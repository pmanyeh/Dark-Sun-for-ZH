      "byte_length": 12
    },
    {
      "unit_id": "LOC_7c560ee7a336",
      "text": "蘭薩札",
      "encoded_ascii": "^/G^-e^.k",
      "encoded_base64": "Xi9HXi1lXi5r",
      "byte_length": 9
    },
    {
      "unit_id": "LOC_23689682a7cc",
      "text": "克倫威爾",
      "encoded_ascii": "^!d^/!^#&^&/",
      "encoded_base64": "XiFkXi8hXiMmXiYv",
      "byte_length": 12
    },
    {
      "unit_id": "LOC_809f925be644",
      "text": "惡徒莫巴德",
      "encoded_ascii": "^#y^#d^/F^#K^#j",
      "encoded_base64": "XiN5XiNkXi9GXiNLXiNq",
      "byte_length": 15
    },
    {
      "unit_id": "LOC_e1d7bf2c0054",
      "text": "芬斯特",
      "encoded_ascii": "^/C^$[^&5",
      "encoded_base64": "Xi9DXiRbXiY1",
      "byte_length": 9
    },
    {
      "unit_id": "LOC_bab191857000",
      "text": "烏爾夫",
      "encoded_ascii": "^/4^&/^\"{",
      "encoded_base64": "Xi80XiYvXiJ7",
      "byte_length": 9
