{
  "format": "darksun-cjk-encoded-catalog",
  "version": 1,
  "catalog": "localization\\catalog\\localization_manifest.csv",
  "catalog_sha256": "f404b0afbf89797b1316f3772d32f1b37d0eea16d1c81fc083c095a83b904454",
  "mapping_sha256": "e3da70e65e53f9efebde92db3314df1a390c6937696bfe4144ce01b4b11683ff",
  "column": "translation_zh_tw",
  "unit_count": 12003,
  "units": [
    {
      "unit_id": "DLG_e2dcee44c746",
      "text": "自由了！終於自由了！我要把你們統統毀滅！哈哈哈哈！ ",
      "encoded_ascii": "^'l^&I^*D^*W^-H^$^^'l^&I^*D^*W^$%^(C^$1^*F^*{^'B^'B^%N^%t^*W^+F^+F^+F^+F^*W ",
      "encoded_base64": "XidsXiZJXipEXipXXi1IXiReXidsXiZJXipEXipXXiQlXihDXiQxXipGXip7XidCXidCXiVOXiV0XipXXitGXitGXitGXitGXipXIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_33724d25c948",
      "text": "達格",
      "encoded_ascii": "^(z^%*",
      "encoded_base64": "Xih6XiUq",
      "byte_length": 6
    },
    {
      "unit_id": "DLG_cfce762186f2",
      "text": "哈爾頓",
      "encoded_ascii": "^+F^&/^.F",
      "encoded_base64": "XitGXiYvXi5G",
      "byte_length": 9
    },
    {
      "unit_id": "DLG_1e1f326abae2",
      "text": "請救救我。我遭到背叛，被囚禁在我自己的地牢裡。",
      "encoded_ascii": "^*S^,Q^,Q^$%^!\"^$%^(}^!u^.r^.Z^*A^(@^\"Z^&y^\"d^$%^'l^#I^&Z^\"e^-$^-j^!\"",
      "encoded_base64": "XipTXixRXixRXiQlXiEiXiQlXih9XiF1Xi5yXi5aXipBXihAXiJaXiZ5XiJkXiQlXidsXiNJXiZaXiJlXi0kXi1qXiEi",
      "byte_length": 69
    },
    {
      "unit_id": "DLG_1e82ab82c6de",
      "text": "加恩",
      "encoded_ascii": "^\"\"^#v",
      "encoded_base64": "XiIiXiN2",
      "byte_length": 6
    },
    {
      "unit_id": "DLG_a8925c8ccb8e",
      "text": "<active_character_name>",
      "encoded_ascii": "<active_character_name>",
      "encoded_base64": "PGFjdGl2ZV9jaGFyYWN0ZXJfbmFtZT4=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_2f14183907e2",
      "text": "  我該如何解救你？ ",
      "encoded_ascii": "  ^$%^(M^#$^!L^(I^,Q^*F^.V ",
      "encoded_base64": "ICBeJCVeKE1eIyReIUxeKEleLFFeKkZeLlYg",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_6802c1dcf451",
      "text": "  什麼是心之水晶？",
      "encoded_ascii": "  ^!=^.T^,X^#k^!/^%V^$h^.V",
      "encoded_base64": "ICBeIT1eLlReLFheI2teIS9eJVZeJGheLlY=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_54f98f9eb386",
      "text": "  這是什麼地方？",
      "encoded_ascii": "  ^(s^,X^!=^.T^\"e^$]^.V",
      "encoded_base64": "ICBeKHNeLFheIT1eLlReImVeJF1eLlY=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_0cbca5fe0c7a",
      "text": "  你現在阻止不了我了。",
      "encoded_ascii": "  ^*F^&?^\"d^)L^%G^!)^*D^$%^*D^!\"",
      "encoded_base64": "ICBeKkZeJj9eImReKUxeJUdeISleKkReJCVeKkReISI=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_3e9b033941ec",
      "text": "  你是誰？",
      "encoded_ascii": "  ^*F^,X^-y^.V",
      "encoded_base64": "ICBeKkZeLFheLXleLlY=",
      "byte_length": 14
    },
    {
      "unit_id": "DLG_0bf25a11367c",
      "text": "  是你摧毀了這座神廟！",
      "encoded_ascii": "  ^,X^*F^$E^%N^*D^(s^/_^&w^0[^*W",
      "encoded_base64": "ICBeLFheKkZeJEVeJU5eKkReKHNeL19eJndeMFteKlc=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_dec6a2af15b2",
      "text": "  是誰背叛了你？",
      "encoded_ascii": "  ^,X^-y^.r^.Z^*D^*F^.V",
      "encoded_base64": "ICBeLFheLXleLnJeLlpeKkReKkZeLlY=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_edeee0b7b34c",
      "text": "  我為什麼要相信你？",
      "encoded_ascii": "  ^$%^%{^!=^.T^(C^&a^!U^*F^.V",
      "encoded_base64": "ICBeJCVeJXteIT1eLlReKENeJmFeIVVeKkZeLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_cfa28f14183c",
      "text": "  還有誰能讓你報仇？",
      "encoded_ascii": "  ^.7^$s^-y^'b^-}^*F^+`^1g^.V",
      "encoded_base64": "ICBeLjdeJHNeLXleJ2JeLX1eKkZeK2BeMWdeLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_505dbe50a9fd",
      "text": "  阿波斯，我這就將你從牢籠中解放出來。",
      "encoded_ascii": "  ^)M^%c^$[^*A^$%^(s^*J^#7^*F^#f^-$^'3^!,^(I^$P^!q^!O^!\"",
      "encoded_base64": "ICBeKU1eJWNeJFteKkFeJCVeKHNeKkpeIzdeKkZeI2ZeLSReJzNeISxeKEleJFBeIXFeIU9eISI=",
      "byte_length": 56
    },
    {
      "unit_id": "DLG_d2c391616617",
      "text": "  要怎樣才能救你出來？",
      "encoded_ascii": "  ^(C^,,^,f^$,^'b^,Q^*F^!q^!O^.V",
      "encoded_base64": "ICBeKENeLCxeLGZeJCxeJ2JeLFFeKkZeIXFeIU9eLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_fa2977b7b1c0",
      "text": "  什麼法術？",
      "encoded_ascii": "  ^!=^.T^%b^(<^.V",
      "encoded_base64": "ICBeIT1eLlReJWJeKDxeLlY=",
      "byte_length": 17
    },
    {
      "unit_id": "DLG_fda6f2fb5429",
      "text": "抱歉，我幫不了你。再見。",
      "encoded_ascii": "^,@^,h^*A^$%^+}^!)^*D^*F^!\"^!l^-m^!\"",
      "encoded_base64": "XixAXixoXipBXiQlXit9XiEpXipEXipGXiEiXiFsXi1tXiEi",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_6a7c12f13aa7",
      "text": "很高興遇見你。 ",
      "encoded_ascii": "^*K^*+^-]^.2^-m^*F^!\" ",
      "encoded_base64": "XipLXiorXi1dXi4yXi1tXipGXiEiIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_b7f764e5161c",
      "text": "去找到我的心之水晶！它就在地表的某處！你一定會得到 ",
      "encoded_ascii": "^\"6^$/^!u^$%^&Z^#k^!/^%V^$h^*W^+o^*J^\"d^\"e^-i^&Z^%$^(,^*W^*F^!%^#.^$r^#e^!u ",
      "encoded_base64": "XiI2XiQvXiF1XiQlXiZaXiNrXiEvXiVWXiRoXipXXitvXipKXiJkXiJlXi1pXiZaXiUkXigsXipXXipGXiElXiMuXiRyXiNlXiF1IA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_7bfe759337d9",
      "text": "重賞的。 ",
      "encoded_ascii": "^))^*T^&Z^!\" ",
      "encoded_base64": "XikpXipUXiZaXiEiIA==",
      "byte_length": 13
    },
    {
      "unit_id": "DLG_e362e5caa226",
      "text": "那是一顆容納了我靈魂的綠色水晶。沒有它，我就無法 ",
      "encoded_ascii": "^)!^,X^!%^)u^+t^';^*D^$%^)g^*.^&Z^3V^'s^%V^$h^!\"^%\\^$s^+o^*A^$%^*J^%}^%b ",
      "encoded_base64": "XikhXixYXiElXil1Xit0Xic7XipEXiQlXilnXiouXiZaXjNWXidzXiVWXiRoXiEiXiVcXiRzXitvXipBXiQlXipKXiV9XiViIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_42334b475a16",
      "text": "重獲自由。 ",
      "encoded_ascii": "^))^&:^'l^&I^!\" ",
      "encoded_base64": "XikpXiY6XidsXiZJXiEiIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_23d8ac2b4e52",
      "text": "這裡是財富神廟。只要你放我出去，我所有的財富 ",
      "encoded_ascii": "^(s^-j^,X^0=^3C^&w^0[^!\"^\"?^(C^*F^$P^$%^!q^\"6^*A^$%^$)^$s^&Z^0=^3C ",
      "encoded_base64": "XihzXi1qXixYXjA9XjNDXiZ3XjBbXiEiXiI/XihDXipGXiRQXiQlXiFxXiI2XipBXiQlXiQpXiRzXiZaXjA9XjNDIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_8ce705d0a084",
      "text": "統統都歸你。",
      "encoded_ascii": "^'B^'B^)$^%K^*F^!\"",
      "encoded_base64": "XidCXidCXikkXiVLXipGXiEi",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_258f314566ea",
      "text": "這個嘛……所有的東西都藏起來了。但我可以告訴你如何找到 ",
      "encoded_ascii": "^(s^!V^+Y^*o^*o^$)^$s^&Z^,`^-l^)$^-f^.(^!O^*D^!\"^!I^$%^\"A^!B^+B^-t^*F^#$^!L^$/^!u ",
      "encoded_base64": "XihzXiFWXitZXipvXipvXiQpXiRzXiZaXixgXi1sXikkXi1mXi4oXiFPXipEXiEiXiFJXiQlXiJBXiFCXitCXi10XipGXiMkXiFMXiQvXiF1IA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_f6a5bbbc1187",
      "text": "所有最頂級的寶藏。",
      "encoded_ascii": "^$)^$s^$q^)p^'<^&Z^#4^-f^!\"",
      "encoded_base64": "XiQpXiRzXiRxXilwXic8XiZaXiM0Xi1mXiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_ab09f5e2e5b2",
      "text": "我是阿波斯，這座神廟的主人。",
      "encoded_ascii": "^$%^,X^)M^%c^$[^*A^(s^/_^&w^0[^&Z^!-^!<^!\"",
      "encoded_base64": "XiQlXixYXilNXiVjXiRbXipBXihzXi9fXiZ3XjBbXiZaXiEtXiE8XiEi",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_2559512cbfc3",
      "text": "沒錯！要是你們不快點把我從這些鎖鏈中放開， ",
      "encoded_ascii": "^%\\^)5^*W^(C^,X^*F^*{^!)^*L^*;^$1^$%^#f^(s^!8^)8^)<^!,^$P^)F^*A ",
      "encoded_base64": "XiVcXik1XipXXihDXixYXipGXip7XiEpXipMXio7XiQxXiQlXiNmXihzXiE4Xik4Xik8XiEsXiRQXilGXipBIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_d43a30515420",
      "text": "我也會把你們一起毀滅！",
      "encoded_ascii": "^$%^!1^$r^$1^*F^*{^!%^.(^%N^%t^*W",
      "encoded_base64": "XiQlXiExXiRyXiQxXipGXip7XiElXi4oXiVOXiV0XipX",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_783e83301118",
      "text": "我的信徒……呃……被另一個邪惡祭司的花言巧語所動搖 ",
      "encoded_ascii": "^$%^&Z^!U^#d^*o^*o^3<^*o^*o^(@^\">^!%^!V^)\"^#y^&x^+=^&Z^'w^1Y^3D^0:^$)^\"%^3J ",
      "encoded_base64": "XiQlXiZaXiFVXiNkXipvXipvXjM8XipvXipvXihAXiI+XiElXiFWXikiXiN5XiZ4Xis9XiZaXid3XjFZXjNEXjA6XiQpXiIlXjNKIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_0d8d76ede62a",
      "text": "與矇騙。他們受騙了，反過來將我毀滅。",
      "encoded_ascii": "^'p^3T^.{^!\"^!@^*{^\";^.{^*D^*A^\"9^(x^!O^#7^$%^%N^%t^!\"",
      "encoded_base64": "XidwXjNUXi57XiEiXiFAXip7XiI7Xi57XipEXipBXiI5Xih4XiFPXiM3XiQlXiVOXiV0XiEi",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_f6450712249d",
      "text": "像我這樣可憐的人，又有什麼動機去欺騙 ",
      "encoded_ascii": "^!`^$%^(s^,f^\"A^1}^&Z^!<^*A^+;^$s^!=^.T^\"%^%>^\"6^2r^.{ ",
      "encoded_base64": "XiFgXiQlXihzXixmXiJBXjF9XiZaXiE8XipBXis7XiRzXiE9Xi5UXiIlXiU+XiI2XjJyXi57IA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_1fcf596b1572",
      "text": "像你這樣善良仁慈的旅人呢？",
      "encoded_ascii": "^!`^*F^(s^,f^1(^1V^37^3H^&Z^2m^!<^+C^.V",
      "encoded_base64": "XiFgXipGXihzXixmXjEoXjFWXjM3XjNIXiZaXjJtXiE8XitDXi5W",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_649538e828a5",
      "text": "我剛才說了復仇嗎？都是這漫長歲月的囚禁矇蔽了 ",
      "encoded_ascii": "^$%^+0^$,^-x^*D^#g^1g^+X^.V^)$^,X^(s^2,^)C^,j^/p^&Z^\"Z^&y^3T^('^*D ",
      "encoded_base64": "XiQlXiswXiQsXi14XipEXiNnXjFnXitYXi5WXikkXixYXihzXjIsXilDXixqXi9wXiZaXiJaXiZ5XjNUXignXipEIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_88563225ebd2",
      "text": "我的理智。我唯一期盼的只是讓我的靈魂得以安息。",
      "encoded_ascii": "^$%^&Z^&A^$i^!\"^$%^+O^!%^$u^23^&Z^\"?^,X^-}^$%^&Z^)g^*.^#e^!B^+p^#w^!\"",
      "encoded_base64": "XiQlXiZaXiZBXiRpXiEiXiQlXitPXiElXiR1XjIzXiZaXiI/XixYXi19XiQlXiZaXilnXiouXiNlXiFCXitwXiN3XiEi",
      "byte_length": 69
    },
    {
      "unit_id": "DLG_f32977434f0e",
      "text": "謝謝你們！終於逃離這座牢獄了！現在我要把你們和任何 ",
      "encoded_ascii": "^-z^-z^*F^*{^*W^-H^$^^(p^)`^(s^/_^-$^3Q^*D^*W^&?^\"d^$%^(C^$1^*F^*{^\"O^!C^!L ",
      "encoded_base64": "Xi16Xi16XipGXip7XipXXi1IXiReXihwXilgXihzXi9fXi0kXjNRXipEXipXXiY/XiJkXiQlXihDXiQxXipGXip7XiJPXiFDXiFMIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_8f27a774aefc",
      "text": "擋我路的人統統殺光！",
      "encoded_ascii": "^$G^$%^(a^&Z^!<^'B^'B^%M^!c^*W",
      "encoded_base64": "XiRHXiQlXihhXiZaXiE8XidCXidCXiVNXiFjXipX",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_5b9b7943161d",
      "text": "找到我的心之水晶。只要你一見到它，就一定能認出來。 ",
      "encoded_ascii": "^$/^!u^$%^&Z^#k^!/^%V^$h^!\"^\"?^(C^*F^!%^-m^!u^+o^*A^*J^!%^#.^'b^(O^!q^!O^!\" ",
      "encoded_base64": "XiQvXiF1XiQlXiZaXiNrXiEvXiVWXiRoXiEiXiI/XihDXipGXiElXi1tXiF1XitvXipBXipKXiElXiMuXidiXihPXiFxXiFPXiEiIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_fd6b4207e83d",
      "text": "多年前它被一個一心想置我於死地的人奪走了。他 ",
      "encoded_ascii": "^\"x^+~^!z^+o^(@^!%^!V^!%^#k^,1^'Q^$%^$^^%L^\"e^&Z^!<^1,^.&^*D^!\"^!@ ",
      "encoded_base64": "XiJ4Xit+XiF6XitvXihAXiElXiFWXiElXiNrXiwxXidRXiQlXiReXiVMXiJlXiZaXiE8XjEsXi4mXipEXiEiXiFAIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_f7510384c1b6",
      "text": "無法摧毀水晶，因此將它藏了起來——我恐怕它並不在神廟裡。 ",
      "encoded_ascii": "^%}^%b^$E^%N^%V^$h^*A^\"]^%I^#7^+o^-f^*D^.(^!O^*n^*n^$%^#t^0^^+o^!+^!)^\"d^&w^0[^-j^!\" ",
      "encoded_base64": "XiV9XiViXiRFXiVOXiVWXiRoXipBXiJdXiVJXiM3XitvXi1mXipEXi4oXiFPXipuXipuXiQlXiN0XjBeXitvXiErXiEpXiJkXiZ3XjBbXi1qXiEiIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_b9b4dc47f49d",
      "text": "帶著寶石回來，我就會傳授你一道強大的法術！ ",
      "encoded_ascii": "^#N^-a^#4^&k^\"\\^!O^*A^$%^*J^$r^+$^$:^*F^!%^(y^#]^\"z^&Z^%b^(<^*W ",
      "encoded_base64": "XiNOXi1hXiM0XiZrXiJcXiFPXipBXiQlXipKXiRyXiskXiQ6XipGXiElXih5XiNdXiJ6XiZaXiViXig8XipXIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_ab0a7898c751",
      "text": "自從化為幽影冤魂後，我學會了如何召喚其他 ",
      "encoded_ascii": "^'l^#f^\")^%{^2f^#a^3;^*.^#b^*A^$%^+n^$r^*D^#$^!L^\"@^\"U^!j^!@ ",
      "encoded_base64": "XidsXiNmXiIpXiV7XjJmXiNhXjM7XiouXiNiXipBXiQlXituXiRyXipEXiMkXiFMXiJAXiJVXiFqXiFAIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_79751f8cf5a1",
      "text": "與我同類的幽影。我將這門知識濃縮成了一卷卷軸， ",
      "encoded_ascii": "^'p^$%^\"E^)w^&Z^2f^#a^!\"^$%^#7^(s^)D^&h^(R^%w^3X^$$^*D^!%^\"3^\"3^(e^*A ",
      "encoded_base64": "XidwXiQlXiJFXil3XiZaXjJmXiNhXiEiXiQlXiM3XihzXilEXiZoXihSXiV3XjNYXiQkXipEXiElXiIzXiIzXihlXipBIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_9a3bbc4f4411",
      "text": "等你們足夠強大、能掌握此等高深魔法時，便可以使用它。 ",
      "encoded_ascii": "^'-^*F^*{^(^^+d^#]^\"z^!!^'b^$;^1>^%I^'-^*+^2*^*0^%b^$f^*A^!R^\"A^!B^!N^&H^+o^!\" ",
      "encoded_base64": "XictXipGXip7XiheXitkXiNdXiJ6XiEhXidiXiQ7XjE+XiVJXictXiorXjIqXiowXiViXiRmXipBXiFSXiJBXiFCXiFOXiZIXitvXiEiIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_fee7cf1e459e",
      "text": "求求你們！別把我留在這裡！ ",
      "encoded_ascii": "^,n^,n^*F^*{^*W^*H^$1^$%^-+^\"d^(s^-j^*W ",
      "encoded_base64": "XixuXixuXipGXip7XipXXipIXiQxXiQlXi0rXiJkXihzXi1qXipXIA==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_78a6f0aef046",
      "text": "以亞薩斯逝去眾神之名，放我自由！是我為這座神殿 ",
      "encoded_ascii": "^!B^!9^-e^$[^0E^\"6^&e^&w^!/^\"F^*A^$P^$%^'l^&I^*W^,X^$%^%{^(s^/_^&w^.m ",
      "encoded_base64": "XiFCXiE5Xi1lXiRbXjBFXiI2XiZlXiZ3XiEvXiJGXipBXiRQXiQlXidsXiZJXipXXixYXiQlXiV7XihzXi9fXiZ3Xi5tIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_c27eb3821e08",
      "text": "招來了滅頂之災，我也會對你們做出一模一樣的事！",
      "encoded_ascii": "^,D^!O^*D^%t^)p^!/^3P^*A^$%^!1^$r^#:^*F^*{^*~^!q^!%^%:^!%^,f^&Z^*r^*W",
      "encoded_base64": "XixEXiFPXipEXiV0XilwXiEvXjNQXipBXiQlXiExXiRyXiM6XipGXip7Xip+XiFxXiElXiU6XiElXixmXiZaXipyXipX",
      "byte_length": 69
    },
    {
      "unit_id": "DLG_beecb8d6e5ff",
      "text": " 快替我解開這些鎖鏈，好讓我向你們表達我的感激之情！",
      "encoded_ascii": " ^*L^2o^$%^(I^)F^(s^!8^)8^)<^*A^+i^-}^$%^+?^*F^*{^-i^(z^$%^&Z^#{^1H^!/^,0^*W",
      "encoded_base64": "IF4qTF4yb14kJV4oSV4pRl4oc14hOF4pOF4pPF4qQV4raV4tfV4kJV4rP14qRl4qe14taV4oel4kJV4mWl4je14xSF4hL14sMF4qVw==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_f04a733896d0",
      "text": " 現在求求你，快替我除去桎梏，好讓我去施展我的復仇！",
      "encoded_ascii": " ^&?^\"d^,n^,n^*F^*A^*L^2o^$%^)Q^\"6^3L^3M^*A^+i^-}^$%^\"6^$_^+x^$%^&Z^#g^1g^*W",
      "encoded_base64": "IF4mP14iZF4sbl4sbl4qRl4qQV4qTF4yb14kJV4pUV4iNl4zTF4zTV4qQV4raV4tfV4kJV4iNl4kX14reF4kJV4mWl4jZ14xZ14qVw==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_e0324cff110a",
      "text": " 求求你，鬆開束縛我的枷鎖吧！",
      "encoded_ascii": " ^,n^,n^*F^*A^.R^)F^$|^3W^$%^&Z^2p^)8^*I^*W",
      "encoded_base64": "IF4sbl4sbl4qRl4qQV4uUl4pRl4kfF4zV14kJV4mWl4ycF4pOF4qSV4qVw==",
      "byte_length": 43
    },
    {
      "unit_id": "DLG_beec6a01f883",
      "text": "  你為什麼要詛咒這個地方？",
      "encoded_ascii": "  ^*F^%{^!=^.T^(C^(L^\"P^(s^!V^\"e^$]^.V",
      "encoded_base64": "ICBeKkZeJXteIT1eLlReKENeKExeIlBeKHNeIVZeImVeJF1eLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_4d6934e85ed9",
      "text": "  你是怎麼被囚禁在這裡的？",
      "encoded_ascii": "  ^*F^,X^,,^.T^(@^\"Z^&y^\"d^(s^-j^&Z^.V",
      "encoded_base64": "ICBeKkZeLFheLCxeLlReKEBeIlpeJnleImReKHNeLWpeJlpeLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_2c2edf829764",
      "text": "  你對那些護符有了解嗎？",
      "encoded_ascii": "  ^*F^#:^)!^!8^(T^'+^$s^*D^(I^+X^.V",
      "encoded_base64": "ICBeKkZeIzpeKSFeITheKFReJyteJHNeKkReKEleK1heLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_f47f64e30c97",
      "text": "  我在哪裡能找到它們？",
      "encoded_ascii": "  ^$%^\"d^+I^-j^'b^$/^!u^+o^*{^.V",
      "encoded_base64": "ICBeJCVeImReK0leLWpeJ2JeJC9eIXVeK29eKnteLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_5da5d69b4388",
      "text": "  崔斯特姆還在這個地方嗎？",
      "encoded_ascii": "  ^#E^$[^&5^#%^.7^\"d^(s^!V^\"e^$]^+X^.V",
      "encoded_base64": "ICBeI0VeJFteJjVeIyVeLjdeImReKHNeIVZeImVeJF1eK1heLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_a81f54ed8ea0",
      "text": "  我在哪裡能找到她？",
      "encoded_ascii": "  ^$%^\"d^+I^-j^'b^$/^!u^+h^.V",
      "encoded_base64": "ICBeJCVeImReK0leLWpeJ2JeJC9eIXVeK2heLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_0289eddfe62a",
      "text": "  為什麼信徒們都變成了殭屍？",
      "encoded_ascii": "  ^%{^!=^.T^!U^#d^*{^)$^(U^$$^*D^3N^#?^.V",
      "encoded_base64": "ICBeJXteIT1eLlReIVVeI2ReKnteKSReKFVeJCReKkReM05eIz9eLlY=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_1445c24d217b",
      "text": "再見。",
      "encoded_ascii": "^!l^-m^!\"",
      "encoded_base64": "XiFsXi1tXiEi",
      "byte_length": 9
    },
    {
      "unit_id": "DLG_a928439fc8f0",
      "text": "泰南為了一個女人的愛，危及了兩個王國之間的和平。 ",
      "encoded_ascii": "^%f^\"/^%{^*D^!%^!V^#\"^!<^&Z^,2^*A^2\\^\"7^*D^!i^!V^-)^+^^!/^)G^&Z^\"O^0Y^!\" ",
      "encoded_base64": "XiVmXiIvXiV7XipEXiElXiFWXiMiXiE8XiZaXiwyXipBXjJcXiI3XipEXiFpXiFWXi0pXiteXiEvXilHXiZaXiJPXjBZXiEiIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_c204d662d37c",
      "text": "那個軟弱的蠢貨落得這般下場純屬咎由自取。",
      "encoded_ascii": "^)!^!V^.x^#\\^&Z^.u^.w^-`^#e^(s^'r^!(^\"n^3\"^#C^3=^&I^'l^\":^!\"",
      "encoded_base64": "XikhXiFWXi54XiNcXiZaXi51Xi53Xi1gXiNlXihzXidyXiEoXiJuXjMiXiNDXjM9XiZJXidsXiI6XiEi",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_67c2d75e7555",
      "text": "在泰南橫加干涉引發的戰爭中，我被俘虜了。 ",
      "encoded_ascii": "^\"d^%f^\"/^/2^\"\"^#R^3O^#Z^&W^&Z^$(^1I^!,^*A^$%^(@^39^3[^*D^!\" ",
      "encoded_base64": "XiJkXiVmXiIvXi8yXiIiXiNSXjNPXiNaXiZXXiZaXiQoXjFJXiEsXipBXiQlXihAXjM5XjNbXipEXiEiIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_767c72227d20",
      "text": "西方國王將他女兒遭受的不測統統歸咎於我。 ",
      "encoded_ascii": "^-l^$]^+^^-)^#7^!@^#\"^++^(}^\";^&Z^!)^%p^'B^'B^%K^3=^$^^$%^!\" ",
      "encoded_base64": "Xi1sXiRdXiteXi0pXiM3XiFAXiMiXisrXih9XiI7XiZaXiEpXiVwXidCXidCXiVLXjM9XiReXiQlXiEiIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_040c08d3d577",
      "text": "他的隨軍祭司將我的靈魂打入並囚禁在 ",
      "encoded_ascii": "^!@^&Z^)X^..^&x^+=^#7^$%^&Z^)g^*.^$-^!f^!+^\"Z^&y^\"d ",
      "encoded_base64": "XiFAXiZaXilYXi4uXiZ4Xis9XiM3XiQlXiZaXilnXiouXiQtXiFmXiErXiJaXiZ5XiJkIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_614c2b7a5b95",
      "text": "這處地牢裡。",
      "encoded_ascii": "^(s^(,^\"e^-$^-j^!\"",
      "encoded_base64": "XihzXigsXiJlXi0kXi1qXiEi",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_33daf8a4fac1",
      "text": "護符？呃，我當然知道那些護符。你想 ",
      "encoded_ascii": "^(T^'+^.V^3<^*A^$%^&N^&\"^&h^(y^)!^!8^(T^'+^!\"^*F^,1 ",
      "encoded_base64": "XihUXicrXi5WXjM8XipBXiQlXiZOXiYiXiZoXih5XikhXiE4XihUXicrXiEiXipGXiwxIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_a602773729f0",
      "text": "知道些什麼？",
      "encoded_ascii": "^&h^(y^!8^!=^.T^.V",
      "encoded_base64": "XiZoXih5XiE4XiE9Xi5UXi5W",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_5a357fc979e7",
      "text": "當然還在！你難道懷疑我詛咒的威力嗎？我將所有 ",
      "encoded_ascii": "^&N^&\"^.7^\"d^*W^*F^)a^(y^,9^0p^$%^(L^\"P^&Z^#&^!~^+X^.V^$%^#7^$)^$s ",
      "encoded_base64": "XiZOXiYiXi43XiJkXipXXipGXilhXih5Xiw5XjBwXiQlXihMXiJQXiZaXiMmXiF+XitYXi5WXiQlXiM3XiQpXiRzIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_7404b403dc0e",
      "text": "靈魂都封鎖在此地，所以她依然留在這裡！",
      "encoded_ascii": "^)g^*.^)$^#5^)8^\"d^%I^\"e^*A^$)^!B^+h^!Q^&\"^-+^\"d^(s^-j^*W",
      "encoded_base64": "XilnXiouXikkXiM1Xik4XiJkXiVJXiJlXipBXiQpXiFCXitoXiFRXiYiXi0rXiJkXihzXi1qXipX",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_423c311717ea",
      "text": "只要你們能活得夠久，就能在這座神廟的某個角落找到她。",
      "encoded_ascii": "^\"?^(C^*F^*{^'b^%i^#e^+d^!.^*A^*J^'b^\"d^(s^/_^&w^0[^&Z^%$^!V^(H^-`^$/^!u^+h^!\"",
      "encoded_base64": "XiI/XihDXipGXip7XidiXiVpXiNlXitkXiEuXipBXipKXidiXiJkXihzXi9fXiZ3XjBbXiZaXiUkXiFWXihIXi1gXiQvXiF1XitoXiEi",
      "byte_length": 78
    },
    {
      "unit_id": "DLG_c7a527964023",
      "text": "你是說為什麼他們沒像其他人那樣化為幽影？那是戰爭期間 ",
      "encoded_ascii": "^*F^,X^-x^%{^!=^.T^!@^*{^%\\^!`^!j^!@^!<^)!^,f^\")^%{^2f^#a^.V^)!^,X^$(^1I^$u^)G ",
      "encoded_base64": "XipGXixYXi14XiV7XiE9Xi5UXiFAXip7XiVcXiFgXiFqXiFAXiE8XikhXixmXiIpXiV7XjJmXiNhXi5WXikhXixYXiQoXjFJXiR1XilHIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_514551c78305",
      "text": "西方國王所為。他以為自己能將他們驅使於 ",
      "encoded_ascii": "^-l^$]^+^^-)^$)^%{^!\"^!@^!B^%{^'l^#I^'b^#7^!@^*{^*#^!N^$^ ",
      "encoded_base64": "Xi1sXiRdXiteXi0pXiQpXiV7XiEiXiFAXiFCXiV7XidsXiNJXidiXiM3XiFAXip7XiojXiFOXiReIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_d6ca6d2f9cde",
      "text": "戰場之上，但我的詛咒阻止了他們踏出這座神廟半步。",
      "encoded_ascii": "^$(^\"n^!/^!'^*A^!I^$%^&Z^(L^\"P^)L^%G^*D^!@^*{^.,^!q^(s^/_^&w^0[^\"-^,i^!\"",
      "encoded_base64": "XiQoXiJuXiEvXiEnXipBXiFJXiQlXiZaXihMXiJQXilMXiVHXipEXiFAXip7Xi4sXiFxXihzXi9fXiZ3XjBbXiItXixpXiEi",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_4f18eb7f1b8c",
      "text": " 快把我從鎖鏈中放出來，否則我一劍刺穿你們！",
      "encoded_ascii": " ^*L^$1^$%^#f^)8^)<^!,^$P^!q^!O^*A^\"H^!x^$%^!%^!|^!w^')^*F^*{^*W",
      "encoded_base64": "IF4qTF4kMV4kJV4jZl4pOF4pPF4hLF4kUF4hcV4hT14qQV4iSF4heF4kJV4hJV4hfF4hd14nKV4qRl4qe14qVw==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_01d252c25bdd",
      "text": " 快把我從鎖鏈中放出來，否則我把你們的眼珠挖出來吃掉！",
      "encoded_ascii": " ^*L^$1^$%^#f^)8^)<^!,^$P^!q^!O^*A^\"H^!x^$%^$1^*F^*{^&Z^&d^&>^2!^!q^!O^2^^/e^*W",
      "encoded_base64": "IF4qTF4kMV4kJV4jZl4pOF4pPF4hLF4kUF4hcV4hT14qQV4iSF4heF4kJV4kMV4qRl4qe14mWl4mZF4mPl4yIV4hcV4hT14yXl4vZV4qVw==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_05a52533e0c1",
      "text": " 快把我從鎖鏈中放出來，否則我把你們的內臟拿去餵蝙蝠！",
      "encoded_ascii": " ^*L^$1^$%^#f^)8^)<^!,^$P^!q^!O^*A^\"H^!x^$%^$1^*F^*{^&Z^!g^3Y^,G^\"6^.L^3\\^3]^*W",
      "encoded_base64": "IF4qTF4kMV4kJV4jZl4pOF4pPF4hLF4kUF4hcV4hT14qQV4iSF4heF4kJV4kMV4qRl4qe14mWl4hZ14zWV4sR14iNl4uTF4zXF4zXV4qVw==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_ff82792c294a",
      "text": "  你看起來可不像之前那麼慈眉善目了。",
      "encoded_ascii": "  ^*F^*Q^.(^!O^\"A^!)^!`^!/^!z^)!^.T^3H^3S^1(^&^^*D^!\"",
      "encoded_base64": "ICBeKkZeKlFeLiheIU9eIkFeISleIWBeIS9eIXpeKSFeLlReM0heM1NeMSheJl5eKkReISI=",
      "byte_length": 53
    },
    {
      "unit_id": "DLG_b03672e1fa29",
      "text": "  你為什麼會被鎖在這裡？",
      "encoded_ascii": "  ^*F^%{^!=^.T^$r^(@^)8^\"d^(s^-j^.V",
      "encoded_base64": "ICBeKkZeJXteIT1eLlReJHJeKEBeKTheImReKHNeLWpeLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_e8bb003dc155",
      "text": "  你是如何為你的國王效忠的？",
      "encoded_ascii": "  ^*F^,X^#$^!L^%{^*F^&Z^+^^-)^$Q^.d^&Z^.V",
      "encoded_base64": "ICBeKkZeLFheIyReIUxeJXteKkZeJlpeK15eLSleJFFeLmReJlpeLlY=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_a8b0af335cc4",
      "text": "  那個女孩願意嫁給你們的國王嗎？",
      "encoded_ascii": "  ^)!^!V^#\"^+m^.H^#z^3B^'A^*F^*{^&Z^+^^-)^+X^.V",
      "encoded_base64": "ICBeKSFeIVZeIyJeK21eLkheI3peM0JeJ0FeKkZeKnteJlpeK15eLSleK1heLlY=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_ca2f776fe0c8",
      "text": "  這真的是你自己的地牢嗎？",
      "encoded_ascii": "  ^(s^-2^&Z^,X^*F^'l^#I^&Z^\"e^-$^+X^.V",
      "encoded_base64": "ICBeKHNeLTJeJlpeLFheKkZeJ2xeI0leJlpeImVeLSReK1heLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_c5110cbd74dc",
      "text": "  這座要塞原本屬於誰？",
      "encoded_ascii": "  ^(s^/_^(C^/(^\"5^$x^#C^$^^-y^.V",
      "encoded_base64": "ICBeKHNeL19eKENeLyheIjVeJHheI0NeJF5eLXleLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_337e99983f95",
      "text": "  你們之間究竟發生了什麼事？",
      "encoded_ascii": "  ^*F^*{^!/^)G^-<^28^&W^&F^*D^!=^.T^*r^.V",
      "encoded_base64": "ICBeKkZeKnteIS9eKUdeLTxeMjheJldeJkZeKkReIT1eLlReKnJeLlY=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_317e8de304e2",
      "text": "  我見過他了。",
      "encoded_ascii": "  ^$%^-m^(x^!@^*D^!\"",
      "encoded_base64": "ICBeJCVeLW1eKHheIUBeKkReISI=",
      "byte_length": 20
    },
    {
      "unit_id": "DLG_9be8bea0479b",
      "text": "  我見過他了！他把你做的好事全告訴我了！",
      "encoded_ascii": "  ^$%^-m^(x^!@^*D^*W^!@^$1^*F^*~^&Z^+i^*r^!h^+B^-t^$%^*D^*W",
      "encoded_base64": "ICBeJCVeLW1eKHheIUBeKkReKldeIUBeJDFeKkZeKn5eJlpeK2leKnJeIWheK0JeLXReJCVeKkReKlc=",
      "byte_length": 59
    },
    {
      "unit_id": "DLG_3306995a06ce",
      "text": " 再會。 ",
      "encoded_ascii": " ^!l^$r^!\" ",
      "encoded_base64": "IF4hbF4kcl4hIiA=",
      "byte_length": 11
    },
    {
      "unit_id": "DLG_5f4b114877e7",
      "text": "數代以來，我的靈魂都被死死封印在這間潰朽的密室裡。 ",
      "encoded_ascii": "^$V^*v^!B^!O^*A^$%^&Z^)g^*.^)$^(@^%L^%L^#5^1%^\"d^(s^)G^2-^3K^&Z^#0^+r^-j^!\" ",
      "encoded_base64": "XiRWXip2XiFCXiFPXipBXiQlXiZaXilnXiouXikkXihAXiVMXiVMXiM1XjElXiJkXihzXilHXjItXjNLXiZaXiMwXityXi1qXiEiIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_d02335572c41",
      "text": "我心中的怨毒怎能不日益潰爛發酵？",
      "encoded_ascii": "^$%^#k^!,^&Z^3F^%Q^,,^'b^!)^$a^3R^2-^&-^&W^3a^.V",
      "encoded_base64": "XiQlXiNrXiEsXiZaXjNGXiVRXiwsXidiXiEpXiRhXjNSXjItXiYtXiZXXjNhXi5W",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_113df1eb24f8",
      "text": "我為我的國王效命，盡了一個優秀祭司應盡的職責！正是我的忠誠 ",
      "encoded_ascii": "^$%^%{^$%^&Z^+^^-)^$Q^\"N^*A^-1^*D^!%^!V^+)^-9^&x^+=^0`^-1^&Z^'\\^0>^*W^%H^,X^$%^&Z^.d^2E ",
      "encoded_base64": "XiQlXiV7XiQlXiZaXiteXi0pXiRRXiJOXipBXi0xXipEXiElXiFWXispXi05XiZ4Xis9XjBgXi0xXiZaXidcXjA+XipXXiVIXixYXiQlXiZaXi5kXjJFIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_da767d5b3204",
      "text": "為我招來了這等奇恥大辱與不公。",
      "encoded_ascii": "^%{^$%^,D^!O^*D^(s^'-^\"}^3G^\"z^3`^'p^!)^3:^!\"",
      "encoded_base64": "XiV7XiQlXixEXiFPXipEXihzXictXiJ9XjNHXiJ6XjNgXidwXiEpXjM6XiEi",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_8fc7109f53ab",
      "text": "國王本與另一王國的公主訂有婚約，但她卻愛上了一名巫師， ",
      "encoded_ascii": "^+^^-)^$x^'p^\">^!%^-)^+^^&Z^3:^!-^3^^$s^3A^-F^*A^!I^+h^1&^,2^!'^*D^!%^\"F^14^#M^*A ",
      "encoded_base64": "XiteXi0pXiR4XidwXiI+XiElXi0pXiteXiZaXjM6XiEtXjNeXiRzXjNBXi1GXipBXiFJXitoXjEmXiwyXiEnXipEXiElXiJGXjE0XiNNXipBIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_f763c5d0fd34",
      "text": "背叛了國王。在國王的聖諭下，我理所當然地懲戒了她 ",
      "encoded_ascii": "^.r^.Z^*D^+^^-)^!\"^\"d^+^^-)^&Z^'Z^3_^!(^*A^$%^&A^$)^&N^&\"^\"e^/b^$&^*D^+h ",
      "encoded_base64": "Xi5yXi5aXipEXiteXi0pXiEiXiJkXiteXi0pXiZaXidaXjNfXiEoXipBXiQlXiZBXiQpXiZOXiYiXiJlXi9iXiQmXipEXitoIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_0dba710c5c55",
      "text": "和那名巫師。",
      "encoded_ascii": "^\"O^)!^\"F^14^#M^!\"",
      "encoded_base64": "XiJPXikhXiJGXjE0XiNNXiEi",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_2026310bac97",
      "text": "她願不願意根本無關緊要。這場聯姻本可 ",
      "encoded_ascii": "^+h^.H^!)^.H^#z^%)^$x^%}^.>^0r^(C^!\"^(s^\"n^-V^3@^$x^\"A ",
      "encoded_base64": "XitoXi5IXiEpXi5IXiN6XiUpXiR4XiV9Xi4+XjByXihDXiEiXihzXiJuXi1WXjNAXiR4XiJBIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_01a203eaef04",
      "text": "鞏固兩個王國之間的盟好關係。 ",
      "encoded_ascii": "^3b^3>^!i^!V^-)^+^^!/^)G^&Z^-0^+i^.>^38^!\" ",
      "encoded_base64": "XjNiXjM+XiFpXiFWXi0pXiteXiEvXilHXiZaXi0wXitpXi4+XjM4XiEiIA==",
      "byte_length": 43
    },
    {
      "unit_id": "DLG_f1522bdc9b01",
      "text": "數個世紀以來的盤踞讓我完全有理由宣稱這裡 ",
      "encoded_ascii": "^$V^!V^*p^2:^!B^!O^&Z^1M^1_^-}^$%^#,^!h^$s^&A^&I^2d^0&^(s^-j ",
      "encoded_base64": "XiRWXiFWXipwXjI6XiFCXiFPXiZaXjFNXjFfXi19XiQlXiMsXiFoXiRzXiZBXiZJXjJkXjAmXihzXi1qIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_767f6709b925",
      "text": "屬於我，但最初這座要塞屬於另一個人。",
      "encoded_ascii": "^#C^$^^$%^*A^!I^$q^1\"^(s^/_^(C^/(^#C^$^^\">^!%^!V^!<^!\"",
      "encoded_base64": "XiNDXiReXiQlXipBXiFJXiRxXjEiXihzXi9fXihDXi8oXiNDXiReXiI+XiElXiFWXiE8XiEi",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_f84db9b58456",
      "text": "一名傳授魔法技藝的導師。他的名字叫泰南。像我這樣的 ",
      "encoded_ascii": "^!%^\"F^+$^$:^*0^%b^,>^3Z^&Z^10^#M^!\"^!@^&Z^\"F^#)^+<^%f^\"/^!\"^!`^$%^(s^,f^&Z ",
      "encoded_base64": "XiElXiJGXiskXiQ6XiowXiViXiw+XjNaXiZaXjEwXiNNXiEiXiFAXiZaXiJGXiMpXis8XiVmXiIvXiEiXiFgXiQlXihzXixmXiZaIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_744278c2b8db",
      "text": "祭司曾慕名前來向他請教。正是與他的這段糾葛， ",
      "encoded_ascii": "^&x^+=^.j^3I^\"F^!z^!O^+?^!@^*S^,R^!\"^%H^,X^'p^!@^&Z^(s^.l^3U^(\"^*A ",
      "encoded_base64": "XiZ4Xis9Xi5qXjNJXiJGXiF6XiFPXis/XiFAXipTXixSXiEiXiVIXixYXidwXiFAXiZaXihzXi5sXjNVXigiXipBIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_87c52196e8ae",
      "text": "為我帶來了這場滅頂之災。",
      "encoded_ascii": "^%{^$%^#N^!O^*D^(s^\"n^%t^)p^!/^3P^!\"",
      "encoded_base64": "XiV7XiQlXiNOXiFPXipEXihzXiJuXiV0XilwXiEvXjNQXiEi",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_8e898c9527a8",
      "text": "喔？是他派你們來找我的嗎？",
      "encoded_ascii": "^+T^.V^,X^!@^.n^*F^*{^!O^$/^$%^&Z^+X^.V",
      "encoded_base64": "XitUXi5WXixYXiFAXi5uXipGXip7XiFPXiQvXiQlXiZaXitYXi5W",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_2c17a5bb0a6a",
      "text": "我敢肯定，他向你們描繪的我對國王的忠誠，與我剛才說的 ",
      "encoded_ascii": "^$%^/m^-Z^#.^*A^!@^+?^*F^*{^/g^0,^&Z^$%^#:^+^^-)^&Z^.d^2E^*A^'p^$%^+0^$,^-x^&Z ",
      "encoded_base64": "XiQlXi9tXi1aXiMuXipBXiFAXis/XipGXip7Xi9nXjAsXiZaXiQlXiM6XiteXi0pXiZaXi5kXjJFXipBXidwXiQlXiswXiQsXi14XiZaIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_f0485d27b51c",
      "text": "大相徑庭。他大概把我形容成某個保守偏執的 ",
      "encoded_ascii": "^\"z^&a^#c^3E^!\"^!@^\"z^,d^$1^$%^#_^+t^$$^%$^!V^!T^#+^![^3?^&Z ",
      "encoded_base64": "XiJ6XiZhXiNjXjNFXiEiXiFAXiJ6XixkXiQxXiQlXiNfXit0XiQkXiUkXiFWXiFUXiMrXiFbXjM/XiZaIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_b923d8e9558a",
      "text": "瘋子了吧。 ",
      "encoded_ascii": "^-/^#(^*D^*I^!\" ",
      "encoded_base64": "Xi0vXiMoXipEXipJXiEiIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_2c3458c7af4b",
      "text": "啊！你這叛徒蠕蟲！我要把你踩在腳下碾碎！",
      "encoded_ascii": "^+Q^*W^*F^(s^.Z^#d^07^(8^*W^$%^(C^$1^*F^0A^\"d^00^!(^0$^&o^*W",
      "encoded_base64": "XitRXipXXipGXihzXi5aXiNkXjA3Xig4XipXXiQlXihDXiQxXipGXjBBXiJkXjAwXiEoXjAkXiZvXipX",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_4ca581fef37e",
      "text": "衛兵！",
      "encoded_ascii": "^(=^+,^*W",
      "encoded_base64": "Xig9XissXipX",
      "byte_length": 9
    },
    {
      "unit_id": "DLG_fe5cb5a5ffd3",
      "text": "塔拉的笑聲在空洞中迴盪，隨後消逝無蹤。",
      "encoded_ascii": "^\"o^$6^&Z^-@^-W^\"d^'(^%h^!,^0D^0\"^*A^)X^#b^%k^0E^%}^(b^!\"",
      "encoded_base64": "XiJvXiQ2XiZaXi1AXi1XXiJkXicoXiVoXiEsXjBEXjAiXipBXilYXiNiXiVrXjBFXiV9XihiXiEi",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_0575adfdf1e5",
      "text": "看來你的母親從未教過你，刺探黑暗角落有多愚蠢。 ",
      "encoded_ascii": "^*Q^!O^*F^&Z^/s^(F^#f^,_^,R^(x^*F^*A^!w^$>^*:^$k^(H^-`^$s^\"x^/a^.u^!\" ",
      "encoded_base64": "XipRXiFPXipGXiZaXi9zXihGXiNmXixfXixSXih4XipGXipBXiF3XiQ+Xio6XiRrXihIXi1gXiRzXiJ4Xi9hXi51XiEiIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_c73a32f098c2",
      "text": "現在，你們要為她的過失付出代價！",
      "encoded_ascii": "^&?^\"d^*A^*F^*{^(C^%{^+h^&Z^(x^\"|^*u^!q^*v^+&^*W",
      "encoded_base64": "XiY/XiJkXipBXipGXip7XihDXiV7XitoXiZaXih4XiJ8Xip1XiFxXip2XismXipX",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_4bc652d260f7",
      "text": "  至少我還有母親！",
      "encoded_ascii": "  ^'n^#<^$%^.7^$s^/s^(F^*W",
      "encoded_base64": "ICBeJ25eIzxeJCVeLjdeJHNeL3NeKEZeKlc=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_4ff77d4166cf",
      "text": "  不好意思，我這就走。",
      "encoded_ascii": "  ^!)^+i^#z^#q^*A^$%^(s^*J^.&^!\"",
      "encoded_base64": "ICBeISleK2leI3peI3FeKkFeJCVeKHNeKkpeLiZeISI=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_e8a024e38d87",
      "text": "那麼你死的時候至少還有個名字可以哭喊！",
      "encoded_ascii": "^)!^.T^*F^%L^&Z^$f^*|^'n^#<^.7^$s^!V^\"F^#)^\"A^!B^/U^+S^*W",
      "encoded_base64": "XikhXi5UXipGXiVMXiZaXiRmXip8XiduXiM8Xi43XiRzXiFWXiJGXiMpXiJBXiFCXi9VXitTXipX",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_72834c8c62c2",
      "text": "藉口是小孩子說的，死人沒資格找藉口！",
      "encoded_ascii": "^04^\"<^,X^#;^+m^#(^-x^&Z^*A^%L^!<^%\\^(X^%*^$/^04^\"<^*W",
      "encoded_base64": "XjA0XiI8XixYXiM7XittXiMoXi14XiZaXipBXiVMXiE8XiVcXihYXiUqXiQvXjA0XiI8XipX",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_04dca7456ece",
      "text": "我叫你們滾開！",
      "encoded_ascii": "^$%^+<^*F^*{^,z^)F^*W",
      "encoded_base64": "XiQlXis8XipGXip7Xix6XilGXipX",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_ddb3c377fd0a",
      "text": "請你們現在離開。我必須回去挖礦了。",
      "encoded_ascii": "^*S^*F^*{^&?^\"d^)`^)F^!\"^$%^#l^)r^\"\\^\"6^2!^5m^*D^!\"",
      "encoded_base64": "XipTXipGXip7XiY/XiJkXilgXilGXiEiXiQlXiNsXilyXiJcXiI2XjIhXjVtXipEXiEi",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_c04e615806b9",
      "text": "謝謝你們！我欠你們一條命！收下這份寶物，作為對你們偉大 ",
      "encoded_ascii": "^-z^-z^*F^*{^*W^$%^,g^*F^*{^!%^%.^\"N^*W^$M^!(^(s^*x^#4^&4^*A^!M^%{^#:^*F^*{^*}^\"z ",
      "encoded_base64": "Xi16Xi16XipGXip7XipXXiQlXixnXipGXip7XiElXiUuXiJOXipXXiRNXiEoXihzXip4XiM0XiY0XipBXiFNXiV7XiM6XipGXip7Xip9XiJ6IA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_9766d723ff7a",
      "text": "善行的酬謝。",
      "encoded_ascii": "^1(^(;^&Z^7o^-z^!\"",
      "encoded_base64": "XjEoXig7XiZaXjdvXi16XiEi",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_b848286f235f",
      "text": "現在，請你們離開，好讓我回去挖礦。告辭。",
      "encoded_ascii": "^&?^\"d^*A^*S^*F^*{^)`^)F^*A^+i^-}^$%^\"\\^\"6^2!^5m^!\"^+B^2M^!\"",
      "encoded_base64": "XiY/XiJkXipBXipTXipGXip7XilgXilGXipBXitpXi19XiQlXiJcXiI2XjIhXjVtXiEiXitCXjJNXiEi",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_288aa31d0e48",
      "text": "聽著，我叫你們離開！ ",
      "encoded_ascii": "^-X^-a^*A^$%^+<^*F^*{^)`^)F^*W ",
      "encoded_base64": "Xi1YXi1hXipBXiQlXis8XipGXip7XilgXilGXipXIA==",
      "byte_length": 31
    },
    {
      "unit_id": "DLG_a408c4083d4a",
      "text": "聽著，我早就跟你們說過那個隱士是個荒蕪術士！你們為什麼不去 ",
      "encoded_ascii": "^-X^-a^*A^$%^,V^*J^.+^*F^*{^-x^(x^)!^!V^)Y^+a^,X^!V^1W^4b^(<^+a^*W^*F^*{^%{^!=^.T^!)^\"6 ",
      "encoded_base64": "Xi1YXi1hXipBXiQlXixWXipKXi4rXipGXip7Xi14Xih4XikhXiFWXilZXithXixYXiFWXjFXXjRiXig8XithXipXXipGXip7XiV7XiE9Xi5UXiEpXiI2IA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_96442e8bf005",
      "text": "問他自己呢？我跟你們沒什麼好說的了。 ",
      "encoded_ascii": "^*Z^!@^'l^#I^+C^.V^$%^.+^*F^*{^%\\^!=^.T^+i^-x^&Z^*D^!\" ",
      "encoded_base64": "XipaXiFAXidsXiNJXitDXi5WXiQlXi4rXipGXip7XiVcXiE9Xi5UXitpXi14XiZaXipEXiEiIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_db000c6cdf34",
      "text": "又怎麼了？我不是叫你們滾出這裡嗎！ ",
      "encoded_ascii": "^+;^,,^.T^*D^.V^$%^!)^,X^+<^*F^*{^,z^!q^(s^-j^+X^*W ",
      "encoded_base64": "Xis7XiwsXi5UXipEXi5WXiQlXiEpXixYXis8XipGXip7Xix6XiFxXihzXi1qXitYXipXIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_8eceff9fa5ea",
      "text": "請離開這片區域。",
      "encoded_ascii": "^*S^)`^)F^(s^&1^\"+^\"k^!\"",
      "encoded_base64": "XipTXilgXilGXihzXiYxXiIrXiJrXiEi",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_dfff72343995",
      "text": "  憑什麼？",
      "encoded_ascii": "  ^,5^!=^.T^.V",
      "encoded_base64": "ICBeLDVeIT1eLlReLlY=",
      "byte_length": 14
    },
    {
      "unit_id": "DLG_700d1173609d",
      "text": "  你認不認識以前住在這附近的隱士？",
      "encoded_ascii": "  ^*F^(O^!)^(O^(R^!B^!z^*z^\"d^(s^.?^(l^&Z^)Y^+a^.V",
      "encoded_base64": "ICBeKkZeKE9eISleKE9eKFJeIUJeIXpeKnpeImReKHNeLj9eKGxeJlpeKVleK2FeLlY=",
      "byte_length": 50
    },
    {
      "unit_id": "DLG_89998811c5d9",
      "text": "  那個隱士說是你們把他趕走的。",
      "encoded_ascii": "  ^)!^!V^)Y^+a^-x^,X^*F^*{^$1^!@^0u^.&^&Z^!\"",
      "encoded_base64": "ICBeKSFeIVZeKVleK2FeLXheLFheKkZeKnteJDFeIUBeMHVeLiZeJlpeISI=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_2194a219d5fc",
      "text": "  我怎麼知道那個隱士是在說謊？",
      "encoded_ascii": "  ^$%^,,^.T^&h^(y^)!^!V^)Y^+a^,X^\"d^-x^3*^.V",
      "encoded_base64": "ICBeJCVeLCxeLlReJmheKHleKSFeIVZeKVleK2FeLFheImReLXheMypeLlY=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_40f524972ae4",
      "text": "  你們在這裡做什麼？",
      "encoded_ascii": "  ^*F^*{^\"d^(s^-j^*~^!=^.T^.V",
      "encoded_base64": "ICBeKkZeKnteImReKHNeLWpeKn5eIT1eLlReLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_2c4dee20ae6b",
      "text": "  我絕不走！",
      "encoded_ascii": "  ^$%^-I^!)^.&^*W",
      "encoded_base64": "ICBeJCVeLUleISleLiZeKlc=",
      "byte_length": 17
    },
    {
      "unit_id": "DLG_e156a9909ffb",
      "text": "  你為什麼要我離開？",
      "encoded_ascii": "  ^*F^%{^!=^.T^(C^$%^)`^)F^.V",
      "encoded_base64": "ICBeKkZeJXteIT1eLlReKENeJCVeKWBeKUZeLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_fa0a54401ea8",
      "text": "我這就離開。再見。",
      "encoded_ascii": "^$%^(s^*J^)`^)F^!\"^!l^-m^!\"",
      "encoded_base64": "XiQlXihzXipKXilgXilGXiEiXiFsXi1tXiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_af67f54997e3",
      "text": "如果我是你，我就會直接離開這裡。那個隱士在對你撒謊。",
      "encoded_ascii": "^#$^%!^$%^,X^*F^*A^$%^*J^$r^&`^$?^)`^)F^(s^-j^!\"^)!^!V^)Y^+a^\"d^#:^*F^<>^3*^!\"",
      "encoded_base64": "XiMkXiUhXiQlXixYXipGXipBXiQlXipKXiRyXiZgXiQ/XilgXilGXihzXi1qXiEiXikhXiFWXilZXithXiJkXiM6XipGXjw+XjMqXiEi",
      "byte_length": 78
    },
    {
      "unit_id": "DLG_b3b2eab43ba3",
      "text": "聽著，在這件事上你必須相信我。那個隱士是個荒蕪術士！那些火 ",
      "encoded_ascii": "^-X^-a^*A^\"d^(s^.W^*r^!'^*F^#l^)r^&a^!U^$%^!\"^)!^!V^)Y^+a^,X^!V^1W^4b^(<^+a^*W^)!^!8^%x ",
      "encoded_base64": "Xi1YXi1hXipBXiJkXihzXi5XXipyXiEnXipGXiNsXilyXiZhXiFVXiQlXiEiXikhXiFWXilZXithXixYXiFWXjFXXjRiXig8XithXipXXikhXiE4XiV4IA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_ef041fdb967b",
      "text": "元素全受他掌控！我們把他趕走，就是為了阻止他繼續 ",
      "encoded_ascii": "^!a^'=^!h^\";^!@^$;^$@^*W^$%^*{^$1^!@^0u^.&^*A^*J^,X^%{^*D^)L^%G^!@^-O^'M ",
      "encoded_base64": "XiFhXic9XiFoXiI7XiFAXiQ7XiRAXipXXiQlXip7XiQxXiFAXjB1Xi4mXipBXipKXixYXiV7XipEXilMXiVHXiFAXi1PXidNIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_f4724d4314bc",
      "text": "召喚牠們！現在快走吧！ ",
      "encoded_ascii": "^\"@^\"U^-#^*{^*W^&?^\"d^*L^.&^*I^*W ",
      "encoded_base64": "XiJAXiJVXi0jXip7XipXXiY/XiJkXipMXi4mXipJXipXIA==",
      "byte_length": 34
    },
    {
      "unit_id": "DLG_bbf2edcc6fc5",
      "text": "這片區域屬於我們，不歡迎任何入侵者！滾！",
      "encoded_ascii": "^(s^&1^\"+^\"k^#C^$^^$%^*{^*A^!)^%F^(k^!C^!L^!f^.X^'V^*W^,z^*W",
      "encoded_base64": "XihzXiYxXiIrXiJrXiNDXiReXiQlXip7XipBXiEpXiVGXihrXiFDXiFMXiFmXi5YXidWXipXXix6XipX",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_5f8329590ed5",
      "text": "我不認識什麼隱士。給我滾出這裡！",
      "encoded_ascii": "^$%^!)^(O^(R^!=^.T^)Y^+a^!\"^'A^$%^,z^!q^(s^-j^*W",
      "encoded_base64": "XiQlXiEpXihPXihSXiE9Xi5UXilZXithXiEiXidBXiQlXix6XiFxXihzXi1qXipX",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_e8327ee46399",
      "text": "那不關你的事。滾開！",
      "encoded_ascii": "^)!^!)^.>^*F^&Z^*r^!\"^,z^)F^*W",
      "encoded_base64": "XikhXiEpXi4+XipGXiZaXipyXiEiXix6XilGXipX",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_7a3820e1e8a2",
      "text": "別再回來了！",
      "encoded_ascii": "^*H^!l^\"\\^!O^*D^*W",
      "encoded_base64": "XipIXiFsXiJcXiFPXipEXipX",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_8931ad04cf09",
      "text": "如果你們不滾出這裡，我們就會動用武力把你們轟出去。滾開！",
      "encoded_ascii": "^#$^%!^*F^*{^!)^,z^!q^(s^-j^*A^$%^*{^*J^$r^\"%^&H^%J^!~^$1^*F^*{^.y^!q^\"6^!\"^,z^)F^*W",
      "encoded_base64": "XiMkXiUhXipGXip7XiEpXix6XiFxXihzXi1qXipBXiQlXip7XipKXiRyXiIlXiZIXiVKXiF+XiQxXipGXip7Xi55XiFxXiI2XiEiXix6XilGXipX",
      "byte_length": 84
    },
    {
      "unit_id": "DLG_a71b72d086d1",
      "text": "這裡不歡迎入侵者。滾遠點！",
      "encoded_ascii": "^(s^-j^!)^%F^(k^!f^.X^'V^!\"^,z^({^*;^*W",
      "encoded_base64": "XihzXi1qXiEpXiVGXihrXiFmXi5YXidWXiEiXix6Xih7Xio7XipX",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_cb55266e83a7",
      "text": "我知道你們已經消滅了那個隱士。謝謝你們。現在我們不會再受到 ",
      "encoded_ascii": "^$%^&h^(y^*F^*{^#J^'D^%k^%t^*D^)!^!V^)Y^+a^!\"^-z^-z^*F^*{^!\"^&?^\"d^$%^*{^!)^$r^!l^\";^!u ",
      "encoded_base64": "XiQlXiZoXih5XipGXip7XiNKXidEXiVrXiV0XipEXikhXiFWXilZXithXiEiXi16Xi16XipGXip7XiEiXiY/XiJkXiQlXip7XiEpXiRyXiFsXiI7XiF1IA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_df0726089f62",
      "text": "火元素的騷擾了。他過去一直在從這道地裂中召喚牠們，誰知道 ",
      "encoded_ascii": "^%x^!a^'=^&Z^0y^$K^*D^!\"^!@^(x^\"6^!%^&`^\"d^#f^(s^(y^\"e^8r^!,^\"@^\"U^-#^*{^*A^-y^&h^(y ",
      "encoded_base64": "XiV4XiFhXic9XiZaXjB5XiRLXipEXiEiXiFAXih4XiI2XiElXiZgXiJkXiNmXihzXih5XiJlXjhyXiEsXiJAXiJVXi0jXip7XipBXi15XiZoXih5IA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_6e17c1e8b113",
      "text": "要是你們沒有阻止他，他還會給亞薩斯引來多少這種怪物。 ",
      "encoded_ascii": "^(C^,X^*F^*{^%\\^$s^)L^%G^!@^*A^!@^.7^$r^'A^!9^-e^$[^#Z^!O^\"x^#<^(s^'$^#s^&4^!\" ",
      "encoded_base64": "XihDXixYXipGXip7XiVcXiRzXilMXiVHXiFAXipBXiFAXi43XiRyXidBXiE5Xi1lXiRbXiNaXiFPXiJ4XiM8XihzXickXiNzXiY0XiEiIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_205577fa01d6",
      "text": "為了表達我的謝意，請收下這只靈能手鐲。 ",
      "encoded_ascii": "^%{^*D^-i^(z^$%^&Z^-z^#z^*A^*S^$M^!(^(s^\"?^)g^'b^$+^98^!\" ",
      "encoded_base64": "XiV7XipEXi1pXih6XiQlXiZaXi16XiN6XipBXipTXiRNXiEoXihzXiI/XilnXidiXiQrXjk4XiEiIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_52452dcd2e8f",
      "text": "你們身上裝不下了，我就先把它留在這裡給你們。 ",
      "encoded_ascii": "^*F^*{^(c^!'^(A^!)^!(^*D^*A^$%^*J^!b^$1^+o^-+^\"d^(s^-j^'A^*F^*{^!\" ",
      "encoded_base64": "XipGXip7XihjXiEnXihBXiEpXiEoXipEXipBXiQlXipKXiFiXiQxXitvXi0rXiJkXihzXi1qXidBXipGXip7XiEiIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_2602be9703f1",
      "text": "恭喜！隊伍獲得了 4000 點經驗值！ ",
      "encoded_ascii": "^1{^+V^*W^)U^!F^&:^#e^*D 4000 ^*;^'D^.P^!Z^*W ",
      "encoded_base64": "XjF7XitWXipXXilVXiFGXiY6XiNlXipEIDQwMDAgXio7XidEXi5QXiFaXipXIA==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_c81874f9fa22",
      "text": "嗨。我是賈哈德王子，德懷爾國王的兒子。看噴泉裡的那些魚！ ",
      "encoded_ascii": "^9}^!\"^$%^,X^/J^+F^#j^-)^#(^*A^#j^,9^&/^+^^-)^&Z^++^#(^!\"^*Q^\"W^%a^-j^&Z^)!^!8^:'^*W ",
      "encoded_base64": "Xjl9XiEiXiQlXixYXi9KXitGXiNqXi0pXiMoXipBXiNqXiw5XiYvXiteXi0pXiZaXisrXiMoXiEiXipRXiJXXiVhXi1qXiZaXikhXiE4XjonXipXIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_a2789c989f67",
      "text": "我真想把牠們抓起來，但父親不准我這麼做。",
      "encoded_ascii": "^$%^-2^,1^$1^-#^*{^$2^.(^!O^*A^!I^5d^(F^!)^/Q^$%^(s^.T^*~^!\"",
      "encoded_base64": "XiQlXi0yXiwxXiQxXi0jXip7XiQyXi4oXiFPXipBXiFJXjVkXihGXiEpXi9RXiQlXihzXi5UXip+XiEi",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_2ff4644ab829",
      "text": "  什麼魚？",
      "encoded_ascii": "  ^!=^.T^:'^.V",
      "encoded_base64": "ICBeIT1eLlReOideLlY=",
      "byte_length": 14
    },
    {
      "unit_id": "DLG_47d92522d55b",
      "text": "  為什麼庭院裡會有血跡？",
      "encoded_ascii": "  ^%{^!=^.T^3E^3/^-j^$r^$s^(:^(`^.V",
      "encoded_base64": "ICBeJXteIT1eLlReM0VeMy9eLWpeJHJeJHNeKDpeKGBeLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_560f3689fb2b",
      "text": "  妳為何會在這裡？",
      "encoded_ascii": "  ^7(^%{^!L^$r^\"d^(s^-j^.V",
      "encoded_base64": "ICBeNyheJXteIUxeJHJeImReKHNeLWpeLlY=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_dddec1ce95cc",
      "text": "  誰要被處決？",
      "encoded_ascii": "  ^-y^(C^(@^(,^,o^.V",
      "encoded_base64": "ICBeLXleKENeKEBeKCxeLG9eLlY=",
      "byte_length": 20
    },
    {
      "unit_id": "DLG_dd7f3ec22b44",
      "text": "  為什麼那些蘇隆蟲人會在這裡？",
      "encoded_ascii": "  ^%{^!=^.T^)!^!8^4c^)T^(8^!<^$r^\"d^(s^-j^.V",
      "encoded_base64": "ICBeJXteIT1eLlReKSFeITheNGNeKVReKDheITxeJHJeImReKHNeLWpeLlY=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_666b5040363d",
      "text": "哈蒙德",
      "encoded_ascii": "^+F^-c^#j",
      "encoded_base64": "XitGXi1jXiNq",
      "byte_length": 9
    },
    {
      "unit_id": "DLG_1033b697f5c8",
      "text": "看到那些綠色和紅色的小傢伙了嗎？牠們是我的最愛。我真希望自己能變成 ",
      "encoded_ascii": "^*Q^!u^)!^!8^3V^'s^\"O^3!^'s^&Z^#;^+#^*y^*D^+X^.V^-#^*{^,X^$%^&Z^$q^,2^!\"^$%^-2^+{^,]^'l^#I^'b^(U^$$ ",
      "encoded_base64": "XipRXiF1XikhXiE4XjNWXidzXiJPXjMhXidzXiZaXiM7XisjXip5XipEXitYXi5WXi0jXip7XixYXiQlXiZaXiRxXiwyXiEiXiQlXi0yXit7XixdXidsXiNJXidiXihVXiQkIA==",
      "byte_length": 100
    },
    {
      "unit_id": "DLG_d6aa60befb61",
      "text": "一條魚，那我就能整天游來游去，也不用去讀書了。 ",
      "encoded_ascii": "^!%^%.^:'^*A^)!^$%^*J^'b^$T^+e^8i^!O^8i^\"6^*A^!1^!)^&H^\"6^7I^$p^*D^!\" ",
      "encoded_base64": "XiElXiUuXjonXipBXikhXiQlXipKXidiXiRUXitlXjhpXiFPXjhpXiI2XipBXiExXiEpXiZIXiI2XjdJXiRwXipEXiEiIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_251e514b9fba",
      "text": "我每天這個時候都在這裡。這可是我逃避那該死的 ",
      "encoded_ascii": "^$%^%P^+e^(s^!V^$f^*|^)$^\"d^(s^-j^!\"^(s^\"A^,X^$%^(p^0F^)!^(M^%L^&Z ",
      "encoded_base64": "XiQlXiVQXitlXihzXiFWXiRmXip8XikkXiJkXihzXi1qXiEiXihzXiJBXixYXiQlXihwXjBGXikhXihNXiVMXiZaIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_34ff1b3fa418",
      "text": "識字閱讀課的藉口。",
      "encoded_ascii": "^(R^#)^:&^7I^:$^&Z^04^\"<^!\"",
      "encoded_base64": "XihSXiMpXjomXjdJXjokXiZaXjA0XiI8XiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_665763ded8eb",
      "text": "噢！那是行刑用的斬首台，我們在那裡處決犯人。很快就有一場處決 ",
      "encoded_ascii": "^+]^*W^)!^,X^(;^9|^&H^&Z^9B^)~^\"B^*A^$%^*{^\"d^)!^-j^(,^,o^-%^!<^!\"^*K^*L^*J^$s^!%^\"n^(,^,o ",
      "encoded_base64": "XitdXipXXikhXixYXig7Xjl8XiZIXiZaXjlCXil+XiJCXipBXiQlXip7XiJkXikhXi1qXigsXixvXi0lXiE8XiEiXipLXipMXipKXiRzXiElXiJuXigsXixvIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_e78a7b040bba",
      "text": "要舉行了。 ",
      "encoded_ascii": "^(C^01^(;^*D^!\" ",
      "encoded_base64": "XihDXjAxXig7XipEXiEiIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_22b8ce0db8ef",
      "text": "克拉格。他以前專門幫我父親做決策。父親不准我去看 ",
      "encoded_ascii": "^!d^$6^%*^!\"^!@^!B^!z^#8^)D^+}^$%^5d^(F^*~^,o^5p^!\"^5d^(F^!)^/Q^$%^\"6^*Q ",
      "encoded_base64": "XiFkXiQ2XiUqXiEiXiFAXiFCXiF6XiM4XilEXit9XiQlXjVkXihGXip+XixvXjVwXiEiXjVkXihGXiEpXi9RXiQlXiI2XipRIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_1b16d98e25cd",
      "text": "斬首。他說我年紀太小——會做噩夢。但我以前早就看過幾次 ",
      "encoded_ascii": "^9B^)~^!\"^!@^-x^$%^+~^2:^+f^#;^*n^*n^$r^*~^/X^\"y^!\"^!I^$%^!B^!z^,V^*J^*Q^(x^#T^%D ",
      "encoded_base64": "XjlCXil+XiEiXiFAXi14XiQlXit+XjI6XitmXiM7XipuXipuXiRyXip+Xi9YXiJ5XiEiXiFJXiQlXiFCXiF6XixWXipKXipRXih4XiNUXiVEIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_2ea3f35d54e6",
      "text": "了——只不過他不知道而已。",
      "encoded_ascii": "^*D^*n^*n^\"?^!)^(x^!@^!)^&h^(y^'W^#J^!\"",
      "encoded_base64": "XipEXipuXipuXiI/XiEpXih4XiFAXiEpXiZoXih5XidXXiNKXiEi",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_a36980079eef",
      "text": "父親把牠們召喚來，希望能變得更聰明。他不准我拿巨靈神燈來玩。他說 ",
      "encoded_ascii": "^5d^(F^$1^-#^*{^\"@^\"U^!O^*A^+{^,]^'b^(U^#e^$o^2=^$c^!\"^!@^!)^/Q^$%^,G^#H^)g^&w^93^!O^4U^!\"^!@^-x ",
      "encoded_base64": "XjVkXihGXiQxXi0jXip7XiJAXiJVXiFPXipBXit7XixdXidiXihVXiNlXiRvXjI9XiRjXiEiXiFAXiEpXi9RXiQlXixHXiNIXilnXiZ3XjkzXiFPXjRVXiEiXiFAXi14IA==",
      "byte_length": 97
    },
    {
      "unit_id": "DLG_7b4711e41376",
      "text": "那只能留到緊急關頭才能用。 ",
      "encoded_ascii": "^)!^\"?^'b^-+^!u^0r^3p^.>^)t^$,^'b^&H^!\" ",
      "encoded_base64": "XikhXiI/XidiXi0rXiF1XjByXjNwXi4+Xil0XiQsXidiXiZIXiEiIA==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_9002ab335d1e",
      "text": "有空再來找我玩喔。",
      "encoded_ascii": "^$s^'(^!l^!O^$/^$%^4U^+T^!\"",
      "encoded_base64": "XiRzXicoXiFsXiFPXiQvXiQlXjRVXitUXiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_8a4de93a20f0",
      "text": "感謝你們的慈悲之舉。正如我所承諾的，這就是巨靈神燈。此外，我還要把 ",
      "encoded_ascii": "^#{^-z^*F^*{^&Z^3H^,.^!/^01^!\"^%H^#$^$%^$)^$0^7k^&Z^*A^(s^*J^,X^#H^)g^&w^93^!\"^%I^\"w^*A^$%^.7^(C^$1 ",
      "encoded_base64": "XiN7Xi16XipGXip7XiZaXjNIXiwuXiEvXjAxXiEiXiVIXiMkXiQlXiQpXiQwXjdrXiZaXipBXihzXipKXixYXiNIXilnXiZ3XjkzXiEiXiVJXiJ3XipBXiQlXi43XihDXiQxIA==",
      "byte_length": 100
    },
    {
      "unit_id": "DLG_6af2f44cf8a4",
      "text": "我當初為了爭奪巨靈而戰的兵刃贈予你們——這柄處刑人之斧。 ",
      "encoded_ascii": "^$%^&N^1\"^%{^*D^1I^1,^#H^)g^'W^$(^&Z^+,^!r^([^!4^*F^*{^*n^*n^(s^%#^(,^9|^!<^!/^$Z^!\" ",
      "encoded_base64": "XiQlXiZOXjEiXiV7XipEXjFJXjEsXiNIXilnXidXXiQoXiZaXissXiFyXihbXiE0XipGXip7XipuXipuXihzXiUjXigsXjl8XiE8XiEvXiRaXiEiIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_52ecebd923f6",
      "text": "站住！報上名來！ ",
      "encoded_ascii": "^->^*z^*W^+`^!'^\"F^!O^*W ",
      "encoded_base64": "Xi0+Xip6XipXXitgXiEnXiJGXiFPXipXIA==",
      "byte_length": 25
    },
    {
      "unit_id": "DLG_b5ef7432668b",
      "text": "  我憑什麼要告訴你？",
      "encoded_ascii": "  ^$%^,5^!=^.T^(C^+B^-t^*F^.V",
      "encoded_base64": "ICBeJCVeLDVeIT1eLlReKENeK0JeLXReKkZeLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_4375cdaa196e",
      "text": "抱歉，我這就離開。 ",
      "encoded_ascii": "^,@^,h^*A^$%^(s^*J^)`^)F^!\" ",
      "encoded_base64": "XixAXixoXipBXiQlXihzXipKXilgXilGXiEiIA==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_03350272e03e",
      "text": "不行。未經准許，你們不得在王宮裡到處亂逛。我會親自押送 ",
      "encoded_ascii": "^!)^(;^!\"^,_^'D^/Q^-s^*A^*F^*{^!)^#e^\"d^-)^/\\^-j^!u^(,^!3^8A^!\"^$%^$r^(F^'l^7Z^./ ",
      "encoded_base64": "XiEpXig7XiEiXixfXidEXi9RXi1zXipBXipGXip7XiEpXiNlXiJkXi0pXi9cXi1qXiF1XigsXiEzXjhBXiEiXiQlXiRyXihGXidsXjdaXi4vIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_99dd076ca904",
      "text": "你們去宮殿大門。跟我來。 ",
      "encoded_ascii": "^*F^*{^\"6^/\\^.m^\"z^)D^!\"^.+^$%^!O^!\" ",
      "encoded_base64": "XipGXip7XiI2Xi9cXi5tXiJ6XilEXiEiXi4rXiQlXiFPXiEiIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_1a6cb6ebab14",
      "text": "報上你們的名字，否則我會將你們逐出王宮領地。",
      "encoded_ascii": "^+`^!'^*F^*{^&Z^\"F^#)^*A^\"H^!x^$%^$r^#7^*F^*{^(r^!q^-)^/\\^)s^\"e^!\"",
      "encoded_base64": "XitgXiEnXipGXip7XiZaXiJGXiMpXipBXiJIXiF4XiQlXiRyXiM3XipGXip7XihyXiFxXi0pXi9cXilzXiJlXiEi",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_6e1b5475e1bd",
      "text": "跟我走，否則我會將你們視為非法侵入者，並依律處置。 ",
      "encoded_ascii": "^.+^$%^.&^*A^\"H^!x^$%^$r^#7^*F^*{^(E^%{^)i^%b^.X^!f^'V^*A^!+^!Q^7W^(,^'Q^!\" ",
      "encoded_base64": "Xi4rXiQlXi4mXipBXiJIXiF4XiQlXiRyXiM3XipGXip7XihFXiV7XilpXiViXi5YXiFmXidWXipBXiErXiFRXjdXXigsXidRXiEiIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_0b63388e1a77",
      "text": "你們在科布諾爾有何貴幹？ ",
      "encoded_ascii": "^*F^*{^\"d^'!^.`^7k^&/^$s^!L^2F^,!^.V ",
      "encoded_base64": "XipGXip7XiJkXichXi5gXjdrXiYvXiRzXiFMXjJGXiwhXi5WIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_b6caa248593e",
      "text": "  科布諾爾？那是哪裡？ ",
      "encoded_ascii": "  ^'!^.`^7k^&/^.V^)!^,X^+I^-j^.V ",
      "encoded_base64": "ICBeJyFeLmBeN2teJi9eLlZeKSFeLFheK0leLWpeLlYg",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_72bbfb30a08d",
      "text": "  我是來取走巨靈神燈的。",
      "encoded_ascii": "  ^$%^,X^!O^\":^.&^#H^)g^&w^93^&Z^!\"",
      "encoded_base64": "ICBeJCVeLFheIU9eIjpeLiZeI0heKWdeJndeOTNeJlpeISI=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_5d3764038796",
      "text": "  我是來晉見國王的。",
      "encoded_ascii": "  ^$%^,X^!O^2n^-m^+^^-)^&Z^!\"",
      "encoded_base64": "ICBeJCVeLFheIU9eMm5eLW1eK15eLSleJlpeISI=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_c5549666cd28",
      "text": "  我是來組建聯軍的。",
      "encoded_ascii": "  ^$%^,X^!O^2;^,'^-V^..^&Z^!\"",
      "encoded_base64": "ICBeJCVeLFheIU9eMjteLCdeLVZeLi5eJlpeISI=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_f9331249a2e4",
      "text": "你們正身處科布諾爾王宮。如果你們連這座城市都不知道，那你們在此肯定無事可辦 ",
      "encoded_ascii": "^*F^*{^%H^(c^(,^'!^.`^7k^&/^-)^/\\^!\"^#$^%!^*F^*{^.0^(s^/_^+_^+z^)$^!)^&h^(y^*A^)!^*F^*{^\"d^%I^-Z^#.^%}^*r^\"A^2L ",
      "encoded_base64": "XipGXip7XiVIXihjXigsXichXi5gXjdrXiYvXi0pXi9cXiEiXiMkXiUhXipGXip7Xi4wXihzXi9fXitfXit6XikkXiEpXiZoXih5XipBXikhXipGXip7XiJkXiVJXi1aXiMuXiV9XipyXiJBXjJMIA==",
      "byte_length": 112
    },
    {
      "unit_id": "DLG_d823e4d7638f",
      "text": "。 ",
      "encoded_ascii": "^!\" ",
      "encoded_base64": "XiEiIA==",
      "byte_length": 4
    },
    {
      "unit_id": "DLG_e1aa38f64603",
      "text": "休得愚妄。巨靈是國王的私有財產，只有他才能驅使巨靈的神力。 ",
      "encoded_ascii": "^!G^#e^/a^+j^!\"^#H^)g^,X^+^^-)^&Z^&~^$s^0=^&G^*A^\"?^$s^!@^$,^'b^*#^!N^#H^)g^&Z^&w^!~^!\" ",
      "encoded_base64": "XiFHXiNlXi9hXitqXiEiXiNIXilnXixYXiteXi0pXiZaXiZ+XiRzXjA9XiZHXipBXiI/XiRzXiFAXiQsXidiXiojXiFOXiNIXilnXiZaXiZ3XiF+XiEiIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_fcd125d06cab",
      "text": "你們現在必須立刻離開。 ",
      "encoded_ascii": "^*F^*{^&?^\"d^#l^)r^0'^.Y^)`^)F^!\" ",
      "encoded_base64": "XipGXip7XiY/XiJkXiNsXilyXjAnXi5ZXilgXilGXiEiIA==",
      "byte_length": 34
    },
    {
      "unit_id": "DLG_419a598127ba",
      "text": "德懷爾國王今日不接見外客。你們改天再來吧。 ",
      "encoded_ascii": "^#j^,9^&/^+^^-)^*E^$a^!)^$?^-m^\"w^+q^!\"^*F^*{^$N^+e^!l^!O^*I^!\" ",
      "encoded_base64": "XiNqXiw5XiYvXiteXi0pXipFXiRhXiEpXiQ/Xi1tXiJ3XitxXiEiXipGXip7XiROXitlXiFsXiFPXipJXiEiIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_73d0d63673f0",
      "text": "唯有國王才能做出此類決策，而他現在不接見訪客。我 ",
      "encoded_ascii": "^+O^$s^+^^-)^$,^'b^*~^!q^%I^)w^,o^5p^*A^'W^!@^&?^\"d^!)^$?^-m^4d^+q^!\"^$% ",
      "encoded_base64": "XitPXiRzXiteXi0pXiQsXidiXip+XiFxXiVJXil3XixvXjVwXipBXidXXiFAXiY/XiJkXiEpXiQ/Xi1tXjRkXitxXiEiXiQlIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_02b1448fab99",
      "text": "將會親自押送你們去宮門。 ",
      "encoded_ascii": "^#7^$r^(F^'l^7Z^./^*F^*{^\"6^/\\^)D^!\" ",
      "encoded_base64": "XiM3XiRyXihGXidsXjdaXi4vXipGXip7XiI2Xi9cXilEXiEiIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_8cf6d751eb0d",
      "text": "王宮有入侵者！攔住他們！ ",
      "encoded_ascii": "^-)^/\\^$s^!f^.X^'V^*W^9n^*z^!@^*{^*W ",
      "encoded_base64": "Xi0pXi9cXiRzXiFmXi5YXidWXipXXjluXip6XiFAXip7XipXIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_7397c3f5f4d4",
      "text": "未獲邀請，不得擅自進入王宮。",
      "encoded_ascii": "^,_^&:^:%^*S^*A^!)^#e^2$^'l^(w^!f^-)^/\\^!\"",
      "encoded_base64": "XixfXiY6XjolXipTXipBXiEpXiNlXjIkXidsXih3XiFmXi0pXi9cXiEi",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_42a5d4dba7b4",
      "text": "你能看見城裡的衛隊正開始在宮外重新集結整隊。",
      "encoded_ascii": "^*F^'b^*Q^-m^+_^-j^&Z^(=^)U^%H^)F^+k^\"d^/\\^\"w^))^$\\^)]^'@^$T^)U^!\"",
      "encoded_base64": "XipGXidiXipRXi1tXitfXi1qXiZaXig9XilVXiVIXilGXitrXiJkXi9cXiJ3XikpXiRcXildXidAXiRUXilVXiEi",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_b223d8c0cab8",
      "text": "卡瑪爾",
      "encoded_ascii": "^\"0^-*^&/",
      "encoded_base64": "XiIwXi0qXiYv",
      "byte_length": 9
    },
    {
      "unit_id": "DLG_50288ab935e0",
      "text": "我現在就召喚幽影軍團與你們並肩作戰——記住，你們必須 ",
      "encoded_ascii": "^$%^&?^\"d^*J^\"@^\"U^2f^#a^..^0V^'p^*F^*{^!+^:#^!M^$(^*n^*n^(K^*z^*A^*F^*{^#l^)r ",
      "encoded_base64": "XiQlXiY/XiJkXipKXiJAXiJVXjJmXiNhXi4uXjBWXidwXipGXip7XiErXjojXiFNXiQoXipuXipuXihLXip6XipBXipGXip7XiNsXilyIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_67034bfd3570",
      "text": "直取指揮官！他才是這支軍團的核心靈魂！ ",
      "encoded_ascii": "^&`^\":^$8^2\"^#-^*W^!@^$,^,X^(s^$L^..^0V^&Z^:\"^#k^)g^*.^*W ",
      "encoded_base64": "XiZgXiI6XiQ4XjIiXiMtXipXXiFAXiQsXixYXihzXiRMXi4uXjBWXiZaXjoiXiNrXilnXiouXipXIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_053e0df327ef",
      "text": "  你是做什麼的？",
      "encoded_ascii": "  ^*F^,X^*~^!=^.T^&Z^.V",
      "encoded_base64": "ICBeKkZeLFheKn5eIT1eLlReJlpeLlY=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_8c4e72a38926",
      "text": "  這座城市究竟發生了什麼事？",
      "encoded_ascii": "  ^(s^/_^+_^+z^-<^28^&W^&F^*D^!=^.T^*r^.V",
      "encoded_base64": "ICBeKHNeL19eK19eK3peLTxeMjheJldeJkZeKkReIT1eLlReKnJeLlY=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_75e31eb6afc3",
      "text": "  這座城市已經徹底破敗凋零了。",
      "encoded_ascii": "  ^(s^/_^+_^+z^#J^'D^18^/^^&n^$R^9{^9*^*D^!\"",
      "encoded_base64": "ICBeKHNeL19eK19eK3peI0peJ0ReMTheL15eJm5eJFJeOXteOSpeKkReISI=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_75964ab684c9",
      "text": "  這座城市早就已經被黃沙掩埋了。",
      "encoded_ascii": "  ^(s^/_^+_^+z^,V^*J^#J^'D^(@^*7^%]^9~^1r^*D^!\"",
      "encoded_base64": "ICBeKHNeL19eK19eK3peLFZeKkpeI0peJ0ReKEBeKjdeJV1eOX5eMXJeKkReISI=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_2bc713993b26",
      "text": "  你對克拉格了解多少？",
      "encoded_ascii": "  ^*F^#:^!d^$6^%*^*D^(I^\"x^#<^.V",
      "encoded_base64": "ICBeKkZeIzpeIWReJDZeJSpeKkReKEleInheIzxeLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_6144083732e5",
      "text": "  他為什麼會被處決？",
      "encoded_ascii": "  ^!@^%{^!=^.T^$r^(@^(,^,o^.V",
      "encoded_base64": "ICBeIUBeJXteIT1eLlReJHJeKEBeKCxeLG9eLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_09d6ba934d4f",
      "text": "你們好。我是馬廄長埃利亞姆。我瞧你們身邊連一隻厄德陸鳥也沒帶。",
      "encoded_ascii": "^*F^*{^+i^!\"^$%^,X^*\"^0Z^)C^/&^!t^!9^#%^!\"^$%^-4^*F^*{^(c^.8^.0^!%^)[^80^#j^99^4p^!1^%\\^#N^!\"",
      "encoded_base64": "XipGXip7XitpXiEiXiQlXixYXioiXjBaXilDXi8mXiF0XiE5XiMlXiEiXiQlXi00XipGXip7XihjXi44Xi4wXiElXilbXjgwXiNqXjk5XjRwXiExXiVcXiNOXiEi",
      "byte_length": 93
    },
    {
      "unit_id": "DLG_15f9efd9f4d3",
      "text": "我在幹活。",
      "encoded_ascii": "^$%^\"d^,!^%i^!\"",
      "encoded_base64": "XiQlXiJkXiwhXiVpXiEi",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_0caaa35126a9",
      "text": "我是個鐵匠，負責照料王宮裡的厄德陸鳥。你們跑進這裡來， ",
      "encoded_ascii": "^$%^,X^!V^)?^7S^*A^(W^0>^/x^/n^-)^/\\^-j^&Z^80^#j^99^4p^!\"^*F^*{^(_^(w^(s^-j^!O^*A ",
      "encoded_base64": "XiQlXixYXiFWXik/XjdTXipBXihXXjA+Xi94Xi9uXi0pXi9cXi1qXiZaXjgwXiNqXjk5XjRwXiEiXipGXip7XihfXih3XihzXi1qXiFPXipBIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_ab2195eb3e51",
      "text": "不正是為了這個嗎？",
      "encoded_ascii": "^!)^%H^,X^%{^*D^(s^!V^+X^.V",
      "encoded_base64": "XiEpXiVIXixYXiV7XipEXihzXiFWXitYXi5W",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_b97b790694c1",
      "text": "老實講，我一直忙於手頭的活計，根本沒機會抽空 ",
      "encoded_ascii": "^'U^#3^6+^*A^$%^!%^&`^,+^$^^$+^)t^&Z^%i^-n^*A^%)^$x^%\\^%>^$r^*_^'( ",
      "encoded_base64": "XidVXiMzXjYrXipBXiQlXiElXiZgXiwrXiReXiQrXil0XiZaXiVpXi1uXipBXiUpXiR4XiVcXiU+XiRyXipfXicoIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_906a61a57c15",
      "text": "到王宮周圍去轉轉。 ",
      "encoded_ascii": "^!u^-)^/\\^\"L^\"`^\"6^(i^(i^!\" ",
      "encoded_base64": "XiF1Xi0pXi9cXiJMXiJgXiI2XihpXihpXiEiIA==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_37867ee47e83",
      "text": "怎麼了？出了什麼事嗎？ ",
      "encoded_ascii": "^,,^.T^*D^.V^!q^*D^!=^.T^*r^+X^.V ",
      "encoded_base64": "XiwsXi5UXipEXi5WXiFxXipEXiE9Xi5UXipyXitYXi5WIA==",
      "byte_length": 34
    },
    {
      "unit_id": "DLG_bb5fba6c64c8",
      "text": "怎麼說？",
      "encoded_ascii": "^,,^.T^-x^.V",
      "encoded_base64": "XiwsXi5UXi14Xi5W",
      "byte_length": 12
    },
    {
      "unit_id": "DLG_0ba4bca03d8c",
      "text": "我……我還有工作要做。我建議你們快點離開。",
      "encoded_ascii": "^$%^*o^*o^$%^.7^$s^+y^!M^(C^*~^!\"^$%^,'^-|^*F^*{^*L^*;^)`^)F^!\"",
      "encoded_base64": "XiQlXipvXipvXiQlXi43XiRzXit5XiFNXihDXip+XiEiXiQlXiwnXi18XipGXip7XipMXio7XilgXilGXiEi",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_a4acb2325e7f",
      "text": "今天下午就要處決克拉格了。全城的人都會 ",
      "encoded_ascii": "^*E^+e^!(^+8^*J^(C^(,^,o^!d^$6^%*^*D^!\"^!h^+_^&Z^!<^)$^$r ",
      "encoded_base64": "XipFXitlXiEoXis4XipKXihDXigsXixvXiFkXiQ2XiUqXipEXiEiXiFoXitfXiZaXiE8XikkXiRyIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_305f923b9f1d",
      "text": "跑去圍觀",
      "encoded_ascii": "^(_^\"6^\"`^*R",
      "encoded_base64": "XihfXiI2XiJgXipS",
      "byte_length": 12
    },
    {
      "unit_id": "DLG_2671bb42177a",
      "text": "，但我還得工作",
      "encoded_ascii": "^*A^!I^$%^.7^#e^+y^!M",
      "encoded_base64": "XipBXiFJXiQlXi43XiNlXit5XiFN",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_9273a1c55db3",
      "text": "據我所聽說的，他是因為國王做出的一項決定，而動手掌摑了德懷爾國王。",
      "encoded_ascii": "^5T^$%^$)^-X^-x^&Z^*A^!@^,X^\"]^%{^+^^-)^*~^!q^&Z^!%^)q^,o^#.^*A^'W^\"%^$+^$;^:!^*D^#j^,9^&/^+^^-)^!\"",
      "encoded_base64": "XjVUXiQlXiQpXi1YXi14XiZaXipBXiFAXixYXiJdXiV7XiteXi0pXip+XiFxXiZaXiElXilxXixvXiMuXipBXidXXiIlXiQrXiQ7XjohXipEXiNqXiw5XiYvXiteXi0pXiEi",
      "byte_length": 99
    },
    {
      "unit_id": "DLG_8e5aa47ba186",
      "text": "要是你們需要照料厄德陸鳥，你們知道該送到哪裡來。",
      "encoded_ascii": "^(C^,X^*F^*{^)e^(C^/x^/n^80^#j^99^4p^*A^*F^*{^&h^(y^(M^./^!u^+I^-j^!O^!\"",
      "encoded_base64": "XihDXixYXipGXip7XillXihDXi94Xi9uXjgwXiNqXjk5XjRwXipBXipGXip7XiZoXih5XihNXi4vXiF1XitJXi1qXiFPXiEi",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_6f6a5150e7ba",
      "text": "你們好。你們也是來看斬首的嗎？我自己也在等呢。 ",
      "encoded_ascii": "^*F^*{^+i^!\"^*F^*{^!1^,X^!O^*Q^9B^)~^&Z^+X^.V^$%^'l^#I^!1^\"d^'-^+C^!\" ",
      "encoded_base64": "XipGXip7XitpXiEiXipGXip7XiExXixYXiFPXipRXjlCXil+XiZaXitYXi5WXiQlXidsXiNJXiExXiJkXictXitDXiEiIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_fa327fc9a78d",
      "text": "我們這裡可有好長一段時間沒處決過犯人了——你們真該留下來看看。",
      "encoded_ascii": "^$%^*{^(s^-j^\"A^$s^+i^)C^!%^.l^$f^)G^%\\^(,^,o^(x^-%^!<^*D^*n^*n^*F^*{^-2^(M^-+^!(^!O^*Q^*Q^!\"",
      "encoded_base64": "XiQlXip7XihzXi1qXiJBXiRzXitpXilDXiElXi5sXiRmXilHXiVcXigsXixvXih4Xi0lXiE8XipEXipuXipuXipGXip7Xi0yXihNXi0rXiEoXiFPXipRXipRXiEi",
      "byte_length": 93
    },
    {
      "unit_id": "DLG_05eb00064aa2",
      "text": "  這座城市已經毀了！ ",
      "encoded_ascii": "  ^(s^/_^+_^+z^#J^'D^%N^*D^*W ",
      "encoded_base64": "ICBeKHNeL19eK19eK3peI0peJ0ReJU5eKkReKlcg",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_80e9cce2238a",
      "text": "  什麼處決？",
      "encoded_ascii": "  ^!=^.T^(,^,o^.V",
      "encoded_base64": "ICBeIT1eLlReKCxeLG9eLlY=",
      "byte_length": 17
    },
    {
      "unit_id": "DLG_2986238f8bbc",
      "text": "  他做了什麼事？",
      "encoded_ascii": "  ^!@^*~^*D^!=^.T^*r^.V",
      "encoded_base64": "ICBeIUBeKn5eKkReIT1eLlReKnJeLlY=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_74e6392dbd14",
      "text": "你說什麼？",
      "encoded_ascii": "^*F^-x^!=^.T^.V",
      "encoded_base64": "XipGXi14XiE9Xi5UXi5W",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_22ecfff7eee6",
      "text": "也許就你們習慣的標準來看是如此，但對我來說可不是。這裡可是個宜居的美好之處， ",
      "encoded_ascii": "^!1^-s^*J^*F^*{^3{^$!^&Z^%9^,x^!O^*Q^,X^#$^%I^*A^!I^#:^$%^!O^-x^\"A^!)^,X^!\"^(s^-j^\"A^,X^!V^/[^+w^&Z^-P^+i^!/^(,^*A ",
      "encoded_base64": "XiExXi1zXipKXipGXip7XjN7XiQhXiZaXiU5Xix4XiFPXipRXixYXiMkXiVJXipBXiFJXiM6XiQlXiFPXi14XiJBXiEpXixYXiEiXihzXi1qXiJBXixYXiFWXi9bXit3XiZaXi1QXitpXiEvXigsXipBIA==",
      "byte_length": 115
    },
    {
      "unit_id": "DLG_1fa5b45e6049",
      "text": "外鄉人。瞧瞧那些雄偉的塔樓！那些亭閣華廈與精美掛毯！ ",
      "encoded_ascii": "^\"w^6<^!<^!\"^-4^-4^)!^!8^)\\^*}^&Z^\"o^0g^*W^)!^!8^:*^6~^3'^:5^'p^'7^-P^$=^%S^*W ",
      "encoded_base64": "XiJ3XjY8XiE8XiEiXi00Xi00XikhXiE4XilcXip9XiZaXiJvXjBnXipXXikhXiE4XjoqXjZ+XjMnXjo1XidwXic3Xi1QXiQ9XiVTXipXIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_0ced4dfdb3b3",
      "text": "德懷爾國王的顧問克拉格被判處斬首。",
      "encoded_ascii": "^#j^,9^&/^+^^-)^&Z^4n^*Z^!d^$6^%*^(@^1k^(,^9B^)~^!\"",
      "encoded_base64": "XiNqXiw5XiYvXiteXi0pXiZaXjRuXipaXiFkXiQ2XiUqXihAXjFrXigsXjlCXil+XiEi",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_861ee5286d4b",
      "text": "他公然質疑國王做出的決策。",
      "encoded_ascii": "^!@^3:^&\"^(Z^0p^+^^-)^*~^!q^&Z^,o^5p^!\"",
      "encoded_base64": "XiFAXjM6XiYiXihaXjBwXiteXi0pXip+XiFxXiZaXixvXjVwXiEi",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_820fc5d814ad",
      "text": "我也不太清楚。不過他肯定是把國王給徹底惹毛了——克拉格 ",
      "encoded_ascii": "^$%^!1^!)^+f^,u^,c^!\"^!)^(x^!@^-Z^#.^,X^$1^+^^-)^'A^18^/^^3s^%R^*D^*n^*n^!d^$6^%* ",
      "encoded_base64": "XiQlXiExXiEpXitmXix1XixjXiEiXiEpXih4XiFAXi1aXiMuXixYXiQxXiteXi0pXidBXjE4Xi9eXjNzXiVSXipEXipuXipuXiFkXiQ2XiUqIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_5656d1f4b057",
      "text": "過去可是國王最信任的親信顧問呢。 ",
      "encoded_ascii": "^(x^\"6^\"A^,X^+^^-)^$q^!U^!C^&Z^(F^!U^4n^*Z^+C^!\" ",
      "encoded_base64": "Xih4XiI2XiJBXixYXiteXi0pXiRxXiFVXiFDXiZaXihGXiFVXjRuXipaXitDXiEiIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_c8ff46bf8225",
      "text": "國王召喚牠們是為了獲取牠們的知識。蘇隆蟲人比我們 ",
      "encoded_ascii": "^+^^-)^\"@^\"U^-#^*{^,X^%{^*D^&:^\":^-#^*{^&Z^&h^(R^!\"^4c^)T^(8^!<^,m^$%^*{ ",
      "encoded_base64": "XiteXi0pXiJAXiJVXi0jXip7XixYXiV7XipEXiY6XiI6Xi0jXip7XiZaXiZoXihSXiEiXjRjXilUXig4XiE8XixtXiQlXip7IA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_450f08cfb7be",
      "text": "先進得多。牠們承諾會讓這座城市擁有遠遠超越其他任何地方的 ",
      "encoded_ascii": "^!b^(w^#e^\"x^!\"^-#^*{^$0^7k^$r^-}^(s^/_^+_^+z^,M^$s^({^({^(\\^(]^!j^!@^!C^!L^\"e^$]^&Z ",
      "encoded_base64": "XiFiXih3XiNlXiJ4XiEiXi0jXip7XiQwXjdrXiRyXi19XihzXi9fXitfXit6XixNXiRzXih7Xih7XihcXihdXiFqXiFAXiFDXiFMXiJlXiRdXiZaIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_ae5837c8b99f",
      "text": "強大力量。 ",
      "encoded_ascii": "^#]^\"z^!~^)*^!\" ",
      "encoded_base64": "XiNdXiJ6XiF+XikqXiEiIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_78b9524abcab",
      "text": "別走開太久。行刑馬上就要開始了。",
      "encoded_ascii": "^*H^.&^)F^+f^!.^!\"^(;^9|^*\"^!'^*J^(C^)F^+k^*D^!\"",
      "encoded_base64": "XipIXi4mXilGXitmXiEuXiEiXig7Xjl8XioiXiEnXipKXihDXilGXitrXipEXiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_185fa21c8863",
      "text": "這份卷軸上的字跡奇蹟般地抵擋住了歲月殘酷的 ",
      "encoded_ascii": "^(s^*x^\"3^(e^!'^&Z^#)^(`^\"}^0B^'r^\"e^$5^$G^*z^*D^,j^/p^,l^1b^&Z ",
      "encoded_base64": "XihzXip4XiIzXihlXiEnXiZaXiMpXihgXiJ9XjBCXidyXiJlXiQ1XiRHXip6XipEXixqXi9wXixsXjFiXiZaIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_3c64ec208dcc",
      "text": "侵蝕，看起來就如同昨日剛寫下的一般。 ",
      "encoded_ascii": "^.X^(4^*A^*Q^.(^!O^*J^#$^\"E^:9^$a^+0^/]^!(^&Z^!%^'r^!\" ",
      "encoded_base64": "Xi5YXig0XipBXipRXi4oXiFPXipKXiMkXiJFXjo5XiRhXiswXi9dXiEoXiZaXiElXidyXiEiIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_7c27c731278f",
      "text": "愚蠢的國王！光是要我替他去搜尋神燈巨靈還嫌不夠， ",
      "encoded_ascii": "^/a^.u^&Z^+^^-)^*W^!c^,X^(C^$%^2o^!@^\"6^/h^#9^&w^93^#H^)g^.7^:4^!)^+d^*A ",
      "encoded_base64": "Xi9hXi51XiZaXiteXi0pXipXXiFjXixYXihDXiQlXjJvXiFAXiI2Xi9oXiM5XiZ3XjkzXiNIXilnXi43Xjo0XiEpXitkXipBIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_6dc6a005219e",
      "text": "現在他竟然連蘇隆蟲人的知識也想染指？ ",
      "encoded_ascii": "^&?^\"d^!@^28^&\"^.0^4c^)T^(8^!<^&Z^&h^(R^!1^,1^%%^$8^.V ",
      "encoded_base64": "XiY/XiJkXiFAXjI4XiYiXi4wXjRjXilUXig4XiE8XiZaXiZoXihSXiExXiwxXiUlXiQ4Xi5WIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_b47f18e2a794",
      "text": "我真不明白自己為何還得迎合這個蠢貨。他在外交上的手腕根本無法與 ",
      "encoded_ascii": "^$%^-2^!)^$c^&X^'l^#I^%{^!L^.7^#e^(k^\"C^(s^!V^.u^.w^!\"^!@^\"d^\"w^0P^!'^&Z^$+^'e^%)^$x^%}^%b^'p ",
      "encoded_base64": "XiQlXi0yXiEpXiRjXiZYXidsXiNJXiV7XiFMXi43XiNlXihrXiJDXihzXiFWXi51Xi53XiEiXiFAXiJkXiJ3XjBQXiEnXiZaXiQrXidlXiUpXiR4XiV9XiViXidwIA==",
      "byte_length": 94
    },
    {
      "unit_id": "DLG_85fb5c123c5d",
      "text": "蘇隆蟲人的狡詐相提並論。召喚牠們肯定會惹出滔天禍端…… ",
      "encoded_ascii": "^4c^)T^(8^!<^&Z^::^6(^&a^$A^!+^1\\^!\"^\"@^\"U^-#^*{^-Z^#.^$r^3s^!q^2t^+e^7B^5o^*o^*o ",
      "encoded_base64": "XjRjXilUXig4XiE8XiZaXjo6XjYoXiZhXiRBXiErXjFcXiEiXiJAXiJVXi0jXip7Xi1aXiMuXiRyXjNzXiFxXjJ0XitlXjdCXjVvXipvXipvIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_0cecd5ad254b",
      "text": "不過，我料想牠們也休想比得過我的智慧——看著牠們屈服在更高超的心智 ",
      "encoded_ascii": "^!)^(x^*A^$%^/n^,1^-#^*{^!1^!G^,1^,m^#e^(x^$%^&Z^$i^4;^*n^*n^*Q^-a^-#^*{^5K^,\\^\"d^$o^*+^(\\^&Z^#k^$i ",
      "encoded_base64": "XiEpXih4XipBXiQlXi9uXiwxXi0jXip7XiExXiFHXiwxXixtXiNlXih4XiQlXiZaXiRpXjQ7XipuXipuXipRXi1hXi0jXip7XjVLXixcXiJkXiRvXiorXihcXiZaXiNrXiRpIA==",
      "byte_length": 100
    },
    {
      "unit_id": "DLG_24184a8a1d0a",
      "text": "之下痛苦扭曲，倒也挺有趣的。或許我可以姑且順從蠢蛋 ",
      "encoded_ascii": "^!/^!(^-.^.t^1;^$n^*A^!X^!1^,I^$s^.*^&Z^!\"^$'^-s^$%^\"A^!B^:3^!*^.D^#f^.u^6\" ",
      "encoded_base64": "XiEvXiEoXi0uXi50XjE7XiRuXipBXiFYXiExXixJXiRzXi4qXiZaXiEiXiQnXi1zXiQlXiJBXiFCXjozXiEqXi5EXiNmXi51XjYiIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_e81b1ba3a08b",
      "text": "德懷爾的意思，把牠們從星界位面召喚過來。 ",
      "encoded_ascii": "^#j^,9^&/^&Z^#z^#q^*A^$1^-#^*{^#f^$e^.p^!J^)j^\"@^\"U^(x^!O^!\" ",
      "encoded_base64": "XiNqXiw5XiYvXiZaXiN6XiNxXipBXiQxXi0jXip7XiNmXiRlXi5wXiFKXilqXiJAXiJVXih4XiFPXiEiIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_b4baaa7dd854",
      "text": "握住寶珠的瞬間，你被早已逝去之人的記憶與強烈情緒 ",
      "encoded_ascii": "^1>^*z^#4^&>^&Z^1N^)G^*A^*F^(@^,V^#J^0E^\"6^!/^!<^&Z^(K^$\"^'p^#]^%|^,0^3# ",
      "encoded_base64": "XjE+Xip6XiM0XiY+XiZaXjFOXilHXipBXipGXihAXixWXiNKXjBFXiI2XiEvXiE8XiZaXihLXiQiXidwXiNdXiV8XiwwXjMjIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_13bf5eb7fffe",
      "text": "猛烈衝擊。你感覺自己被硬生生拖回到了另一個時代……",
      "encoded_ascii": "^*P^%|^-h^$F^!\"^*F^#{^(G^'l^#I^(@^25^&F^&F^.f^\"\\^!u^*D^\">^!%^!V^$f^*v^*o^*o",
      "encoded_base64": "XipQXiV8Xi1oXiRGXiEiXipGXiN7XihHXidsXiNJXihAXjI1XiZGXiZGXi5mXiJcXiF1XipEXiI+XiElXiFWXiRmXip2XipvXipv",
      "byte_length": 75
    },
    {
      "unit_id": "DLG_1b259d77d78a",
      "text": "〈這些蘇隆蟲人根本毫無力量！束縛結界已經夠薄弱了——牠們為何 ",
      "encoded_ascii": "^:(^(s^!8^4c^)T^(8^!<^%)^$x^/t^%}^!~^)*^*W^$|^3W^'@^.p^#J^'D^+d^6o^#\\^*D^*n^*n^-#^*{^%{^!L ",
      "encoded_base64": "XjooXihzXiE4XjRjXilUXig4XiE8XiUpXiR4Xi90XiV9XiF+XikqXipXXiR8XjNXXidAXi5wXiNKXidEXitkXjZvXiNcXipEXipuXipuXi0jXip7XiV7XiFMIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_be712e2e39e8",
      "text": "還不掙脫？我肯定是高估牠們了。看來在整個阿塔斯，我恐怕永遠都找不到 ",
      "encoded_ascii": "^.7^!)^.g^'c^.V^$%^-Z^#.^,X^*+^:+^-#^*{^*D^!\"^*Q^!O^\"d^$T^!V^)M^\"o^$[^*A^$%^#t^0^^%W^({^)$^$/^!)^!u ",
      "encoded_base64": "Xi43XiEpXi5nXidjXi5WXiQlXi1aXiMuXixYXiorXjorXi0jXip7XipEXiEiXipRXiFPXiJkXiRUXiFWXilNXiJvXiRbXipBXiQlXiN0XjBeXiVXXih7XikkXiQvXiEpXiF1IA==",
      "byte_length": 100
    },
    {
      "unit_id": "DLG_4eb8aeb508db",
      "text": "足以匹敵我力量的對手了。肯——〉 ",
      "encoded_ascii": "^(^^!B^8w^$U^$%^!~^)*^&Z^#:^$+^*D^!\"^-Z^*n^*n^:) ",
      "encoded_base64": "XiheXiFCXjh3XiRVXiQlXiF+XikqXiZaXiM6XiQrXipEXiEiXi1aXipuXipuXjopIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_30f9c21f0712",
      "text": "〈那個蠢貨現在又想幹嘛？〉",
      "encoded_ascii": "^:(^)!^!V^.u^.w^&?^\"d^+;^,1^,!^+Y^.V^:)",
      "encoded_base64": "XjooXikhXiFWXi51Xi53XiY/XiJkXis7XiwxXiwhXitZXi5WXjop",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_b1088dc621e3",
      "text": "在，陛下有何吩咐？ ",
      "encoded_ascii": "^\"d^*A^:@^!(^$s^!L^:.^:/^.V ",
      "encoded_base64": "XiJkXipBXjpAXiEoXiRzXiFMXjouXjovXi5WIA==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_93c37f8960ac",
      "text": "羅德，把力場撤除，好讓我們能與這些高貴的生物交談。 ",
      "encoded_ascii": "^/?^#j^*A^$1^!~^\"n^:7^)Q^*A^+i^-}^$%^*{^'b^'p^(s^!8^*+^2F^&Z^&F^&4^0P^0;^!\" ",
      "encoded_base64": "Xi8/XiNqXipBXiQxXiF+XiJuXjo3XilRXipBXitpXi19XiQlXip7XidiXidwXihzXiE4XiorXjJGXiZaXiZGXiY0XjBQXjA7XiEiIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_e3e9ff65b98e",
      "text": "遵命，陛下。〈雖然這不過耗費我微不足道的一星點力量，但我就照辦吧。〉 ",
      "encoded_ascii": "^4#^\"N^*A^:@^!(^!\"^:(^.A^&\"^(s^!)^(x^'X^.\"^$%^#i^!)^(^^(y^&Z^!%^$e^*;^!~^)*^*A^!I^$%^*J^/x^2L^*I^!\"^:) ",
      "encoded_base64": "XjQjXiJOXipBXjpAXiEoXiEiXjooXi5BXiYiXihzXiEpXih4XidYXi4iXiQlXiNpXiEpXiheXih5XiZaXiElXiRlXio7XiF+XikqXipBXiFJXiQlXipKXi94XjJMXipJXiEiXjopIA==",
      "byte_length": 103
    },
    {
      "unit_id": "DLG_70c9ee02a362",
      "text": "〈這些生物根本構不成威脅。牠們的狡黠肯定是誇大其詞的神話。不過，傳言若毫無 ",
      "encoded_ascii": "^:(^(s^!8^&F^&4^%)^$x^8~^!)^$$^#&^1T^!\"^-#^*{^&Z^::^:A^-Z^#.^,X^6w^\"z^!j^.v^&Z^&w^-v^!\"^!)^(x^*A^+$^1Y^'x^/t^%} ",
      "encoded_base64": "XjooXihzXiE4XiZGXiY0XiUpXiR4Xjh+XiEpXiQkXiMmXjFUXiEiXi0jXip7XiZaXjo6XjpBXi1aXiMuXixYXjZ3XiJ6XiFqXi52XiZaXiZ3Xi12XiEiXiEpXih4XipBXiskXjFZXid4Xi90XiV9IA==",
      "byte_length": 112
    },
    {
      "unit_id": "DLG_f17c5687979f",
      "text": "真憑實據，倒也很難流傳得如此久遠。 ",
      "encoded_ascii": "^-2^,5^#3^5T^*A^!X^!1^*K^)a^%j^+$^#e^#$^%I^!.^({^!\" ",
      "encoded_base64": "Xi0yXiw1XiMzXjVUXipBXiFYXiExXipLXilhXiVqXiskXiNlXiMkXiVJXiEuXih7XiEiIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_f08f93ffaa44",
      "text": "我不禁——煩人的蟲子！大家為什麼都在尖叫？該不會——〉",
      "encoded_ascii": "^$%^!)^&y^*n^*n^-!^!<^&Z^(8^#(^*W^\"z^+s^%{^!=^.T^)$^\"d^#=^+<^.V^(M^!)^$r^*n^*n^:)",
      "encoded_base64": "XiQlXiEpXiZ5XipuXipuXi0hXiE8XiZaXig4XiMoXipXXiJ6XitzXiV7XiE9Xi5UXikkXiJkXiM9Xis8Xi5WXihNXiEpXiRyXipuXipuXjop",
      "byte_length": 81
    },
    {
      "unit_id": "DLG_8f787f68f858",
      "text": "思緒在此處變得混亂模糊。你隱約感受到一場慘烈的大戰，但 ",
      "encoded_ascii": "^#q^3#^\"d^%I^(,^(U^#e^%n^!3^%:^'8^!\"^*F^)Y^-F^#{^\";^!u^!%^\"n^,4^%|^&Z^\"z^$(^*A^!I ",
      "encoded_base64": "XiNxXjMjXiJkXiVJXigsXihVXiNlXiVuXiEzXiU6Xic4XiEiXipGXilZXi1GXiN7XiI7XiF1XiElXiJuXiw0XiV8XiZaXiJ6XiQoXipBXiFJIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_e622a9c4afa5",
      "text": "無法看清最終的結局。 ",
      "encoded_ascii": "^%}^%b^*Q^,u^$q^-H^&Z^'@^._^!\" ",
      "encoded_base64": "XiV9XiViXipRXix1XiRxXi1IXiZaXidAXi5fXiEiIA==",
      "byte_length": 31
    },
    {
      "unit_id": "DLG_66246739f6f5",
      "text": "當你鬆開手時，寶珠在掌中化作齏粉。 ",
      "encoded_ascii": "^&N^*F^.R^)F^$+^$f^*A^#4^&>^\"d^$;^!,^\")^!M^9g^'5^!\" ",
      "encoded_base64": "XiZOXipGXi5SXilGXiQrXiRmXipBXiM0XiY+XiJkXiQ7XiEsXiIpXiFNXjlnXic1XiEiIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_459b38425b33",
      "text": "這就是我的棺木。將我的遺體安放其中，我便能安息了。 ",
      "encoded_ascii": "^(s^*J^,X^$%^&Z^%2^$v^!\"^#7^$%^&Z^0v^**^+p^$P^!j^!,^*A^$%^!R^'b^+p^#w^*D^!\" ",
      "encoded_base64": "XihzXipKXixYXiQlXiZaXiUyXiR2XiEiXiM3XiQlXiZaXjB2XioqXitwXiRQXiFqXiEsXipBXiQlXiFSXidiXitwXiN3XipEXiEiIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_20d47298f1ec",
      "text": "向你致意，旅人。如你所見，我是來自過去的生靈，被困於此地。請傾聽 ",
      "encoded_ascii": "^+?^*F^'o^#z^*A^2m^!<^!\"^#$^*F^$)^-m^*A^$%^,X^!O^'l^(x^\"6^&Z^&F^)g^*A^(@^\"^^$^^%I^\"e^!\"^*S^2U^-X ",
      "encoded_base64": "Xis/XipGXidvXiN6XipBXjJtXiE8XiEiXiMkXipGXiQpXi1tXipBXiQlXixYXiFPXidsXih4XiI2XiZaXiZGXilnXipBXihAXiJeXiReXiVJXiJlXiEiXipTXjJVXi1YIA==",
      "byte_length": 97
    },
    {
      "unit_id": "DLG_c61847d9301d",
      "text": "我的故事： ",
      "encoded_ascii": "^$%^&Z^5U^*r^*B ",
      "encoded_base64": "XiQlXiZaXjVVXipyXipCIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_61007f9f61d2",
      "text": "  告訴我你的故事。 ",
      "encoded_ascii": "  ^+B^-t^$%^*F^&Z^5U^*r^!\" ",
      "encoded_base64": "ICBeK0JeLXReJCVeKkZeJlpeNVVeKnJeISIg",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_3b9504b5aeae",
      "text": "  你……你是個什麼東西？ ",
      "encoded_ascii": "  ^*F^*o^*o^*F^,X^!V^!=^.T^,`^-l^.V ",
      "encoded_base64": "ICBeKkZeKm9eKm9eKkZeLFheIVZeIT1eLlReLGBeLWxeLlYg",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_02de60e12673",
      "text": "  我沒時間聽。 ",
      "encoded_ascii": "  ^$%^%\\^$f^)G^-X^!\" ",
      "encoded_base64": "ICBeJCVeJVxeJGZeKUdeLVheISIg",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_9088ba95f6b9",
      "text": "我現在必須離開。 ",
      "encoded_ascii": "^$%^&?^\"d^#l^)r^)`^)F^!\" ",
      "encoded_base64": "XiQlXiY/XiJkXiNsXilyXilgXilGXiEiIA==",
      "byte_length": 25
    },
    {
      "unit_id": "DLG_e34f776df462",
      "text": "我是個蘇隆蟲人，來自一個遠比人類更古老的種族。我們受德懷爾國王 ",
      "encoded_ascii": "^$%^,X^!V^4c^)T^(8^!<^*A^!O^'l^!%^!V^({^,m^!<^)w^$o^\"=^'U^&Z^'$^5V^!\"^$%^*{^\";^#j^,9^&/^+^^-) ",
      "encoded_base64": "XiQlXixYXiFWXjRjXilUXig4XiE8XipBXiFPXidsXiElXiFWXih7XixtXiE8Xil3XiRvXiI9XidVXiZaXickXjVWXiEiXiQlXip7XiI7XiNqXiw5XiYvXiteXi0pIA==",
      "byte_length": 94
    },
    {
      "unit_id": "DLG_cb027db0d123",
      "text": "召喚來到這座城市，他渴求我們的知識。我們答應向國王傳授 ",
      "encoded_ascii": "^\"@^\"U^!O^!u^(s^/_^+_^+z^*A^!@^,w^,n^$%^*{^&Z^&h^(R^!\"^$%^*{^-B^0`^+?^+^^-)^+$^$: ",
      "encoded_base64": "XiJAXiJVXiFPXiF1XihzXi9fXitfXit6XipBXiFAXix3XixuXiQlXip7XiZaXiZoXihSXiEiXiQlXip7Xi1CXjBgXis/XiteXi0pXiskXiQ6IA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_5b1ea4746406",
      "text": "我們的心法，但城中卻出現了反對異議。 ",
      "encoded_ascii": "^$%^*{^&Z^#k^%b^*A^!I^+_^!,^1&^!q^&?^*D^\"9^#:^&M^-|^!\" ",
      "encoded_base64": "XiQlXip7XiZaXiNrXiViXipBXiFJXitfXiEsXjEmXiFxXiY/XipEXiI5XiM6XiZNXi18XiEiIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_92acc34842b9",
      "text": "  請繼續說。 ",
      "encoded_ascii": "  ^*S^-O^'M^-x^!\" ",
      "encoded_base64": "ICBeKlNeLU9eJ01eLXheISIg",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_5b9387f6d12a",
      "text": "  我不想聽這些。 ",
      "encoded_ascii": "  ^$%^!)^,1^-X^(s^!8^!\" ",
      "encoded_base64": "ICBeJCVeISleLDFeLVheKHNeITheISIg",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_44a4942dec04",
      "text": "我真的必須走了。 ",
      "encoded_ascii": "^$%^-2^&Z^#l^)r^.&^*D^!\" ",
      "encoded_base64": "XiQlXi0yXiZaXiNsXilyXi4mXipEXiEiIA==",
      "byte_length": 25
    },
    {
      "unit_id": "DLG_422b3cd751a3",
      "text": "我們索求的知識代價，不過是國王所擁有的一件小玩意——一只裝有巨靈的神燈。 ",
      "encoded_ascii": "^$%^*{^'>^,n^&Z^&h^(R^*v^+&^*A^!)^(x^,X^+^^-)^$)^,M^$s^&Z^!%^.W^#;^4U^#z^*n^*n^!%^\"?^(A^$s^#H^)g^&Z^&w^93^!\" ",
      "encoded_base64": "XiQlXip7Xic+XixuXiZaXiZoXihSXip2XismXipBXiEpXih4XixYXiteXi0pXiQpXixNXiRzXiZaXiElXi5XXiM7XjRVXiN6XipuXipuXiElXiI/XihBXiRzXiNIXilnXiZaXiZ3XjkzXiEiIA==",
      "byte_length": 109
    },
    {
      "unit_id": "DLG_2d81f8e0c3fd",
      "text": "當國王將此事告知內閣時，他的顧問克拉格出面反對。他宣稱 ",
      "encoded_ascii": "^&N^+^^-)^#7^%I^*r^+B^&h^!g^6~^$f^*A^!@^&Z^4n^*Z^!d^$6^%*^!q^)j^\"9^#:^!\"^!@^2d^0& ",
      "encoded_base64": "XiZOXiteXi0pXiM3XiVJXipyXitCXiZoXiFnXjZ+XiRmXipBXiFAXiZaXjRuXipaXiFkXiQ2XiUqXiFxXilqXiI5XiM6XiEiXiFAXjJkXjAmIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_422b85020730",
      "text": "我們會利用巨靈來毀滅這座城市。 ",
      "encoded_ascii": "^$%^*{^$r^!t^&H^#H^)g^!O^%N^%t^(s^/_^+_^+z^!\" ",
      "encoded_base64": "XiQlXip7XiRyXiF0XiZIXiNIXilnXiFPXiVOXiV0XihzXi9fXitfXit6XiEiIA==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_ba777cc4bcb9",
      "text": "  然後發生了什麼事？",
      "encoded_ascii": "  ^&\"^#b^&W^&F^*D^!=^.T^*r^.V",
      "encoded_base64": "ICBeJiJeI2JeJldeJkZeKkReIT1eLlReKnJeLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_8b3e4b9e16c3",
      "text": "  呃，這座城市「確實」被毀了啊……",
      "encoded_ascii": "  ^3<^*A^(s^/_^+_^+z^!#^-6^#3^!$^(@^%N^*D^+Q^*o^*o",
      "encoded_base64": "ICBeMzxeKkFeKHNeL19eK19eK3peISNeLTZeIzNeISReKEBeJU5eKkReK1FeKm9eKm8=",
      "byte_length": 50
    },
    {
      "unit_id": "DLG_b46e7fe3ffa3",
      "text": "我現在就要走！",
      "encoded_ascii": "^$%^&?^\"d^*J^(C^.&^*W",
      "encoded_base64": "XiQlXiY/XiJkXipKXihDXi4mXipX",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_7fc467e20f09",
      "text": "克拉格與國王爆發了激烈爭吵。在爭論白熱化之際，克拉格動手打了 ",
      "encoded_ascii": "^!d^$6^%*^'p^+^^-)^&*^&W^*D^1H^%|^1I^/T^!\"^\"d^1I^1\\^&X^&$^\")^!/^30^*A^!d^$6^%*^\"%^$+^$-^*D ",
      "encoded_base64": "XiFkXiQ2XiUqXidwXiteXi0pXiYqXiZXXipEXjFIXiV8XjFJXi9UXiEiXiJkXjFJXjFcXiZYXiYkXiIpXiEvXjMwXipBXiFkXiQ2XiUqXiIlXiQrXiQtXipEIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_f0e390b68409",
      "text": "國王。他被判處斬首，但他卻逃脫了，隨後再次當面質問國王， ",
      "encoded_ascii": "^+^^-)^!\"^!@^(@^1k^(,^9B^)~^*A^!I^!@^1&^(p^'c^*D^*A^)X^#b^!l^%D^&N^)j^(Z^*Z^+^^-)^*A ",
      "encoded_base64": "XiteXi0pXiEiXiFAXihAXjFrXigsXjlCXil+XipBXiFJXiFAXjEmXihwXidjXipEXipBXilYXiNiXiFsXiVEXiZOXilqXihaXipaXiteXi0pXipBIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_ba8b77b71e9a",
      "text": "並在搏鬥中殺害了國王。克拉格自己在打鬥中也身負致命重傷， ",
      "encoded_ascii": "^!+^\"d^,K^*,^!,^%M^#/^*D^+^^-)^!\"^!d^$6^%*^'l^#I^\"d^$-^*,^!,^!1^(c^(W^'o^\"N^))^!^^*A ",
      "encoded_base64": "XiErXiJkXixLXiosXiEsXiVNXiMvXipEXiteXi0pXiEiXiFkXiQ2XiUqXidsXiNJXiJkXiQtXiosXiEsXiExXihjXihXXidvXiJOXikpXiFeXipBIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_670132b829e0",
      "text": "但在嚥氣之前，他向巨靈下達了一道命令……",
      "encoded_ascii": "^!I^\"d^:1^%U^!/^!z^*A^!@^+?^#H^)g^!(^(z^*D^!%^(y^\"N^*w^*o^*o",
      "encoded_base64": "XiFJXiJkXjoxXiVVXiEvXiF6XipBXiFAXis/XiNIXilnXiEoXih6XipEXiElXih5XiJOXip3XipvXipv",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_110ce9d1f166",
      "text": "  命令是什麼？ ",
      "encoded_ascii": "  ^\"N^*w^,X^!=^.T^.V ",
      "encoded_base64": "ICBeIk5eKndeLFheIT1eLlReLlYg",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_b8178427365a",
      "text": "  我猜得到發生了什麼事……",
      "encoded_ascii": "  ^$%^-'^#e^!u^&W^&F^*D^!=^.T^*r^*o^*o",
      "encoded_base64": "ICBeJCVeLSdeI2VeIXVeJldeJkZeKkReIT1eLlReKnJeKm9eKm8=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_f56ef8d6064a",
      "text": "夠了！我要離開了！ ",
      "encoded_ascii": "^+d^*D^*W^$%^(C^)`^)F^*D^*W ",
      "encoded_base64": "XitkXipEXipXXiQlXihDXilgXilGXipEXipXIA==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_f6a6b4fe9b82",
      "text": "克拉格下的指令是「照顧好我們」。不幸的是，巨靈擅自決定了 ",
      "encoded_ascii": "^!d^$6^%*^!(^&Z^$8^*w^,X^!#^/x^4n^+i^$%^*{^!$^!\"^!)^15^&Z^,X^*A^#H^)g^2$^'l^,o^#.^*D ",
      "encoded_base64": "XiFkXiQ2XiUqXiEoXiZaXiQ4Xip3XixYXiEjXi94XjRuXitpXiQlXip7XiEkXiEiXiEpXjE1XiZaXixYXipBXiNIXilnXjIkXidsXixvXiMuXipEIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_91e7795e5cb7",
      "text": "具體執行方式，用一場沙塵暴將整座城市吞噬掩埋，奪走了全城所有人的性命—— ",
      "encoded_ascii": "^!k^**^3?^(;^$]^#X^*A^&H^!%^\"n^%]^\"p^$m^#7^$T^/_^+_^+z^:-^:0^9~^1r^*A^1,^.&^*D^!h^+_^$)^$s^!<^&Z^#r^\"N^*n^*n ",
      "encoded_base64": "XiFrXioqXjM/Xig7XiRdXiNYXipBXiZIXiElXiJuXiVdXiJwXiRtXiM3XiRUXi9fXitfXit6XjotXjowXjl+XjFyXipBXjEsXi4mXipEXiFoXitfXiQpXiRzXiE8XiZaXiNyXiJOXipuXipuIA==",
      "byte_length": 109
    },
    {
      "unit_id": "DLG_26222455c7f7",
      "text": "將我們所有人永恆地困在這裡。 ",
      "encoded_ascii": "^#7^$%^*{^$)^$s^!<^%W^:6^\"e^\"^^\"d^(s^-j^!\" ",
      "encoded_base64": "XiM3XiQlXip7XiQpXiRzXiE8XiVXXjo2XiJlXiJeXiJkXihzXi1qXiEiIA==",
      "byte_length": 43
    },
    {
      "unit_id": "DLG_a649ae5df794",
      "text": "  那必須做些什麼？",
      "encoded_ascii": "  ^)!^#l^)r^*~^!8^!=^.T^.V",
      "encoded_base64": "ICBeKSFeI2xeKXJeKn5eITheIT1eLlReLlY=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_dbefc2ee03b0",
      "text": "  那巨靈呢？",
      "encoded_ascii": "  ^)!^#H^)g^+C^.V",
      "encoded_base64": "ICBeKSFeI0heKWdeK0NeLlY=",
      "byte_length": 17
    },
    {
      "unit_id": "DLG_ddf434a94d5e",
      "text": "我不在乎。我走了。",
      "encoded_ascii": "^$%^!)^\"d^!0^!\"^$%^.&^*D^!\"",
      "encoded_base64": "XiQlXiEpXiJkXiEwXiEiXiQlXi4mXipEXiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_7dc7ded88b27",
      "text": "答案適時自會揭曉。靜心傾聽，你就會明白…… ",
      "encoded_ascii": "^-B^4|^(|^$f^'l^$r^$B^7y^!\"^)h^#k^2U^-X^*A^*F^*J^$r^$c^&X^*o^*o ",
      "encoded_base64": "Xi1CXjR8Xih8XiRmXidsXiRyXiRCXjd5XiEiXiloXiNrXjJVXi1YXipBXipGXipKXiRyXiRjXiZYXipvXipvIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_cd26f3108f92",
      "text": "你必須聽！我們的命運與這座城市緊密相繫，而你必須成為解除這場 ",
      "encoded_ascii": "^*F^#l^)r^-X^*W^$%^*{^&Z^\"N^.4^'p^(s^/_^+_^+z^0r^#0^&a^:;^*A^'W^*F^#l^)r^$$^%{^(I^)Q^(s^\"n ",
      "encoded_base64": "XipGXiNsXilyXi1YXipXXiQlXip7XiZaXiJOXi40XidwXihzXi9fXitfXit6XjByXiMwXiZhXjo7XipBXidXXipGXiNsXilyXiQkXiV7XihJXilRXihzXiJuIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_72a61f033107",
      "text": "奸邪背叛之人。傾聽我的敘述吧…… ",
      "encoded_ascii": "^:2^)\"^.r^.Z^!/^!<^!\"^2U^-X^$%^&Z^:8^68^*I^*o^*o ",
      "encoded_base64": "XjoyXikiXi5yXi5aXiEvXiE8XiEiXjJVXi1YXiQlXiZaXjo4XjY4XipJXipvXipvIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_3fc9e63eae1c",
      "text": "不行。你必須聽完我的故事，否則休想再前進一步！ ",
      "encoded_ascii": "^!)^(;^!\"^*F^#l^)r^-X^#,^$%^&Z^5U^*r^*A^\"H^!x^!G^,1^!l^!z^(w^!%^,i^*W ",
      "encoded_base64": "XiEpXig7XiEiXipGXiNsXilyXi1YXiMsXiQlXiZaXjVVXipyXipBXiJIXiF4XiFHXiwxXiFsXiF6Xih3XiElXixpXipXIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_f2243780ad8a",
      "text": "無論如何你都得聽。你是我們種族唯一的希望！我要繼續說了…… ",
      "encoded_ascii": "^%}^1\\^#$^!L^*F^)$^#e^-X^!\"^*F^,X^$%^*{^'$^5V^+O^!%^&Z^+{^,]^*W^$%^(C^-O^'M^-x^*D^*o^*o ",
      "encoded_base64": "XiV9XjFcXiMkXiFMXipGXikkXiNlXi1YXiEiXipGXixYXiQlXip7XickXjVWXitPXiElXiZaXit7XixdXipXXiQlXihDXi1PXidNXi14XipEXipvXipvIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_5649d690edd7",
      "text": "休想！要是你現在離開，我們的種族必將覆滅，而一旦發生這種事， ",
      "encoded_ascii": "^!G^,1^*W^(C^,X^*F^&?^\"d^)`^)F^*A^$%^*{^&Z^'$^5V^#l^#7^(D^%t^*A^'W^!%^1C^&W^&F^(s^'$^*r^*A ",
      "encoded_base64": "XiFHXiwxXipXXihDXixYXipGXiY/XiJkXilgXilGXipBXiQlXip7XiZaXickXjVWXiNsXiM3XihEXiV0XipBXidXXiElXjFDXiZXXiZGXihzXickXipyXipBIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_6b4857bcea15",
      "text": "從這座城市釋放出來的邪惡將會讓整個阿塔斯徹底屈膝淪亡。我會繼續說下去。 ",
      "encoded_ascii": "^#f^(s^/_^+_^+z^0w^$P^!q^!O^&Z^)\"^#y^#7^$r^-}^$T^!V^)M^\"o^$[^18^/^^5K^:<^2)^!:^!\"^$%^$r^-O^'M^-x^!(^\"6^!\" ",
      "encoded_base64": "XiNmXihzXi9fXitfXit6XjB3XiRQXiFxXiFPXiZaXikiXiN5XiM3XiRyXi19XiRUXiFWXilNXiJvXiRbXjE4Xi9eXjVLXjo8XjIpXiE6XiEiXiQlXiRyXi1PXidNXi14XiEoXiI2XiEiIA==",
      "byte_length": 106
    },
    {
      "unit_id": "DLG_c75aa74e6d22",
      "text": "誠然如此，但這絕非我們所為。讓我把話說完。 ",
      "encoded_ascii": "^2E^&\"^#$^%I^*A^!I^(s^-I^)i^$%^*{^$)^%{^!\"^-}^$%^$1^-v^-x^#,^!\" ",
      "encoded_base64": "XjJFXiYiXiMkXiVJXipBXiFJXihzXi1JXilpXiQlXip7XiQpXiV7XiEiXi19XiQlXiQxXi12Xi14XiMsXiEiIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_b135aa377c83",
      "text": "我快說完了，接著你就能將這座城市從克拉格的邪惡中解救出來。 ",
      "encoded_ascii": "^$%^*L^-x^#,^*D^*A^$?^-a^*F^*J^'b^#7^(s^/_^+_^+z^#f^!d^$6^%*^&Z^)\"^#y^!,^(I^,Q^!q^!O^!\" ",
      "encoded_base64": "XiQlXipMXi14XiMsXipEXipBXiQ/Xi1hXipGXipKXidiXiM3XihzXi9fXitfXit6XiNmXiFkXiQ2XiUqXiZaXikiXiN5XiEsXihJXixRXiFxXiFPXiEiIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_75542082aa57",
      "text": "要結束對話嗎？ ",
      "encoded_ascii": "^(C^'@^$|^#:^-v^+X^.V ",
      "encoded_base64": "XihDXidAXiR8XiM6Xi12XitYXi5WIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_45e3c1621ce0",
      "text": "如果你不肯聽，那你必定是與惡魔克拉格同流合污！ ",
      "encoded_ascii": "^#$^%!^*F^!)^-Z^-X^*A^)!^*F^#l^#.^,X^'p^#y^*0^!d^$6^%*^\"E^%j^\"C^0h^*W ",
      "encoded_base64": "XiMkXiUhXipGXiEpXi1aXi1YXipBXikhXipGXiNsXiMuXixYXidwXiN5XiowXiFkXiQ2XiUqXiJFXiVqXiJDXjBoXipXIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_dcc7b8180e8a",
      "text": "必須從克拉格手中奪回巨靈，我們才能逆轉他對這座城市所鑄下的 ",
      "encoded_ascii": "^#l^)r^#f^!d^$6^%*^$+^!,^1,^\"\\^#H^)g^*A^$%^*{^$,^'b^8c^(i^!@^#:^(s^/_^+_^+z^$)^:?^!(^&Z ",
      "encoded_base64": "XiNsXilyXiNmXiFkXiQ2XiUqXiQrXiEsXjEsXiJcXiNIXilnXipBXiQlXip7XiQsXidiXjhjXihpXiFAXiM6XihzXi9fXitfXit6XiQpXjo/XiEoXiZaIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_34dd13815ceb",
      "text": "大錯。要做到這點，你必須找到克拉格並將他除掉。絕無 ",
      "encoded_ascii": "^\"z^)5^!\"^(C^*~^!u^(s^*;^*A^*F^#l^)r^$/^!u^!d^$6^%*^!+^#7^!@^)Q^/e^!\"^-I^%} ",
      "encoded_base64": "XiJ6Xik1XiEiXihDXip+XiF1XihzXio7XipBXipGXiNsXilyXiQvXiF1XiFkXiQ2XiUqXiErXiM3XiFAXilRXi9lXiEiXi1JXiV9IA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_61e3e999e1ab",
      "text": "其他辦法——他造下的罪孽必須被徹底抹除。 ",
      "encoded_ascii": "^!j^!@^2L^%b^*n^*n^!@^(v^!(^&Z^5x^5I^#l^)r^(@^18^/^^4=^)Q^!\" ",
      "encoded_base64": "XiFqXiFAXjJMXiViXipuXipuXiFAXih2XiEoXiZaXjV4XjVJXiNsXilyXihAXjE4Xi9eXjQ9XilRXiEiIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_dacdbfbd8c0b",
      "text": "  克拉格在哪裡？",
      "encoded_ascii": "  ^!d^$6^%*^\"d^+I^-j^.V",
      "encoded_base64": "ICBeIWReJDZeJSpeImReK0leLWpeLlY=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_eeeda15d79e5",
      "text": "  你能跟我講講過去的事嗎？",
      "encoded_ascii": "  ^*F^'b^.+^$%^6+^6+^(x^\"6^&Z^*r^+X^.V",
      "encoded_base64": "ICBeKkZeJ2JeLiteJCVeNiteNiteKHheIjZeJlpeKnJeK1heLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_77e6c104d830",
      "text": "  得了吧，跟我說說過去的事吧。",
      "encoded_ascii": "  ^#e^*D^*I^*A^.+^$%^-x^-x^(x^\"6^&Z^*r^*I^!\"",
      "encoded_base64": "ICBeI2VeKkReKkleKkFeLiteJCVeLXheLXheKHheIjZeJlpeKnJeKkleISI=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_3786d173ac2c",
      "text": "  你們現在為什麼滅絕了？",
      "encoded_ascii": "  ^*F^*{^&?^\"d^%{^!=^.T^%t^-I^*D^.V",
      "encoded_base64": "ICBeKkZeKnteJj9eImReJXteIT1eLlReJXReLUleKkReLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_0ff541d06bf0",
      "text": "  我有時間聽——快告訴我。",
      "encoded_ascii": "  ^$%^$s^$f^)G^-X^*n^*n^*L^+B^-t^$%^!\"",
      "encoded_base64": "ICBeJCVeJHNeJGZeKUdeLVheKm5eKm5eKkxeK0JeLXReJCVeISI=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_ca758de9da9b",
      "text": "  我會幫你。",
      "encoded_ascii": "  ^$%^$r^+}^*F^!\"",
      "encoded_base64": "ICBeJCVeJHJeK31eKkZeISI=",
      "byte_length": 17
    },
    {
      "unit_id": "DLG_9c29044c5f64",
      "text": "  我有更重要的事要做。",
      "encoded_ascii": "  ^$%^$s^$o^))^(C^&Z^*r^(C^*~^!\"",
      "encoded_base64": "ICBeJCVeJHNeJG9eKSleKENeJlpeKnJeKENeKn5eISI=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_a34275087dba",
      "text": "我現在要走了。 ",
      "encoded_ascii": "^$%^&?^\"d^(C^.&^*D^!\" ",
      "encoded_base64": "XiQlXiY/XiJkXihDXi4mXipEXiEiIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_a6fc394ed9dc",
      "text": "不。過去早已逝去——永不復返。何況你手頭也沒有任何能用來交換情報的 ",
      "encoded_ascii": "^!)^!\"^(x^\"6^,V^#J^0E^\"6^*n^*n^%W^!)^#g^7J^!\"^!L^,q^*F^$+^)t^!1^%\\^$s^!C^!L^'b^&H^!O^0P^4@^,0^+`^&Z ",
      "encoded_base64": "XiEpXiEiXih4XiI2XixWXiNKXjBFXiI2XipuXipuXiVXXiEpXiNnXjdKXiEiXiFMXixxXipGXiQrXil0XiExXiVcXiRzXiFDXiFMXidiXiZIXiFPXjBQXjRAXiwwXitgXiZaIA==",
      "byte_length": 100
    },
    {
      "unit_id": "DLG_cd466b7c4cee",
      "text": "物事。休得再問！ ",
      "encoded_ascii": "^&4^*r^!\"^!G^#e^!l^*Z^*W ",
      "encoded_base64": "XiY0XipyXiEiXiFHXiNlXiFsXipaXipXIA==",
      "byte_length": 25
    },
    {
      "unit_id": "DLG_905ee54cf1dc",
      "text": "真令我驚訝，你們這種種族居然還活著，而我們的族類卻已 ",
      "encoded_ascii": "^-2^*w^$%^.Q^-r^*A^*F^*{^(s^'$^'$^5V^+w^&\"^.7^%i^-a^*A^'W^$%^*{^&Z^5V^)w^1&^#J ",
      "encoded_base64": "Xi0yXip3XiQlXi5RXi1yXipBXipGXip7XihzXickXickXjVWXit3XiYiXi43XiVpXi1hXipBXidXXiQlXip7XiZaXjVWXil3XjEmXiNKIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_c4054686a187",
      "text": "滅絕。聽你這番胡言亂語，我真懷疑你們是怎麼苟活到現在的。 ",
      "encoded_ascii": "^%t^-I^!\"^-X^*F^(s^2{^3}^1Y^!3^0:^*A^$%^-2^,9^0p^*F^*{^,X^,,^.T^-^^%i^!u^&?^\"d^&Z^!\" ",
      "encoded_base64": "XiV0Xi1JXiEiXi1YXipGXihzXjJ7XjN9XjFZXiEzXjA6XipBXiQlXi0yXiw5XjBwXipGXip7XixYXiwsXi5UXi1eXiVpXiF1XiY/XiJkXiZaXiEiIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_8747c80fe1a5",
      "text": "或許是時候讓你們也跟著滅絕了。 ",
      "encoded_ascii": "^$'^-s^,X^$f^*|^-}^*F^*{^!1^.+^-a^%t^-I^*D^!\" ",
      "encoded_base64": "XiQnXi1zXixYXiRmXip8Xi19XipGXip7XiExXi4rXi1hXiV0Xi1JXipEXiEiIA==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_676d79410047",
      "text": "克拉格就躲藏在神廟深處。唯有活生生的生靈才能消滅他！ ",
      "encoded_ascii": "^!d^$6^%*^*J^0C^-f^\"d^&w^0[^2*^(,^!\"^+O^$s^%i^&F^&F^&Z^&F^)g^$,^'b^%k^%t^!@^*W ",
      "encoded_base64": "XiFkXiQ2XiUqXipKXjBDXi1mXiJkXiZ3XjBbXjIqXigsXiEiXitPXiRzXiVpXiZGXiZGXiZaXiZGXilnXiQsXidiXiVrXiV0XiFAXipXIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_dd14be01f51f",
      "text": "把巨靈奪回來，但切記小心！克拉格是個奸詐小人——千萬別聽信 ",
      "encoded_ascii": "^$1^#H^)g^1,^\"\\^!O^*A^!I^+.^(K^#;^#k^*W^!d^$6^%*^,X^!V^:2^6(^#;^!<^*n^*n^+7^-_^*H^-X^!U ",
      "encoded_base64": "XiQxXiNIXilnXjEsXiJcXiFPXipBXiFJXisuXihLXiM7XiNrXipXXiFkXiQ2XiUqXixYXiFWXjoyXjYoXiM7XiE8XipuXipuXis3Xi1fXipIXi1YXiFVIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_35b6281227ef",
      "text": "他的鬼話。",
      "encoded_ascii": "^!@^&Z^*-^-v^!\"",
      "encoded_base64": "XiFAXiZaXiotXi12XiEi",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_1d6731995988",
      "text": "你打算不施以援手就一走了之？很明顯，如果你不是我們的朋友，那你必定 ",
      "encoded_ascii": "^*F^$-^-C^!)^$_^!B^$C^$+^*J^!%^.&^*D^!/^.V^*K^$c^4&^*A^#$^%!^*F^!)^,X^$%^*{^&Z^,[^\"8^*A^)!^*F^#l^#. ",
      "encoded_base64": "XipGXiQtXi1DXiEpXiRfXiFCXiRDXiQrXipKXiElXi4mXipEXiEvXi5WXipLXiRjXjQmXipBXiMkXiUhXipGXiEpXixYXiQlXip7XiZaXixbXiI4XipBXikhXipGXiNsXiMuIA==",
      "byte_length": 100
    },
    {
      "unit_id": "DLG_d74f65426fdc",
      "text": "就是我們的敵人！",
      "encoded_ascii": "^*J^,X^$%^*{^&Z^$U^!<^*W",
      "encoded_base64": "XipKXixYXiQlXip7XiZaXiRVXiE8XipX",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_b8aff13662d2",
      "text": "那是個漫長而悲傷的故事。改天我有空再告訴你吧。 ",
      "encoded_ascii": "^)!^,X^!V^2,^)C^'W^,.^!^^&Z^5U^*r^!\"^$N^+e^$%^$s^'(^!l^+B^-t^*F^*I^!\" ",
      "encoded_base64": "XikhXixYXiFWXjIsXilDXidXXiwuXiFeXiZaXjVVXipyXiEiXiROXitlXiQlXiRzXicoXiFsXitCXi10XipGXipJXiEiIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_1b73d0d22f4c",
      "text": "我聽膩了你的調侃戲謔。你根本是在浪費時間。",
      "encoded_ascii": "^$%^-X^:=^*D^*F^&Z^(Q^:,^,;^:>^!\"^*F^%)^$x^,X^\"d^,r^.\"^$f^)G^!\"",
      "encoded_base64": "XiQlXi1YXjo9XipEXipGXiZaXihRXjosXiw7Xjo+XiEiXipGXiUpXiR4XixYXiJkXixyXi4iXiRmXilHXiEi",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_e9448acce192",
      "text": "太好了。進入這片廢墟，找到克拉格。殺了他，把巨靈帶給我。 ",
      "encoded_ascii": "^+f^+i^*D^!\"^(w^!f^(s^&1^#W^\"t^*A^$/^!u^!d^$6^%*^!\"^%M^*D^!@^*A^$1^#H^)g^#N^'A^$%^!\" ",
      "encoded_base64": "XitmXitpXipEXiEiXih3XiFmXihzXiYxXiNXXiJ0XipBXiQvXiF1XiFkXiQ2XiUqXiEiXiVNXipEXiFAXipBXiQxXiNIXilnXiNOXidBXiQlXiEiIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_b8bb3f818d0e",
      "text": "如此一來，這座城市便能再度充滿生靈。 ",
      "encoded_ascii": "^#$^%I^!%^!O^*A^(s^/_^+_^+z^!R^'b^!l^#V^5.^,{^&F^)g^!\" ",
      "encoded_base64": "XiMkXiVJXiElXiFPXipBXihzXi9fXitfXit6XiFSXidiXiFsXiNWXjUuXix7XiZGXilnXiEiIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_d7002292b355",
      "text": "你還在等什麼？事不宜遲，動作快點。誰曉得這座城市還能維持 ",
      "encoded_ascii": "^*F^.7^\"d^'-^!=^.T^.V^*r^!)^/[^.5^*A^\"%^!M^*L^*;^!\"^-y^7y^#e^(s^/_^+_^+z^.7^'b^'F^$7 ",
      "encoded_base64": "XipGXi43XiJkXictXiE9Xi5UXi5WXipyXiEpXi9bXi41XipBXiIlXiFNXipMXio7XiEiXi15Xjd5XiNlXihzXi9fXitfXit6Xi43XidiXidGXiQ3IA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_a0c21ab30596",
      "text": "多久不被黃沙再度掩埋。快去找到克拉格並釋放巨靈。 ",
      "encoded_ascii": "^\"x^!.^!)^(@^*7^%]^!l^#V^9~^1r^!\"^*L^\"6^$/^!u^!d^$6^%*^!+^0w^$P^#H^)g^!\" ",
      "encoded_base64": "XiJ4XiEuXiEpXihAXio3XiVdXiFsXiNWXjl+XjFyXiEiXipMXiI2XiQvXiF1XiFkXiQ2XiUqXiErXjB3XiRQXiNIXilnXiEiIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_68ce912c8fca",
      "text": "此處並非爾等活人之地。休得靠近——唯有 ",
      "encoded_ascii": "^%I^(,^!+^)i^&/^'-^%i^!<^!/^\"e^!\"^!G^#e^.C^(l^*n^*n^+O^$s ",
      "encoded_base64": "XiVJXigsXiErXilpXiYvXictXiVpXiE8XiEvXiJlXiEiXiFHXiNlXi5DXihsXipuXipuXitPXiRzIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_f494d78b44d7",
      "text": "死者方可前行。 ",
      "encoded_ascii": "^%L^'V^$]^\"A^!z^(;^!\" ",
      "encoded_base64": "XiVMXidWXiRdXiJBXiF6Xig7XiEiIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_f815ff355a55",
      "text": "  裡面到底有什麼大不了的東西？",
      "encoded_ascii": "  ^-j^)j^!u^/^^$s^!=^.T^\"z^!)^*D^&Z^,`^-l^.V",
      "encoded_base64": "ICBeLWpeKWpeIXVeL15eJHNeIT1eLlReInpeISleKkReJlpeLGBeLWxeLlY=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_74558f6ec182",
      "text": "  喔，是嗎？那我就來開個特例。 ",
      "encoded_ascii": "  ^+T^*A^,X^+X^.V^)!^$%^*J^!O^)F^!V^&5^9h^!\" ",
      "encoded_base64": "ICBeK1ReKkFeLFheK1heLlZeKSFeJCVeKkpeIU9eKUZeIVZeJjVeOWheISIg",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_00d87989aa3d",
      "text": "好吧，我這就走。 ",
      "encoded_ascii": "^+i^*I^*A^$%^(s^*J^.&^!\" ",
      "encoded_base64": "XitpXipJXipBXiQlXihzXipKXi4mXiEiIA==",
      "byte_length": 25
    },
    {
      "unit_id": "DLG_d7fcd93ab718",
      "text": "自此處滾開，永世不得返回！ ",
      "encoded_ascii": "^'l^%I^(,^,z^)F^*A^%W^*p^!)^#e^7J^\"\\^*W ",
      "encoded_base64": "XidsXiVJXigsXix6XilGXipBXiVXXipwXiEpXiNlXjdKXiJcXipXIA==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_3d1214406e3f",
      "text": "狂怒的亡魂盤踞於此。你若膽敢靠近牠們，便是將 ",
      "encoded_ascii": "^&8^#o^&Z^!:^*.^1M^1_^$^^%I^!\"^*F^'x^-[^/m^.C^(l^-#^*{^*A^!R^,X^#7 ",
      "encoded_base64": "XiY4XiNvXiZaXiE6XiouXjFNXjFfXiReXiVJXiEiXipGXid4Xi1bXi9tXi5DXihsXi0jXip7XipBXiFSXixYXiM3IA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_c6b062295faa",
      "text": "自己置於巨大凶險之中——牠們以生靈為食。 ",
      "encoded_ascii": "^'l^#I^'Q^$^^#H^\"z^3e^*m^!/^!,^*n^*n^-#^*{^!B^&F^)g^%{^0J^!\" ",
      "encoded_base64": "XidsXiNJXidRXiReXiNIXiJ6XjNlXiptXiEvXiEsXipuXipuXi0jXip7XiFCXiZGXilnXiV7XjBKXiEiIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_41578b4426c4",
      "text": "不行。你絕不可能成為例外。前方是死者棲息之所。 ",
      "encoded_ascii": "^!)^(;^!\"^*F^-I^!)^\"A^'b^$$^%{^9h^\"w^!\"^!z^$]^,X^%L^'V^,b^#w^!/^$)^!\" ",
      "encoded_base64": "XiEpXig7XiEiXipGXi1JXiEpXiJBXidiXiQkXiV7XjloXiJ3XiEiXiF6XiRdXixYXiVMXidWXixiXiN3XiEvXiQpXiEiIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_0d5f7c2ba407",
      "text": "你的生命氣息會褻瀆這片淨土——並招致亡靈的滔天怒火 ",
      "encoded_ascii": "^*F^&Z^&F^\"N^%U^#w^$r^-k^,~^(s^&1^0k^\"c^*n^*n^!+^,D^'o^!:^)g^&Z^2t^+e^#o^%x ",
      "encoded_base64": "XipGXiZaXiZGXiJOXiVVXiN3XiRyXi1rXix+XihzXiYxXjBrXiJjXipuXipuXiErXixEXidvXiE6XilnXiZaXjJ0XitlXiNvXiV4IA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_6842cdf649bd",
      "text": "降臨於你的頭頂。 ",
      "encoded_ascii": "^)N^1U^$^^*F^&Z^)t^)p^!\" ",
      "encoded_base64": "XilOXjFVXiReXipGXiZaXil0XilwXiEiIA==",
      "byte_length": 25
    },
    {
      "unit_id": "DLG_2d128f670959",
      "text": "那是明智的抉擇。 ",
      "encoded_ascii": "^)!^,X^$c^$i^&Z^:F^,N^!\" ",
      "encoded_base64": "XikhXixYXiRjXiRpXiZaXjpGXixOXiEiIA==",
      "byte_length": 25
    },
    {
      "unit_id": "DLG_37d4b93fcc68",
      "text": "你早已受過警告了，活人！ ",
      "encoded_ascii": "^*F^,V^#J^\";^(x^(S^+B^*D^*A^%i^!<^*W ",
      "encoded_base64": "XipGXixWXiNKXiI7Xih4XihTXitCXipEXipBXiVpXiE8XipXIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_934a8d13e5cb",
      "text": "蠢材！早就警告過你們不得涉足此地！你們正在阻礙 ",
      "encoded_ascii": "^.u^$y^*W^,V^*J^(S^+B^(x^*F^*{^!)^#e^3O^(^^%I^\"e^*W^*F^*{^%H^\"d^)L^:M ",
      "encoded_base64": "Xi51XiR5XipXXixWXipKXihTXitCXih4XipGXip7XiEpXiNlXjNPXiheXiVJXiJlXipXXipGXip7XiVIXiJkXilMXjpNIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_3130d0d3d457",
      "text": "蘇隆蟲人種族的偉大重生！ ",
      "encoded_ascii": "^4c^)T^(8^!<^'$^5V^&Z^*}^\"z^))^&F^*W ",
      "encoded_base64": "XjRjXilUXig4XiE8XickXjVWXiZaXip9XiJ6XikpXiZGXipXIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_745aeabd8f22",
      "text": "  你們要如何復興你們的種族？",
      "encoded_ascii": "  ^*F^*{^(C^#$^!L^#g^-]^*F^*{^&Z^'$^5V^.V",
      "encoded_base64": "ICBeKkZeKnteKENeIyReIUxeI2deLV1eKkZeKnteJlpeJyReNVZeLlY=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_fe01859ec737",
      "text": "  你們的種族早就滅絕了，而且將永遠滅絕！",
      "encoded_ascii": "  ^*F^*{^&Z^'$^5V^,V^*J^%t^-I^*D^*A^'W^!*^#7^%W^({^%t^-I^*W",
      "encoded_base64": "ICBeKkZeKnteJlpeJyReNVZeLFZeKkpeJXReLUleKkReKkFeJ1deISpeIzdeJVdeKHteJXReLUleKlc=",
      "byte_length": 59
    },
    {
      "unit_id": "DLG_569901802e00",
      "text": "  時間挑得真巧！那就讓我來多搗點亂吧！",
      "encoded_ascii": "  ^$f^)G^,H^#e^-2^3D^*W^)!^*J^-}^$%^!O^\"x^:H^*;^!3^*I^*W",
      "encoded_base64": "ICBeJGZeKUdeLEheI2VeLTJeM0ReKldeKSFeKkpeLX1eJCVeIU9eInheOkheKjteITNeKkleKlc=",
      "byte_length": 56
    },
    {
      "unit_id": "DLG_d6fd043f51bc",
      "text": "  你們的罪惡在此終結了，蘇隆蟲人！",
      "encoded_ascii": "  ^*F^*{^&Z^5x^#y^\"d^%I^-H^'@^*D^*A^4c^)T^(8^!<^*W",
      "encoded_base64": "ICBeKkZeKnteJlpeNXheI3leImReJUleLUheJ0BeKkReKkFeNGNeKVReKDheITxeKlc=",
      "byte_length": 50
    },
    {
      "unit_id": "DLG_afa3da0249b6",
      "text": "  受死吧，你們這些橘色的……呃……怪東西！",
      "encoded_ascii": "  ^\";^%L^*I^*A^*F^*{^(s^!8^:J^'s^&Z^*o^*o^3<^*o^*o^#s^,`^-l^*W",
      "encoded_base64": "ICBeIjteJUxeKkleKkFeKkZeKnteKHNeITheOkpeJ3NeJlpeKm9eKm9eMzxeKm9eKm9eI3NeLGBeLWxeKlc=",
      "byte_length": 62
    },
    {
      "unit_id": "DLG_5fa9f0f3b8d1",
      "text": "噢。那不好意思，我這就走人。 ",
      "encoded_ascii": "^+]^!\"^)!^!)^+i^#z^#q^*A^$%^(s^*J^.&^!<^!\" ",
      "encoded_base64": "XitdXiEiXikhXiEpXitpXiN6XiNxXipBXiQlXihzXipKXi4mXiE8XiEiIA==",
      "byte_length": 43
    },
    {
      "unit_id": "DLG_be3f416bf96b",
      "text": "蘇隆蟲人朝地面一揮手……地底深處傳來陣陣轟鳴！",
      "encoded_ascii": "^4c^)T^(8^!<^,^^\"e^)j^!%^2\"^$+^*o^*o^\"e^/^^2*^(,^+$^!O^)P^)P^.y^.|^*W",
      "encoded_base64": "XjRjXilUXig4XiE8XixeXiJlXilqXiElXjIiXiQrXipvXipvXiJlXi9eXjIqXigsXiskXiFPXilQXilQXi55Xi58XipX",
      "byte_length": 69
    },
    {
      "unit_id": "DLG_22a9b7d93914",
      "text": "甦醒吧，孩子們！助我們成就大業！ ",
      "encoded_ascii": "^6e^.9^*I^*A^+m^#(^*{^*W^\"#^$%^*{^$$^*J^\"z^%5^*W ",
      "encoded_base64": "XjZlXi45XipJXipBXittXiMoXip7XipXXiIjXiQlXip7XiQkXipKXiJ6XiU1XipXIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_82df708dad0e",
      "text": "以你們那淺薄低下的心智，根本休想理解這些深奧奧秘！而我們 ",
      "encoded_ascii": "^!B^*F^*{^)!^:K^6o^!K^!(^&Z^#k^$i^*A^%)^$x^!G^,1^&A^(I^(s^!8^2*^6Q^6Q^1O^*W^'W^$%^*{ ",
      "encoded_base64": "XiFCXipGXip7XikhXjpLXjZvXiFLXiEoXiZaXiNrXiRpXipBXiUpXiR4XiFHXiwxXiZBXihJXihzXiE4XjIqXjZRXjZRXjFPXipXXidXXiQlXip7IA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_45118747e6f0",
      "text": "也沒打算給你們時間去揣摩！ ",
      "encoded_ascii": "^!1^%\\^$-^-C^'A^*F^*{^$f^)G^\"6^:G^:I^*W ",
      "encoded_base64": "XiExXiVcXiQtXi1DXidBXipGXip7XiRmXilHXiI2XjpHXjpJXipXIA==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_62315edd5905",
      "text": "你們以及你們所有的同類，很快就會步入滅絕！",
      "encoded_ascii": "^*F^*{^!B^\"7^*F^*{^$)^$s^&Z^\"E^)w^*A^*K^*L^*J^$r^,i^!f^%t^-I^*W",
      "encoded_base64": "XipGXip7XiFCXiI3XipGXip7XiQpXiRzXiZaXiJFXil3XipBXipLXipMXipKXiRyXixpXiFmXiV0Xi1JXipX",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_dbc9d1a2cfa6",
      "text": "此地不再歡迎你們……我們會確保你們徹底 ",
      "encoded_ascii": "^%I^\"e^!)^!l^%F^(k^*F^*{^*o^*o^$%^*{^$r^-6^!T^*F^*{^18^/^ ",
      "encoded_base64": "XiVJXiJlXiEpXiFsXiVGXihrXipGXip7XipvXipvXiQlXip7XiRyXi02XiFUXipGXip7XjE4Xi9eIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_ef7d30fce5c7",
      "text": "灰飛煙滅！ ",
      "encoded_ascii": "^%y^)z^4S^%t^*W ",
      "encoded_base64": "XiV5Xil6XjRTXiV0XipXIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_0219062a2fb3",
      "text": "不，我們的邪惡在此刻「才正要開始」……並將從這裡擴張籠罩整個世界！ ",
      "encoded_ascii": "^!)^*A^$%^*{^&Z^)\"^#y^\"d^%I^.Y^!#^$,^%H^(C^)F^+k^!$^*o^*o^!+^#7^#f^(s^-j^$J^,(^'3^'P^$T^!V^*p^.p^*W ",
      "encoded_base64": "XiEpXipBXiQlXip7XiZaXikiXiN5XiJkXiVJXi5ZXiEjXiQsXiVIXihDXilGXitrXiEkXipvXipvXiErXiM3XiNmXihzXi1qXiRKXiwoXiczXidQXiRUXiFWXipwXi5wXipXIA==",
      "byte_length": 100
    },
    {
      "unit_id": "DLG_7b0ca6dcb52e",
      "text": "你就這點能耐嗎？你的辱罵簡直不痛不癢。無所謂—— ",
      "encoded_ascii": "^*F^*J^(s^*;^'b^-S^+X^.V^*F^&Z^3`^:N^3y^&`^!)^-.^!)^5i^!\"^%}^$)^0s^*n^*n ",
      "encoded_base64": "XipGXipKXihzXio7XidiXi1TXitYXi5WXipGXiZaXjNgXjpOXjN5XiZgXiEpXi0uXiEpXjVpXiEiXiV9XiQpXjBzXipuXipuIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_491976d36fb1",
      "text": "反正你再也沒機會構思新的詞了。 ",
      "encoded_ascii": "^\"9^%H^*F^!l^!1^%\\^%>^$r^8~^#q^$\\^&Z^.v^*D^!\" ",
      "encoded_base64": "XiI5XiVIXipGXiFsXiExXiVcXiU+XiRyXjh+XiNxXiRcXiZaXi52XipEXiEiIA==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_7b13af4492c6",
      "text": "沒錯，踏上通往墳墓的黃泉路吧！你休想活著見證我們統治 ",
      "encoded_ascii": "^%\\^)5^*A^.,^!'^(t^,)^:C^6P^&Z^*7^%a^(a^*I^*W^*F^!G^,1^%i^-a^-m^-{^$%^*{^'B^%_ ",
      "encoded_base64": "XiVcXik1XipBXi4sXiEnXih0XiwpXjpDXjZQXiZaXio3XiVhXihhXipJXipXXipGXiFHXiwxXiVpXi1hXi1tXi17XiQlXip7XidCXiVfIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_b344d41bd141",
      "text": "這個世界的那一天！ ",
      "encoded_ascii": "^(s^!V^*p^.p^&Z^)!^!%^+e^*W ",
      "encoded_base64": "XihzXiFWXipwXi5wXiZaXikhXiElXitlXipXIA==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_80970ca97a8a",
      "text": "你們休想把遺骸交還給克拉格！我們絕不允許！ ",
      "encoded_ascii": "^*F^*{^!G^,1^$1^0v^*'^0P^.7^'A^!d^$6^%*^*W^$%^*{^-I^!)^/\"^-s^*W ",
      "encoded_base64": "XipGXip7XiFHXiwxXiQxXjB2XionXjBQXi43XidBXiFkXiQ2XiUqXipXXiQlXip7Xi1JXiEpXi8iXi1zXipXIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_413cbe23b994",
      "text": "甦醒吧，孩子們！守護我們的族群！",
      "encoded_ascii": "^6e^.9^*I^*A^+m^#(^*{^*W^#+^(T^$%^*{^&Z^5V^'R^*W",
      "encoded_base64": "XjZlXi45XipJXipBXittXiMoXip7XipXXiMrXihUXiQlXip7XiZaXjVWXidSXipX",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_c85eb6e2577e",
      "text": "把巨靈交給我！那是屬於我們的！你們休想據為己有！ ",
      "encoded_ascii": "^$1^#H^)g^0P^'A^$%^*W^)!^,X^#C^$^^$%^*{^&Z^*W^*F^*{^!G^,1^5T^%{^#I^$s^*W ",
      "encoded_base64": "XiQxXiNIXilnXjBQXidBXiQlXipXXikhXixYXiNDXiReXiQlXip7XiZaXipXXipGXip7XiFHXiwxXjVUXiV7XiNJXiRzXipXIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_8484d867320b",
      "text": "別踩上講台王座。唯有我才准踏足於此。我不會再 ",
      "encoded_ascii": "^*H^0A^!'^6+^\"B^-)^/_^!\"^+O^$s^$%^$,^/Q^.,^(^^$^^%I^!\"^$%^!)^$r^!l ",
      "encoded_base64": "XipIXjBBXiEnXjYrXiJCXi0pXi9fXiEiXitPXiRzXiQlXiQsXi9RXi4sXiheXiReXiVJXiEiXiQlXiEpXiRyXiFsIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_ec10b328a4dc",
      "text": "警告你們第二次。 ",
      "encoded_ascii": "^(S^+B^*F^*{^',^!5^%D^!\" ",
      "encoded_base64": "XihTXitCXipGXip7XicsXiE1XiVEXiEiIA==",
      "byte_length": 25
    },
    {
      "unit_id": "DLG_cb3185f27ae5",
      "text": "  閉嘴！我想去哪就去哪！ ",
      "encoded_ascii": "  ^.=^+[^*W^$%^,1^\"6^+I^*J^\"6^+I^*W ",
      "encoded_base64": "ICBeLj1eK1teKldeJCVeLDFeIjZeK0leKkpeIjZeK0leKlcg",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_c52644d828c9",
      "text": "  抱歉。我這就下來。 ",
      "encoded_ascii": "  ^,@^,h^!\"^$%^(s^*J^!(^!O^!\" ",
      "encoded_base64": "ICBeLEBeLGheISJeJCVeKHNeKkpeISheIU9eISIg",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_cc101da16be5",
      "text": "休得再踏上來。 ",
      "encoded_ascii": "^!G^#e^!l^.,^!'^!O^!\" ",
      "encoded_base64": "XiFHXiNlXiFsXi4sXiEnXiFPXiEiIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_2493a041448e",
      "text": "你早已受過警告了！",
      "encoded_ascii": "^*F^,V^#J^\";^(x^(S^+B^*D^*W",
      "encoded_base64": "XipGXixWXiNKXiI7Xih4XihTXitCXipEXipX",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_26cbf14745f7",
      "text": "向你們致意，活人們。我是德懷爾國王，這座城市的統治者。然而，隨著 ",
      "encoded_ascii": "^+?^*F^*{^'o^#z^*A^%i^!<^*{^!\"^$%^,X^#j^,9^&/^+^^-)^*A^(s^/_^+_^+z^&Z^'B^%_^'V^!\"^&\"^'W^*A^)X^-a ",
      "encoded_base64": "Xis/XipGXip7XidvXiN6XipBXiVpXiE8Xip7XiEiXiQlXixYXiNqXiw5XiYvXiteXi0pXipBXihzXi9fXitfXit6XiZaXidCXiVfXidWXiEiXiYiXidXXipBXilYXi1hIA==",
      "byte_length": 97
    },
    {
      "unit_id": "DLG_338e4f04f1c2",
      "text": "這座城市被黃沙掩埋、徹底殘破凋零，我承認我已沒有多少子民可供統治了。 ",
      "encoded_ascii": "^(s^/_^+_^+z^(@^*7^%]^9~^1r^!!^18^/^^,l^&n^9{^9*^*A^$%^$0^(O^$%^#J^%\\^$s^\"x^#<^#(^%T^\"A^!P^'B^%_^*D^!\" ",
      "encoded_base64": "XihzXi9fXitfXit6XihAXio3XiVdXjl+XjFyXiEhXjE4Xi9eXixsXiZuXjl7XjkqXipBXiQlXiQwXihPXiQlXiNKXiVcXiRzXiJ4XiM8XiMoXiVUXiJBXiFQXidCXiVfXipEXiEiIA==",
      "byte_length": 103
    },
    {
      "unit_id": "DLG_a56dd4cd9bfd",
      "text": "  你知道自己已經死了嗎？",
      "encoded_ascii": "  ^*F^&h^(y^'l^#I^#J^'D^%L^*D^+X^.V",
      "encoded_base64": "ICBeKkZeJmheKHleJ2xeI0leI0peJ0ReJUxeKkReK1heLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_c36abd464968",
      "text": "  那是你的骸骨嗎？",
      "encoded_ascii": "  ^)!^,X^*F^&Z^*'^*$^+X^.V",
      "encoded_base64": "ICBeKSFeLFheKkZeJlpeKideKiReK1heLlY=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_bc988f4ad57e",
      "text": "  你是怎麼死的？",
      "encoded_ascii": "  ^*F^,X^,,^.T^%L^&Z^.V",
      "encoded_base64": "ICBeKkZeLFheLCxeLlReJUxeJlpeLlY=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_40bc1492195c",
      "text": "  他為什麼想要奪取巨靈？",
      "encoded_ascii": "  ^!@^%{^!=^.T^,1^(C^1,^\":^#H^)g^.V",
      "encoded_base64": "ICBeIUBeJXteIT1eLlReLDFeKENeMSxeIjpeI0heKWdeLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_248468cd340d",
      "text": "  你當初為何要處決克拉格？",
      "encoded_ascii": "  ^*F^&N^1\"^%{^!L^(C^(,^,o^!d^$6^%*^.V",
      "encoded_base64": "ICBeKkZeJk5eMSJeJXteIUxeKENeKCxeLG9eIWReJDZeJSpeLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_938a0caba7c1",
      "text": "  克拉格是誰？",
      "encoded_ascii": "  ^!d^$6^%*^,X^-y^.V",
      "encoded_base64": "ICBeIWReJDZeJSpeLFheLXleLlY=",
      "byte_length": 20
    },
    {
      "unit_id": "DLG_cebc8d769588",
      "text": "  你認識羅德嗎？",
      "encoded_ascii": "  ^*F^(O^(R^/?^#j^+X^.V",
      "encoded_base64": "ICBeKkZeKE9eKFJeLz9eI2peK1heLlY=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_f272b00fc8a9",
      "text": "  羅德在哪裡？",
      "encoded_ascii": "  ^/?^#j^\"d^+I^-j^.V",
      "encoded_base64": "ICBeLz9eI2peImReK0leLWpeLlY=",
      "byte_length": 20
    },
    {
      "unit_id": "DLG_25e283bb052a",
      "text": "我當然認識。羅德是我的宮廷巫師——而且才智過人。正是他 ",
      "encoded_ascii": "^$%^&N^&\"^(O^(R^!\"^/?^#j^,X^$%^&Z^/\\^:D^14^#M^*n^*n^'W^!*^$,^$i^(x^!<^!\"^%H^,X^!@ ",
      "encoded_base64": "XiQlXiZOXiYiXihPXihSXiEiXi8/XiNqXixYXiQlXiZaXi9cXjpEXjE0XiNNXipuXipuXidXXiEqXiQsXiRpXih4XiE8XiEiXiVIXixYXiFAIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_172c6ca4e248",
      "text": "負責將蘇隆蟲人召喚至這座城市的。若沒有他，我根本無法 ",
      "encoded_ascii": "^(W^0>^#7^4c^)T^(8^!<^\"@^\"U^'n^(s^/_^+_^+z^&Z^!\"^'x^%\\^$s^!@^*A^$%^%)^$x^%}^%b ",
      "encoded_base64": "XihXXjA+XiM3XjRjXilUXig4XiE8XiJAXiJVXiduXihzXi9fXitfXit6XiZaXiEiXid4XiVcXiRzXiFAXipBXiQlXiUpXiR4XiV9XiViIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_acf5b3a51ffc",
      "text": "獲得牠們的博大知識。 ",
      "encoded_ascii": "^&:^#e^-#^*{^&Z^/$^\"z^&h^(R^!\" ",
      "encoded_base64": "XiY6XiNlXi0jXip7XiZaXi8kXiJ6XiZoXihSXiEiIA==",
      "byte_length": 31
    },
    {
      "unit_id": "DLG_08135889d589",
      "text": "他死了。在召喚蘇隆蟲人之後，束縛結界出了差錯， ",
      "encoded_ascii": "^!@^%L^*D^!\"^\"d^\"@^\"U^4c^)T^(8^!<^!/^#b^*A^$|^3W^'@^.p^!q^*D^48^)5^*A ",
      "encoded_base64": "XiFAXiVMXipEXiEiXiJkXiJAXiJVXjRjXilUXig4XiE8XiEvXiNiXipBXiR8XjNXXidAXi5wXiFxXipEXjQ4Xik1XipBIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_59130ccc1dc5",
      "text": "反噬奪走了他的性命。這真令我意外——他可是整個阿塔斯最偉大的法師。 ",
      "encoded_ascii": "^\"9^:0^1,^.&^*D^!@^&Z^#r^\"N^!\"^(s^-2^*w^$%^#z^\"w^*n^*n^!@^\"A^,X^$T^!V^)M^\"o^$[^$q^*}^\"z^&Z^%b^#M^!\" ",
      "encoded_base64": "XiI5XjowXjEsXi4mXipEXiFAXiZaXiNyXiJOXiEiXihzXi0yXip3XiQlXiN6XiJ3XipuXipuXiFAXiJBXixYXiRUXiFWXilNXiJvXiRbXiRxXip9XiJ6XiZaXiViXiNNXiEiIA==",
      "byte_length": 100
    },
    {
      "unit_id": "DLG_a949e4b3d2af",
      "text": "我本以為他能用魔法擺脫任何危局——甚至是 ",
      "encoded_ascii": "^$%^$x^!B^%{^!@^'b^&H^*0^%b^1@^'c^!C^!L^2\\^._^*n^*n^/|^'n^,X ",
      "encoded_base64": "XiQlXiR4XiFCXiV7XiFAXidiXiZIXiowXiViXjFAXidjXiFDXiFMXjJcXi5fXipuXipuXi98XiduXixYIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_7c2338fe1564",
      "text": "死亡。 ",
      "encoded_ascii": "^%L^!:^!\" ",
      "encoded_base64": "XiVMXiE6XiEiIA==",
      "byte_length": 10
    },
    {
      "unit_id": "DLG_60e3159a2403",
      "text": "羅德的起居室就在神廟入口附近，位於此處的東北方。歡迎你們 ",
      "encoded_ascii": "^/?^#j^&Z^.(^+w^+r^*J^\"d^&w^0[^!f^\"<^.?^(l^*A^!J^$^^%I^(,^&Z^,`^+6^$]^!\"^%F^(k^*F^*{ ",
      "encoded_base64": "Xi8/XiNqXiZaXi4oXit3XityXipKXiJkXiZ3XjBbXiFmXiI8Xi4/XihsXipBXiFKXiReXiVJXigsXiZaXixgXis2XiRdXiEiXiVGXihrXipGXip7IA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_f89d2a1a30bb",
      "text": "隨意前去查閱。不過，我懷疑他的研究成果大概很難在沙塵暴中 ",
      "encoded_ascii": "^)X^#z^!z^\"6^%&^:&^!\"^!)^(x^*A^$%^,9^0p^!@^&Z^9G^-<^$$^%!^\"z^,d^*K^)a^\"d^%]^\"p^$m^!, ",
      "encoded_base64": "XilYXiN6XiF6XiI2XiUmXjomXiEiXiEpXih4XipBXiQlXiw5XjBwXiFAXiZaXjlHXi08XiQkXiUhXiJ6XixkXipLXilhXiJkXiVdXiJwXiRtXiEsIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_9f4c00aa0823",
      "text": "倖存下來。 ",
      "encoded_ascii": "^5+^#*^!(^!O^!\" ",
      "encoded_base64": "XjUrXiMqXiEoXiFPXiEiIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_d7854771efb2",
      "text": "我當然知道。只是其他人拒絕接受這個事實。他們看不見 ",
      "encoded_ascii": "^$%^&N^&\"^&h^(y^!\"^\"?^,X^!j^!@^!<^5Q^-I^$?^\";^(s^!V^*r^#3^!\"^!@^*{^*Q^!)^-m ",
      "encoded_base64": "XiQlXiZOXiYiXiZoXih5XiEiXiI/XixYXiFqXiFAXiE8XjVRXi1JXiQ/XiI7XihzXiFWXipyXiMzXiEiXiFAXip7XipRXiEpXi1tIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_ee0a4cf4ece6",
      "text": "城市破敗頹圮的真貌；他們只看自己想看的。就讓他們繼續沉醉在 ",
      "encoded_ascii": "^+_^+z^&n^$R^:P^:B^&Z^-2^-~^*C^!@^*{^\"?^*Q^'l^#I^,1^*Q^&Z^!\"^*J^-}^!@^*{^-O^'M^%Z^:O^\"d ",
      "encoded_base64": "XitfXit6XiZuXiRSXjpQXjpCXiZaXi0yXi1+XipDXiFAXip7XiI/XipRXidsXiNJXiwxXipRXiZaXiEiXipKXi19XiFAXip7Xi1PXidNXiVaXjpPXiJkIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_f0dd1d29fe2a",
      "text": "幻象中吧——如今他們已經傷害不了任何人了。 ",
      "encoded_ascii": "^#S^4g^!,^*I^*n^*n^#$^*E^!@^*{^#J^'D^!^^#/^!)^*D^!C^!L^!<^*D^!\" ",
      "encoded_base64": "XiNTXjRnXiEsXipJXipuXipuXiMkXipFXiFAXip7XiNKXidEXiFeXiMvXiEpXipEXiFDXiFMXiE8XipEXiEiIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_e69d4388604d",
      "text": "是的。那是我血肉之軀僅存的殘骸。",
      "encoded_ascii": "^,X^&Z^!\"^)!^,X^$%^(:^'^^!/^(d^!_^#*^&Z^,l^*'^!\"",
      "encoded_base64": "XixYXiZaXiEiXikhXixYXiQlXig6XideXiEvXihkXiFfXiMqXiZaXixsXionXiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_08ed2c83315d",
      "text": "我判處了克拉格死刑。但他逃脫了行刑，前來搶奪巨靈神燈。 ",
      "encoded_ascii": "^$%^1k^(,^*D^!d^$6^%*^%L^9|^!\"^!I^!@^(p^'c^*D^(;^9|^*A^!z^!O^1?^1,^#H^)g^&w^93^!\" ",
      "encoded_base64": "XiQlXjFrXigsXipEXiFkXiQ2XiUqXiVMXjl8XiEiXiFJXiFAXihwXidjXipEXig7Xjl8XipBXiF6XiFPXjE/XjEsXiNIXilnXiZ3XjkzXiEiIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_80d36afcd3aa",
      "text": "我們搏鬥起來，隨後他將我斬首。 ",
      "encoded_ascii": "^$%^*{^,K^*,^.(^!O^*A^)X^#b^!@^#7^$%^9B^)~^!\" ",
      "encoded_base64": "XiQlXip7XixLXiosXi4oXiFPXipBXilYXiNiXiFAXiM3XiQlXjlCXil+XiEiIA==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_dfc558da9861",
      "text": "他堅決反對把巨靈拱手讓給蘇隆蟲人。但那是我身為國王的決策， ",
      "encoded_ascii": "^!@^\"l^,o^\"9^#:^$1^#H^)g^*a^$+^-}^'A^4c^)T^(8^!<^!\"^!I^)!^,X^$%^(c^%{^+^^-)^&Z^,o^5p^*A ",
      "encoded_base64": "XiFAXiJsXixvXiI5XiM6XiQxXiNIXilnXiphXiQrXi19XidBXjRjXilUXig4XiE8XiEiXiFJXikhXixYXiQlXihjXiV7XiteXi0pXiZaXixvXjVwXipBIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_5eedea6218dd",
      "text": "而且我心意已決。他偷走巨靈，就是為了阻止蘇隆蟲人染指它。",
      "encoded_ascii": "^'W^!*^$%^#k^#z^#J^,o^!\"^!@^/O^.&^#H^)g^*A^*J^,X^%{^*D^)L^%G^4c^)T^(8^!<^%%^$8^+o^!\"",
      "encoded_base64": "XidXXiEqXiQlXiNrXiN6XiNKXixvXiEiXiFAXi9PXi4mXiNIXilnXipBXipKXixYXiV7XipEXilMXiVHXjRjXilUXig4XiE8XiUlXiQ4XitvXiEi",
      "byte_length": 84
    },
    {
      "unit_id": "DLG_4cb7c3655004",
      "text": "當我提議將巨靈交給蘇隆蟲人時，他在全體內閣面前動手掌摑了我， ",
      "encoded_ascii": "^&N^$%^$A^-|^#7^#H^)g^0P^'A^4c^)T^(8^!<^$f^*A^!@^\"d^!h^**^!g^6~^)j^!z^\"%^$+^$;^:!^*D^$%^*A ",
      "encoded_base64": "XiZOXiQlXiRBXi18XiM3XiNIXilnXjBQXidBXjRjXilUXig4XiE8XiRmXipBXiFAXiJkXiFoXioqXiFnXjZ+XilqXiF6XiIlXiQrXiQ7XjohXipEXiQlXipBIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_826b229a6656",
      "text": "因此我判處他斬首死刑。",
      "encoded_ascii": "^\"]^%I^$%^1k^(,^!@^9B^)~^%L^9|^!\"",
      "encoded_base64": "XiJdXiVJXiQlXjFrXigsXiFAXjlCXil+XiVMXjl8XiEi",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_a946cea6e391",
      "text": "克拉格曾是我的顧問。",
      "encoded_ascii": "^!d^$6^%*^.j^,X^$%^&Z^4n^*Z^!\"",
      "encoded_base64": "XiFkXiQ2XiUqXi5qXixYXiQlXiZaXjRuXipaXiEi",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_aa919ef9769e",
      "text": "是我召喚了牠們。蘇隆蟲人是個極具高等智慧的種族，早已從這個世界上消逝。 ",
      "encoded_ascii": "^,X^$%^\"@^\"U^*D^-#^*{^!\"^4c^)T^(8^!<^,X^!V^1D^!k^*+^'-^$i^4;^&Z^'$^5V^*A^,V^#J^#f^(s^!V^*p^.p^!'^%k^0E^!\" ",
      "encoded_base64": "XixYXiQlXiJAXiJVXipEXi0jXip7XiEiXjRjXilUXig4XiE8XixYXiFWXjFEXiFrXiorXictXiRpXjQ7XiZaXickXjVWXipBXixWXiNKXiNmXihzXiFWXipwXi5wXiEnXiVrXjBFXiEiIA==",
      "byte_length": 106
    },
    {
      "unit_id": "DLG_e796d75d66cc",
      "text": "彼時這座城市陷入停滯衰退——我需要牠們的知識來讓城邦重現繁榮 ",
      "encoded_ascii": "^:E^$f^(s^/_^+_^+z^)S^!f^+!^:L^2D^*V^*n^*n^$%^)e^(C^-#^*{^&Z^&h^(R^!O^-}^+_^1a^))^&?^-N^,e ",
      "encoded_base64": "XjpFXiRmXihzXi9fXitfXit6XilTXiFmXishXjpMXjJEXipWXipuXipuXiQlXillXihDXi0jXip7XiZaXiZoXihSXiFPXi19XitfXjFhXikpXiY/Xi1OXixlIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_bb701cee737b",
      "text": "相見。 ",
      "encoded_ascii": "^&a^-m^!\" ",
      "encoded_base64": "XiZhXi1tXiEiIA==",
      "byte_length": 10
    },
    {
      "unit_id": "DLG_091d56370a27",
      "text": "永別了，活人們。",
      "encoded_ascii": "^%W^*H^*D^*A^%i^!<^*{^!\"",
      "encoded_base64": "XiVXXipIXipEXipBXiVpXiE8Xip7XiEi",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_1d473e128af0",
      "text": "當你邁步走向那具屍體時，它晃動了一下，彷彿根本不是實體。 ",
      "encoded_ascii": "^&N^*F^2N^,i^.&^+?^)!^!k^#?^**^$f^*A^+o^=:^\"%^*D^!%^!(^*A^.a^.b^%)^$x^!)^,X^#3^**^!\" ",
      "encoded_base64": "XiZOXipGXjJOXixpXi4mXis/XikhXiFrXiM/XioqXiRmXipBXitvXj06XiIlXipEXiElXiEoXipBXi5hXi5iXiUpXiR4XiEpXixYXiMzXioqXiEiIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_87a72d1d4781",
      "text": "果不其然，僅僅一秒鐘之後，它便憑空消失了！ ",
      "encoded_ascii": "^%!^!)^!j^&\"^*A^!_^!_^!%^;2^9y^!/^#b^*A^+o^!R^,5^'(^%k^\"|^*D^*W ",
      "encoded_base64": "XiUhXiEpXiFqXiYiXipBXiFfXiFfXiElXjsyXjl5XiEvXiNiXipBXitvXiFSXiw1XicoXiVrXiJ8XipEXipXIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_007d6b58e87d",
      "text": "搜查這名奴隸的屍身，你唯一找到的東西是一卷卷軸，仍然緊握在 ",
      "encoded_ascii": "^/h^%&^(s^\"F^##^)Z^&Z^#?^(c^*A^*F^+O^!%^$/^!u^&Z^,`^-l^,X^!%^\"3^\"3^(e^*A^!?^&\"^0r^1>^\"d ",
      "encoded_base64": "Xi9oXiUmXihzXiJGXiMjXilaXiZaXiM/XihjXipBXipGXitPXiElXiQvXiF1XiZaXixgXi1sXixYXiElXiIzXiIzXihlXipBXiE/XiYiXjByXjE+XiJkIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_f985f49fbcfe",
      "text": "他僵死的手中。你將卷軸撬了出來，仔細閱讀。 ",
      "encoded_ascii": "^!@^=P^%L^&Z^$+^!,^!\"^*F^#7^\"3^(e^6]^*D^!q^!O^*A^6I^'?^:&^7I^!\" ",
      "encoded_base64": "XiFAXj1QXiVMXiZaXiQrXiEsXiEiXipGXiM3XiIzXihlXjZdXipEXiFxXiFPXipBXjZJXic/XjomXjdJXiEiIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_844b52b78b95",
      "text": "這封口信十萬火急，必須盡快送到你們手中，因此我冒著危險藉故離開 ",
      "encoded_ascii": "^(s^#5^\"<^!U^*Y^-_^%x^3p^*A^#l^)r^-1^*L^./^!u^*F^*{^$+^!,^*A^\"]^%I^$%^/P^-a^2\\^*m^04^5U^)`^)F ",
      "encoded_base64": "XihzXiM1XiI8XiFVXipZXi1fXiV4XjNwXipBXiNsXilyXi0xXipMXi4vXiF1XipGXip7XiQrXiEsXipBXiJdXiVJXiQlXi9QXi1hXjJcXiptXjA0XjVVXilgXilGIA==",
      "byte_length": 94
    },
    {
      "unit_id": "DLG_d0bd38e5e983",
      "text": "指揮官們的身邊，匆匆寫下這份密函。 ",
      "encoded_ascii": "^$8^2\"^#-^*{^&Z^(c^.8^*A^<6^<6^/]^!(^(s^*x^#0^=Q^!\" ",
      "encoded_base64": "XiQ4XjIiXiMtXip7XiZaXihjXi44XipBXjw2Xjw2Xi9dXiEoXihzXip4XiMwXj1RXiEiIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_fb8b80c04a98",
      "text": "我帶來了極為沉痛的消息。特克圖克特雷的大軍確實正在集結，但並非為了出征 ",
      "encoded_ascii": "^$%^#N^!O^*D^1D^%{^%Z^-.^&Z^%k^#w^!\"^&5^!d^\"b^!d^&5^)c^&Z^\"z^..^-6^#3^%H^\"d^)]^'@^*A^!I^!+^)i^%{^*D^!q^.c ",
      "encoded_base64": "XiQlXiNOXiFPXipEXjFEXiV7XiVaXi0uXiZaXiVrXiN3XiEiXiY1XiFkXiJiXiFkXiY1XiljXiZaXiJ6Xi4uXi02XiMzXiVIXiJkXildXidAXipBXiFJXiErXilpXiV7XipEXiFxXi5jIA==",
      "byte_length": 106
    },
    {
      "unit_id": "DLG_405f66d1ad66",
      "text": "遠方的某個戰場——他們集結的目標正是我們！ ",
      "encoded_ascii": "^({^$]^&Z^%$^!V^$(^\"n^*n^*n^!@^*{^)]^'@^&Z^&^^%9^%H^,X^$%^*{^*W ",
      "encoded_base64": "Xih7XiRdXiZaXiUkXiFWXiQoXiJuXipuXipuXiFAXip7XildXidAXiZaXiZeXiU5XiVIXixYXiQlXip7XipXIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_2f3e54e5084a",
      "text": "我獲悉不久之後，大軍就將開拔進軍荒原， ",
      "encoded_ascii": "^$%^&:^2h^!)^!.^!/^#b^*A^\"z^..^*J^#7^)F^/c^(w^..^1W^\"5^*A ",
      "encoded_base64": "XiQlXiY6XjJoXiEpXiEuXiEvXiNiXipBXiJ6Xi4uXipKXiM3XilGXi9jXih3Xi4uXjFXXiI1XipBIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_52a8ca542623",
      "text": "將我們的村落以及其他類似的聚落徹底從亞薩斯的大地上抹去。我們正面臨極大的 ",
      "encoded_ascii": "^#7^$%^*{^&Z^$z^-`^!B^\"7^!j^!@^)w^!H^&Z^'[^-`^18^/^^#f^!9^-e^$[^&Z^\"z^\"e^!'^4=^\"6^!\"^$%^*{^%H^)j^1U^1D^\"z^&Z ",
      "encoded_base64": "XiM3XiQlXip7XiZaXiR6Xi1gXiFCXiI3XiFqXiFAXil3XiFIXiZaXidbXi1gXjE4Xi9eXiNmXiE5Xi1lXiRbXiZaXiJ6XiJlXiEnXjQ9XiI2XiEiXiQlXip7XiVIXilqXjFVXjFEXiJ6XiZaIA==",
      "byte_length": 109
    },
    {
      "unit_id": "DLG_088b61608c9a",
      "text": "危險，我認為你們必須立刻知曉。 ",
      "encoded_ascii": "^2\\^*m^*A^$%^(O^%{^*F^*{^#l^)r^0'^.Y^&h^7y^!\" ",
      "encoded_base64": "XjJcXiptXipBXiQlXihPXiV7XipGXip7XiNsXilyXjAnXi5ZXiZoXjd5XiEiIA==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_60cc9be0c587",
      "text": "我懇求你們，帶上能帶走的一切，將村莊留給荒風吧！看來 ",
      "encoded_ascii": "^$%^3t^,n^*F^*{^*A^#N^!'^'b^#N^.&^&Z^!%^+.^*A^#7^$z^6l^-+^'A^1W^)y^*I^*W^*Q^!O ",
      "encoded_base64": "XiQlXjN0XixuXipGXip7XipBXiNOXiEnXidiXiNOXi4mXiZaXiElXisuXipBXiM3XiR6XjZsXi0rXidBXjFXXil5XipJXipXXipRXiFPIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_0334696edb5b",
      "text": "那位先知的預言如今看來更像是瘋子的胡言亂語， ",
      "encoded_ascii": "^)!^!J^!b^&h^&Z^.E^1Y^#$^*E^*Q^!O^$o^!`^,X^-/^#(^&Z^3}^1Y^!3^0:^*A ",
      "encoded_base64": "XikhXiFKXiFiXiZoXiZaXi5FXjFZXiMkXipFXipRXiFPXiRvXiFgXixYXi0vXiMoXiZaXjN9XjFZXiEzXjA6XipBIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_8e9252963fa4",
      "text": "而非真正的遠見天賦。我看不到任何能夠前來拯救我們免於德拉吉大軍 ",
      "encoded_ascii": "^'W^)i^-2^%H^&Z^({^-m^+e^(Y^!\"^$%^*Q^!)^!u^!C^!L^'b^+d^!z^!O^,F^,Q^$%^*{^!e^$^^#j^$6^\"D^\"z^.. ",
      "encoded_base64": "XidXXilpXi0yXiVIXiZaXih7Xi1tXitlXihZXiEiXiQlXipRXiEpXiF1XiFDXiFMXidiXitkXiF6XiFPXixGXixRXiQlXip7XiFlXiReXiNqXiQ2XiJEXiJ6Xi4uIA==",
      "byte_length": 94
    },
    {
      "unit_id": "DLG_a5c4956c2f22",
      "text": "鐵蹄踐踏的『英雄』隊伍，我們也再也不能 ",
      "encoded_ascii": "^)?^8s^4h^.,^&Z^<_^'y^)\\^<`^)U^!F^*A^$%^*{^!1^!l^!1^!)^'b ",
      "encoded_base64": "Xik/XjhzXjRoXi4sXiZaXjxfXid5XilcXjxgXilVXiFGXipBXiQlXip7XiExXiFsXiExXiEpXidiIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_6c4dea02a28d",
      "text": "指望它了。 ",
      "encoded_ascii": "^$8^,]^+o^*D^!\" ",
      "encoded_base64": "XiQ4XixdXitvXipEXiEiIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_a0f56e614696",
      "text": "我將由我最信任的僕人送出這封信——我祈禱他能在 ",
      "encoded_ascii": "^$%^#7^&I^$%^$q^!U^!C^&Z^+%^!<^./^!q^(s^#5^!U^*n^*n^$%^&u^&|^!@^'b^\"d ",
      "encoded_base64": "XiQlXiM3XiZJXiQlXiRxXiFVXiFDXiZaXislXiE8Xi4vXiFxXihzXiM1XiFVXipuXipuXiQlXiZ1XiZ8XiFAXidiXiJkIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_e837ae5abb88",
      "text": "大軍殺到之前趕抵你們身邊。 ",
      "encoded_ascii": "^\"z^..^%M^!u^!/^!z^0u^$5^*F^*{^(c^.8^!\" ",
      "encoded_base64": "XiJ6Xi4uXiVNXiF1XiEvXiF6XjB1XiQ1XipGXip7XihjXi44XiEiIA==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_b3fa0ec13727",
      "text": "如果可能的話，我會嘗試再次向你們呈報，但我恐怕自己已經遭到了 ",
      "encoded_ascii": "^#$^%!^\"A^'b^&Z^-v^*A^$%^$r^1o^-u^!l^%D^+?^*F^*{^<8^+`^*A^!I^$%^#t^0^^'l^#I^#J^'D^(}^!u^*D ",
      "encoded_base64": "XiMkXiUhXiJBXidiXiZaXi12XipBXiQlXiRyXjFvXi11XiFsXiVEXis/XipGXip7Xjw4XitgXipBXiFJXiQlXiN0XjBeXidsXiNJXiNKXidEXih9XiF1XipEIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_4c988ab0aca8",
      "text": "懷疑，因此這很可能是你們最後一次收到我的消息了。願命運眷顧 ",
      "encoded_ascii": "^,9^0p^*A^\"]^%I^(s^*K^\"A^'b^,X^*F^*{^$q^#b^!%^%D^$M^!u^$%^&Z^%k^#w^*D^!\"^.H^\"N^.4^7A^4n ",
      "encoded_base64": "Xiw5XjBwXipBXiJdXiVJXihzXipLXiJBXidiXixYXipGXip7XiRxXiNiXiElXiVEXiRNXiF1XiQlXiZaXiVrXiN3XipEXiEiXi5IXiJOXi40XjdBXjRuIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_5e105fe6b6a9",
      "text": "我們所有人。 ",
      "encoded_ascii": "^$%^*{^$)^$s^!<^!\" ",
      "encoded_base64": "XiQlXip7XiQpXiRzXiE8XiEiIA==",
      "byte_length": 19
    },
    {
      "unit_id": "DLG_bb7b7a9b20a8",
      "text": "拉賈克",
      "encoded_ascii": "^$6^/J^!d",
      "encoded_base64": "XiQ2Xi9KXiFk",
      "byte_length": 9
    },
    {
      "unit_id": "DLG_c8202304b881",
      "text": "喂，你們！如果你們放聰明點，就該無視那卷軸上寫的內容，趕緊 ",
      "encoded_ascii": "^;c^*A^*F^*{^*W^#$^%!^*F^*{^$P^2=^$c^*;^*A^*J^(M^%}^(E^)!^\"3^(e^!'^/]^&Z^!g^+t^*A^0u^0r ",
      "encoded_base64": "XjtjXipBXipGXip7XipXXiMkXiUhXipGXip7XiRQXjI9XiRjXio7XipBXipKXihNXiV9XihFXikhXiIzXihlXiEnXi9dXiZaXiFnXit0XipBXjB1XjByIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_4694bd40002e",
      "text": "過好自己的日子——至少珍惜自己所剩無幾的餘生吧。 ",
      "encoded_ascii": "^(x^+i^'l^#I^&Z^$a^#(^*n^*n^'n^#<^/7^7X^'l^#I^$)^8U^%}^#T^&Z^1e^&F^*I^!\" ",
      "encoded_base64": "Xih4XitpXidsXiNJXiZaXiRhXiMoXipuXipuXiduXiM8Xi83XjdYXidsXiNJXiQpXjhVXiV9XiNUXiZaXjFlXiZGXipJXiEiIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_34e312cc6218",
      "text": "  你在說什麼卷軸？",
      "encoded_ascii": "  ^*F^\"d^-x^!=^.T^\"3^(e^.V",
      "encoded_base64": "ICBeKkZeImReLXheIT1eLlReIjNeKGVeLlY=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_9c1a3bb0d39d",
      "text": "  你能跟我說說關於那卷軸的事嗎？",
      "encoded_ascii": "  ^*F^'b^.+^$%^-x^-x^.>^$^^)!^\"3^(e^&Z^*r^+X^.V",
      "encoded_base64": "ICBeKkZeJ2JeLiteJCVeLXheLXheLj5eJF5eKSFeIjNeKGVeJlpeKnJeK1heLlY=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_025da343bf65",
      "text": "  你怎麼會在這裡？",
      "encoded_ascii": "  ^*F^,,^.T^$r^\"d^(s^-j^.V",
      "encoded_base64": "ICBeKkZeLCxeLlReJHJeImReKHNeLWpeLlY=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_2df2de1372df",
      "text": "  你看過這卷軸了？",
      "encoded_ascii": "  ^*F^*Q^(x^(s^\"3^(e^*D^.V",
      "encoded_base64": "ICBeKkZeKlFeKHheKHNeIjNeKGVeKkReLlY=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_e7f013bc73b5",
      "text": "  這些村落都在哪裡？",
      "encoded_ascii": "  ^(s^!8^$z^-`^)$^\"d^+I^-j^.V",
      "encoded_base64": "ICBeKHNeITheJHpeLWBeKSReImReK0leLWpeLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_76d9dbc37ebe",
      "text": "  你認得這個死者是誰嗎？ ",
      "encoded_ascii": "  ^*F^(O^#e^(s^!V^%L^'V^,X^-y^+X^.V ",
      "encoded_base64": "ICBeKkZeKE9eI2VeKHNeIVZeJUxeJ1ZeLFheLXleK1heLlYg",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_da3a41e56cf3",
      "text": "  你了解提奎茲爾村嗎？",
      "encoded_ascii": "  ^*F^*D^(I^$A^5B^/D^&/^$z^+X^.V",
      "encoded_base64": "ICBeKkZeKkReKEleJEFeNUJeL0ReJi9eJHpeK1heLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_d0eaf8498701",
      "text": "我得走了。後會有期。 ",
      "encoded_ascii": "^$%^#e^.&^*D^!\"^#b^$r^$s^$u^!\" ",
      "encoded_base64": "XiQlXiNlXi4mXipEXiEiXiNiXiRyXiRzXiR1XiEiIA==",
      "byte_length": 31
    },
    {
      "unit_id": "DLG_13dbccc7f9b7",
      "text": "我是埃格魯斯。你們看起來像奴隸——是逃出來的吧？無所謂了。等到大軍殺過來 ",
      "encoded_ascii": "^$%^,X^/&^%*^/K^$[^!\"^*F^*{^*Q^.(^!O^!`^##^)Z^*n^*n^,X^(p^!q^!O^&Z^*I^.V^%}^$)^0s^*D^!\"^'-^!u^\"z^..^%M^(x^!O ",
      "encoded_base64": "XiQlXixYXi8mXiUqXi9LXiRbXiEiXipGXip7XipRXi4oXiFPXiFgXiMjXilaXipuXipuXixYXihwXiFxXiFPXiZaXipJXi5WXiV9XiQpXjBzXipEXiEiXictXiF1XiJ6Xi4uXiVNXih4XiFPIA==",
      "byte_length": 109
    },
    {
      "unit_id": "DLG_8b7423aedba8",
      "text": "的時候，你們逃沒逃脫根本就無關緊要了。 ",
      "encoded_ascii": "^&Z^$f^*|^*A^*F^*{^(p^%\\^(p^'c^%)^$x^*J^%}^.>^0r^(C^*D^!\" ",
      "encoded_base64": "XiZaXiRmXip8XipBXipGXip7XihwXiVcXihwXidjXiUpXiR4XipKXiV9Xi4+XjByXihDXipEXiEiIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_e40d57281d1d",
      "text": "你們沒看見那邊的那具屍體嗎？他身上帶著一封要送給某個奴隸 ",
      "encoded_ascii": "^*F^*{^%\\^*Q^-m^)!^.8^&Z^)!^!k^#?^**^+X^.V^!@^(c^!'^#N^-a^!%^#5^(C^./^'A^%$^!V^##^)Z ",
      "encoded_base64": "XipGXip7XiVcXipRXi1tXikhXi44XiZaXikhXiFrXiM/XioqXitYXi5WXiFAXihjXiEnXiNOXi1hXiElXiM1XihDXi4vXidBXiUkXiFWXiMjXilaIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_63a8fd0ba636",
      "text": "村莊的卷軸。不過看來是送不到了。 ",
      "encoded_ascii": "^$z^6l^&Z^\"3^(e^!\"^!)^(x^*Q^!O^,X^./^!)^!u^*D^!\" ",
      "encoded_base64": "XiR6XjZsXiZaXiIzXihlXiEiXiEpXih4XipRXiFPXixYXi4vXiEpXiF1XipEXiEiIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_2399d457c95a",
      "text": "你們自己看吧！只要去搜查那具屍體就能找到了。 ",
      "encoded_ascii": "^*F^*{^'l^#I^*Q^*I^*W^\"?^(C^\"6^/h^%&^)!^!k^#?^**^*J^'b^$/^!u^*D^!\" ",
      "encoded_base64": "XipGXip7XidsXiNJXipRXipJXipXXiI/XihDXiI2Xi9oXiUmXikhXiFrXiM/XioqXipKXidiXiQvXiF1XipEXiEiIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_008fef40ac29",
      "text": "我在這裡是因為繼續留在奴隸村子裡太危險了。我想要在 ",
      "encoded_ascii": "^$%^\"d^(s^-j^,X^\"]^%{^-O^'M^-+^\"d^##^)Z^$z^#(^-j^+f^2\\^*m^*D^!\"^$%^,1^(C^\"d ",
      "encoded_base64": "XiQlXiJkXihzXi1qXixYXiJdXiV7Xi1PXidNXi0rXiJkXiMjXilaXiR6XiMoXi1qXitmXjJcXiptXipEXiEiXiQlXiwxXihDXiJkIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_1d1f65c21963",
      "text": "村子被大軍攻陷之前逃出來。真是倒楣，偏偏讓我在這裡碰上了這個奴隸 ",
      "encoded_ascii": "^$z^#(^(@^\"z^..^$O^)S^!/^!z^(p^!q^!O^!\"^-2^,X^!X^/r^*A^![^![^-}^$%^\"d^(s^-j^-5^!'^*D^(s^!V^##^)Z ",
      "encoded_base64": "XiR6XiMoXihAXiJ6Xi4uXiRPXilTXiEvXiF6XihwXiFxXiFPXiEiXi0yXixYXiFYXi9yXipBXiFbXiFbXi19XiQlXiJkXihzXi1qXi01XiEnXipEXihzXiFWXiMjXilaIA==",
      "byte_length": 97
    },
    {
      "unit_id": "DLG_a80348a42eb4",
      "text": "和他身上的卷軸——現在看來真是無處可逃了。 ",
      "encoded_ascii": "^\"O^!@^(c^!'^&Z^\"3^(e^*n^*n^&?^\"d^*Q^!O^-2^,X^%}^(,^\"A^(p^*D^!\" ",
      "encoded_base64": "XiJPXiFAXihjXiEnXiZaXiIzXihlXipuXipuXiY/XiJkXipRXiFPXi0yXixYXiV9XigsXiJBXihwXipEXiEiIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_837c1babe77e",
      "text": "沒錯，我看了，而且我讓它留在那裡跟著屍體一起腐爛。現在什麼都保護不了 ",
      "encoded_ascii": "^%\\^)5^*A^$%^*Q^*D^*A^'W^!*^$%^-}^+o^-+^\"d^)!^-j^.+^-a^#?^**^!%^.(^0/^&-^!\"^&?^\"d^!=^.T^)$^!T^(T^!)^*D ",
      "encoded_base64": "XiVcXik1XipBXiQlXipRXipEXipBXidXXiEqXiQlXi19XitvXi0rXiJkXikhXi1qXi4rXi1hXiM/XioqXiElXi4oXjAvXiYtXiEiXiY/XiJkXiE9Xi5UXikkXiFUXihUXiEpXipEIA==",
      "byte_length": 103
    },
    {
      "unit_id": "DLG_d8b0d0763b4f",
      "text": "我們了。那些村子最好對大軍一無所知；至少那樣一來，他們就 ",
      "encoded_ascii": "^$%^*{^*D^!\"^)!^!8^$z^#(^$q^+i^#:^\"z^..^!%^%}^$)^&h^*C^'n^#<^)!^,f^!%^!O^*A^!@^*{^*J ",
      "encoded_base64": "XiQlXip7XipEXiEiXikhXiE4XiR6XiMoXiRxXitpXiM6XiJ6Xi4uXiElXiV9XiQpXiZoXipDXiduXiM8XikhXixmXiElXiFPXipBXiFAXip7XipKIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_9e23386d76cf",
      "text": "沒有時間去恐懼了——至少不會擔驚受怕太久。 ",
      "encoded_ascii": "^%\\^$s^$f^)G^\"6^#t^$#^*D^*n^*n^'n^#<^!)^$r^*N^.Q^\";^0^^+f^!.^!\" ",
      "encoded_base64": "XiVcXiRzXiRmXilHXiI2XiN0XiQjXipEXipuXipuXiduXiM8XiEpXiRyXipOXi5RXiI7XjBeXitmXiEuXiEiIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_22360aadb3fe",
      "text": "那些村落散佈在荒原各處。那個奴隸原本要前往的村子是 ",
      "encoded_ascii": "^)!^!8^$z^-`^$S^:f^\"d^1W^\"5^+>^(,^!\"^)!^!V^##^)Z^\"5^$x^(C^!z^,)^&Z^$z^#(^,X ",
      "encoded_base64": "XikhXiE4XiR6Xi1gXiRTXjpmXiJkXjFXXiI1Xis+XigsXiEiXikhXiFWXiMjXilaXiI1XiR4XihDXiF6XiwpXiZaXiR6XiMoXixYIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_4663374e49ce",
      "text": "提奎茲爾——我原本就是那裡的人，但我逃了出來。如果你們一路往北走， ",
      "encoded_ascii": "^$A^5B^/D^&/^*n^*n^$%^\"5^$x^*J^,X^)!^-j^&Z^!<^*A^!I^$%^(p^*D^!q^!O^!\"^#$^%!^*F^*{^!%^(a^,)^+6^.&^*A ",
      "encoded_base64": "XiRBXjVCXi9EXiYvXipuXipuXiQlXiI1XiR4XipKXixYXikhXi1qXiZaXiE8XipBXiFJXiQlXihwXipEXiFxXiFPXiEiXiMkXiUhXipGXip7XiElXihhXiwpXis2Xi4mXipBIA==",
      "byte_length": 100
    },
    {
      "unit_id": "DLG_e3422461b33b",
      "text": "就能找到它。 ",
      "encoded_ascii": "^*J^'b^$/^!u^+o^!\" ",
      "encoded_base64": "XipKXidiXiQvXiF1XitvXiEiIA==",
      "byte_length": 19
    },
    {
      "unit_id": "DLG_3509ed3e0ee5",
      "text": "不認得，我也不在乎他是誰。我只知道自己知道得太多了。 ",
      "encoded_ascii": "^!)^(O^#e^*A^$%^!1^!)^\"d^!0^!@^,X^-y^!\"^$%^\"?^&h^(y^'l^#I^&h^(y^#e^+f^\"x^*D^!\" ",
      "encoded_base64": "XiEpXihPXiNlXipBXiQlXiExXiEpXiJkXiEwXiFAXixYXi15XiEiXiQlXiI/XiZoXih5XidsXiNJXiZoXih5XiNlXitmXiJ4XipEXiEiIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_a208a08a002f",
      "text": "我離開村子就是為了擺脫對德拉吉大軍的恐懼， ",
      "encoded_ascii": "^$%^)`^)F^$z^#(^*J^,X^%{^*D^1@^'c^#:^#j^$6^\"D^\"z^..^&Z^#t^$#^*A ",
      "encoded_base64": "XiQlXilgXilGXiR6XiMoXipKXixYXiV7XipEXjFAXidjXiM6XiNqXiQ2XiJEXiJ6Xi4uXiZaXiN0XiQjXipBIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_258d6578ab9b",
      "text": "然而現在我看透了，哪怕逃到這片荒原上，也根本逃不出它的陰影。 ",
      "encoded_ascii": "^&\"^'W^&?^\"d^$%^*Q^(q^*D^*A^+I^0^^(p^!u^(s^&1^1W^\"5^!'^*A^!1^%)^$x^(p^!)^!q^+o^&Z^6B^#a^!\" ",
      "encoded_base64": "XiYiXidXXiY/XiJkXiQlXipRXihxXipEXipBXitJXjBeXihwXiF1XihzXiYxXjFXXiI1XiEnXipBXiExXiUpXiR4XihwXiEpXiFxXitvXiZaXjZCXiNhXiEiIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_518c37e417ac",
      "text": "我當然知道提奎茲爾，在來到這裡之前那裡曾是我的家園。那裡 ",
      "encoded_ascii": "^$%^&N^&\"^&h^(y^$A^5B^/D^&/^*A^\"d^!O^!u^(s^-j^!/^!z^)!^-j^.j^,X^$%^&Z^+s^41^!\"^)!^-j ",
      "encoded_base64": "XiQlXiZOXiYiXiZoXih5XiRBXjVCXi9EXiYvXipBXiJkXiFPXiF1XihzXi1qXiEvXiF6XikhXi1qXi5qXixYXiQlXiZaXitzXjQxXiEiXikhXi1qIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_5d781fae2f2d",
      "text": "還算不錯，但它撐不久了——所有村子都撐不下去。大軍將會橫掃 ",
      "encoded_ascii": "^.7^-C^!)^)5^*A^!I^+o^,L^!)^!.^*D^*n^*n^$)^$s^$z^#(^)$^,L^!)^!(^\"6^!\"^\"z^..^#7^$r^/2^:p ",
      "encoded_base64": "Xi43Xi1DXiEpXik1XipBXiFJXitvXixMXiEpXiEuXipEXipuXipuXiQpXiRzXiR6XiMoXikkXixMXiEpXiEoXiI2XiEiXiJ6Xi4uXiM3XiRyXi8yXjpwIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_3a47e67bc4bf",
      "text": "整片荒原，摧毀沿途的一切。 ",
      "encoded_ascii": "^$T^&1^1W^\"5^*A^$E^%N^%`^3.^&Z^!%^+.^!\" ",
      "encoded_base64": "XiRUXiYxXjFXXiI1XipBXiRFXiVOXiVgXjMuXiZaXiElXisuXiEiIA==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_7c5a98f66542",
      "text": "忘了你們看過那份卷軸的事吧——那樣日子會好過得多。 ",
      "encoded_ascii": "^0]^*D^*F^*{^*Q^(x^)!^*x^\"3^(e^&Z^*r^*I^*n^*n^)!^,f^$a^#(^$r^+i^(x^#e^\"x^!\" ",
      "encoded_base64": "XjBdXipEXipGXip7XipRXih4XikhXip4XiIzXihlXiZaXipyXipJXipuXipuXikhXixmXiRhXiMoXiRyXitpXih4XiNlXiJ4XiEiIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_6fcec559719a",
      "text": "趁你們還有時間，最好早點替自己準備後事吧。 ",
      "encoded_ascii": "^.)^*F^*{^.7^$s^$f^)G^*A^$q^+i^,V^*;^2o^'l^#I^,x^+\"^#b^*r^*I^!\" ",
      "encoded_base64": "Xi4pXipGXip7Xi43XiRzXiRmXilHXipBXiRxXitpXixWXio7XjJvXidsXiNJXix4XisiXiNiXipyXipJXiEiIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_a9aedc43aed6",
      "text": "去跟頭領談談。",
      "encoded_ascii": "^\"6^.+^)t^)s^0;^0;^!\"",
      "encoded_base64": "XiI2Xi4rXil0XilzXjA7XjA7XiEi",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_773f78b71e8f",
      "text": "那群走過來的卑賤奴隸敗類是誰？衛兵——把他們給我殺了， ",
      "encoded_ascii": "^)!^'R^.&^(x^!O^&Z^\".^2G^##^)Z^$R^)w^,X^-y^.V^(=^+,^*n^*n^$1^!@^*{^'A^$%^%M^*D^*A ",
      "encoded_base64": "XikhXidSXi4mXih4XiFPXiZaXiIuXjJHXiMjXilaXiRSXil3XixYXi15Xi5WXig9XissXipuXipuXiQxXiFAXip7XidBXiQlXiVNXipEXipBIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_db99b78a2599",
      "text": "竟敢膽大妄為直視本大爺。等等，我好像在哪裡見過他們…… ",
      "encoded_ascii": "^28^/m^-[^\"z^+j^%{^&`^(E^$x^\"z^=S^!\"^'-^'-^*A^$%^+i^!`^\"d^+I^-j^-m^(x^!@^*{^*o^*o ",
      "encoded_base64": "XjI4Xi9tXi1bXiJ6XitqXiV7XiZgXihFXiR4XiJ6Xj1TXiEiXictXictXipBXiQlXitpXiFgXiJkXitJXi1qXi1tXih4XiFAXip7XipvXipvIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_5d6ff239f629",
      "text": "你距離太遠，無法與報幕官交談。 ",
      "encoded_ascii": "^*F^2I^)`^+f^({^*A^%}^%b^'p^+`^#Q^#-^0P^0;^!\" ",
      "encoded_base64": "XipGXjJJXilgXitmXih7XipBXiV9XiViXidwXitgXiNRXiMtXjBQXjA7XiEiIA==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_dad48ad3ad59",
      "text": "再會了。很高興能再次見到你們。 ",
      "encoded_ascii": "^!l^$r^*D^!\"^*K^*+^-]^'b^!l^%D^-m^!u^*F^*{^!\" ",
      "encoded_base64": "XiFsXiRyXipEXiEiXipLXiorXi1dXidiXiFsXiVEXi1tXiF1XipGXip7XiEiIA==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_8e6a3daef0ed",
      "text": "不！不可能……你們是怎麼活下來的？ ",
      "encoded_ascii": "^!)^*W^!)^\"A^'b^*o^*o^*F^*{^,X^,,^.T^%i^!(^!O^&Z^.V ",
      "encoded_base64": "XiEpXipXXiEpXiJBXidiXipvXipvXipGXip7XixYXiwsXi5UXiVpXiEoXiFPXiZaXi5WIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_6cb65a79713d",
      "text": "  這不關你的事！ ",
      "encoded_ascii": "  ^(s^!)^.>^*F^&Z^*r^*W ",
      "encoded_base64": "ICBeKHNeISleLj5eKkZeJlpeKnJeKlcg",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_20de245df8d7",
      "text": "  我從下水道的一條秘密地道逃出來的。 ",
      "encoded_ascii": "  ^$%^#f^!(^%V^(y^&Z^!%^%.^1O^#0^\"e^(y^(p^!q^!O^&Z^!\" ",
      "encoded_base64": "ICBeJCVeI2ZeISheJVZeKHleJlpeISVeJS5eMU9eIzBeImVeKHleKHBeIXFeIU9eJlpeISIg",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_a82e947274be",
      "text": "  我一路砍翻了成群結隊的衛兵。 ",
      "encoded_ascii": "  ^$%^!%^(a^&l^-Q^*D^$$^'R^'@^)U^&Z^(=^+,^!\" ",
      "encoded_base64": "ICBeJCVeISVeKGFeJmxeLVFeKkReJCReJ1JeJ0BeKVVeJlpeKD1eKyxeISIg",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_096a8dc7b68d",
      "text": "去死吧，德拉吉敗類！！ ",
      "encoded_ascii": "^\"6^%L^*I^*A^#j^$6^\"D^$R^)w^*W^*W ",
      "encoded_base64": "XiI2XiVMXipJXipBXiNqXiQ2XiJEXiRSXil3XipXXipXIA==",
      "byte_length": 34
    },
    {
      "unit_id": "DLG_29ad5ddaf9e1",
      "text": "們該啟程上路了。很高興，呃， ",
      "encoded_ascii": "^*{^(M^57^'#^!'^(a^*D^!\"^*K^*+^-]^*A^3<^*A ",
      "encoded_base64": "Xip7XihNXjU3XicjXiEnXihhXipEXiEiXipLXiorXi1dXipBXjM8XipBIA==",
      "byte_length": 43
    },
    {
      "unit_id": "DLG_e86c897026c3",
      "text": "看到你們過得很好。 ",
      "encoded_ascii": "^*Q^!u^*F^*{^(x^#e^*K^+i^!\" ",
      "encoded_base64": "XipRXiF1XipGXip7Xih4XiNlXipLXitpXiEiIA==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_b88c0420d09c",
      "text": " 休想。我們還有事情要好好談談。",
      "encoded_ascii": " ^!G^,1^!\"^$%^*{^.7^$s^*r^,0^(C^+i^+i^0;^0;^!\"",
      "encoded_base64": "IF4hR14sMV4hIl4kJV4qe14uN14kc14qcl4sMF4oQ14raV4raV4wO14wO14hIg==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_9cfa9bda9acd",
      "text": " 死亡將是你唯一的伴侶！哈啊！",
      "encoded_ascii": " ^%L^!:^#7^,X^*F^+O^!%^&Z^1h^=R^*W^+F^+Q^*W",
      "encoded_base64": "IF4lTF4hOl4jN14sWF4qRl4rT14hJV4mWl4xaF49Ul4qV14rRl4rUV4qVw==",
      "byte_length": 43
    },
    {
      "unit_id": "DLG_a38880f93422",
      "text": "再會……祝你們旅途順利。",
      "encoded_ascii": "^!l^$r^*o^*o^&v^*F^*{^2m^3.^.D^!t^!\"",
      "encoded_base64": "XiFsXiRyXipvXipvXiZ2XipGXip7XjJtXjMuXi5EXiF0XiEi",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_3b83ca8577f0",
      "text": "這片沙漠中埋藏著一個箱子。它的位置 ",
      "encoded_ascii": "^(s^&1^%]^,}^!,^1r^-f^-a^!%^!V^'/^#(^!\"^+o^&Z^!J^'Q ",
      "encoded_base64": "XihzXiYxXiVdXix9XiEsXjFyXi1mXi1hXiElXiFWXicvXiMoXiEiXitvXiZaXiFKXidRIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_dc82e6549245",
      "text": "只有我一個人知曉，而現在你們也知道了。 ",
      "encoded_ascii": "^\"?^$s^$%^!%^!V^!<^&h^7y^*A^'W^&?^\"d^*F^*{^!1^&h^(y^*D^!\" ",
      "encoded_base64": "XiI/XiRzXiQlXiElXiFWXiE8XiZoXjd5XipBXidXXiY/XiJkXipGXip7XiExXiZoXih5XipEXiEiIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_a1b94b28a9dd",
      "text": "找到『龍之眼』並在那裡挖掘。 ",
      "encoded_ascii": "^$/^!u^<_^*>^!/^&d^<`^!+^\"d^)!^-j^2!^=@^!\" ",
      "encoded_base64": "XiQvXiF1XjxfXio+XiEvXiZkXjxgXiErXiJkXikhXi1qXjIhXj1AXiEiIA==",
      "byte_length": 43
    },
    {
      "unit_id": "DLG_5030600741e0",
      "text": "那麼，你們到底想要什麼？",
      "encoded_ascii": "^)!^.T^*A^*F^*{^!u^/^^,1^(C^!=^.T^.V",
      "encoded_base64": "XikhXi5UXipBXipGXip7XiF1Xi9eXiwxXihDXiE9Xi5UXi5W",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_bb64cdd2cae9",
      "text": "  很好，現在把你身上所有的錢都交出來！ ",
      "encoded_ascii": "  ^*K^+i^*A^&?^\"d^$1^*F^(c^!'^$)^$s^&Z^.<^)$^0P^!q^!O^*W ",
      "encoded_base64": "ICBeKkteK2leKkFeJj9eImReJDFeKkZeKGNeISdeJCleJHNeJlpeLjxeKSReMFBeIXFeIU9eKlcg",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_b5d004de976f",
      "text": "  只要把你擁有的全部東西交出來，就足以抵命了。 ",
      "encoded_ascii": "  ^\"?^(C^$1^*F^,M^$s^&Z^!h^)#^,`^-l^0P^!q^!O^*A^*J^(^^!B^$5^\"N^*D^!\" ",
      "encoded_base64": "ICBeIj9eKENeJDFeKkZeLE1eJHNeJlpeIWheKSNeLGBeLWxeMFBeIXFeIU9eKkFeKkpeKF5eIUJeJDVeIk5eKkReISIg",
      "byte_length": 69
    },
    {
      "unit_id": "DLG_720503f62529",
      "text": "  這個『龍眼』在哪裡？ ",
      "encoded_ascii": "  ^(s^!V^<_^*>^&d^<`^\"d^+I^-j^.V ",
      "encoded_base64": "ICBeKHNeIVZePF9eKj5eJmRePGBeImReK0leLWpeLlYg",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_7f2705c71e04",
      "text": "我改變主意了……準備受死吧！ ",
      "encoded_ascii": "^$%^$N^(U^!-^#z^*D^*o^*o^,x^+\"^\";^%L^*I^*W ",
      "encoded_base64": "XiQlXiROXihVXiEtXiN6XipEXipvXipvXix4XisiXiI7XiVMXipJXipXIA==",
      "byte_length": 43
    },
    {
      "unit_id": "DLG_9d02a351e530",
      "text": "趁我還沒動手殺你之前滾出這裡。",
      "encoded_ascii": "^.)^$%^.7^%\\^\"%^$+^%M^*F^!/^!z^,z^!q^(s^-j^!\"",
      "encoded_base64": "Xi4pXiQlXi43XiVcXiIlXiQrXiVNXipGXiEvXiF6Xix6XiFxXihzXi1qXiEi",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_2c955cd18976",
      "text": "我明白了，呃，我",
      "encoded_ascii": "^$%^$c^&X^*D^*A^3<^*A^$%",
      "encoded_base64": "XiQlXiRjXiZYXipEXipBXjM8XipBXiQl",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_8c435b8297f2",
      "text": "那可真聰明。我，呃，其實私底下一直期盼你們能逃脫呢。我",
      "encoded_ascii": "^)!^\"A^-2^2=^$c^!\"^$%^*A^3<^*A^!j^#3^&~^/^^!(^!%^&`^$u^23^*F^*{^'b^(p^'c^+C^!\"^$%",
      "encoded_base64": "XikhXiJBXi0yXjI9XiRjXiEiXiQlXipBXjM8XipBXiFqXiMzXiZ+Xi9eXiEoXiElXiZgXiR1XjIzXipGXip7XidiXihwXidjXitDXiEiXiQl",
      "byte_length": 81
    },
    {
      "unit_id": "DLG_61964df59e33",
      "text": "喔……好吧，很高興看到競技場讓你們做好了面對 ",
      "encoded_ascii": "^+T^*o^*o^+i^*I^*A^*K^*+^-]^*Q^!u^-?^,>^\"n^-}^*F^*{^*~^+i^*D^)j^#: ",
      "encoded_base64": "XitUXipvXipvXitpXipJXipBXipLXiorXi1dXipRXiF1Xi0/Xiw+XiJuXi19XipGXip7Xip+XitpXipEXilqXiM6IA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_ab1381ac2610",
      "text": "亞薩斯殘酷現實的準備。我",
      "encoded_ascii": "^!9^-e^$[^,l^1b^&?^#3^&Z^,x^+\"^!\"^$%",
      "encoded_base64": "XiE5Xi1lXiRbXixsXjFiXiY/XiMzXiZaXix4XisiXiEiXiQl",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_fe7af8c7cd65",
      "text": "聽著，如果你們饒我一命，我就告訴你們一個絕佳的 ",
      "encoded_ascii": "^-X^-a^*A^#$^%!^*F^*{^.M^$%^!%^\"N^*A^$%^*J^+B^-t^*F^*{^!%^!V^-I^7P^&Z ",
      "encoded_base64": "Xi1YXi1hXipBXiMkXiUhXipGXip7Xi5NXiQlXiElXiJOXipBXiQlXipKXitCXi10XipGXip7XiElXiFWXi1JXjdQXiZaIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_fe36aab6eac9",
      "text": "發財機會。有興趣嗎？ ",
      "encoded_ascii": "^&W^0=^%>^$r^!\"^$s^-]^.*^+X^.V ",
      "encoded_base64": "XiZXXjA9XiU+XiRyXiEiXiRzXi1dXi4qXitYXi5WIA==",
      "byte_length": 31
    },
    {
      "unit_id": "DLG_f5648d822cfb",
      "text": "它在鹽灘上，我只知道這麼多。 ",
      "encoded_ascii": "^+o^\"d^*4^:j^!'^*A^$%^\"?^&h^(y^(s^.T^\"x^!\" ",
      "encoded_base64": "XitvXiJkXio0XjpqXiEnXipBXiQlXiI/XiZoXih5XihzXi5UXiJ4XiEiIA==",
      "byte_length": 43
    },
    {
      "unit_id": "DLG_3942128b41e2",
      "text": "休想！衛兵——殺了他們！ ",
      "encoded_ascii": "^!G^,1^*W^(=^+,^*n^*n^%M^*D^!@^*{^*W ",
      "encoded_base64": "XiFHXiwxXipXXig9XissXipuXipuXiVNXipEXiFAXip7XipXIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_9cf7166897b0",
      "text": "如果你們能饒我一命，我就能掏出我的錢。 ",
      "encoded_ascii": "^#$^%!^*F^*{^'b^.M^$%^!%^\"N^*A^$%^*J^'b^/f^!q^$%^&Z^.<^!\" ",
      "encoded_base64": "XiMkXiUhXipGXip7XidiXi5NXiQlXiElXiJOXipBXiQlXipKXidiXi9mXiFxXiQlXiZaXi48XiEiIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_2bb2fd9e91eb",
      "text": "我所有的錢都在這個盒子裡。",
      "encoded_ascii": "^$%^$)^$s^&Z^.<^)$^\"d^(s^!V^/~^#(^-j^!\"",
      "encoded_base64": "XiQlXiQpXiRzXiZaXi48XikkXiJkXihzXiFWXi9+XiMoXi1qXiEi",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_d4e4f686e0f3",
      "text": "再會！ ",
      "encoded_ascii": "^!l^$r^*W ",
      "encoded_base64": "XiFsXiRyXipXIA==",
      "byte_length": 10
    },
    {
      "unit_id": "DLG_e90780ae337d",
      "text": "你獲得了蝴蝶翅膀。 ",
      "encoded_ascii": "^*F^&:^#e^*D^(5^(6^95^96^!\" ",
      "encoded_base64": "XipGXiY6XiNlXipEXig1Xig2Xjk1Xjk2XiEiIA==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_97107d57288f",
      "text": "竟敢破壞我的領地！準備受死吧。 ",
      "encoded_ascii": "^28^/m^&n^\"v^$%^&Z^)s^\"e^*W^,x^+\"^\";^%L^*I^!\" ",
      "encoded_base64": "XjI4Xi9tXiZuXiJ2XiQlXiZaXilzXiJlXipXXix4XisiXiI7XiVMXipJXiEiIA==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_360fb11347ee",
      "text": "  放馬過來吧！ ",
      "encoded_ascii": "  ^$P^*\"^(x^!O^*I^*W ",
      "encoded_base64": "ICBeJFBeKiJeKHheIU9eKkleKlcg",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_6e2c00747e47",
      "text": "  我不知道這座綠洲有守護者。 ",
      "encoded_ascii": "  ^$%^!)^&h^(y^(s^/_^3V^76^$s^#+^(T^'V^!\" ",
      "encoded_base64": "ICBeJCVeISleJmheKHleKHNeL19eM1ZeNzZeJHNeIyteKFReJ1ZeISIg",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_544deefecd87",
      "text": "  饒了我吧，我沒有惡意！ ",
      "encoded_ascii": "  ^.M^*D^$%^*I^*A^$%^%\\^$s^#y^#z^*W ",
      "encoded_base64": "ICBeLk1eKkReJCVeKkleKkFeJCVeJVxeJHNeI3leI3peKlcg",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_1b84755c3930",
      "text": "  我需要蝴蝶翅膀拿去賣錢。 ",
      "encoded_ascii": "  ^$%^)e^(C^(5^(6^95^96^,G^\"6^.$^.<^!\" ",
      "encoded_base64": "ICBeJCVeKWVeKENeKDVeKDZeOTVeOTZeLEdeIjZeLiReLjxeISIg",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_7a922a9153b8",
      "text": "你又一次褻瀆了這座綠洲。受死吧！",
      "encoded_ascii": "^*F^+;^!%^%D^-k^,~^*D^(s^/_^3V^76^!\"^\";^%L^*I^*W",
      "encoded_base64": "XipGXis7XiElXiVEXi1rXix+XipEXihzXi9fXjNWXjc2XiEiXiI7XiVMXipJXipX",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_72173438126c",
      "text": "拿蝴蝶翅膀去賣！太令人作嘔了！難道你徹底喪失了 ",
      "encoded_ascii": "^,G^(5^(6^95^96^\"6^.$^*W^+f^*w^!<^!M^0T^*D^*W^)a^(y^*F^18^/^^1)^\"|^*D ",
      "encoded_base64": "XixHXig1Xig2Xjk1Xjk2XiI2Xi4kXipXXitmXip3XiE8XiFNXjBUXipEXipXXilhXih5XipGXjE4Xi9eXjEpXiJ8XipEIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_3324ec39e109",
      "text": "一切道德良知嗎？你真該為自己感到羞恥。如果你缺錢， ",
      "encoded_ascii": "^!%^+.^(y^#j^1V^&h^+X^.V^*F^-2^(M^%{^'l^#I^#{^!u^;3^3G^!\"^#$^%!^*F^7e^.<^*A ",
      "encoded_base64": "XiElXisuXih5XiNqXjFWXiZoXitYXi5WXipGXi0yXihNXiV7XidsXiNJXiN7XiF1XjszXjNHXiEiXiMkXiUhXipGXjdlXi48XipBIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_056cc79cc8ab",
      "text": "就去西南方的寶石礦原吧。你可以拿走你已經 ",
      "encoded_ascii": "^*J^\"6^-l^\"/^$]^&Z^#4^&k^5m^\"5^*I^!\"^*F^\"A^!B^,G^.&^*F^#J^'D ",
      "encoded_base64": "XipKXiI2Xi1sXiIvXiRdXiZaXiM0XiZrXjVtXiI1XipJXiEiXipGXiJBXiFCXixHXi4mXipGXiNKXidEIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_db372b9aafb2",
      "text": "收集到的那些翅膀。但要是你膽敢再殺一隻蝴蝶，我就拔掉你的 ",
      "encoded_ascii": "^$M^)]^!u^&Z^)!^!8^95^96^!\"^!I^(C^,X^*F^-[^/m^!l^%M^!%^)[^(5^(6^*A^$%^*J^/c^/e^*F^&Z ",
      "encoded_base64": "XiRNXildXiF1XiZaXikhXiE4Xjk1Xjk2XiEiXiFJXihDXixYXipGXi1bXi9tXiFsXiVNXiElXilbXig1Xig2XipBXiQlXipKXi9jXi9lXipGXiZaIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_e5655aa387fc",
      "text": "雙翼。 ",
      "encoded_ascii": "^)_^'T^!\" ",
      "encoded_base64": "XilfXidUXiEiIA==",
      "byte_length": 10
    },
    {
      "unit_id": "DLG_0653068a8fd2",
      "text": "  你算什麼東西，敢對我發號施令？",
      "encoded_ascii": "  ^*F^-C^!=^.T^,`^-l^*A^/m^#:^$%^&W^(-^$_^*w^.V",
      "encoded_base64": "ICBeKkZeLUNeIT1eLlReLGBeLWxeKkFeL21eIzpeJCVeJldeKC1eJF9eKndeLlY=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_788f02063ad7",
      "text": "  我深表歉意。 ",
      "encoded_ascii": "  ^$%^2*^-i^,h^#z^!\" ",
      "encoded_base64": "ICBeJCVeMipeLWleLGheI3peISIg",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_e9f05e1596c6",
      "text": "  我保證立刻離開。 ",
      "encoded_ascii": "  ^$%^!T^-{^0'^.Y^)`^)F^!\" ",
      "encoded_base64": "ICBeJCVeIVReLXteMCdeLlleKWBeKUZeISIg",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_3baf85d05bba",
      "text": "你太魯莽無知了。",
      "encoded_ascii": "^*F^+f^/K^;8^%}^&h^*D^!\"",
      "encoded_base64": "XipGXitmXi9LXjs4XiV9XiZoXipEXiEi",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_eb0139c0766d",
      "text": "很好。快滾吧。 ",
      "encoded_ascii": "^*K^+i^!\"^*L^,z^*I^!\" ",
      "encoded_base64": "XipLXitpXiEiXipMXix6XipJXiEiIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_d0f7319816e2",
      "text": "我們之中只有一個人能活著走出這場遭遇！ ",
      "encoded_ascii": "^$%^*{^!/^!,^\"?^$s^!%^!V^!<^'b^%i^-a^.&^!q^(s^\"n^(}^.2^*W ",
      "encoded_base64": "XiQlXip7XiEvXiEsXiI/XiRzXiElXiFWXiE8XidiXiVpXi1hXi4mXiFxXihzXiJuXih9Xi4yXipXIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_41a68c3338b7",
      "text": "那也不能成為無故攻擊其他生靈的藉口。 ",
      "encoded_ascii": "^)!^!1^!)^'b^$$^%{^%}^5U^$O^$F^!j^!@^&F^)g^&Z^04^\"<^!\" ",
      "encoded_base64": "XikhXiExXiEpXidiXiQkXiV7XiV9XjVVXiRPXiRGXiFqXiFAXiZGXilnXiZaXjA0XiI8XiEiIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_30c75b8a9e63",
      "text": "我接受你的誠懇道歉。只要你克制自己不再無端傷害 ",
      "encoded_ascii": "^$%^$?^\";^*F^&Z^2E^3t^(y^,h^!\"^\"?^(C^*F^!d^!v^'l^#I^!)^!l^%}^5o^!^^#/ ",
      "encoded_base64": "XiQlXiQ/XiI7XipGXiZaXjJFXjN0Xih5XixoXiEiXiI/XihDXipGXiFkXiF2XidsXiNJXiEpXiFsXiV9XjVvXiFeXiMvIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_874740a01aa4",
      "text": "這座綠洲的任何生靈，你就可以留下來。 ",
      "encoded_ascii": "^(s^/_^3V^76^&Z^!C^!L^&F^)g^*A^*F^*J^\"A^!B^-+^!(^!O^!\" ",
      "encoded_base64": "XihzXi9fXjNWXjc2XiZaXiFDXiFMXiZGXilnXipBXipGXipKXiJBXiFCXi0rXiEoXiFPXiEiIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_4244f483ba51",
      "text": "你不必離開。只要別傷害生活在這座綠洲裡的動物與 ",
      "encoded_ascii": "^*F^!)^#l^)`^)F^!\"^\"?^(C^*H^!^^#/^&F^%i^\"d^(s^/_^3V^76^-j^&Z^\"%^&4^'p ",
      "encoded_base64": "XipGXiEpXiNsXilgXilGXiEiXiI/XihDXipIXiFeXiMvXiZGXiVpXiJkXihzXi9fXjNWXjc2Xi1qXiZaXiIlXiY0XidwIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_ee84cc4384df",
      "text": "植物就行了。 ",
      "encoded_ascii": "^%3^&4^*J^(;^*D^!\" ",
      "encoded_base64": "XiUzXiY0XipKXig7XipEXiEiIA==",
      "byte_length": 19
    },
    {
      "unit_id": "DLG_140204b62b62",
      "text": "我會密切監視你的一舉一動。 ",
      "encoded_ascii": "^$%^$r^#0^+.^2|^(E^*F^&Z^!%^01^!%^\"%^!\" ",
      "encoded_base64": "XiQlXiRyXiMwXisuXjJ8XihFXipGXiZaXiElXjAxXiElXiIlXiEiIA==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_a552b45358d8",
      "text": "我是德魯伊阿蘭塔爾，我恪盡職守，誓要摧毀 ",
      "encoded_ascii": "^$%^,X^#j^/K^!E^)M^/G^\"o^&/^*A^$%^49^-1^'\\^#+^*A^-w^(C^$E^%N ",
      "encoded_base64": "XiQlXixYXiNqXi9LXiFFXilNXi9HXiJvXiYvXipBXiQlXjQ5Xi0xXidcXiMrXipBXi13XihDXiRFXiVOIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_539e81795978",
      "text": "所有企圖玷污這片領地之徒。 ",
      "encoded_ascii": "^$)^$s^4-^\"b^1K^0h^(s^&1^)s^\"e^!/^#d^!\" ",
      "encoded_base64": "XiQpXiRzXjQtXiJiXjFLXjBoXihzXiYxXilzXiJlXiEvXiNkXiEiIA==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_4ff8e0ccb89a",
      "text": "看在你似乎真心悔過的份上，我會將最近死去的幾隻蝴蝶的 ",
      "encoded_ascii": "^*Q^\"d^*F^!H^!0^-2^#k^6Y^(x^&Z^*x^!'^*A^$%^$r^#7^$q^(l^%L^\"6^&Z^#T^)[^(5^(6^&Z ",
      "encoded_base64": "XipRXiJkXipGXiFIXiEwXi0yXiNrXjZZXih4XiZaXip4XiEnXipBXiQlXiRyXiM3XiRxXihsXiVMXiI2XiZaXiNUXilbXig1Xig2XiZaIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_d7dc1f6ce70f",
      "text": "翅膀送給你。然而，要是我看見你在我的綠洲裡攻擊 ",
      "encoded_ascii": "^95^96^./^'A^*F^!\"^&\"^'W^*A^(C^,X^$%^*Q^-m^*F^\"d^$%^&Z^3V^76^-j^$O^$F ",
      "encoded_base64": "Xjk1Xjk2Xi4vXidBXipGXiEiXiYiXidXXipBXihDXixYXiQlXipRXi1tXipGXiJkXiQlXiZaXjNWXjc2Xi1qXiRPXiRGIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_b4b318c65d0c",
      "text": "其他任何生靈，我就不得不取你性命。 ",
      "encoded_ascii": "^!j^!@^!C^!L^&F^)g^*A^$%^*J^!)^#e^!)^\":^*F^#r^\"N^!\" ",
      "encoded_base64": "XiFqXiFAXiFDXiFMXiZGXilnXipBXiQlXipKXiEpXiNlXiEpXiI6XipGXiNyXiJOXiEiIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_3bb0753ecafe",
      "text": "你在戰鬥中無法播種種子。",
      "encoded_ascii": "^*F^\"d^$(^*,^!,^%}^%b^4A^'$^'$^#(^!\"",
      "encoded_base64": "XipGXiJkXiQoXiosXiEsXiV9XiViXjRBXickXickXiMoXiEi",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_6f1adf7aef4b",
      "text": "你要播下這顆種子嗎？",
      "encoded_ascii": "^*F^(C^4A^!(^(s^)u^'$^#(^+X^.V",
      "encoded_base64": "XipGXihDXjRBXiEoXihzXil1XickXiMoXitYXi5W",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_b484e99d6fd6",
      "text": "謝謝你們！能看到有人關心 ",
      "encoded_ascii": "^-z^-z^*F^*{^*W^'b^*Q^!u^$s^!<^.>^#k ",
      "encoded_base64": "Xi16Xi16XipGXip7XipXXidiXipRXiF1XiRzXiE8Xi4+XiNrIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_b56896802f2b",
      "text": "花草與動物，真是令人欣慰的改變。我是阿蘭塔爾，這座 ",
      "encoded_ascii": "^'w^*f^'p^\"%^&4^*A^-2^,X^*w^!<^2'^4<^&Z^$N^(U^!\"^$%^,X^)M^/G^\"o^&/^*A^(s^/_ ",
      "encoded_base64": "Xid3XipmXidwXiIlXiY0XipBXi0yXixYXip3XiE8XjInXjQ8XiZaXiROXihVXiEiXiQlXixYXilNXi9HXiJvXiYvXipBXihzXi9fIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_7ee41c35e1cf",
      "text": "綠洲的守護者。你們的善舉為我重新點燃了對亞薩斯的希望。 ",
      "encoded_ascii": "^3V^76^&Z^#+^(T^'V^!\"^*F^*{^&Z^1(^01^%{^$%^))^$\\^*;^&%^*D^#:^!9^-e^$[^&Z^+{^,]^!\" ",
      "encoded_base64": "XjNWXjc2XiZaXiMrXihUXidWXiEiXipGXip7XiZaXjEoXjAxXiV7XiQlXikpXiRcXio7XiYlXipEXiM6XiE5Xi1lXiRbXiZaXit7XixdXiEiIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_91542ea17d49",
      "text": "有什麼我可以為你們效勞以回報這份恩情嗎？",
      "encoded_ascii": "^$s^!=^.T^$%^\"A^!B^%{^*F^*{^$Q^/R^!B^\"\\^+`^(s^*x^#v^,0^+X^.V",
      "encoded_base64": "XiRzXiE9Xi5UXiQlXiJBXiFCXiV7XipGXip7XiRRXi9SXiFCXiJcXitgXihzXip4XiN2XiwwXitYXi5W",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_683a0143be14",
      "text": "  不必了，行善本身就是最好的回報。",
      "encoded_ascii": "  ^!)^#l^*D^*A^(;^1(^$x^(c^*J^,X^$q^+i^&Z^\"\\^+`^!\"",
      "encoded_base64": "ICBeISleI2xeKkReKkFeKDteMSheJHheKGNeKkpeLFheJHFeK2leJlpeIlxeK2BeISI=",
      "byte_length": 50
    },
    {
      "unit_id": "DLG_74116331db56",
      "text": "  你身上有任何蝴蝶翅膀嗎？",
      "encoded_ascii": "  ^*F^(c^!'^$s^!C^!L^(5^(6^95^96^+X^.V",
      "encoded_base64": "ICBeKkZeKGNeISdeJHNeIUNeIUxeKDVeKDZeOTVeOTZeK1heLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_28fcde1ba7cc",
      "text": "  現在不需要，也許以後吧。",
      "encoded_ascii": "  ^&?^\"d^!)^)e^(C^*A^!1^-s^!B^#b^*I^!\"",
      "encoded_base64": "ICBeJj9eImReISleKWVeKENeKkFeITFeLXNeIUJeI2JeKkleISI=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_244d84517cab",
      "text": "如果你把種子種在這裡，它會因缺水而枯死。",
      "encoded_ascii": "^#$^%!^*F^$1^'$^#(^'$^\"d^(s^-j^*A^+o^$r^\"]^7e^%V^'W^5Z^%L^!\"",
      "encoded_base64": "XiMkXiUhXipGXiQxXickXiMoXickXiJkXihzXi1qXipBXitvXiRyXiJdXjdlXiVWXidXXjVaXiVMXiEi",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_abc5330253d4",
      "text": "你們真了不起！知道世上還有像你們這樣的人， ",
      "encoded_ascii": "^*F^*{^-2^*D^!)^.(^*W^&h^(y^*p^!'^.7^$s^!`^*F^*{^(s^,f^&Z^!<^*A ",
      "encoded_base64": "XipGXip7Xi0yXipEXiEpXi4oXipXXiZoXih5XipwXiEnXi43XiRzXiFgXipGXip7XihzXixmXiZaXiE8XipBIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_9f0f415644d5",
      "text": "讓我的心靈為之一亮。如果需要任何幫助，儘管告訴我，我會 ",
      "encoded_ascii": "^-}^$%^&Z^#k^)g^%{^!/^!%^*t^!\"^#$^%!^)e^(C^!C^!L^+}^\"#^*A^+(^-D^+B^-t^$%^*A^$%^$r ",
      "encoded_base64": "Xi19XiQlXiZaXiNrXilnXiV7XiEvXiElXip0XiEiXiMkXiUhXillXihDXiFDXiFMXit9XiIjXipBXisoXi1EXitCXi10XiQlXipBXiQlXiRyIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_9c2e5525e9de",
      "text": "竭盡所能提供協助。",
      "encoded_ascii": "^29^-1^$)^'b^$A^!P^2[^\"#^!\"",
      "encoded_base64": "XjI5Xi0xXiQpXidiXiRBXiFQXjJbXiIjXiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_c324d39c3b3c",
      "text": "我的一些蝴蝶最近自然死去了，所以我剛好有幾對可以 ",
      "encoded_ascii": "^$%^&Z^!%^!8^(5^(6^$q^(l^'l^&\"^%L^\"6^*D^*A^$)^!B^$%^+0^+i^$s^#T^#:^\"A^!B ",
      "encoded_base64": "XiQlXiZaXiElXiE4Xig1Xig2XiRxXihsXidsXiYiXiVMXiI2XipEXipBXiQpXiFCXiQlXiswXitpXiRzXiNUXiM6XiJBXiFCIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_232ff71a7c97",
      "text": "送給你們。拿去吧。",
      "encoded_ascii": "^./^'A^*F^*{^!\"^,G^\"6^*I^!\"",
      "encoded_base64": "Xi4vXidBXipGXip7XiEiXixHXiI2XipJXiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_629623615fe3",
      "text": "再會，祝你們旅途一帆風順。",
      "encoded_ascii": "^!l^$r^*A^&v^*F^*{^2m^3.^!%^1x^)y^.D^!\"",
      "encoded_base64": "XiFsXiRyXipBXiZ2XipGXip7XjJtXjMuXiElXjF4Xil5Xi5EXiEi",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_5529cef563f5",
      "text": "我就在附近，若需要任何東西儘管告訴我。再次感謝你們 ",
      "encoded_ascii": "^$%^*J^\"d^.?^(l^*A^'x^)e^(C^!C^!L^,`^-l^+(^-D^+B^-t^$%^!\"^!l^%D^#{^-z^*F^*{ ",
      "encoded_base64": "XiQlXipKXiJkXi4/XihsXipBXid4XillXihDXiFDXiFMXixgXi1sXisoXi1EXitCXi10XiQlXiEiXiFsXiVEXiN7Xi16XipGXip7IA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_c3c029ba2fcd",
      "text": "替我播下那顆種子。",
      "encoded_ascii": "^2o^$%^4A^!(^)!^)u^'$^#(^!\"",
      "encoded_base64": "XjJvXiQlXjRBXiEoXikhXil1XickXiMoXiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_c92ce97cc6a4",
      "text": "再會。謝謝你們為我播下種子。",
      "encoded_ascii": "^!l^$r^!\"^-z^-z^*F^*{^%{^$%^4A^!(^'$^#(^!\"",
      "encoded_base64": "XiFsXiRyXiEiXi16Xi16XipGXip7XiV7XiQlXjRBXiEoXickXiMoXiEi",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_be3aa552ae64",
      "text": "你們好。現在有什麼我能為你們效勞的嗎？",
      "encoded_ascii": "^*F^*{^+i^!\"^&?^\"d^$s^!=^.T^$%^'b^%{^*F^*{^$Q^/R^&Z^+X^.V",
      "encoded_base64": "XipGXip7XitpXiEiXiY/XiJkXiRzXiE9Xi5UXiQlXidiXiV7XipGXip7XiRRXi9SXiZaXitYXi5W",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_8b2ffe68c96a",
      "text": "  沒事，我只是順道過來看看。",
      "encoded_ascii": "  ^%\\^*r^*A^$%^\"?^,X^.D^(y^(x^!O^*Q^*Q^!\"",
      "encoded_base64": "ICBeJVxeKnJeKkFeJCVeIj9eLFheLkReKHleKHheIU9eKlFeKlFeISI=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_82c16a093803",
      "text": "祝你們旅途一帆風順。",
      "encoded_ascii": "^&v^*F^*{^2m^3.^!%^1x^)y^.D^!\"",
      "encoded_base64": "XiZ2XipGXip7XjJtXjMuXiElXjF4Xil5Xi5EXiEi",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_824fe23e5e72",
      "text": "如果需要我，我就在這裡。",
      "encoded_ascii": "^#$^%!^)e^(C^$%^*A^$%^*J^\"d^(s^-j^!\"",
      "encoded_base64": "XiMkXiUhXillXihDXiQlXipBXiQlXipKXiJkXihzXi1qXiEi",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_7d4a8d1ea70a",
      "text": "  雙足飛龍欄舍在哪裡？",
      "encoded_ascii": "  ^)_^(^^)z^*>^%C^03^\"d^+I^-j^.V",
      "encoded_base64": "ICBeKV9eKF5eKXpeKj5eJUNeMDNeImReK0leLWpeLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_69405e19f57e",
      "text": "  我不再需要你的幫助了。",
      "encoded_ascii": "  ^$%^!)^!l^)e^(C^*F^&Z^+}^\"#^*D^!\"",
      "encoded_base64": "ICBeJCVeISleIWxeKWVeKENeKkZeJlpeK31eIiNeKkReISI=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_bb7a32100cea",
      "text": "我們走吧。",
      "encoded_ascii": "^$%^*{^.&^*I^!\"",
      "encoded_base64": "XiQlXip7Xi4mXipJXiEi",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_1c5d96123958",
      "text": "我要在衛兵抓到我之前離開這裡。祝你們好運。",
      "encoded_ascii": "^$%^(C^\"d^(=^+,^$2^!u^$%^!/^!z^)`^)F^(s^-j^!\"^&v^*F^*{^+i^.4^!\"",
      "encoded_base64": "XiQlXihDXiJkXig9XissXiQyXiF1XiQlXiEvXiF6XilgXilGXihzXi1qXiEiXiZ2XipGXip7XitpXi40XiEi",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_76ee1eff3484",
      "text": "你們在這裡做什麼？",
      "encoded_ascii": "^*F^*{^\"d^(s^-j^*~^!=^.T^.V",
      "encoded_base64": "XipGXip7XiJkXihzXi1qXip+XiE9Xi5UXi5W",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_61506546e02b",
      "text": "  我只是想跟你談談。",
      "encoded_ascii": "  ^$%^\"?^,X^,1^.+^*F^0;^0;^!\"",
      "encoded_base64": "ICBeJCVeIj9eLFheLDFeLiteKkZeMDteMDteISI=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_d5379cfdbf5c",
      "text": "  安靜點，不然我殺了你。",
      "encoded_ascii": "  ^+p^)h^*;^*A^!)^&\"^$%^%M^*D^*F^!\"",
      "encoded_base64": "ICBeK3BeKWheKjteKkFeISleJiJeJCVeJU1eKkReKkZeISI=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_115da2bfabe3",
      "text": "  我是來為亞薩斯除掉你們這些人渣的！",
      "encoded_ascii": "  ^$%^,X^!O^%{^!9^-e^$[^)Q^/e^*F^*{^(s^!8^!<^,v^&Z^*W",
      "encoded_base64": "ICBeJCVeLFheIU9eJXteITleLWVeJFteKVFeL2VeKkZeKnteKHNeITheITxeLHZeJlpeKlc=",
      "byte_length": 53
    },
    {
      "unit_id": "DLG_385d3c97ce52",
      "text": "我要離開了。",
      "encoded_ascii": "^$%^(C^)`^)F^*D^!\"",
      "encoded_base64": "XiQlXihDXilgXilGXipEXiEi",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_842da0f4ff81",
      "text": "好吧，但千萬別讓衛兵打開雙足飛龍欄舍的門。 ",
      "encoded_ascii": "^+i^*I^*A^!I^+7^-_^*H^-}^(=^+,^$-^)F^)_^(^^)z^*>^%C^03^&Z^)D^!\" ",
      "encoded_base64": "XitpXipJXipBXiFJXis3Xi1fXipIXi19Xig9XissXiQtXilGXilfXiheXil6Xio+XiVDXjAzXiZaXilEXiEiIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_c2716b194e6f",
      "text": "他們一定會殺了你們的。我得在衛兵發現我幫過你們之前溜走。祝你們好運！ ",
      "encoded_ascii": "^!@^*{^!%^#.^$r^%M^*D^*F^*{^&Z^!\"^$%^#e^\"d^(=^+,^&W^&?^$%^+}^(x^*F^*{^!/^!z^%r^.&^!\"^&v^*F^*{^+i^.4^*W ",
      "encoded_base64": "XiFAXip7XiElXiMuXiRyXiVNXipEXipGXip7XiZaXiEiXiQlXiNlXiJkXig9XissXiZXXiY/XiQlXit9Xih4XipGXip7XiEvXiF6XiVyXi4mXiEiXiZ2XipGXip7XitpXi40XipXIA==",
      "byte_length": 103
    },
    {
      "unit_id": "DLG_986cfacdf629",
      "text": "我幫了你們。祝好運！",
      "encoded_ascii": "^$%^+}^*D^*F^*{^!\"^&v^+i^.4^*W",
      "encoded_base64": "XiQlXit9XipEXipGXip7XiEiXiZ2XitpXi40XipX",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_385d67a3bdad",
      "text": "我就緊跟在你們身後。",
      "encoded_ascii": "^$%^*J^0r^.+^\"d^*F^*{^(c^#b^!\"",
      "encoded_base64": "XiQlXipKXjByXi4rXiJkXipGXip7XihjXiNiXiEi",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_091ea4fdd94a",
      "text": "衛兵知道你們在這裡了。他們隨時會帶著雙足飛龍殺過來。",
      "encoded_ascii": "^(=^+,^&h^(y^*F^*{^\"d^(s^-j^*D^!\"^!@^*{^)X^$f^$r^#N^-a^)_^(^^)z^*>^%M^(x^!O^!\"",
      "encoded_base64": "Xig9XissXiZoXih5XipGXip7XiJkXihzXi1qXipEXiEiXiFAXip7XilYXiRmXiRyXiNOXi1hXilfXiheXil6Xio+XiVNXih4XiFPXiEi",
      "byte_length": 78
    },
    {
      "unit_id": "DLG_a788db0d62c3",
      "text": "我想那樣應該沒問題。 ",
      "encoded_ascii": "^$%^,1^)!^,f^0`^(M^%\\^*Z^.G^!\" ",
      "encoded_base64": "XiQlXiwxXikhXixmXjBgXihNXiVcXipaXi5HXiEiIA==",
      "byte_length": 31
    },
    {
      "unit_id": "DLG_4934ec62429c",
      "text": "城堡裡有賊！救命啊！",
      "encoded_ascii": "^+_^\"m^-j^$s^0?^*W^,Q^\"N^+Q^*W",
      "encoded_base64": "XitfXiJtXi1qXiRzXjA/XipXXixRXiJOXitRXipX",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_2e28b4f928f1",
      "text": "我和其他人不一樣！我討厭殺戮！我加入強盜團只是為了能夠…… ",
      "encoded_ascii": "^$%^\"O^!j^!@^!<^!)^!%^,f^*W^$%^-o^+9^%M^,:^*W^$%^\"\"^!f^#]^0!^0V^\"?^,X^%{^*D^'b^+d^*o^*o ",
      "encoded_base64": "XiQlXiJPXiFqXiFAXiE8XiEpXiElXixmXipXXiQlXi1vXis5XiVNXiw6XipXXiQlXiIiXiFmXiNdXjAhXjBWXiI/XixYXiV7XipEXidiXitkXipvXipvIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_9d170ce33989",
      "text": "騎乘雙足飛龍。總有一天我會釋放牠們，讓我們和平生活！ ",
      "encoded_ascii": "^0K^0O^)_^(^^)z^*>^!\"^-M^$s^!%^+e^$%^$r^0w^$P^-#^*{^*A^-}^$%^*{^\"O^0Y^&F^%i^*W ",
      "encoded_base64": "XjBLXjBPXilfXiheXil6Xio+XiEiXi1NXiRzXiElXitlXiQlXiRyXjB3XiRQXi0jXip7XipBXi19XiQlXip7XiJPXjBZXiZGXiVpXipXIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_d354fc105759",
      "text": "但我打不過雙足飛龍大師，而且欄舍那裡有衛兵把守。",
      "encoded_ascii": "^!I^$%^$-^!)^(x^)_^(^^)z^*>^\"z^#M^*A^'W^!*^%C^03^)!^-j^$s^(=^+,^$1^#+^!\"",
      "encoded_base64": "XiFJXiQlXiQtXiEpXih4XilfXiheXil6Xio+XiJ6XiNNXipBXidXXiEqXiVDXjAzXikhXi1qXiRzXig9XissXiQxXiMrXiEi",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_d1a2f741222a",
      "text": "你最好快點離開。要是被雙足飛龍大師抓住…… ",
      "encoded_ascii": "^*F^$q^+i^*L^*;^)`^)F^!\"^(C^,X^(@^)_^(^^)z^*>^\"z^#M^$2^*z^*o^*o ",
      "encoded_base64": "XipGXiRxXitpXipMXio7XilgXilGXiEiXihDXixYXihAXilfXiheXil6Xio+XiJ6XiNNXiQyXip6XipvXipvIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_849d24fc5098",
      "text": "他會把你交給塔拉處置。",
      "encoded_ascii": "^!@^$r^$1^*F^0P^'A^\"o^$6^(,^'Q^!\"",
      "encoded_base64": "XiFAXiRyXiQxXipGXjBQXidBXiJvXiQ2XigsXidRXiEi",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_44a4cc751517",
      "text": "  你們的首領在哪裡？",
      "encoded_ascii": "  ^*F^*{^&Z^)~^)s^\"d^+I^-j^.V",
      "encoded_base64": "ICBeKkZeKnteJlpeKX5eKXNeImReK0leLWpeLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_fcf10659cd45",
      "text": "  跟我說說這座城堡的事。",
      "encoded_ascii": "  ^.+^$%^-x^-x^(s^/_^+_^\"m^&Z^*r^!\"",
      "encoded_base64": "ICBeLiteJCVeLXheLXheKHNeL19eK19eIm1eJlpeKnJeISI=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_f1f79b591b09",
      "text": "  你為什麼不願意去神廟？",
      "encoded_ascii": "  ^*F^%{^!=^.T^!)^.H^#z^\"6^&w^0[^.V",
      "encoded_base64": "ICBeKkZeJXteIT1eLlReISleLkheI3peIjZeJndeMFteLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_6476a8146227",
      "text": "  你是怎麼控制那些猛獸的？",
      "encoded_ascii": "  ^*F^,X^,,^.T^$@^!v^)!^!8^*P^&<^&Z^.V",
      "encoded_base64": "ICBeKkZeLFheLCxeLlReJEBeIXZeKSFeITheKlBeJjxeJlpeLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_96504dacda21",
      "text": "  跟我說說飛龍鉤的事。",
      "encoded_ascii": "  ^.+^$%^-x^-x^)z^*>^)/^&Z^*r^!\"",
      "encoded_base64": "ICBeLiteJCVeLXheLXheKXpeKj5eKS9eJlpeKnJeISI=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_02a1c98f5486",
      "text": "  幫我個忙，我就幫你弄一隻雙足飛龍。",
      "encoded_ascii": "  ^+}^$%^!V^,+^*A^$%^*J^+}^*F^/`^!%^)[^)_^(^^)z^*>^!\"",
      "encoded_base64": "ICBeK31eJCVeIVZeLCteKkFeJCVeKkpeK31eKkZeL2BeISVeKVteKV9eKF5eKXpeKj5eISI=",
      "byte_length": 53
    },
    {
      "unit_id": "DLG_676922186fbf",
      "text": "  回去幹活，並且忘掉我來過這裡。",
      "encoded_ascii": "  ^\"\\^\"6^,!^%i^*A^!+^!*^0]^/e^$%^!O^(x^(s^-j^!\"",
      "encoded_base64": "ICBeIlxeIjZeLCFeJWleKkFeISteISpeMF1eL2VeJCVeIU9eKHheKHNeLWpeISI=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_b1843540e19b",
      "text": "我是馬廄雜工查耶羅。我是負責照料雙足飛龍的人。 ",
      "encoded_ascii": "^$%^,X^*\"^0Z^0G^+y^%&^0.^/?^!\"^$%^,X^(W^0>^/x^/n^)_^(^^)z^*>^&Z^!<^!\" ",
      "encoded_base64": "XiQlXixYXioiXjBaXjBHXit5XiUmXjAuXi8/XiEiXiQlXixYXihXXjA+Xi94Xi9uXilfXiheXil6Xio+XiZaXiE8XiEiIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_f5c29281f6e3",
      "text": "牠們是無比壯麗的生靈。要是能擁有一隻屬於我自己的飛龍，叫我付出什麼我都願意！",
      "encoded_ascii": "^-#^*{^,X^%}^,m^+b^0z^&Z^&F^)g^!\"^(C^,X^'b^,M^$s^!%^)[^#C^$^^$%^'l^#I^&Z^)z^*>^*A^+<^$%^*u^!q^!=^.T^$%^)$^.H^#z^*W",
      "encoded_base64": "Xi0jXip7XixYXiV9XixtXitiXjB6XiZaXiZGXilnXiEiXihDXixYXidiXixNXiRzXiElXilbXiNDXiReXiQlXidsXiNJXiZaXil6Xio+XipBXis8XiQlXip1XiFxXiE9Xi5UXiQlXikkXi5IXiN6XipX",
      "byte_length": 114
    },
    {
      "unit_id": "DLG_cf760280140d",
      "text": "雙足飛龍大師的房間在城堡上層。你必須…… ",
      "encoded_ascii": "^)_^(^^)z^*>^\"z^#M^&Z^,<^)G^\"d^+_^\"m^!'^#B^!\"^*F^#l^)r^*o^*o ",
      "encoded_base64": "XilfXiheXil6Xio+XiJ6XiNNXiZaXiw8XilHXiJkXitfXiJtXiEnXiNCXiEiXipGXiNsXilyXipvXipvIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_16ee4b58f5e9",
      "text": "穿過雙足飛龍欄舍才能到達那裡。",
      "encoded_ascii": "^')^(x^)_^(^^)z^*>^%C^03^$,^'b^!u^(z^)!^-j^!\"",
      "encoded_base64": "XicpXih4XilfXiheXil6Xio+XiVDXjAzXiQsXidiXiF1Xih6XikhXi1qXiEi",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_9a6fcb7e0424",
      "text": "牠們在城堡的東北角。",
      "encoded_ascii": "^-#^*{^\"d^+_^\"m^&Z^,`^+6^(H^!\"",
      "encoded_base64": "Xi0jXip7XiJkXitfXiJtXiZaXixgXis2XihIXiEi",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_c0e6a7a8c1f3",
      "text": "雙足飛龍大師很害怕西塔。所有人都不准…… ",
      "encoded_ascii": "^)_^(^^)z^*>^\"z^#M^*K^#/^0^^-l^\"o^!\"^$)^$s^!<^)$^!)^/Q^*o^*o ",
      "encoded_base64": "XilfXiheXil6Xio+XiJ6XiNNXipLXiMvXjBeXi1sXiJvXiEiXiQpXiRzXiE8XikkXiEpXi9RXipvXipvIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_e66dd7848d2b",
      "text": "去那裡。那裡還有黑色迷宮，但去過那裡的人全都死了。 ",
      "encoded_ascii": "^\"6^)!^-j^!\"^)!^-j^.7^$s^*:^'s^(n^/\\^*A^!I^\"6^(x^)!^-j^&Z^!<^!h^)$^%L^*D^!\" ",
      "encoded_base64": "XiI2XikhXi1qXiEiXikhXi1qXi43XiRzXio6XidzXihuXi9cXipBXiFJXiI2Xih4XikhXi1qXiZaXiE8XiFoXikkXiVMXipEXiEiIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_c0c5f0d4eef3",
      "text": "我絕不去那裡，也不去那座令人作嘔的懸吊神廟。",
      "encoded_ascii": "^$%^-I^!)^\"6^)!^-j^*A^!1^!)^\"6^)!^/_^*w^!<^!M^0T^&Z^0a^0S^&w^0[^!\"",
      "encoded_base64": "XiQlXi1JXiEpXiI2XikhXi1qXipBXiExXiEpXiI2XikhXi9fXip3XiE8XiFNXjBUXiZaXjBhXjBTXiZ3XjBbXiEi",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_a2575336caa9",
      "text": "雙足飛龍大師把人吊在籠子裡。他們被吸乾了…… ",
      "encoded_ascii": "^)_^(^^)z^*>^\"z^#M^$1^!<^0S^\"d^'3^#(^-j^!\"^!@^*{^(@^\"J^*X^*D^*o^*o ",
      "encoded_base64": "XilfXiheXil6Xio+XiJ6XiNNXiQxXiE8XjBTXiJkXiczXiMoXi1qXiEiXiFAXip7XihAXiJKXipYXipEXipvXipvIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_8b295c3a691c",
      "text": "被給他飛龍鉤的女人吸乾了精氣。",
      "encoded_ascii": "^(@^'A^!@^)z^*>^)/^&Z^#\"^!<^\"J^*X^*D^'7^%U^!\"",
      "encoded_base64": "XihAXidBXiFAXil6Xio+XikvXiZaXiMiXiE8XiJKXipYXipEXic3XiVVXiEi",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_3739b16c8cc1",
      "text": "為了擁有一隻自己的雙足飛龍，我什麼都願意做！我會跟你們去欄舍，這…… ",
      "encoded_ascii": "^%{^*D^,M^$s^!%^)[^'l^#I^&Z^)_^(^^)z^*>^*A^$%^!=^.T^)$^.H^#z^*~^*W^$%^$r^.+^*F^*{^\"6^%C^03^*A^(s^*o^*o ",
      "encoded_base64": "XiV7XipEXixNXiRzXiElXilbXidsXiNJXiZaXilfXiheXil6Xio+XipBXiQlXiE9Xi5UXikkXi5IXiN6Xip+XipXXiQlXiRyXi4rXipGXip7XiI2XiVDXjAzXipBXihzXipvXipvIA==",
      "byte_length": 103
    },
    {
      "unit_id": "DLG_2b0e287117b0",
      "text": "應該能安撫衛兵的疑心，讓你們有足夠時間在他們放出雙足飛龍前展開突襲。 ",
      "encoded_ascii": "^0`^(M^'b^+p^0d^(=^+,^&Z^0p^#k^*A^-}^*F^*{^$s^(^^+d^$f^)G^\"d^!@^*{^$P^!q^)_^(^^)z^*>^!z^+x^)F^'*^08^!\" ",
      "encoded_base64": "XjBgXihNXidiXitwXjBkXig9XissXiZaXjBwXiNrXipBXi19XipGXip7XiRzXiheXitkXiRmXilHXiJkXiFAXip7XiRQXiFxXilfXiheXil6Xio+XiF6Xit4XilGXicqXjA4XiEiIA==",
      "byte_length": 103
    },
    {
      "unit_id": "DLG_379fa71ce7f5",
      "text": "釋放雙足飛龍。這樣行嗎？",
      "encoded_ascii": "^0w^$P^)_^(^^)z^*>^!\"^(s^,f^(;^+X^.V",
      "encoded_base64": "XjB3XiRQXilfXiheXil6Xio+XiEiXihzXixmXig7XitYXi5W",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_38a2cd86c47e",
      "text": "太棒了！ ",
      "encoded_ascii": "^+f^%1^*D^*W ",
      "encoded_base64": "XitmXiUxXipEXipXIA==",
      "byte_length": 13
    },
    {
      "unit_id": "DLG_a9ba2c6007e5",
      "text": "噢，好吧。 ",
      "encoded_ascii": "^+]^*A^+i^*I^!\" ",
      "encoded_base64": "XitdXipBXitpXipJXiEiIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_43fd4f4b7548",
      "text": "比起人類，我更喜歡雙足飛龍，而飛龍也知道…… ",
      "encoded_ascii": "^,m^.(^!<^)w^*A^$%^$o^+V^%F^)_^(^^)z^*>^*A^'W^)z^*>^!1^&h^(y^*o^*o ",
      "encoded_base64": "XixtXi4oXiE8Xil3XipBXiQlXiRvXitWXiVGXilfXiheXil6Xio+XipBXidXXil6Xio+XiExXiZoXih5XipvXipvIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_9cf9e656724f",
      "text": "這一點。為了騎乘牠們，我做什麼都行，哪怕伺候雙足飛龍大師也無所謂。 ",
      "encoded_ascii": "^(s^!%^*;^!\"^%{^*D^0K^0O^-#^*{^*A^$%^*~^!=^.T^)$^(;^*A^+I^0^^0Q^*|^)_^(^^)z^*>^\"z^#M^!1^%}^$)^0s^!\" ",
      "encoded_base64": "XihzXiElXio7XiEiXiV7XipEXjBLXjBPXi0jXip7XipBXiQlXip+XiE9Xi5UXikkXig7XipBXitJXjBeXjBRXip8XilfXiheXil6Xio+XiJ6XiNNXiExXiV9XiQpXjBzXiEiIA==",
      "byte_length": 100
    },
    {
      "unit_id": "DLG_f41b6ab6fe39",
      "text": "他不像我那樣理解雙足飛龍，必須完全依賴…… ",
      "encoded_ascii": "^!@^!)^!`^$%^)!^,f^&A^(I^)_^(^^)z^*>^*A^#l^)r^#,^!h^!Q^0t^*o^*o ",
      "encoded_base64": "XiFAXiEpXiFgXiQlXikhXixmXiZBXihJXilfXiheXil6Xio+XipBXiNsXilyXiMsXiFoXiFRXjB0XipvXipvIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_e9253d78da41",
      "text": "飛龍鉤來控制牠們。",
      "encoded_ascii": "^)z^*>^)/^!O^$@^!v^-#^*{^!\"",
      "encoded_base64": "Xil6Xio+XikvXiFPXiRAXiF2Xi0jXip7XiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_047b38278b79",
      "text": "雙足飛龍只服從攜帶騎鉤的人。雙足飛龍大師是從…… ",
      "encoded_ascii": "^)_^(^^)z^*>^\"?^,\\^#f^0e^#N^0K^)/^&Z^!<^!\"^)_^(^^)z^*>^\"z^#M^,X^#f^*o^*o ",
      "encoded_base64": "XilfXiheXil6Xio+XiI/XixcXiNmXjBlXiNOXjBLXikvXiZaXiE8XiEiXilfXiheXil6Xio+XiJ6XiNNXixYXiNmXipvXipvIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_8edc441cdff5",
      "text": "從東塔的女人塔拉那裡得來的。",
      "encoded_ascii": "^#f^,`^\"o^&Z^#\"^!<^\"o^$6^)!^-j^#e^!O^&Z^!\"",
      "encoded_base64": "XiNmXixgXiJvXiZaXiMiXiE8XiJvXiQ2XikhXi1qXiNlXiFPXiZaXiEi",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_752d96447a5b",
      "text": "我們應該在衛兵發現之前趕到雙足飛龍欄舍。",
      "encoded_ascii": "^$%^*{^0`^(M^\"d^(=^+,^&W^&?^!/^!z^0u^!u^)_^(^^)z^*>^%C^03^!\"",
      "encoded_base64": "XiQlXip7XjBgXihNXiJkXig9XissXiZXXiY/XiEvXiF6XjB1XiF1XilfXiheXil6Xio+XiVDXjAzXiEi",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_d2834924ae1e",
      "text": "拿下那些強盜！ ",
      "encoded_ascii": "^,G^!(^)!^!8^#]^0!^*W ",
      "encoded_base64": "XixHXiEoXikhXiE4XiNdXjAhXipXIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_7eebd0a5b421",
      "text": "呀啊啊啊！ ",
      "encoded_ascii": "^3h^+Q^+Q^+Q^*W ",
      "encoded_base64": "XjNoXitRXitRXitRXipXIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_3d506ee4cfea",
      "text": "這座綠洲屬於城邦。嚴禁擅入！立刻離開，否則我們就 ",
      "encoded_ascii": "^(s^/_^3V^76^#C^$^^+_^1a^!\"^1*^&y^2$^!f^*W^0'^.Y^)`^)F^*A^\"H^!x^$%^*{^*J ",
      "encoded_base64": "XihzXi9fXjNWXjc2XiNDXiReXitfXjFhXiEiXjEqXiZ5XjIkXiFmXipXXjAnXi5ZXilgXilGXipBXiJIXiF4XiQlXip7XipKIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_a43f09703d3a",
      "text": "用武力把你們轟出去。",
      "encoded_ascii": "^&H^%J^!~^$1^*F^*{^.y^!q^\"6^!\"",
      "encoded_base64": "XiZIXiVKXiF+XiQxXipGXip7Xi55XiFxXiI2XiEi",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_d046b6a2b5b0",
      "text": "幾隻巴布魔正圍在法陣四周，嘲弄著裡面的瑪格拉人。 ",
      "encoded_ascii": "^#T^)[^#K^.`^*0^%H^\"`^\"d^%b^)P^\"[^\"L^*A^+Z^/`^-a^-j^)j^&Z^-*^%*^$6^!<^!\" ",
      "encoded_base64": "XiNUXilbXiNLXi5gXiowXiVIXiJgXiJkXiViXilQXiJbXiJMXipBXitaXi9gXi1hXi1qXilqXiZaXi0qXiUqXiQ2XiE8XiEiIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_2431b3ba5814",
      "text": "蠢貨！你真以為自己會被轉化為 ",
      "encoded_ascii": "^.u^.w^*W^*F^-2^!B^%{^'l^#I^$r^(@^(i^\")^%{ ",
      "encoded_base64": "Xi51Xi53XipXXipGXi0yXiFCXiV7XidsXiNJXiRyXihAXihpXiIpXiV7IA==",
      "byte_length": 43
    },
    {
      "unit_id": "DLG_ae6de926a5e7",
      "text": "另一種更高等的存在嗎？你們這種種族妄圖昇華自我的慾望，蒙蔽了你們對真相的 ",
      "encoded_ascii": "^\">^!%^'$^$o^*+^'-^&Z^#*^\"d^+X^.V^*F^*{^(s^'$^'$^5V^+j^\"b^<}^3'^'l^$%^&Z^=T^,]^*A^-c^('^*D^*F^*{^#:^-2^&a^&Z ",
      "encoded_base64": "XiI+XiElXickXiRvXiorXictXiZaXiMqXiJkXitYXi5WXipGXip7XihzXickXickXjVWXitqXiJiXjx9XjMnXidsXiQlXiZaXj1UXixdXipBXi1jXignXipEXipGXip7XiM6Xi0yXiZhXiZaIA==",
      "byte_length": 109
    },
    {
      "unit_id": "DLG_4428644119f7",
      "text": "雙眼！你難道從沒問過自己，為什麼從來沒見過任何『被轉化』的人回來嗎？",
      "encoded_ascii": "^)_^&d^*W^*F^)a^(y^#f^%\\^*Z^(x^'l^#I^*A^%{^!=^.T^#f^!O^%\\^-m^(x^!C^!L^<_^(@^(i^\")^<`^&Z^!<^\"\\^!O^+X^.V",
      "encoded_base64": "XilfXiZkXipXXipGXilhXih5XiNmXiVcXipaXih4XidsXiNJXipBXiV7XiE9Xi5UXiNmXiFPXiVcXi1tXih4XiFDXiFMXjxfXihAXihpXiIpXjxgXiZaXiE8XiJcXiFPXitYXi5W",
      "byte_length": 102
    },
    {
      "unit_id": "DLG_38e3c39639b1",
      "text": "巴布魔尚未注意到你們……",
      "encoded_ascii": "^#K^.`^*0^+v^,_^%e^#z^!u^*F^*{^*o^*o",
      "encoded_base64": "XiNLXi5gXiowXit2XixfXiVlXiN6XiF1XipGXip7XipvXipv",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_979dac368383",
      "text": "馬格拉瑪",
      "encoded_ascii": "^*\"^%*^$6^-*",
      "encoded_base64": "XioiXiUqXiQ2Xi0q",
      "byte_length": 12
    },
    {
      "unit_id": "DLG_0c3263fc6674",
      "text": "  靜觀其變，看看會發生什麼事。",
      "encoded_ascii": "  ^)h^*R^!j^(U^*A^*Q^*Q^$r^&W^&F^!=^.T^*r^!\"",
      "encoded_base64": "ICBeKWheKlJeIWpeKFVeKkFeKlFeKlFeJHJeJldeJkZeIT1eLlReKnJeISI=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_8c11ab3813a8",
      "text": "  發動攻擊！",
      "encoded_ascii": "  ^&W^\"%^$O^$F^*W",
      "encoded_base64": "ICBeJldeIiVeJE9eJEZeKlc=",
      "byte_length": 17
    },
    {
      "unit_id": "DLG_75a1886a7209",
      "text": "離開。 ",
      "encoded_ascii": "^)`^)F^!\" ",
      "encoded_base64": "XilgXilGXiEiIA==",
      "byte_length": 10
    },
    {
      "unit_id": "DLG_2e40c5ae7e92",
      "text": "巴布魔繼續無情地嘲弄著瑪格拉人。",
      "encoded_ascii": "^#K^.`^*0^-O^'M^%}^,0^\"e^+Z^/`^-a^-*^%*^$6^!<^!\"",
      "encoded_base64": "XiNLXi5gXiowXi1PXidNXiV9XiwwXiJlXitaXi9gXi1hXi0qXiUqXiQ2XiE8XiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_609e18e787e5",
      "text": "你知道為什麼你從沒見過任何人『被轉化』嗎？因為他們全都死了！ ",
      "encoded_ascii": "^*F^&h^(y^%{^!=^.T^*F^#f^%\\^-m^(x^!C^!L^!<^<_^(@^(i^\")^<`^+X^.V^\"]^%{^!@^*{^!h^)$^%L^*D^*W ",
      "encoded_base64": "XipGXiZoXih5XiV7XiE9Xi5UXipGXiNmXiVcXi1tXih4XiFDXiFMXiE8XjxfXihAXihpXiIpXjxgXitYXi5WXiJdXiV7XiFAXip7XiFoXikkXiVMXipEXipXIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_c4b6eb528714",
      "text": "巴爾卡札是要宰了你，好召喚一隻新的巴布魔！你的盲目信仰 ",
      "encoded_ascii": "^#K^&/^\"0^.k^,X^(C^1w^*D^*F^*A^+i^\"@^\"U^!%^)[^$\\^&Z^#K^.`^*0^*W^*F^&Z^&_^&^^!U^4, ",
      "encoded_base64": "XiNLXiYvXiIwXi5rXixYXihDXjF3XipEXipGXipBXitpXiJAXiJVXiElXilbXiRcXiZaXiNLXi5gXiowXipXXipGXiZaXiZfXiZeXiFVXjQsIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_02ab9d7537a5",
      "text": "將你一步步引向了死亡！",
      "encoded_ascii": "^#7^*F^!%^,i^,i^#Z^+?^*D^%L^!:^*W",
      "encoded_base64": "XiM3XipGXiElXixpXixpXiNaXis/XipEXiVMXiE6XipX",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_bf5039596509",
      "text": "巴布魔逼近了瑪格拉人……",
      "encoded_ascii": "^#K^.`^*0^.1^(l^*D^-*^%*^$6^!<^*o^*o",
      "encoded_base64": "XiNLXi5gXiowXi4xXihsXipEXi0qXiUqXiQ2XiE8XipvXipv",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_00cab69fe632",
      "text": "  等等。",
      "encoded_ascii": "  ^'-^'-^!\"",
      "encoded_base64": "ICBeJy1eJy1eISI=",
      "byte_length": 11
    },
    {
      "unit_id": "DLG_b0d249ea4766",
      "text": "離開。",
      "encoded_ascii": "^)`^)F^!\"",
      "encoded_base64": "XilgXilGXiEi",
      "byte_length": 9
    },
    {
      "unit_id": "DLG_c66e27b3b5c3",
      "text": "不！你們休想破壞我獲得轉化的機會！ ",
      "encoded_ascii": "^!)^*W^*F^*{^!G^,1^&n^\"v^$%^&:^#e^(i^\")^&Z^%>^$r^*W ",
      "encoded_base64": "XiEpXipXXipGXip7XiFHXiwxXiZuXiJ2XiQlXiY6XiNlXihpXiIpXiZaXiU+XiRyXipXIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_5b94982880af",
      "text": "我的一生就是一場騙局！根本沒有什麼轉化，也沒有更高等的 ",
      "encoded_ascii": "^$%^&Z^!%^&F^*J^,X^!%^\"n^.{^._^*W^%)^$x^%\\^$s^!=^.T^(i^\")^*A^!1^%\\^$s^$o^*+^'-^&Z ",
      "encoded_base64": "XiQlXiZaXiElXiZGXipKXixYXiElXiJuXi57Xi5fXipXXiUpXiR4XiVcXiRzXiE9Xi5UXihpXiIpXipBXiExXiVcXiRzXiRvXiorXictXiZaIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_4d826b8297a4",
      "text": "境界可以達成。我的一生毫無意義！",
      "encoded_ascii": "^\"q^.p^\"A^!B^(z^$$^!\"^$%^&Z^!%^&F^/t^%}^#z^2<^*W",
      "encoded_base64": "XiJxXi5wXiJBXiFCXih6XiQkXiEiXiQlXiZaXiElXiZGXi90XiV9XiN6XjI8XipX",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_a529adaa0e19",
      "text": "我現在該何去何從？",
      "encoded_ascii": "^$%^&?^\"d^(M^!L^\"6^!L^#f^.V",
      "encoded_base64": "XiQlXiY/XiJkXihNXiFMXiI2XiFMXiNmXi5W",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_dc97649b7378",
      "text": "你們需要我的幫助嗎？",
      "encoded_ascii": "^*F^*{^)e^(C^$%^&Z^+}^\"#^+X^.V",
      "encoded_base64": "XipGXip7XillXihDXiQlXiZaXit9XiIjXitYXi5W",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_0b4174efdf5a",
      "text": "  巴爾卡札已經死了。我殺了他。 ",
      "encoded_ascii": "  ^#K^&/^\"0^.k^#J^'D^%L^*D^!\"^$%^%M^*D^!@^!\" ",
      "encoded_base64": "ICBeI0teJi9eIjBeLmteI0peJ0ReJUxeKkReISJeJCVeJU1eKkReIUBeISIg",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_6df98746b4ec",
      "text": "  你能幫我找到巴爾卡札嗎？",
      "encoded_ascii": "  ^*F^'b^+}^$%^$/^!u^#K^&/^\"0^.k^+X^.V",
      "encoded_base64": "ICBeKkZeJ2JeK31eJCVeJC9eIXVeI0teJi9eIjBeLmteK1heLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_2ce51bf94901",
      "text": "  向巴爾卡札討回血債！",
      "encoded_ascii": "  ^+?^#K^&/^\"0^.k^-o^\"\\^(:^<d^*W",
      "encoded_base64": "ICBeKz9eI0teJi9eIjBeLmteLW9eIlxeKDpePGReKlc=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_9aa690edad5e",
      "text": "  我該如何擊敗巴爾卡札？",
      "encoded_ascii": "  ^$%^(M^#$^!L^$F^$R^#K^&/^\"0^.k^.V",
      "encoded_base64": "ICBeJCVeKE1eIyReIUxeJEZeJFJeI0teJi9eIjBeLmteLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_9689418647b1",
      "text": "喔！謝謝你們消滅了他！現在我們可以著手重建神廟與 ",
      "encoded_ascii": "^+T^*W^-z^-z^*F^*{^%k^%t^*D^!@^*W^&?^\"d^$%^*{^\"A^!B^-a^$+^))^,'^&w^0[^'p ",
      "encoded_base64": "XitUXipXXi16Xi16XipGXip7XiVrXiV0XipEXiFAXipXXiY/XiJkXiQlXip7XiJBXiFCXi1hXiQrXikpXiwnXiZ3XjBbXidwIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_5c39ef8ce16f",
      "text": "那間巨大的密室吧。 ",
      "encoded_ascii": "^)!^)G^#H^\"z^&Z^#0^+r^*I^!\" ",
      "encoded_base64": "XikhXilHXiNIXiJ6XiZaXiMwXityXipJXiEiIA==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_f7d698598bcc",
      "text": "我服侍了巴爾卡札好多年，結果全是一場空！我知道他的 ",
      "encoded_ascii": "^$%^,\\^0}^*D^#K^&/^\"0^.k^+i^\"x^+~^*A^'@^%!^!h^,X^!%^\"n^'(^*W^$%^&h^(y^!@^&Z ",
      "encoded_base64": "XiQlXixcXjB9XipEXiNLXiYvXiIwXi5rXitpXiJ4Xit+XipBXidAXiUhXiFoXixYXiElXiJuXicoXipXXiQlXiZoXih5XiFAXiZaIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_84e6ddb0ec07",
      "text": "起居室在哪裡。跟我來。",
      "encoded_ascii": "^.(^+w^+r^\"d^+I^-j^!\"^.+^$%^!O^!\"",
      "encoded_base64": "Xi4oXit3XityXiJkXitJXi1qXiEiXi4rXiQlXiFPXiEi",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_f51e2c16b107",
      "text": "我無法與巴爾卡札正面對抗。他會利用我的憤怒反過來對付我。",
      "encoded_ascii": "^$%^%}^%b^'p^#K^&/^\"0^.k^%H^)j^#:^$4^!\"^!@^$r^!t^&H^$%^&Z^7Y^#o^\"9^(x^!O^#:^*u^$%^!\"",
      "encoded_base64": "XiQlXiV9XiViXidwXiNLXiYvXiIwXi5rXiVIXilqXiM6XiQ0XiEiXiFAXiRyXiF0XiZIXiQlXiZaXjdZXiNvXiI5Xih4XiFPXiM6Xip1XiQlXiEi",
      "byte_length": 84
    },
    {
      "unit_id": "DLG_88f0116c8fd7",
      "text": "有些奴隸聽說巴爾卡札的力量源自於某個法器焦點，但 ",
      "encoded_ascii": "^$s^!8^##^)Z^-X^-x^#K^&/^\"0^.k^&Z^!~^)*^%q^'l^$^^%$^!V^%b^\"V^%~^*;^*A^!I ",
      "encoded_base64": "XiRzXiE4XiMjXilaXi1YXi14XiNLXiYvXiIwXi5rXiZaXiF+XikqXiVxXidsXiReXiUkXiFWXiViXiJWXiV+Xio7XipBXiFJIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_7791678a9838",
      "text": "我不知道那法器到底是什麼。 ",
      "encoded_ascii": "^$%^!)^&h^(y^)!^%b^\"V^!u^/^^,X^!=^.T^!\" ",
      "encoded_base64": "XiQlXiEpXiZoXih5XikhXiViXiJWXiF1Xi9eXixYXiE9Xi5UXiEiIA==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_b32c7ca10baf",
      "text": "我也只聽過關於法器的傳聞。我不知道消滅巴爾卡札的 ",
      "encoded_ascii": "^$%^!1^\"?^-X^(x^.>^$^^%b^\"V^&Z^+$^4^^!\"^$%^!)^&h^(y^%k^%t^#K^&/^\"0^.k^&Z ",
      "encoded_base64": "XiQlXiExXiI/Xi1YXih4Xi4+XiReXiViXiJWXiZaXiskXjReXiEiXiQlXiEpXiZoXih5XiVrXiV0XiNLXiYvXiIwXi5rXiZaIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_6f5233eba664",
      "text": "確切方法。 ",
      "encoded_ascii": "^-6^+.^$]^%b^!\" ",
      "encoded_base64": "Xi02XisuXiRdXiViXiEiIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_df294ed6000a",
      "text": "如果我們傻站在這裡閒聊，巴布魔就會找上門來。雖然我也不在乎了， ",
      "encoded_ascii": "^#$^%!^$%^*{^7$^->^\"d^(s^-j^6A^-U^*A^#K^.`^*0^*J^$r^$/^!'^)D^!O^!\"^.A^&\"^$%^!1^!)^\"d^!0^*D^*A ",
      "encoded_base64": "XiMkXiUhXiQlXip7XjckXi0+XiJkXihzXi1qXjZBXi1VXipBXiNLXi5gXiowXipKXiRyXiQvXiEnXilEXiFPXiEiXi5BXiYiXiQlXiExXiEpXiJkXiEwXipEXipBIA==",
      "byte_length": 94
    },
    {
      "unit_id": "DLG_fc857e9ae0b4",
      "text": "反正我活著也沒什麼指望。 ",
      "encoded_ascii": "^\"9^%H^$%^%i^-a^!1^%\\^!=^.T^$8^,]^!\" ",
      "encoded_base64": "XiI5XiVIXiQlXiVpXi1hXiExXiVcXiE9Xi5UXiQ4XixdXiEiIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_0179574d68f2",
      "text": "怎麼了？有什麼事？",
      "encoded_ascii": "^,,^.T^*D^.V^$s^!=^.T^*r^.V",
      "encoded_base64": "XiwsXi5UXipEXi5WXiRzXiE9Xi5UXipyXi5W",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_2292db1b6262",
      "text": "  你要去哪裡？",
      "encoded_ascii": "  ^*F^(C^\"6^+I^-j^.V",
      "encoded_base64": "ICBeKkZeKENeIjZeK0leLWpeLlY=",
      "byte_length": 20
    },
    {
      "unit_id": "DLG_9cfb747d0ab5",
      "text": "沒事。繼續走。",
      "encoded_ascii": "^%\\^*r^!\"^-O^'M^.&^!\"",
      "encoded_base64": "XiVcXipyXiEiXi1PXidNXi4mXiEi",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_0a47210c643f",
      "text": "我正帶你們去巴爾卡札的起居室。",
      "encoded_ascii": "^$%^%H^#N^*F^*{^\"6^#K^&/^\"0^.k^&Z^.(^+w^+r^!\"",
      "encoded_base64": "XiQlXiVIXiNOXipGXip7XiI2XiNLXiYvXiIwXi5rXiZaXi4oXit3XityXiEi",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_ab1a16033a9d",
      "text": "好，我們走。",
      "encoded_ascii": "^+i^*A^$%^*{^.&^!\"",
      "encoded_base64": "XitpXipBXiQlXip7Xi4mXiEi",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_dd95294f1b2b",
      "text": "快往前走！你們現在是奴隸，可不是觀光客。",
      "encoded_ascii": "^*L^,)^!z^.&^*W^*F^*{^&?^\"d^,X^##^)Z^*A^\"A^!)^,X^*R^!c^+q^!\"",
      "encoded_base64": "XipMXiwpXiF6Xi4mXipXXipGXip7XiY/XiJkXixYXiMjXilaXipBXiJBXiEpXixYXipSXiFjXitxXiEi",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_3de1aab2c35a",
      "text": "瞧瞧這是誰來了？終於有點樂子了！",
      "encoded_ascii": "^-4^-4^(s^,X^-y^!O^*D^.V^-H^$^^$s^*;^%8^#(^*D^*W",
      "encoded_base64": "Xi00Xi00XihzXixYXi15XiFPXipEXi5WXi1IXiReXiRzXio7XiU4XiMoXipEXipX",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_731da99fffc0",
      "text": "  你這話是什麼意思？",
      "encoded_ascii": "  ^*F^(s^-v^,X^!=^.T^#z^#q^.V",
      "encoded_base64": "ICBeKkZeKHNeLXZeLFheIT1eLlReI3peI3FeLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_594c1ad8d62a",
      "text": "  放我過去！",
      "encoded_ascii": "  ^$P^$%^(x^\"6^*W",
      "encoded_base64": "ICBeJFBeJCVeKHheIjZeKlc=",
      "byte_length": 17
    },
    {
      "unit_id": "DLG_e10473bc467a",
      "text": "  讓我過去！",
      "encoded_ascii": "  ^-}^$%^(x^\"6^*W",
      "encoded_base64": "ICBeLX1eJCVeKHheIjZeKlc=",
      "byte_length": 17
    },
    {
      "unit_id": "DLG_ffe2db4817ca",
      "text": "  你放我過去，我絕不會告訴任何人。",
      "encoded_ascii": "  ^*F^$P^$%^(x^\"6^*A^$%^-I^!)^$r^+B^-t^!C^!L^!<^!\"",
      "encoded_base64": "ICBeKkZeJFBeJCVeKHheIjZeKkFeJCVeLUleISleJHJeK0JeLXReIUNeIUxeITxeISI=",
      "byte_length": 50
    },
    {
      "unit_id": "DLG_a0ce73431c18",
      "text": "  我奉命向巴爾卡札呈報！",
      "encoded_ascii": "  ^$%^1+^\"N^+?^#K^&/^\"0^.k^<8^+`^*W",
      "encoded_base64": "ICBeJCVeMSteIk5eKz9eI0teJi9eIjBeLmtePDheK2BeKlc=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_1837fee293e3",
      "text": "  我能以奴隸的身分進去嗎？",
      "encoded_ascii": "  ^$%^'b^!B^##^)Z^&Z^(c^!s^(w^\"6^+X^.V",
      "encoded_base64": "ICBeJCVeJ2JeIUJeIyNeKVpeJlpeKGNeIXNeKHdeIjZeK1heLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_c1d0ba5cb63d",
      "text": "  拔劍吧，骯髒的孽種！",
      "encoded_ascii": "  ^/c^!|^*I^*A^0L^0M^&Z^5I^'$^*W",
      "encoded_base64": "ICBeL2NeIXxeKkleKkFeMExeME1eJlpeNUleJyReKlc=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_a4b7684f1b28",
      "text": "  要怎樣你才肯放我進去？",
      "encoded_ascii": "  ^(C^,,^,f^*F^$,^-Z^$P^$%^(w^\"6^.V",
      "encoded_base64": "ICBeKENeLCxeLGZeKkZeJCxeLVpeJFBeJCVeKHdeIjZeLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_3d354be08148",
      "text": "  放我進去，否則你死定了！",
      "encoded_ascii": "  ^$P^$%^(w^\"6^*A^\"H^!x^*F^%L^#.^*D^*W",
      "encoded_base64": "ICBeJFBeJCVeKHdeIjZeKkFeIkheIXheKkZeJUxeIy5eKkReKlc=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_4ae3b27d9ef7",
      "text": "  我投降！饒了我吧！",
      "encoded_ascii": "  ^$%^$3^)N^*W^.M^*D^$%^*I^*W",
      "encoded_base64": "ICBeJCVeJDNeKU5eKldeLk1eKkReJCVeKkleKlc=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_52daf48ac76c",
      "text": "沒幾個人蠢到膽敢試圖闖進這裡。",
      "encoded_ascii": "^%\\^#T^!V^!<^.u^!u^-[^/m^-u^\"b^.z^(w^(s^-j^!\"",
      "encoded_base64": "XiVcXiNUXiFWXiE8Xi51XiF1Xi1bXi9tXi11XiJiXi56Xih3XihzXi1qXiEi",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_d6c7f92d132d",
      "text": "你哪裡也別想去，更別想從我面前穿過去！ ",
      "encoded_ascii": "^*F^+I^-j^!1^*H^,1^\"6^*A^$o^*H^,1^#f^$%^)j^!z^')^(x^\"6^*W ",
      "encoded_base64": "XipGXitJXi1qXiExXipIXiwxXiI2XipBXiRvXipIXiwxXiNmXiQlXilqXiF6XicpXih4XiI2XipXIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_6b4585c1d41b",
      "text": "別急。既然來了，你們就得留下來——不是當奴隸，就是當屍體。",
      "encoded_ascii": "^*H^3p^!\"^,U^&\"^!O^*D^*A^*F^*{^*J^#e^-+^!(^!O^*n^*n^!)^,X^&N^##^)Z^*A^*J^,X^&N^#?^**^!\"",
      "encoded_base64": "XipIXjNwXiEiXixVXiYiXiFPXipEXipBXipGXip7XipKXiNlXi0rXiEoXiFPXipuXipuXiEpXixYXiZOXiMjXilaXipBXipKXixYXiZOXiM/XioqXiEi",
      "byte_length": 87
    },
    {
      "unit_id": "DLG_0dc3d7c4b5c9",
      "text": "想得美。只有奴隸才能從這裡通過。",
      "encoded_ascii": "^,1^#e^-P^!\"^\"?^$s^##^)Z^$,^'b^#f^(s^-j^(t^(x^!\"",
      "encoded_base64": "XiwxXiNlXi1QXiEiXiI/XiRzXiMjXilaXiQsXidiXiNmXihzXi1qXih0Xih4XiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_6ac9abf1e3d9",
      "text": "拙劣的謊言。巴爾卡札何時有訪客，我們一清二楚。",
      "encoded_ascii": "^4z^+2^&Z^3*^1Y^!\"^#K^&/^\"0^.k^!L^$f^$s^4d^+q^*A^$%^*{^!%^,u^!5^,c^!\"",
      "encoded_base64": "XjR6XisyXiZaXjMqXjFZXiEiXiNLXiYvXiIwXi5rXiFMXiRmXiRzXjRkXitxXipBXiQlXip7XiElXix1XiE1XixjXiEi",
      "byte_length": 69
    },
    {
      "unit_id": "DLG_c3242308ea00",
      "text": "怎麼，想當奴隸？那你們得扔下所有物品向我 ",
      "encoded_ascii": "^,,^.T^*A^,1^&N^##^)Z^.V^)!^*F^*{^#e^8{^!(^$)^$s^&4^\"R^+?^$% ",
      "encoded_base64": "XiwsXi5UXipBXiwxXiZOXiMjXilaXi5WXikhXipGXip7XiNlXjh7XiEoXiQpXiRzXiY0XiJSXis/XiQlIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_c667e0a7a5fc",
      "text": "投降。你們看起來賊眉鼠眼的……乾脆直接宰了你們還省事點。",
      "encoded_ascii": "^$3^)N^!\"^*F^*{^*Q^.(^!O^0?^3S^*=^&d^&Z^*o^*o^*X^2?^&`^$?^1w^*D^*F^*{^.7^9%^*r^*;^!\"",
      "encoded_base64": "XiQzXilOXiEiXipGXip7XipRXi4oXiFPXjA/XjNTXio9XiZkXiZaXipvXipvXipYXjI/XiZgXiQ/XjF3XipEXipGXip7Xi43XjklXipyXio7XiEi",
      "byte_length": 84
    },
    {
      "unit_id": "DLG_63ce5a153356",
      "text": "看來！你們寧死也不願為奴！既然如此！ ",
      "encoded_ascii": "^*Q^!O^*W^*F^*{^3k^%L^!1^!)^.H^%{^##^*W^,U^&\"^#$^%I^*W ",
      "encoded_base64": "XipRXiFPXipXXipGXip7XjNrXiVMXiExXiEpXi5IXiV7XiMjXipXXixVXiYiXiMkXiVJXipXIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_5a6bd6f24ff2",
      "text": "少在那裡廢話連篇。準備受死吧！",
      "encoded_ascii": "^#<^\"d^)!^-j^#W^-v^.0^;m^!\"^,x^+\"^\";^%L^*I^*W",
      "encoded_base64": "XiM8XiJkXikhXi1qXiNXXi12Xi4wXjttXiEiXix4XisiXiI7XiVMXipJXipX",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_8330031c15aa",
      "text": "很好，那就看看你們當奴隸表現如何。放下你們的裝備， ",
      "encoded_ascii": "^*K^+i^*A^)!^*J^*Q^*Q^*F^*{^&N^##^)Z^-i^&?^#$^!L^!\"^$P^!(^*F^*{^&Z^(A^+\"^*A ",
      "encoded_base64": "XipLXitpXipBXikhXipKXipRXipRXipGXip7XiZOXiMjXilaXi1pXiY/XiMkXiFMXiEiXiRQXiEoXipGXip7XiZaXihBXisiXipBIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_1f2665cea0f5",
      "text": "跟我到廚房去。",
      "encoded_ascii": "^.+^$%^!u^,%^,<^\"6^!\"",
      "encoded_base64": "Xi4rXiQlXiF1XiwlXiw8XiI2XiEi",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_16d53f7de25c",
      "text": "放下裝備？",
      "encoded_ascii": "^$P^!(^(A^+\"^.V",
      "encoded_base64": "XiRQXiEoXihBXisiXi5W",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_68446dab7618",
      "text": "留在這廚房裡幫忙打掃。要是你們幹得好， ",
      "encoded_ascii": "^-+^\"d^(s^,%^,<^-j^+}^,+^$-^:p^!\"^(C^,X^*F^*{^,!^#e^+i^*A ",
      "encoded_base64": "Xi0rXiJkXihzXiwlXiw8Xi1qXit9XiwrXiQtXjpwXiEiXihDXixYXipGXip7XiwhXiNlXitpXipBIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_dac63dabee48",
      "text": "說不定還能有幸獲得轉化呢！ ",
      "encoded_ascii": "^-x^!)^#.^.7^'b^$s^15^&:^#e^(i^\")^+C^*W ",
      "encoded_base64": "Xi14XiEpXiMuXi43XidiXiRzXjE1XiY6XiNlXihpXiIpXitDXipXIA==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_40d008f259c7",
      "text": " 猛力砸開了門鎖，大門隨之敞開。",
      "encoded_ascii": " ^*P^!~^0#^)F^*D^)D^)8^*A^\"z^)D^)X^!/^*d^)F^!\"",
      "encoded_base64": "IF4qUF4hfl4wI14pRl4qRF4pRF4pOF4qQV4iel4pRF4pWF4hL14qZF4pRl4hIg==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_2d5479a7840f",
      "text": " 破壞了大門，但門鎖依然緊鎖。",
      "encoded_ascii": " ^&n^\"v^*D^\"z^)D^*A^!I^)D^)8^!Q^&\"^0r^)8^!\"",
      "encoded_base64": "IF4mbl4idl4qRF4iel4pRF4qQV4hSV4pRF4pOF4hUV4mIl4wcl4pOF4hIg==",
      "byte_length": 43
    },
    {
      "unit_id": "DLG_fe13814e7ab3",
      "text": "歡迎，強大的戰士們，英勇擊敗邪惡米奎茲爾的勇者！",
      "encoded_ascii": "^%F^(k^*A^#]^\"z^&Z^$(^+a^*{^*A^'y^\"$^$F^$R^)\"^#y^'4^5B^/D^&/^&Z^\"$^'V^*W",
      "encoded_base64": "XiVGXihrXipBXiNdXiJ6XiZaXiQoXithXip7XipBXid5XiIkXiRGXiRSXikiXiN5Xic0XjVCXi9EXiYvXiZaXiIkXidWXipX",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_687b05c823f0",
      "text": "  那些狂信徒不過是一群弱者。",
      "encoded_ascii": "  ^)!^!8^&8^!U^#d^!)^(x^,X^!%^'R^#\\^'V^!\"",
      "encoded_base64": "ICBeKSFeITheJjheIVVeI2ReISleKHheLFheISVeJ1JeI1xeJ1ZeISI=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_bd68fc8af70b",
      "text": "  你為何如此親切？你想要什麼？",
      "encoded_ascii": "  ^*F^%{^!L^#$^%I^(F^+.^.V^*F^,1^(C^!=^.T^.V",
      "encoded_base64": "ICBeKkZeJXteIUxeIyReJUleKEZeKy5eLlZeKkZeLDFeKENeIT1eLlReLlY=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_d2a1e5d46bc8",
      "text": "  回頭見。",
      "encoded_ascii": "  ^\"\\^)t^-m^!\"",
      "encoded_base64": "ICBeIlxeKXReLW1eISI=",
      "byte_length": 14
    },
    {
      "unit_id": "DLG_e5736a69e2fb",
      "text": "很抱歉，如果你們是來交易的，我已經沒有任何東西可以給你們了。",
      "encoded_ascii": "^*K^,@^,h^*A^#$^%!^*F^*{^,X^!O^0P^,W^&Z^*A^$%^#J^'D^%\\^$s^!C^!L^,`^-l^\"A^!B^'A^*F^*{^*D^!\"",
      "encoded_base64": "XipLXixAXixoXipBXiMkXiUhXipGXip7XixYXiFPXjBQXixXXiZaXipBXiQlXiNKXidEXiVcXiRzXiFDXiFMXixgXi1sXiJBXiFCXidBXipGXip7XipEXiEi",
      "byte_length": 90
    },
    {
      "unit_id": "DLG_bb272ce2d013",
      "text": "孩子們非常感謝你們帶來的糧食。祝你們冒險順利。",
      "encoded_ascii": "^+m^#(^*{^)i^#O^#{^-z^*F^*{^#N^!O^&Z^5s^0J^!\"^&v^*F^*{^/P^*m^.D^!t^!\"",
      "encoded_base64": "XittXiMoXip7XilpXiNPXiN7Xi16XipGXip7XiNOXiFPXiZaXjVzXjBKXiEiXiZ2XipGXip7Xi9QXiptXi5EXiF0XiEi",
      "byte_length": 69
    },
    {
      "unit_id": "DLG_a593c8b35240",
      "text": "我的族人已經快餓瘋了。你們找到任何糧食了嗎？",
      "encoded_ascii": "^$%^&Z^5V^!<^#J^'D^*L^2R^-/^*D^!\"^*F^*{^$/^!u^!C^!L^5s^0J^*D^+X^.V",
      "encoded_base64": "XiQlXiZaXjVWXiE8XiNKXidEXipMXjJSXi0vXipEXiEiXipGXip7XiQvXiF1XiFDXiFMXjVzXjBKXipEXitYXi5W",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_6fbe94739c1b",
      "text": "  你說的是什麼糧食？",
      "encoded_ascii": "  ^*F^-x^&Z^,X^!=^.T^5s^0J^.V",
      "encoded_base64": "ICBeKkZeLXheJlpeLFheIT1eLlReNXNeMEpeLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_8164c2c61351",
      "text": "  每袋糧食我要換更多護甲。",
      "encoded_ascii": "  ^%P^(?^5s^0J^$%^(C^4@^$o^\"x^(T^&J^!\"",
      "encoded_base64": "ICBeJVBeKD9eNXNeMEpeJCVeKENeNEBeJG9eInheKFReJkpeISI=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_ebc6b7faf1e0",
      "text": "  我有糧食。也許我們可以做筆交易？",
      "encoded_ascii": "  ^$%^$s^5s^0J^!\"^!1^-s^$%^*{^\"A^!B^*~^-A^0P^,W^.V",
      "encoded_base64": "ICBeJCVeJHNeNXNeMEpeISJeITFeLXNeJCVeKnteIkFeIUJeKn5eLUFeMFBeLFdeLlY=",
      "byte_length": 50
    },
    {
      "unit_id": "DLG_6d9fadea1142",
      "text": "  我有糧食可以和你交易。",
      "encoded_ascii": "  ^$%^$s^5s^0J^\"A^!B^\"O^*F^0P^,W^!\"",
      "encoded_base64": "ICBeJCVeJHNeNXNeMEpeIkFeIUJeIk9eKkZeMFBeLFdeISI=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_ff08b6adb2ac",
      "text": "  你打算拿什麼換糧食？",
      "encoded_ascii": "  ^*F^$-^-C^,G^!=^.T^4@^5s^0J^.V",
      "encoded_base64": "ICBeKkZeJC1eLUNeLEdeIT1eLlReNEBeNXNeMEpeLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_dbb7035ea42f",
      "text": "  你從哪裡弄來這些護甲的？",
      "encoded_ascii": "  ^*F^#f^+I^-j^/`^!O^(s^!8^(T^&J^&Z^.V",
      "encoded_base64": "ICBeKkZeI2ZeK0leLWpeL2BeIU9eKHNeITheKFReJkpeJlpeLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_bf25a64d39d8",
      "text": "  我不想跟你交易。",
      "encoded_ascii": "  ^$%^!)^,1^.+^*F^0P^,W^!\"",
      "encoded_base64": "ICBeJCVeISleLDFeLiteKkZeMFBeLFdeISI=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_130ba70a2fef",
      "text": " 我現在必須回去處理職責了。再見。",
      "encoded_ascii": " ^$%^&?^\"d^#l^)r^\"\\^\"6^(,^&A^'\\^0>^*D^!\"^!l^-m^!\"",
      "encoded_base64": "IF4kJV4mP14iZF4jbF4pcl4iXF4iNl4oLF4mQV4nXF4wPl4qRF4hIl4hbF4tbV4hIg==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_5cd180630ae2",
      "text": "你們真是英勇無比。我初次見到你們時，就知道你們會替下水道剷除米奎茲爾……",
      "encoded_ascii": "^*F^*{^-2^,X^'y^\"$^%}^,m^!\"^$%^1\"^%D^-m^!u^*F^*{^$f^*A^*J^&h^(y^*F^*{^$r^2o^!(^%V^(y^2Y^)Q^'4^5B^/D^&/^*o^*o",
      "encoded_base64": "XipGXip7Xi0yXixYXid5XiIkXiV9XixtXiEiXiQlXjEiXiVEXi1tXiF1XipGXip7XiRmXipBXipKXiZoXih5XipGXip7XiRyXjJvXiEoXiVWXih5XjJZXilRXic0XjVCXi9EXiYvXipvXipv",
      "byte_length": 108
    },
    {
      "unit_id": "DLG_84ddcffb282e",
      "text": "想要什麼？什麼都不想要！我只是看見你們活著凱旋歸來，鬆了一大口氣！",
      "encoded_ascii": "^,1^(C^!=^.T^.V^!=^.T^)$^!)^,1^(C^*W^$%^\"?^,X^*Q^-m^*F^*{^%i^-a^!p^$`^%K^!O^*A^.R^*D^!%^\"z^\"<^%U^*W",
      "encoded_base64": "XiwxXihDXiE9Xi5UXi5WXiE9Xi5UXikkXiEpXiwxXihDXipXXiQlXiI/XixYXipRXi1tXipGXip7XiVpXi1hXiFwXiRgXiVLXiFPXipBXi5SXipEXiElXiJ6XiI8XiVVXipX",
      "byte_length": 99
    },
    {
      "unit_id": "DLG_a44d511f4b20",
      "text": " 請想想那些因你們的自私而挨餓的孩子吧。能不能請你們替我們找些糧食？",
      "encoded_ascii": " ^*S^,1^,1^)!^!8^\"]^*F^*{^&Z^'l^&~^'W^7\\^2R^&Z^+m^#(^*I^!\"^'b^!)^'b^*S^*F^*{^2o^$%^*{^$/^!8^5s^0J^.V",
      "encoded_base64": "IF4qU14sMV4sMV4pIV4hOF4iXV4qRl4qe14mWl4nbF4mfl4nV143XF4yUl4mWl4rbV4jKF4qSV4hIl4nYl4hKV4nYl4qU14qRl4qe14yb14kJV4qe14kL14hOF41c14wSl4uVg==",
      "byte_length": 100
    },
    {
      "unit_id": "DLG_8904cc97ec8e",
      "text": "你們真是太好心了。 ",
      "encoded_ascii": "^*F^*{^-2^,X^+f^+i^#k^*D^!\" ",
      "encoded_base64": "XipGXip7Xi0yXixYXitmXitpXiNrXipEXiEiIA==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_aa8873c46905",
      "text": "那些狂信徒曾囤積了大量糧食，全據為己有。 ",
      "encoded_ascii": "^)!^!8^&8^!U^#d^.j^8V^27^*D^\"z^)*^5s^0J^*A^!h^5T^%{^#I^$s^!\" ",
      "encoded_base64": "XikhXiE4XiY4XiFVXiNkXi5qXjhWXjI3XipEXiJ6XikqXjVzXjBKXipBXiFoXjVUXiV7XiNJXiRzXiEiIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_1e94c70a2e64",
      "text": "我敢說高層巢穴肯定也有些糧食，你們可以去偷一些過來。",
      "encoded_ascii": "^$%^/m^-x^*+^#B^#G^'&^-Z^#.^!1^$s^!8^5s^0J^*A^*F^*{^\"A^!B^\"6^/O^!%^!8^(x^!O^!\"",
      "encoded_base64": "XiQlXi9tXi14XiorXiNCXiNHXicmXi1aXiMuXiExXiRzXiE4XjVzXjBKXipBXipGXip7XiJBXiFCXiI2Xi9PXiElXiE4Xih4XiFPXiEi",
      "byte_length": 78
    },
    {
      "unit_id": "DLG_65c62d2b8096",
      "text": "你瘋了嗎？沒有人會像我這麼慷慨了。我每袋糧食給你們一件護甲， ",
      "encoded_ascii": "^*F^-/^*D^+X^.V^%\\^$s^!<^$r^!`^$%^(s^.T^70^7/^*D^!\"^$%^%P^(?^5s^0J^'A^*F^*{^!%^.W^(T^&J^*A ",
      "encoded_base64": "XipGXi0vXipEXitYXi5WXiVcXiRzXiE8XiRyXiFgXiQlXihzXi5UXjcwXjcvXipEXiEiXiQlXiVQXig/XjVzXjBKXidBXipGXip7XiElXi5XXihUXiZKXipBIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_3ca591119522",
      "text": "那是因為我走投無路了。這交易條件簡直好得不像話。",
      "encoded_ascii": "^)!^,X^\"]^%{^$%^.&^$3^%}^(a^*D^!\"^(s^0P^,W^%.^.W^3y^&`^+i^#e^!)^!`^-v^!\"",
      "encoded_base64": "XikhXixYXiJdXiV7XiQlXi4mXiQzXiV9XihhXipEXiEiXihzXjBQXixXXiUuXi5XXjN5XiZgXitpXiNlXiEpXiFgXi12XiEi",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_2489bddd4bca",
      "text": "我們從被扔進下水道的屍體上蒐集了許多件護甲。 ",
      "encoded_ascii": "^$%^*{^#f^(@^8{^(w^!(^%V^(y^&Z^#?^**^!'^3(^)]^*D^-s^\"x^.W^(T^&J^!\" ",
      "encoded_base64": "XiQlXip7XiNmXihAXjh7Xih3XiEoXiVWXih5XiZaXiM/XioqXiEnXjMoXildXipEXi1zXiJ4Xi5XXihUXiZKXiEiIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_796063d2cdde",
      "text": "我們甚至還把上面的污血清洗乾淨了！",
      "encoded_ascii": "^$%^*{^/|^'n^.7^$1^!'^)j^&Z^0h^(:^,u^0j^*X^0k^*D^*W",
      "encoded_base64": "XiQlXip7Xi98XiduXi43XiQxXiEnXilqXiZaXjBoXig6Xix1XjBqXipYXjBrXipEXipX",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_d7363511c455",
      "text": "再見……",
      "encoded_ascii": "^!l^-m^*o^*o",
      "encoded_base64": "XiFsXi1tXipvXipv",
      "byte_length": 12
    },
    {
      "unit_id": "DLG_27d3a27f9d0b",
      "text": " 只有一件微不足道的小事——如果你們找到任何袋裝糧食，我願意和你們交易。",
      "encoded_ascii": " ^\"?^$s^!%^.W^#i^!)^(^^(y^&Z^#;^*r^*n^*n^#$^%!^*F^*{^$/^!u^!C^!L^(?^(A^5s^0J^*A^$%^.H^#z^\"O^*F^*{^0P^,W^!\"",
      "encoded_base64": "IF4iP14kc14hJV4uV14jaV4hKV4oXl4oeV4mWl4jO14qcl4qbl4qbl4jJF4lIV4qRl4qe14kL14hdV4hQ14hTF4oP14oQV41c14wSl4qQV4kJV4uSF4jel4iT14qRl4qe14wUF4sV14hIg==",
      "byte_length": 106
    },
    {
      "unit_id": "DLG_b355051ffc8e",
      "text": "每袋糧食我給你們五枚陶幣。",
      "encoded_ascii": "^%P^(?^5s^0J^$%^'A^*F^*{^!6^$~^)R^+|^!\"",
      "encoded_base64": "XiVQXig/XjVzXjBKXiQlXidBXipGXip7XiE2XiR+XilSXit8XiEi",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_4f60686faa3b",
      "text": "  奸商！五枚陶幣太少了。",
      "encoded_ascii": "  ^:2^1'^*W^!6^$~^)R^+|^+f^#<^*D^!\"",
      "encoded_base64": "ICBeOjJeMSdeKldeITZeJH5eKVJeK3xeK2ZeIzxeKkReISI=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_0161025434ac",
      "text": "  我要錢，不要護甲！",
      "encoded_ascii": "  ^$%^(C^.<^*A^!)^(C^(T^&J^*W",
      "encoded_base64": "ICBeJCVeKENeLjxeKkFeISleKENeKFReJkpeKlc=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_2c0d641c4f62",
      "text": "  聽起來挺公道的。",
      "encoded_ascii": "  ^-X^.(^!O^,I^3:^(y^&Z^!\"",
      "encoded_base64": "ICBeLVheLiheIU9eLEleMzpeKHleJlpeISI=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_0877dc9f53eb",
      "text": "  讓我考慮一下。",
      "encoded_ascii": "  ^-}^$%^-R^19^!%^!(^!\"",
      "encoded_base64": "ICBeLX1eJCVeLVJeMTleISVeISheISI=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_3f7edb211feb",
      "text": "你以為我們鼠人住在下水道就沒有感情嗎？ ",
      "encoded_ascii": "^*F^!B^%{^$%^*{^*=^!<^*z^\"d^!(^%V^(y^*J^%\\^$s^#{^,0^+X^.V ",
      "encoded_base64": "XipGXiFCXiV7XiQlXip7Xio9XiE8Xip6XiJkXiEoXiVWXih5XipKXiVcXiRzXiN7XiwwXitYXi5WIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_653b4fcd3fac",
      "text": "哼，我們不需要你的憐憫！",
      "encoded_ascii": "^+K^*A^$%^*{^!)^)e^(C^*F^&Z^1}^1~^*W",
      "encoded_base64": "XitLXipBXiQlXip7XiEpXillXihDXipGXiZaXjF9XjF+XipX",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_7db2965e3324",
      "text": "我們是卑微的鼠人，一貧如洗，但我不得不答應。但願我的孩子永遠不會知道， ",
      "encoded_ascii": "^$%^*{^,X^\".^#i^&Z^*=^!<^*A^!%^;:^#$^0j^*A^!I^$%^!)^#e^!)^-B^0`^!\"^!I^.H^$%^&Z^+m^#(^%W^({^!)^$r^&h^(y^*A ",
      "encoded_base64": "XiQlXip7XixYXiIuXiNpXiZaXio9XiE8XipBXiElXjs6XiMkXjBqXipBXiFJXiQlXiEpXiNlXiEpXi1CXjBgXiEiXiFJXi5IXiQlXiZaXittXiMoXiVXXih7XiEpXiRyXiZoXih5XipBIA==",
      "byte_length": 106
    },
    {
      "unit_id": "DLG_853420c66cdb",
      "text": "你們是如何用這苛刻的交易從他們嘴裡奪走食物的。我會給你們一件護 ",
      "encoded_ascii": "^*F^*{^,X^#$^!L^&H^(s^;}^.Y^&Z^0P^,W^#f^!@^*{^+[^-j^1,^.&^0J^&4^&Z^!\"^$%^$r^'A^*F^*{^!%^.W^(T ",
      "encoded_base64": "XipGXip7XixYXiMkXiFMXiZIXihzXjt9Xi5ZXiZaXjBQXixXXiNmXiFAXip7XitbXi1qXjEsXi4mXjBKXiY0XiZaXiEiXiQlXiRyXidBXipGXip7XiElXi5XXihUIA==",
      "byte_length": 94
    },
    {
      "unit_id": "DLG_bef791070705",
      "text": "甲來換取每袋糧食。",
      "encoded_ascii": "^&J^!O^4@^\":^%P^(?^5s^0J^!\"",
      "encoded_base64": "XiZKXiFPXjRAXiI6XiVQXig/XjVzXjBKXiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_588ae4856562",
      "text": "五枚陶幣是我能負擔的極限了。你們想要這五枚陶幣，還是要護甲？",
      "encoded_ascii": "^!6^$~^)R^+|^,X^$%^'b^(W^*N^&Z^1D^)O^*D^!\"^*F^*{^,1^(C^(s^!6^$~^)R^+|^*A^.7^,X^(C^(T^&J^.V",
      "encoded_base64": "XiE2XiR+XilSXit8XixYXiQlXidiXihXXipOXiZaXjFEXilPXipEXiEiXipGXip7XiwxXihDXihzXiE2XiR+XilSXit8XipBXi43XixYXihDXihUXiZKXi5W",
      "byte_length": 90
    },
    {
      "unit_id": "DLG_2f81f1b5e0ce",
      "text": "  我要錢。",
      "encoded_ascii": "  ^$%^(C^.<^!\"",
      "encoded_base64": "ICBeJCVeKENeLjxeISI=",
      "byte_length": 14
    },
    {
      "unit_id": "DLG_abf7785c25ff",
      "text": "  我要護甲。",
      "encoded_ascii": "  ^$%^(C^(T^&J^!\"",
      "encoded_base64": "ICBeJCVeKENeKFReJkpeISI=",
      "byte_length": 17
    },
    {
      "unit_id": "DLG_bed3b68d2a9d",
      "text": "  我兩個都不想要。",
      "encoded_ascii": "  ^$%^!i^!V^)$^!)^,1^(C^!\"",
      "encoded_base64": "ICBeJCVeIWleIVZeKSReISleLDFeKENeISI=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_dd15a8dc30f3",
      "text": "那就一言為定， ",
      "encoded_ascii": "^)!^*J^!%^1Y^%{^#.^*A ",
      "encoded_base64": "XikhXipKXiElXjFZXiV7XiMuXipBIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_23cf463c68f8",
      "text": "五枚陶幣",
      "encoded_ascii": "^!6^$~^)R^+|",
      "encoded_base64": "XiE2XiR+XilSXit8",
      "byte_length": 12
    },
    {
      "unit_id": "DLG_870f76445915",
      "text": "一件護甲",
      "encoded_ascii": "^!%^.W^(T^&J",
      "encoded_base64": "XiElXi5XXihUXiZK",
      "byte_length": 12
    },
    {
      "unit_id": "DLG_f1633c2c1107",
      "text": " 換一袋糧食。",
      "encoded_ascii": " ^4@^!%^(?^5s^0J^!\"",
      "encoded_base64": "IF40QF4hJV4oP141c14wSl4hIg==",
      "byte_length": 19
    },
    {
      "unit_id": "DLG_42514dfb857c",
      "text": "你們簡直是在搶劫，但護甲給你們。糧食歸我了。",
      "encoded_ascii": "^*F^*{^3y^&`^,X^\"d^1?^1l^*A^!I^(T^&J^'A^*F^*{^!\"^5s^0J^%K^$%^*D^!\"",
      "encoded_base64": "XipGXip7XjN5XiZgXixYXiJkXjE/XjFsXipBXiFJXihUXiZKXidBXipGXip7XiEiXjVzXjBKXiVLXiQlXipEXiEi",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_4cf6b5e69312",
      "text": " 這樣能接受嗎？",
      "encoded_ascii": " ^(s^,f^'b^$?^\";^+X^.V",
      "encoded_base64": "IF4oc14sZl4nYl4kP14iO14rWF4uVg==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_76f52f90c864",
      "text": "那就成交了。",
      "encoded_ascii": "^)!^*J^$$^0P^*D^!\"",
      "encoded_base64": "XikhXipKXiQkXjBQXipEXiEi",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_c18abde98cd7",
      "text": "  我在哪裡能找到這個米奎茲爾？",
      "encoded_ascii": "  ^$%^\"d^+I^-j^'b^$/^!u^(s^!V^'4^5B^/D^&/^.V",
      "encoded_base64": "ICBeJCVeImReK0leLWpeJ2JeJC9eIXVeKHNeIVZeJzReNUJeL0ReJi9eLlY=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_edfe346f7f26",
      "text": "  跟我說說狂信徒的事。",
      "encoded_ascii": "  ^.+^$%^-x^-x^&8^!U^#d^&Z^*r^!\"",
      "encoded_base64": "ICBeLiteJCVeLXheLXheJjheIVVeI2ReJlpeKnJeISI=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_4c1b726a65ec",
      "text": " 從這裡往西延伸的管道走下去。",
      "encoded_ascii": " ^#f^(s^-j^,)^-l^,&^/N^&Z^-D^(y^.&^!(^\"6^!\"",
      "encoded_base64": "IF4jZl4oc14tal4sKV4tbF4sJl4vTl4mWl4tRF4oeV4uJl4hKF4iNl4hIg==",
      "byte_length": 43
    },
    {
      "unit_id": "DLG_4e3b42af4cc4",
      "text": " 狂信徒",
      "encoded_ascii": " ^&8^!U^#d",
      "encoded_base64": "IF4mOF4hVV4jZA==",
      "byte_length": 10
    },
    {
      "unit_id": "DLG_34ddfb5c95d3",
      "text": "就在你們攻擊我部下的那一刻！他們隨時都會趕到！",
      "encoded_ascii": "^*J^\"d^*F^*{^$O^$F^$%^)#^!(^&Z^)!^!%^.Y^*W^!@^*{^)X^$f^)$^$r^0u^!u^*W",
      "encoded_base64": "XipKXiJkXipGXip7XiRPXiRGXiQlXikjXiEoXiZaXikhXiElXi5ZXipXXiFAXip7XilYXiRmXikkXiRyXjB1XiF1XipX",
      "byte_length": 69
    },
    {
      "unit_id": "DLG_58a98807bee7",
      "text": "  把高層巢穴酋長的女兒交出來！",
      "encoded_ascii": "  ^$1^*+^#B^#G^'&^=5^)C^&Z^#\"^++^0P^!q^!O^*W",
      "encoded_base64": "ICBeJDFeKiteI0JeI0deJyZePTVeKUNeJlpeIyJeKyteMFBeIXFeIU9eKlc=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_8c2630bd2b42",
      "text": "  我知道是你們綁架了酋長的女兒。",
      "encoded_ascii": "  ^$%^&h^(y^,X^*F^*{^-K^%\"^*D^=5^)C^&Z^#\"^++^!\"",
      "encoded_base64": "ICBeJCVeJmheKHleLFheKkZeKnteLUteJSJeKkRePTVeKUNeJlpeIyJeKyteISI=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_eaae3962333e",
      "text": "  你們這些綁匪真是敗類！",
      "encoded_ascii": "  ^*F^*{^(s^!8^-K^3g^-2^,X^$R^)w^*W",
      "encoded_base64": "ICBeKkZeKnteKHNeITheLUteM2deLTJeLFheJFJeKXdeKlc=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_81530d308384",
      "text": "  那女孩會怎麼樣？",
      "encoded_ascii": "  ^)!^#\"^+m^$r^,,^.T^,f^.V",
      "encoded_base64": "ICBeKSFeIyJeK21eJHJeLCxeLlReLGZeLlY=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_66d1fd52db0c",
      "text": "  你說的獻祭是怎麼回事？",
      "encoded_ascii": "  ^*F^-x^&Z^-(^&x^,X^,,^.T^\"\\^*r^.V",
      "encoded_base64": "ICBeKkZeLXheJlpeLSheJnheLFheLCxeLlReIlxeKnJeLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_d239a88a5ce9",
      "text": "  說說你的提議吧。",
      "encoded_ascii": "  ^-x^-x^*F^&Z^$A^-|^*I^!\"",
      "encoded_base64": "ICBeLXheLXheKkZeJlpeJEFeLXxeKkleISI=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_2d77dfbe195c",
      "text": "  你竟敢侮辱我，我該宰了你！",
      "encoded_ascii": "  ^*F^28^/m^9+^3`^$%^*A^$%^(M^1w^*D^*F^*W",
      "encoded_base64": "ICBeKkZeMjheL21eOSteM2BeJCVeKkFeJCVeKE1eMXdeKkReKkZeKlc=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_b82a933ababb",
      "text": "  我絕不可能替你們這幫賊工作！",
      "encoded_ascii": "  ^$%^-I^!)^\"A^'b^2o^*F^*{^(s^+}^0?^+y^!M^*W",
      "encoded_base64": "ICBeJCVeLUleISleIkFeJ2JeMm9eKkZeKnteKHNeK31eMD9eK3leIU1eKlc=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_9637f45704a7",
      "text": "  米奎茲爾是誰？",
      "encoded_ascii": "  ^'4^5B^/D^&/^,X^-y^.V",
      "encoded_base64": "ICBeJzReNUJeL0ReJi9eLFheLXleLlY=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_3a1c766cc7aa",
      "text": "  跟我說說高層巢穴的事。",
      "encoded_ascii": "  ^.+^$%^-x^-x^*+^#B^#G^'&^&Z^*r^!\"",
      "encoded_base64": "ICBeLiteJCVeLXheLXheKiteI0JeI0deJyZeJlpeKnJeISI=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_ce7f52c013ef",
      "text": "  我要怎麼去高層巢穴？",
      "encoded_ascii": "  ^$%^(C^,,^.T^\"6^*+^#B^#G^'&^.V",
      "encoded_base64": "ICBeJCVeKENeLCxeLlReIjZeKiteI0JeI0deJyZeLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_1b1e319a2a76",
      "text": "  關於某個人的女兒，有什麼傳聞？",
      "encoded_ascii": "  ^.>^$^^%$^!V^!<^&Z^#\"^++^*A^$s^!=^.T^+$^4^^.V",
      "encoded_base64": "ICBeLj5eJF5eJSReIVZeITxeJlpeIyJeKyteKkFeJHNeIT1eLlReKyReNF5eLlY=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_1e25b95df1b2",
      "text": "你嚴重錯看了我的族人。他們都是老實的勞工。他們當然 ",
      "encoded_ascii": "^*F^1*^))^)5^*Q^*D^$%^&Z^5V^!<^!\"^!@^*{^)$^,X^'U^#3^&Z^/R^+y^!\"^!@^*{^&N^&\" ",
      "encoded_base64": "XipGXjEqXikpXik1XipRXipEXiQlXiZaXjVWXiE8XiEiXiFAXip7XikkXixYXidVXiMzXiZaXi9SXit5XiEiXiFAXip7XiZOXiYiIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_15b360a2b99a",
      "text": "不像米奎茲爾的狂信徒那樣是暴徒。",
      "encoded_ascii": "^!)^!`^'4^5B^/D^&/^&Z^&8^!U^#d^)!^,f^,X^$m^#d^!\"",
      "encoded_base64": "XiEpXiFgXic0XjVCXi9EXiYvXiZaXiY4XiFVXiNkXikhXixmXixYXiRtXiNkXiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_9c0be0d27194",
      "text": "他的神廟就在這裡以西",
      "encoded_ascii": "^!@^&Z^&w^0[^*J^\"d^(s^-j^!B^-l",
      "encoded_base64": "XiFAXiZaXiZ3XjBbXipKXiJkXihzXi1qXiFCXi1s",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_689b3977a7f0",
      "text": "。不用擔心那些",
      "encoded_ascii": "^!\"^!)^&H^*N^#k^)!^!8",
      "encoded_base64": "XiEiXiEpXiZIXipOXiNrXikhXiE4",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_24a12fe10846",
      "text": "。他們只會設法拉攏你加入。如果你執意要去，你就得順著",
      "encoded_ascii": "^!\"^!@^*{^\"?^$r^4e^%b^$6^=V^*F^\"\"^!f^!\"^#$^%!^*F^3?^#z^(C^\"6^*A^*F^*J^#e^.D^-a",
      "encoded_base64": "XiEiXiFAXip7XiI/XiRyXjRlXiViXiQ2Xj1WXipGXiIiXiFmXiEiXiMkXiUhXipGXjM/XiN6XihDXiI2XipBXipGXipKXiNlXi5EXi1h",
      "byte_length": 78
    },
    {
      "unit_id": "DLG_8f4e7257307d",
      "text": "，但聰明的話就避開高層巢穴——沿著",
      "encoded_ascii": "^*A^!I^2=^$c^&Z^-v^*J^0F^)F^*+^#B^#G^'&^*n^*n^%`^-a",
      "encoded_base64": "XipBXiFJXjI9XiRjXiZaXi12XipKXjBGXilGXiorXiNCXiNHXicmXipuXipuXiVgXi1h",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_dd377540121f",
      "text": " 南面管道走，穿過雙重閘門，然後往西北前進。",
      "encoded_ascii": " ^\"/^)j^-D^(y^.&^*A^')^(x^)_^))^)H^)D^*A^&\"^#b^,)^-l^+6^!z^(w^!\"",
      "encoded_base64": "IF4iL14pal4tRF4oeV4uJl4qQV4nKV4oeF4pX14pKV4pSF4pRF4qQV4mIl4jYl4sKV4tbF4rNl4hel4od14hIg==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_67a56627c520",
      "text": "高層巢穴就在這裡的西北方，但那裡的鼠人毫無榮譽可言。他們全是一群盜賊與 ",
      "encoded_ascii": "^*+^#B^#G^'&^*J^\"d^(s^-j^&Z^-l^+6^$]^*A^!I^)!^-j^&Z^*=^!<^/t^%}^,e^6-^\"A^1Y^!\"^!@^*{^!h^,X^!%^'R^0!^0?^'p ",
      "encoded_base64": "XiorXiNCXiNHXicmXipKXiJkXihzXi1qXiZaXi1sXis2XiRdXipBXiFJXikhXi1qXiZaXio9XiE8Xi90XiV9XixlXjYtXiJBXjFZXiEiXiFAXip7XiFoXixYXiElXidSXjAhXjA/XidwIA==",
      "byte_length": 106
    },
    {
      "unit_id": "DLG_0ae2f1c25e04",
      "text": "騙子，為了幾枚陶幣就會在背後捅你一刀。",
      "encoded_ascii": "^.{^#(^*A^%{^*D^#T^$~^)R^+|^*J^$r^\"d^.r^#b^=U^*F^!%^7Q^!\"",
      "encoded_base64": "Xi57XiMoXipBXiV7XipEXiNUXiR+XilSXit8XipKXiRyXiJkXi5yXiNiXj1VXipGXiElXjdRXiEi",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_08ce74e83228",
      "text": "順著",
      "encoded_ascii": "^.D^-a",
      "encoded_base64": "Xi5EXi1h",
      "byte_length": 6
    },
    {
      "unit_id": "DLG_27609ef40022",
      "text": " 岔路口往北走，穿過你遇到的閘門，高層巢穴就在後面。",
      "encoded_ascii": " ^3m^(a^\"<^,)^+6^.&^*A^')^(x^*F^.2^!u^&Z^)H^)D^*A^*+^#B^#G^'&^*J^\"d^#b^)j^!\"",
      "encoded_base64": "IF4zbV4oYV4iPF4sKV4rNl4uJl4qQV4nKV4oeF4qRl4uMl4hdV4mWl4pSF4pRF4qQV4qK14jQl4jR14nJl4qSl4iZF4jYl4pal4hIg==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_22fa1b0093d7",
      "text": "滾開，離我遠點！ ",
      "encoded_ascii": "^,z^)F^*A^)`^$%^({^*;^*W ",
      "encoded_base64": "Xix6XilGXipBXilgXiQlXih7Xio7XipXIA==",
      "byte_length": 25
    },
    {
      "unit_id": "DLG_8fd4130de0e6",
      "text": "我早就向城衛兵通報你們的行蹤了， ",
      "encoded_ascii": "^$%^,V^*J^+?^+_^(=^+,^(t^+`^*F^*{^&Z^(;^(b^*D^*A ",
      "encoded_base64": "XiQlXixWXipKXis/XitfXig9XissXih0XitgXipGXip7XiZaXig7XihiXipEXipBIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_2163ad05b06f",
      "text": "我對她的事一無所知！",
      "encoded_ascii": "^$%^#:^+h^&Z^*r^!%^%}^$)^&h^*W",
      "encoded_base64": "XiQlXiM6XitoXiZaXipyXiElXiV9XiQpXiZoXipX",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_57a661de9e91",
      "text": "別傷害我！她不在這裡！ ",
      "encoded_ascii": "^*H^!^^#/^$%^*W^+h^!)^\"d^(s^-j^*W ",
      "encoded_base64": "XipIXiFeXiMvXiQlXipXXitoXiEpXiJkXihzXi1qXipXIA==",
      "byte_length": 34
    },
    {
      "unit_id": "DLG_b6cde954d896",
      "text": "，不是我！",
      "encoded_ascii": "^*A^!)^,X^$%^*W",
      "encoded_base64": "XipBXiEpXixYXiQlXipX",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_86cc31a33ef6",
      "text": "。我們沒有惡意！那只是一份差事。",
      "encoded_ascii": "^!\"^$%^*{^%\\^$s^#y^#z^*W^)!^\"?^,X^!%^*x^48^*r^!\"",
      "encoded_base64": "XiEiXiQlXip7XiVcXiRzXiN5XiN6XipXXikhXiI/XixYXiElXip4XjQ4XipyXiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_4f6c80014ca3",
      "text": "米奎茲爾才是邪惡的罪魁禍首！是他派我們去抓那個女孩的。 ",
      "encoded_ascii": "^'4^5B^/D^&/^$,^,X^)\"^#y^&Z^5x^<!^7B^)~^*W^,X^!@^.n^$%^*{^\"6^$2^)!^!V^#\"^+m^&Z^!\" ",
      "encoded_base64": "Xic0XjVCXi9EXiYvXiQsXixYXikiXiN5XiZaXjV4XjwhXjdCXil+XipXXixYXiFAXi5uXiQlXip7XiI2XiQyXikhXiFWXiMiXittXiZaXiEiIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_668cb03f3719",
      "text": "我們只是為了酬勞做些誠實的苦工。",
      "encoded_ascii": "^$%^*{^\"?^,X^%{^*D^7o^/R^*~^!8^2E^#3^&Z^.t^+y^!\"",
      "encoded_base64": "XiQlXip7XiI/XixYXiV7XipEXjdvXi9SXip+XiE4XjJFXiMzXiZaXi50Xit5XiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_31014619152f",
      "text": "我懷疑那女孩還活著。我敢說那些",
      "encoded_ascii": "^$%^,9^0p^)!^#\"^+m^.7^%i^-a^!\"^$%^/m^-x^)!^!8",
      "encoded_base64": "XiQlXiw5XjBwXikhXiMiXittXi43XiVpXi1hXiEiXiQlXi9tXi14XikhXiE4",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_b17c2ce24d42",
      "text": " 肯定早就把她獻祭了。",
      "encoded_ascii": " ^-Z^#.^,V^*J^$1^+h^-(^&x^*D^!\"",
      "encoded_base64": "IF4tWl4jLl4sVl4qSl4kMV4raF4tKF4meF4qRF4hIg==",
      "byte_length": 31
    },
    {
      "unit_id": "DLG_1bb50ad32f14",
      "text": "米奎茲爾和他的",
      "encoded_ascii": "^'4^5B^/D^&/^\"O^!@^&Z",
      "encoded_base64": "Xic0XjVCXi9EXiYvXiJPXiFAXiZa",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_f9f46250b2de",
      "text": " 隨時都在向特克圖克提特利獻祭。米奎茲爾就是這樣獲取力量的。",
      "encoded_ascii": " ^)X^$f^)$^\"d^+?^&5^!d^\"b^!d^$A^&5^!t^-(^&x^!\"^'4^5B^/D^&/^*J^,X^(s^,f^&:^\":^!~^)*^&Z^!\"",
      "encoded_base64": "IF4pWF4kZl4pJF4iZF4rP14mNV4hZF4iYl4hZF4kQV4mNV4hdF4tKF4meF4hIl4nNF41Ql4vRF4mL14qSl4sWF4oc14sZl4mOl4iOl4hfl4pKl4mWl4hIg==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_12c1cfbcdb1e",
      "text": "米奎茲爾說服了許多鼠人追隨他，並且崇拜巫王特克圖克提特利。",
      "encoded_ascii": "^'4^5B^/D^&/^-x^,\\^*D^-s^\"x^*=^!<^(o^)X^!@^*A^!+^!*^13^,E^14^-)^&5^!d^\"b^!d^$A^&5^!t^!\"",
      "encoded_base64": "Xic0XjVCXi9EXiYvXi14XixcXipEXi1zXiJ4Xio9XiE8XihvXilYXiFAXipBXiErXiEqXjEzXixFXjE0Xi0pXiY1XiFkXiJiXiFkXiRBXiY1XiF0XiEi",
      "byte_length": 87
    },
    {
      "unit_id": "DLG_712cfe321b7f",
      "text": "  為什麼這些鼠人會追隨米奎茲爾？",
      "encoded_ascii": "  ^%{^!=^.T^(s^!8^*=^!<^$r^(o^)X^'4^5B^/D^&/^.V",
      "encoded_base64": "ICBeJXteIT1eLlReKHNeITheKj1eITxeJHJeKG9eKVheJzReNUJeL0ReJi9eLlY=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_38729ba1e1f1",
      "text": "  你和米奎茲爾有什麼勾當？",
      "encoded_ascii": "  ^*F^\"O^'4^5B^/D^&/^$s^!=^.T^7t^&N^.V",
      "encoded_base64": "ICBeKkZeIk9eJzReNUJeL0ReJi9eJHNeIT1eLlReN3ReJk5eLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_e6255246747a",
      "text": "  為什麼米奎茲爾要招募鼠人？",
      "encoded_ascii": "  ^%{^!=^.T^'4^5B^/D^&/^(C^,D^9S^*=^!<^.V",
      "encoded_base64": "ICBeJXteIT1eLlReJzReNUJeL0ReJi9eKENeLEReOVNeKj1eITxeLlY=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_4f750bbbbb13",
      "text": "澤圖斯",
      "encoded_ascii": "^/3^\"b^$[",
      "encoded_base64": "Xi8zXiJiXiRb",
      "byte_length": 9
    },
    {
      "unit_id": "DLG_4d12e0644459",
      "text": "是我用詞不當。我只是說，你們註定要成就更偉大的征業， ",
      "encoded_ascii": "^,X^$%^&H^.v^!)^&N^!\"^$%^\"?^,X^-x^*A^*F^*{^=F^#.^(C^$$^*J^$o^*}^\"z^&Z^.c^%5^*A ",
      "encoded_base64": "XixYXiQlXiZIXi52XiEpXiZOXiEiXiQlXiI/XixYXi14XipBXipGXip7Xj1GXiMuXihDXiQkXipKXiRvXip9XiJ6XiZaXi5jXiU1XipBIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_af1a0f73634c",
      "text": "不需要靠高層巢穴的鼠人來考驗勇氣。",
      "encoded_ascii": "^!)^)e^(C^.C^*+^#B^#G^'&^&Z^*=^!<^!O^-R^.P^\"$^%U^!\"",
      "encoded_base64": "XiEpXillXihDXi5DXiorXiNCXiNHXicmXiZaXio9XiE8XiFPXi1SXi5QXiIkXiVVXiEi",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_5f075d36e031",
      "text": "他給他們食物。下水道裡沒什麼可吃的，所以所有 ",
      "encoded_ascii": "^!@^'A^!@^*{^0J^&4^!\"^!(^%V^(y^-j^%\\^!=^.T^\"A^2^^&Z^*A^$)^!B^$)^$s ",
      "encoded_base64": "XiFAXidBXiFAXip7XjBKXiY0XiEiXiEoXiVWXih5Xi1qXiVcXiE9Xi5UXiJBXjJeXiZaXipBXiQpXiFCXiQpXiRzIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_727c4638f4c7",
      "text": "意志薄弱的敗類都投奔了他。",
      "encoded_ascii": "^#z^#m^6o^#\\^&Z^$R^)w^)$^$3^2b^*D^!@^!\"",
      "encoded_base64": "XiN6XiNtXjZvXiNcXiZaXiRSXil3XikkXiQzXjJiXipEXiFAXiEi",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_f3f9cae986fd",
      "text": "我發誓，我為他綁架高層巢穴酋長的女兒，純粹是因為我們快餓死了。 ",
      "encoded_ascii": "^$%^&W^-w^*A^$%^%{^!@^-K^%\"^*+^#B^#G^'&^=5^)C^&Z^#\"^++^*A^3\"^5r^,X^\"]^%{^$%^*{^*L^2R^%L^*D^!\" ",
      "encoded_base64": "XiQlXiZXXi13XipBXiQlXiV7XiFAXi1LXiUiXiorXiNCXiNHXicmXj01XilDXiZaXiMiXisrXipBXjMiXjVyXixYXiJdXiV7XiQlXip7XipMXjJSXiVMXipEXiEiIA==",
      "byte_length": 94
    },
    {
      "unit_id": "DLG_5bac541f7e82",
      "text": "米奎茲爾囤積了所有食物。我試過反抗他，但我勢單力薄。",
      "encoded_ascii": "^'4^5B^/D^&/^8V^27^*D^$)^$s^0J^&4^!\"^$%^-u^(x^\"9^$4^!@^*A^!I^$%^\"&^2a^!~^6o^!\"",
      "encoded_base64": "Xic0XjVCXi9EXiYvXjhWXjI3XipEXiQpXiRzXjBKXiY0XiEiXiQlXi11Xih4XiI5XiQ0XiFAXipBXiFJXiQlXiImXjJhXiF+XjZvXiEi",
      "byte_length": 78
    },
    {
      "unit_id": "DLG_6331d229299c",
      "text": "我和米奎茲爾沒有任何往來。",
      "encoded_ascii": "^$%^\"O^'4^5B^/D^&/^%\\^$s^!C^!L^,)^!O^!\"",
      "encoded_base64": "XiQlXiJPXic0XjVCXi9EXiYvXiVcXiRzXiFDXiFMXiwpXiFPXiEi",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_0d976ca5d03b",
      "text": "那不是我關心的事，老實說，我也不想知道。",
      "encoded_ascii": "^)!^!)^,X^$%^.>^#k^&Z^*r^*A^'U^#3^-x^*A^$%^!1^!)^,1^&h^(y^!\"",
      "encoded_base64": "XikhXiEpXixYXiQlXi4+XiNrXiZaXipyXipBXidVXiMzXi14XipBXiQlXiExXiEpXiwxXiZoXih5XiEi",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_a927430b1b7e",
      "text": "隨你高興，強大的戰士。",
      "encoded_ascii": "^)X^*F^*+^-]^*A^#]^\"z^&Z^$(^+a^!\"",
      "encoded_base64": "XilYXipGXiorXi1dXipBXiNdXiJ6XiZaXiQoXithXiEi",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_9a258cdbc334",
      "text": "米奎茲爾付錢讓我們綁架她並送交給他。她現在在他手裡",
      "encoded_ascii": "^'4^5B^/D^&/^*u^.<^-}^$%^*{^-K^%\"^+h^!+^./^0P^'A^!@^!\"^+h^&?^\"d^\"d^!@^$+^-j",
      "encoded_base64": "Xic0XjVCXi9EXiYvXip1Xi48Xi19XiQlXip7Xi1LXiUiXitoXiErXi4vXjBQXidBXiFAXiEiXitoXiY/XiJkXiJkXiFAXiQrXi1q",
      "byte_length": 75
    },
    {
      "unit_id": "DLG_b8e969534820",
      "text": " 不過，在你們離開之前……孩子們",
      "encoded_ascii": " ^!)^(x^*A^\"d^*F^*{^)`^)F^!/^!z^*o^*o^+m^#(^*{",
      "encoded_base64": "IF4hKV4oeF4qQV4iZF4qRl4qe14pYF4pRl4hL14hel4qb14qb14rbV4jKF4qew==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_0f17e5a89aa6",
      "text": "很抱歉，我沒什麼能再告訴你們的了。 ",
      "encoded_ascii": "^*K^,@^,h^*A^$%^%\\^!=^.T^'b^!l^+B^-t^*F^*{^&Z^*D^!\" ",
      "encoded_base64": "XipLXixAXixoXipBXiQlXiVcXiE9Xi5UXidiXiFsXitCXi10XipGXip7XiZaXipEXiEiIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_804e339f5771",
      "text": "不過，我的族人",
      "encoded_ascii": "^!)^(x^*A^$%^&Z^5V^!<",
      "encoded_base64": "XiEpXih4XipBXiQlXiZaXjVWXiE8",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_67af0a83cd08",
      "text": " 非常飢餓。你們有任何糧食願意 ",
      "encoded_ascii": " ^)i^#O^1d^2R^!\"^*F^*{^$s^!C^!L^5s^0J^.H^#z ",
      "encoded_base64": "IF4paV4jT14xZF4yUl4hIl4qRl4qe14kc14hQ14hTF41c14wSl4uSF4jeiA=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_cb5d3da02de2",
      "text": "拿來交易嗎？",
      "encoded_ascii": "^,G^!O^0P^,W^+X^.V",
      "encoded_base64": "XixHXiFPXjBQXixXXitYXi5W",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_e22e027c8e6c",
      "text": "我是巢穴主管丘爾。你們是誰？",
      "encoded_ascii": "^$%^,X^#G^'&^!-^-D^5(^&/^!\"^*F^*{^,X^-y^.V",
      "encoded_base64": "XiQlXixYXiNHXicmXiEtXi1EXjUoXiYvXiEiXipGXip7XixYXi15Xi5W",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_749a1f4b287b",
      "text": "  我是角鬥士。",
      "encoded_ascii": "  ^$%^,X^(H^*,^+a^!\"",
      "encoded_base64": "ICBeJCVeLFheKEheKixeK2FeISI=",
      "byte_length": 20
    },
    {
      "unit_id": "DLG_d11a2ccce9ae",
      "text": "  我什麼都不會告訴你！",
      "encoded_ascii": "  ^$%^!=^.T^)$^!)^$r^+B^-t^*F^*W",
      "encoded_base64": "ICBeJCVeIT1eLlReKSReISleJHJeK0JeLXReKkZeKlc=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_e367c60c48a2",
      "text": "  我是城裡的下水道巡檢員。",
      "encoded_ascii": "  ^$%^,X^+_^-j^&Z^!(^%V^(y^8g^%?^+G^!\"",
      "encoded_base64": "ICBeJCVeLFheK19eLWpeJlpeISheJVZeKHleOGdeJT9eK0deISI=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_fc9a9a0ba53b",
      "text": "很好！",
      "encoded_ascii": "^*K^+i^*W",
      "encoded_base64": "XipLXitpXipX",
      "byte_length": 9
    },
    {
      "unit_id": "DLG_15389c079456",
      "text": "哈！哈雷爾跟我說過你有多嚇人——就像隻膽小的耗子一樣！",
      "encoded_ascii": "^+F^*W^+F^)c^&/^.+^$%^-x^(x^*F^$s^\"x^\"X^!<^*n^*n^*J^!`^)[^-[^#;^&Z^'X^#(^!%^,f^*W",
      "encoded_base64": "XitGXipXXitGXiljXiYvXi4rXiQlXi14Xih4XipGXiRzXiJ4XiJYXiE8XipuXipuXipKXiFgXilbXi1bXiM7XiZaXidYXiMoXiElXixmXipX",
      "byte_length": 81
    },
    {
      "unit_id": "DLG_d5023570facc",
      "text": "我只是基於友善問問。你顯然是個 ",
      "encoded_ascii": "^$%^\"?^,X^/'^$^^\"8^1(^*Z^*Z^!\"^*F^4&^&\"^,X^!V ",
      "encoded_base64": "XiQlXiI/XixYXi8nXiReXiI4XjEoXipaXipaXiEiXipGXjQmXiYiXixYXiFWIA==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_164e4a29750c",
      "text": "手段不凡的大人物。",
      "encoded_ascii": "^$+^.l^!)^+-^&Z^\"z^!<^&4^!\"",
      "encoded_base64": "XiQrXi5sXiEpXistXiZaXiJ6XiE8XiY0XiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_844175f04d95",
      "text": "德拉吉根本不在乎下面發生什麼事！ ",
      "encoded_ascii": "^#j^$6^\"D^%)^$x^!)^\"d^!0^!(^)j^&W^&F^!=^.T^*r^*W ",
      "encoded_base64": "XiNqXiQ2XiJEXiUpXiR4XiEpXiJkXiEwXiEoXilqXiZXXiZGXiE9Xi5UXipyXipXIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_78891f94325a",
      "text": "不然你以為我們鼠人為什麼住在下水道？但我不會逼你說實話。",
      "encoded_ascii": "^!)^&\"^*F^!B^%{^$%^*{^*=^!<^%{^!=^.T^*z^\"d^!(^%V^(y^.V^!I^$%^!)^$r^.1^*F^-x^#3^-v^!\"",
      "encoded_base64": "XiEpXiYiXipGXiFCXiV7XiQlXip7Xio9XiE8XiV7XiE9Xi5UXip6XiJkXiEoXiVWXih5Xi5WXiFJXiQlXiEpXiRyXi4xXipGXi14XiMzXi12XiEi",
      "byte_length": 84
    },
    {
      "unit_id": "DLG_57a9e6eeb7b6",
      "text": "除非有逃亡的奴隸湊巧迷失了 ",
      "encoded_ascii": "^)Q^)i^$s^(p^!:^&Z^##^)Z^77^3D^(n^\"|^*D ",
      "encoded_base64": "XilRXilpXiRzXihwXiE6XiZaXiMjXilaXjc3XjNEXihuXiJ8XipEIA==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_b81975da33c7",
      "text": "他的",
      "encoded_ascii": "^!@^&Z",
      "encoded_base64": "XiFAXiZa",
      "byte_length": 6
    },
    {
      "unit_id": "DLG_2136cfff2513",
      "text": "她的",
      "encoded_ascii": "^+h^&Z",
      "encoded_base64": "XitoXiZa",
      "byte_length": 6
    },
    {
      "unit_id": "DLG_96a0b0c79fc4",
      "text": " 方向。",
      "encoded_ascii": " ^$]^+?^!\"",
      "encoded_base64": "IF4kXV4rP14hIg==",
      "byte_length": 10
    },
    {
      "unit_id": "DLG_e64ca27e4abd",
      "text": "滾開！我對你們這種諂媚假笑的弱者毫無興趣！",
      "encoded_ascii": "^,z^)F^*W^$%^#:^*F^*{^(s^'$^1[^1.^1i^-@^&Z^#\\^'V^/t^%}^-]^.*^*W",
      "encoded_base64": "Xix6XilGXipXXiQlXiM6XipGXip7XihzXickXjFbXjEuXjFpXi1AXiZaXiNcXidWXi90XiV9Xi1dXi4qXipX",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_6831e4996cfb",
      "text": " 我需要像你們這樣強大的戰士效勞。想不想賺點外快？",
      "encoded_ascii": " ^$%^)e^(C^!`^*F^*{^(s^,f^#]^\"z^&Z^$(^+a^$Q^/R^!\"^,1^!)^,1^7m^*;^\"w^*L^.V",
      "encoded_base64": "IF4kJV4pZV4oQ14hYF4qRl4qe14oc14sZl4jXV4iel4mWl4kKF4rYV4kUV4vUl4hIl4sMV4hKV4sMV43bV4qO14id14qTF4uVg==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_9dc7f2716758",
      "text": "我早就派人去叫城衛兵來領回他們的逃跑財產了。",
      "encoded_ascii": "^$%^,V^*J^.n^!<^\"6^+<^+_^(=^+,^!O^)s^\"\\^!@^*{^&Z^(p^(_^0=^&G^*D^!\"",
      "encoded_base64": "XiQlXixWXipKXi5uXiE8XiI2Xis8XitfXig9XissXiFPXilzXiJcXiFAXip7XiZaXihwXihfXjA9XiZHXipEXiEi",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_fb98600c66c8",
      "text": "你們和我的人馬聯手。我們一起徹底消滅盤踞在高層巢穴的下賤害蟲！ ",
      "encoded_ascii": "^*F^*{^\"O^$%^&Z^!<^*\"^-V^$+^!\"^$%^*{^!%^.(^18^/^^%k^%t^1M^1_^\"d^*+^#B^#G^'&^&Z^!(^2G^#/^(8^*W ",
      "encoded_base64": "XipGXip7XiJPXiQlXiZaXiE8XioiXi1WXiQrXiEiXiQlXip7XiElXi4oXjE4Xi9eXiVrXiV0XjFNXjFfXiJkXiorXiNCXiNHXicmXiZaXiEoXjJHXiMvXig4XipXIA==",
      "byte_length": 94
    },
    {
      "unit_id": "DLG_93c2287c0170",
      "text": "我們大家都能靠戰利品大發橫財、吃得腦滿腸肥，就像那些狂信徒一樣！",
      "encoded_ascii": "^$%^*{^\"z^+s^)$^'b^.C^$(^!t^\"R^\"z^&W^/2^0=^!!^2^^#e^2@^,{^<[^-Y^*A^*J^!`^)!^!8^&8^!U^#d^!%^,f^*W",
      "encoded_base64": "XiQlXip7XiJ6XitzXikkXidiXi5DXiQoXiF0XiJSXiJ6XiZXXi8yXjA9XiEhXjJeXiNlXjJAXix7XjxbXi1ZXipBXipKXiFgXikhXiE4XiY4XiFVXiNkXiElXixmXipX",
      "byte_length": 96
    },
    {
      "unit_id": "DLG_9d89d4939ce1",
      "text": "  算我一個！",
      "encoded_ascii": "  ^-C^$%^!%^!V^*W",
      "encoded_base64": "ICBeLUNeJCVeISVeIVZeKlc=",
      "byte_length": 17
    },
    {
      "unit_id": "DLG_ed3f624d75ee",
      "text": "  我不和惡徒為伍。",
      "encoded_ascii": "  ^$%^!)^\"O^#y^#d^%{^!F^!\"",
      "encoded_base64": "ICBeJCVeISleIk9eI3leI2ReJXteIUZeISI=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_ebef60eb6737",
      "text": "  我不需要錢。",
      "encoded_ascii": "  ^$%^!)^)e^(C^.<^!\"",
      "encoded_base64": "ICBeJCVeISleKWVeKENeLjxeISI=",
      "byte_length": 20
    },
    {
      "unit_id": "DLG_b8c97d4bfb93",
      "text": "你可能不需要，但錢永遠不嫌多！你要加入我們嗎？",
      "encoded_ascii": "^*F^\"A^'b^!)^)e^(C^*A^!I^.<^%W^({^!)^:4^\"x^*W^*F^(C^\"\"^!f^$%^*{^+X^.V",
      "encoded_base64": "XipGXiJBXidiXiEpXillXihDXipBXiFJXi48XiVXXih7XiEpXjo0XiJ4XipXXipGXihDXiIiXiFmXiQlXip7XitYXi5W",
      "byte_length": 69
    },
    {
      "unit_id": "DLG_f2e516ab2cba",
      "text": "哎，算了。我一開始就知道你根本沒那個膽量！",
      "encoded_ascii": "^3i^*A^-C^*D^!\"^$%^!%^)F^+k^*J^&h^(y^*F^%)^$x^%\\^)!^!V^-[^)*^*W",
      "encoded_base64": "XjNpXipBXi1DXipEXiEiXiQlXiElXilGXitrXipKXiZoXih5XipGXiUpXiR4XiVcXikhXiFWXi1bXikqXipX",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_e17c85fe69ed",
      "text": "太棒了！我的戰士們會跟隨你們前往高層巢穴。 ",
      "encoded_ascii": "^+f^%1^*D^*W^$%^&Z^$(^+a^*{^$r^.+^)X^*F^*{^!z^,)^*+^#B^#G^'&^!\" ",
      "encoded_base64": "XitmXiUxXipEXipXXiQlXiZaXiQoXithXip7XiRyXi4rXilYXipGXip7XiF6XiwpXiorXiNCXiNHXicmXiEiIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_86b87d4227ba",
      "text": "這場屠殺將會無比壯烈！",
      "encoded_ascii": "^(s^\"n^#A^%M^#7^$r^%}^,m^+b^%|^*W",
      "encoded_base64": "XihzXiJuXiNBXiVNXiM3XiRyXiV9XixtXitiXiV8XipX",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_631f0f4af363",
      "text": "  我想打聽些情報！",
      "encoded_ascii": "  ^$%^,1^$-^-X^!8^,0^+`^*W",
      "encoded_base64": "ICBeJCVeLDFeJC1eLVheITheLDBeK2BeKlc=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_c7c8d6439f17",
      "text": "  我的報酬呢？",
      "encoded_ascii": "  ^$%^&Z^+`^7o^+C^.V",
      "encoded_base64": "ICBeJCVeJlpeK2BeN29eK0NeLlY=",
      "byte_length": 20
    },
    {
      "unit_id": "DLG_020358a4e45e",
      "text": "  把錢給我，否則你就得死！",
      "encoded_ascii": "  ^$1^.<^'A^$%^*A^\"H^!x^*F^*J^#e^%L^*W",
      "encoded_base64": "ICBeJDFeLjxeJ0FeJCVeKkFeIkheIXheKkZeKkpeI2VeJUxeKlc=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_78b229b48398",
      "text": "  只是隨便逛逛。",
      "encoded_ascii": "  ^\"?^,X^)X^!R^8A^8A^!\"",
      "encoded_base64": "ICBeIj9eLFheKVheIVJeOEFeOEFeISI=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_a6620a78ec66",
      "text": "  你想要多少錢？",
      "encoded_ascii": "  ^*F^,1^(C^\"x^#<^.<^.V",
      "encoded_base64": "ICBeKkZeLDFeKENeInheIzxeLjxeLlY=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_6bd355baabdc",
      "text": "怎樣？考慮過我的提議了嗎？",
      "encoded_ascii": "^,,^,f^.V^-R^19^(x^$%^&Z^$A^-|^*D^+X^.V",
      "encoded_base64": "XiwsXixmXi5WXi1SXjE5Xih4XiQlXiZaXiRBXi18XipEXitYXi5W",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_cc5f06df4cb9",
      "text": "我就知道你們辦得到！既然你們殺了高層巢穴那個愛管閒事的傢伙，現在下水道歸我管了！",
      "encoded_ascii": "^$%^*J^&h^(y^*F^*{^2L^#e^!u^*W^,U^&\"^*F^*{^%M^*D^*+^#B^#G^'&^)!^!V^,2^-D^6A^*r^&Z^+#^*y^*A^&?^\"d^!(^%V^(y^%K^$%^-D^*D^*W",
      "encoded_base64": "XiQlXipKXiZoXih5XipGXip7XjJMXiNlXiF1XipXXixVXiYiXipGXip7XiVNXipEXiorXiNCXiNHXicmXikhXiFWXiwyXi1EXjZBXipyXiZaXisjXip5XipBXiY/XiJkXiEoXiVWXih5XiVLXiQlXi1EXipEXipX",
      "byte_length": 120
    },
    {
      "unit_id": "DLG_97e18567fe35",
      "text": "你們在這裡做什麼？你們應該率隊進攻高層巢穴才對。",
      "encoded_ascii": "^*F^*{^\"d^(s^-j^*~^!=^.T^.V^*F^*{^0`^(M^22^)U^(w^$O^*+^#B^#G^'&^$,^#:^!\"",
      "encoded_base64": "XipGXip7XiJkXihzXi1qXip+XiE9Xi5UXi5WXipGXip7XjBgXihNXjIyXilVXih3XiRPXiorXiNCXiNHXicmXiQsXiM6XiEi",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_c385468dd8ff",
      "text": "高層巢穴酋長一死，米奎茲爾和他的狂信徒就是下水道裡唯一的另一股勢力了。",
      "encoded_ascii": "^*+^#B^#G^'&^=5^)C^!%^%L^*A^'4^5B^/D^&/^\"O^!@^&Z^&8^!U^#d^*J^,X^!(^%V^(y^-j^+O^!%^&Z^\">^!%^'_^\"&^!~^*D^!\"",
      "encoded_base64": "XiorXiNCXiNHXicmXj01XilDXiElXiVMXipBXic0XjVCXi9EXiYvXiJPXiFAXiZaXiY4XiFVXiNkXipKXixYXiEoXiVWXih5Xi1qXitPXiElXiZaXiI+XiElXidfXiImXiF+XipEXiEi",
      "byte_length": 105
    },
    {
      "unit_id": "DLG_d990074d1361",
      "text": "我已經把我知道的一切都告訴你了。 ",
      "encoded_ascii": "^$%^#J^'D^$1^$%^&h^(y^&Z^!%^+.^)$^+B^-t^*F^*D^!\" ",
      "encoded_base64": "XiQlXiNKXidEXiQxXiQlXiZoXih5XiZaXiElXisuXikkXitCXi10XipGXipEXiEiIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_d2bc431625ad",
      "text": "總之，除非你想給我錢，否則離我遠點。",
      "encoded_ascii": "^-M^!/^*A^)Q^)i^*F^,1^'A^$%^.<^*A^\"H^!x^)`^$%^({^*;^!\"",
      "encoded_base64": "Xi1NXiEvXipBXilRXilpXipGXiwxXidBXiQlXi48XipBXiJIXiF4XilgXiQlXih7Xio7XiEi",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_33476c57616b",
      "text": "我要收 ",
      "encoded_ascii": "^$%^(C^$M ",
      "encoded_base64": "XiQlXihDXiRNIA==",
      "byte_length": 10
    },
    {
      "unit_id": "DLG_73cbcdb8f0a2",
      "text": " 枚陶幣，如果你有的話。這樣能接受嗎？",
      "encoded_ascii": " ^$~^)R^+|^*A^#$^%!^*F^$s^&Z^-v^!\"^(s^,f^'b^$?^\";^+X^.V",
      "encoded_base64": "IF4kfl4pUl4rfF4qQV4jJF4lIV4qRl4kc14mWl4tdl4hIl4oc14sZl4nYl4kP14iO14rWF4uVg==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_df57248f2ede",
      "text": "多謝。你真是慷慨。",
      "encoded_ascii": "^\"x^-z^!\"^*F^-2^,X^70^7/^!\"",
      "encoded_base64": "XiJ4Xi16XiEiXipGXi0yXixYXjcwXjcvXiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_8856731dc613",
      "text": "錢很難賺，對吧？",
      "encoded_ascii": "^.<^*K^)a^7m^*A^#:^*I^.V",
      "encoded_base64": "Xi48XipLXilhXjdtXipBXiM6XipJXi5W",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_e3bf30abcc76",
      "text": "你們在高層巢穴沒找到戰利品嗎？肯定都被米奎茲爾 ",
      "encoded_ascii": "^*F^*{^\"d^*+^#B^#G^'&^%\\^$/^!u^$(^!t^\"R^+X^.V^-Z^#.^)$^(@^'4^5B^/D^&/ ",
      "encoded_base64": "XipGXip7XiJkXiorXiNCXiNHXicmXiVcXiQvXiF1XiQoXiF0XiJSXitYXi5WXi1aXiMuXikkXihAXic0XjVCXi9EXiYvIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_74b995f4e158",
      "text": "搜刮光了。你們得從他那裡討回來。",
      "encoded_ascii": "^/h^;r^!c^*D^!\"^*F^*{^#e^#f^!@^)!^-j^-o^\"\\^!O^!\"",
      "encoded_base64": "Xi9oXjtyXiFjXipEXiEiXipGXip7XiNlXiNmXiFAXikhXi1qXi1vXiJcXiFPXiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_28b671e336f7",
      "text": "早就說過了！",
      "encoded_ascii": "^,V^*J^-x^(x^*D^*W",
      "encoded_base64": "XixWXipKXi14Xih4XipEXipX",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_391326f4aa8e",
      "text": "他曾是德拉吉的聖堂武士，但因蒙受恥辱而被迫逃進了下水道。",
      "encoded_ascii": "^!@^.j^,X^#j^$6^\"D^&Z^'Z^42^%J^+a^*A^!I^\"]^-c^\";^3G^3`^'W^(@^1`^(p^(w^*D^!(^%V^(y^!\"",
      "encoded_base64": "XiFAXi5qXixYXiNqXiQ2XiJEXiZaXidaXjQyXiVKXithXipBXiFJXiJdXi1jXiI7XjNHXjNgXidXXihAXjFgXihwXih3XipEXiEoXiVWXih5XiEi",
      "byte_length": 84
    },
    {
      "unit_id": "DLG_48f4693ce6d9",
      "text": "我早就告訴過你了，我們把那個女孩交給米奎茲爾了。你想把她救回去，就自己去找他解決。",
      "encoded_ascii": "^$%^,V^*J^+B^-t^(x^*F^*D^*A^$%^*{^$1^)!^!V^#\"^+m^0P^'A^'4^5B^/D^&/^*D^!\"^*F^,1^$1^+h^,Q^\"\\^\"6^*A^*J^'l^#I^\"6^$/^!@^(I^,o^!\"",
      "encoded_base64": "XiQlXixWXipKXitCXi10Xih4XipGXipEXipBXiQlXip7XiQxXikhXiFWXiMiXittXjBQXidBXic0XjVCXi9EXiYvXipEXiEiXipGXiwxXiQxXitoXixRXiJcXiI2XipBXipKXidsXiNJXiI2XiQvXiFAXihJXixvXiEi",
      "byte_length": 123
    },
    {
      "unit_id": "DLG_948501a7548f",
      "text": "那些狂信徒企圖消滅長老！已經有人在巢穴深處發現了更多 ",
      "encoded_ascii": "^)!^!8^&8^!U^#d^4-^\"b^%k^%t^)C^'U^*W^#J^'D^$s^!<^\"d^#G^'&^2*^(,^&W^&?^*D^$o^\"x ",
      "encoded_base64": "XikhXiE4XiY4XiFVXiNkXjQtXiJiXiVrXiV0XilDXidVXipXXiNKXidEXiRzXiE8XiJkXiNHXicmXjIqXigsXiZXXiY/XipEXiRvXiJ4IA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_ac4e46b75377",
      "text": "狂信徒的蹤影。",
      "encoded_ascii": "^&8^!U^#d^&Z^(b^#a^!\"",
      "encoded_base64": "XiY4XiFVXiNkXiZaXihiXiNhXiEi",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_237c25dd3357",
      "text": "滾開，別靠近我， ",
      "encoded_ascii": "^,z^)F^*A^*H^.C^(l^$%^*A ",
      "encoded_base64": "Xix6XilGXipBXipIXi5DXihsXiQlXipBIA==",
      "byte_length": 25
    },
    {
      "unit_id": "DLG_faeb8abf126b",
      "text": "莽漢！",
      "encoded_ascii": "^;8^4Q^*W",
      "encoded_base64": "Xjs4XjRRXipX",
      "byte_length": 9
    },
    {
      "unit_id": "DLG_27c8ac10353d",
      "text": "潑婦！",
      "encoded_ascii": "^=X^=W^*W",
      "encoded_base64": "Xj1YXj1XXipX",
      "byte_length": 9
    },
    {
      "unit_id": "DLG_1622c24a2d4c",
      "text": " 我寧可留在這裡餓死，也不要跟米奎茲爾的任何追隨者 ",
      "encoded_ascii": " ^$%^3k^\"A^-+^\"d^(s^-j^2R^%L^*A^!1^!)^(C^.+^'4^5B^/D^&/^&Z^!C^!L^(o^)X^'V ",
      "encoded_base64": "IF4kJV4za14iQV4tK14iZF4oc14tal4yUl4lTF4qQV4hMV4hKV4oQ14uK14nNF41Ql4vRF4mL14mWl4hQ14hTF4ob14pWF4nViA=",
      "byte_length": 74
    },
    {
      "unit_id": "DLG_7408008c5c8c",
      "text": "說半句話！",
      "encoded_ascii": "^-x^\"-^2]^-v^*W",
      "encoded_base64": "Xi14XiItXjJdXi12XipX",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_cac20a3b5213",
      "text": "  那你就留在這裡爛掉吧！",
      "encoded_ascii": "  ^)!^*F^*J^-+^\"d^(s^-j^&-^/e^*I^*W",
      "encoded_base64": "ICBeKSFeKkZeKkpeLSteImReKHNeLWpeJi1eL2VeKkleKlc=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_354a48d62936",
      "text": "  對不起。至少讓我替你解開繩子。",
      "encoded_ascii": "  ^#:^!)^.(^!\"^'n^#<^-}^$%^2o^*F^(I^)F^'L^#(^!\"",
      "encoded_base64": "ICBeIzpeISleLiheISJeJ25eIzxeLX1eJCVeMm9eKkZeKEleKUZeJ0xeIyheISI=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_15f1361ee9c7",
      "text": "別把你的髒手碰我！我不需要你的幫忙！",
      "encoded_ascii": "^*H^$1^*F^&Z^0M^$+^-5^$%^*W^$%^!)^)e^(C^*F^&Z^+}^,+^*W",
      "encoded_base64": "XipIXiQxXipGXiZaXjBNXiQrXi01XiQlXipXXiQlXiEpXillXihDXipGXiZaXit9XiwrXipX",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_9bdd98680692",
      "text": "你依然要替她解開繩索嗎？",
      "encoded_ascii": "^*F^!Q^&\"^(C^2o^+h^(I^)F^'L^'>^+X^.V",
      "encoded_base64": "XipGXiFRXiYiXihDXjJvXitoXihJXilGXidMXic+XitYXi5W",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_57b2b81594d0",
      "text": "是",
      "encoded_ascii": "^,X",
      "encoded_base64": "XixY",
      "byte_length": 3
    },
    {
      "unit_id": "DLG_938f28da90cb",
      "text": "酋長之女扭過頭去，拒絕開口。",
      "encoded_ascii": "^=5^)C^!/^#\"^1;^(x^)t^\"6^*A^5Q^-I^)F^\"<^!\"",
      "encoded_base64": "Xj01XilDXiEvXiMiXjE7Xih4Xil0XiI2XipBXjVRXi1JXilGXiI8XiEi",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_c052c72af7e7",
      "text": "你、你這個野蠻人！",
      "encoded_ascii": "^*F^!!^*F^(s^!V^.:^/H^!<^*W",
      "encoded_base64": "XipGXiEhXipGXihzXiFWXi46Xi9IXiE8XipX",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_942b87dc8ca1",
      "text": "所有鼠人都對你們的所作所為感激不盡，而我，更是有充足的理由 ",
      "encoded_ascii": "^$)^$s^*=^!<^)$^#:^*F^*{^&Z^$)^!M^$)^%{^#{^1H^!)^-1^*A^'W^$%^*A^$o^,X^$s^5.^(^^&Z^&A^&I ",
      "encoded_base64": "XiQpXiRzXio9XiE8XikkXiM6XipGXip7XiZaXiQpXiFNXiQpXiV7XiN7XjFIXiEpXi0xXipBXidXXiQlXipBXiRvXixYXiRzXjUuXiheXiZaXiZBXiZJIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_dd37138fbd30",
      "text": "感謝你們。我永遠不會忘記你們的英勇。",
      "encoded_ascii": "^#{^-z^*F^*{^!\"^$%^%W^({^!)^$r^0]^(K^*F^*{^&Z^'y^\"$^!\"",
      "encoded_base64": "XiN7Xi16XipGXip7XiEiXiQlXiVXXih7XiEpXiRyXjBdXihLXipGXip7XiZaXid5XiIkXiEi",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_dff618ea3eef",
      "text": "謝謝你們救了我的命。但當我們的生活方式已被徹底摧毀時，這不過是徒勞的慰藉。 ",
      "encoded_ascii": "^-z^-z^*F^*{^,Q^*D^$%^&Z^\"N^!\"^!I^&N^$%^*{^&Z^&F^%i^$]^#X^#J^(@^18^/^^$E^%N^$f^*A^(s^!)^(x^,X^#d^/R^&Z^4<^04^!\" ",
      "encoded_base64": "Xi16Xi16XipGXip7XixRXipEXiQlXiZaXiJOXiEiXiFJXiZOXiQlXip7XiZaXiZGXiVpXiRdXiNYXiNKXihAXjE4Xi9eXiRFXiVOXiRmXipBXihzXiEpXih4XixYXiNkXi9SXiZaXjQ8XjA0XiEiIA==",
      "byte_length": 112
    },
    {
      "unit_id": "DLG_7cf6f1ffb007",
      "text": "我懷疑你們不會再見到我們了。運氣好的話，我們也許能在下水道更深處 ",
      "encoded_ascii": "^$%^,9^0p^*F^*{^!)^$r^!l^-m^!u^$%^*{^*D^!\"^.4^%U^+i^&Z^-v^*A^$%^*{^!1^-s^'b^\"d^!(^%V^(y^$o^2*^(, ",
      "encoded_base64": "XiQlXiw5XjBwXipGXip7XiEpXiRyXiFsXi1tXiF1XiQlXip7XipEXiEiXi40XiVVXitpXiZaXi12XipBXiQlXip7XiExXi1zXidiXiJkXiEoXiVWXih5XiRvXjIqXigsIA==",
      "byte_length": 97
    },
    {
      "unit_id": "DLG_67b8db9074e2",
      "text": "找到一個安全的棲身之所。",
      "encoded_ascii": "^$/^!u^!%^!V^+p^!h^&Z^,b^(c^!/^$)^!\"",
      "encoded_base64": "XiQvXiF1XiElXiFWXitwXiFoXiZaXixiXihjXiEvXiQpXiEi",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_4e7ef3e96782",
      "text": "求求你們，沒時間閒聊了。狂信徒隨時都會進攻頭骨神廟！",
      "encoded_ascii": "^,n^,n^*F^*{^*A^%\\^$f^)G^6A^-U^*D^!\"^&8^!U^#d^)X^$f^)$^$r^(w^$O^)t^*$^&w^0[^*W",
      "encoded_base64": "XixuXixuXipGXip7XipBXiVcXiRmXilHXjZBXi1VXipEXiEiXiY4XiFVXiNkXilYXiRmXikkXiRyXih3XiRPXil0XiokXiZ3XjBbXipX",
      "byte_length": 78
    },
    {
      "unit_id": "DLG_b7a2110e3a74",
      "text": "出了什麼事嗎？我們必須抓緊時間，才能及時警告我父親襲擊的事。",
      "encoded_ascii": "^!q^*D^!=^.T^*r^+X^.V^$%^*{^#l^)r^$2^0r^$f^)G^*A^$,^'b^\"7^$f^(S^+B^$%^5d^(F^08^$F^&Z^*r^!\"",
      "encoded_base64": "XiFxXipEXiE9Xi5UXipyXitYXi5WXiQlXip7XiNsXilyXiQyXjByXiRmXilHXipBXiQsXidiXiI3XiRmXihTXitCXiQlXjVkXihGXjA4XiRGXiZaXipyXiEi",
      "byte_length": 90
    },
    {
      "unit_id": "DLG_0f92d48216b1",
      "text": "  我想打聽些情報。",
      "encoded_ascii": "  ^$%^,1^$-^-X^!8^,0^+`^!\"",
      "encoded_base64": "ICBeJCVeLDFeJC1eLVheITheLDBeK2BeISI=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_84d67dbb8c7a",
      "text": "  你知道離開下水道的出路嗎？",
      "encoded_ascii": "  ^*F^&h^(y^)`^)F^!(^%V^(y^&Z^!q^(a^+X^.V",
      "encoded_base64": "ICBeKkZeJmheKHleKWBeKUZeISheJVZeKHleJlpeIXFeKGFeK1heLlY=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_5a274ff8e32b",
      "text": "  我只對報酬感興趣。",
      "encoded_ascii": "  ^$%^\"?^#:^+`^7o^#{^-]^.*^!\"",
      "encoded_base64": "ICBeJCVeIj9eIzpeK2BeN29eI3teLV1eLipeISI=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_32d381418e89",
      "text": "  跟我說說長老的事。",
      "encoded_ascii": "  ^.+^$%^-x^-x^)C^'U^&Z^*r^!\"",
      "encoded_base64": "ICBeLiteJCVeLXheLXheKUNeJ1VeJlpeKnJeISI=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_65313e238629",
      "text": "  你先走，不用管我。",
      "encoded_ascii": "  ^*F^!b^.&^*A^!)^&H^-D^$%^!\"",
      "encoded_base64": "ICBeKkZeIWJeLiZeKkFeISleJkheLUReJCVeISI=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_ac699c5ab0e9",
      "text": "  別擋我的路。",
      "encoded_ascii": "  ^*H^$G^$%^&Z^(a^!\"",
      "encoded_base64": "ICBeKkheJEdeJCVeJlpeKGFeISI=",
      "byte_length": 20
    },
    {
      "unit_id": "DLG_aaf595674754",
      "text": "  來吧。你可以跟我一起走。",
      "encoded_ascii": "  ^!O^*I^!\"^*F^\"A^!B^.+^$%^!%^.(^.&^!\"",
      "encoded_base64": "ICBeIU9eKkleISJeKkZeIkFeIUJeLiteJCVeISVeLiheLiZeISI=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_7878f44ac978",
      "text": "我們走吧。",
      "encoded_ascii": "^$%^*{^.&^*I^!\"",
      "encoded_base64": "XiQlXip7Xi4mXipJXiEi",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_0b2a885a5745",
      "text": "救救我！請替我鬆綁。那個瘋子正準備襲擊頭骨神廟。 ",
      "encoded_ascii": "^,Q^,Q^$%^*W^*S^2o^$%^.R^-K^!\"^)!^!V^-/^#(^%H^,x^+\"^08^$F^)t^*$^&w^0[^!\" ",
      "encoded_base64": "XixRXixRXiQlXipXXipTXjJvXiQlXi5SXi1LXiEiXikhXiFWXi0vXiMoXiVIXix4XisiXjA4XiRGXil0XiokXiZ3XjBbXiEiIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_938ddb2a3115",
      "text": "我必須警告我父親！",
      "encoded_ascii": "^$%^#l^)r^(S^+B^$%^5d^(F^*W",
      "encoded_base64": "XiQlXiNsXilyXihTXitCXiQlXjVkXihGXipX",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_0188eafa1f66",
      "text": "  米奎茲爾已經死了。他不會再襲擊任何人了。",
      "encoded_ascii": "  ^'4^5B^/D^&/^#J^'D^%L^*D^!\"^!@^!)^$r^!l^08^$F^!C^!L^!<^*D^!\"",
      "encoded_base64": "ICBeJzReNUJeL0ReJi9eI0peJ0ReJUxeKkReISJeIUBeISleJHJeIWxeMDheJEZeIUNeIUxeITxeKkReISI=",
      "byte_length": 62
    },
    {
      "unit_id": "DLG_5eef358b9ac2",
      "text": "  先跟我說說米奎茲爾的事。",
      "encoded_ascii": "  ^!b^.+^$%^-x^-x^'4^5B^/D^&/^&Z^*r^!\"",
      "encoded_base64": "ICBeIWJeLiteJCVeLXheLXheJzReNUJeL0ReJi9eJlpeKnJeISI=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_3ec4e27e2a39",
      "text": "  我這就替你鬆綁。",
      "encoded_ascii": "  ^$%^(s^*J^2o^*F^.R^-K^!\"",
      "encoded_base64": "ICBeJCVeKHNeKkpeMm9eKkZeLlJeLUteISI=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_4d8660ad062a",
      "text": "我要走了。再會。",
      "encoded_ascii": "^$%^(C^.&^*D^!\"^!l^$r^!\"",
      "encoded_base64": "XiQlXihDXi4mXipEXiEiXiFsXiRyXiEi",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_a89be494eaf0",
      "text": "那無關緊要——不，情況會更糟。他的手下全是狂熱分子！ ",
      "encoded_ascii": "^)!^%}^.>^0r^(C^*n^*n^!)^*A^,0^,q^$r^$o^-E^!\"^!@^&Z^$+^!(^!h^,X^&8^&$^!s^#(^*W ",
      "encoded_base64": "XikhXiV9Xi4+XjByXihDXipuXipuXiEpXipBXiwwXixxXiRyXiRvXi1FXiEiXiFAXiZaXiQrXiEoXiFoXixYXiY4XiYkXiFzXiMoXipXIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_d6ad80d1bfe5",
      "text": "他們一定會想要復仇。求求你！快替我解開繩索。",
      "encoded_ascii": "^!@^*{^!%^#.^$r^,1^(C^#g^1g^!\"^,n^,n^*F^*W^*L^2o^$%^(I^)F^'L^'>^!\"",
      "encoded_base64": "XiFAXip7XiElXiMuXiRyXiwxXihDXiNnXjFnXiEiXixuXixuXipGXipXXipMXjJvXiQlXihJXilGXidMXic+XiEi",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_e11681cd0a58",
      "text": "對不起。我只是不習慣這種冒險，剛才的緊張驚慌 ",
      "encoded_ascii": "^#:^!)^.(^!\"^$%^\"?^,X^!)^3{^$!^(s^'$^/P^*m^*A^+0^$,^&Z^0r^,(^.Q^#} ",
      "encoded_base64": "XiM6XiEpXi4oXiEiXiQlXiI/XixYXiEpXjN7XiQhXihzXickXi9QXiptXipBXiswXiQsXiZaXjByXiwoXi5RXiN9IA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_2ce38a1c6bda",
      "text": "讓我的腦子一片混亂。",
      "encoded_ascii": "^-}^$%^&Z^2@^#(^!%^&1^%n^!3^!\"",
      "encoded_base64": "Xi19XiQlXiZaXjJAXiMoXiElXiYxXiVuXiEzXiEi",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_c9b708a2d52c",
      "text": "他根本是個瘋子！他嘴裡唸叨的全是重獲大權、重新當上特克圖克提特利的 ",
      "encoded_ascii": "^!@^%)^$x^,X^!V^-/^#(^*W^!@^+[^-j^.]^82^&Z^!h^,X^))^&:^\"z^1E^!!^))^$\\^&N^!'^&5^!d^\"b^!d^$A^&5^!t^&Z ",
      "encoded_base64": "XiFAXiUpXiR4XixYXiFWXi0vXiMoXipXXiFAXitbXi1qXi5dXjgyXiZaXiFoXixYXikpXiY6XiJ6XjFFXiEhXikpXiRcXiZOXiEnXiY1XiFkXiJiXiFkXiRBXiY1XiF0XiZaIA==",
      "byte_length": 100
    },
    {
      "unit_id": "DLG_7ba707155a2b",
      "text": "聖堂武士。他打算把鼠人當作自己的私人軍隊。",
      "encoded_ascii": "^'Z^42^%J^+a^!\"^!@^$-^-C^$1^*=^!<^&N^!M^'l^#I^&Z^&~^!<^..^)U^!\"",
      "encoded_base64": "XidaXjQyXiVKXithXiEiXiFAXiQtXi1DXiQxXio9XiE8XiZOXiFNXidsXiNJXiZaXiZ+XiE8Xi4uXilVXiEi",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_203be50fa667",
      "text": "我是高層巢穴酋長的女兒。凡是把我平安送回他身邊的人， ",
      "encoded_ascii": "^$%^,X^*+^#B^#G^'&^=5^)C^&Z^#\"^++^!\"^+-^,X^$1^$%^0Y^+p^./^\"\\^!@^(c^.8^&Z^!<^*A ",
      "encoded_base64": "XiQlXixYXiorXiNCXiNHXicmXj01XilDXiZaXiMiXisrXiEiXistXixYXiQxXiQlXjBZXitwXi4vXiJcXiFAXihjXi44XiZaXiE8XipBIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_6029b4b7087b",
      "text": "都將獲得豐厚的獎賞。",
      "encoded_ascii": "^)$^#7^&:^#e^4!^\"4^&Z^7?^*T^!\"",
      "encoded_base64": "XikkXiM3XiY6XiNlXjQhXiI0XiZaXjc/XipUXiEi",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_d793337aaf41",
      "text": "噢，謝謝你們。我相信我的父親",
      "encoded_ascii": "^+]^*A^-z^-z^*F^*{^!\"^$%^&a^!U^$%^&Z^5d^(F",
      "encoded_base64": "XitdXipBXi16Xi16XipGXip7XiEiXiQlXiZhXiFVXiQlXiZaXjVkXihG",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_b1f0e45fb612",
      "text": "，也就是高層巢穴的酋長，",
      "encoded_ascii": "^*A^!1^*J^,X^*+^#B^#G^'&^&Z^=5^)C^*A",
      "encoded_base64": "XipBXiExXipKXixYXiorXiNCXiNHXicmXiZaXj01XilDXipB",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_51725ec5ef9f",
      "text": " 一定會獎賞你們的勇氣，但我們必須立刻趕去見他。",
      "encoded_ascii": " ^!%^#.^$r^7?^*T^*F^*{^&Z^\"$^%U^*A^!I^$%^*{^#l^)r^0'^.Y^0u^\"6^-m^!@^!\"",
      "encoded_base64": "IF4hJV4jLl4kcl43P14qVF4qRl4qe14mWl4iJF4lVV4qQV4hSV4kJV4qe14jbF4pcl4wJ14uWV4wdV4iNl4tbV4hQF4hIg==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_c9e71917c8b8",
      "text": "出路？難道你們不打算幫我父親保衛頭骨神廟嗎？",
      "encoded_ascii": "^!q^(a^.V^)a^(y^*F^*{^!)^$-^-C^+}^$%^5d^(F^!T^(=^)t^*$^&w^0[^+X^.V",
      "encoded_base64": "XiFxXihhXi5WXilhXih5XipGXip7XiEpXiQtXi1DXit9XiQlXjVkXihGXiFUXig9Xil0XiokXiZ3XjBbXitYXi5W",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_ba99da7377f2",
      "text": "我不知道出路，但我相信頭骨長老肯定知道。 ",
      "encoded_ascii": "^$%^!)^&h^(y^!q^(a^*A^!I^$%^&a^!U^)t^*$^)C^'U^-Z^#.^&h^(y^!\" ",
      "encoded_base64": "XiQlXiEpXiZoXih5XiFxXihhXipBXiFJXiQlXiZhXiFVXil0XiokXilDXidVXi1aXiMuXiZoXih5XiEiIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_5db2b243dc51",
      "text": "如果你們阻止了襲擊，或許就能向他們請教。",
      "encoded_ascii": "^#$^%!^*F^*{^)L^%G^*D^08^$F^*A^$'^-s^*J^'b^+?^!@^*{^*S^,R^!\"",
      "encoded_base64": "XiMkXiUhXipGXip7XilMXiVHXipEXjA4XiRGXipBXiQnXi1zXipKXidiXis/XiFAXip7XipTXixSXiEi",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_96aa7547555a",
      "text": "那你們幹嘛費心思救我？要是不把那些狂信徒消滅，他們會殺了我， ",
      "encoded_ascii": "^)!^*F^*{^,!^+Y^.\"^#k^#q^,Q^$%^.V^(C^,X^!)^$1^)!^!8^&8^!U^#d^%k^%t^*A^!@^*{^$r^%M^*D^$%^*A ",
      "encoded_base64": "XikhXipGXip7XiwhXitZXi4iXiNrXiNxXixRXiQlXi5WXihDXixYXiEpXiQxXikhXiE4XiY4XiFVXiNkXiVrXiV0XipBXiFAXip7XiRyXiVNXipEXiQlXipBIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_aa932423dee3",
      "text": "還會殺光所有其他鼠人。",
      "encoded_ascii": "^.7^$r^%M^!c^$)^$s^!j^!@^*=^!<^!\"",
      "encoded_base64": "Xi43XiRyXiVNXiFjXiQpXiRzXiFqXiFAXio9XiE8XiEi",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_5504b5c88bc8",
      "text": "既然你們這麼希望，我只盼自己別迷路。我以前從來沒有 ",
      "encoded_ascii": "^,U^&\"^*F^*{^(s^.T^+{^,]^*A^$%^\"?^23^'l^#I^*H^(n^(a^!\"^$%^!B^!z^#f^!O^%\\^$s ",
      "encoded_base64": "XixVXiYiXipGXip7XihzXi5UXit7XixdXipBXiQlXiI/XjIzXidsXiNJXipIXihuXihhXiEiXiQlXiFCXiF6XiNmXiFPXiVcXiRzIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_3378555ff37d",
      "text": "獨自一人在下水道走過。",
      "encoded_ascii": "^/z^'l^!%^!<^\"d^!(^%V^(y^.&^(x^!\"",
      "encoded_base64": "Xi96XidsXiElXiE8XiJkXiEoXiVWXih5Xi4mXih4XiEi",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_616bfed1ba6d",
      "text": "噢，謝謝你們。我剛才真的嚇壞了。",
      "encoded_ascii": "^+]^*A^-z^-z^*F^*{^!\"^$%^+0^$,^-2^&Z^\"X^\"v^*D^!\"",
      "encoded_base64": "XitdXipBXi16Xi16XipGXip7XiEiXiQlXiswXiQsXi0yXiZaXiJYXiJ2XipEXiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_cff0133db276",
      "text": "只要我平安回到他身邊，我相信我父親一定會給你們重賞。 ",
      "encoded_ascii": "^\"?^(C^$%^0Y^+p^\"\\^!u^!@^(c^.8^*A^$%^&a^!U^$%^5d^(F^!%^#.^$r^'A^*F^*{^))^*T^!\" ",
      "encoded_base64": "XiI/XihDXiQlXjBZXitwXiJcXiF1XiFAXihjXi44XipBXiQlXiZhXiFVXiQlXjVkXihGXiElXiMuXiRyXidBXipGXip7XikpXipUXiEiIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_2613a52623de",
      "text": "但如果不阻止那些狂信徒，他恐怕就沒命活著 ",
      "encoded_ascii": "^!I^#$^%!^!)^)L^%G^)!^!8^&8^!U^#d^*A^!@^#t^0^^*J^%\\^\"N^%i^-a ",
      "encoded_base64": "XiFJXiMkXiUhXiEpXilMXiVHXikhXiE4XiY4XiFVXiNkXipBXiFAXiN0XjBeXipKXiVcXiJOXiVpXi1hIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_229d79e06bbd",
      "text": "給你們獎賞了。",
      "encoded_ascii": "^'A^*F^*{^7?^*T^*D^!\"",
      "encoded_base64": "XidBXipGXip7Xjc/XipUXipEXiEi",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_c7dfdaee1abd",
      "text": "我不確定自己該不該說。長老是我們最神聖的象徵。 ",
      "encoded_ascii": "^$%^!)^-6^#.^'l^#I^(M^!)^(M^-x^!\"^)C^'U^,X^$%^*{^$q^&w^'Z^&Z^4g^5O^!\" ",
      "encoded_base64": "XiQlXiEpXi02XiMuXidsXiNJXihNXiEpXihNXi14XiEiXilDXidVXixYXiQlXip7XiRxXiZ3XidaXiZaXjRnXjVPXiEiIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_5ab1d31989ba",
      "text": "只有具備資格的英者才獲准與他們交談。",
      "encoded_ascii": "^\"?^$s^!k^+\"^(X^%*^&Z^'y^'V^$,^&:^/Q^'p^!@^*{^0P^0;^!\"",
      "encoded_base64": "XiI/XiRzXiFrXisiXihYXiUqXiZaXid5XidWXiQsXiY6Xi9RXidwXiFAXip7XjBQXjA7XiEi",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_40527ffb6eaf",
      "text": "不，別把我像這樣丟在這裡！求求你，能不能替我鬆綁？我求你了！",
      "encoded_ascii": "^!)^*A^*H^$1^$%^!`^(s^,f^*q^\"d^(s^-j^*W^,n^,n^*F^*A^'b^!)^'b^2o^$%^.R^-K^.V^$%^,n^*F^*D^*W",
      "encoded_base64": "XiEpXipBXipIXiQxXiQlXiFgXihzXixmXipxXiJkXihzXi1qXipXXixuXixuXipGXipBXidiXiEpXidiXjJvXiQlXi5SXi1LXi5WXiQlXixuXipGXipEXipX",
      "byte_length": 90
    },
    {
      "unit_id": "DLG_d1cc8011c5d9",
      "text": "你想打聽什麼情報？",
      "encoded_ascii": "^*F^,1^$-^-X^!=^.T^,0^+`^.V",
      "encoded_base64": "XipGXiwxXiQtXi1YXiE9Xi5UXiwwXitgXi5W",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_1375e8c37bc9",
      "text": "  跟我說說米奎茲爾的事。",
      "encoded_ascii": "  ^.+^$%^-x^-x^'4^5B^/D^&/^&Z^*r^!\"",
      "encoded_base64": "ICBeLiteJCVeLXheLXheJzReNUJeL0ReJi9eJlpeKnJeISI=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_1b1710181377",
      "text": "  米奎茲爾待在下水道多久了？",
      "encoded_ascii": "  ^'4^5B^/D^&/^,*^\"d^!(^%V^(y^\"x^!.^*D^.V",
      "encoded_base64": "ICBeJzReNUJeL0ReJi9eLCpeImReISheJVZeKHleInheIS5eKkReLlY=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_cfbbe946b350",
      "text": "  米奎茲爾當初是蒙受了什麼恥辱？",
      "encoded_ascii": "  ^'4^5B^/D^&/^&N^1\"^,X^-c^\";^*D^!=^.T^3G^3`^.V",
      "encoded_base64": "ICBeJzReNUJeL0ReJi9eJk5eMSJeLFheLWNeIjteKkReIT1eLlReM0deM2BeLlY=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_5ec47bfee467",
      "text": "  這場所謂的襲擊到底是怎麼回事？",
      "encoded_ascii": "  ^(s^\"n^$)^0s^&Z^08^$F^!u^/^^,X^,,^.T^\"\\^*r^.V",
      "encoded_base64": "ICBeKHNeIm5eJCleMHNeJlpeMDheJEZeIXVeL15eLFheLCxeLlReIlxeKnJeLlY=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_0bb47a4db756",
      "text": "  跟我說說米奎茲爾的狂信徒。",
      "encoded_ascii": "  ^.+^$%^-x^-x^'4^5B^/D^&/^&Z^&8^!U^#d^!\"",
      "encoded_base64": "ICBeLiteJCVeLXheLXheJzReNUJeL0ReJi9eJlpeJjheIVVeI2ReISI=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_30de51992da0",
      "text": "  你想離開下水道嗎？",
      "encoded_ascii": "  ^*F^,1^)`^)F^!(^%V^(y^+X^.V",
      "encoded_base64": "ICBeKkZeLDFeKWBeKUZeISheJVZeKHleK1heLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_dd076282e546",
      "text": "  丘爾是怎麼牽扯進這整件事裡的？",
      "encoded_ascii": "  ^5(^&/^,X^,,^.T^5e^.e^(w^(s^$T^.W^*r^-j^&Z^.V",
      "encoded_base64": "ICBeNSheJi9eLFheLCxeLlReNWVeLmVeKHdeKHNeJFReLldeKnJeLWpeJlpeLlY=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_fc0b5c126011",
      "text": "  我想確認你有沒有受傷。",
      "encoded_ascii": "  ^$%^,1^-6^(O^*F^$s^%\\^$s^\";^!^^!\"",
      "encoded_base64": "ICBeJCVeLDFeLTZeKE9eKkZeJHNeJVxeJHNeIjteIV5eISI=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_0841d310833f",
      "text": "  我們現在走吧。",
      "encoded_ascii": "  ^$%^*{^&?^\"d^.&^*I^!\"",
      "encoded_base64": "ICBeJCVeKnteJj9eImReLiZeKkleISI=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_d9ee38d0dabd",
      "text": "米奎茲爾企圖摧毀頭骨神廟並奴役全體鼠人。 ",
      "encoded_ascii": "^'4^5B^/D^&/^4-^\"b^$E^%N^)t^*$^&w^0[^!+^##^17^!h^**^*=^!<^!\" ",
      "encoded_base64": "Xic0XjVCXi9EXiYvXjQtXiJiXiRFXiVOXil0XiokXiZ3XjBbXiErXiMjXjE3XiFoXioqXio9XiE8XiEiIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_2f4df4f3606f",
      "text": "在你們來之前，他就派他們去搜集武器了——噢，我真希望一切還 ",
      "encoded_ascii": "^\"d^*F^*{^!O^!/^!z^*A^!@^*J^.n^!@^*{^\"6^/h^)]^%J^\"V^*D^*n^*n^+]^*A^$%^-2^+{^,]^!%^+.^.7 ",
      "encoded_base64": "XiJkXipGXip7XiFPXiEvXiF6XipBXiFAXipKXi5uXiFAXip7XiI2Xi9oXildXiVKXiJWXipEXipuXipuXitdXipBXiQlXi0yXit7XixdXiElXisuXi43IA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_83448f289c81",
      "text": "來得及！",
      "encoded_ascii": "^!O^#e^\"7^*W",
      "encoded_base64": "XiFPXiNlXiI3XipX",
      "byte_length": 12
    },
    {
      "unit_id": "DLG_596513be966c",
      "text": "起初我們沒把他放在眼裡，因為他看起來那麼可悲。他狼狽落魄、 ",
      "encoded_ascii": "^.(^1\"^$%^*{^%\\^$1^!@^$P^\"d^&d^-j^*A^\"]^%{^!@^*Q^.(^!O^)!^.T^\"A^,.^!\"^!@^21^=Y^-`^.S^!! ",
      "encoded_base64": "Xi4oXjEiXiQlXip7XiVcXiQxXiFAXiRQXiJkXiZkXi1qXipBXiJdXiV7XiFAXipRXi4oXiFPXikhXi5UXiJBXiwuXiEiXiFAXjIxXj1ZXi1gXi5TXiEhIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_da9611b0e7a2",
      "text": "身敗名裂，躲藏了很長一段時間。我們幾乎把他忘了，直到 ",
      "encoded_ascii": "^(c^$R^\"F^8r^*A^0C^-f^*D^*K^)C^!%^.l^$f^)G^!\"^$%^*{^#T^!0^$1^!@^0]^*D^*A^&`^!u ",
      "encoded_base64": "XihjXiRSXiJGXjhyXipBXjBDXi1mXipEXipLXilDXiElXi5sXiRmXilHXiEiXiQlXip7XiNUXiEwXiQxXiFAXjBdXipEXipBXiZgXiF1IA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_20ea18103e16",
      "text": "他開始招募那些狂信徒。",
      "encoded_ascii": "^!@^)F^+k^,D^9S^)!^!8^&8^!U^#d^!\"",
      "encoded_base64": "XiFAXilGXitrXixEXjlTXikhXiE4XiY4XiFVXiNkXiEi",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_fbdb9c4bd495",
      "text": "丘爾就是個惡霸！只要有錢賺，他什麼事都肯替任何人幹，甚至連 ",
      "encoded_ascii": "^5(^&/^*J^,X^!V^#y^33^*W^\"?^(C^$s^.<^7m^*A^!@^!=^.T^*r^)$^-Z^2o^!C^!L^!<^,!^*A^/|^'n^.0 ",
      "encoded_base64": "XjUoXiYvXipKXixYXiFWXiN5XjMzXipXXiI/XihDXiRzXi48XjdtXipBXiFAXiE9Xi5UXipyXikkXi1aXjJvXiFDXiFMXiE8XiwhXipBXi98XiduXi4wIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_9eb6119979d0",
      "text": "城衛軍的差事也接。",
      "encoded_ascii": "^+_^(=^..^&Z^48^*r^!1^$?^!\"",
      "encoded_base64": "XitfXig9Xi4uXiZaXjQ4XipyXiExXiQ/XiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_f0d5973f7240",
      "text": "噢，我不太清楚。好像是因為奴隸暴動被怪罪歸咎之類的。 ",
      "encoded_ascii": "^+]^*A^$%^!)^+f^,u^,c^!\"^+i^!`^,X^\"]^%{^##^)Z^$m^\"%^(@^#s^5x^%K^3=^!/^)w^&Z^!\" ",
      "encoded_base64": "XitdXipBXiQlXiEpXitmXix1XixjXiEiXitpXiFgXixYXiJdXiV7XiMjXilaXiRtXiIlXihAXiNzXjV4XiVLXjM9XiEvXil3XiZaXiEiIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_21665c6948aa",
      "text": "我們能不能快點出發？必須趕快向我父親通報襲擊，好讓他有所防備。",
      "encoded_ascii": "^$%^*{^'b^!)^'b^*L^*;^!q^&W^.V^#l^)r^0u^*L^+?^$%^5d^(F^(t^+`^08^$F^*A^+i^-}^!@^$s^$)^)K^+\"^!\"",
      "encoded_base64": "XiQlXip7XidiXiEpXidiXipMXio7XiFxXiZXXi5WXiNsXilyXjB1XipMXis/XiQlXjVkXihGXih0XitgXjA4XiRGXipBXitpXi19XiFAXiRzXiQpXilLXisiXiEi",
      "byte_length": 93
    },
    {
      "unit_id": "DLG_ec776959b962",
      "text": "很好。",
      "encoded_ascii": "^*K^+i^!\"",
      "encoded_base64": "XipLXitpXiEi",
      "byte_length": 9
    },
    {
      "unit_id": "DLG_330989355f2f",
      "text": "我們還有什麼好說的？",
      "encoded_ascii": "^$%^*{^.7^$s^!=^.T^+i^-x^&Z^.V",
      "encoded_base64": "XiQlXip7Xi43XiRzXiE9Xi5UXitpXi14XiZaXi5W",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_c692a5cd3efc",
      "text": "我很快就會痊癒的。",
      "encoded_ascii": "^$%^*K^*L^*J^$r^--^&V^&Z^!\"",
      "encoded_base64": "XiQlXipLXipMXipKXiRyXi0tXiZWXiZaXiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_5c78533ace24",
      "text": "是的，我沒事。",
      "encoded_ascii": "^,X^&Z^*A^$%^%\\^*r^!\"",
      "encoded_base64": "XixYXiZaXipBXiQlXiVcXipyXiEi",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_ed1cff101725",
      "text": "好了，我要走了。我們不能再站在這裡浪費時間。",
      "encoded_ascii": "^+i^*D^*A^$%^(C^.&^*D^!\"^$%^*{^!)^'b^!l^->^\"d^(s^-j^,r^.\"^$f^)G^!\"",
      "encoded_base64": "XitpXipEXipBXiQlXihDXi4mXipEXiEiXiQlXip7XiEpXidiXiFsXi0+XiJkXihzXi1qXixyXi4iXiRmXilHXiEi",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_1b610b3f33ee",
      "text": "他們是被誤導的鼠人，以為那個瘋子會帶領他們離開下水道， ",
      "encoded_ascii": "^!@^*{^,X^(@^(P^10^&Z^*=^!<^*A^!B^%{^)!^!V^-/^#(^$r^#N^)s^!@^*{^)`^)F^!(^%V^(y^*A ",
      "encoded_base64": "XiFAXip7XixYXihAXihQXjEwXiZaXio9XiE8XipBXiFCXiV7XikhXiFWXi0vXiMoXiRyXiNOXilzXiFAXip7XilgXilGXiEoXiVWXih5XipBIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_0bd747f265c0",
      "text": "過上更好的生活。但只要他們失去利用價值，那個瘋子就會立刻把他們 ",
      "encoded_ascii": "^(x^!'^$o^+i^&Z^&F^%i^!\"^!I^\"?^(C^!@^*{^\"|^\"6^!t^&H^+&^!Z^*A^)!^!V^-/^#(^*J^$r^0'^.Y^$1^!@^*{ ",
      "encoded_base64": "Xih4XiEnXiRvXitpXiZaXiZGXiVpXiEiXiFJXiI/XihDXiFAXip7XiJ8XiI2XiF0XiZIXismXiFaXipBXikhXiFWXi0vXiMoXipKXiRyXjAnXi5ZXiQxXiFAXip7IA==",
      "byte_length": 94
    },
    {
      "unit_id": "DLG_95e95c39c17c",
      "text": "斬盡殺絕。",
      "encoded_ascii": "^9B^-1^%M^-I^!\"",
      "encoded_base64": "XjlCXi0xXiVNXi1JXiEi",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_2da14ed514fd",
      "text": "不。鼠人屬於下水道。這裡的生活雖然貧苦微薄，卻最適合 ",
      "encoded_ascii": "^!)^!\"^*=^!<^#C^$^^!(^%V^(y^!\"^(s^-j^&Z^&F^%i^.A^&\"^;:^.t^#i^6o^*A^1&^$q^(|^\"C ",
      "encoded_base64": "XiEpXiEiXio9XiE8XiNDXiReXiEoXiVWXih5XiEiXihzXi1qXiZaXiZGXiVpXi5BXiYiXjs6Xi50XiNpXjZvXipBXjEmXiRxXih8XiJDIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_55836187a88f",
      "text": "我們。鼠人太過弱小，在地表根本活不了多久。 ",
      "encoded_ascii": "^$%^*{^!\"^*=^!<^+f^(x^#\\^#;^*A^\"d^\"e^-i^%)^$x^%i^!)^*D^\"x^!.^!\" ",
      "encoded_base64": "XiQlXip7XiEiXio9XiE8XitmXih4XiNcXiM7XipBXiJkXiJlXi1pXiUpXiR4XiVpXiEpXipEXiJ4XiEuXiEiIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_bb28e4ff8791",
      "text": "至少在這裡，我們還有機會平靜生活。",
      "encoded_ascii": "^'n^#<^\"d^(s^-j^*A^$%^*{^.7^$s^%>^$r^0Y^)h^&F^%i^!\"",
      "encoded_base64": "XiduXiM8XiJkXihzXi1qXipBXiQlXip7Xi43XiRzXiU+XiRyXjBZXiloXiZGXiVpXiEi",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_2840309f9a85",
      "text": "很好。我們得抓緊時間。",
      "encoded_ascii": "^*K^+i^!\"^$%^*{^#e^$2^0r^$f^)G^!\"",
      "encoded_base64": "XipLXitpXiEiXiQlXip7XiNlXiQyXjByXiRmXilHXiEi",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_66f2f31013b0",
      "text": "你還想談些什麼？",
      "encoded_ascii": "^*F^.7^,1^0;^!8^!=^.T^.V",
      "encoded_base64": "XipGXi43XiwxXjA7XiE4XiE9Xi5UXi5W",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_ab1dded99970",
      "text": "帶上那根骨製曲柄。我們可能會用得上。",
      "encoded_ascii": "^#N^!'^)!^%)^*$^(B^$n^%#^!\"^$%^*{^\"A^'b^$r^&H^#e^!'^!\"",
      "encoded_base64": "XiNOXiEnXikhXiUpXiokXihCXiRuXiUjXiEiXiQlXip7XiJBXidiXiRyXiZIXiNlXiEnXiEi",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_058afb046541",
      "text": "大家人都去哪了？這裡到底發生了什麼事？",
      "encoded_ascii": "^\"z^+s^!<^)$^\"6^+I^*D^.V^(s^-j^!u^/^^&W^&F^*D^!=^.T^*r^.V",
      "encoded_base64": "XiJ6XitzXiE8XikkXiI2XitJXipEXi5WXihzXi1qXiF1Xi9eXiZXXiZGXipEXiE9Xi5UXipyXi5W",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_426a40d06c8f",
      "text": "  我把這裡的蠢老鼠全殺光了！",
      "encoded_ascii": "  ^$%^$1^(s^-j^&Z^.u^'U^*=^!h^%M^!c^*D^*W",
      "encoded_base64": "ICBeJCVeJDFeKHNeLWpeJlpeLnVeJ1VeKj1eIWheJU1eIWNeKkReKlc=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_6f98968dd033",
      "text": "  是丘爾幹的。",
      "encoded_ascii": "  ^,X^5(^&/^,!^&Z^!\"",
      "encoded_base64": "ICBeLFheNSheJi9eLCFeJlpeISI=",
      "byte_length": 20
    },
    {
      "unit_id": "DLG_761fa46e690b",
      "text": "噢！你這個禽獸！",
      "encoded_ascii": "^+]^*W^*F^(s^!V^7C^&<^*W",
      "encoded_base64": "XitdXipXXipGXihzXiFWXjdDXiY8XipX",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_4112570149bf",
      "text": "全殺了？！你怎麼能這樣？這裡曾是我的家……我的家人…… ",
      "encoded_ascii": "^!h^%M^*D^.V^*W^*F^,,^.T^'b^(s^,f^.V^(s^-j^.j^,X^$%^&Z^+s^*o^*o^$%^&Z^+s^!<^*o^*o ",
      "encoded_base64": "XiFoXiVNXipEXi5WXipXXipGXiwsXi5UXidiXihzXixmXi5WXihzXi1qXi5qXixYXiQlXiZaXitzXipvXipvXiQlXiZaXitzXiE8XipvXipvIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_e32a35364eaa",
      "text": "我不相信你！丘爾根本沒有實力襲擊我的家園。是你！ ",
      "encoded_ascii": "^$%^!)^&a^!U^*F^*W^5(^&/^%)^$x^%\\^$s^#3^!~^08^$F^$%^&Z^+s^41^!\"^,X^*F^*W ",
      "encoded_base64": "XiQlXiEpXiZhXiFVXipGXipXXjUoXiYvXiUpXiR4XiVcXiRzXiMzXiF+XjA4XiRGXiQlXiZaXitzXjQxXiEiXixYXipGXipXIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_7037db636f83",
      "text": "是你殺了他們！",
      "encoded_ascii": "^,X^*F^%M^*D^!@^*{^*W",
      "encoded_base64": "XixYXipGXiVNXipEXiFAXip7XipX",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_8be17beda499",
      "text": "狂信徒！你們必須在剩下的狂信徒抵達神廟之前， ",
      "encoded_ascii": "^&8^!U^#d^*W^*F^*{^#l^)r^\"d^8U^!(^&Z^&8^!U^#d^$5^(z^&w^0[^!/^!z^*A ",
      "encoded_base64": "XiY4XiFVXiNkXipXXipGXip7XiNsXilyXiJkXjhVXiEoXiZaXiY4XiFVXiNkXiQ1Xih6XiZ3XjBbXiEvXiF6XipBIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_ef6455e1aaf0",
      "text": "阻止他們！",
      "encoded_ascii": "^)L^%G^!@^*{^*W",
      "encoded_base64": "XilMXiVHXiFAXip7XipX",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_8d3da7d684c3",
      "text": "  好，我這就走。",
      "encoded_ascii": "  ^+i^*A^$%^(s^*J^.&^!\"",
      "encoded_base64": "ICBeK2leKkFeJCVeKHNeKkpeLiZeISI=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_b9fb8a88aeed",
      "text": "站住，別動！ ",
      "encoded_ascii": "^->^*z^*A^*H^\"%^*W ",
      "encoded_base64": "Xi0+Xip6XipBXipIXiIlXipXIA==",
      "byte_length": 19
    },
    {
      "unit_id": "DLG_b6a2ef3a107e",
      "text": "你們是丘爾派來的密探！",
      "encoded_ascii": "^*F^*{^,X^5(^&/^.n^!O^&Z^#0^$>^*W",
      "encoded_base64": "XipGXip7XixYXjUoXiYvXi5uXiFPXiZaXiMwXiQ+XipX",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_42a725a787c5",
      "text": "這裡不歡迎你和你那些低層巢穴的暴徒！",
      "encoded_ascii": "^(s^-j^!)^%F^(k^*F^\"O^*F^)!^!8^!K^#B^#G^'&^&Z^$m^#d^*W",
      "encoded_base64": "XihzXi1qXiEpXiVGXihrXipGXiJPXipGXikhXiE4XiFLXiNCXiNHXicmXiZaXiRtXiNkXipX",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_8241785a9b11",
      "text": "  開門，我們饒你不死！",
      "encoded_ascii": "  ^)F^)D^*A^$%^*{^.M^*F^!)^%L^*W",
      "encoded_base64": "ICBeKUZeKUReKkFeJCVeKnteLk1eKkZeISleJUxeKlc=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_71f2e2099380",
      "text": "  丘爾已經死了。我殺了他。",
      "encoded_ascii": "  ^5(^&/^#J^'D^%L^*D^!\"^$%^%M^*D^!@^!\"",
      "encoded_base64": "ICBeNSheJi9eI0peJ0ReJUxeKkReISJeJCVeJU1eKkReIUBeISI=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_86976e6a2ca2",
      "text": "  丘爾也是我們的敵人！",
      "encoded_ascii": "  ^5(^&/^!1^,X^$%^*{^&Z^$U^!<^*W",
      "encoded_base64": "ICBeNSheJi9eITFeLFheJCVeKnteJlpeJFVeITxeKlc=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_171b539fc4f7",
      "text": "  這全是一場誤會。",
      "encoded_ascii": "  ^(s^!h^,X^!%^\"n^(P^$r^!\"",
      "encoded_base64": "ICBeKHNeIWheLFheISVeIm5eKFBeJHJeISI=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_883b007d0109",
      "text": "  也許我當初站隊站得太倉促了。",
      "encoded_ascii": "  ^!1^-s^$%^&N^1\"^->^)U^->^#e^+f^8T^2T^*D^!\"",
      "encoded_base64": "ICBeITFeLXNeJCVeJk5eMSJeLT5eKVVeLT5eI2VeK2ZeOFReMlReKkReISI=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_4b5eba8e33aa",
      "text": "是酋長的女兒！你們是怎麼把她從米奎茲爾那裡救出來的？ ",
      "encoded_ascii": "^,X^=5^)C^&Z^#\"^++^*W^*F^*{^,X^,,^.T^$1^+h^#f^'4^5B^/D^&/^)!^-j^,Q^!q^!O^&Z^.V ",
      "encoded_base64": "XixYXj01XilDXiZaXiMiXisrXipXXipGXip7XixYXiwsXi5UXiQxXitoXiNmXic0XjVCXi9EXiYvXikhXi1qXixRXiFxXiFPXiZaXi5WIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_3fe1998435fa",
      "text": "不過那不重要了。她平安無事！酋長一定會想要立刻和 ",
      "encoded_ascii": "^!)^(x^)!^!)^))^(C^*D^!\"^+h^0Y^+p^%}^*r^*W^=5^)C^!%^#.^$r^,1^(C^0'^.Y^\"O ",
      "encoded_base64": "XiEpXih4XikhXiEpXikpXihDXipEXiEiXitoXjBZXitwXiV9XipyXipXXj01XilDXiElXiMuXiRyXiwxXihDXjAnXi5ZXiJPIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_dd79a2d89e22",
      "text": "你們面談。 ",
      "encoded_ascii": "^*F^*{^)j^0;^!\" ",
      "encoded_base64": "XipGXip7XilqXjA7XiEiIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_325e1d3c572a",
      "text": "你們是敵是友？快說！",
      "encoded_ascii": "^*F^*{^,X^$U^,X^\"8^.V^*L^-x^*W",
      "encoded_base64": "XipGXip7XixYXiRVXixYXiI4Xi5WXipMXi14XipX",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_98c4b4a760e4",
      "text": "  是朋友。我正在尋找逃離下水道的出路。",
      "encoded_ascii": "  ^,X^,[^\"8^!\"^$%^%H^\"d^#9^$/^(p^)`^!(^%V^(y^&Z^!q^(a^!\"",
      "encoded_base64": "ICBeLFheLFteIjheISJeJCVeJUheImReIzleJC9eKHBeKWBeISheJVZeKHleJlpeIXFeKGFeISI=",
      "byte_length": 56
    },
    {
      "unit_id": "DLG_d5692f9277d1",
      "text": "  開門。我是來見酋長的。",
      "encoded_ascii": "  ^)F^)D^!\"^$%^,X^!O^-m^=5^)C^&Z^!\"",
      "encoded_base64": "ICBeKUZeKUReISJeJCVeLFheIU9eLW1ePTVeKUNeJlpeISI=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_346636f59b0a",
      "text": "  少廢話，快開門！",
      "encoded_ascii": "  ^#<^#W^-v^*A^*L^)F^)D^*W",
      "encoded_base64": "ICBeIzxeI1deLXZeKkFeKkxeKUZeKUReKlc=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_70ba4fb0c458",
      "text": "滾出去，流民，否則我們就把你們大卸八塊！",
      "encoded_ascii": "^,z^!q^\"6^*A^%j^%T^*A^\"H^!x^$%^*{^*J^$1^*F^*{^\"z^<7^50^/Z^*W",
      "encoded_base64": "Xix6XiFxXiI2XipBXiVqXiVUXipBXiJIXiF4XiQlXip7XipKXiQxXipGXip7XiJ6Xjw3XjUwXi9aXipX",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_6e25e2ddec6d",
      "text": "搞錯的人是你們！丘爾是我們最大的死敵，而且 ",
      "encoded_ascii": "^:R^)5^&Z^!<^,X^*F^*{^*W^5(^&/^,X^$%^*{^$q^\"z^&Z^%L^$U^*A^'W^!* ",
      "encoded_base64": "XjpSXik1XiZaXiE8XixYXipGXip7XipXXjUoXiYvXixYXiQlXip7XiRxXiJ6XiZaXiVMXiRVXipBXidXXiEqIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_e8eb4fb5fff4",
      "text": "任何與他勾結的人也一樣！",
      "encoded_ascii": "^!C^!L^'p^!@^7t^'@^&Z^!<^!1^!%^,f^*W",
      "encoded_base64": "XiFDXiFMXidwXiFAXjd0XidAXiZaXiE8XiExXiElXixmXipX",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_4df7457b6840",
      "text": "現在，滾吧！",
      "encoded_ascii": "^&?^\"d^*A^,z^*I^*W",
      "encoded_base64": "XiY/XiJkXipBXix6XipJXipX",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_6d0c22d86f2c",
      "text": "證明給我看！",
      "encoded_ascii": "^-{^$c^'A^$%^*Q^*W",
      "encoded_base64": "Xi17XiRjXidBXiQlXipRXipX",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_d5c15cf43754",
      "text": "巢穴酋長聽到這消息一定會很高興！",
      "encoded_ascii": "^#G^'&^=5^)C^-X^!u^(s^%k^#w^!%^#.^$r^*K^*+^-]^*W",
      "encoded_base64": "XiNHXicmXj01XilDXi1YXiF1XihzXiVrXiN3XiElXiMuXiRyXipLXiorXi1dXipX",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_0b62bb5c5ba5",
      "text": "別自討沒趣再回來了！",
      "encoded_ascii": "^*H^'l^-o^%\\^.*^!l^\"\\^!O^*D^*W",
      "encoded_base64": "XipIXidsXi1vXiVcXi4qXiFsXiJcXiFPXipEXipX",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_b280ae893aae",
      "text": "逃離下水道？酋長也許知道出路，但你們休想見到 ",
      "encoded_ascii": "^(p^)`^!(^%V^(y^.V^=5^)C^!1^-s^&h^(y^!q^(a^*A^!I^*F^*{^!G^,1^-m^!u ",
      "encoded_base64": "XihwXilgXiEoXiVWXih5Xi5WXj01XilDXiExXi1zXiZoXih5XiFxXihhXipBXiFJXipGXip7XiFHXiwxXi1tXiF1IA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_6860a264d2e2",
      "text": "他！誰也別想穿過這道閘門！要不是我恪盡職守， ",
      "encoded_ascii": "^!@^*W^-y^!1^*H^,1^')^(x^(s^(y^)H^)D^*W^(C^!)^,X^$%^49^-1^'\\^#+^*A ",
      "encoded_base64": "XiFAXipXXi15XiExXipIXiwxXicpXih4XihzXih5XilIXilEXipXXihDXiEpXixYXiQlXjQ5Xi0xXidcXiMrXipBIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_b650ef3766cf",
      "text": "城衛軍早就把他殺了。",
      "encoded_ascii": "^+_^(=^..^,V^*J^$1^!@^%M^*D^!\"",
      "encoded_base64": "XitfXig9Xi4uXixWXipKXiQxXiFAXiVNXipEXiEi",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_6f380b3551e8",
      "text": "我看你們就像密探！你們休想通過。",
      "encoded_ascii": "^$%^*Q^*F^*{^*J^!`^#0^$>^*W^*F^*{^!G^,1^(t^(x^!\"",
      "encoded_base64": "XiQlXipRXipGXip7XipKXiFgXiMwXiQ+XipXXipGXip7XiFHXiwxXih0Xih4XiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_cbbe0a23758e",
      "text": "  我會向你們酋長解釋一切的。",
      "encoded_ascii": "  ^$%^$r^+?^*F^*{^=5^)C^(I^0w^!%^+.^&Z^!\"",
      "encoded_base64": "ICBeJCVeJHJeKz9eKkZeKntePTVeKUNeKEleMHdeISVeKy5eJlpeISI=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_bc862d9dc2ee",
      "text": "  我是角鬥士，我的劍隨時受僱。",
      "encoded_ascii": "  ^$%^,X^(H^*,^+a^*A^$%^&Z^!|^)X^$f^\";^=?^!\"",
      "encoded_base64": "ICBeJCVeLFheKEheKixeK2FeKkFeJCVeJlpeIXxeKVheJGZeIjtePT9eISI=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_601eb8d6237a",
      "text": "  城衛軍正想殺我！",
      "encoded_ascii": "  ^+_^(=^..^%H^,1^%M^$%^*W",
      "encoded_base64": "ICBeK19eKD1eLi5eJUheLDFeJU1eJCVeKlc=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_b1992ab5ba54",
      "text": "  我逃出了角鬥坑，正在尋求庇護！",
      "encoded_ascii": "  ^$%^(p^!q^*D^(H^*,^5>^*A^%H^\"d^#9^,n^,\"^(T^*W",
      "encoded_base64": "ICBeJCVeKHBeIXFeKkReKEheKixeNT5eKkFeJUheImReIzleLG5eLCJeKFReKlc=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_5a1b59560495",
      "text": "  敵人的敵人就是朋友。",
      "encoded_ascii": "  ^$U^!<^&Z^$U^!<^*J^,X^,[^\"8^!\"",
      "encoded_base64": "ICBeJFVeITxeJlpeJFVeITxeKkpeLFheLFteIjheISI=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_7c177b279fad",
      "text": "  我有只能透露給你們酋長的機密情報。",
      "encoded_ascii": "  ^$%^$s^\"?^'b^(q^.B^'A^*F^*{^=5^)C^&Z^%>^#0^,0^+`^!\"",
      "encoded_base64": "ICBeJCVeJHNeIj9eJ2JeKHFeLkJeJ0FeKkZeKntePTVeKUNeJlpeJT5eIzBeLDBeK2BeISI=",
      "byte_length": 53
    },
    {
      "unit_id": "DLG_46d52bc1bbdf",
      "text": "  打開這道閘門，否則我宰了你！",
      "encoded_ascii": "  ^$-^)F^(s^(y^)H^)D^*A^\"H^!x^$%^1w^*D^*F^*W",
      "encoded_base64": "ICBeJC1eKUZeKHNeKHleKUheKUReKkFeIkheIXheJCVeMXdeKkReKkZeKlc=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_e19c8da9faac",
      "text": "你們休想通過。我的誓職就是保護酋長。",
      "encoded_ascii": "^*F^*{^!G^,1^(t^(x^!\"^$%^&Z^-w^'\\^*J^,X^!T^(T^=5^)C^!\"",
      "encoded_base64": "XipGXip7XiFHXiwxXih0Xih4XiEiXiQlXiZaXi13XidcXipKXixYXiFUXihUXj01XilDXiEi",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_9b00294d116c",
      "text": "城衛軍想殺光所有人！這能讓你有什麼特別的？",
      "encoded_ascii": "^+_^(=^..^,1^%M^!c^$)^$s^!<^*W^(s^'b^-}^*F^$s^!=^.T^&5^*H^&Z^.V",
      "encoded_base64": "XitfXig9Xi4uXiwxXiVNXiFjXiQpXiRzXiE8XipXXihzXidiXi19XipGXiRzXiE9Xi5UXiY1XipIXiZaXi5W",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_6dc67587cfcd",
      "text": "你說起話來就像個密探！",
      "encoded_ascii": "^*F^-x^.(^-v^!O^*J^!`^!V^#0^$>^*W",
      "encoded_base64": "XipGXi14Xi4oXi12XiFPXipKXiFgXiFWXiMwXiQ+XipX",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_6112b169fa35",
      "text": "滾開！",
      "encoded_ascii": "^,z^)F^*W",
      "encoded_base64": "Xix6XilGXipX",
      "byte_length": 9
    },
    {
      "unit_id": "DLG_67cc26658d3b",
      "text": "角鬥士？那情況就不一樣了。酋長會想和你們談談。 ",
      "encoded_ascii": "^(H^*,^+a^.V^)!^,0^,q^*J^!)^!%^,f^*D^!\"^=5^)C^$r^,1^\"O^*F^*{^0;^0;^!\" ",
      "encoded_base64": "XihIXiosXithXi5WXikhXiwwXixxXipKXiEpXiElXixmXipEXiEiXj01XilDXiRyXiwxXiJPXipGXip7XjA7XjA7XiEiIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_880722957b7e",
      "text": "等一下，我這就開門。",
      "encoded_ascii": "^'-^!%^!(^*A^$%^(s^*J^)F^)D^!\"",
      "encoded_base64": "XictXiElXiEoXipBXiQlXihzXipKXilGXilEXiEi",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_adc8ba065beb",
      "text": " 但如果你們敢起半點傷害酋長的念頭，那將是你們最後的念頭！",
      "encoded_ascii": " ^!I^#$^%!^*F^*{^/m^.(^\"-^*;^!^^#/^=5^)C^&Z^1z^)t^*A^)!^#7^,X^*F^*{^$q^#b^&Z^1z^)t^*W",
      "encoded_base64": "IF4hSV4jJF4lIV4qRl4qe14vbV4uKF4iLV4qO14hXl4jL149NV4pQ14mWl4xel4pdF4qQV4pIV4jN14sWF4qRl4qe14kcV4jYl4mWl4xel4pdF4qVw==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_56090c6de6e9",
      "text": "住手，別打了，你們這些無知的蠢物！",
      "encoded_ascii": "^*z^$+^*A^*H^$-^*D^*A^*F^*{^(s^!8^%}^&h^&Z^.u^&4^*W",
      "encoded_base64": "Xip6XiQrXipBXipIXiQtXipEXipBXipGXip7XihzXiE4XiV9XiZoXiZaXi51XiY0XipX",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_98610f5d5ab6",
      "text": "請恕我失禮。這些下人連老鼠的腦子都沒有。",
      "encoded_ascii": "^*S^3q^$%^\"|^-8^!\"^(s^!8^!(^!<^.0^'U^*=^&Z^2@^#(^)$^%\\^$s^!\"",
      "encoded_base64": "XipTXjNxXiQlXiJ8Xi04XiEiXihzXiE4XiEoXiE8Xi4wXidVXio9XiZaXjJAXiMoXikkXiVcXiRzXiEi",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_843e93cb6f04",
      "text": "終於有地表居民前來尋求我的指引了。",
      "encoded_ascii": "^-H^$^^$s^\"e^-i^+w^%T^!z^!O^#9^,n^$%^&Z^$8^#Z^*D^!\"",
      "encoded_base64": "Xi1IXiReXiRzXiJlXi1pXit3XiVUXiF6XiFPXiM5XixuXiQlXiZaXiQ4XiNaXipEXiEi",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_c99be9531cb8",
      "text": " 我是米奎茲爾，侍奉特克圖克特雷的高階聖堂武士。我將 ",
      "encoded_ascii": " ^$%^,X^'4^5B^/D^&/^*A^0}^1+^&5^!d^\"b^!d^&5^)c^&Z^*+^=b^'Z^42^%J^+a^!\"^$%^#7 ",
      "encoded_base64": "IF4kJV4sWF4nNF41Ql4vRF4mL14qQV4wfV4xK14mNV4hZF4iYl4hZF4mNV4pY14mWl4qK149Yl4nWl40Ml4lSl4rYV4hIl4kJV4jNyA=",
      "byte_length": 77
    },
    {
      "unit_id": "DLG_4403b2b9b67c",
      "text": "他的旨意傳達給這些蒙昧的造物。",
      "encoded_ascii": "^!@^&Z^<(^#z^+$^(z^'A^(s^!8^-c^4D^&Z^(v^&4^!\"",
      "encoded_base64": "XiFAXiZaXjwoXiN6XiskXih6XidBXihzXiE4Xi1jXjREXiZaXih2XiY0XiEi",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_af3c681a9a27",
      "text": "  我也同樣崇敬偉大的特克圖克特雷。",
      "encoded_ascii": "  ^$%^!1^\"E^,f^13^*O^*}^\"z^&Z^&5^!d^\"b^!d^&5^)c^!\"",
      "encoded_base64": "ICBeJCVeITFeIkVeLGZeMTNeKk9eKn1eInpeJlpeJjVeIWReImJeIWReJjVeKWNeISI=",
      "byte_length": 50
    },
    {
      "unit_id": "DLG_1a0fe8791672",
      "text": "  我在尋找高層巢穴酋長的女兒。",
      "encoded_ascii": "  ^$%^\"d^#9^$/^*+^#B^#G^'&^=5^)C^&Z^#\"^++^!\"",
      "encoded_base64": "ICBeJCVeImReIzleJC9eKiteI0JeI0deJyZePTVeKUNeJlpeIyJeKyteISI=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_2987e18e817f",
      "text": "  把那個女孩放了！",
      "encoded_ascii": "  ^$1^)!^!V^#\"^+m^$P^*D^*W",
      "encoded_base64": "ICBeJDFeKSFeIVZeIyJeK21eJFBeKkReKlc=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_ecb6df479fd3",
      "text": "  很好，繼續進行獻祭吧。",
      "encoded_ascii": "  ^*K^+i^*A^-O^'M^(w^(;^-(^&x^*I^!\"",
      "encoded_base64": "ICBeKkteK2leKkFeLU9eJ01eKHdeKDteLSheJnheKkleISI=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_2ccedc2d1a24",
      "text": "  你跟這些生物在這裡做什麼？",
      "encoded_ascii": "  ^*F^.+^(s^!8^&F^&4^\"d^(s^-j^*~^!=^.T^.V",
      "encoded_base64": "ICBeKkZeLiteKHNeITheJkZeJjReImReKHNeLWpeKn5eIT1eLlReLlY=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_30d461b8e9f0",
      "text": "  特克圖克特雷是坎克巨蟻生的雜種！",
      "encoded_ascii": "  ^&5^!d^\"b^!d^&5^)c^,X^/%^!d^#H^=a^&F^&Z^0G^'$^*W",
      "encoded_base64": "ICBeJjVeIWReImJeIWReJjVeKWNeLFheLyVeIWReI0hePWFeJkZeJlpeMEdeJyReKlc=",
      "byte_length": 50
    },
    {
      "unit_id": "DLG_130f8634b966",
      "text": "那個女孩？必須讓她的鮮血流淌，才能迎來特克圖克特雷的賜福。 ",
      "encoded_ascii": "^)!^!V^#\"^+m^.V^#l^)r^-}^+h^&Z^35^(:^%j^9]^*A^$,^'b^(k^!O^&5^!d^\"b^!d^&5^)c^&Z^.#^&z^!\" ",
      "encoded_base64": "XikhXiFWXiMiXittXi5WXiNsXilyXi19XitoXiZaXjM1Xig6XiVqXjldXipBXiQsXidiXihrXiFPXiY1XiFkXiJiXiFkXiY1XiljXiZaXi4jXiZ6XiEiIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_6c43882411b5",
      "text": "她的死將加速這座迷宮的淨化。很快地，這裡將只剩下真正的 ",
      "encoded_ascii": "^+h^&Z^%L^#7^\"\"^(u^(s^/_^(n^/\\^&Z^0k^\")^!\"^*K^*L^\"e^*A^(s^-j^#7^\"?^8U^!(^-2^%H^&Z ",
      "encoded_base64": "XitoXiZaXiVMXiM3XiIiXih1XihzXi9fXihuXi9cXiZaXjBrXiIpXiEiXipLXipMXiJlXipBXihzXi1qXiM3XiI/XjhVXiEoXi0yXiVIXiZaIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_8e260b414175",
      "text": "信徒。而我也將光榮地重返地表。",
      "encoded_ascii": "^!U^#d^!\"^'W^$%^!1^#7^!c^,e^\"e^))^7J^\"e^-i^!\"",
      "encoded_base64": "XiFVXiNkXiEiXidXXiQlXiExXiM3XiFjXixlXiJlXikpXjdKXiJlXi1pXiEi",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_fc636eb70f2c",
      "text": "你願意代替她躺上獻祭的祭壇嗎？",
      "encoded_ascii": "^*F^.H^#z^*v^2o^+h^.-^!'^-(^&x^&Z^&x^*]^+X^.V",
      "encoded_base64": "XipGXi5IXiN6Xip2XjJvXitoXi4tXiEnXi0oXiZ4XiZaXiZ4XipdXitYXi5W",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_ffa2aaa1d8ef",
      "text": "你對特克圖克特雷的虔誠實在令人欽佩！ ",
      "encoded_ascii": "^*F^#:^&5^!d^\"b^!d^&5^)c^&Z^=`^2E^#3^\"d^*w^!<^<@^.}^*W ",
      "encoded_base64": "XipGXiM6XiY1XiFkXiJiXiFkXiY1XiljXiZaXj1gXjJFXiMzXiJkXip3XiE8XjxAXi59XipXIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_d8cbc96f830a",
      "text": "你將榮耀赴死，並為更崇高的使命獲得重生。",
      "encoded_ascii": "^*F^#7^,e^7D^.'^%L^*A^!+^%{^$o^13^*+^&Z^!N^\"N^&:^#e^))^&F^!\"",
      "encoded_base64": "XipGXiM3XixlXjdEXi4nXiVMXipBXiErXiV7XiRvXjEzXiorXiZaXiFOXiJOXiY6XiNlXikpXiZGXiEi",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_6dd7741cf735",
      "text": "噢，偉大且全能的特克圖克特雷，生命之父兼 ",
      "encoded_ascii": "^+]^*A^*}^\"z^!*^!h^'b^&Z^&5^!d^\"b^!d^&5^)c^*A^&F^\"N^!/^5d^<4 ",
      "encoded_base64": "XitdXipBXip9XiJ6XiEqXiFoXidiXiZaXiY1XiFkXiJiXiFkXiY1XiljXipBXiZGXiJOXiEvXjVkXjw0IA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_1472e149cd50",
      "text": "雙月之主！請接納我奉獻於您祭壇上的這份祭品！ ",
      "encoded_ascii": "^)_^/p^!/^!-^*W^*S^$?^';^$%^1+^-(^$^^4:^&x^*]^!'^&Z^(s^*x^&x^\"R^*W ",
      "encoded_base64": "XilfXi9wXiEvXiEtXipXXipTXiQ/Xic7XiQlXjErXi0oXiReXjQ6XiZ4XipdXiEnXiZaXihzXip4XiZ4XiJSXipXIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_9bf2e51301b6",
      "text": "願您的榮耀永無止境！",
      "encoded_ascii": "^.H^4:^&Z^,e^7D^%W^%}^%G^\"q^*W",
      "encoded_base64": "Xi5IXjQ6XiZaXixlXjdEXiVXXiV9XiVHXiJxXipX",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_d3713c478d03",
      "text": "當然不是，特克圖克特雷不需要活著更能為他效力的人充當祭品。 ",
      "encoded_ascii": "^&N^&\"^!)^,X^*A^&5^!d^\"b^!d^&5^)c^!)^)e^(C^%i^-a^$o^'b^%{^!@^$Q^!~^&Z^!<^5.^&N^&x^\"R^!\" ",
      "encoded_base64": "XiZOXiYiXiEpXixYXipBXiY1XiFkXiJiXiFkXiY1XiljXiEpXillXihDXiVpXi1hXiRvXidiXiV7XiFAXiRRXiF+XiZaXiE8XjUuXiZOXiZ4XiJSXiEiIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_5feafa33cac7",
      "text": "你願意加入我的行列，一同效忠於這位 ",
      "encoded_ascii": "^*F^.H^#z^\"\"^!f^$%^&Z^(;^8f^*A^!%^\"E^$Q^.d^$^^(s^!J ",
      "encoded_base64": "XipGXi5IXiN6XiIiXiFmXiQlXiZaXig7XjhmXipBXiElXiJFXiRRXi5kXiReXihzXiFKIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_59331975e804",
      "text": "巫王嗎？",
      "encoded_ascii": "^14^-)^+X^.V",
      "encoded_base64": "XjE0Xi0pXitYXi5W",
      "byte_length": 12
    },
    {
      "unit_id": "DLG_f9dd7fc72e97",
      "text": "除了我的信徒以外，這些生物崇拜的是頭骨，而不是我們的 ",
      "encoded_ascii": "^)Q^*D^$%^&Z^!U^#d^!B^\"w^*A^(s^!8^&F^&4^13^,E^&Z^,X^)t^*$^*A^'W^!)^,X^$%^*{^&Z ",
      "encoded_base64": "XilRXipEXiQlXiZaXiFVXiNkXiFCXiJ3XipBXihzXiE4XiZGXiY0XjEzXixFXiZaXixYXil0XiokXipBXidXXiEpXixYXiQlXip7XiZaIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_21d4f2d752f6",
      "text": "巫王。屠滅他們將讓我重獲國王的青睞。你們 ",
      "encoded_ascii": "^14^-)^!\"^#A^%t^!@^*{^#7^-}^$%^))^&:^+^^-)^&Z^2Q^=]^!\"^*F^*{ ",
      "encoded_base64": "XjE0Xi0pXiEiXiNBXiV0XiFAXip7XiM3Xi19XiQlXikpXiY6XiteXi0pXiZaXjJRXj1dXiEiXipGXip7IA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_a261083dded6",
      "text": "來得正是時候，剛好能親眼見證這名高層巢穴女孩的獻祭。",
      "encoded_ascii": "^!O^#e^%H^,X^$f^*|^*A^+0^+i^'b^(F^&d^-m^-{^(s^\"F^*+^#B^#G^'&^#\"^+m^&Z^-(^&x^!\"",
      "encoded_base64": "XiFPXiNlXiVIXixYXiRmXip8XipBXiswXitpXidiXihGXiZkXi1tXi17XihzXiJGXiorXiNCXiNHXicmXiMiXittXiZaXi0oXiZ4XiEi",
      "byte_length": 78
    },
    {
      "unit_id": "DLG_e19fb4ad96a5",
      "text": "什麼？在她開口求死之前？她必須心甘情願地走上祭壇， ",
      "encoded_ascii": "^!=^.T^.V^\"d^+h^)F^\"<^,n^%L^!/^!z^.V^+h^#l^)r^#k^/:^,0^.H^\"e^.&^!'^&x^*]^*A ",
      "encoded_base64": "XiE9Xi5UXi5WXiJkXitoXilGXiI8XixuXiVMXiEvXiF6Xi5WXitoXiNsXilyXiNrXi86XiwwXi5IXiJlXi4mXiEnXiZ4XipdXipBIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_e5d64b458797",
      "text": "而她所受的折磨還遠遠不夠！難道你們是想來動搖 ",
      "encoded_ascii": "^'W^+h^$)^\";^&Z^,?^-7^.7^({^({^!)^+d^*W^)a^(y^*F^*{^,X^,1^!O^\"%^3J ",
      "encoded_base64": "XidXXitoXiQpXiI7XiZaXiw/Xi03Xi43Xih7Xih7XiEpXitkXipXXilhXih5XipGXip7XixYXiwxXiFPXiIlXjNKIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_28bea837d6b8",
      "text": "我在特克圖克特雷心中的地位嗎？",
      "encoded_ascii": "^$%^\"d^&5^!d^\"b^!d^&5^)c^#k^!,^&Z^\"e^!J^+X^.V",
      "encoded_base64": "XiQlXiJkXiY1XiFkXiJiXiFkXiY1XiljXiNrXiEsXiZaXiJlXiFKXitYXi5W",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_930eebadffb7",
      "text": "太好了！期待已久的這一天終於到了。我們將聯手用烈火與利刃 ",
      "encoded_ascii": "^+f^+i^*D^*W^$u^,*^#J^!.^&Z^(s^!%^+e^-H^$^^!u^*D^!\"^$%^*{^#7^-V^$+^&H^%|^%x^'p^!t^!r ",
      "encoded_base64": "XitmXitpXipEXipXXiR1XiwqXiNKXiEuXiZaXihzXiElXitlXi1IXiReXiF1XipEXiEiXiQlXip7XiM3Xi1WXiQrXiZIXiV8XiV4XidwXiF0XiFyIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_2d67c190154d",
      "text": "橫掃下水道。一切都將為了特克圖克特雷的榮耀而被淨化， ",
      "encoded_ascii": "^/2^:p^!(^%V^(y^!\"^!%^+.^)$^#7^%{^*D^&5^!d^\"b^!d^&5^)c^&Z^,e^7D^'W^(@^0k^\")^*A ",
      "encoded_base64": "Xi8yXjpwXiEoXiVWXih5XiEiXiElXisuXikkXiM3XiV7XipEXiY1XiFkXiJiXiFkXiY1XiljXiZaXixlXjdEXidXXihAXjBrXiIpXipBIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_0ded9a3a3467",
      "text": "而那個酋長家的鼠女將會第一個受死！",
      "encoded_ascii": "^'W^)!^!V^=5^)C^+s^&Z^*=^#\"^#7^$r^',^!%^!V^\";^%L^*W",
      "encoded_base64": "XidXXikhXiFWXj01XilDXitzXiZaXio9XiMiXiM3XiRyXicsXiElXiFWXiI7XiVMXipX",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_d26338ce2c2c",
      "text": "  偉大的米奎茲爾，我已經把那些不信者全宰了！",
      "encoded_ascii": "  ^*}^\"z^&Z^'4^5B^/D^&/^*A^$%^#J^'D^$1^)!^!8^!)^!U^'V^!h^1w^*D^*W",
      "encoded_base64": "ICBeKn1eInpeJlpeJzReNUJeL0ReJi9eKkFeJCVeI0peJ0ReJDFeKSFeITheISleIVVeJ1ZeIWheMXdeKkReKlc=",
      "byte_length": 65
    },
    {
      "unit_id": "DLG_165ad17500e4",
      "text": "  你想要我做些什麼？",
      "encoded_ascii": "  ^*F^,1^(C^$%^*~^!8^!=^.T^.V",
      "encoded_base64": "ICBeKkZeLDFeKENeJCVeKn5eITheIT1eLlReLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_0ba6bb4446cd",
      "text": "  那個女孩對你有什麼用處？",
      "encoded_ascii": "  ^)!^!V^#\"^+m^#:^*F^$s^!=^.T^&H^(,^.V",
      "encoded_base64": "ICBeKSFeIVZeIyJeK21eIzpeKkZeJHNeIT1eLlReJkheKCxeLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_3888bd158020",
      "text": "  你為什麼想要消滅鼠人？",
      "encoded_ascii": "  ^*F^%{^!=^.T^,1^(C^%k^%t^*=^!<^.V",
      "encoded_base64": "ICBeKkZeJXteIT1eLlReLDFeKENeJWteJXReKj1eITxeLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_e5f8cecb01bf",
      "text": "  難道沒有任何辦法能避免這場血腥屠殺嗎？",
      "encoded_ascii": "  ^)a^(y^%\\^$s^!C^!L^2L^%b^'b^0F^!e^(s^\"n^(:^=_^#A^%M^+X^.V",
      "encoded_base64": "ICBeKWFeKHleJVxeJHNeIUNeIUxeMkxeJWJeJ2JeMEZeIWVeKHNeIm5eKDpePV9eI0FeJU1eK1heLlY=",
      "byte_length": 59
    },
    {
      "unit_id": "DLG_7e748e317408",
      "text": "  我拒絕參與你這邪惡的陰謀。",
      "encoded_ascii": "  ^$%^5Q^-I^6K^'p^*F^(s^)\"^#y^&Z^6B^3~^!\"",
      "encoded_base64": "ICBeJCVeNVFeLUleNkteJ3BeKkZeKHNeKSJeI3leJlpeNkJeM35eISI=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_e907ebf063aa",
      "text": "  我這就立刻前去展開淨化！",
      "encoded_ascii": "  ^$%^(s^*J^0'^.Y^!z^\"6^+x^)F^0k^\")^*W",
      "encoded_base64": "ICBeJCVeKHNeKkpeMCdeLlleIXpeIjZeK3heKUZeMGteIileKlc=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_f06016db13fb",
      "text": "  我聽憑您的差遣。",
      "encoded_ascii": "  ^$%^-X^,5^4:^&Z^48^4k^!\"",
      "encoded_base64": "ICBeJCVeLVheLDVeNDpeJlpeNDheNGteISI=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_f02bc0c8d15a",
      "text": "褻瀆者！你們的鮮血將染紅這座祭壇！祈禱這足以 ",
      "encoded_ascii": "^-k^,~^'V^*W^*F^*{^&Z^35^(:^#7^%%^3!^(s^/_^&x^*]^*W^&u^&|^(s^(^^!B ",
      "encoded_base64": "Xi1rXix+XidWXipXXipGXip7XiZaXjM1Xig6XiM3XiUlXjMhXihzXi9fXiZ4XipdXipXXiZ1XiZ8XihzXiheXiFCIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_39a2a8cec070",
      "text": "平息偉大且全能的特克圖克特雷之怒吧！",
      "encoded_ascii": "^0Y^#w^*}^\"z^!*^!h^'b^&Z^&5^!d^\"b^!d^&5^)c^!/^#o^*I^*W",
      "encoded_base64": "XjBZXiN3Xip9XiJ6XiEqXiFoXidiXiZaXiY1XiFkXiJiXiFkXiY1XiljXiEvXiNvXipJXipX",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_7de8ec3943c1",
      "text": "什麼？！那份榮耀本該由我自己獨享！你將為你的狂妄付出代價！",
      "encoded_ascii": "^!=^.T^.V^*W^)!^*x^,e^7D^$x^(M^&I^$%^'l^#I^/z^!;^*W^*F^#7^%{^*F^&Z^&8^+j^*u^!q^*v^+&^*W",
      "encoded_base64": "XiE9Xi5UXi5WXipXXikhXip4XixlXjdEXiR4XihNXiZJXiQlXidsXiNJXi96XiE7XipXXipGXiM3XiV7XipGXiZaXiY4XitqXip1XiFxXip2XismXipX",
      "byte_length": 87
    },
    {
      "unit_id": "DLG_cae9db20376a",
      "text": "很快地，我們就會讓下水道徹底剷除那座可憎的頭骨神廟，它侮辱了 ",
      "encoded_ascii": "^*K^*L^\"e^*A^$%^*{^*J^$r^-}^!(^%V^(y^18^/^^2Y^)Q^)!^/_^\"A^9m^&Z^)t^*$^&w^0[^*A^+o^9+^3`^*D ",
      "encoded_base64": "XipLXipMXiJlXipBXiQlXip7XipKXiRyXi19XiEoXiVWXih5XjE4Xi9eXjJZXilRXikhXi9fXiJBXjltXiZaXil0XiokXiZ3XjBbXipBXitvXjkrXjNgXipEIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_c1ef8b738c80",
      "text": "特克圖克特雷的榮耀！我會利用高層巢穴酋長的女兒， ",
      "encoded_ascii": "^&5^!d^\"b^!d^&5^)c^&Z^,e^7D^*W^$%^$r^!t^&H^*+^#B^#G^'&^=5^)C^&Z^#\"^++^*A ",
      "encoded_base64": "XiY1XiFkXiJiXiFkXiY1XiljXiZaXixlXjdEXipXXiQlXiRyXiF0XiZIXiorXiNCXiNHXicmXj01XilDXiZaXiMiXisrXipBIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_067489a8f6f7",
      "text": "來阻止那些不信者的鼠人插手干預。",
      "encoded_ascii": "^!O^)L^%G^)!^!8^!)^!U^'V^&Z^*=^!<^4{^$+^#R^.E^!\"",
      "encoded_base64": "XiFPXilMXiVHXikhXiE4XiEpXiFVXidWXiZaXio9XiE8XjR7XiQrXiNSXi5FXiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_18c6294a2207",
      "text": "我這一切都是為了特克圖克特雷！除非鮮血將這些地道中的褻瀆者洗滌殆盡， ",
      "encoded_ascii": "^$%^(s^!%^+.^)$^,X^%{^*D^&5^!d^\"b^!d^&5^)c^*W^)Q^)i^35^(:^#7^(s^!8^\"e^(y^!,^&Z^-k^,~^'V^0j^0n^8H^-1^*A ",
      "encoded_base64": "XiQlXihzXiElXisuXikkXixYXiV7XipEXiY1XiFkXiJiXiFkXiY1XiljXipXXilRXilpXjM1Xig6XiM3XihzXiE4XiJlXih5XiEsXiZaXi1rXix+XidWXjBqXjBuXjhIXi0xXipBIA==",
      "byte_length": 103
    },
    {
      "unit_id": "DLG_a5a5560351e4",
      "text": "否則我無法重獲他的青睞。在成為國王身邊的大紅人、 ",
      "encoded_ascii": "^\"H^!x^$%^%}^%b^))^&:^!@^&Z^2Q^=]^!\"^\"d^$$^%{^+^^-)^(c^.8^&Z^\"z^3!^!<^!! ",
      "encoded_base64": "XiJIXiF4XiQlXiV9XiViXikpXiY6XiFAXiZaXjJRXj1dXiEiXiJkXiQkXiV7XiteXi0pXihjXi44XiZaXiJ6XjMhXiE8XiEhIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_e9074ba7f5ff",
      "text": "看著誣告我的人在我面前痛苦蠕動之前，我是絕不會罷手的。",
      "encoded_ascii": "^*Q^-a^6*^+B^$%^&Z^!<^\"d^$%^)j^!z^-.^.t^07^\"%^!/^!z^*A^$%^,X^-I^!)^$r^1Q^$+^&Z^!\"",
      "encoded_base64": "XipRXi1hXjYqXitCXiQlXiZaXiE8XiJkXiQlXilqXiF6Xi0uXi50XjA3XiIlXiEvXiF6XipBXiQlXixYXi1JXiEpXiRyXjFRXiQrXiZaXiEi",
      "byte_length": 81
    },
    {
      "unit_id": "DLG_300146aca806",
      "text": "你們將率領我的鼠人在這場偉大的淨化中衝鋒。那些 ",
      "encoded_ascii": "^*F^*{^#7^22^)s^$%^&Z^*=^!<^\"d^(s^\"n^*}^\"z^&Z^0k^\")^!,^-h^6?^!\"^)!^!8 ",
      "encoded_base64": "XipGXip7XiM3XjIyXilzXiQlXiZaXio9XiE8XiJkXihzXiJuXip9XiJ6XiZaXjBrXiIpXiEsXi1oXjY/XiEiXikhXiE4IA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_8feb799fdfa8",
      "text": "誣告我的人將被屠戮殆盡，而我也將無可匹敵地從這片深處 ",
      "encoded_ascii": "^6*^+B^$%^&Z^!<^#7^(@^#A^,:^8H^-1^*A^'W^$%^!1^#7^%}^\"A^8w^$U^\"e^#f^(s^&1^2*^(, ",
      "encoded_base64": "XjYqXitCXiQlXiZaXiE8XiM3XihAXiNBXiw6XjhIXi0xXipBXidXXiQlXiExXiM3XiV9XiJBXjh3XiRVXiJlXiNmXihzXiYxXjIqXigsIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_80f752a9e73c",
      "text": "重見天日！作為我的奴隸，你們也將共享我的勝利榮耀！",
      "encoded_ascii": "^))^-m^+e^$a^*W^!M^%{^$%^&Z^##^)Z^*A^*F^*{^!1^#7^3d^!;^$%^&Z^+5^!t^,e^7D^*W",
      "encoded_base64": "XikpXi1tXitlXiRhXipXXiFNXiV7XiQlXiZaXiMjXilaXipBXipGXip7XiExXiM3XjNkXiE7XiQlXiZaXis1XiF0XixlXjdEXipX",
      "byte_length": 75
    },
    {
      "unit_id": "DLG_c6300712e4f6",
      "text": "你們休想阻擋我！我註定要再次崛起，成為特克圖克特雷麾下 ",
      "encoded_ascii": "^*F^*{^!G^,1^)L^$G^$%^*W^$%^=F^#.^(C^!l^%D^=C^.(^*A^$$^%{^&5^!d^\"b^!d^&5^)c^4)^!( ",
      "encoded_base64": "XipGXip7XiFHXiwxXilMXiRHXiQlXipXXiQlXj1GXiMuXihDXiFsXiVEXj1DXi4oXipBXiQkXiV7XiY1XiFkXiJiXiFkXiY1XiljXjQpXiEoIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_2ec359c8f2b4",
      "text": "最偉大的聖堂武士。你們、這些可悲的造物，任何敢挑戰我的人 ",
      "encoded_ascii": "^$q^*}^\"z^&Z^'Z^42^%J^+a^!\"^*F^*{^!!^(s^!8^\"A^,.^&Z^(v^&4^*A^!C^!L^/m^,H^$(^$%^&Z^!< ",
      "encoded_base64": "XiRxXip9XiJ6XiZaXidaXjQyXiVKXithXiEiXipGXip7XiEhXihzXiE4XiJBXiwuXiZaXih2XiY0XipBXiFDXiFMXi9tXixIXiQoXiQlXiZaXiE8IA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_59722b19dc99",
      "text": "——全都得死！我不需要任何人的幫助就能達成我的宿命。",
      "encoded_ascii": "^*n^*n^!h^)$^#e^%L^*W^$%^!)^)e^(C^!C^!L^!<^&Z^+}^\"#^*J^'b^(z^$$^$%^&Z^7+^\"N^!\"",
      "encoded_base64": "XipuXipuXiFoXikkXiNlXiVMXipXXiQlXiEpXillXihDXiFDXiFMXiE8XiZaXit9XiIjXipKXidiXih6XiQkXiQlXiZaXjcrXiJOXiEi",
      "byte_length": 78
    },
    {
      "unit_id": "DLG_eddb07937dc2",
      "text": "你在質疑我的判斷嗎？",
      "encoded_ascii": "^*F^\"d^(Z^0p^$%^&Z^1k^,T^+X^.V",
      "encoded_base64": "XipGXiJkXihaXjBwXiQlXiZaXjFrXixUXitYXi5W",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_00aded29c129",
      "text": "我可沒有准許你們離開！",
      "encoded_ascii": "^$%^\"A^%\\^$s^/Q^-s^*F^*{^)`^)F^*W",
      "encoded_base64": "XiQlXiJBXiVcXiRzXi9RXi1zXipGXip7XilgXilGXipX",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_eb7f593d37b6",
      "text": "這才是我對奴隸所要求的順從！作為對你們謙卑的獎賞，我恩准你們 ",
      "encoded_ascii": "^(s^$,^,X^$%^#:^##^)Z^$)^(C^,n^&Z^.D^#f^*W^!M^%{^#:^*F^*{^6x^\".^&Z^7?^*T^*A^$%^#v^/Q^*F^*{ ",
      "encoded_base64": "XihzXiQsXixYXiQlXiM6XiMjXilaXiQpXihDXixuXiZaXi5EXiNmXipXXiFNXiV7XiM6XipGXip7XjZ4XiIuXiZaXjc/XipUXipBXiQlXiN2Xi9RXipGXip7IA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_aa431fc58643",
      "text": "活命。待在我的神廟裡，直到我們收到 ",
      "encoded_ascii": "^%i^\"N^!\"^,*^\"d^$%^&Z^&w^0[^-j^*A^&`^!u^$%^*{^$M^!u ",
      "encoded_base64": "XiVpXiJOXiEiXiwqXiJkXiQlXiZaXiZ3XjBbXi1qXipBXiZgXiF1XiQlXip7XiRNXiF1IA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_b0e796ecb120",
      "text": "進攻頭骨神廟的消息為止。",
      "encoded_ascii": "^(w^$O^)t^*$^&w^0[^&Z^%k^#w^%{^%G^!\"",
      "encoded_base64": "Xih3XiRPXil0XiokXiZ3XjBbXiZaXiVrXiN3XiV7XiVHXiEi",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_34eb9b75ee37",
      "text": " 若想為我效勞，你們就得先學會適度的服從與謙卑！",
      "encoded_ascii": " ^'x^,1^%{^$%^$Q^/R^*A^*F^*{^*J^#e^!b^+n^$r^(|^#V^&Z^,\\^#f^'p^6x^\".^*W",
      "encoded_base64": "IF4neF4sMV4le14kJV4kUV4vUl4qQV4qRl4qe14qSl4jZV4hYl4rbl4kcl4ofF4jVl4mWl4sXF4jZl4ncF42eF4iLl4qVw==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_a20e7101462c",
      "text": "米奎茲爾大人！頭骨神廟已在您精妙的計策下陷落了！",
      "encoded_ascii": "^'4^5B^/D^&/^\"z^!<^*W^)t^*$^&w^0[^#J^\"d^4:^'7^43^&Z^-n^5p^!(^)S^-`^*D^*W",
      "encoded_base64": "Xic0XjVCXi9EXiYvXiJ6XiE8XipXXil0XiokXiZ3XjBbXiNKXiJkXjQ6Xic3XjQzXiZaXi1uXjVwXiEoXilTXi1gXipEXipX",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_e79dc422c90e",
      "text": "終於成了！我根本不需要這群外人的幫忙！",
      "encoded_ascii": "^-H^$^^$$^*D^*W^$%^%)^$x^!)^)e^(C^(s^'R^\"w^!<^&Z^+}^,+^*W",
      "encoded_base64": "Xi1IXiReXiQkXipEXipXXiQlXiUpXiR4XiEpXillXihDXihzXidSXiJ3XiE8XiZaXit9XiwrXipX",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_e7b67395d9ae",
      "text": "我叫你們在原地等著！",
      "encoded_ascii": "^$%^+<^*F^*{^\"d^\"5^\"e^'-^-a^*W",
      "encoded_base64": "XiQlXis8XipGXip7XiJkXiI1XiJlXictXi1hXipX",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_1928be337b52",
      "text": "你這個奸詐的小人！你將為此付出性命的代價！",
      "encoded_ascii": "^*F^(s^!V^:2^6(^&Z^#;^!<^*W^*F^#7^%{^%I^*u^!q^#r^\"N^&Z^*v^+&^*W",
      "encoded_base64": "XipGXihzXiFWXjoyXjYoXiZaXiM7XiE8XipXXipGXiM3XiV7XiVJXip1XiFxXiNyXiJOXiZaXip2XismXipX",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_3f966aa37f4b",
      "text": "偉大的米奎茲爾，我們只是來為您效勞的！",
      "encoded_ascii": "^*}^\"z^&Z^'4^5B^/D^&/^*A^$%^*{^\"?^,X^!O^%{^4:^$Q^/R^&Z^*W",
      "encoded_base64": "Xip9XiJ6XiZaXic0XjVCXi9EXiYvXipBXiQlXip7XiI/XixYXiFPXiV7XjQ6XiRRXi9SXiZaXipX",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_c714b931b582",
      "text": "  你能治療我們的傷勢嗎？",
      "encoded_ascii": "  ^*F^'b^%_^&U^$%^*{^&Z^!^^\"&^+X^.V",
      "encoded_base64": "ICBeKkZeJ2JeJV9eJlVeJCVeKnteJlpeIV5eIiZeK1heLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_c91054f23fda",
      "text": "我是呼嘯之風德魯伊。 ",
      "encoded_ascii": "^$%^,X^\"M^0U^!/^)y^#j^/K^!E^!\" ",
      "encoded_base64": "XiQlXixYXiJNXjBVXiEvXil5XiNqXi9LXiFFXiEiIA==",
      "byte_length": 31
    },
    {
      "unit_id": "DLG_bd2b9b3b3d22",
      "text": "你們做得很好！消滅塔拉是一項了不起的壯舉。 ",
      "encoded_ascii": "^*F^*{^*~^#e^*K^+i^*W^%k^%t^\"o^$6^,X^!%^)q^*D^!)^.(^&Z^+b^01^!\" ",
      "encoded_base64": "XipGXip7Xip+XiNlXipLXitpXipXXiVrXiV0XiJvXiQ2XixYXiElXilxXipEXiEpXi4oXiZaXitiXjAxXiEiIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_7574152e88a7",
      "text": "長期以來，塔拉的邪惡玷污了這片區域，如今我們終於擺脫了它。我的…… ",
      "encoded_ascii": "^)C^$u^!B^!O^*A^\"o^$6^&Z^)\"^#y^1K^0h^*D^(s^&1^\"+^\"k^*A^#$^*E^$%^*{^-H^$^^1@^'c^*D^+o^!\"^$%^&Z^*o^*o ",
      "encoded_base64": "XilDXiR1XiFCXiFPXipBXiJvXiQ2XiZaXikiXiN5XjFLXjBoXipEXihzXiYxXiIrXiJrXipBXiMkXipFXiQlXip7Xi1IXiReXjFAXidjXipEXitvXiEiXiQlXiZaXipvXipvIA==",
      "byte_length": 100
    },
    {
      "unit_id": "DLG_9083aa014014",
      "text": "感激之情無以言表！",
      "encoded_ascii": "^#{^1H^!/^,0^%}^!B^1Y^-i^*W",
      "encoded_base64": "XiN7XjFIXiEvXiwwXiV9XiFCXjFZXi1pXipX",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_7004314b2f90",
      "text": "你好。我能為你們做些什麼？",
      "encoded_ascii": "^*F^+i^!\"^$%^'b^%{^*F^*{^*~^!8^!=^.T^.V",
      "encoded_base64": "XipGXitpXiEiXiQlXidiXiV7XipGXip7Xip+XiE4XiE9Xi5UXi5W",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_9255b560b1ae",
      "text": "在你們去消滅塔拉之前，還有什麼想問的嗎？",
      "encoded_ascii": "^\"d^*F^*{^\"6^%k^%t^\"o^$6^!/^!z^*A^.7^$s^!=^.T^,1^*Z^&Z^+X^.V",
      "encoded_base64": "XiJkXipGXip7XiI2XiVrXiV0XiJvXiQ2XiEvXiF6XipBXi43XiRzXiE9Xi5UXiwxXipaXiZaXitYXi5W",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_3eaa5af28395",
      "text": "你們對付雙足飛龍大師的進展如何？",
      "encoded_ascii": "^*F^*{^#:^*u^)_^(^^)z^*>^\"z^#M^&Z^(w^+x^#$^!L^.V",
      "encoded_base64": "XipGXip7XiM6Xip1XilfXiheXil6Xio+XiJ6XiNNXiZaXih3Xit4XiMkXiFMXi5W",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_506ad5c52412",
      "text": "我就知道會再見到你們。你們重新考慮幫我的忙了嗎？",
      "encoded_ascii": "^$%^*J^&h^(y^$r^!l^-m^!u^*F^*{^!\"^*F^*{^))^$\\^-R^19^+}^$%^&Z^,+^*D^+X^.V",
      "encoded_base64": "XiQlXipKXiZoXih5XiRyXiFsXi1tXiF1XipGXip7XiEiXipGXip7XikpXiRcXi1SXjE5Xit9XiQlXiZaXiwrXipEXitYXi5W",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_cfec3f61d8b0",
      "text": "我是呼嘯之風德魯伊。感謝你們將我從…… ",
      "encoded_ascii": "^$%^,X^\"M^0U^!/^)y^#j^/K^!E^!\"^#{^-z^*F^*{^#7^$%^#f^*o^*o ",
      "encoded_base64": "XiQlXixYXiJNXjBVXiEvXil5XiNqXi9LXiFFXiEiXiN7Xi16XipGXip7XiM3XiQlXiNmXipvXipvIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_75622a6f28c5",
      "text": "土元素手中救出，這證明了你們心存良善。如果…… ",
      "encoded_ascii": "^\"c^!a^'=^$+^!,^,Q^!q^*A^(s^-{^$c^*D^*F^*{^#k^#*^1V^1(^!\"^#$^%!^*o^*o ",
      "encoded_base64": "XiJjXiFhXic9XiQrXiEsXixRXiFxXipBXihzXi17XiRjXipEXipGXip7XiNrXiMqXjFWXjEoXiEiXiMkXiUhXipvXipvIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_550165cb430e",
      "text": "可以的話，我能否進一步請求你們展現英雄本色，幫我一個忙？",
      "encoded_ascii": "^\"A^!B^&Z^-v^*A^$%^'b^\"H^(w^!%^,i^*S^,n^*F^*{^+x^&?^'y^)\\^$x^'s^*A^+}^$%^!%^!V^,+^.V",
      "encoded_base64": "XiJBXiFCXiZaXi12XipBXiQlXidiXiJIXih3XiElXixpXipTXixuXipGXip7Xit4XiY/Xid5XilcXiR4XidzXipBXit9XiQlXiElXiFWXiwrXi5W",
      "byte_length": 84
    },
    {
      "unit_id": "DLG_1122cca1cafa",
      "text": "  跟我說說秘密寶藏的事。",
      "encoded_ascii": "  ^.+^$%^-x^-x^1O^#0^#4^-f^&Z^*r^!\"",
      "encoded_base64": "ICBeLiteJCVeLXheLXheMU9eIzBeIzReLWZeJlpeKnJeISI=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_a361ff0ed6a1",
      "text": "  你有多感激我的英勇之舉？",
      "encoded_ascii": "  ^*F^$s^\"x^#{^1H^$%^&Z^'y^\"$^!/^01^.V",
      "encoded_base64": "ICBeKkZeJHNeInheI3teMUheJCVeJlpeJ3leIiReIS9eMDFeLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_75bf7f8217d0",
      "text": "  什麼是蛇靴？",
      "encoded_ascii": "  ^!=^.T^,X^(/^)k^.V",
      "encoded_base64": "ICBeIT1eLlReLFheKC9eKWteLlY=",
      "byte_length": 20
    },
    {
      "unit_id": "DLG_89b743f757dc",
      "text": "  跟我說說那把魔法劍的事。",
      "encoded_ascii": "  ^.+^$%^-x^-x^)!^$1^*0^%b^!|^&Z^*r^!\"",
      "encoded_base64": "ICBeLiteJCVeLXheLXheKSFeJDFeKjBeJWJeIXxeJlpeKnJeISI=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_18aae5685af9",
      "text": "  「內在之眼」是什麼？",
      "encoded_ascii": "  ^!#^!g^\"d^!/^&d^!$^,X^!=^.T^.V",
      "encoded_base64": "ICBeISNeIWdeImReIS9eJmReISReLFheIT1eLlReLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_9a55a3807e50",
      "text": "  塔拉的信徒下場會如何？",
      "encoded_ascii": "  ^\"o^$6^&Z^!U^#d^!(^\"n^$r^#$^!L^.V",
      "encoded_base64": "ICBeIm9eJDZeJlpeIVVeI2ReISheIm5eJHJeIyReIUxeLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_ea8c85c89107",
      "text": "  你現在打算做什麼？",
      "encoded_ascii": "  ^*F^&?^\"d^$-^-C^*~^!=^.T^.V",
      "encoded_base64": "ICBeKkZeJj9eImReJC1eLUNeKn5eIT1eLlReLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_e41e6cf81042",
      "text": " 不好意思，我現在必須休息了。再會。",
      "encoded_ascii": " ^!)^+i^#z^#q^*A^$%^&?^\"d^#l^)r^!G^#w^*D^!\"^!l^$r^!\"",
      "encoded_base64": "IF4hKV4raV4jel4jcV4qQV4kJV4mP14iZF4jbF4pcl4hR14jd14qRF4hIl4hbF4kcl4hIg==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_2f361adf6766",
      "text": "  我已經奪回飛龍騎鉤了。",
      "encoded_ascii": "  ^$%^#J^'D^1,^\"\\^)z^*>^0K^)/^*D^!\"",
      "encoded_base64": "ICBeJCVeI0peJ0ReMSxeIlxeKXpeKj5eMEteKS9eKkReISI=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_7fc77d44cdcb",
      "text": "  我還沒拿到飛龍騎鉤。",
      "encoded_ascii": "  ^$%^.7^%\\^,G^!u^)z^*>^0K^)/^!\"",
      "encoded_base64": "ICBeJCVeLjdeJVxeLEdeIXVeKXpeKj5eMEteKS9eISI=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_e104b8409db2",
      "text": "  我想向你打聽一些情報。",
      "encoded_ascii": "  ^$%^,1^+?^*F^$-^-X^!%^!8^,0^+`^!\"",
      "encoded_base64": "ICBeJCVeLDFeKz9eKkZeJC1eLVheISVeITheLDBeK2BeISI=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_2ba564d8825c",
      "text": "  我現在該做什麼？",
      "encoded_ascii": "  ^$%^&?^\"d^(M^*~^!=^.T^.V",
      "encoded_base64": "ICBeJCVeJj9eImReKE1eKn5eIT1eLlReLlY=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_2dc390d01b40",
      "text": "  我該如何消滅塔拉？",
      "encoded_ascii": "  ^$%^(M^#$^!L^%k^%t^\"o^$6^.V",
      "encoded_base64": "ICBeJCVeKE1eIyReIUxeJWteJXReIm9eJDZeLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_d70bdea6ddcd",
      "text": "  你能給我更多幫助嗎？",
      "encoded_ascii": "  ^*F^'b^'A^$%^$o^\"x^+}^\"#^+X^.V",
      "encoded_base64": "ICBeKkZeJ2JeJ0FeJCVeJG9eInheK31eIiNeK1heLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_17fbcc8ccb4f",
      "text": "  你想要什麼？",
      "encoded_ascii": "  ^*F^,1^(C^!=^.T^.V",
      "encoded_base64": "ICBeKkZeLDFeKENeIT1eLlReLlY=",
      "byte_length": 20
    },
    {
      "unit_id": "DLG_2c8cd1617781",
      "text": "  你為什麼想要飛龍騎鉤？",
      "encoded_ascii": "  ^*F^%{^!=^.T^,1^(C^)z^*>^0K^)/^.V",
      "encoded_base64": "ICBeKkZeJXteIT1eLlReLDFeKENeKXpeKj5eMEteKS9eLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_93b14b6cf197",
      "text": "  我想先打聽一些消息。",
      "encoded_ascii": "  ^$%^,1^!b^$-^-X^!%^!8^%k^#w^!\"",
      "encoded_base64": "ICBeJCVeLDFeIWJeJC1eLVheISVeITheJWteI3deISI=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_9ca1b95bb0c4",
      "text": "  我能從這筆交易中得到什麼好處？",
      "encoded_ascii": "  ^$%^'b^#f^(s^-A^0P^,W^!,^#e^!u^!=^.T^+i^(,^.V",
      "encoded_base64": "ICBeJCVeJ2JeI2ZeKHNeLUFeMFBeLFdeISxeI2VeIXVeIT1eLlReK2leKCxeLlY=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_690dad9ea5bd",
      "text": "  能為你效勞是我的榮幸。",
      "encoded_ascii": "  ^'b^%{^*F^$Q^/R^,X^$%^&Z^,e^15^!\"",
      "encoded_base64": "ICBeJ2JeJXteKkZeJFFeL1JeLFheJCVeJlpeLGVeMTVeISI=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_4f231a6ec005",
      "text": "  我為你做的已經夠多了。",
      "encoded_ascii": "  ^$%^%{^*F^*~^&Z^#J^'D^+d^\"x^*D^!\"",
      "encoded_base64": "ICBeJCVeJXteKkZeKn5eJlpeI0peJ0ReK2ReInheKkReISI=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_53af5d6595d7",
      "text": "在下層城堡的東南角有一處荒廢區域，那裡藏著一把…… ",
      "encoded_ascii": "^\"d^!(^#B^+_^\"m^&Z^,`^\"/^(H^$s^!%^(,^1W^#W^\"+^\"k^*A^)!^-j^-f^-a^!%^$1^*o^*o ",
      "encoded_base64": "XiJkXiEoXiNCXitfXiJtXiZaXixgXiIvXihIXiRzXiElXigsXjFXXiNXXiIrXiJrXipBXikhXi1qXi1mXi1hXiElXiQxXipvXipvIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_a58184661510",
      "text": "魔法神劍。你們需要穿上蛇靴，才能穿過…… ",
      "encoded_ascii": "^*0^%b^&w^!|^!\"^*F^*{^)e^(C^')^!'^(/^)k^*A^$,^'b^')^(x^*o^*o ",
      "encoded_base64": "XiowXiViXiZ3XiF8XiEiXipGXip7XillXihDXicpXiEnXigvXilrXipBXiQsXidiXicpXih4XipvXipvIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_940115f7dadb",
      "text": "南牆上的秘密入口。",
      "encoded_ascii": "^\"/^&0^!'^&Z^1O^#0^!f^\"<^!\"",
      "encoded_base64": "XiIvXiYwXiEnXiZaXjFPXiMwXiFmXiI8XiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_609f7c172f5c",
      "text": "內在之眼一位專精變化系的法師製造了這雙蛇靴。穿上牠們…… ",
      "encoded_ascii": "^!g^\"d^!/^&d^!%^!J^#8^'7^(U^\")^'9^&Z^%b^#M^(B^(v^*D^(s^)_^(/^)k^!\"^')^!'^-#^*{^*o^*o ",
      "encoded_base64": "XiFnXiJkXiEvXiZkXiElXiFKXiM4Xic3XihVXiIpXic5XiZaXiViXiNNXihCXih2XipEXihzXilfXigvXilrXiEiXicpXiEnXi0jXip7XipvXipvIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_ecac819b8592",
      "text": "其星界特質能讓你們穿透秘密密門的禁制障壁。 ",
      "encoded_ascii": "^!j^$e^.p^&5^(Z^'b^-}^*F^*{^')^(q^1O^#0^#0^)D^&Z^&y^!v^)W^*\\^!\" ",
      "encoded_base64": "XiFqXiRlXi5wXiY1XihaXidiXi19XipGXip7XicpXihxXjFPXiMwXiMwXilEXiZaXiZ5XiF2XilXXipcXiEiIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_082677571603",
      "text": "在穿戴這雙靴子時穿過門的結界障壁。",
      "encoded_ascii": "^\"d^')^1:^(s^)_^)k^#(^$f^')^(x^)D^&Z^'@^.p^)W^*\\^!\"",
      "encoded_base64": "XiJkXicpXjE6XihzXilfXilrXiMoXiRmXicpXih4XilEXiZaXidAXi5wXilXXipcXiEi",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_9efc339969ca",
      "text": " 黑色迷宮中塔拉的某個信徒身上，大概還留著這雙靴子。",
      "encoded_ascii": " ^*:^'s^(n^/\\^!,^\"o^$6^&Z^%$^!V^!U^#d^(c^!'^*A^\"z^,d^.7^-+^-a^(s^)_^)k^#(^!\"",
      "encoded_base64": "IF4qOl4nc14obl4vXF4hLF4ib14kNl4mWl4lJF4hVl4hVV4jZF4oY14hJ14qQV4iel4sZF4uN14tK14tYV4oc14pX14pa14jKF4hIg==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_84c13e691873",
      "text": "除了它的名字「黑暗之焰」外，我對這把劍知之甚少。這是一把…… ",
      "encoded_ascii": "^)Q^*D^+o^&Z^\"F^#)^!#^*:^$k^!/^&!^!$^\"w^*A^$%^#:^(s^$1^!|^&h^!/^/|^#<^!\"^(s^,X^!%^$1^*o^*o ",
      "encoded_base64": "XilRXipEXitvXiZaXiJGXiMpXiEjXio6XiRrXiEvXiYhXiEkXiJ3XipBXiQlXiM6XihzXiQxXiF8XiZoXiEvXi98XiM8XiEiXihzXixYXiElXiQxXipvXipvIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_147ae7449c5c",
      "text": "遠古神劍，早在內在之眼進駐這座城堡前很久就鍛造完成了。呼嘯之風…… ",
      "encoded_ascii": "^({^\"=^&w^!|^*A^,V^\"d^!g^\"d^!/^&d^(w^1f^(s^/_^+_^\"m^!z^*K^!.^*J^1c^(v^#,^$$^*D^!\"^\"M^0U^!/^)y^*o^*o ",
      "encoded_base64": "Xih7XiI9XiZ3XiF8XipBXixWXiJkXiFnXiJkXiEvXiZkXih3XjFmXihzXi9fXitfXiJtXiF6XipLXiEuXipKXjFjXih2XiMsXiQkXipEXiEiXiJNXjBVXiEvXil5XipvXipvIA==",
      "byte_length": 100
    },
    {
      "unit_id": "DLG_628f141e81b8",
      "text": "精魂曾說，依然有極為可怕的守護者在城堡的那片區域…… ",
      "encoded_ascii": "^'7^*.^.j^-x^*A^!Q^&\"^$s^1D^%{^\"A^0^^&Z^#+^(T^'V^\"d^+_^\"m^&Z^)!^&1^\"+^\"k^*o^*o ",
      "encoded_base64": "Xic3XiouXi5qXi14XipBXiFRXiYiXiRzXjFEXiV7XiJBXjBeXiZaXiMrXihUXidWXiJkXitfXiJtXiZaXikhXiYxXiIrXiJrXipvXipvIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_e2e61af5e23f",
      "text": "嚴密守衛著。",
      "encoded_ascii": "^1*^#0^#+^(=^-a^!\"",
      "encoded_base64": "XjEqXiMwXiMrXig9Xi1hXiEi",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_6810020f2164",
      "text": "鎮守黑色迷宮的符印依舊囚禁著他們，儘管塔拉死後詛咒已經被打破。 ",
      "encoded_ascii": "^);^#+^*:^'s^(n^/\\^&Z^'+^1%^!Q^02^\"Z^&y^-a^!@^*{^*A^+(^-D^\"o^$6^%L^#b^(L^\"P^#J^'D^(@^$-^&n^!\" ",
      "encoded_base64": "Xik7XiMrXio6XidzXihuXi9cXiZaXicrXjElXiFRXjAyXiJaXiZ5Xi1hXiFAXip7XipBXisoXi1EXiJvXiQ2XiVMXiNiXihMXiJQXiNKXidEXihAXiQtXiZuXiEiIA==",
      "byte_length": 94
    },
    {
      "unit_id": "DLG_1cc9d6757799",
      "text": "他們會在迷宮迴廊中遊蕩，直到徹底死去化為塵土； ",
      "encoded_ascii": "^!@^*{^$r^\"d^(n^/\\^0D^,$^!,^.3^1X^*A^&`^!u^18^/^^%L^\"6^\")^%{^\"p^\"c^*C ",
      "encoded_base64": "XiFAXip7XiRyXiJkXihuXi9cXjBEXiwkXiEsXi4zXjFYXipBXiZgXiF1XjE4Xi9eXiVMXiI2XiIpXiV7XiJwXiJjXipDIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_a7383426b164",
      "text": "或者你們也可以使用風之魔藥摧毀結界符印，讓他們獲得解脫。 ",
      "encoded_ascii": "^$'^'V^*F^*{^!1^\"A^!B^!N^&H^)y^!/^*0^()^$E^%N^'@^.p^'+^1%^*A^-}^!@^*{^&:^#e^(I^'c^!\" ",
      "encoded_base64": "XiQnXidWXipGXip7XiExXiJBXiFCXiFOXiZIXil5XiEvXiowXigpXiRFXiVOXidAXi5wXicrXjElXipBXi19XiFAXip7XiY6XiNlXihJXidjXiEiIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_2157aabd63f0",
      "text": "摧毀符印結界。",
      "encoded_ascii": "^$E^%N^'+^1%^'@^.p^!\"",
      "encoded_base64": "XiRFXiVOXicrXjElXidAXi5wXiEi",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_57431c415109",
      "text": "我會留在這座山上，繼續侍奉呼嘯之風精魂。",
      "encoded_ascii": "^$%^$r^-+^\"d^(s^/_^11^!'^*A^-O^'M^0}^1+^\"M^0U^!/^)y^'7^*.^!\"",
      "encoded_base64": "XiQlXiRyXi0rXiJkXihzXi9fXjExXiEnXipBXi1PXidNXjB9XjErXiJNXjBVXiEvXil5Xic3XiouXiEi",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_229985ebe5d1",
      "text": "是的，我很樂意為你效勞。",
      "encoded_ascii": "^,X^&Z^*A^$%^*K^%8^#z^%{^*F^$Q^/R^!\"",
      "encoded_base64": "XixYXiZaXipBXiQlXipLXiU4XiN6XiV7XipGXiRRXi9SXiEi",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_93f28061d1f9",
      "text": "這真是令人遺憾的消息，但我相信你們很快就會成功。這只不過是…… ",
      "encoded_ascii": "^(s^-2^,X^*w^!<^0v^0_^&Z^%k^#w^*A^!I^$%^&a^!U^*F^*{^*K^*L^*J^$r^$$^\"!^!\"^(s^\"?^!)^(x^,X^*o^*o ",
      "encoded_base64": "XihzXi0yXixYXip3XiE8XjB2XjBfXiZaXiVrXiN3XipBXiFJXiQlXiZhXiFVXipGXip7XipLXipMXipKXiRyXiQkXiIhXiEiXihzXiI/XiEpXih4XixYXipvXipvIA==",
      "byte_length": 94
    },
    {
      "unit_id": "DLG_98c2e7a6fc6b",
      "text": "從雙足飛龍大師手中把它搶過來的問題罷了。",
      "encoded_ascii": "^#f^)_^(^^)z^*>^\"z^#M^$+^!,^$1^+o^1?^(x^!O^&Z^*Z^.G^1Q^*D^!\"",
      "encoded_base64": "XiNmXilfXiheXil6Xio+XiJ6XiNNXiQrXiEsXiQxXitvXjE/Xih4XiFPXiZaXipaXi5HXjFRXipEXiEi",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_7ded2964e700",
      "text": "你們必須前往塔拉盤踞的東塔與她戰鬥。一旦她…… ",
      "encoded_ascii": "^*F^*{^#l^)r^!z^,)^\"o^$6^1M^1_^&Z^,`^\"o^'p^+h^$(^*,^!\"^!%^1C^+h^*o^*o ",
      "encoded_base64": "XipGXip7XiNsXilyXiF6XiwpXiJvXiQ2XjFNXjFfXiZaXixgXiJvXidwXitoXiQoXiosXiEiXiElXjFDXitoXipvXipvIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_c956ca0843d1",
      "text": "被擊倒並消失時，立刻使用風之魔藥將她的…… ",
      "encoded_ascii": "^(@^$F^!X^!+^%k^\"|^$f^*A^0'^.Y^!N^&H^)y^!/^*0^()^#7^+h^&Z^*o^*o ",
      "encoded_base64": "XihAXiRGXiFYXiErXiVrXiJ8XiRmXipBXjAnXi5ZXiFOXiZIXil5XiEvXiowXigpXiM3XitoXiZaXipvXipvIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_dd7010aba37e",
      "text": "殘留軀殼吹散到窗外。 ",
      "encoded_ascii": "^,l^-+^(d^1F^+A^$S^!u^1P^\"w^!\" ",
      "encoded_base64": "XixsXi0rXihkXjFGXitBXiRTXiF1XjFQXiJ3XiEiIA==",
      "byte_length": 31
    },
    {
      "unit_id": "DLG_45c92fdbd979",
      "text": "但你們動作必須快，要在她來得及重聚現形之前完成。",
      "encoded_ascii": "^!I^*F^*{^\"%^!M^#l^)r^*L^*A^(C^\"d^+h^!O^#e^\"7^))^'[^&?^#_^!/^!z^#,^$$^!\"",
      "encoded_base64": "XiFJXipGXip7XiIlXiFNXiNsXilyXipMXipBXihDXiJkXitoXiFPXiNlXiI3XikpXidbXiY/XiNfXiEvXiF6XiMsXiQkXiEi",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_42cc12bdba3e",
      "text": "我很抱歉，但我長期被囚禁，身體太過虛弱，無法在…… ",
      "encoded_ascii": "^$%^*K^,@^,h^*A^!I^$%^)C^$u^(@^\"Z^&y^*A^(c^**^+f^(x^-g^#\\^*A^%}^%b^\"d^*o^*o ",
      "encoded_base64": "XiQlXipLXixAXixoXipBXiFJXiQlXilDXiR1XihAXiJaXiZ5XipBXihjXioqXitmXih4Xi1nXiNcXipBXiV9XiViXiJkXipvXipvIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_659a221c9b37",
      "text": "你們即將面臨的殘酷戰鬥中提供太多實質幫助。 ",
      "encoded_ascii": "^*F^*{^\"1^#7^)j^1U^&Z^,l^1b^$(^*,^!,^$A^!P^+f^\"x^#3^(Z^+}^\"#^!\" ",
      "encoded_base64": "XipGXip7XiIxXiM3XilqXjFVXiZaXixsXjFiXiQoXiosXiEsXiRBXiFQXitmXiJ4XiMzXihaXit9XiIjXiEiIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_317e7f172ee2",
      "text": " 當然，只要你們把騎鉤交給我，我保證雙足飛龍…… ",
      "encoded_ascii": " ^&N^&\"^*A^\"?^(C^*F^*{^$1^0K^)/^0P^'A^$%^*A^$%^!T^-{^)_^(^^)z^*>^*o^*o ",
      "encoded_base64": "IF4mTl4mIl4qQV4iP14oQ14qRl4qe14kMV4wS14pL14wUF4nQV4kJV4qQV4kJV4hVF4te14pX14oXl4pel4qPl4qb14qbyA=",
      "byte_length": 71
    },
    {
      "unit_id": "DLG_0c1b5fdeee7d",
      "text": "再也不會威脅騷擾你們。",
      "encoded_ascii": "^!l^!1^!)^$r^#&^1T^0y^$K^*F^*{^!\"",
      "encoded_base64": "XiFsXiExXiEpXiRyXiMmXjFUXjB5XiRLXipGXip7XiEi",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_389e490328b2",
      "text": "我必須奪回雙足飛龍大師的騎鉤。塔拉利用它許以力量，誘騙…… ",
      "encoded_ascii": "^$%^#l^)r^1,^\"\\^)_^(^^)z^*>^\"z^#M^&Z^0K^)/^!\"^\"o^$6^!t^&H^+o^-s^!B^!~^)*^*A^1Z^.{^*o^*o ",
      "encoded_base64": "XiQlXiNsXilyXjEsXiJcXilfXiheXil6Xio+XiJ6XiNNXiZaXjBLXikvXiEiXiJvXiQ2XiF0XiZIXitvXi1zXiFCXiF+XikqXipBXjFaXi57XipvXipvIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_ee9fad41cd56",
      "text": "受害者來到她身邊。兩者都必須被消滅！只要你們…… ",
      "encoded_ascii": "^\";^#/^'V^!O^!u^+h^(c^.8^!\"^!i^'V^)$^#l^)r^(@^%k^%t^*W^\"?^(C^*F^*{^*o^*o ",
      "encoded_base64": "XiI7XiMvXidWXiFPXiF1XitoXihjXi44XiEiXiFpXidWXikkXiNsXilyXihAXiVrXiV0XipXXiI/XihDXipGXip7XipvXipvIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_14dfbb5d40b7",
      "text": "把騎鉤交給我",
      "encoded_ascii": "^$1^0K^)/^0P^'A^$%",
      "encoded_base64": "XiQxXjBLXikvXjBQXidBXiQl",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_33e19873f6b8",
      "text": "幫我取回騎鉤",
      "encoded_ascii": "^+}^$%^\":^\"\\^0K^)/",
      "encoded_base64": "Xit9XiQlXiI6XiJcXjBLXikv",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_8390f30026cf",
      "text": " 並徹底消滅塔拉，我能為你們提供很多幫助。",
      "encoded_ascii": " ^!+^18^/^^%k^%t^\"o^$6^*A^$%^'b^%{^*F^*{^$A^!P^*K^\"x^+}^\"#^!\"",
      "encoded_base64": "IF4hK14xOF4vXl4la14ldF4ib14kNl4qQV4kJV4nYl4le14qRl4qe14kQV4hUF4qS14ieF4rfV4iI14hIg==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_4e4335a10d25",
      "text": "在雙足飛龍大師用騎鉤奴役牠們之前，雙足飛龍一直受我的庇護…… ",
      "encoded_ascii": "^\"d^)_^(^^)z^*>^\"z^#M^&H^0K^)/^##^17^-#^*{^!/^!z^*A^)_^(^^)z^*>^!%^&`^\";^$%^&Z^,\"^(T^*o^*o ",
      "encoded_base64": "XiJkXilfXiheXil6Xio+XiJ6XiNNXiZIXjBLXikvXiMjXjE3Xi0jXip7XiEvXiF6XipBXilfXiheXil6Xio+XiElXiZgXiI7XiQlXiZaXiwiXihUXipvXipvIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_d65a30626352",
      "text": "我必須確保這種悲劇絕不再重演。",
      "encoded_ascii": "^$%^#l^)r^-6^!T^(s^'$^,.^1#^-I^!)^!l^))^1G^!\"",
      "encoded_base64": "XiQlXiNsXilyXi02XiFUXihzXickXiwuXjEjXi1JXiEpXiFsXikpXjFHXiEi",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_3c6bd2ddc91f",
      "text": "你們必須找到塔拉，並使用風之魔藥徹底消滅她。",
      "encoded_ascii": "^*F^*{^#l^)r^$/^!u^\"o^$6^*A^!+^!N^&H^)y^!/^*0^()^18^/^^%k^%t^+h^!\"",
      "encoded_base64": "XipGXip7XiNsXilyXiQvXiF1XiJvXiQ2XipBXiErXiFOXiZIXil5XiEvXiowXigpXjE4Xi9eXiVrXiV0XitoXiEi",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_ec343ae543b0",
      "text": "從雙足飛龍大師手中奪回騎鉤並帶給我。然後…… ",
      "encoded_ascii": "^#f^)_^(^^)z^*>^\"z^#M^$+^!,^1,^\"\\^0K^)/^!+^#N^'A^$%^!\"^&\"^#b^*o^*o ",
      "encoded_base64": "XiNmXilfXiheXil6Xio+XiJ6XiNNXiQrXiEsXjEsXiJcXjBLXikvXiErXiNOXidBXiQlXiEiXiYiXiNiXipvXipvIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_cda6175b9c89",
      "text": "我們就能商討如何消滅塔拉了。",
      "encoded_ascii": "^$%^*{^*J^'b^1'^-o^#$^!L^%k^%t^\"o^$6^*D^!\"",
      "encoded_base64": "XiQlXip7XipKXidiXjEnXi1vXiMkXiFMXiVrXiV0XiJvXiQ2XipEXiEi",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_ad3b9f7a711e",
      "text": "你們想知道些什麼？",
      "encoded_ascii": "^*F^*{^,1^&h^(y^!8^!=^.T^.V",
      "encoded_base64": "XipGXip7XiwxXiZoXih5XiE4XiE9Xi5UXi5W",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_c690202fc6df",
      "text": "我可以告訴你們城堡中寶藏的下落。我也會治療你們的…… ",
      "encoded_ascii": "^$%^\"A^!B^+B^-t^*F^*{^+_^\"m^!,^#4^-f^&Z^!(^-`^!\"^$%^!1^$r^%_^&U^*F^*{^&Z^*o^*o ",
      "encoded_base64": "XiQlXiJBXiFCXitCXi10XipGXip7XitfXiJtXiEsXiM0Xi1mXiZaXiEoXi1gXiEiXiQlXiExXiRyXiVfXiZVXipGXip7XiZaXipvXipvIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_c8577d4f77f2",
      "text": "傷勢，而且誰知道呢？說不定哪天我也能回報這份恩情。",
      "encoded_ascii": "^!^^\"&^*A^'W^!*^-y^&h^(y^+C^.V^-x^!)^#.^+I^+e^$%^!1^'b^\"\\^+`^(s^*x^#v^,0^!\"",
      "encoded_base64": "XiFeXiImXipBXidXXiEqXi15XiZoXih5XitDXi5WXi14XiEpXiMuXitJXitlXiQlXiExXidiXiJcXitgXihzXip4XiN2XiwwXiEi",
      "byte_length": 75
    },
    {
      "unit_id": "DLG_aa8a75f45237",
      "text": "當然，讓附近的村落重獲安全本身就是最大的回報，而且…… ",
      "encoded_ascii": "^&N^&\"^*A^-}^.?^(l^&Z^$z^-`^))^&:^+p^!h^$x^(c^*J^,X^$q^\"z^&Z^\"\\^+`^*A^'W^!*^*o^*o ",
      "encoded_base64": "XiZOXiYiXipBXi19Xi4/XihsXiZaXiR6Xi1gXikpXiY6XitwXiFoXiR4XihjXipKXixYXiRxXiJ6XiZaXiJcXitgXipBXidXXiEqXipvXipvIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_cdbae331e54a",
      "text": "你們也需要我的幫助才能消滅塔拉。",
      "encoded_ascii": "^*F^*{^!1^)e^(C^$%^&Z^+}^\"#^$,^'b^%k^%t^\"o^$6^!\"",
      "encoded_base64": "XipGXip7XiExXillXihDXiQlXiZaXit9XiIjXiQsXidiXiVrXiV0XiJvXiQ2XiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_8de78512c149",
      "text": "我就知道我可以信賴你們的高尚品格！ ",
      "encoded_ascii": "^$%^*J^&h^(y^$%^\"A^!B^!U^0t^*F^*{^&Z^*+^+v^\"R^%*^*W ",
      "encoded_base64": "XiQlXipKXiZoXih5XiQlXiJBXiFCXiFVXjB0XipGXip7XiZaXiorXit2XiJSXiUqXipXIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_f00426b3e711",
      "text": "我床邊的那把鑰匙能讓你們進入雙足飛龍大師的領地。 ",
      "encoded_ascii": "^$%^#U^.8^&Z^)!^$1^)@^\"*^'b^-}^*F^*{^(w^!f^)_^(^^)z^*>^\"z^#M^&Z^)s^\"e^!\" ",
      "encoded_base64": "XiQlXiNVXi44XiZaXikhXiQxXilAXiIqXidiXi19XipGXip7Xih3XiFmXilfXiheXil6Xio+XiJ6XiNNXiZaXilzXiJlXiEiIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_27f4d312fd8a",
      "text": "當你們帶著飛龍騎鉤回來時，我會給你們一瓶能…… ",
      "encoded_ascii": "^&N^*F^*{^#N^-a^)z^*>^0K^)/^\"\\^!O^$f^*A^$%^$r^'A^*F^*{^!%^&D^'b^*o^*o ",
      "encoded_base64": "XiZOXipGXip7XiNOXi1hXil6Xio+XjBLXikvXiJcXiFPXiRmXipBXiQlXiRyXidBXipGXip7XiElXiZEXidiXipvXipvIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_263a1a823e27",
      "text": "讓你們徹底擊敗塔拉的魔藥。",
      "encoded_ascii": "^-}^*F^*{^18^/^^$F^$R^\"o^$6^&Z^*0^()^!\"",
      "encoded_base64": "Xi19XipGXip7XjE4Xi9eXiRGXiRSXiJvXiQ2XiZaXiowXigpXiEi",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_9a3c356d279f",
      "text": "你們是不折不扣的崇高英雄！",
      "encoded_ascii": "^*F^*{^,X^!)^,?^!)^$.^&Z^13^*+^'y^)\\^*W",
      "encoded_base64": "XipGXip7XixYXiEpXiw/XiEpXiQuXiZaXjEzXiorXid5XilcXipX",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_912d74a30520",
      "text": "那麼祝你們一路順風，但我相信在一切塵埃落定之前…… ",
      "encoded_ascii": "^)!^.T^&v^*F^*{^!%^(a^.D^)y^*A^!I^$%^&a^!U^\"d^!%^+.^\"p^/&^-`^#.^!/^!z^*o^*o ",
      "encoded_base64": "XikhXi5UXiZ2XipGXip7XiElXihhXi5EXil5XipBXiFJXiQlXiZhXiFVXiJkXiElXisuXiJwXi8mXi1gXiMuXiEvXiF6XipvXipvIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_605408bb14c1",
      "text": "我們的命運必然會再次交會。再會。",
      "encoded_ascii": "^$%^*{^&Z^\"N^.4^#l^&\"^$r^!l^%D^0P^$r^!\"^!l^$r^!\"",
      "encoded_base64": "XiQlXip7XiZaXiJOXi40XiNsXiYiXiRyXiFsXiVEXjBQXiRyXiEiXiFsXiRyXiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_b602d7250298",
      "text": "能結識你們是我的榮幸。珍重再見。",
      "encoded_ascii": "^'b^'@^(R^*F^*{^,X^$%^&Z^,e^15^!\"^/7^))^!l^-m^!\"",
      "encoded_base64": "XidiXidAXihSXipGXip7XixYXiQlXiZaXixlXjE1XiEiXi83XikpXiFsXi1tXiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_aead4c0be57f",
      "text": "暫且告別了。祝你們好運！",
      "encoded_ascii": "^$l^!*^+B^*H^*D^!\"^&v^*F^*{^+i^.4^*W",
      "encoded_base64": "XiRsXiEqXitCXipIXipEXiEiXiZ2XipGXip7XitpXi40XipX",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_a2618729d66b",
      "text": "你們現在願意把騎鉤交給我了嗎？",
      "encoded_ascii": "^*F^*{^&?^\"d^.H^#z^$1^0K^)/^0P^'A^$%^*D^+X^.V",
      "encoded_base64": "XipGXip7XiY/XiJkXi5IXiN6XiQxXjBLXikvXjBQXidBXiQlXipEXitYXi5W",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_1dfc5d279a02",
      "text": "謝謝你們。我會確保它被銷毀，而你們也必須確保…… ",
      "encoded_ascii": "^-z^-z^*F^*{^!\"^$%^$r^-6^!T^+o^(@^)1^%N^*A^'W^*F^*{^!1^#l^)r^-6^!T^*o^*o ",
      "encoded_base64": "Xi16Xi16XipGXip7XiEiXiQlXiRyXi02XiFUXitvXihAXikxXiVOXipBXidXXipGXip7XiExXiNsXilyXi02XiFUXipvXipvIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_8589b542df58",
      "text": "塔拉被徹底消滅。拿著這瓶風之魔藥，在你們…… ",
      "encoded_ascii": "^\"o^$6^(@^18^/^^%k^%t^!\"^,G^-a^(s^&D^)y^!/^*0^()^*A^\"d^*F^*{^*o^*o ",
      "encoded_base64": "XiJvXiQ2XihAXjE4Xi9eXiVrXiV0XiEiXixHXi1hXihzXiZEXil5XiEvXiowXigpXipBXiJkXipGXip7XipvXipvIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_3a3b37d71bd1",
      "text": "將塔拉擊倒後立刻使用它，否則她還會再次重聚現身。",
      "encoded_ascii": "^#7^\"o^$6^$F^!X^#b^0'^.Y^!N^&H^+o^*A^\"H^!x^+h^.7^$r^!l^%D^))^'[^&?^(c^!\"",
      "encoded_base64": "XiM3XiJvXiQ2XiRGXiFYXiNiXjAnXi5ZXiFOXiZIXitvXipBXiJIXiF4XitoXi43XiRyXiFsXiVEXikpXidbXiY/XihjXiEi",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_2bb53dd40e6a",
      "text": "  這瓶風之魔藥有什麼功效？",
      "encoded_ascii": "  ^(s^&D^)y^!/^*0^()^$s^!=^.T^\"!^$Q^.V",
      "encoded_base64": "ICBeKHNeJkReKXleIS9eKjBeKCleJHNeIT1eLlReIiFeJFFeLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_8334c2ba0d65",
      "text": "  你從哪裡弄來這瓶魔藥的？",
      "encoded_ascii": "  ^*F^#f^+I^-j^/`^!O^(s^&D^*0^()^&Z^.V",
      "encoded_base64": "ICBeKkZeI2ZeK0leLWpeL2BeIU9eKHNeJkReKjBeKCleJlpeLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_fe757161c057",
      "text": "  包在我們身上！",
      "encoded_ascii": "  ^\"'^\"d^$%^*{^(c^!'^*W",
      "encoded_base64": "ICBeIideImReJCVeKnteKGNeISdeKlc=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_8ef9beb0f38e",
      "text": "  我不想去跟塔拉交戰。",
      "encoded_ascii": "  ^$%^!)^,1^\"6^.+^\"o^$6^0P^$(^!\"",
      "encoded_base64": "ICBeJCVeISleLDFeIjZeLiteIm9eJDZeMFBeJCheISI=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_7ea612b9e230",
      "text": "聽到這話真遺憾。等你們準備好把它交給我時再來吧。",
      "encoded_ascii": "^-X^!u^(s^-v^-2^0v^0_^!\"^'-^*F^*{^,x^+\"^+i^$1^+o^0P^'A^$%^$f^!l^!O^*I^!\"",
      "encoded_base64": "Xi1YXiF1XihzXi12Xi0yXjB2XjBfXiEiXictXipGXip7Xix4XisiXitpXiQxXitvXjBQXidBXiQlXiRmXiFsXiFPXipJXiEi",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_748926c56bd7",
      "text": "  你為什麼會被關在這裡？",
      "encoded_ascii": "  ^*F^%{^!=^.T^$r^(@^.>^\"d^(s^-j^.V",
      "encoded_base64": "ICBeKkZeJXteIT1eLlReJHJeKEBeLj5eImReKHNeLWpeLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_7f54bf3909a3",
      "text": "  關於雙足飛龍大師，你了解多少？",
      "encoded_ascii": "  ^.>^$^^)_^(^^)z^*>^\"z^#M^*A^*F^*D^(I^\"x^#<^.V",
      "encoded_base64": "ICBeLj5eJF5eKV9eKF5eKXpeKj5eInpeI01eKkFeKkZeKkReKEleInheIzxeLlY=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_5f79f25ecbae",
      "text": "  關於塔拉，你知道些什麼？",
      "encoded_ascii": "  ^.>^$^^\"o^$6^*A^*F^&h^(y^!8^!=^.T^.V",
      "encoded_base64": "ICBeLj5eJF5eIm9eJDZeKkFeKkZeJmheKHleITheIT1eLlReLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_10ce2a20f572",
      "text": "  塔拉和強盜們居然會是盟友，真不可思議。",
      "encoded_ascii": "  ^\"o^$6^\"O^#]^0!^*{^+w^&\"^$r^,X^-0^\"8^*A^-2^!)^\"A^#q^-|^!\"",
      "encoded_base64": "ICBeIm9eJDZeIk9eI11eMCFeKnteK3deJiJeJHJeLFheLTBeIjheKkFeLTJeISleIkFeI3FeLXxeISI=",
      "byte_length": 59
    },
    {
      "unit_id": "DLG_f123ad70efc4",
      "text": "  什麼是懸吊神廟？",
      "encoded_ascii": "  ^!=^.T^,X^0a^0S^&w^0[^.V",
      "encoded_base64": "ICBeIT1eLlReLFheMGFeMFNeJndeMFteLlY=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_11d2885012d6",
      "text": "  跟我說說風之魔藥的事。",
      "encoded_ascii": "  ^.+^$%^-x^-x^)y^!/^*0^()^&Z^*r^!\"",
      "encoded_base64": "ICBeLiteJCVeLXheLXheKXleIS9eKjBeKCleJlpeKnJeISI=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_c1211e9be875",
      "text": "  呼嘯之風精魂到底是什麼？",
      "encoded_ascii": "  ^\"M^0U^!/^)y^'7^*.^!u^/^^,X^!=^.T^.V",
      "encoded_base64": "ICBeIk1eMFVeIS9eKXleJzdeKi5eIXVeL15eLFheIT1eLlReLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_f0bb6e1204b4",
      "text": "  我聽夠了。",
      "encoded_ascii": "  ^$%^-X^+d^*D^!\"",
      "encoded_base64": "ICBeJCVeLVheK2ReKkReISI=",
      "byte_length": 17
    },
    {
      "unit_id": "DLG_83181617bba6",
      "text": "它引導了呼嘯之風精魂的神聖力量。當塔拉…… ",
      "encoded_ascii": "^+o^#Z^10^*D^\"M^0U^!/^)y^'7^*.^&Z^&w^'Z^!~^)*^!\"^&N^\"o^$6^*o^*o ",
      "encoded_base64": "XitvXiNaXjEwXipEXiJNXjBVXiEvXil5Xic3XiouXiZaXiZ3XidaXiF+XikqXiEiXiZOXiJvXiQ2XipvXipvIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_76b56c44b256",
      "text": "處於最虛弱的狀態時，風之魔藥將能把她軀體的碎片…… ",
      "encoded_ascii": "^(,^$^^$q^-g^#\\^&Z^&7^#|^$f^*A^)y^!/^*0^()^#7^'b^$1^+h^(d^**^&Z^&o^&1^*o^*o ",
      "encoded_base64": "XigsXiReXiRxXi1nXiNcXiZaXiY3XiN8XiRmXipBXil5XiEvXiowXigpXiM3XidiXiQxXitoXihkXioqXiZaXiZvXiYxXipvXipvIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_00381562e510",
      "text": "吹散到亞薩斯的各個角落。雖然她的意識依然殘存，但她的肉身…… ",
      "encoded_ascii": "^+A^$S^!u^!9^-e^$[^&Z^+>^!V^(H^-`^!\"^.A^&\"^+h^&Z^#z^(R^!Q^&\"^,l^#*^*A^!I^+h^&Z^'^^(c^*o^*o ",
      "encoded_base64": "XitBXiRTXiF1XiE5Xi1lXiRbXiZaXis+XiFWXihIXi1gXiEiXi5BXiYiXitoXiZaXiN6XihSXiFRXiYiXixsXiMqXipBXiFJXitoXiZaXideXihjXipvXipvIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_ed3354496bd6",
      "text": "將再也無法重聚現世。",
      "encoded_ascii": "^#7^!l^!1^%}^%b^))^'[^&?^*p^!\"",
      "encoded_base64": "XiM3XiFsXiExXiV9XiViXikpXidbXiY/XipwXiEi",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_9849903e9acd",
      "text": "呼嘯之風精魂為我帶來了調製魔藥的原料， ",
      "encoded_ascii": "^\"M^0U^!/^)y^'7^*.^%{^$%^#N^!O^*D^(Q^(B^*0^()^&Z^\"5^/n^*A ",
      "encoded_base64": "XiJNXjBVXiEvXil5Xic3XiouXiV7XiQlXiNOXiFPXipEXihRXihCXiowXigpXiZaXiI1Xi9uXipBIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_1ba56d4bfc8e",
      "text": "讓我能夠在暗中秘密將它調配完成。",
      "encoded_ascii": "^-}^$%^'b^+d^\"d^$k^!,^1O^#0^#7^+o^(Q^)&^#,^$$^!\"",
      "encoded_base64": "Xi19XiQlXidiXitkXiJkXiRrXiEsXjFPXiMwXiM3XitvXihRXikmXiMsXiQkXiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_7a76b8bfce46",
      "text": "呼嘯之風精魂是盤踞於這座高山險峰之間的…… ",
      "encoded_ascii": "^\"M^0U^!/^)y^'7^*.^,X^1M^1_^$^^(s^/_^*+^11^*m^12^!/^)G^&Z^*o^*o ",
      "encoded_base64": "XiJNXjBVXiEvXil5Xic3XiouXixYXjFNXjFfXiReXihzXi9fXiorXjExXiptXjEyXiEvXilHXiZaXipvXipvIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_3df2b739ad1c",
      "text": "自然元素偉力。這尊聖靈…… ",
      "encoded_ascii": "^'l^&\"^!a^'=^*}^!~^!\"^(s^+u^'Z^)g^*o^*o ",
      "encoded_base64": "XidsXiYiXiFhXic9Xip9XiF+XiEiXihzXit1XidaXilnXipvXipvIA==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_a00be9c4dc3c",
      "text": "賦予了我守護這片狂風呼嘯荒野的強大神力。",
      "encoded_ascii": "^(Y^!4^*D^$%^#+^(T^(s^&1^&8^)y^\"M^0U^1W^.:^&Z^#]^\"z^&w^!~^!\"",
      "encoded_base64": "XihZXiE0XipEXiQlXiMrXihUXihzXiYxXiY4Xil5XiJNXjBVXjFXXi46XiZaXiNdXiJ6XiZ3XiF+XiEi",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_0b06ff3f1240",
      "text": " 請記住，你們必須在塔拉被打倒…… ",
      "encoded_ascii": " ^*S^(K^*z^*A^*F^*{^#l^)r^\"d^\"o^$6^(@^$-^!X^*o^*o ",
      "encoded_base64": "IF4qU14oS14qel4qQV4qRl4qe14jbF4pcl4iZF4ib14kNl4oQF4kLV4hWF4qb14qbyA=",
      "byte_length": 50
    },
    {
      "unit_id": "DLG_d9a7361fb6d9",
      "text": "且身形消散的瞬間立刻使用魔藥。 ",
      "encoded_ascii": "^!*^(c^#_^%k^$S^&Z^1N^)G^0'^.Y^!N^&H^*0^()^!\" ",
      "encoded_base64": "XiEqXihjXiNfXiVrXiRTXiZaXjFOXilHXjAnXi5ZXiFOXiZIXiowXigpXiEiIA==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_52eb72c76d02",
      "text": "他不過是個普通的強盜頭子。飛龍騎鉤是他唯一的倚仗…… ",
      "encoded_ascii": "^!@^!)^(x^,X^!V^$g^(t^&Z^#]^0!^)t^#(^!\"^)z^*>^0K^)/^,X^!@^+O^!%^&Z^0~^0|^*o^*o ",
      "encoded_base64": "XiFAXiEpXih4XixYXiFWXiRnXih0XiZaXiNdXjAhXil0XiMoXiEiXil6Xio+XjBLXikvXixYXiFAXitPXiElXiZaXjB+XjB8XipvXipvIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_373f4fcb3513",
      "text": "那是塔拉賜給他的。不過他倒是挺機靈的，機靈到…… ",
      "encoded_ascii": "^)!^,X^\"o^$6^.#^'A^!@^&Z^!\"^!)^(x^!@^!X^,X^,I^%>^)g^&Z^*A^%>^)g^!u^*o^*o ",
      "encoded_base64": "XikhXixYXiJvXiQ2Xi4jXidBXiFAXiZaXiEiXiEpXih4XiFAXiFYXixYXixJXiU+XilnXiZaXipBXiU+XilnXiF1XipvXipvIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_bb569e92814a",
      "text": "當初找到塔拉時，能夠保住性命沒被她當場殺死。",
      "encoded_ascii": "^&N^1\"^$/^!u^\"o^$6^$f^*A^'b^+d^!T^*z^#r^\"N^%\\^(@^+h^&N^\"n^%M^%L^!\"",
      "encoded_base64": "XiZOXjEiXiQvXiF1XiJvXiQ2XiRmXipBXidiXitkXiFUXip6XiNyXiJOXiVcXihAXitoXiZOXiJuXiVNXiVMXiEi",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_a5df9a9c5034",
      "text": "太好了！ ",
      "encoded_ascii": "^+f^+i^*D^*W ",
      "encoded_base64": "XitmXitpXipEXipXIA==",
      "byte_length": 13
    },
    {
      "unit_id": "DLG_fb8c72296dc8",
      "text": "無論如何先把魔藥收下吧。要是你們不消滅塔拉，你們在此所做的一切…… ",
      "encoded_ascii": "^%}^1\\^#$^!L^!b^$1^*0^()^$M^!(^*I^!\"^(C^,X^*F^*{^!)^%k^%t^\"o^$6^*A^*F^*{^\"d^%I^$)^*~^&Z^!%^+.^*o^*o ",
      "encoded_base64": "XiV9XjFcXiMkXiFMXiFiXiQxXiowXigpXiRNXiEoXipJXiEiXihDXixYXipGXip7XiEpXiVrXiV0XiJvXiQ2XipBXipGXip7XiJkXiVJXiQpXip+XiZaXiElXisuXipvXipvIA==",
      "byte_length": 100
    },
    {
      "unit_id": "DLG_eba4324cf0bb",
      "text": "努力都將付諸東流。",
      "encoded_ascii": "^1$^!~^)$^#7^*u^1]^,`^%j^!\"",
      "encoded_base64": "XjEkXiF+XikkXiM3Xip1XjFdXixgXiVqXiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_a09f8f438de9",
      "text": " 來吧。還有更緊迫的事情需要我們處理。",
      "encoded_ascii": " ^!O^*I^!\"^.7^$s^$o^0r^1`^&Z^*r^,0^)e^(C^$%^*{^(,^&A^!\"",
      "encoded_base64": "IF4hT14qSV4hIl4uN14kc14kb14wcl4xYF4mWl4qcl4sMF4pZV4oQ14kJV4qe14oLF4mQV4hIg==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_5369a3e9bca0",
      "text": "呼嘯之風精魂派我來這裡解救雙足飛龍， ",
      "encoded_ascii": "^\"M^0U^!/^)y^'7^*.^.n^$%^!O^(s^-j^(I^,Q^)_^(^^)z^*>^*A ",
      "encoded_base64": "XiJNXjBVXiEvXil5Xic3XiouXi5uXiQlXiFPXihzXi1qXihJXixRXilfXiheXil6Xio+XipBIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_ae4ea47819e9",
      "text": "但我被打敗了。當雙足飛龍大師發現我掌握著…… ",
      "encoded_ascii": "^!I^$%^(@^$-^$R^*D^!\"^&N^)_^(^^)z^*>^\"z^#M^&W^&?^$%^$;^1>^-a^*o^*o ",
      "encoded_base64": "XiFJXiQlXihAXiQtXiRSXipEXiEiXiZOXilfXiheXil6Xio+XiJ6XiNNXiZXXiY/XiQlXiQ7XjE+Xi1hXipvXipvIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_1ee7f48fb6a5",
      "text": "消滅塔拉的方法時，他留了我一命，用來逼迫塔拉乖乖合作。",
      "encoded_ascii": "^%k^%t^\"o^$6^&Z^$]^%b^$f^*A^!@^-+^*D^$%^!%^\"N^*A^&H^!O^.1^1`^\"o^$6^0{^0{^\"C^!M^!\"",
      "encoded_base64": "XiVrXiV0XiJvXiQ2XiZaXiRdXiViXiRmXipBXiFAXi0rXipEXiQlXiElXiJOXipBXiZIXiFPXi4xXjFgXiJvXiQ2XjB7XjB7XiJDXiFNXiEi",
      "byte_length": 81
    },
    {
      "unit_id": "DLG_b058bef2b79b",
      "text": "塔拉為了爭奪內在之眼的統治權與她的兄弟納吉自相殘殺，但是…… ",
      "encoded_ascii": "^\"o^$6^%{^*D^1I^1,^!g^\"d^!/^&d^&Z^'B^%_^1E^'p^+h^&Z^1!^16^';^\"D^'l^&a^,l^%M^*A^!I^,X^*o^*o ",
      "encoded_base64": "XiJvXiQ2XiV7XipEXjFJXjEsXiFnXiJkXiEvXiZkXiZaXidCXiVfXjFFXidwXitoXiZaXjEhXjE2Xic7XiJEXidsXiZhXixsXiVNXipBXiFJXixYXipvXipvIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_bb6aec7af446",
      "text": "誰也沒有得勝。納吉戰死，而塔拉則遭受了永世的詛咒。",
      "encoded_ascii": "^-y^!1^%\\^$s^#e^+5^!\"^';^\"D^$(^%L^*A^'W^\"o^$6^!x^(}^\";^*D^%W^*p^&Z^(L^\"P^!\"",
      "encoded_base64": "Xi15XiExXiVcXiRzXiNlXis1XiEiXic7XiJEXiQoXiVMXipBXidXXiJvXiQ2XiF4Xih9XiI7XipEXiVXXipwXiZaXihMXiJQXiEi",
      "byte_length": 75
    },
    {
      "unit_id": "DLG_ac99287f4998",
      "text": "你們身上帶著的護符是納吉的遺物，能夠提供…… ",
      "encoded_ascii": "^*F^*{^(c^!'^#N^-a^&Z^(T^'+^,X^';^\"D^&Z^0v^&4^*A^'b^+d^$A^!P^*o^*o ",
      "encoded_base64": "XipGXip7XihjXiEnXiNOXi1hXiZaXihUXicrXixYXic7XiJEXiZaXjB2XiY0XipBXidiXitkXiRBXiFQXipvXipvIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_9b5f678fb470",
      "text": "抵禦塔拉邪惡力量的一定防護。",
      "encoded_ascii": "^$5^&{^\"o^$6^)\"^#y^!~^)*^&Z^!%^#.^)K^(T^!\"",
      "encoded_base64": "XiQ1XiZ7XiJvXiQ2XikiXiN5XiF+XikqXiZaXiElXiMuXilLXihUXiEi",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_8d366a119d05",
      "text": "內在之眼是一個專精於附魔與惑控法術的巫師學派。 ",
      "encoded_ascii": "^!g^\"d^!/^&d^,X^!%^!V^#8^'7^$^^.?^*0^'p^#x^$@^%b^(<^&Z^14^#M^+n^.n^!\" ",
      "encoded_base64": "XiFnXiJkXiEvXiZkXixYXiElXiFWXiM4Xic3XiReXi4/XiowXidwXiN4XiRAXiViXig8XiZaXjE0XiNNXituXi5uXiEiIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_69d35d1c9eef",
      "text": "我相信他們曾妄想有朝一日能挑戰…… ",
      "encoded_ascii": "^$%^&a^!U^!@^*{^.j^+j^,1^$s^,^^!%^$a^'b^,H^$(^*o^*o ",
      "encoded_base64": "XiQlXiZhXiFVXiFAXip7Xi5qXitqXiwxXiRzXixeXiElXiRhXidiXixIXiQoXipvXipvIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_39ab17e42bb8",
      "text": "城邦巫王。亞薩斯…… ",
      "encoded_ascii": "^+_^1a^14^-)^!\"^!9^-e^$[^*o^*o ",
      "encoded_base64": "XitfXjFhXjE0Xi0pXiEiXiE5Xi1lXiRbXipvXipvIA==",
      "byte_length": 31
    },
    {
      "unit_id": "DLG_82769c6b8c28",
      "text": "總算能夠……",
      "encoded_ascii": "^-M^-C^'b^+d^*o^*o",
      "encoded_base64": "Xi1NXi1DXidiXitkXipvXipv",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_82bf4fe2053e",
      "text": " 徹底擺脫他們那殘酷邪惡的魔法了。",
      "encoded_ascii": " ^18^/^^1@^'c^!@^*{^)!^,l^1b^)\"^#y^&Z^*0^%b^*D^!\"",
      "encoded_base64": "IF4xOF4vXl4xQF4nY14hQF4qe14pIV4sbF4xYl4pIl4jeV4mWl4qMF4lYl4qRF4hIg==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_dc51f411b528",
      "text": "那是一件必須被摧毀的邪惡器具！雙足飛龍本應在…… ",
      "encoded_ascii": "^)!^,X^!%^.W^#l^)r^(@^$E^%N^&Z^)\"^#y^\"V^!k^*W^)_^(^^)z^*>^$x^0`^\"d^*o^*o ",
      "encoded_base64": "XikhXixYXiElXi5XXiNsXilyXihAXiRFXiVOXiZaXikiXiN5XiJWXiFrXipXXilfXiheXil6Xio+XiR4XjBgXiJkXipvXipvIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_88ebfd055a07",
      "text": "我的庇護下自由翱翔於風中。然而那根騎鉤…… ",
      "encoded_ascii": "^$%^&Z^,\"^(T^!(^'l^&I^1S^1R^$^^)y^!,^!\"^&\"^'W^)!^%)^0K^)/^*o^*o ",
      "encoded_base64": "XiQlXiZaXiwiXihUXiEoXidsXiZJXjFTXjFSXiReXil5XiEsXiEiXiYiXidXXikhXiUpXjBLXikvXipvXipvIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_5f24991e2693",
      "text": "卻扭曲了牠們的心智，讓牠們徹底喪失了自己的意志。",
      "encoded_ascii": "^1&^1;^$n^*D^-#^*{^&Z^#k^$i^*A^-}^-#^*{^18^/^^1)^\"|^*D^'l^#I^&Z^#z^#m^!\"",
      "encoded_base64": "XjEmXjE7XiRuXipEXi0jXip7XiZaXiNrXiRpXipBXi19Xi0jXip7XjE4Xi9eXjEpXiJ8XipEXidsXiNJXiZaXiN6XiNtXiEi",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_e9a23f6a7040",
      "text": "塔拉沒有挑三揀四的餘地。雙足飛龍大師在懸吊神廟為她提供…… ",
      "encoded_ascii": "^\"o^$6^%\\^$s^,H^!&^1=^\"[^&Z^1e^\"e^!\"^)_^(^^)z^*>^\"z^#M^\"d^0a^0S^&w^0[^%{^+h^$A^!P^*o^*o ",
      "encoded_base64": "XiJvXiQ2XiVcXiRzXixIXiEmXjE9XiJbXiZaXjFlXiJlXiEiXilfXiheXil6Xio+XiJ6XiNNXiJkXjBhXjBTXiZ3XjBbXiV7XitoXiRBXiFQXipvXipvIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_f865777f4c1b",
      "text": "活人祭品。她吸乾祭品的生命以維持肉身不腐。相對地…… ",
      "encoded_ascii": "^%i^!<^&x^\"R^!\"^+h^\"J^*X^&x^\"R^&Z^&F^\"N^!B^'F^$7^'^^(c^!)^0/^!\"^&a^#:^\"e^*o^*o ",
      "encoded_base64": "XiVpXiE8XiZ4XiJSXiEiXitoXiJKXipYXiZ4XiJSXiZaXiZGXiJOXiFCXidGXiQ3XideXihjXiEpXjAvXiEiXiZhXiM6XiJlXipvXipvIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_ee28a1840159",
      "text": "塔拉則賦予大師發動掠奪突襲的力量。",
      "encoded_ascii": "^\"o^$6^!x^(Y^!4^\"z^#M^&W^\"%^1<^1,^'*^08^&Z^!~^)*^!\"",
      "encoded_base64": "XiJvXiQ2XiF4XihZXiE0XiJ6XiNNXiZXXiIlXjE8XjEsXicqXjA4XiZaXiF+XikqXiEi",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_8604d9f2e7d7",
      "text": "雙足飛龍欄舍西面的懸吊神廟，是雙足飛龍大師的主意。 ",
      "encoded_ascii": "^)_^(^^)z^*>^%C^03^-l^)j^&Z^0a^0S^&w^0[^*A^,X^)_^(^^)z^*>^\"z^#M^&Z^!-^#z^!\" ",
      "encoded_base64": "XilfXiheXil6Xio+XiVDXjAzXi1sXilqXiZaXjBhXjBTXiZ3XjBbXipBXixYXilfXiheXil6Xio+XiJ6XiNNXiZaXiEtXiN6XiEiIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_5f1e2f3c886b",
      "text": "他敲響銅鑼，大張旗鼓地召喚塔拉前來享用人牲盛宴。 ",
      "encoded_ascii": "^!@^1A^)o^0x^)B^*A^\"z^,(^1B^*<^\"e^\"@^\"U^\"o^$6^!z^!O^!;^&H^!<^1J^1L^1/^!\" ",
      "encoded_base64": "XiFAXjFBXilvXjB4XilCXipBXiJ6XiwoXjFCXio8XiJlXiJAXiJVXiJvXiQ2XiF6XiFPXiE7XiZIXiE8XjFKXjFMXjEvXiEiIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_678a778143f0",
      "text": "這一切諂媚行徑，無非是為了轉移塔拉貪婪飢渴的目光，保住大師自己的性命。",
      "encoded_ascii": "^(s^!%^+.^1[^1.^(;^#c^*A^%}^)i^,X^%{^*D^(i^'\"^\"o^$6^1^^1-^1d^,w^&Z^&^^!c^*A^!T^*z^\"z^#M^'l^#I^&Z^#r^\"N^!\"",
      "encoded_base64": "XihzXiElXisuXjFbXjEuXig7XiNjXipBXiV9XilpXixYXiV7XipEXihpXiciXiJvXiQ2XjFeXjEtXjFkXix3XiZaXiZeXiFjXipBXiFUXip6XiJ6XiNNXidsXiNJXiZaXiNyXiJOXiEi",
      "byte_length": 105
    },
    {
      "unit_id": "DLG_6da20c301706",
      "text": "當然。",
      "encoded_ascii": "^&N^&\"^!\"",
      "encoded_base64": "XiZOXiYiXiEi",
      "byte_length": 9
    },
    {
      "unit_id": "DLG_9b676b6d1d6f",
      "text": "在你們離開前，還有什麼需要我效勞的嗎？",
      "encoded_ascii": "^\"d^*F^*{^)`^)F^!z^*A^.7^$s^!=^.T^)e^(C^$%^$Q^/R^&Z^+X^.V",
      "encoded_base64": "XiJkXipGXip7XilgXilGXiF6XipBXi43XiRzXiE9Xi5UXillXihDXiQlXiRRXi9SXiZaXitYXi5W",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_c5bb50e48a8f",
      "text": "我就在這裡靜候你們凱旋歸來。",
      "encoded_ascii": "^$%^*J^\"d^(s^-j^)h^*|^*F^*{^!p^$`^%K^!O^!\"",
      "encoded_base64": "XiQlXipKXiJkXihzXi1qXiloXip8XipGXip7XiFwXiRgXiVLXiFPXiEi",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_e2c7ed0a1652",
      "text": "頭骨神廟必須嚴加把守，直到所有狂信徒都被擊退為止。 ",
      "encoded_ascii": "^)t^*$^&w^0[^#l^)r^1*^\"\"^$1^#+^*A^&`^!u^$)^$s^&8^!U^#d^)$^(@^$F^*V^%{^%G^!\" ",
      "encoded_base64": "Xil0XiokXiZ3XjBbXiNsXilyXjEqXiIiXiQxXiMrXipBXiZgXiF1XiQpXiRzXiY4XiFVXiNkXikkXihAXiRGXipWXiV7XiVHXiEiIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_c416017ae85e",
      "text": "求求你們，請務必在這件事上施以援手。",
      "encoded_ascii": "^,n^,n^*F^*{^*A^*S^+4^#l^\"d^(s^.W^*r^!'^$_^!B^$C^$+^!\"",
      "encoded_base64": "XixuXixuXipGXip7XipBXipTXis0XiNsXiJkXihzXi5XXipyXiEnXiRfXiFCXiRDXiQrXiEi",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_a71ecbe8e040",
      "text": "我永遠無法報答你們拯救了我女兒的性命，以及",
      "encoded_ascii": "^$%^%W^({^%}^%b^+`^-B^*F^*{^,F^,Q^*D^$%^#\"^++^&Z^#r^\"N^*A^!B^\"7",
      "encoded_base64": "XiQlXiVXXih7XiV9XiViXitgXi1CXipGXip7XixGXixRXipEXiQlXiMiXisrXiZaXiNyXiJOXipBXiFCXiI3",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_c205fcf9dce8",
      "text": "我和我族人萬分感謝你們",
      "encoded_ascii": "^$%^\"O^$%^5V^!<^-_^!s^#{^-z^*F^*{",
      "encoded_base64": "XiQlXiJPXiQlXjVWXiE8Xi1fXiFzXiN7Xi16XipGXip7",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_a4512c263e08",
      "text": " 拯救了頭骨神廟。雖然我如今僅剩感激之情與安全的庇護所能回報，但我仍願獻給你們 ",
      "encoded_ascii": " ^,F^,Q^*D^)t^*$^&w^0[^!\"^.A^&\"^$%^#$^*E^!_^8U^#{^1H^!/^,0^'p^+p^!h^&Z^,\"^(T^$)^'b^\"\\^+`^*A^!I^$%^!?^.H^-(^'A^*F^*{ ",
      "encoded_base64": "IF4sRl4sUV4qRF4pdF4qJF4md14wW14hIl4uQV4mIl4kJV4jJF4qRV4hX144VV4je14xSF4hL14sMF4ncF4rcF4haF4mWl4sIl4oVF4kKV4nYl4iXF4rYF4qQV4hSV4kJV4hP14uSF4tKF4nQV4qRl4qeyA=",
      "byte_length": 116
    },
    {
      "unit_id": "DLG_5d45240b3a00",
      "text": "以示謝意。你們想休息多久就休息多久——這裡絕不會有人打擾你們。",
      "encoded_ascii": "^!B^&s^-z^#z^!\"^*F^*{^,1^!G^#w^\"x^!.^*J^!G^#w^\"x^!.^*n^*n^(s^-j^-I^!)^$r^$s^!<^$-^$K^*F^*{^!\"",
      "encoded_base64": "XiFCXiZzXi16XiN6XiEiXipGXip7XiwxXiFHXiN3XiJ4XiEuXipKXiFHXiN3XiJ4XiEuXipuXipuXihzXi1qXi1JXiEpXiRyXiRzXiE8XiQtXiRLXipGXip7XiEi",
      "byte_length": 93
    },
    {
      "unit_id": "DLG_5e39cc25ae11",
      "text": "求求你們，讓我一個人沉浸在悲痛中吧。",
      "encoded_ascii": "^,n^,n^*F^*{^*A^-}^$%^!%^!V^!<^%Z^=Z^\"d^,.^-.^!,^*I^!\"",
      "encoded_base64": "XixuXixuXipGXip7XipBXi19XiQlXiElXiFWXiE8XiVaXj1aXiJkXiwuXi0uXiEsXipJXiEi",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_0c17cfebcf4d",
      "text": "快！",
      "encoded_ascii": "^*L^*W",
      "encoded_base64": "XipMXipX",
      "byte_length": 6
    },
    {
      "unit_id": "DLG_84de536a281b",
      "text": "狂信徒隨時都會進攻東邊的頭骨神廟！",
      "encoded_ascii": "^&8^!U^#d^)X^$f^)$^$r^(w^$O^,`^.8^&Z^)t^*$^&w^0[^*W",
      "encoded_base64": "XiY4XiFVXiNkXilYXiRmXikkXiRyXih3XiRPXixgXi44XiZaXil0XiokXiZ3XjBbXipX",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_6e723405a926",
      "text": "站在原地別動，奴隸！",
      "encoded_ascii": "^->^\"d^\"5^\"e^*H^\"%^*A^##^)Z^*W",
      "encoded_base64": "Xi0+XiJkXiI1XiJlXipIXiIlXipBXiMjXilaXipX",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_39c0be58c0ff",
      "text": "你要我帶你去見酋長嗎？",
      "encoded_ascii": "^*F^(C^$%^#N^*F^\"6^-m^=5^)C^+X^.V",
      "encoded_base64": "XipGXihDXiQlXiNOXipGXiI2Xi1tXj01XilDXitYXi5W",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_18149625b0a9",
      "text": "那就跟我來吧。",
      "encoded_ascii": "^)!^*J^.+^$%^!O^*I^!\"",
      "encoded_base64": "XikhXipKXi4rXiQlXiFPXipJXiEi",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_3570969e279f",
      "text": "哈哈！難道沒人告訴過你，從來沒有人能逃出奴隸欄嗎？",
      "encoded_ascii": "^+F^+F^*W^)a^(y^%\\^!<^+B^-t^(x^*F^*A^#f^!O^%\\^$s^!<^'b^(p^!q^##^)Z^%C^+X^.V",
      "encoded_base64": "XitGXitGXipXXilhXih5XiVcXiE8XitCXi10Xih4XipGXipBXiNmXiFPXiVcXiRzXiE8XidiXihwXiFxXiMjXilaXiVDXitYXi5W",
      "byte_length": 75
    },
    {
      "unit_id": "DLG_4cc5f5b4e955",
      "text": "現在你就為你的愚蠢受死吧！",
      "encoded_ascii": "^&?^\"d^*F^*J^%{^*F^&Z^/a^.u^\";^%L^*I^*W",
      "encoded_base64": "XiY/XiJkXipGXipKXiV7XipGXiZaXi9hXi51XiI7XiVMXipJXipX",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_2bf8c1963dbc",
      "text": "南",
      "encoded_ascii": "^\"/",
      "encoded_base64": "XiIv",
      "byte_length": 3
    },
    {
      "unit_id": "DLG_23ae105a20d8",
      "text": "北邊",
      "encoded_ascii": "^+6^.8",
      "encoded_base64": "Xis2Xi44",
      "byte_length": 6
    },
    {
      "unit_id": "DLG_f256ddaeaf5b",
      "text": "通往 ",
      "encoded_ascii": "^(t^,) ",
      "encoded_base64": "Xih0XiwpIA==",
      "byte_length": 7
    },
    {
      "unit_id": "DLG_9e01ec3a3dfe",
      "text": " 方向的牆面潮濕又滑溜。你要試著攀爬上去嗎？",
      "encoded_ascii": " ^$]^+?^&Z^&0^)j^=[^=\\^+;^%u^%r^!\"^*F^(C^-u^-a^8|^/y^!'^\"6^+X^.V",
      "encoded_base64": "IF4kXV4rP14mWl4mMF4pal49W149XF4rO14ldV4lcl4hIl4qRl4oQ14tdV4tYV44fF4veV4hJ14iNl4rWF4uVg==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_38b1c9c736b1",
      "text": " 輕鬆自如地翻越了這道牆。",
      "encoded_ascii": " ^(g^.R^'l^#$^\"e^-Q^(]^*D^(s^(y^&0^!\"",
      "encoded_base64": "IF4oZ14uUl4nbF4jJF4iZV4tUV4oXV4qRF4oc14oeV4mMF4hIg==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_4c6647d9c2e7",
      "text": " 毫不費力地攀上了牆壁。",
      "encoded_ascii": " ^/t^!)^.\"^!~^\"e^8|^!'^*D^&0^*\\^!\"",
      "encoded_base64": "IF4vdF4hKV4uIl4hfl4iZV44fF4hJ14qRF4mMF4qXF4hIg==",
      "byte_length": 34
    },
    {
      "unit_id": "DLG_dabc0f37dcaf",
      "text": " 沒能找到穩固的立足點。",
      "encoded_ascii": " ^%\\^'b^$/^!u^-;^3>^&Z^0'^(^^*;^!\"",
      "encoded_base64": "IF4lXF4nYl4kL14hdV4tO14zPl4mWl4wJ14oXl4qO14hIg==",
      "byte_length": 34
    },
    {
      "unit_id": "DLG_cc7c35450b4f",
      "text": "你要爬下去進入下層地道嗎？",
      "encoded_ascii": "^*F^(C^/y^!(^\"6^(w^!f^!(^#B^\"e^(y^+X^.V",
      "encoded_base64": "XipGXihDXi95XiEoXiI2Xih3XiFmXiEoXiNCXiJlXih5XitYXi5W",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_3c563fe8b9e6",
      "text": "你想要離開下水道嗎？",
      "encoded_ascii": "^*F^,1^(C^)`^)F^!(^%V^(y^+X^.V",
      "encoded_base64": "XipGXiwxXihDXilgXilGXiEoXiVWXih5XitYXi5W",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_301dabddf9f2",
      "text": "快幫我找出其餘的狂信徒！我們必須保護長老！",
      "encoded_ascii": "^*L^+}^$%^$/^!q^!j^1e^&Z^&8^!U^#d^*W^$%^*{^#l^)r^!T^(T^)C^'U^*W",
      "encoded_base64": "XipMXit9XiQlXiQvXiFxXiFqXjFlXiZaXiY4XiFVXiNkXipXXiQlXip7XiNsXilyXiFUXihUXilDXidVXipX",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_01bec592fe99",
      "text": "滾開！你們不能進來這裡！",
      "encoded_ascii": "^,z^)F^*W^*F^*{^!)^'b^(w^!O^(s^-j^*W",
      "encoded_base64": "Xix6XilGXipXXipGXip7XiEpXidiXih3XiFPXihzXi1qXipX",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_395f6d708256",
      "text": "我提醒你們，嚴禁擅闖頭骨神廟，亦不得 ",
      "encoded_ascii": "^$%^$A^.9^*F^*{^*A^1*^&y^2$^.z^)t^*$^&w^0[^*A^7#^!)^#e ",
      "encoded_base64": "XiQlXiRBXi45XipGXip7XipBXjEqXiZ5XjIkXi56Xil0XiokXiZ3XjBbXipBXjcjXiEpXiNlIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_e55653b1391c",
      "text": "觸碰任何物品。純粹是我們的寬容才讓你們走到這裡。",
      "encoded_ascii": "^(J^-5^!C^!L^&4^\"R^!\"^3\"^5r^,X^$%^*{^&Z^3l^+t^$,^-}^*F^*{^.&^!u^(s^-j^!\"",
      "encoded_base64": "XihKXi01XiFDXiFMXiY0XiJSXiEiXjMiXjVyXixYXiQlXip7XiZaXjNsXit0XiQsXi19XipGXip7Xi4mXiF1XihzXi1qXiEi",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_181d06007e2c",
      "text": "這裡不歡迎你們！此地乃神聖之處，嚴禁 ",
      "encoded_ascii": "^(s^-j^!)^%F^(k^*F^*{^*W^%I^\"e^/M^&w^'Z^!/^(,^*A^1*^&y ",
      "encoded_base64": "XihzXi1qXiEpXiVGXihrXipGXip7XipXXiVJXiJlXi9NXiZ3XidaXiEvXigsXipBXjEqXiZ5IA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_994f26f2c0d6",
      "text": "不配者擅入。",
      "encoded_ascii": "^!)^)&^'V^2$^!f^!\"",
      "encoded_base64": "XiEpXikmXidWXjIkXiFmXiEi",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_f2112f4cc199",
      "text": "向你們致敬。請進，聆聽先哲的智慧吧。頭骨神廟的 ",
      "encoded_ascii": "^+?^*F^*{^'o^*O^!\"^*S^(w^*A^3$^-X^!b^+J^&Z^$i^4;^*I^!\"^)t^*$^&w^0[^&Z ",
      "encoded_base64": "Xis/XipGXip7XidvXipPXiEiXipTXih3XipBXjMkXi1YXiFiXitKXiZaXiRpXjQ7XipJXiEiXil0XiokXiZ3XjBbXiZaIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_b4a0637d8afd",
      "text": "長老們非常感激你們英勇保衛神廟的壯舉。",
      "encoded_ascii": "^)C^'U^*{^)i^#O^#{^1H^*F^*{^'y^\"$^!T^(=^&w^0[^&Z^+b^01^!\"",
      "encoded_base64": "XilDXidVXip7XilpXiNPXiN7XjFIXipGXip7Xid5XiIkXiFUXig9XiZ3XjBbXiZaXitiXjAxXiEi",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_eb44ccae1588",
      "text": "  我是為和平而來的。",
      "encoded_ascii": "  ^$%^,X^%{^\"O^0Y^'W^!O^&Z^!\"",
      "encoded_base64": "ICBeJCVeLFheJXteIk9eMFleJ1deIU9eJlpeISI=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_6c02d9311649",
      "text": "  我要求進入！",
      "encoded_ascii": "  ^$%^(C^,n^(w^!f^*W",
      "encoded_base64": "ICBeJCVeKENeLG5eKHdeIWZeKlc=",
      "byte_length": 20
    },
    {
      "unit_id": "DLG_c716a1aafb95",
      "text": "  我只是想離開這座下水道。",
      "encoded_ascii": "  ^$%^\"?^,X^,1^)`^)F^(s^/_^!(^%V^(y^!\"",
      "encoded_base64": "ICBeJCVeIj9eLFheLDFeKWBeKUZeKHNeL19eISheJVZeKHleISI=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_c603fe1426c7",
      "text": "只要你們發誓絕不觸碰任何物品，就可以留下來。你們願意發誓嗎？",
      "encoded_ascii": "^\"?^(C^*F^*{^&W^-w^-I^!)^(J^-5^!C^!L^&4^\"R^*A^*J^\"A^!B^-+^!(^!O^!\"^*F^*{^.H^#z^&W^-w^+X^.V",
      "encoded_base64": "XiI/XihDXipGXip7XiZXXi13Xi1JXiEpXihKXi01XiFDXiFMXiY0XiJSXipBXipKXiJBXiFCXi0rXiEoXiFPXiEiXipGXip7Xi5IXiN6XiZXXi13XitYXi5W",
      "byte_length": 90
    },
    {
      "unit_id": "DLG_5d17bcc6de20",
      "text": "那麼你們可以留下來。如果願意，你們可以向長老們祈求賜予智慧。",
      "encoded_ascii": "^)!^.T^*F^*{^\"A^!B^-+^!(^!O^!\"^#$^%!^.H^#z^*A^*F^*{^\"A^!B^+?^)C^'U^*{^&u^,n^.#^!4^$i^4;^!\"",
      "encoded_base64": "XikhXi5UXipGXip7XiJBXiFCXi0rXiEoXiFPXiEiXiMkXiUhXi5IXiN6XipBXipGXip7XiJBXiFCXis/XilDXidVXip7XiZ1XixuXi4jXiE0XiRpXjQ7XiEi",
      "byte_length": 90
    },
    {
      "unit_id": "DLG_3d48a83d1e8b",
      "text": "你們竟敢玷污我們的聖地！滾出這裡！",
      "encoded_ascii": "^*F^*{^28^/m^1K^0h^$%^*{^&Z^'Z^\"e^*W^,z^!q^(s^-j^*W",
      "encoded_base64": "XipGXip7XjI4Xi9tXjFLXjBoXiQlXip7XiZaXidaXiJlXipXXix6XiFxXihzXi1qXipX",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_0b3288c947a0",
      "text": "那就去別處找吧！在此處，唯有死亡才是你們的解脫之道。",
      "encoded_ascii": "^)!^*J^\"6^*H^(,^$/^*I^*W^\"d^%I^(,^*A^+O^$s^%L^!:^$,^,X^*F^*{^&Z^(I^'c^!/^(y^!\"",
      "encoded_base64": "XikhXipKXiI2XipIXigsXiQvXipJXipXXiJkXiVJXigsXipBXitPXiRzXiVMXiE6XiQsXixYXipGXip7XiZaXihJXidjXiEvXih5XiEi",
      "byte_length": 78
    },
    {
      "unit_id": "DLG_d75d052fe38f",
      "text": "  這座頭骨神廟是做什麼用的？",
      "encoded_ascii": "  ^(s^/_^)t^*$^&w^0[^,X^*~^!=^.T^&H^&Z^.V",
      "encoded_base64": "ICBeKHNeL19eKXReKiReJndeMFteLFheKn5eIT1eLlReJkheJlpeLlY=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_33b068b384e7",
      "text": "  能跟我說說長老們的事嗎？",
      "encoded_ascii": "  ^'b^.+^$%^-x^-x^)C^'U^*{^&Z^*r^+X^.V",
      "encoded_base64": "ICBeJ2JeLiteJCVeLXheLXheKUNeJ1VeKnteJlpeKnJeK1heLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_b1c97764297e",
      "text": "  關於綁架事件，你都知道些什麼？",
      "encoded_ascii": "  ^.>^$^^-K^%\"^*r^.W^*A^*F^)$^&h^(y^!8^!=^.T^.V",
      "encoded_base64": "ICBeLj5eJF5eLUteJSJeKnJeLldeKkFeKkZeKSReJmheKHleITheIT1eLlReLlY=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_ec165a762087",
      "text": "  你和其他鼠人長得不太一樣。",
      "encoded_ascii": "  ^*F^\"O^!j^!@^*=^!<^)C^#e^!)^+f^!%^,f^!\"",
      "encoded_base64": "ICBeKkZeIk9eIWpeIUBeKj1eITxeKUNeI2VeISleK2ZeISVeLGZeISI=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_39887d6f6839",
      "text": "  你是怎麼變成這樣的？",
      "encoded_ascii": "  ^*F^,X^,,^.T^(U^$$^(s^,f^&Z^.V",
      "encoded_base64": "ICBeKkZeLFheLCxeLlReKFVeJCReKHNeLGZeJlpeLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_c662a0e4ce72",
      "text": "  誰是達戈拉爾？",
      "encoded_ascii": "  ^-y^,X^(z^*M^$6^&/^.V",
      "encoded_base64": "ICBeLXleLFheKHpeKk1eJDZeJi9eLlY=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_3ddee1fd8a03",
      "text": "  我要怎麼進去面見長老們？",
      "encoded_ascii": "  ^$%^(C^,,^.T^(w^\"6^)j^-m^)C^'U^*{^.V",
      "encoded_base64": "ICBeJCVeKENeLCxeLlReKHdeIjZeKWpeLW1eKUNeJ1VeKnteLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_0b21186adafd",
      "text": "頭骨神廟是我們祖先的神聖安息之所。每逢 ",
      "encoded_ascii": "^)t^*$^&w^0[^,X^$%^*{^/>^!b^&Z^&w^'Z^+p^#w^!/^$)^!\"^%P^7K ",
      "encoded_base64": "Xil0XiokXiZ3XjBbXixYXiQlXip7Xi8+XiFiXiZaXiZ3XidaXitwXiN3XiEvXiQpXiEiXiVQXjdLIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_80c6b8461535",
      "text": "危急之秋，合格的鼠人便可前來尋求長老們的指引。",
      "encoded_ascii": "^2\\^3p^!/^=^^*A^\"C^%*^&Z^*=^!<^!R^\"A^!z^!O^#9^,n^)C^'U^*{^&Z^$8^#Z^!\"",
      "encoded_base64": "XjJcXjNwXiEvXj1eXipBXiJDXiUqXiZaXio9XiE8XiFSXiJBXiF6XiFPXiM5XixuXilDXidVXip7XiZaXiQ4XiNaXiEi",
      "byte_length": 69
    },
    {
      "unit_id": "DLG_6de416186709",
      "text": "  長老們究竟是誰？",
      "encoded_ascii": "  ^)C^'U^*{^-<^28^,X^-y^.V",
      "encoded_base64": "ICBeKUNeJ1VeKnteLTxeMjheLFheLXleLlY=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_13af2d51e40e",
      "text": "  長老們的記憶是如何保存下來的？",
      "encoded_ascii": "  ^)C^'U^*{^&Z^(K^$\"^,X^#$^!L^!T^#*^!(^!O^&Z^.V",
      "encoded_base64": "ICBeKUNeJ1VeKnteJlpeKEteJCJeLFheIyReIUxeIVReIypeISheIU9eJlpeLlY=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_656b30d34bb1",
      "text": "  為什麼不是每次都會出現頭骨？",
      "encoded_ascii": "  ^%{^!=^.T^!)^,X^%P^%D^)$^$r^!q^&?^)t^*$^.V",
      "encoded_base64": "ICBeJXteIT1eLlReISleLFheJVBeJUReKSReJHJeIXFeJj9eKXReKiReLlY=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_8b6a703e587e",
      "text": "  長老們會給出什麼樣的建議？",
      "encoded_ascii": "  ^)C^'U^*{^$r^'A^!q^!=^.T^,f^&Z^,'^-|^.V",
      "encoded_base64": "ICBeKUNeJ1VeKnteJHJeJ0FeIXFeIT1eLlReLGZeJlpeLCdeLXxeLlY=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_c2d82b713a4d",
      "text": "  現在正是危急時刻。我可以面見長老嗎？",
      "encoded_ascii": "  ^&?^\"d^%H^,X^2\\^3p^$f^.Y^!\"^$%^\"A^!B^)j^-m^)C^'U^+X^.V",
      "encoded_base64": "ICBeJj9eImReJUheLFheMlxeM3BeJGZeLlleISJeJCVeIkFeIUJeKWpeLW1eKUNeJ1VeK1heLlY=",
      "byte_length": 56
    },
    {
      "unit_id": "DLG_5f93c0e08a2b",
      "text": "  你們那些頭骨的事我已經聽夠了。",
      "encoded_ascii": "  ^*F^*{^)!^!8^)t^*$^&Z^*r^$%^#J^'D^-X^+d^*D^!\"",
      "encoded_base64": "ICBeKkZeKnteKSFeITheKXReKiReJlpeKnJeJCVeI0peJ0ReLVheK2ReKkReISI=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_b684e9a2c788",
      "text": "我從不過問世俗之事。我的職責是守護 ",
      "encoded_ascii": "^$%^#f^!)^(x^*Z^*p^8e^!/^*r^!\"^$%^&Z^'\\^0>^,X^#+^(T ",
      "encoded_base64": "XiQlXiNmXiEpXih4XipaXipwXjhlXiEvXipyXiEiXiQlXiZaXidcXjA+XixYXiMrXihUIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_6a3912cc9aad",
      "text": "長老，除此之外別無旁騖。",
      "encoded_ascii": "^)C^'U^*A^)Q^%I^!/^\"w^*H^%}^.h^=c^!\"",
      "encoded_base64": "XilDXidVXipBXilRXiVJXiEvXiJ3XipIXiV9Xi5oXj1jXiEi",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_c78c085f2f52",
      "text": "我們曾經也和其他鼠人無異，但我們的虔誠改變了我們的容貌， ",
      "encoded_ascii": "^$%^*{^.j^'D^!1^\"O^!j^!@^*=^!<^%}^&M^*A^!I^$%^*{^&Z^=`^2E^$N^(U^*D^$%^*{^&Z^+t^-~^*A ",
      "encoded_base64": "XiQlXip7Xi5qXidEXiExXiJPXiFqXiFAXio9XiE8XiV9XiZNXipBXiFJXiQlXip7XiZaXj1gXjJFXiROXihVXipEXiQlXip7XiZaXit0Xi1+XipBIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_b15ba8e5da51",
      "text": "就像它重塑了我們的心靈一樣。",
      "encoded_ascii": "^*J^!`^+o^))^1s^*D^$%^*{^&Z^#k^)g^!%^,f^!\"",
      "encoded_base64": "XipKXiFgXitvXikpXjFzXipEXiQlXip7XiZaXiNrXilnXiElXixmXiEi",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_bb4bef2680d9",
      "text": "我們對那項奧秘毫無記憶。我只知道很久以前，有一群 ",
      "encoded_ascii": "^$%^*{^#:^)!^)q^6Q^1O^/t^%}^(K^$\"^!\"^$%^\"?^&h^(y^*K^!.^!B^!z^*A^$s^!%^'R ",
      "encoded_base64": "XiQlXip7XiM6XikhXilxXjZRXjFPXi90XiV9XihLXiQiXiEiXiQlXiI/XiZoXih5XipLXiEuXiFCXiF6XipBXiRzXiElXidSIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_407f5210c5aa",
      "text": "鼠人在臨終前被召喚去尋找達戈拉爾。他們歸來時 ",
      "encoded_ascii": "^*=^!<^\"d^1U^-H^!z^(@^\"@^\"U^\"6^#9^$/^(z^*M^$6^&/^!\"^!@^*{^%K^!O^$f ",
      "encoded_base64": "Xio9XiE8XiJkXjFVXi1IXiF6XihAXiJAXiJVXiI2XiM5XiQvXih6XipNXiQ2XiYvXiEiXiFAXip7XiVLXiFPXiRmIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_683bee4c2760",
      "text": "便成了你現在看到我的模樣，成為了頭骨守護者。",
      "encoded_ascii": "^!R^$$^*D^*F^&?^\"d^*Q^!u^$%^&Z^%:^,f^*A^$$^%{^*D^)t^*$^#+^(T^'V^!\"",
      "encoded_base64": "XiFSXiQkXipEXipGXiY/XiJkXipRXiF1XiQlXiZaXiU6XixmXipBXiQkXiV7XipEXil0XiokXiMrXihUXidWXiEi",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_b626740f43ce",
      "text": "使用交給你的骨製曲柄",
      "encoded_ascii": "^!N^&H^0P^'A^*F^&Z^*$^(B^$n^%#",
      "encoded_base64": "XiFOXiZIXjBQXidBXipGXiZaXiokXihCXiRuXiUj",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_dc022374fc4e",
      "text": "使用這支骨製曲柄",
      "encoded_ascii": "^!N^&H^(s^$L^*$^(B^$n^%#",
      "encoded_base64": "XiFOXiZIXihzXiRMXiokXihCXiRuXiUj",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_c9cd2101c620",
      "text": "。它能用來轉動輪盤。",
      "encoded_ascii": "^!\"^+o^'b^&H^!O^(i^\"%^(h^1M^!\"",
      "encoded_base64": "XiEiXitvXidiXiZIXiFPXihpXiIlXihoXjFNXiEi",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_3c24f667839c",
      "text": "長老們是已故鼠人的鮮活記憶。",
      "encoded_ascii": "^)C^'U^*{^,X^#J^5U^*=^!<^&Z^35^%i^(K^$\"^!\"",
      "encoded_base64": "XilDXidVXip7XixYXiNKXjVVXio9XiE8XiZaXjM1XiVpXihLXiQiXiEi",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_52d75ebd3361",
      "text": "證明自身價值的鼠人遺骸會被交給達戈拉爾。 ",
      "encoded_ascii": "^-{^$c^'l^(c^+&^!Z^&Z^*=^!<^0v^*'^$r^(@^0P^'A^(z^*M^$6^&/^!\" ",
      "encoded_base64": "Xi17XiRjXidsXihjXismXiFaXiZaXio9XiE8XjB2XionXiRyXihAXjBQXidBXih6XipNXiQ2XiYvXiEiIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_f62728617f7a",
      "text": "有時，神廟稍後會出現一顆新的頭骨，承載著 ",
      "encoded_ascii": "^$s^$f^*A^&w^0[^-:^#b^$r^!q^&?^!%^)u^$\\^&Z^)t^*$^*A^$0^64^-a ",
      "encoded_base64": "XiRzXiRmXipBXiZ3XjBbXi06XiNiXiRyXiFxXiY/XiElXil1XiRcXiZaXil0XiokXipBXiQwXjY0Xi1hIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_222476d401e0",
      "text": "那位長老的記憶。",
      "encoded_ascii": "^)!^!J^)C^'U^&Z^(K^$\"^!\"",
      "encoded_base64": "XikhXiFKXilDXidVXiZaXihLXiQiXiEi",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_a60624229ca5",
      "text": "只有配得上資格的鼠人才能成為長老。但我們往往會誤判 ",
      "encoded_ascii": "^\"?^$s^)&^#e^!'^(X^%*^&Z^*=^!<^$,^'b^$$^%{^)C^'U^!\"^!I^$%^*{^,)^,)^$r^(P^1k ",
      "encoded_base64": "XiI/XiRzXikmXiNlXiEnXihYXiUqXiZaXio9XiE8XiQsXidiXiQkXiV7XilDXidVXiEiXiFJXiQlXip7XiwpXiwpXiRyXihQXjFrIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_83ba48339ffc",
      "text": "究竟何謂合格。",
      "encoded_ascii": "^-<^28^!L^0s^\"C^%*^!\"",
      "encoded_base64": "Xi08XjI4XiFMXjBzXiJDXiUqXiEi",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_d36ded227205",
      "text": "他的本質對鼠人而言是一項神聖奧秘。你不該探問這種問題。",
      "encoded_ascii": "^!@^&Z^$x^(Z^#:^*=^!<^'W^1Y^,X^!%^)q^&w^'Z^6Q^1O^!\"^*F^!)^(M^$>^*Z^(s^'$^*Z^.G^!\"",
      "encoded_base64": "XiFAXiZaXiR4XihaXiM6Xio9XiE8XidXXjFZXixYXiElXilxXiZ3XidaXjZRXjFPXiEiXipGXiEpXihNXiQ+XipaXihzXickXipaXi5HXiEi",
      "byte_length": 81
    },
    {
      "unit_id": "DLG_4cd442476263",
      "text": "長老們掌握著我們整個種族所積累的 ",
      "encoded_ascii": "^)C^'U^*{^$;^1>^-a^$%^*{^$T^!V^'$^5V^$)^27^<Z^&Z ",
      "encoded_base64": "XilDXidVXip7XiQ7XjE+Xi1hXiQlXip7XiRUXiFWXickXjVWXiQpXjI3XjxaXiZaIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_aea482eea28f",
      "text": "歷史知識。沒有任何問題是他們無法解答的，他們的指引 ",
      "encoded_ascii": "^6^^1m^&h^(R^!\"^%\\^$s^!C^!L^*Z^.G^,X^!@^*{^%}^%b^(I^-B^&Z^*A^!@^*{^&Z^$8^#Z ",
      "encoded_base64": "XjZeXjFtXiZoXihSXiEiXiVcXiRzXiFDXiFMXipaXi5HXixYXiFAXip7XiV9XiViXihJXi1CXiZaXipBXiFAXip7XiZaXiQ4XiNaIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_1e4924a3d340",
      "text": "是你們所能獲得最睿智的建言。",
      "encoded_ascii": "^,X^*F^*{^$)^'b^&:^#e^$q^/=^$i^&Z^,'^1Y^!\"",
      "encoded_base64": "XixYXipGXip7XiQpXidiXiY6XiNlXiRxXi89XiRpXiZaXiwnXjFZXiEi",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_48efc533393a",
      "text": "這是嚴厲禁止的。",
      "encoded_ascii": "^(s^,X^1*^+:^&y^%G^&Z^!\"",
      "encoded_base64": "XihzXixYXjEqXis6XiZ5XiVHXiZaXiEi",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_b18b68a130f0",
      "text": "這種知識絕非給你們這種人知曉的。",
      "encoded_ascii": "^(s^'$^&h^(R^-I^)i^'A^*F^*{^(s^'$^!<^&h^7y^&Z^!\"",
      "encoded_base64": "XihzXickXiZoXihSXi1JXilpXidBXipGXip7XihzXickXiE8XiZoXjd5XiZaXiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_640f6c2ed819",
      "text": "你必須朝 ",
      "encoded_ascii": "^*F^#l^)r^,^ ",
      "encoded_base64": "XipGXiNsXilyXixeIA==",
      "byte_length": 13
    },
    {
      "unit_id": "DLG_347b9ee90ad7",
      "text": "西邊",
      "encoded_ascii": "^-l^.8",
      "encoded_base64": "Xi1sXi44",
      "byte_length": 6
    },
    {
      "unit_id": "DLG_f850b71e2440",
      "text": "，然後向北",
      "encoded_ascii": "^*A^&\"^#b^+?^+6",
      "encoded_base64": "XipBXiYiXiNiXis/Xis2",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_4be54b2bd76c",
      "text": "，然後向西",
      "encoded_ascii": "^*A^&\"^#b^+?^-l",
      "encoded_base64": "XipBXiYiXiNiXis/Xi1s",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_4324cf1d8568",
      "text": "，然後向東",
      "encoded_ascii": "^*A^&\"^#b^+?^,`",
      "encoded_base64": "XipBXiYiXiNiXis/Xixg",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_d20fee5fe2b5",
      "text": " 前進，才能抵達沖洗通道。",
      "encoded_ascii": " ^!z^(w^*A^$,^'b^$5^(z^,p^0j^(t^(y^!\"",
      "encoded_base64": "IF4hel4od14qQV4kLF4nYl4kNV4oel4scF4wal4odF4oeV4hIg==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_2ab8ee0c2f80",
      "text": "隱藏出口位於 ",
      "encoded_ascii": "^)Y^-f^!q^\"<^!J^$^ ",
      "encoded_base64": "XilZXi1mXiFxXiI8XiFKXiReIA==",
      "byte_length": 19
    },
    {
      "unit_id": "DLG_1fa85f9e134f",
      "text": "東方。",
      "encoded_ascii": "^,`^$]^!\"",
      "encoded_base64": "XixgXiRdXiEi",
      "byte_length": 9
    },
    {
      "unit_id": "DLG_a666f9560fad",
      "text": "西方。",
      "encoded_ascii": "^-l^$]^!\"",
      "encoded_base64": "Xi1sXiRdXiEi",
      "byte_length": 9
    },
    {
      "unit_id": "DLG_d6ba50cff11f",
      "text": "北方。",
      "encoded_ascii": "^+6^$]^!\"",
      "encoded_base64": "Xis2XiRdXiEi",
      "byte_length": 9
    },
    {
      "unit_id": "DLG_f8000237ae73",
      "text": "把那件物品還來！你們竟敢在這座神廟裡行竊？！",
      "encoded_ascii": "^$1^)!^.W^&4^\"R^.7^!O^*W^*F^*{^28^/m^\"d^(s^/_^&w^0[^-j^(;^5n^.V^*W",
      "encoded_base64": "XiQxXikhXi5XXiY0XiJSXi43XiFPXipXXipGXip7XjI4Xi9tXiJkXihzXi9fXiZ3XjBbXi1qXig7XjVuXi5WXipX",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_fb87d53d3d2f",
      "text": "  我很抱歉。這就奉還。",
      "encoded_ascii": "  ^$%^*K^,@^,h^!\"^(s^*J^1+^.7^!\"",
      "encoded_base64": "ICBeJCVeKkteLEBeLGheISJeKHNeKkpeMSteLjdeISI=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_9335f7a5bedb",
      "text": "  我想怎樣就怎樣！",
      "encoded_ascii": "  ^$%^,1^,,^,f^*J^,,^,f^*W",
      "encoded_base64": "ICBeJCVeLDFeLCxeLGZeKkpeLCxeLGZeKlc=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_c8e0774d6224",
      "text": "以後克制點你的行為。",
      "encoded_ascii": "^!B^#b^!d^!v^*;^*F^&Z^(;^%{^!\"",
      "encoded_base64": "XiFCXiNiXiFkXiF2Xio7XipGXiZaXig7XiV7XiEi",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_72fba9b1ca38",
      "text": "你絕不可能活著為此後悔！",
      "encoded_ascii": "^*F^-I^!)^\"A^'b^%i^-a^%{^%I^#b^6Y^*W",
      "encoded_base64": "XipGXi1JXiEpXiJBXidiXiVpXi1hXiV7XiVJXiNiXjZZXipX",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_034f512743e3",
      "text": "  感謝您慷慨分享智慧。",
      "encoded_ascii": "  ^#{^-z^4:^70^7/^!s^!;^$i^4;^!\"",
      "encoded_base64": "ICBeI3teLXpeNDpeNzBeNy9eIXNeITteJGleNDteISI=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_006eeee04c50",
      "text": "  你根本不知道答案，對吧？",
      "encoded_ascii": "  ^*F^%)^$x^!)^&h^(y^-B^4|^*A^#:^*I^.V",
      "encoded_base64": "ICBeKkZeJSleJHheISleJmheKHleLUJeNHxeKkFeIzpeKkleLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_34260eec586c",
      "text": "  你能幫我逃離下水道嗎？",
      "encoded_ascii": "  ^*F^'b^+}^$%^(p^)`^!(^%V^(y^+X^.V",
      "encoded_base64": "ICBeKkZeJ2JeK31eJCVeKHBeKWBeISheJVZeKHleK1heLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_9990e08631d4",
      "text": "  我要怎麼走出下水道？",
      "encoded_ascii": "  ^$%^(C^,,^.T^.&^!q^!(^%V^(y^.V",
      "encoded_base64": "ICBeJCVeKENeLCxeLlReLiZeIXFeISheJVZeKHleLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_8a3c586aac3f",
      "text": "  關於德拉吉，你都知道些什麼？",
      "encoded_ascii": "  ^.>^$^^#j^$6^\"D^*A^*F^)$^&h^(y^!8^!=^.T^.V",
      "encoded_base64": "ICBeLj5eJF5eI2peJDZeIkReKkFeKkZeKSReJmheKHleITheIT1eLlReLlY=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_f96d5c74c4a2",
      "text": "不得打擾長老！我們的冥想無比重要，容不得 ",
      "encoded_ascii": "^!)^#e^$-^$K^)C^'U^*W^$%^*{^&Z^2X^,1^%}^,m^))^(C^*A^+t^!)^#e ",
      "encoded_base64": "XiEpXiNlXiQtXiRLXilDXidVXipXXiQlXip7XiZaXjJYXiwxXiV9XixtXikpXihDXipBXit0XiEpXiNlIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_8b65ddf6041a",
      "text": "你們這種人來打擾。",
      "encoded_ascii": "^*F^*{^(s^'$^!<^!O^$-^$K^!\"",
      "encoded_base64": "XipGXip7XihzXickXiE8XiFPXiQtXiRLXiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_222b1784304c",
      "text": "是誰在向鼠人長老發話？",
      "encoded_ascii": "^,X^-y^\"d^+?^*=^!<^)C^'U^&W^-v^.V",
      "encoded_base64": "XixYXi15XiJkXis/Xio9XiE8XilDXidVXiZXXi12Xi5W",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_7f44088650e0",
      "text": "  我們是貴神廟卑微的守護者。",
      "encoded_ascii": "  ^$%^*{^,X^2F^&w^0[^\".^#i^&Z^#+^(T^'V^!\"",
      "encoded_base64": "ICBeJCVeKnteLFheMkZeJndeMFteIi5eI2leJlpeIyteKFReJ1ZeISI=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_9c52ba87c43c",
      "text": "  不關你的事！",
      "encoded_ascii": "  ^!)^.>^*F^&Z^*r^*W",
      "encoded_base64": "ICBeISleLj5eKkZeJlpeKnJeKlc=",
      "byte_length": 20
    },
    {
      "unit_id": "DLG_d207dc71feec",
      "text": "  我前來尋求指引。",
      "encoded_ascii": "  ^$%^!z^!O^#9^,n^$8^#Z^!\"",
      "encoded_base64": "ICBeJCVeIXpeIU9eIzleLG5eJDheI1peISI=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_caa58f7d51c3",
      "text": "  我不需要發霉老頭骨的幫忙。",
      "encoded_ascii": "  ^$%^!)^)e^(C^&W^0H^'U^)t^*$^&Z^+}^,+^!\"",
      "encoded_base64": "ICBeJCVeISleKWVeKENeJldeMEheJ1VeKXReKiReJlpeK31eLCteISI=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_c84d547b4314",
      "text": "你們是來尋求長老的智慧嗎？",
      "encoded_ascii": "^*F^*{^,X^!O^#9^,n^)C^'U^&Z^$i^4;^+X^.V",
      "encoded_base64": "XipGXip7XixYXiFPXiM5XixuXilDXidVXiZaXiRpXjQ7XitYXi5W",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_e8ff8ee6ca8e",
      "text": "身負博大知識的我們，准予接見你們。",
      "encoded_ascii": "^(c^(W^/$^\"z^&h^(R^&Z^$%^*{^*A^/Q^!4^$?^-m^*F^*{^!\"",
      "encoded_base64": "XihjXihXXi8kXiJ6XiZoXihSXiZaXiQlXip7XipBXi9RXiE0XiQ/Xi1tXipGXip7XiEi",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_ea8f8ad08a02",
      "text": "既然你們幫了我們，我們也自當投桃報李。",
      "encoded_ascii": "^,U^&\"^*F^*{^+}^*D^$%^*{^*A^$%^*{^!1^'l^&N^$3^%+^+`^=f^!\"",
      "encoded_base64": "XixVXiYiXipGXip7Xit9XipEXiQlXip7XipBXiQlXip7XiExXidsXiZOXiQzXiUrXitgXj1mXiEi",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_2f146aad8bc0",
      "text": "有兩處出口可以從下水道通往德拉吉城外的農田。",
      "encoded_ascii": "^$s^!i^(,^!q^\"<^\"A^!B^#f^!(^%V^(y^(t^,)^#j^$6^\"D^+_^\"w^&Z^4i^;\\^!\"",
      "encoded_base64": "XiRzXiFpXigsXiFxXiI8XiJBXiFCXiNmXiEoXiVWXih5Xih0XiwpXiNqXiQ2XiJEXitfXiJ3XiZaXjRpXjtcXiEi",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_19eaf773a3ce",
      "text": "  我要如何避開地道中的危險？",
      "encoded_ascii": "  ^$%^(C^#$^!L^0F^)F^\"e^(y^!,^&Z^2\\^*m^.V",
      "encoded_base64": "ICBeJCVeKENeIyReIUxeMEZeKUZeImVeKHleISxeJlpeMlxeKm1eLlY=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_a8d1eed8a2ec",
      "text": "  出口都在哪裡？",
      "encoded_ascii": "  ^!q^\"<^)$^\"d^+I^-j^.V",
      "encoded_base64": "ICBeIXFeIjxeKSReImReK0leLWpeLlY=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_53ad8bad8588",
      "text": "  另一個出口在哪裡？",
      "encoded_ascii": "  ^\">^!%^!V^!q^\"<^\"d^+I^-j^.V",
      "encoded_base64": "ICBeIj5eISVeIVZeIXFeIjxeImReK0leLWpeLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_bb62dd4e9314",
      "text": "  隱藏出口在哪裡？",
      "encoded_ascii": "  ^)Y^-f^!q^\"<^\"d^+I^-j^.V",
      "encoded_base64": "ICBeKVleLWZeIXFeIjxeImReK0leLWpeLlY=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_138ccee8a335",
      "text": "  既然是隱藏的，我要怎麼找到它？",
      "encoded_ascii": "  ^,U^&\"^,X^)Y^-f^&Z^*A^$%^(C^,,^.T^$/^!u^+o^.V",
      "encoded_base64": "ICBeLFVeJiJeLFheKVleLWZeJlpeKkFeJCVeKENeLCxeLlReJC9eIXVeK29eLlY=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_1ed886231d58",
      "text": "  我懇求您的睿智指引，該如何找到它？",
      "encoded_ascii": "  ^$%^3t^,n^4:^&Z^/=^$i^$8^#Z^*A^(M^#$^!L^$/^!u^+o^.V",
      "encoded_base64": "ICBeJCVeM3ReLG5eNDpeJlpeLz1eJGleJDheI1peKkFeKE1eIyReIUxeJC9eIXVeK29eLlY=",
      "byte_length": 53
    },
    {
      "unit_id": "DLG_02f582d63511",
      "text": "  快告訴我怎麼找到它，你這隻死了兩次的老死鼠！",
      "encoded_ascii": "  ^*L^+B^-t^$%^,,^.T^$/^!u^+o^*A^*F^(s^)[^%L^*D^!i^%D^&Z^'U^%L^*=^*W",
      "encoded_base64": "ICBeKkxeK0JeLXReJCVeLCxeLlReJC9eIXVeK29eKkFeKkZeKHNeKVteJUxeKkReIWleJUReJlpeJ1VeJUxeKj1eKlc=",
      "byte_length": 68
    },
    {
      "unit_id": "DLG_1859897b4c85",
      "text": "  沖洗通道在哪裡？",
      "encoded_ascii": "  ^,p^0j^(t^(y^\"d^+I^-j^.V",
      "encoded_base64": "ICBeLHBeMGpeKHReKHleImReK0leLWpeLlY=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_cbabf490b2ff",
      "text": "達戈拉爾是位博大精深的博學者。正是他將我們的 ",
      "encoded_ascii": "^(z^*M^$6^&/^,X^!J^/$^\"z^'7^2*^&Z^/$^+n^'V^!\"^%H^,X^!@^#7^$%^*{^&Z ",
      "encoded_base64": "Xih6XipNXiQ2XiYvXixYXiFKXi8kXiJ6Xic3XjIqXiZaXi8kXituXidWXiEiXiVIXixYXiFAXiM3XiQlXip7XiZaIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_a0009ceea0e3",
      "text": "思緒留存於這些骸骨之中。達戈拉爾正是鼠人得以延續的原因。",
      "encoded_ascii": "^#q^3#^-+^#*^$^^(s^!8^*'^*$^!/^!,^!\"^(z^*M^$6^&/^%H^,X^*=^!<^#e^!B^,&^'M^&Z^\"5^\"]^!\"",
      "encoded_base64": "XiNxXjMjXi0rXiMqXiReXihzXiE4XionXiokXiEvXiEsXiEiXih6XipNXiQ2XiYvXiVIXixYXio9XiE8XiNlXiFCXiwmXidNXiZaXiI1XiJdXiEi",
      "byte_length": 84
    },
    {
      "unit_id": "DLG_4368b1a3bf49",
      "text": "  達戈拉爾在哪裡？",
      "encoded_ascii": "  ^(z^*M^$6^&/^\"d^+I^-j^.V",
      "encoded_base64": "ICBeKHpeKk1eJDZeJi9eImReK0leLWpeLlY=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_f58da85948e5",
      "text": "  不過，他肯定就在附近對吧？",
      "encoded_ascii": "  ^!)^(x^*A^!@^-Z^#.^*J^\"d^.?^(l^#:^*I^.V",
      "encoded_base64": "ICBeISleKHheKkFeIUBeLVpeIy5eKkpeImReLj9eKGxeIzpeKkleLlY=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_712872b93900",
      "text": "  我在哪裡能找到分離之杖？",
      "encoded_ascii": "  ^$%^\"d^+I^-j^'b^$/^!u^!s^)`^!/^${^.V",
      "encoded_base64": "ICBeJCVeImReK0leLWpeJ2JeJC9eIXVeIXNeKWBeIS9eJHteLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_6448ab4c77f5",
      "text": "  分離之杖是什麼？",
      "encoded_ascii": "  ^!s^)`^!/^${^,X^!=^.T^.V",
      "encoded_base64": "ICBeIXNeKWBeIS9eJHteLFheIT1eLlReLlY=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_9203d1099723",
      "text": "  請告訴我在哪裡可以找到這支法杖。",
      "encoded_ascii": "  ^*S^+B^-t^$%^\"d^+I^-j^\"A^!B^$/^!u^(s^$L^%b^${^!\"",
      "encoded_base64": "ICBeKlNeK0JeLXReJCVeImReK0leLWpeIkFeIUJeJC9eIXVeKHNeJExeJWJeJHteISI=",
      "byte_length": 50
    },
    {
      "unit_id": "DLG_857f9737e3c4",
      "text": "  你的意思是，達戈拉爾創造了鼠人？",
      "encoded_ascii": "  ^*F^&Z^#z^#q^,X^*A^(z^*M^$6^&/^!{^(v^*D^*=^!<^.V",
      "encoded_base64": "ICBeKkZeJlpeI3peI3FeLFheKkFeKHpeKk1eJDZeJi9eIXteKHZeKkReKj1eITxeLlY=",
      "byte_length": 50
    },
    {
      "unit_id": "DLG_3230a94de043",
      "text": "  他是如何讓你們復甦重現的？",
      "encoded_ascii": "  ^!@^,X^#$^!L^-}^*F^*{^#g^6e^))^&?^&Z^.V",
      "encoded_base64": "ICBeIUBeLFheIyReIUxeLX1eKkZeKnteI2deNmVeKSleJj9eJlpeLlY=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_c5279db1c13c",
      "text": "  我不趕時間。請您詳細解釋吧。",
      "encoded_ascii": "  ^$%^!)^0u^$f^)G^!\"^*S^4:^6v^'?^(I^0w^*I^!\"",
      "encoded_base64": "ICBeJCVeISleMHVeJGZeKUdeISJeKlNeNDpeNnZeJz9eKEleMHdeKkleISI=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_3306280b19b4",
      "text": " 如果你對達戈拉爾的好奇出自真心，你可以取走那支分離之杖，就在 ",
      "encoded_ascii": " ^#$^%!^*F^#:^(z^*M^$6^&/^&Z^+i^\"}^!q^'l^-2^#k^*A^*F^\"A^!B^\":^.&^)!^$L^!s^)`^!/^${^*A^*J^\"d ",
      "encoded_base64": "IF4jJF4lIV4qRl4jOl4oel4qTV4kNl4mL14mWl4raV4ifV4hcV4nbF4tMl4ja14qQV4qRl4iQV4hQl4iOl4uJl4pIV4kTF4hc14pYF4hL14ke14qQV4qSl4iZCA=",
      "byte_length": 92
    },
    {
      "unit_id": "DLG_26f507319fe7",
      "text": "那個下水道排水管裡。只要在沖洗通道的東北角使用它， ",
      "encoded_ascii": "^)!^!V^!(^%V^(y^$<^%V^-D^-j^!\"^\"?^(C^\"d^,p^0j^(t^(y^&Z^,`^+6^(H^!N^&H^+o^*A ",
      "encoded_base64": "XikhXiFWXiEoXiVWXih5XiQ8XiVWXi1EXi1qXiEiXiI/XihDXiJkXixwXjBqXih0Xih5XiZaXixgXis2XihIXiFOXiZIXitvXipBIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_fa4620f5a871",
      "text": "就能揭示通往達戈拉爾領地的入口。",
      "encoded_ascii": "^*J^'b^$B^&s^(t^,)^(z^*M^$6^&/^)s^\"e^&Z^!f^\"<^!\"",
      "encoded_base64": "XipKXidiXiRCXiZzXih0XiwpXih6XipNXiQ2XiYvXilzXiJlXiZaXiFmXiI8XiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_9dd86f5179ea",
      "text": "我深知許多事情。整個德拉吉都在騷動，正一步步走向 ",
      "encoded_ascii": "^$%^2*^&h^-s^\"x^*r^,0^!\"^$T^!V^#j^$6^\"D^)$^\"d^0y^\"%^*A^%H^!%^,i^,i^.&^+? ",
      "encoded_base64": "XiQlXjIqXiZoXi1zXiJ4XipyXiwwXiEiXiRUXiFWXiNqXiQ2XiJEXikkXiJkXjB5XiIlXipBXiVIXiElXixpXixpXi4mXis/IA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_304b7bebf2da",
      "text": "決定命運的重大事件。當心，若是特克圖克特雷建成了金字塔，整個 ",
      "encoded_ascii": "^,o^#.^\"N^.4^&Z^))^\"z^*r^.W^!\"^&N^#k^*A^'x^,X^&5^!d^\"b^!d^&5^)c^,'^$$^*D^)+^#)^\"o^*A^$T^!V ",
      "encoded_base64": "XixvXiMuXiJOXi40XiZaXikpXiJ6XipyXi5XXiEiXiZOXiNrXipBXid4XixYXiY1XiFkXiJiXiFkXiY1XiljXiwnXiQkXipEXikrXiMpXiJvXipBXiRUXiFWIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_60be06375f91",
      "text": "阿塔斯都將面臨滅頂之災。",
      "encoded_ascii": "^)M^\"o^$[^)$^#7^)j^1U^%t^)p^!/^3P^!\"",
      "encoded_base64": "XilNXiJvXiRbXikkXiM3XilqXjFVXiV0XilwXiEvXjNQXiEi",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_94341e59c2d4",
      "text": "  為什麼德拉吉會騷動不安？",
      "encoded_ascii": "  ^%{^!=^.T^#j^$6^\"D^$r^0y^\"%^!)^+p^.V",
      "encoded_base64": "ICBeJXteIT1eLlReI2peJDZeIkReJHJeMHleIiVeISleK3BeLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_01a5ed829bbe",
      "text": "  你說的重大事件是指什麼？",
      "encoded_ascii": "  ^*F^-x^&Z^))^\"z^*r^.W^,X^$8^!=^.T^.V",
      "encoded_base64": "ICBeKkZeLXheJlpeKSleInpeKnJeLldeLFheJDheIT1eLlReLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_060395a72b64",
      "text": "  金字塔還要多久才會完工？",
      "encoded_ascii": "  ^)+^#)^\"o^.7^(C^\"x^!.^$,^$r^#,^+y^.V",
      "encoded_base64": "ICBeKSteIyleIm9eLjdeKENeInheIS5eJCxeJHJeIyxeK3leLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_bfb35699e99a",
      "text": "  跟我說說那位巫王的事吧。",
      "encoded_ascii": "  ^.+^$%^-x^-x^)!^!J^14^-)^&Z^*r^*I^!\"",
      "encoded_base64": "ICBeLiteJCVeLXheLXheKSFeIUpeMTReLSleJlpeKnJeKkleISI=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_bc81922a0472",
      "text": "願幸運與你們同在。",
      "encoded_ascii": "^.H^15^.4^'p^*F^*{^\"E^\"d^!\"",
      "encoded_base64": "Xi5IXjE1Xi40XidwXipGXip7XiJFXiJkXiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_43ad13d8dcb8",
      "text": "主要出水口位於沖洗通道，但切記當心， ",
      "encoded_ascii": "^!-^(C^!q^%V^\"<^!J^$^^,p^0j^(t^(y^*A^!I^+.^(K^&N^#k^*A ",
      "encoded_base64": "XiEtXihDXiFxXiVWXiI8XiFKXiReXixwXjBqXih0Xih5XipBXiFJXisuXihLXiZOXiNrXipBIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_fcc4ef9fbf4a",
      "text": "城防衛軍經常搜查下水道的主要出水口。",
      "encoded_ascii": "^+_^)K^(=^..^'D^#O^/h^%&^!(^%V^(y^&Z^!-^(C^!q^%V^\"<^!\"",
      "encoded_base64": "XitfXilLXig9Xi4uXidEXiNPXi9oXiUmXiEoXiVWXih5XiZaXiEtXihDXiFxXiVWXiI8XiEi",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_6e22137ec746",
      "text": "在沖洗通道裡還有一條密道， ",
      "encoded_ascii": "^\"d^,p^0j^(t^(y^-j^.7^$s^!%^%.^#0^(y^*A ",
      "encoded_base64": "XiJkXixwXjBqXih0Xih5Xi1qXi43XiRzXiElXiUuXiMwXih5XipBIA==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_87d69cd9d39c",
      "text": "同樣可行， ",
      "encoded_ascii": "^\"E^,f^\"A^(;^*A ",
      "encoded_base64": "XiJFXixmXiJBXig7XipBIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_d52eaa5a4795",
      "text": "但要小心在那帶出沒為患的提爾軟泥怪。",
      "encoded_ascii": "^!I^(C^#;^#k^\"d^)!^#N^!q^%\\^%{^;Q^&Z^$A^&/^.x^%d^#s^!\"",
      "encoded_base64": "XiFJXihDXiM7XiNrXiJkXikhXiNOXiFxXiVcXiV7XjtRXiZaXiRBXiYvXi54XiVkXiNzXiEi",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_ee02e11b9def",
      "text": "凡隱密之物，本質皆是如此。",
      "encoded_ascii": "^+-^)Y^#0^!/^&4^*A^$x^(Z^5j^,X^#$^%I^!\"",
      "encoded_base64": "XistXilZXiMwXiEvXiY0XipBXiR4XihaXjVqXixYXiMkXiVJXiEi",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_f0c9e6063af0",
      "text": "某個排水溝中藏有一根拉桿。拉動它便能解鎖 ",
      "encoded_ascii": "^%$^!V^$<^%V^:|^!,^-f^$s^!%^%)^$6^%,^!\"^$6^\"%^+o^!R^'b^(I^)8 ",
      "encoded_base64": "XiUkXiFWXiQ8XiVWXjp8XiEsXi1mXiRzXiElXiUpXiQ2XiUsXiEiXiQ2XiIlXitvXiFSXidiXihJXik4IA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_317850b338fe",
      "text": "一道密門，但你們務必格外小心，切勿觸發陷阱。 ",
      "encoded_ascii": "^!%^(y^#0^)D^*A^!I^*F^*{^+4^#l^%*^\"w^#;^#k^*A^+.^3f^(J^&W^)S^)J^!\" ",
      "encoded_base64": "XiElXih5XiMwXilEXipBXiFJXipGXip7Xis0XiNsXiUqXiJ3XiM7XiNrXipBXisuXjNmXihKXiZXXilTXilKXiEiIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_ee54025e47f8",
      "text": "後面的地道直通城外農田。",
      "encoded_ascii": "^#b^)j^&Z^\"e^(y^&`^(t^+_^\"w^4i^;\\^!\"",
      "encoded_base64": "XiNiXilqXiZaXiJlXih5XiZgXih0XitfXiJ3XjRpXjtcXiEi",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_9a021ef746c4",
      "text": "你們在懂得何謂敬重之前，還有得學呢。滾開！",
      "encoded_ascii": "^*F^*{^\"d^,6^#e^!L^0s^*O^))^!/^!z^*A^.7^$s^#e^+n^+C^!\"^,z^)F^*W",
      "encoded_base64": "XipGXip7XiJkXiw2XiNlXiFMXjBzXipPXikpXiEvXiF6XipBXi43XiRzXiNlXituXitDXiEiXix6XilGXipX",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_6ecc5331a564",
      "text": "那是個沒有真正解答的問題。",
      "encoded_ascii": "^)!^,X^!V^%\\^$s^-2^%H^(I^-B^&Z^*Z^.G^!\"",
      "encoded_base64": "XikhXixYXiFWXiVcXiRzXi0yXiVIXihJXi1CXiZaXipaXi5HXiEi",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_5c95d97990b9",
      "text": "沖洗通道就在高層巢穴的正北方。",
      "encoded_ascii": "^,p^0j^(t^(y^*J^\"d^*+^#B^#G^'&^&Z^%H^+6^$]^!\"",
      "encoded_base64": "XixwXjBqXih0Xih5XipKXiJkXiorXiNCXiNHXicmXiZaXiVIXis2XiRdXiEi",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_00f88ca432a0",
      "text": " 你可以帶走我身旁的這只石碗。要是 ",
      "encoded_ascii": " ^*F^\"A^!B^#N^.&^$%^(c^.h^&Z^(s^\"?^&k^&q^!\"^(C^,X ",
      "encoded_base64": "IF4qRl4iQV4hQl4jTl4uJl4kJV4oY14uaF4mWl4oc14iP14ma14mcV4hIl4oQ14sWCA=",
      "byte_length": 50
    },
    {
      "unit_id": "DLG_352df212f84d",
      "text": "你們迷了路，我會透過它向你們說話，給予指引。",
      "encoded_ascii": "^*F^*{^(n^*D^(a^*A^$%^$r^(q^(x^+o^+?^*F^*{^-x^-v^*A^'A^!4^$8^#Z^!\"",
      "encoded_base64": "XipGXip7XihuXipEXihhXipBXiQlXiRyXihxXih4XitvXis/XipGXip7Xi14Xi12XipBXidBXiE0XiQ4XiNaXiEi",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_dfb864df2b2c",
      "text": "，你就是消滅褻瀆我們神聖神廟的英雄嗎？",
      "encoded_ascii": "^*A^*F^*J^,X^%k^%t^-k^,~^$%^*{^&w^'Z^&w^0[^&Z^'y^)\\^+X^.V",
      "encoded_base64": "XipBXipGXipKXixYXiVrXiV0Xi1rXix+XiQlXip7XiZ3XidaXiZ3XjBbXiZaXid5XilcXitYXi5W",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_4aa5bb66ae26",
      "text": "那就離去吧。 ",
      "encoded_ascii": "^)!^*J^)`^\"6^*I^!\" ",
      "encoded_base64": "XikhXipKXilgXiI2XipJXiEiIA==",
      "byte_length": 19
    },
    {
      "unit_id": "DLG_4bdc331ebb4a",
      "text": "你們對長老毫無敬意。",
      "encoded_ascii": "^*F^*{^#:^)C^'U^/t^%}^*O^#z^!\"",
      "encoded_base64": "XipGXip7XiM6XilDXidVXi90XiV9XipPXiN6XiEi",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_aa19670d9e03",
      "text": "長老的知識只傳授給配得上的人。",
      "encoded_ascii": "^)C^'U^&Z^&h^(R^\"?^+$^$:^'A^)&^#e^!'^&Z^!<^!\"",
      "encoded_base64": "XilDXidVXiZaXiZoXihSXiI/XiskXiQ6XidBXikmXiNlXiEnXiZaXiE8XiEi",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_419be30453bd",
      "text": "你們值得無上的讚譽！長老們能為你們提供什麼幫助？",
      "encoded_ascii": "^*F^*{^!Z^#e^%}^!'^&Z^8'^6-^*W^)C^'U^*{^'b^%{^*F^*{^$A^!P^!=^.T^+}^\"#^.V",
      "encoded_base64": "XipGXip7XiFaXiNlXiV9XiEnXiZaXjgnXjYtXipXXilDXidVXip7XidiXiV7XipGXip7XiRBXiFQXiE9Xi5UXit9XiIjXi5W",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_0980a0398148",
      "text": "我再問一次，究竟是誰在說話？",
      "encoded_ascii": "^$%^!l^*Z^!%^%D^*A^-<^28^,X^-y^\"d^-x^-v^.V",
      "encoded_base64": "XiQlXiFsXipaXiElXiVEXipBXi08XjI4XixYXi15XiJkXi14Xi12Xi5W",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_8bdc314d2bef",
      "text": "我們是高層巢穴的長老。當我們的鼠人肉身死去時，我們的遺骸 ",
      "encoded_ascii": "^$%^*{^,X^*+^#B^#G^'&^&Z^)C^'U^!\"^&N^$%^*{^&Z^*=^!<^'^^(c^%L^\"6^$f^*A^$%^*{^&Z^0v^*' ",
      "encoded_base64": "XiQlXip7XixYXiorXiNCXiNHXicmXiZaXilDXidVXiEiXiZOXiQlXip7XiZaXio9XiE8XideXihjXiVMXiI2XiRmXipBXiQlXip7XiZaXjB2XionIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_462cc8277489",
      "text": "被送往達戈拉爾處，以這種形態獲得重生。你們需要我們的幫助嗎？",
      "encoded_ascii": "^(@^./^,)^(z^*M^$6^&/^(,^*A^!B^(s^'$^#_^#|^&:^#e^))^&F^!\"^*F^*{^)e^(C^$%^*{^&Z^+}^\"#^+X^.V",
      "encoded_base64": "XihAXi4vXiwpXih6XipNXiQ2XiYvXigsXipBXiFCXihzXickXiNfXiN8XiY6XiNlXikpXiZGXiEiXipGXip7XillXihDXiQlXip7XiZaXit9XiIjXitYXi5W",
      "byte_length": 90
    },
    {
      "unit_id": "DLG_a86fd050384a",
      "text": "正如達戈拉爾所囑託，提供指引是我們唯一的使命。我們的知識 ",
      "encoded_ascii": "^%H^#$^(z^*M^$6^&/^$)^=d^-q^*A^$A^!P^$8^#Z^,X^$%^*{^+O^!%^&Z^!N^\"N^!\"^$%^*{^&Z^&h^(R ",
      "encoded_base64": "XiVIXiMkXih6XipNXiQ2XiYvXiQpXj1kXi1xXipBXiRBXiFQXiQ4XiNaXixYXiQlXip7XitPXiElXiZaXiFOXiJOXiEiXiQlXip7XiZaXiZoXihSIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_03d65a9629f0",
      "text": "淵博無比，智慧浩瀚深邃。儘管發問吧，我們會為你們啟迪開導。",
      "encoded_ascii": "^<m^/$^%}^,m^*A^$i^4;^5^^9F^2*^6;^!\"^+(^-D^&W^*Z^*I^*A^$%^*{^$r^%{^*F^*{^57^(m^)F^10^!\"",
      "encoded_base64": "XjxtXi8kXiV9XixtXipBXiRpXjQ7XjVeXjlGXjIqXjY7XiEiXisoXi1EXiZXXipaXipJXipBXiQlXip7XiRyXiV7XipGXip7XjU3XihtXilGXjEwXiEi",
      "byte_length": 87
    },
    {
      "unit_id": "DLG_6c86be4a2367",
      "text": "那是顯而易見的，因為我們將死者都交給了他。但若沒有分離之杖，你們絕不可能進入 ",
      "encoded_ascii": "^)!^,X^4&^'W^,W^-m^&Z^*A^\"]^%{^$%^*{^#7^%L^'V^)$^0P^'A^*D^!@^!\"^!I^'x^%\\^$s^!s^)`^!/^${^*A^*F^*{^-I^!)^\"A^'b^(w^!f ",
      "encoded_base64": "XikhXixYXjQmXidXXixXXi1tXiZaXipBXiJdXiV7XiQlXip7XiM3XiVMXidWXikkXjBQXidBXipEXiFAXiEiXiFJXid4XiVcXiRzXiFzXilgXiEvXiR7XipBXipGXip7Xi1JXiEpXiJBXidiXih3XiFmIA==",
      "byte_length": 115
    },
    {
      "unit_id": "DLG_1f95638cbf72",
      "text": "他的領地。",
      "encoded_ascii": "^!@^&Z^)s^\"e^!\"",
      "encoded_base64": "XiFAXiZaXilzXiJlXiEi",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_950c97f350d2",
      "text": "分離之杖能讓我們的守護者進入水下達戈拉爾的領地， ",
      "encoded_ascii": "^!s^)`^!/^${^'b^-}^$%^*{^&Z^#+^(T^'V^(w^!f^%V^!(^(z^*M^$6^&/^&Z^)s^\"e^*A ",
      "encoded_base64": "XiFzXilgXiEvXiR7XidiXi19XiQlXip7XiZaXiMrXihUXidWXih3XiFmXiVWXiEoXih6XipNXiQ2XiYvXiZaXilzXiJlXipBIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_a2b9a26f7634",
      "text": "但你們缺乏足夠年歲的智慧去領悟其奧妙魔法。",
      "encoded_ascii": "^!I^*F^*{^7e^;'^(^^+d^+~^,j^&Z^$i^4;^\"6^)s^=e^!j^6Q^43^*0^%b^!\"",
      "encoded_base64": "XiFJXipGXip7XjdlXjsnXiheXitkXit+XixqXiZaXiRpXjQ7XiI2XilzXj1lXiFqXjZRXjQzXiowXiViXiEi",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_e372e0b18b4a",
      "text": "好吧。你們為我們付出了許多。分離之杖就在那道牆面的 ",
      "encoded_ascii": "^+i^*I^!\"^*F^*{^%{^$%^*{^*u^!q^*D^-s^\"x^!\"^!s^)`^!/^${^*J^\"d^)!^(y^&0^)j^&Z ",
      "encoded_base64": "XitpXipJXiEiXipGXip7XiV7XiQlXip7Xip1XiFxXipEXi1zXiJ4XiEiXiFzXilgXiEvXiR7XipKXiJkXikhXih5XiYwXilqXiZaIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_8e2d08320994",
      "text": "排水孔裡。帶著它前往沖洗通道東北角的 ",
      "encoded_ascii": "^$<^%V^5G^-j^!\"^#N^-a^+o^!z^,)^,p^0j^(t^(y^,`^+6^(H^&Z ",
      "encoded_base64": "XiQ8XiVWXjVHXi1qXiEiXiNOXi1hXitvXiF6XiwpXixwXjBqXih0Xih5XixgXis2XihIXiZaIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_7912eb6881e8",
      "text": "水池。它將為你們展現通往達戈拉爾領地的入口。",
      "encoded_ascii": "^%V^%X^!\"^+o^#7^%{^*F^*{^+x^&?^(t^,)^(z^*M^$6^&/^)s^\"e^&Z^!f^\"<^!\"",
      "encoded_base64": "XiVWXiVYXiEiXitvXiM3XiV7XipGXip7Xit4XiY/Xih0XiwpXih6XipNXiQ2XiYvXilzXiJlXiZaXiFmXiI8XiEi",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_1493c3c4260b",
      "text": "巫王無時無刻不在督造那座金字塔。它的落成 ",
      "encoded_ascii": "^14^-)^%}^$f^%}^.Y^!)^\"d^<x^(v^)!^/_^)+^#)^\"o^!\"^+o^&Z^-`^$$ ",
      "encoded_base64": "XjE0Xi0pXiV9XiRmXiV9Xi5ZXiEpXiJkXjx4Xih2XikhXi9fXikrXiMpXiJvXiEiXitvXiZaXi1gXiQkIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_626e41e67c91",
      "text": "已是勢在必行。",
      "encoded_ascii": "^#J^,X^\"&^\"d^#l^(;^!\"",
      "encoded_base64": "XiNKXixYXiImXiJkXiNsXig7XiEi",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_24ade1d8508a",
      "text": "此等知識絕不傳予未獲入門者。",
      "encoded_ascii": "^%I^'-^&h^(R^-I^!)^+$^!4^,_^&:^!f^)D^'V^!\"",
      "encoded_base64": "XiVJXictXiZoXihSXi1JXiEpXiskXiE0XixfXiY6XiFmXilEXidWXiEi",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_3d8bef55485b",
      "text": "  誰才算入門者？",
      "encoded_ascii": "  ^-y^$,^-C^!f^)D^'V^.V",
      "encoded_base64": "ICBeLXleJCxeLUNeIWZeKUReJ1ZeLlY=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_08c027bd3a93",
      "text": "你這個問題的答案超出了你的理解範疇。",
      "encoded_ascii": "^*F^(s^!V^*Z^.G^&Z^-B^4|^(\\^!q^*D^*F^&Z^&A^(I^'0^=g^!\"",
      "encoded_base64": "XipGXihzXiFWXipaXi5HXiZaXi1CXjR8XihcXiFxXipEXipGXiZaXiZBXihJXicwXj1nXiEi",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_e99b9c4d2049",
      "text": "  你怎麼知道我不會理解？",
      "encoded_ascii": "  ^*F^,,^.T^&h^(y^$%^!)^$r^&A^(I^.V",
      "encoded_base64": "ICBeKkZeLCxeLlReJmheKHleJCVeISleJHJeJkFeKEleLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_b2eca82dd14c",
      "text": "有些事情還是別問為妙。",
      "encoded_ascii": "^$s^!8^*r^,0^.7^,X^*H^*Z^%{^43^!\"",
      "encoded_base64": "XiRzXiE4XipyXiwwXi43XixYXipIXipaXiV7XjQzXiEi",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_f6078b155f2f",
      "text": "  有些問題總得有人問，不是嗎？",
      "encoded_ascii": "  ^$s^!8^*Z^.G^-M^#e^$s^!<^*Z^*A^!)^,X^+X^.V",
      "encoded_base64": "ICBeJHNeITheKlpeLkdeLU1eI2VeJHNeITxeKlpeKkFeISleLFheK1heLlY=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_5bd0b1744176",
      "text": "長老的智慧必須審慎傳授。年輕的 ",
      "encoded_ascii": "^)C^'U^&Z^$i^4;^#l^)r^7V^83^+$^$:^!\"^+~^(g^&Z ",
      "encoded_base64": "XilDXidVXiZaXiRpXjQ7XiNsXilyXjdWXjgzXiskXiQ6XiEiXit+XihnXiZaIA==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_0fef2e31402d",
      "text": "心靈往往過於脆弱。",
      "encoded_ascii": "^#k^)g^,)^,)^(x^$^^2?^#\\^!\"",
      "encoded_base64": "XiNrXilnXiwpXiwpXih4XiReXjI/XiNcXiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_99da14de0684",
      "text": "  您能為我破個例嗎？",
      "encoded_ascii": "  ^4:^'b^%{^$%^&n^!V^9h^+X^.V",
      "encoded_base64": "ICBeNDpeJ2JeJXteJCVeJm5eIVZeOWheK1heLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_b37e9d0e937a",
      "text": "你這個問題的答案太過複雜，需要耗費 ",
      "encoded_ascii": "^*F^(s^!V^*Z^.G^&Z^-B^4|^+f^(x^6s^0G^*A^)e^(C^'X^.\" ",
      "encoded_base64": "XipGXihzXiFWXipaXi5HXiZaXi1CXjR8XitmXih4XjZzXjBHXipBXillXihDXidYXi4iIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_74306cd5e25a",
      "text": "太長時間才能解釋清楚。",
      "encoded_ascii": "^+f^)C^$f^)G^$,^'b^(I^0w^,u^,c^!\"",
      "encoded_base64": "XitmXilDXiRmXilHXiQsXidiXihJXjB3Xix1XixjXiEi",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_15a1cd66cbd9",
      "text": "你們改天再感謝我的寬大吧。憑著我的睿智， ",
      "encoded_ascii": "^*F^*{^$N^+e^!l^#{^-z^$%^&Z^3l^\"z^*I^!\"^,5^-a^$%^&Z^/=^$i^*A ",
      "encoded_base64": "XipGXip7XiROXitlXiFsXiN7Xi16XiQlXiZaXjNsXiJ6XipJXiEiXiw1Xi1hXiQlXiZaXi89XiRpXipBIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_6f6fbeee217e",
      "text": "我早已學會寬恕年輕人的魯莽舉止。",
      "encoded_ascii": "^$%^,V^#J^+n^$r^3l^3q^+~^(g^!<^&Z^/K^;8^01^%G^!\"",
      "encoded_base64": "XiQlXixWXiNKXituXiRyXjNsXjNxXit+XihnXiE8XiZaXi9LXjs4XjAxXiVHXiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_53c3872fbd2b",
      "text": " 你們難道沒有別的想問了嗎？",
      "encoded_ascii": " ^*F^*{^)a^(y^%\\^$s^*H^&Z^,1^*Z^*D^+X^.V",
      "encoded_base64": "IF4qRl4qe14pYV4oeV4lXF4kc14qSF4mWl4sMV4qWl4qRF4rWF4uVg==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_6c23a30f6083",
      "text": " 現在離開吧。我們必須細細思索近來發生的種種變故。 ",
      "encoded_ascii": " ^&?^\"d^)`^)F^*I^!\"^$%^*{^#l^)r^'?^'?^#q^'>^(l^!O^&W^&F^&Z^'$^'$^(U^5U^!\" ",
      "encoded_base64": "IF4mP14iZF4pYF4pRl4qSV4hIl4kJV4qe14jbF4pcl4nP14nP14jcV4nPl4obF4hT14mV14mRl4mWl4nJF4nJF4oVV41VV4hIiA=",
      "byte_length": 74
    },
    {
      "unit_id": "DLG_8581e814fd52",
      "text": "祝你們的冒險旅途順遂。",
      "encoded_ascii": "^&v^*F^*{^&Z^/P^*m^2m^3.^.D^;p^!\"",
      "encoded_base64": "XiZ2XipGXip7XiZaXi9QXiptXjJtXjMuXi5EXjtwXiEi",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_8429abfa9a47",
      "text": "我要把你的心臟給扯出來！",
      "encoded_ascii": "^$%^(C^$1^*F^&Z^#k^3Y^'A^.e^!q^!O^*W",
      "encoded_base64": "XiQlXihDXiQxXipGXiZaXiNrXjNZXidBXi5lXiFxXiFPXipX",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_3dc0cfd2b0a4",
      "text": "嘿，那邊那個！想打這過，就得留下買路財！",
      "encoded_ascii": "^+\\^*A^)!^.8^)!^!V^*W^,1^$-^(s^(x^*A^*J^#e^-+^!(^.!^(a^0=^*W",
      "encoded_base64": "XitcXipBXikhXi44XikhXiFWXipXXiwxXiQtXihzXih4XipBXipKXiNlXi0rXiEoXi4hXihhXjA9XipX",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_3337d2415250",
      "text": "全部",
      "encoded_ascii": "^!h^)#",
      "encoded_base64": "XiFoXikj",
      "byte_length": 6
    },
    {
      "unit_id": "DLG_631db704b305",
      "text": "一半",
      "encoded_ascii": "^!%^\"-",
      "encoded_base64": "XiElXiIt",
      "byte_length": 6
    },
    {
      "unit_id": "DLG_01aacc1022f4",
      "text": "  你們想要多少？",
      "encoded_ascii": "  ^*F^*{^,1^(C^\"x^#<^.V",
      "encoded_base64": "ICBeKkZeKnteLDFeKENeInheIzxeLlY=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_0b30111a150a",
      "text": "  我才不會給你們這群惡棍半毛錢！",
      "encoded_ascii": "  ^$%^$,^!)^$r^'A^*F^*{^(s^'R^#y^%0^\"-^%R^.<^*W",
      "encoded_base64": "ICBeJCVeJCxeISleJHJeJ0FeKkZeKnteKHNeJ1JeI3leJTBeIi1eJVJeLjxeKlc=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_f26ea72fe86d",
      "text": "  那也太多了吧！",
      "encoded_ascii": "  ^)!^!1^+f^\"x^*D^*I^*W",
      "encoded_base64": "ICBeKSFeITFeK2ZeInheKkReKkleKlc=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_b1cb7570b141",
      "text": "  放我們過去，否則就納命來！",
      "encoded_ascii": "  ^$P^$%^*{^(x^\"6^*A^\"H^!x^*J^';^\"N^!O^*W",
      "encoded_base64": "ICBeJFBeJCVeKnteKHheIjZeKkFeIkheIXheKkpeJzteIk5eIU9eKlc=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_7a9dd3be09af",
      "text": "  我身上根本沒錢。",
      "encoded_ascii": "  ^$%^(c^!'^%)^$x^%\\^.<^!\"",
      "encoded_base64": "ICBeJCVeKGNeISdeJSleJHheJVxeLjxeISI=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_59372c1f76a2",
      "text": "  好啦，拿去吧。",
      "encoded_ascii": "  ^+i^+R^*A^,G^\"6^*I^!\"",
      "encoded_base64": "ICBeK2leK1JeKkFeLEdeIjZeKkleISI=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_cf8089fd3386",
      "text": "  好吧，裝備給你們就是了。",
      "encoded_ascii": "  ^+i^*I^*A^(A^+\"^'A^*F^*{^*J^,X^*D^!\"",
      "encoded_base64": "ICBeK2leKkleKkFeKEFeKyJeJ0FeKkZeKnteKkpeLFheKkReISI=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_6e281c21e48e",
      "text": "  那我們走別條路就是了。再見。",
      "encoded_ascii": "  ^)!^$%^*{^.&^*H^%.^(a^*J^,X^*D^!\"^!l^-m^!\"",
      "encoded_base64": "ICBeKSFeJCVeKnteLiZeKkheJS5eKGFeKkpeLFheKkReISJeIWxeLW1eISI=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_3d8d805eb71a",
      "text": "那名鼠人轉向他的一名同夥。",
      "encoded_ascii": "^)!^\"F^*=^!<^(i^+?^!@^&Z^!%^\"F^\"E^5?^!\"",
      "encoded_base64": "XikhXiJGXio9XiE8XihpXis/XiFAXiZaXiElXiJGXiJFXjU/XiEi",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_2f7c8544bed8",
      "text": "哈雷爾，去告訴丘爾我們有客人來了。",
      "encoded_ascii": "^+F^)c^&/^*A^\"6^+B^-t^5(^&/^$%^*{^$s^+q^!<^!O^*D^!\"",
      "encoded_base64": "XitGXiljXiYvXipBXiI2XitCXi10XjUoXiYvXiQlXip7XiRzXitxXiE8XiFPXipEXiEi",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_865265c11412",
      "text": "交出你身上 ",
      "encoded_ascii": "^0P^!q^*F^(c^!' ",
      "encoded_base64": "XjBQXiFxXipGXihjXiEnIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_66ced866d091",
      "text": " 的陶幣！這些錢應該就夠了！",
      "encoded_ascii": " ^&Z^)R^+|^*W^(s^!8^.<^0`^(M^*J^+d^*D^*W",
      "encoded_base64": "IF4mWl4pUl4rfF4qV14oc14hOF4uPF4wYF4oTV4qSl4rZF4qRF4qVw==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_0c3c932a9418",
      "text": "不交出 ",
      "encoded_ascii": "^!)^0P^!q ",
      "encoded_base64": "XiEpXjBQXiFxIA==",
      "byte_length": 10
    },
    {
      "unit_id": "DLG_6cb9c5ddfb0f",
      "text": " 的財物，你們哪裡也別想去！",
      "encoded_ascii": " ^&Z^0=^&4^*A^*F^*{^+I^-j^!1^*H^,1^\"6^*W",
      "encoded_base64": "IF4mWl4wPV4mNF4qQV4qRl4qe14rSV4tal4hMV4qSF4sMV4iNl4qVw==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_db3c054e04df",
      "text": "別妄想了！你們得乖乖付給我們 ",
      "encoded_ascii": "^*H^+j^,1^*D^*W^*F^*{^#e^0{^0{^*u^'A^$%^*{ ",
      "encoded_base64": "XipIXitqXiwxXipEXipXXipGXip7XiNlXjB7XjB7Xip1XidBXiQlXip7IA==",
      "byte_length": 43
    },
    {
      "unit_id": "DLG_e6bf20569634",
      "text": " 陶幣！",
      "encoded_ascii": " ^)R^+|^*W",
      "encoded_base64": "IF4pUl4rfF4qVw==",
      "byte_length": 10
    },
    {
      "unit_id": "DLG_c821c5e592af",
      "text": "錢！",
      "encoded_ascii": "^.<^*W",
      "encoded_base64": "Xi48XipX",
      "byte_length": 6
    },
    {
      "unit_id": "DLG_577b0c25316d",
      "text": "到底想不想過？把錢交出來！",
      "encoded_ascii": "^!u^/^^,1^!)^,1^(x^.V^$1^.<^0P^!q^!O^*W",
      "encoded_base64": "XiF1Xi9eXiwxXiEpXiwxXih4Xi5WXiQxXi48XjBQXiFxXiFPXipX",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_f5c68c58c376",
      "text": "那我們就改拿你們的裝備來抵！",
      "encoded_ascii": "^)!^$%^*{^*J^$N^,G^*F^*{^&Z^(A^+\"^!O^$5^*W",
      "encoded_base64": "XikhXiQlXip7XipKXiROXixHXipGXip7XiZaXihBXisiXiFPXiQ1XipX",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_89a1aa944ca4",
      "text": "呃……這次就替你們破個例吧。",
      "encoded_ascii": "^3<^*o^*o^(s^%D^*J^2o^*F^*{^&n^!V^9h^*I^!\"",
      "encoded_base64": "XjM8XipvXipvXihzXiVEXipKXjJvXipGXip7XiZuXiFWXjloXipJXiEi",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_b59ac1567448",
      "text": "行了，過去吧。",
      "encoded_ascii": "^(;^*D^*A^(x^\"6^*I^!\"",
      "encoded_base64": "Xig7XipEXipBXih4XiI2XipJXiEi",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_b041e2f14f82",
      "text": "那我們抓了你們換賞金也一樣！",
      "encoded_ascii": "^)!^$%^*{^$2^*D^*F^*{^4@^*T^)+^!1^!%^,f^*W",
      "encoded_base64": "XikhXiQlXip7XiQyXipEXipGXip7XjRAXipUXikrXiExXiElXixmXipX",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_22cbb73550a8",
      "text": "衛兵！快到底下來！有奴隸逃跑了！衛兵！",
      "encoded_ascii": "^(=^+,^*W^*L^!u^/^^!(^!O^*W^$s^##^)Z^(p^(_^*D^*W^(=^+,^*W",
      "encoded_base64": "Xig9XissXipXXipMXiF1Xi9eXiEoXiFPXipXXiRzXiMjXilaXihwXihfXipEXipXXig9XissXipX",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_cef52672f36b",
      "text": "噢，又是你們。隨便你們想去哪吧，我們可不想惹麻煩。",
      "encoded_ascii": "^+]^*A^+;^,X^*F^*{^!\"^)X^!R^*F^*{^,1^\"6^+I^*I^*A^$%^*{^\"A^!)^,1^3s^*6^-!^!\"",
      "encoded_base64": "XitdXipBXis7XixYXipGXip7XiEiXilYXiFSXipGXip7XiwxXiI2XitJXipJXipBXiQlXip7XiJBXiEpXiwxXjNzXio2Xi0hXiEi",
      "byte_length": 75
    },
    {
      "unit_id": "DLG_843994ca633d",
      "text": "你們找碴是不是？",
      "encoded_ascii": "^*F^*{^$/^=h^,X^!)^,X^.V",
      "encoded_base64": "XipGXip7XiQvXj1oXixYXiEpXixYXi5W",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_7aa1b425c0a3",
      "text": "趁我們還沒決定要你們加倍奉還之前，給我滾遠點！",
      "encoded_ascii": "^.)^$%^*{^.7^%\\^,o^#.^(C^*F^*{^\"\"^!W^1+^.7^!/^!z^*A^'A^$%^,z^({^*;^*W",
      "encoded_base64": "Xi4pXiQlXip7Xi43XiVcXixvXiMuXihDXipGXip7XiIiXiFXXjErXi43XiEvXiF6XipBXidBXiQlXix6Xih7Xio7XipX",
      "byte_length": 69
    },
    {
      "unit_id": "DLG_2d87ab46d322",
      "text": "你們想要什麼？",
      "encoded_ascii": "^*F^*{^,1^(C^!=^.T^.V",
      "encoded_base64": "XipGXip7XiwxXihDXiE9Xi5UXi5W",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_f39fb4721f94",
      "text": "  你們為什麼要跟蹤我？",
      "encoded_ascii": "  ^*F^*{^%{^!=^.T^(C^.+^(b^$%^.V",
      "encoded_base64": "ICBeKkZeKnteJXteIT1eLlReKENeLiteKGJeJCVeLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_489b4800bda3",
      "text": "  滾一邊去！",
      "encoded_ascii": "  ^,z^!%^.8^\"6^*W",
      "encoded_base64": "ICBeLHpeISVeLjheIjZeKlc=",
      "byte_length": 17
    },
    {
      "unit_id": "DLG_803040a54c94",
      "text": "  好吧。",
      "encoded_ascii": "  ^+i^*I^!\"",
      "encoded_base64": "ICBeK2leKkleISI=",
      "byte_length": 11
    },
    {
      "unit_id": "DLG_0a6ab0a8e94a",
      "text": "  我宣布取消這次襲擊！",
      "encoded_ascii": "  ^$%^2d^.`^\":^%k^(s^%D^08^$F^*W",
      "encoded_base64": "ICBeJCVeMmReLmBeIjpeJWteKHNeJUReMDheJEZeKlc=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_b99dd378e1fe",
      "text": "算了，沒事。",
      "encoded_ascii": "^-C^*D^*A^%\\^*r^!\"",
      "encoded_base64": "Xi1DXipEXipBXiVcXipyXiEi",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_498d01337334",
      "text": " 我們該動身出發了。",
      "encoded_ascii": " ^$%^*{^(M^\"%^(c^!q^&W^*D^!\"",
      "encoded_base64": "IF4kJV4qe14oTV4iJV4oY14hcV4mV14qRF4hIg==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_e3b4a9ba08f7",
      "text": "抱歉！",
      "encoded_ascii": "^,@^,h^*W",
      "encoded_base64": "XixAXixoXipX",
      "byte_length": 9
    },
    {
      "unit_id": "DLG_a6b8900eab16",
      "text": "你想打聽些什麼？",
      "encoded_ascii": "^*F^,1^$-^-X^!8^!=^.T^.V",
      "encoded_base64": "XipGXiwxXiQtXi1YXiE4XiE9Xi5UXi5W",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_aa1c0c9dd7f5",
      "text": "我們本該幫你們鏟平高層巢穴的。",
      "encoded_ascii": "^$%^*{^$x^(M^+}^*F^*{^)=^0Y^*+^#B^#G^'&^&Z^!\"",
      "encoded_base64": "XiQlXip7XiR4XihNXit9XipGXip7Xik9XjBZXiorXiNCXiNHXicmXiZaXiEi",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_7ac841b30420",
      "text": " 我們還得找出高層巢穴的酋長並宰了他。",
      "encoded_ascii": " ^$%^*{^.7^#e^$/^!q^*+^#B^#G^'&^&Z^=5^)C^!+^1w^*D^!@^!\"",
      "encoded_base64": "IF4kJV4qe14uN14jZV4kL14hcV4qK14jQl4jR14nJl4mWl49NV4pQ14hK14xd14qRF4hQF4hIg==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_8ee7234efce8",
      "text": "那進攻高層巢穴的事怎麼說？丘爾叫我們現在就發動攻擊。",
      "encoded_ascii": "^)!^(w^$O^*+^#B^#G^'&^&Z^*r^,,^.T^-x^.V^5(^&/^+<^$%^*{^&?^\"d^*J^&W^\"%^$O^$F^!\"",
      "encoded_base64": "XikhXih3XiRPXiorXiNCXiNHXicmXiZaXipyXiwsXi5UXi14Xi5WXjUoXiYvXis8XiQlXip7XiY/XiJkXipKXiZXXiIlXiRPXiRGXiEi",
      "byte_length": 78
    },
    {
      "unit_id": "DLG_d8432bf1948f",
      "text": "那就上吧！",
      "encoded_ascii": "^)!^*J^!'^*I^*W",
      "encoded_base64": "XikhXipKXiEnXipJXipX",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_b1dd6ce4de86",
      "text": "你犯了個大錯，懦夫！丘爾絕不會放過你的！",
      "encoded_ascii": "^*F^-%^*D^!V^\"z^)5^*A^,7^\"{^*W^5(^&/^-I^!)^$r^$P^(x^*F^&Z^*W",
      "encoded_base64": "XipGXi0lXipEXiFWXiJ6Xik1XipBXiw3XiJ7XipXXjUoXiYvXi1JXiEpXiRyXiRQXih4XipGXiZaXipX",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_5bf84623256e",
      "text": "  誰是丘爾？",
      "encoded_ascii": "  ^-y^,X^5(^&/^.V",
      "encoded_base64": "ICBeLXleLFheNSheJi9eLlY=",
      "byte_length": 17
    },
    {
      "unit_id": "DLG_6f276875c53e",
      "text": "  跟我說說丘爾的事。",
      "encoded_ascii": "  ^.+^$%^-x^-x^5(^&/^&Z^*r^!\"",
      "encoded_base64": "ICBeLiteJCVeLXheLXheNSheJi9eJlpeKnJeISI=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_04921cd62c57",
      "text": "  他有何能耐讓人敬重？",
      "encoded_ascii": "  ^!@^$s^!L^'b^-S^-}^!<^*O^))^.V",
      "encoded_base64": "ICBeIUBeJHNeIUxeJ2JeLVNeLX1eITxeKk9eKSleLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_fe6183b7e872",
      "text": "  在我們進攻她的巢穴前，我必須先弄清楚。",
      "encoded_ascii": "  ^\"d^$%^*{^(w^$O^+h^&Z^#G^'&^!z^*A^$%^#l^)r^!b^/`^,u^,c^!\"",
      "encoded_base64": "ICBeImReJCVeKnteKHdeJE9eK2heJlpeI0deJyZeIXpeKkFeJCVeI2xeKXJeIWJeL2BeLHVeLGNeISI=",
      "byte_length": 59
    },
    {
      "unit_id": "DLG_656e3412836e",
      "text": "  跟我說說那個女孩的事，鼠人！",
      "encoded_ascii": "  ^.+^$%^-x^-x^)!^!V^#\"^+m^&Z^*r^*A^*=^!<^*W",
      "encoded_base64": "ICBeLiteJCVeLXheLXheKSFeIVZeIyJeK21eJlpeKnJeKkFeKj1eITxeKlc=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_1cb352bcef5f",
      "text": "  跟我說說下水道的事。",
      "encoded_ascii": "  ^.+^$%^-x^-x^!(^%V^(y^&Z^*r^!\"",
      "encoded_base64": "ICBeLiteJCVeLXheLXheISheJVZeKHleJlpeKnJeISI=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_eeea53411147",
      "text": "  沖洗通道裡有什麼？",
      "encoded_ascii": "  ^,p^0j^(t^(y^-j^$s^!=^.T^.V",
      "encoded_base64": "ICBeLHBeMGpeKHReKHleLWpeJHNeIT1eLlReLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_f0e87eb7bcad",
      "text": "  那個倖存者有說什麼嗎？",
      "encoded_ascii": "  ^)!^!V^5+^#*^'V^$s^-x^!=^.T^+X^.V",
      "encoded_base64": "ICBeKSFeIVZeNSteIypeJ1ZeJHNeLXheIT1eLlReK1heLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_d8f5f81002f5",
      "text": "  沖洗通道在哪裡",
      "encoded_ascii": "  ^,p^0j^(t^(y^\"d^+I^-j",
      "encoded_base64": "ICBeLHBeMGpeKHReKHleImReK0leLWo=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_1beb6f25d07d",
      "text": "  其他的巢穴呢？",
      "encoded_ascii": "  ^!j^!@^&Z^#G^'&^+C^.V",
      "encoded_base64": "ICBeIWpeIUBeJlpeI0deJyZeK0NeLlY=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_8cd0e0291625",
      "text": "  關於高層巢穴，你都知道些什麼？",
      "encoded_ascii": "  ^.>^$^^*+^#B^#G^'&^*A^*F^)$^&h^(y^!8^!=^.T^.V",
      "encoded_base64": "ICBeLj5eJF5eKiteI0JeI0deJyZeKkFeKkZeKSReJmheKHleITheIT1eLlReLlY=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_65e318f8da3e",
      "text": " 我現在還有要緊事要辦。 ",
      "encoded_ascii": " ^$%^&?^\"d^.7^$s^(C^0r^*r^(C^2L^!\" ",
      "encoded_base64": "IF4kJV4mP14iZF4uN14kc14oQ14wcl4qcl4oQ14yTF4hIiA=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_f81a4775b493",
      "text": "巢穴主管丘爾是我們的領袖——",
      "encoded_ascii": "^#G^'&^!-^-D^5(^&/^,X^$%^*{^&Z^)s^7G^*n^*n",
      "encoded_base64": "XiNHXicmXiEtXi1EXjUoXiYvXixYXiQlXip7XiZaXilzXjdHXipuXipu",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_3923713ebe63",
      "text": "丘爾乃是",
      "encoded_ascii": "^5(^&/^/M^,X",
      "encoded_base64": "XjUoXiYvXi9NXixY",
      "byte_length": 12
    },
    {
      "unit_id": "DLG_bdde824a24e5",
      "text": " 只要我們把高層巢穴裡的老鼠雜碎全宰光，我們就能掌控整個 ",
      "encoded_ascii": " ^\"?^(C^$%^*{^$1^*+^#B^#G^'&^-j^&Z^'U^*=^0G^&o^!h^1w^!c^*A^$%^*{^*J^'b^$;^$@^$T^!V ",
      "encoded_base64": "IF4iP14oQ14kJV4qe14kMV4qK14jQl4jR14nJl4tal4mWl4nVV4qPV4wR14mb14haF4xd14hY14qQV4kJV4qe14qSl4nYl4kO14kQF4kVF4hViA=",
      "byte_length": 83
    },
    {
      "unit_id": "DLG_58679b87852e",
      "text": "下水道。",
      "encoded_ascii": "^!(^%V^(y^!\"",
      "encoded_base64": "XiEoXiVWXih5XiEi",
      "byte_length": 12
    },
    {
      "unit_id": "DLG_2209b70d417a",
      "text": "我不能告訴你。丘爾下令不准向任何人透露關於 ",
      "encoded_ascii": "^$%^!)^'b^+B^-t^*F^!\"^5(^&/^!(^*w^!)^/Q^+?^!C^!L^!<^(q^.B^.>^$^ ",
      "encoded_base64": "XiQlXiEpXidiXitCXi10XipGXiEiXjUoXiYvXiEoXip3XiEpXi9RXis/XiFDXiFMXiE8XihxXi5CXi4+XiReIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_5a3bd81ab6c3",
      "text": "高層巢穴酋長女兒的事。",
      "encoded_ascii": "^*+^#B^#G^'&^=5^)C^#\"^++^&Z^*r^!\"",
      "encoded_base64": "XiorXiNCXiNHXicmXj01XilDXiMiXisrXiZaXipyXiEi",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_b8bad20dc099",
      "text": "沒錯，這就說得通了——正是丘爾綁架了高層巢穴 ",
      "encoded_ascii": "^%\\^)5^*A^(s^*J^-x^#e^(t^*D^*n^*n^%H^,X^5(^&/^-K^%\"^*D^*+^#B^#G^'& ",
      "encoded_base64": "XiVcXik1XipBXihzXipKXi14XiNlXih0XipEXipuXipuXiVIXixYXjUoXiYvXi1LXiUiXipEXiorXiNCXiNHXicmIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_eb3ff26b8102",
      "text": "酋長的女兒。我不知道他把她弄去哪了，但我已經很久 ",
      "encoded_ascii": "^=5^)C^&Z^#\"^++^!\"^$%^!)^&h^(y^!@^$1^+h^/`^\"6^+I^*D^*A^!I^$%^#J^'D^*K^!. ",
      "encoded_base64": "Xj01XilDXiZaXiMiXisrXiEiXiQlXiEpXiZoXih5XiFAXiQxXitoXi9gXiI2XitJXipEXipBXiFJXiQlXiNKXidEXipLXiEuIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_85e302cc84ef",
      "text": "沒見過她了。",
      "encoded_ascii": "^%\\^-m^(x^+h^*D^!\"",
      "encoded_base64": "XiVcXi1tXih4XitoXipEXiEi",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_39d75ee30f78",
      "text": "我……我不能說。求求你別傷害我！要是我說了，丘爾會把我拿去餵軟泥怪的 ",
      "encoded_ascii": "^$%^*o^*o^$%^!)^'b^-x^!\"^,n^,n^*F^*H^!^^#/^$%^*W^(C^,X^$%^-x^*D^*A^5(^&/^$r^$1^$%^,G^\"6^.L^.x^%d^#s^&Z ",
      "encoded_base64": "XiQlXipvXipvXiQlXiEpXidiXi14XiEiXixuXixuXipGXipIXiFeXiMvXiQlXipXXihDXixYXiQlXi14XipEXipBXjUoXiYvXiRyXiQxXiQlXixHXiI2Xi5MXi54XiVkXiNzXiZaIA==",
      "byte_length": 103
    },
    {
      "unit_id": "DLG_e58c8145f175",
      "text": "！",
      "encoded_ascii": "^*W",
      "encoded_base64": "XipX",
      "byte_length": 3
    },
    {
      "unit_id": "DLG_c0eab58662d4",
      "text": "下水道被劃分成各個鼠人聚居的巢穴。你要找就去找 ",
      "encoded_ascii": "^!(^%V^(y^(@^4s^!s^$$^+>^!V^*=^!<^'[^+w^&Z^#G^'&^!\"^*F^(C^$/^*J^\"6^$/ ",
      "encoded_base64": "XiEoXiVWXih5XihAXjRzXiFzXiQkXis+XiFWXio9XiE8XidbXit3XiZaXiNHXicmXiEiXipGXihDXiQvXipKXiI2XiQvIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_4ae7d80b5568",
      "text": "丘爾談。他是最強的巢穴主管，而且低層巢穴擁有 ",
      "encoded_ascii": "^5(^&/^0;^!\"^!@^,X^$q^#]^&Z^#G^'&^!-^-D^*A^'W^!*^!K^#B^#G^'&^,M^$s ",
      "encoded_base64": "XjUoXiYvXjA7XiEiXiFAXixYXiRxXiNdXiZaXiNHXicmXiEtXi1EXipBXidXXiEqXiFLXiNCXiNHXicmXixNXiRzIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_0ed50e6b5af6",
      "text": "最勇猛的戰士。但不管怎樣，千萬別去沖洗 ",
      "encoded_ascii": "^$q^\"$^*P^&Z^$(^+a^!\"^!I^!)^-D^,,^,f^*A^+7^-_^*H^\"6^,p^0j ",
      "encoded_base64": "XiRxXiIkXipQXiZaXiQoXithXiEiXiFJXiEpXi1EXiwsXixmXipBXis3Xi1fXipIXiI2XixwXjBqIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_fec4f8d0feec",
      "text": "通道。",
      "encoded_ascii": "^(t^(y^!\"",
      "encoded_base64": "Xih0Xih5XiEi",
      "byte_length": 9
    },
    {
      "unit_id": "DLG_d35cbb4349b8",
      "text": "沖洗通道就在遙遠的北方。",
      "encoded_ascii": "^,p^0j^(t^(y^*J^\"d^4j^({^&Z^+6^$]^!\"",
      "encoded_base64": "XixwXjBqXih0Xih5XipKXiJkXjRqXih7XiZaXis2XiRdXiEi",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_76ffa2c02f72",
      "text": "去了只有死路一條。我所知不多，但丘爾曾經派過一夥人 ",
      "encoded_ascii": "^\"6^*D^\"?^$s^%L^(a^!%^%.^!\"^$%^$)^&h^!)^\"x^*A^!I^5(^&/^.j^'D^.n^(x^!%^5?^!< ",
      "encoded_base64": "XiI2XipEXiI/XiRzXiVMXihhXiElXiUuXiEiXiQlXiQpXiZoXiEpXiJ4XipBXiFJXjUoXiYvXi5qXidEXi5uXih4XiElXjU/XiE8IA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_72c9a3d9dbd9",
      "text": "上去那裡——去看看排水管裡有沒有值錢的東西。結果只有 ",
      "encoded_ascii": "^!'^\"6^)!^-j^*n^*n^\"6^*Q^*Q^$<^%V^-D^-j^$s^%\\^$s^!Z^.<^&Z^,`^-l^!\"^'@^%!^\"?^$s ",
      "encoded_base64": "XiEnXiI2XikhXi1qXipuXipuXiI2XipRXipRXiQ8XiVWXi1EXi1qXiRzXiVcXiRzXiFaXi48XiZaXixgXi1sXiEiXidAXiUhXiI/XiRzIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_4fdb4a9a325e",
      "text": "一個人逃了回來，而且回來後馬上就斷氣了。",
      "encoded_ascii": "^!%^!V^!<^(p^*D^\"\\^!O^*A^'W^!*^\"\\^!O^#b^*\"^!'^*J^,T^%U^*D^!\"",
      "encoded_base64": "XiElXiFWXiE8XihwXipEXiJcXiFPXipBXidXXiEqXiJcXiFPXiNiXioiXiEnXipKXixUXiVVXipEXiEi",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_54872315863b",
      "text": "他說東北邊的一個水池排空後，大群殭屍從水柵裡蜂擁而出 ",
      "encoded_ascii": "^!@^-x^,`^+6^.8^&Z^!%^!V^%V^%X^$<^'(^#b^*A^\"z^'R^3N^#?^#f^%V^%(^-j^=i^,M^'W^!q ",
      "encoded_base64": "XiFAXi14XixgXis2Xi44XiZaXiElXiFWXiVWXiVYXiQ8XicoXiNiXipBXiJ6XidSXjNOXiM/XiNmXiVWXiUoXi1qXj1pXixNXidXXiFxIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_391ca47e1485",
      "text": "。除了他之外，所有人都被抓走了。",
      "encoded_ascii": "^!\"^)Q^*D^!@^!/^\"w^*A^$)^$s^!<^)$^(@^$2^.&^*D^!\"",
      "encoded_base64": "XiEiXilRXipEXiFAXiEvXiJ3XipBXiQpXiRzXiE8XikkXihAXiQyXi4mXipEXiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_c25f26412f10",
      "text": "軟弱的鼠人都住在高層巢穴。他們是一幫自私又 ",
      "encoded_ascii": "^.x^#\\^&Z^*=^!<^)$^*z^\"d^*+^#B^#G^'&^!\"^!@^*{^,X^!%^+}^'l^&~^+; ",
      "encoded_base64": "Xi54XiNcXiZaXio9XiE8XikkXip6XiJkXiorXiNCXiNHXicmXiEiXiFAXip7XixYXiElXit9XidsXiZ+Xis7IA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_d48a884dd7b9",
      "text": "膽小的傢伙。",
      "encoded_ascii": "^-[^#;^&Z^+#^*y^!\"",
      "encoded_base64": "Xi1bXiM7XiZaXisjXip5XiEi",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_365fc3a3506a",
      "text": " 是一位偉大又兇猛的戰士，你最好懂得敬重他！",
      "encoded_ascii": " ^,X^!%^!J^*}^\"z^+;^*G^*P^&Z^$(^+a^*A^*F^$q^+i^,6^#e^*O^))^!@^*W",
      "encoded_base64": "IF4sWF4hJV4hSl4qfV4iel4rO14qR14qUF4mWl4kKF4rYV4qQV4qRl4kcV4raV4sNl4jZV4qT14pKV4hQF4qVw==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_47bce7863419",
      "text": "平靜的水面泛起一陣短暫的漣漪。",
      "encoded_ascii": "^0Y^)h^&Z^%V^)j^0i^.(^!%^)P^&i^$l^&Z^=p^=q^!\"",
      "encoded_base64": "XjBZXiloXiZaXiVWXilqXjBpXi4oXiElXilQXiZpXiRsXiZaXj1wXj1xXiEi",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_c4b0720573bf",
      "text": "牆壁與地面上的水珠泛起一陣微光。",
      "encoded_ascii": "^&0^*\\^'p^\"e^)j^!'^&Z^%V^&>^0i^.(^!%^)P^#i^!c^!\"",
      "encoded_base64": "XiYwXipcXidwXiJlXilqXiEnXiZaXiVWXiY+XjBpXi4oXiElXilQXiNpXiFjXiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_3900f875146b",
      "text": "水流在鐵柵周圍咕嘟作響，但隨即便後勁不足地平息了下來。",
      "encoded_ascii": "^%V^%j^\"d^)?^%(^\"L^\"`^=k^=l^!M^)o^*A^!I^)X^\"1^!R^#b^+3^!)^(^^\"e^0Y^#w^*D^!(^!O^!\"",
      "encoded_base64": "XiVWXiVqXiJkXik/XiUoXiJMXiJgXj1rXj1sXiFNXilvXipBXiFJXilYXiIxXiFSXiNiXiszXiEpXiheXiJlXjBZXiN3XipEXiEoXiFPXiEi",
      "byte_length": 81
    },
    {
      "unit_id": "DLG_4f208a15ac5d",
      "text": " 法杖微微朝著東北方牽引拉扯。",
      "encoded_ascii": " ^%b^${^#i^#i^,^^-a^,`^+6^$]^5e^#Z^$6^.e^!\"",
      "encoded_base64": "IF4lYl4ke14jaV4jaV4sXl4tYV4sYF4rNl4kXV41ZV4jWl4kNl4uZV4hIg==",
      "byte_length": 43
    },
    {
      "unit_id": "DLG_11ab8df9874a",
      "text": "卷軸",
      "encoded_ascii": "^\"3^(e",
      "encoded_base64": "XiIzXihl",
      "byte_length": 6
    },
    {
      "unit_id": "DLG_7877040ae39f",
      "text": "滾開那裡！你們竟敢褻瀆我們的神廟？！",
      "encoded_ascii": "^,z^)F^)!^-j^*W^*F^*{^28^/m^-k^,~^$%^*{^&Z^&w^0[^.V^*W",
      "encoded_base64": "Xix6XilGXikhXi1qXipXXipGXip7XjI4Xi9tXi1rXix+XiQlXip7XiZaXiZ3XjBbXi5WXipX",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_5c59efe9b6d2",
      "text": "  對不起，我只是好奇而已。",
      "encoded_ascii": "  ^#:^!)^.(^*A^$%^\"?^,X^+i^\"}^'W^#J^!\"",
      "encoded_base64": "ICBeIzpeISleLiheKkFeJCVeIj9eLFheK2leIn1eJ1deI0peISI=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_20af6de424bd",
      "text": "以後給我放規矩點！",
      "encoded_ascii": "^!B^#b^'A^$%^$P^6'^5k^*;^*W",
      "encoded_base64": "XiFCXiNiXidBXiQlXiRQXjYnXjVrXio7XipX",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_f8a85104988f",
      "text": "你絕不可能活著為此後悔！",
      "encoded_ascii": "^*F^-I^!)^\"A^'b^%i^-a^%{^%I^#b^6Y^*W",
      "encoded_base64": "XipGXi1JXiEpXiJBXidiXiVpXi1hXiV7XiVJXiNiXjZZXipX",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_24a3be998d09",
      "text": "魔法法杖",
      "encoded_ascii": "^*0^%b^%b^${",
      "encoded_base64": "XiowXiViXiViXiR7",
      "byte_length": 12
    },
    {
      "unit_id": "DLG_0ccbbae848ac",
      "text": "魔法斧",
      "encoded_ascii": "^*0^%b^$Z",
      "encoded_base64": "XiowXiViXiRa",
      "byte_length": 9
    },
    {
      "unit_id": "DLG_3ec8c1a6ad27",
      "text": "嘿！從那裡滾出來！",
      "encoded_ascii": "^+\\^*W^#f^)!^-j^,z^!q^!O^*W",
      "encoded_base64": "XitcXipXXiNmXikhXi1qXix6XiFxXiFPXipX",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_0e75eff18c2e",
      "text": "  有種來阻止我啊，鼠人！",
      "encoded_ascii": "  ^$s^'$^!O^)L^%G^$%^+Q^*A^*=^!<^*W",
      "encoded_base64": "ICBeJHNeJyReIU9eKUxeJUdeJCVeK1FeKkFeKj1eITxeKlc=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_d7e003b112c6",
      "text": "  抱歉，我無意冒犯你。",
      "encoded_ascii": "  ^,@^,h^*A^$%^%}^#z^/P^-%^*F^!\"",
      "encoded_base64": "ICBeLEBeLGheKkFeJCVeJX1eI3peL1BeLSVeKkZeISI=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_1bd43927ab33",
      "text": "我、呃，我並不想傷害你們。像我們這樣的勇士， ",
      "encoded_ascii": "^$%^!!^3<^*A^$%^!+^!)^,1^!^^#/^*F^*{^!\"^!`^$%^*{^(s^,f^&Z^\"$^+a^*A ",
      "encoded_base64": "XiQlXiEhXjM8XipBXiQlXiErXiEpXiwxXiFeXiMvXipGXip7XiEiXiFgXiQlXip7XihzXixmXiZaXiIkXithXipBIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_414a648cd8a8",
      "text": "應該成為盟友，而非仇敵。我的就是你們的。",
      "encoded_ascii": "^0`^(M^$$^%{^-0^\"8^*A^'W^)i^1g^$U^!\"^$%^&Z^*J^,X^*F^*{^&Z^!\"",
      "encoded_base64": "XjBgXihNXiQkXiV7Xi0wXiI4XipBXidXXilpXjFnXiRVXiEiXiQlXiZaXipKXixYXipGXip7XiZaXiEi",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_ad8bf407d1df",
      "text": "哈！殺你連一滴汗都不用流！",
      "encoded_ascii": "^+F^*W^%M^*F^.0^!%^2u^;j^)$^!)^&H^%j^*W",
      "encoded_base64": "XitGXipXXiVNXipGXi4wXiElXjJ1XjtqXikkXiEpXiZIXiVqXipX",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_3152071be72f",
      "text": "沒事，只要別想偷我的東西就好。",
      "encoded_ascii": "^%\\^*r^*A^\"?^(C^*H^,1^/O^$%^&Z^,`^-l^*J^+i^!\"",
      "encoded_base64": "XiVcXipyXipBXiI/XihDXipIXiwxXi9PXiQlXiZaXixgXi1sXipKXitpXiEi",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_35183ac538cc",
      "text": "戒指",
      "encoded_ascii": "^$&^$8",
      "encoded_base64": "XiQmXiQ4",
      "byte_length": 6
    },
    {
      "unit_id": "DLG_e6a917738287",
      "text": "寶石",
      "encoded_ascii": "^#4^&k",
      "encoded_base64": "XiM0XiZr",
      "byte_length": 6
    },
    {
      "unit_id": "DLG_2b2e8052818b",
      "text": "找到了一個",
      "encoded_ascii": "^$/^!u^*D^!%^!V",
      "encoded_base64": "XiQvXiF1XipEXiElXiFW",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_0b5678cf4886",
      "text": "幾枚沾滿污穢的陶幣",
      "encoded_ascii": "^#T^$~^74^,{^0h^0q^&Z^)R^+|",
      "encoded_base64": "XiNUXiR+Xjc0Xix7XjBoXjBxXiZaXilSXit8",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_122a95896024",
      "text": "你在排水管裡發現了一根隱蔽的拉桿",
      "encoded_ascii": "^*F^\"d^$<^%V^-D^-j^&W^&?^*D^!%^%)^)Y^('^&Z^$6^%,",
      "encoded_base64": "XipGXiJkXiQ8XiVWXi1EXi1qXiZXXiY/XipEXiElXiUpXilZXignXiZaXiQ2XiUs",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_2dc540abf5df",
      "text": "，並拆除了連接著它的精巧隱蔽陷阱",
      "encoded_ascii": "^*A^!+^=o^)Q^*D^.0^$?^-a^+o^&Z^'7^3D^)Y^('^)S^)J",
      "encoded_base64": "XipBXiErXj1vXilRXipEXi4wXiQ/Xi1hXitvXiZaXic3XjNEXilZXignXilTXilK",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_20b4a42ea155",
      "text": "你要拉動這根拉桿嗎？",
      "encoded_ascii": "^*F^(C^$6^\"%^(s^%)^$6^%,^+X^.V",
      "encoded_base64": "XipGXihDXiQ2XiIlXihzXiUpXiQ2XiUsXitYXi5W",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_b115913004cc",
      "text": "拉桿卡住了。",
      "encoded_ascii": "^$6^%,^\"0^*z^*D^!\"",
      "encoded_base64": "XiQ2XiUsXiIwXip6XipEXiEi",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_31ef11281056",
      "text": " 驚動了一隻正在垃圾堆裡進食的老鼠。它受驚之下咬了 ",
      "encoded_ascii": " ^.Q^\"%^*D^!%^)[^%H^\"d^\"i^\"f^*[^-j^(w^0J^&Z^'U^*=^!\"^+o^\";^.Q^!/^!(^\"Q^*D ",
      "encoded_base64": "IF4uUV4iJV4qRF4hJV4pW14lSF4iZF4iaV4iZl4qW14tal4od14wSl4mWl4nVV4qPV4hIl4rb14iO14uUV4hL14hKF4iUV4qRCA=",
      "byte_length": 74
    },
    {
      "unit_id": "DLG_cd148d4db5d5",
      "text": "他",
      "encoded_ascii": "^!@",
      "encoded_base64": "XiFA",
      "byte_length": 3
    },
    {
      "unit_id": "DLG_a6a467e78a75",
      "text": " 一口。",
      "encoded_ascii": " ^!%^\"<^!\"",
      "encoded_base64": "IF4hJV4iPF4hIg==",
      "byte_length": 10
    },
    {
      "unit_id": "DLG_12ce098786cc",
      "text": "破碎陶罐",
      "encoded_ascii": "^&n^&o^)R^'O",
      "encoded_base64": "XiZuXiZvXilSXidP",
      "byte_length": 12
    },
    {
      "unit_id": "DLG_6d2275f92f59",
      "text": "匕首",
      "encoded_ascii": "^\"(^)~",
      "encoded_base64": "XiIoXil+",
      "byte_length": 6
    },
    {
      "unit_id": "DLG_2bca6ad869a8",
      "text": "頭骨",
      "encoded_ascii": "^)t^*$",
      "encoded_base64": "Xil0Xiok",
      "byte_length": 6
    },
    {
      "unit_id": "DLG_bc3273aa9621",
      "text": "裝滿發臭霉菌的空瓶",
      "encoded_ascii": "^(A^,{^&W^'m^0H^9M^&Z^'(^&D",
      "encoded_base64": "XihBXix7XiZXXidtXjBIXjlNXiZaXicoXiZE",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_b272ff5812da",
      "text": "廉價項鍊",
      "encoded_ascii": "^6X^+&^)q^)6",
      "encoded_base64": "XjZYXismXilxXik2",
      "byte_length": 12
    },
    {
      "unit_id": "DLG_6e40b081a3b1",
      "text": "腰帶",
      "encoded_ascii": "^'f^#N",
      "encoded_base64": "XidmXiNO",
      "byte_length": 6
    },
    {
      "unit_id": "DLG_8e170e730fef",
      "text": "甲殼",
      "encoded_ascii": "^&J^1F",
      "encoded_base64": "XiZKXjFG",
      "byte_length": 6
    },
    {
      "unit_id": "DLG_60cc8cf35d15",
      "text": " 摸到了滑溜溜的東西。而且還會動！",
      "encoded_ascii": " ^/j^!u^*D^%u^%r^%r^&Z^,`^-l^!\"^'W^!*^.7^$r^\"%^*W",
      "encoded_base64": "IF4val4hdV4qRF4ldV4lcl4lcl4mWl4sYF4tbF4hIl4nV14hKl4uN14kcl4iJV4qVw==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_97fa31fccdde",
      "text": "排水管裡除了一灘發臭的污水之外什麼也沒有。",
      "encoded_ascii": "^$<^%V^-D^-j^)Q^*D^!%^:j^&W^'m^&Z^0h^%V^!/^\"w^!=^.T^!1^%\\^$s^!\"",
      "encoded_base64": "XiQ8XiVWXi1EXi1qXilRXipEXiElXjpqXiZXXidtXiZaXjBoXiVWXiEvXiJ3XiE9Xi5UXiExXiVcXiRzXiEi",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_1f977adb5cf7",
      "text": "在一番摸索之後， ",
      "encoded_ascii": "^\"d^!%^2{^/j^'>^!/^#b^*A ",
      "encoded_base64": "XiJkXiElXjJ7Xi9qXic+XiEvXiNiXipBIA==",
      "byte_length": 25
    },
    {
      "unit_id": "DLG_da318af16305",
      "text": " 攪騰而起的只有滿腔惡臭， ",
      "encoded_ascii": " ^*c^.O^'W^.(^&Z^\"?^$s^,{^=r^#y^'m^*A ",
      "encoded_base64": "IF4qY14uT14nV14uKF4mWl4iP14kc14se149cl4jeV4nbV4qQSA=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_002fd837e7e6",
      "text": " 搜找完全一無所獲。",
      "encoded_ascii": " ^/h^$/^#,^!h^!%^%}^$)^&:^!\"",
      "encoded_base64": "IF4vaF4kL14jLF4haF4hJV4lfV4kKV4mOl4hIg==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_c4097f88b01e",
      "text": "排水管內壁覆蓋著一層黏液。",
      "encoded_ascii": "^$<^%V^-D^!g^*\\^(D^-d^-a^!%^#B^*9^%l^!\"",
      "encoded_base64": "XiQ8XiVWXi1EXiFnXipcXihEXi1kXi1hXiElXiNCXio5XiVsXiEi",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_75dfae653f61",
      "text": "在 ",
      "encoded_ascii": "^\"d ",
      "encoded_base64": "XiJkIA==",
      "byte_length": 4
    },
    {
      "unit_id": "DLG_a36b7c4c5f04",
      "text": "伸手進排水管摸索時，有蛆蟲爬到了 ",
      "encoded_ascii": "^/N^$+^(w^$<^%V^-D^/j^'>^$f^*A^$s^2C^(8^/y^!u^*D ",
      "encoded_base64": "Xi9OXiQrXih3XiQ8XiVWXi1EXi9qXic+XiRmXipBXiRzXjJDXig4Xi95XiF1XipEIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_c7637e73c5a4",
      "text": " 的手臂上。",
      "encoded_ascii": " ^&Z^$+^'k^!'^!\"",
      "encoded_base64": "IF4mWl4kK14na14hJ14hIg==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_117536c7dfb6",
      "text": " 抓了一把爛泥，除此之外一無所獲。",
      "encoded_ascii": " ^$2^*D^!%^$1^&-^%d^*A^)Q^%I^!/^\"w^!%^%}^$)^&:^!\"",
      "encoded_base64": "IF4kMl4qRF4hJV4kMV4mLV4lZF4qQV4pUV4lSV4hL14id14hJV4lfV4kKV4mOl4hIg==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_27081879ad22",
      "text": " 夠不著 ",
      "encoded_ascii": " ^+d^!)^-a ",
      "encoded_base64": "IF4rZF4hKV4tYSA=",
      "byte_length": 11
    },
    {
      "unit_id": "DLG_67f8ac7902b5",
      "text": "轉輪已經損壞了。",
      "encoded_ascii": "^(i^(h^#J^'D^$D^\"v^*D^!\"",
      "encoded_base64": "XihpXihoXiNKXidEXiREXiJ2XipEXiEi",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_21a94885de8d",
      "text": " 注意到內緣有磨損痕跡，就像有人曾拿槓桿撬過一樣。",
      "encoded_ascii": " ^%e^#z^!u^!g^9J^$s^-7^$D^3v^(`^*A^*J^!`^$s^!<^.j^,G^8^^%,^6]^(x^!%^,f^!\"",
      "encoded_base64": "IF4lZV4jel4hdV4hZ145Sl4kc14tN14kRF4zdl4oYF4qQV4qSl4hYF4kc14hPF4ual4sR144Xl4lLF42XV4oeF4hJV4sZl4hIg==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_776debdcf7f1",
      "text": " 現在沒時間做那件事。",
      "encoded_ascii": " ^&?^\"d^%\\^$f^)G^*~^)!^.W^*r^!\"",
      "encoded_base64": "IF4mP14iZF4lXF4kZl4pR14qfl4pIV4uV14qcl4hIg==",
      "byte_length": 31
    },
    {
      "unit_id": "DLG_524c02d3f46a",
      "text": "向你們致敬，高貴的勇士們！ ",
      "encoded_ascii": "^+?^*F^*{^'o^*O^*A^*+^2F^&Z^\"$^+a^*{^*W ",
      "encoded_base64": "Xis/XipGXip7XidvXipPXipBXiorXjJGXiZaXiIkXithXip7XipXIA==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_894e0053e4e5",
      "text": "你們為下水道剷除了那個卑鄙的丘爾，實乃功在全體，但是 ",
      "encoded_ascii": "^*F^*{^%{^!(^%V^(y^2Y^)Q^*D^)!^!V^\".^8,^&Z^5(^&/^*A^#3^/M^\"!^\"d^!h^**^*A^!I^,X ",
      "encoded_base64": "XipGXip7XiV7XiEoXiVWXih5XjJZXilRXipEXikhXiFWXiIuXjgsXiZaXjUoXiYvXipBXiMzXi9NXiIhXiJkXiFoXioqXipBXiFJXixYIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_a225596ffa63",
      "text": "你們能逃出奴隸欄真是莫大的幸運。是這樣的， ",
      "encoded_ascii": "^*F^*{^'b^(p^!q^##^)Z^%C^-2^,X^/F^\"z^&Z^15^.4^!\"^,X^(s^,f^&Z^*A ",
      "encoded_base64": "XipGXip7XidiXihwXiFxXiMjXilaXiVDXi0yXixYXi9GXiJ6XiZaXjE1Xi40XiEiXixYXihzXixmXiZaXipBIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_d2b87cf33bfe",
      "text": "有一件私事亟需仰仗你們過人的身手。",
      "encoded_ascii": "^$s^!%^.W^&~^*r^7O^)e^4,^0|^*F^*{^(x^!<^&Z^(c^$+^!\"",
      "encoded_base64": "XiRzXiElXi5XXiZ+XipyXjdPXillXjQsXjB8XipGXip7Xih4XiE8XiZaXihjXiQrXiEi",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_fabdb63fa8a4",
      "text": "  你有什麼難題？",
      "encoded_ascii": "  ^*F^$s^!=^.T^)a^.G^.V",
      "encoded_base64": "ICBeKkZeJHNeIT1eLlReKWFeLkdeLlY=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_4ac3124e4c3f",
      "text": "  你剛才提到的私事是什麼？",
      "encoded_ascii": "  ^*F^+0^$,^$A^!u^&Z^&~^*r^,X^!=^.T^.V",
      "encoded_base64": "ICBeKkZeKzBeJCxeJEFeIXVeJlpeJn5eKnJeLFheIT1eLlReLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_e860f613e2b1",
      "text": "  救了她，你能給我什麼回報？",
      "encoded_ascii": "  ^,Q^*D^+h^*A^*F^'b^'A^$%^!=^.T^\"\\^+`^.V",
      "encoded_base64": "ICBeLFFeKkReK2heKkFeKkZeJ2JeJ0FeJCVeIT1eLlReIlxeK2BeLlY=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_ff3190e5aeeb",
      "text": "  出發前我還想打聽更多情報。",
      "encoded_ascii": "  ^!q^&W^!z^$%^.7^,1^$-^-X^$o^\"x^,0^+`^!\"",
      "encoded_base64": "ICBeIXFeJldeIXpeJCVeLjdeLDFeJC1eLVheJG9eInheLDBeK2BeISI=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_26b71d4545e8",
      "text": "  關於米奎茲爾，你都知道些什麼？",
      "encoded_ascii": "  ^.>^$^^'4^5B^/D^&/^*A^*F^)$^&h^(y^!8^!=^.T^.V",
      "encoded_base64": "ICBeLj5eJF5eJzReNUJeL0ReJi9eKkFeKkZeKSReJmheKHleITheIT1eLlReLlY=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_c5ac23a1e262",
      "text": "  為什麼米奎茲爾的狂信徒會追隨他？",
      "encoded_ascii": "  ^%{^!=^.T^'4^5B^/D^&/^&Z^&8^!U^#d^$r^(o^)X^!@^.V",
      "encoded_base64": "ICBeJXteIT1eLlReJzReNUJeL0ReJi9eJlpeJjheIVVeI2ReJHJeKG9eKVheIUBeLlY=",
      "byte_length": 50
    },
    {
      "unit_id": "DLG_417c2e550916",
      "text": "  我很樂意幫你救回女兒。",
      "encoded_ascii": "  ^$%^*K^%8^#z^+}^*F^,Q^\"\\^#\"^++^!\"",
      "encoded_base64": "ICBeJCVeKkteJTheI3peK31eKkZeLFFeIlxeIyJeKyteISI=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_4929e53fea48",
      "text": "  我對你的麻煩沒興趣。",
      "encoded_ascii": "  ^$%^#:^*F^&Z^*6^-!^%\\^-]^.*^!\"",
      "encoded_base64": "ICBeJCVeIzpeKkZeJlpeKjZeLSFeJVxeLV1eLipeISI=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_0ff8a077f8f6",
      "text": "  把應得的獎賞給我，我已經做了這麼多。",
      "encoded_ascii": "  ^$1^0`^#e^&Z^7?^*T^'A^$%^*A^$%^#J^'D^*~^*D^(s^.T^\"x^!\"",
      "encoded_base64": "ICBeJDFeMGBeI2VeJlpeNz9eKlReJ0FeJCVeKkFeJCVeI0peJ0ReKn5eKkReKHNeLlReInheISI=",
      "byte_length": 56
    },
    {
      "unit_id": "DLG_9b4a3b922bae",
      "text": "  我為你做了這麼多事，我要拿到報酬。",
      "encoded_ascii": "  ^$%^%{^*F^*~^*D^(s^.T^\"x^*r^*A^$%^(C^,G^!u^+`^7o^!\"",
      "encoded_base64": "ICBeJCVeJXteKkZeKn5eKkReKHNeLlReInheKnJeKkFeJCVeKENeLEdeIXVeK2BeN29eISI=",
      "byte_length": 53
    },
    {
      "unit_id": "DLG_cbba47b28f1d",
      "text": "  我為什麼要信任你？",
      "encoded_ascii": "  ^$%^%{^!=^.T^(C^!U^!C^*F^.V",
      "encoded_base64": "ICBeJCVeJXteIT1eLlReKENeIVVeIUNeKkZeLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_6411b805b9f8",
      "text": "  你確定嗎？在米奎茲爾已經死了的情況下？",
      "encoded_ascii": "  ^*F^-6^#.^+X^.V^\"d^'4^5B^/D^&/^#J^'D^%L^*D^&Z^,0^,q^!(^.V",
      "encoded_base64": "ICBeKkZeLTZeIy5eK1heLlZeImReJzReNUJeL0ReJi9eI0peJ0ReJUxeKkReJlpeLDBeLHFeISheLlY=",
      "byte_length": 59
    },
    {
      "unit_id": "DLG_23d6a89542ab",
      "text": "  跟我說說頭骨神廟的事。",
      "encoded_ascii": "  ^.+^$%^-x^-x^)t^*$^&w^0[^&Z^*r^!\"",
      "encoded_base64": "ICBeLiteJCVeLXheLXheKXReKiReJndeMFteJlpeKnJeISI=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_c3092a3fc1de",
      "text": "  我要怎麼走出這座惡臭的下水道？",
      "encoded_ascii": "  ^$%^(C^,,^.T^.&^!q^(s^/_^#y^'m^&Z^!(^%V^(y^.V",
      "encoded_base64": "ICBeJCVeKENeLCxeLlReLiZeIXFeKHNeL19eI3leJ21eJlpeISheJVZeKHleLlY=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_80ab80365a36",
      "text": "  我願意幫忙保衛神廟。",
      "encoded_ascii": "  ^$%^.H^#z^+}^,+^!T^(=^&w^0[^!\"",
      "encoded_base64": "ICBeJCVeLkheI3peK31eLCteIVReKD1eJndeMFteISI=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_219668529062",
      "text": "  我受夠了幫你們這群人的忙！",
      "encoded_ascii": "  ^$%^\";^+d^*D^+}^*F^*{^(s^'R^!<^&Z^,+^*W",
      "encoded_base64": "ICBeJCVeIjteK2ReKkReK31eKkZeKnteKHNeJ1JeITxeJlpeLCteKlc=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_e463f85d96ac",
      "text": "你們找到我女兒了嗎？",
      "encoded_ascii": "^*F^*{^$/^!u^$%^#\"^++^*D^+X^.V",
      "encoded_base64": "XipGXip7XiQvXiF1XiQlXiMiXisrXipEXitYXi5W",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_0b04bef532c3",
      "text": "不，看你們的臉色就知道還沒。",
      "encoded_ascii": "^!)^*A^*Q^*F^*{^&Z^-\\^'s^*J^&h^(y^.7^%\\^!\"",
      "encoded_base64": "XiEpXipBXipRXipGXip7XiZaXi1cXidzXipKXiZoXih5Xi43XiVcXiEi",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_40b258bc530c",
      "text": "求求你們，我們沒時間閒聊了。我女兒的安全容不得分心， ",
      "encoded_ascii": "^,n^,n^*F^*{^*A^$%^*{^%\\^$f^)G^6A^-U^*D^!\"^$%^#\"^++^&Z^+p^!h^+t^!)^#e^!s^#k^*A ",
      "encoded_base64": "XixuXixuXipGXip7XipBXiQlXip7XiVcXiRmXilHXjZBXi1VXipEXiEiXiQlXiMiXisrXiZaXitwXiFoXit0XiEpXiNlXiFzXiNrXipBIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_a57deb87d9fe",
      "text": "請務必找到她，把她帶回我身邊，我求求你們了。",
      "encoded_ascii": "^*S^+4^#l^$/^!u^+h^*A^$1^+h^#N^\"\\^$%^(c^.8^*A^$%^,n^,n^*F^*{^*D^!\"",
      "encoded_base64": "XipTXis0XiNsXiQvXiF1XitoXipBXiQxXitoXiNOXiJcXiQlXihjXi44XipBXiQlXixuXixuXipGXip7XipEXiEi",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_64fdad486d07",
      "text": "我美麗的女兒在哪裡？我的探子聽到了狂信徒巢穴那邊傳來打鬥聲。 ",
      "encoded_ascii": "^$%^-P^0z^&Z^#\"^++^\"d^+I^-j^.V^$%^&Z^$>^#(^-X^!u^*D^&8^!U^#d^#G^'&^)!^.8^+$^!O^$-^*,^-W^!\" ",
      "encoded_base64": "XiQlXi1QXjB6XiZaXiMiXisrXiJkXitJXi1qXi5WXiQlXiZaXiQ+XiMoXi1YXiF1XipEXiY4XiFVXiNkXiNHXicmXikhXi44XiskXiFPXiQtXiosXi1XXiEiIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_a9e31e309bb3",
      "text": "她肯定在那裡吧？",
      "encoded_ascii": "^+h^-Z^#.^\"d^)!^-j^*I^.V",
      "encoded_base64": "XitoXi1aXiMuXiJkXikhXi1qXipJXi5W",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_101f480e9997",
      "text": "  我叫你女兒自己找路回來。",
      "encoded_ascii": "  ^$%^+<^*F^#\"^++^'l^#I^$/^(a^\"\\^!O^!\"",
      "encoded_base64": "ICBeJCVeKzxeKkZeIyJeKyteJ2xeI0leJC9eKGFeIlxeIU9eISI=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_3a185a212747",
      "text": "  我很遺憾，你女兒已經死了。",
      "encoded_ascii": "  ^$%^*K^0v^0_^*A^*F^#\"^++^#J^'D^%L^*D^!\"",
      "encoded_base64": "ICBeJCVeKkteMHZeMF9eKkFeKkZeIyJeKyteI0peJ0ReJUxeKkReISI=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_50802fb54d46",
      "text": "  我沒能找到你女兒。",
      "encoded_ascii": "  ^$%^%\\^'b^$/^!u^*F^#\"^++^!\"",
      "encoded_base64": "ICBeJCVeJVxeJ2JeJC9eIXVeKkZeIyJeKyteISI=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_e4f6958d6eb3",
      "text": "我的女兒！願福澤庇佑你們，感謝你們平安將她帶回家！",
      "encoded_ascii": "^$%^&Z^#\"^++^*W^.H^&z^/3^,\"^4.^*F^*{^*A^#{^-z^*F^*{^0Y^+p^#7^+h^#N^\"\\^+s^*W",
      "encoded_base64": "XiQlXiZaXiMiXisrXipXXi5IXiZ6Xi8zXiwiXjQuXipGXip7XipBXiN7Xi16XipGXip7XjBZXitwXiM3XitoXiNOXiJcXitzXipX",
      "byte_length": 75
    },
    {
      "unit_id": "DLG_4c704a7b97a3",
      "text": "向如此偉大的英雄提出更多要求，我感到十分慚愧，但我不得不開口。狂",
      "encoded_ascii": "^+?^#$^%I^*}^\"z^&Z^'y^)\\^$A^!q^$o^\"x^(C^,n^*A^$%^#{^!u^*Y^!s^<S^,3^*A^!I^$%^!)^#e^!)^)F^\"<^!\"^&8",
      "encoded_base64": "Xis/XiMkXiVJXip9XiJ6XiZaXid5XilcXiRBXiFxXiRvXiJ4XihDXixuXipBXiQlXiN7XiF1XipZXiFzXjxTXiwzXipBXiFJXiQlXiEpXiNlXiEpXilGXiI8XiEiXiY4",
      "byte_length": 96
    },
    {
      "unit_id": "DLG_bd457ed3d8af",
      "text": "求求你們，沒時間可以浪費了！要是你們不快點，頭骨長老就要被消滅了！",
      "encoded_ascii": "^,n^,n^*F^*{^*A^%\\^$f^)G^\"A^!B^,r^.\"^*D^*W^(C^,X^*F^*{^!)^*L^*;^*A^)t^*$^)C^'U^*J^(C^(@^%k^%t^*D^*W",
      "encoded_base64": "XixuXixuXipGXip7XipBXiVcXiRmXilHXiJBXiFCXixyXi4iXipEXipXXihDXixYXipGXip7XiEpXipMXio7XipBXil0XiokXilDXidVXipKXihDXihAXiVrXiV0XipEXipX",
      "byte_length": 99
    },
    {
      "unit_id": "DLG_87e5643b15a7",
      "text": "你們拯救了頭骨神廟",
      "encoded_ascii": "^*F^*{^,F^,Q^*D^)t^*$^&w^0[",
      "encoded_base64": "XipGXip7XixGXixRXipEXil0XiokXiZ3XjBb",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_b07256ecc899",
      "text": " ，還救回了我的女兒！我的寶藏以及我能給予的一切，你們當之無愧！",
      "encoded_ascii": " ^*A^.7^,Q^\"\\^*D^$%^&Z^#\"^++^*W^$%^&Z^#4^-f^!B^\"7^$%^'b^'A^!4^&Z^!%^+.^*A^*F^*{^&N^!/^%}^,3^*W",
      "encoded_base64": "IF4qQV4uN14sUV4iXF4qRF4kJV4mWl4jIl4rK14qV14kJV4mWl4jNF4tZl4hQl4iN14kJV4nYl4nQV4hNF4mWl4hJV4rLl4qQV4qRl4qe14mTl4hL14lfV4sM14qVw==",
      "byte_length": 94
    },
    {
      "unit_id": "DLG_d2d3e36a26a0",
      "text": "！你們的大名必將在我族人之中傳為傳奇！",
      "encoded_ascii": "^*W^*F^*{^&Z^\"z^\"F^#l^#7^\"d^$%^5V^!<^!/^!,^+$^%{^+$^\"}^*W",
      "encoded_base64": "XipXXipGXip7XiZaXiJ6XiJGXiNsXiM3XiJkXiQlXjVWXiE8XiEvXiEsXiskXiV7XiskXiJ9XipX",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_852fed6169ad",
      "text": "然而，失去女兒是我難以承受的沉痛代價。我永遠無法釋懷。",
      "encoded_ascii": "^&\"^'W^*A^\"|^\"6^#\"^++^,X^$%^)a^!B^$0^\";^&Z^%Z^-.^*v^+&^!\"^$%^%W^({^%}^%b^0w^,9^!\"",
      "encoded_base64": "XiYiXidXXipBXiJ8XiI2XiMiXisrXixYXiQlXilhXiFCXiQwXiI7XiZaXiVaXi0uXip2XismXiEiXiQlXiVXXih7XiV9XiViXjB3Xiw5XiEi",
      "byte_length": 81
    },
    {
      "unit_id": "DLG_fd7163091654",
      "text": "  我現在能拿報酬了嗎？",
      "encoded_ascii": "  ^$%^&?^\"d^'b^,G^+`^7o^*D^+X^.V",
      "encoded_base64": "ICBeJCVeJj9eImReJ2JeLEdeK2BeN29eKkReK1heLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_fc65cface508",
      "text": "  這頂頭盔到底有什麼名堂？",
      "encoded_ascii": "  ^(s^)p^)t^&]^!u^/^^$s^!=^.T^\"F^42^.V",
      "encoded_base64": "ICBeKHNeKXBeKXReJl1eIXVeL15eJHNeIT1eLlReIkZeNDJeLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_d951d366e11b",
      "text": "  跟我說說沖洗通道的事。",
      "encoded_ascii": "  ^.+^$%^-x^-x^,p^0j^(t^(y^&Z^*r^!\"",
      "encoded_base64": "ICBeLiteJCVeLXheLXheLHBeMGpeKHReKHleJlpeKnJeISI=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_bf5f53912929",
      "text": "噢！這是我承諾給你們的頭盔。請收下吧。",
      "encoded_ascii": "^+]^*W^(s^,X^$%^$0^7k^'A^*F^*{^&Z^)t^&]^!\"^*S^$M^!(^*I^!\"",
      "encoded_base64": "XitdXipXXihzXixYXiQlXiQwXjdrXidBXipGXip7XiZaXil0XiZdXiEiXipTXiRNXiEoXipJXiEi",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_c6cff58f6070",
      "text": "每位隊員獲得 5,000 點經驗值。",
      "encoded_ascii": "^%P^!J^)U^+G^&:^#e 5,000 ^*;^'D^.P^!Z^!\"",
      "encoded_base64": "XiVQXiFKXilVXitHXiY6XiNlIDUsMDAwIF4qO14nRF4uUF4hWl4hIg==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_4e19d265b925",
      "text": "這對鼠人而言是悲痛欲絕的一天。失去了頭骨神廟是毀滅性的打擊",
      "encoded_ascii": "^(s^#:^*=^!<^'W^1Y^,X^,.^-.^4I^-I^&Z^!%^+e^!\"^\"|^\"6^*D^)t^*$^&w^0[^,X^%N^%t^#r^&Z^$-^$F",
      "encoded_base64": "XihzXiM6Xio9XiE8XidXXjFZXixYXiwuXi0uXjRJXi1JXiZaXiElXitlXiEiXiJ8XiI2XipEXil0XiokXiZ3XjBbXixYXiVOXiV0XiNyXiZaXiQtXiRG",
      "byte_length": 87
    },
    {
      "unit_id": "DLG_f3c6e7ef0c57",
      "text": "。不過，你們救了我女兒，為此我心存感激。 ",
      "encoded_ascii": "^!\"^!)^(x^*A^*F^*{^,Q^*D^$%^#\"^++^*A^%{^%I^$%^#k^#*^#{^1H^!\" ",
      "encoded_base64": "XiEiXiEpXih4XipBXipGXip7XixRXipEXiQlXiMiXisrXipBXiV7XiVJXiQlXiNrXiMqXiN7XjFIXiEiIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_f60b3851c277",
      "text": "我會履行諾言，將頭盔賜予你們。",
      "encoded_ascii": "^$%^$r^5L^(;^7k^1Y^*A^#7^)t^&]^.#^!4^*F^*{^!\"",
      "encoded_base64": "XiQlXiRyXjVMXig7XjdrXjFZXipBXiM3Xil0XiZdXi4jXiE0XipGXip7XiEi",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_c6c84913e658",
      "text": "，而我甚至還失去了女兒！不，我們活著已經毫無意義了……",
      "encoded_ascii": "^*A^'W^$%^/|^'n^.7^\"|^\"6^*D^#\"^++^*W^!)^*A^$%^*{^%i^-a^#J^'D^/t^%}^#z^2<^*D^*o^*o",
      "encoded_base64": "XipBXidXXiQlXi98XiduXi43XiJ8XiI2XipEXiMiXisrXipXXiEpXipBXiQlXip7XiVpXi1hXiNKXidEXi90XiV9XiN6XjI8XipEXipvXipv",
      "byte_length": 81
    },
    {
      "unit_id": "DLG_b9a8635aabd3",
      "text": "如果可以的話我早就給你們了，請相信我，但在頭骨神廟受到威脅時，我必須留著這頂 ",
      "encoded_ascii": "^#$^%!^\"A^!B^&Z^-v^$%^,V^*J^'A^*F^*{^*D^*A^*S^&a^!U^$%^*A^!I^\"d^)t^*$^&w^0[^\";^!u^#&^1T^$f^*A^$%^#l^)r^-+^-a^(s^)p ",
      "encoded_base64": "XiMkXiUhXiJBXiFCXiZaXi12XiQlXixWXipKXidBXipGXip7XipEXipBXipTXiZhXiFVXiQlXipBXiFJXiJkXil0XiokXiZ3XjBbXiI7XiF1XiMmXjFUXiRmXipBXiQlXiNsXilyXi0rXi1hXihzXilwIA==",
      "byte_length": 115
    },
    {
      "unit_id": "DLG_4e5028d52147",
      "text": "沉思頭盔。",
      "encoded_ascii": "^%Z^#q^)t^&]^!\"",
      "encoded_base64": "XiVaXiNxXil0XiZdXiEi",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_63fda3b40b30",
      "text": "難道你們還沒向頭骨長老請教過嗎？只有他們才能告訴你們逃離下水道的 ",
      "encoded_ascii": "^)a^(y^*F^*{^.7^%\\^+?^)t^*$^)C^'U^*S^,R^(x^+X^.V^\"?^$s^!@^*{^$,^'b^+B^-t^*F^*{^(p^)`^!(^%V^(y^&Z ",
      "encoded_base64": "XilhXih5XipGXip7Xi43XiVcXis/Xil0XiokXilDXidVXipTXixSXih4XitYXi5WXiI/XiRzXiFAXip7XiQsXidiXitCXi10XipGXip7XihwXilgXiEoXiVWXih5XiZaIA==",
      "byte_length": 97
    },
    {
      "unit_id": "DLG_49834e25af68",
      "text": "途徑。",
      "encoded_ascii": "^3.^#c^!\"",
      "encoded_base64": "XjMuXiNjXiEi",
      "byte_length": 9
    },
    {
      "unit_id": "DLG_23457674fe06",
      "text": "我萬分樂意將寶藏奉獻給你們！我女兒的性命遠比這些身外之物寶貴得多。",
      "encoded_ascii": "^$%^-_^!s^%8^#z^#7^#4^-f^1+^-(^'A^*F^*{^*W^$%^#\"^++^&Z^#r^\"N^({^,m^(s^!8^(c^\"w^!/^&4^#4^2F^#e^\"x^!\"",
      "encoded_base64": "XiQlXi1fXiFzXiU4XiN6XiM3XiM0Xi1mXjErXi0oXidBXipGXip7XipXXiQlXiMiXisrXiZaXiNyXiJOXih7XixtXihzXiE4XihjXiJ3XiEvXiY0XiM0XjJGXiNlXiJ4XiEi",
      "byte_length": 99
    },
    {
      "unit_id": "DLG_4e612a111531",
      "text": "希望這頂頭盔能像你們保護我女兒那樣，庇佑你們平安。",
      "encoded_ascii": "^+{^,]^(s^)p^)t^&]^'b^!`^*F^*{^!T^(T^$%^#\"^++^)!^,f^*A^,\"^4.^*F^*{^0Y^+p^!\"",
      "encoded_base64": "Xit7XixdXihzXilwXil0XiZdXidiXiFgXipGXip7XiFUXihUXiQlXiMiXisrXikhXixmXipBXiwiXjQuXipGXip7XjBZXitwXiEi",
      "byte_length": 75
    },
    {
      "unit_id": "DLG_697576dee872",
      "text": "這是一頂沉思頭盔，是我在某個下水道排水孔裡發現的。 ",
      "encoded_ascii": "^(s^,X^!%^)p^%Z^#q^)t^&]^*A^,X^$%^\"d^%$^!V^!(^%V^(y^$<^%V^5G^-j^&W^&?^&Z^!\" ",
      "encoded_base64": "XihzXixYXiElXilwXiVaXiNxXil0XiZdXipBXixYXiQlXiJkXiUkXiFWXiEoXiVWXih5XiQ8XiVWXjVHXi1qXiZXXiY/XiZaXiEiIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_39b5b67723d8",
      "text": "有時在底下能找到令人驚奇的寶物。要是你們膽識過人， ",
      "encoded_ascii": "^$s^$f^\"d^/^^!(^'b^$/^!u^*w^!<^.Q^\"}^&Z^#4^&4^!\"^(C^,X^*F^*{^-[^(R^(x^!<^*A ",
      "encoded_base64": "XiRzXiRmXiJkXi9eXiEoXidiXiQvXiF1Xip3XiE8Xi5RXiJ9XiZaXiM0XiY0XiEiXihDXixYXipGXip7Xi1bXihSXih4XiE8XipBIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_9b1ee7840555",
      "text": "沖洗通道絕對是尋寶的最佳去處。",
      "encoded_ascii": "^,p^0j^(t^(y^-I^#:^,X^#9^#4^&Z^$q^7P^\"6^(,^!\"",
      "encoded_base64": "XixwXjBqXih0Xih5Xi1JXiM6XixYXiM5XiM0XiZaXiRxXjdQXiI2XigsXiEi",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_c17e6ee87531",
      "text": "沖洗通道位於下水道北端，那裡到處都是 ",
      "encoded_ascii": "^,p^0j^(t^(y^!J^$^^!(^%V^(y^+6^5o^*A^)!^-j^!u^(,^)$^,X ",
      "encoded_base64": "XixwXjBqXih0Xih5XiFKXiReXiEoXiVWXih5Xis2XjVvXipBXikhXi1qXiF1XigsXikkXixYIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_38ce36244a0d",
      "text": "提爾軟泥怪。這就是為什麼我們極少踏足那裡。",
      "encoded_ascii": "^$A^&/^.x^%d^#s^!\"^(s^*J^,X^%{^!=^.T^$%^*{^1D^#<^.,^(^^)!^-j^!\"",
      "encoded_base64": "XiRBXiYvXi54XiVkXiNzXiEiXihzXipKXixYXiV7XiE9Xi5UXiQlXip7XjFEXiM8Xi4sXiheXikhXi1qXiEi",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_5214e59afa2a",
      "text": "他們全是一群狂信徒！哨兵看到他們正朝著東邊的神廟進發。 ",
      "encoded_ascii": "^!@^*{^!h^,X^!%^'R^&8^!U^#d^*W^:Q^+,^*Q^!u^!@^*{^%H^,^^-a^,`^.8^&Z^&w^0[^(w^&W^!\" ",
      "encoded_base64": "XiFAXip7XiFoXixYXiElXidSXiY4XiFVXiNkXipXXjpRXissXipRXiF1XiFAXip7XiVIXixeXi1hXixgXi44XiZaXiZ3XjBbXih3XiZXXiEiIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_6e6eaa8bb211",
      "text": "請務必在他們消滅長老之前阻止他們！",
      "encoded_ascii": "^*S^+4^#l^\"d^!@^*{^%k^%t^)C^'U^!/^!z^)L^%G^!@^*{^*W",
      "encoded_base64": "XipTXis0XiNsXiJkXiFAXip7XiVrXiV0XilDXidVXiEvXiF6XilMXiVHXiFAXip7XipX",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_f6c37e4db7c0",
      "text": "我不怪你們對我不信任，但我求求你們。拯救我們神聖的神廟，你們就能得到我的 ",
      "encoded_ascii": "^$%^!)^#s^*F^*{^#:^$%^!)^!U^!C^*A^!I^$%^,n^,n^*F^*{^!\"^,F^,Q^$%^*{^&w^'Z^&Z^&w^0[^*A^*F^*{^*J^'b^#e^!u^$%^&Z ",
      "encoded_base64": "XiQlXiEpXiNzXipGXip7XiM6XiQlXiEpXiFVXiFDXipBXiFJXiQlXixuXixuXipGXip7XiEiXixGXixRXiQlXip7XiZ3XidaXiZaXiZ3XjBbXipBXipGXip7XipKXidiXiNlXiF1XiQlXiZaIA==",
      "byte_length": 109
    },
    {
      "unit_id": "DLG_c76ae5a6d7df",
      "text": "寶藏。再者，要是神廟陷落，長老們就無法指引你們逃離下水道了。",
      "encoded_ascii": "^#4^-f^!\"^!l^'V^*A^(C^,X^&w^0[^)S^-`^*A^)C^'U^*{^*J^%}^%b^$8^#Z^*F^*{^(p^)`^!(^%V^(y^*D^!\"",
      "encoded_base64": "XiM0Xi1mXiEiXiFsXidWXipBXihDXixYXiZ3XjBbXilTXi1gXipBXilDXidVXip7XipKXiV9XiViXiQ4XiNaXipGXip7XihwXilgXiEoXiVWXih5XipEXiEi",
      "byte_length": 90
    },
    {
      "unit_id": "DLG_4391086d2d0f",
      "text": "噢，太感謝你們了！你們的大慈大悲恩同再造。",
      "encoded_ascii": "^+]^*A^+f^#{^-z^*F^*{^*D^*W^*F^*{^&Z^\"z^3H^\"z^,.^#v^\"E^!l^(v^!\"",
      "encoded_base64": "XitdXipBXitmXiN7Xi16XipGXip7XipEXipXXipGXip7XiZaXiJ6XjNIXiJ6XiwuXiN2XiJFXiFsXih2XiEi",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_59ccabe5db67",
      "text": "神廟就在我居所的正北方。 ",
      "encoded_ascii": "^&w^0[^*J^\"d^$%^+w^$)^&Z^%H^+6^$]^!\" ",
      "encoded_base64": "XiZ3XjBbXipKXiJkXiQlXit3XiQpXiZaXiVIXis2XiRdXiEiIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_634d1286dd78",
      "text": "我的衛兵會替你們帶路。",
      "encoded_ascii": "^$%^&Z^(=^+,^$r^2o^*F^*{^#N^(a^!\"",
      "encoded_base64": "XiQlXiZaXig9XissXiRyXjJvXipGXip7XiNOXihhXiEi",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_d88789a6307a",
      "text": "你們難道毫無憐憫之心嗎？ ",
      "encoded_ascii": "^*F^*{^)a^(y^/t^%}^1}^1~^!/^#k^+X^.V ",
      "encoded_base64": "XipGXip7XilhXih5Xi90XiV9XjF9XjF+XiEvXiNrXitYXi5WIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_c73234e3317c",
      "text": "我已經拿不出更多東西了！ ",
      "encoded_ascii": "^$%^#J^'D^,G^!)^!q^$o^\"x^,`^-l^*D^*W ",
      "encoded_base64": "XiQlXiNKXidEXixHXiEpXiFxXiRvXiJ4XixgXi1sXipEXipXIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_f7f80eea3a39",
      "text": "要是頭骨神廟淪陷，我們的生命便毫無價值。神廟裡的頭骨 ",
      "encoded_ascii": "^(C^,X^)t^*$^&w^0[^2)^)S^*A^$%^*{^&Z^&F^\"N^!R^/t^%}^+&^!Z^!\"^&w^0[^-j^&Z^)t^*$ ",
      "encoded_base64": "XihDXixYXil0XiokXiZ3XjBbXjIpXilTXipBXiQlXip7XiZaXiZGXiJOXiFSXi90XiV9XismXiFaXiEiXiZ3XjBbXi1qXiZaXil0XiokIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_805a50736e00",
      "text": "太過珍貴了！求求你們，能施以援手嗎？",
      "encoded_ascii": "^+f^(x^/7^2F^*D^*W^,n^,n^*F^*{^*A^'b^$_^!B^$C^$+^+X^.V",
      "encoded_base64": "XitmXih4Xi83XjJGXipEXipXXixuXixuXipGXip7XipBXidiXiRfXiFCXiRDXiQrXitYXi5W",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_2f7ed4972bed",
      "text": "你們是我們唯一的希望！我們全完了！",
      "encoded_ascii": "^*F^*{^,X^$%^*{^+O^!%^&Z^+{^,]^*W^$%^*{^!h^#,^*D^*W",
      "encoded_base64": "XipGXip7XixYXiQlXip7XitPXiElXiZaXit7XixdXipXXiQlXip7XiFoXiMsXipEXipX",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_302b548dc61e",
      "text": "你想知道些什麼？",
      "encoded_ascii": "^*F^,1^&h^(y^!8^!=^.T^.V",
      "encoded_base64": "XipGXiwxXiZoXih5XiE4XiE9Xi5UXi5W",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_aeb7dcdb082a",
      "text": "  我想和你談談綁架的事。",
      "encoded_ascii": "  ^$%^,1^\"O^*F^0;^0;^-K^%\"^&Z^*r^!\"",
      "encoded_base64": "ICBeJCVeLDFeIk9eKkZeMDteMDteLUteJSJeJlpeKnJeISI=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_2b1936db9539",
      "text": "  長老們是從何而來的？",
      "encoded_ascii": "  ^)C^'U^*{^,X^#f^!L^'W^!O^&Z^.V",
      "encoded_base64": "ICBeKUNeJ1VeKnteLFheI2ZeIUxeJ1deIU9eJlpeLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_0c0b446fa01e",
      "text": "我需要勇士去救回我被綁架的女兒。我不敢想像自從她被擄走以來， ",
      "encoded_ascii": "^$%^)e^(C^\"$^+a^\"6^,Q^\"\\^$%^(@^-K^%\"^&Z^#\"^++^!\"^$%^!)^/m^,1^!`^'l^#f^+h^(@^92^.&^!B^!O^*A ",
      "encoded_base64": "XiQlXillXihDXiIkXithXiI2XixRXiJcXiQlXihAXi1LXiUiXiZaXiMiXisrXiEiXiQlXiEpXi9tXiwxXiFgXidsXiNmXitoXihAXjkyXi4mXiFCXiFPXipBIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_6cfabb934b35",
      "text": "這幾天他們對她做出了什麼暴行。",
      "encoded_ascii": "^(s^#T^+e^!@^*{^#:^+h^*~^!q^*D^!=^.T^$m^(;^!\"",
      "encoded_base64": "XihzXiNUXitlXiFAXip7XiM6XitoXip+XiFxXipEXiE9Xi5UXiRtXig7XiEi",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_2186f33bdd45",
      "text": "只要能再次見到女兒，我願獻上我最珍貴的寶藏。此外，我還會准許你們進入 ",
      "encoded_ascii": "^\"?^(C^'b^!l^%D^-m^!u^#\"^++^*A^$%^.H^-(^!'^$%^$q^/7^2F^&Z^#4^-f^!\"^%I^\"w^*A^$%^.7^$r^/Q^-s^*F^*{^(w^!f ",
      "encoded_base64": "XiI/XihDXidiXiFsXiVEXi1tXiF1XiMiXisrXipBXiQlXi5IXi0oXiEnXiQlXiRxXi83XjJGXiZaXiM0Xi1mXiEiXiVJXiJ3XipBXiQlXi43XiRyXi9RXi1zXipGXip7Xih3XiFmIA==",
      "byte_length": 103
    },
    {
      "unit_id": "DLG_a56b48801aa6",
      "text": "頭骨神廟。長老們將指引你們逃離這座下水道。 ",
      "encoded_ascii": "^)t^*$^&w^0[^!\"^)C^'U^*{^#7^$8^#Z^*F^*{^(p^)`^(s^/_^!(^%V^(y^!\" ",
      "encoded_base64": "Xil0XiokXiZ3XjBbXiEiXilDXidVXip7XiM3XiQ4XiNaXipGXip7XihwXilgXihzXi9fXiEoXiVWXih5XiEiIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_bc814b97cc9a",
      "text": "每位隊員獲得 500 點經驗值。",
      "encoded_ascii": "^%P^!J^)U^+G^&:^#e 500 ^*;^'D^.P^!Z^!\"",
      "encoded_base64": "XiVQXiFKXilVXitHXiY6XiNlIDUwMCBeKjteJ0ReLlBeIVpeISI=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_ec79ec6817f1",
      "text": "噢，這真是讓我如釋重負！ ",
      "encoded_ascii": "^+]^*A^(s^-2^,X^-}^$%^#$^0w^))^(W^*W ",
      "encoded_base64": "XitdXipBXihzXi0yXixYXi19XiQlXiMkXjB3XikpXihXXipXIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_e30d11eb8a3c",
      "text": "狂信徒巢穴位於西南方",
      "encoded_ascii": "^&8^!U^#d^#G^'&^!J^$^^-l^\"/^$]",
      "encoded_base64": "XiY4XiFVXiNkXiNHXicmXiFKXiReXi1sXiIvXiRd",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_e240786359ce",
      "text": "低層巢穴位於東南方",
      "encoded_ascii": "^!K^#B^#G^'&^!J^$^^,`^\"/^$]",
      "encoded_base64": "XiFLXiNCXiNHXicmXiFKXiReXixgXiIvXiRd",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_c904f761dc6f",
      "text": "。我為你們的平安祈禱，但請務必抓緊時間。",
      "encoded_ascii": "^!\"^$%^%{^*F^*{^&Z^0Y^+p^&u^&|^*A^!I^*S^+4^#l^$2^0r^$f^)G^!\"",
      "encoded_base64": "XiEiXiQlXiV7XipGXip7XiZaXjBZXitwXiZ1XiZ8XipBXiFJXipTXis0XiNsXiQyXjByXiRmXilHXiEi",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_13913db7a024",
      "text": "我唯一知道的出口直通回奴隸欄，但這座下水道肯定還有其他通往外界的出路。",
      "encoded_ascii": "^$%^+O^!%^&h^(y^&Z^!q^\"<^&`^(t^\"\\^##^)Z^%C^*A^!I^(s^/_^!(^%V^(y^-Z^#.^.7^$s^!j^!@^(t^,)^\"w^.p^&Z^!q^(a^!\"",
      "encoded_base64": "XiQlXitPXiElXiZoXih5XiZaXiFxXiI8XiZgXih0XiJcXiMjXilaXiVDXipBXiFJXihzXi9fXiEoXiVWXih5Xi1aXiMuXi43XiRzXiFqXiFAXih0XiwpXiJ3Xi5wXiZaXiFxXihhXiEi",
      "byte_length": 105
    },
    {
      "unit_id": "DLG_21de22ee53bf",
      "text": " 懇請你們接受這項使命好嗎？",
      "encoded_ascii": " ^3t^*S^*F^*{^$?^\";^(s^)q^!N^\"N^+i^+X^.V",
      "encoded_base64": "IF4zdF4qU14qRl4qe14kP14iO14oc14pcV4hTl4iTl4raV4rWF4uVg==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_1a978f02e092",
      "text": "請再考慮一下吧！你們是唯一能救她性命的人！但為了表明我對你們的誠意，我准許你們在 ",
      "encoded_ascii": "^*S^!l^-R^19^!%^!(^*I^*W^*F^*{^,X^+O^!%^'b^,Q^+h^#r^\"N^&Z^!<^*W^!I^%{^*D^-i^$c^$%^#:^*F^*{^&Z^2E^#z^*A^$%^/Q^-s^*F^*{^\"d ",
      "encoded_base64": "XipTXiFsXi1SXjE5XiElXiEoXipJXipXXipGXip7XixYXitPXiElXidiXixRXitoXiNyXiJOXiZaXiE8XipXXiFJXiV7XipEXi1pXiRjXiQlXiM6XipGXip7XiZaXjJFXiN6XipBXiQlXi9RXi1zXipGXip7XiJkIA==",
      "byte_length": 121
    },
    {
      "unit_id": "DLG_f707b72e1292",
      "text": "高層巢穴中自由通行，除了頭骨神廟之外。",
      "encoded_ascii": "^*+^#B^#G^'&^!,^'l^&I^(t^(;^*A^)Q^*D^)t^*$^&w^0[^!/^\"w^!\"",
      "encoded_base64": "XiorXiNCXiNHXicmXiEsXidsXiZJXih0Xig7XipBXilRXipEXil0XiokXiZ3XjBbXiEvXiJ3XiEi",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_c1b8f06e77d7",
      "text": "我女兒死了！你們怎麼能讓她死去？她",
      "encoded_ascii": "^$%^#\"^++^%L^*D^*W^*F^*{^,,^.T^'b^-}^+h^%L^\"6^.V^+h",
      "encoded_base64": "XiQlXiMiXisrXiVMXipEXipXXipGXip7XiwsXi5UXidiXi19XitoXiVMXiI2Xi5WXito",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_62fc87bcfae8",
      "text": "你們怎麼能讓這麼嬌弱的一朵鮮花獨自一人在下水道遊蕩？！",
      "encoded_ascii": "^*F^*{^,,^.T^'b^-}^(s^.T^=n^#\\^&Z^!%^9C^35^'w^/z^'l^!%^!<^\"d^!(^%V^(y^.3^1X^.V^*W",
      "encoded_base64": "XipGXip7XiwsXi5UXidiXi19XihzXi5UXj1uXiNcXiZaXiElXjlDXjM1Xid3Xi96XidsXiElXiE8XiJkXiEoXiVWXih5Xi4zXjFYXi5WXipX",
      "byte_length": 81
    },
    {
      "unit_id": "DLG_2a593f6d0276",
      "text": "她已經失蹤太久了。",
      "encoded_ascii": "^+h^#J^'D^\"|^(b^+f^!.^*D^!\"",
      "encoded_base64": "XitoXiNKXidEXiJ8XihiXitmXiEuXipEXiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_fdfccbeff5fa",
      "text": " 我必須面對她已經死去的現實，但她",
      "encoded_ascii": " ^$%^#l^)r^)j^#:^+h^#J^'D^%L^\"6^&Z^&?^#3^*A^!I^+h",
      "encoded_base64": "IF4kJV4jbF4pcl4pal4jOl4raF4jSl4nRF4lTF4iNl4mWl4mP14jM14qQV4hSV4raA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_07c7f08ba6d9",
      "text": "唯有長老們知曉離開的方法。保衛頭骨神廟，他們便會傾囊相告。",
      "encoded_ascii": "^+O^$s^)C^'U^*{^&h^7y^)`^)F^&Z^$]^%b^!\"^!T^(=^)t^*$^&w^0[^*A^!@^*{^!R^$r^2U^5=^&a^+B^!\"",
      "encoded_base64": "XitPXiRzXilDXidVXip7XiZoXjd5XilgXilGXiZaXiRdXiViXiEiXiFUXig9Xil0XiokXiZ3XjBbXipBXiFAXip7XiFSXiRyXjJVXjU9XiZhXitCXiEi",
      "byte_length": 87
    },
    {
      "unit_id": "DLG_ac94286d4d51",
      "text": "信徒們正在進攻我們神聖的頭骨神廟！",
      "encoded_ascii": "^!U^#d^*{^%H^\"d^(w^$O^$%^*{^&w^'Z^&Z^)t^*$^&w^0[^*W",
      "encoded_base64": "XiFVXiNkXip7XiVIXiJkXih3XiRPXiQlXip7XiZ3XidaXiZaXil0XiokXiZ3XjBbXipX",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_129b0a72e451",
      "text": "你想打聽關於它的什麼事？",
      "encoded_ascii": "^*F^,1^$-^-X^.>^$^^+o^&Z^!=^.T^*r^.V",
      "encoded_base64": "XipGXiwxXiQtXi1YXi4+XiReXitvXiZaXiE9Xi5UXipyXi5W",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_f8c02f274a58",
      "text": "頭骨神廟為全體鼠人指引方向。要是沒有長老們的睿智， ",
      "encoded_ascii": "^)t^*$^&w^0[^%{^!h^**^*=^!<^$8^#Z^$]^+?^!\"^(C^,X^%\\^$s^)C^'U^*{^&Z^/=^$i^*A ",
      "encoded_base64": "Xil0XiokXiZ3XjBbXiV7XiFoXioqXio9XiE8XiQ4XiNaXiRdXis/XiEiXihDXixYXiVcXiRzXilDXidVXip7XiZaXi89XiRpXipBIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_c84bd0916290",
      "text": "我們鼠人將迷失方向。長老至高神聖，無論付出何種代價都必須誓死保護。",
      "encoded_ascii": "^$%^*{^*=^!<^#7^(n^\"|^$]^+?^!\"^)C^'U^'n^*+^&w^'Z^*A^%}^1\\^*u^!q^!L^'$^*v^+&^)$^#l^)r^-w^%L^!T^(T^!\"",
      "encoded_base64": "XiQlXip7Xio9XiE8XiM3XihuXiJ8XiRdXis/XiEiXilDXidVXiduXiorXiZ3XidaXipBXiV9XjFcXip1XiFxXiFMXickXip2XismXikkXiNsXilyXi13XiVMXiFUXihUXiEi",
      "byte_length": 99
    },
    {
      "unit_id": "DLG_622273daa8d8",
      "text": "長老是我們的先祖，他們身上保存了所有曾活過的鼠人之智慧。 ",
      "encoded_ascii": "^)C^'U^,X^$%^*{^&Z^!b^/>^*A^!@^*{^(c^!'^!T^#*^*D^$)^$s^.j^%i^(x^&Z^*=^!<^!/^$i^4;^!\" ",
      "encoded_base64": "XilDXidVXixYXiQlXip7XiZaXiFiXi8+XipBXiFAXip7XihjXiEnXiFUXiMqXipEXiQpXiRzXi5qXiVpXih4XiZaXio9XiE8XiEvXiRpXjQ7XiEiIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_a9b5e881ce0f",
      "text": "在我們崇敬長老之前，鼠人只能愚昧墮落地在下水道四處亂竄苟活。",
      "encoded_ascii": "^\"d^$%^*{^13^*O^)C^'U^!/^!z^*A^*=^!<^\"?^'b^/a^4D^=m^-`^\"e^\"d^!(^%V^(y^\"[^(,^!3^7c^-^^%i^!\"",
      "encoded_base64": "XiJkXiQlXip7XjEzXipPXilDXidVXiEvXiF6XipBXio9XiE8XiI/XidiXi9hXjREXj1tXi1gXiJlXiJkXiEoXiVWXih5XiJbXigsXiEzXjdjXi1eXiVpXiEi",
      "byte_length": 90
    },
    {
      "unit_id": "DLG_68dde1747560",
      "text": "那是只有長老才能解答的神聖奧秘。每當長老顯靈傳承的時刻來臨， ",
      "encoded_ascii": "^)!^,X^\"?^$s^)C^'U^$,^'b^(I^-B^&Z^&w^'Z^6Q^1O^!\"^%P^&N^)C^'U^4&^)g^+$^$0^&Z^$f^.Y^!O^1U^*A ",
      "encoded_base64": "XikhXixYXiI/XiRzXilDXidVXiQsXidiXihJXi1CXiZaXiZ3XidaXjZRXjFPXiEiXiVQXiZOXilDXidVXjQmXilnXiskXiQwXiZaXiRmXi5ZXiFPXjFVXipBIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_6406cc9bf468",
      "text": "其中一位頭骨守護者便會帶著一把魔法法杖前往沖洗通道， ",
      "encoded_ascii": "^!j^!,^!%^!J^)t^*$^#+^(T^'V^!R^$r^#N^-a^!%^$1^*0^%b^%b^${^!z^,)^,p^0j^(t^(y^*A ",
      "encoded_base64": "XiFqXiEsXiElXiFKXil0XiokXiMrXihUXidWXiFSXiRyXiNOXi1hXiElXiQxXiowXiViXiViXiR7XiF6XiwpXixwXjBqXih0Xih5XipBIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_4bba78163548",
      "text": "然後帶著一位長老歸來。我所知道的就只有這些了。",
      "encoded_ascii": "^&\"^#b^#N^-a^!%^!J^)C^'U^%K^!O^!\"^$%^$)^&h^(y^&Z^*J^\"?^$s^(s^!8^*D^!\"",
      "encoded_base64": "XiYiXiNiXiNOXi1hXiElXiFKXilDXidVXiVLXiFPXiEiXiQlXiQpXiZoXih5XiZaXipKXiI/XiRzXihzXiE4XipEXiEi",
      "byte_length": 69
    },
    {
      "unit_id": "DLG_ab7f7cb0ca95",
      "text": "  你知道是誰抓走了你女兒嗎？",
      "encoded_ascii": "  ^*F^&h^(y^,X^-y^$2^.&^*D^*F^#\"^++^+X^.V",
      "encoded_base64": "ICBeKkZeJmheKHleLFheLXleJDJeLiZeKkReKkZeIyJeKyteK1heLlY=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_1df73bdb5ee9",
      "text": "  丘爾那裡並沒有你女兒。",
      "encoded_ascii": "  ^5(^&/^)!^-j^!+^%\\^$s^*F^#\"^++^!\"",
      "encoded_base64": "ICBeNSheJi9eKSFeLWpeISteJVxeJHNeKkZeIyJeKyteISI=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_a865c87c4dfe",
      "text": "  我要在哪裡能找到丘爾？",
      "encoded_ascii": "  ^$%^(C^\"d^+I^-j^'b^$/^!u^5(^&/^.V",
      "encoded_base64": "ICBeJCVeKENeImReK0leLWpeJ2JeJC9eIXVeNSheJi9eLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_ea9d2683e986",
      "text": "  他們是怎麼綁走你女兒的？",
      "encoded_ascii": "  ^!@^*{^,X^,,^.T^-K^.&^*F^#\"^++^&Z^.V",
      "encoded_base64": "ICBeIUBeKnteLFheLCxeLlReLUteLiZeKkZeIyJeKyteJlpeLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_1d3516b55840",
      "text": "  關於這群狂信徒，你都知道些什麼？",
      "encoded_ascii": "  ^.>^$^^(s^'R^&8^!U^#d^*A^*F^)$^&h^(y^!8^!=^.T^.V",
      "encoded_base64": "ICBeLj5eJF5eKHNeJ1JeJjheIVVeI2ReKkFeKkZeKSReJmheKHleITheIT1eLlReLlY=",
      "byte_length": 50
    },
    {
      "unit_id": "DLG_a81d4676ab36",
      "text": "  為什麼你女兒會被綁架？",
      "encoded_ascii": "  ^%{^!=^.T^*F^#\"^++^$r^(@^-K^%\"^.V",
      "encoded_base64": "ICBeJXteIT1eLlReKkZeIyJeKyteJHJeKEBeLUteJSJeLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_7156f3e6eb41",
      "text": "是那麼年輕、那麼天真無邪……噢，這太可怕了！就在我們說話的同時，狂",
      "encoded_ascii": "^,X^)!^.T^+~^(g^!!^)!^.T^+e^-2^%}^)\"^*o^*o^+]^*A^(s^+f^\"A^0^^*D^*W^*J^\"d^$%^*{^-x^-v^&Z^\"E^$f^*A^&8",
      "encoded_base64": "XixYXikhXi5UXit+XihnXiEhXikhXi5UXitlXi0yXiV9XikiXipvXipvXitdXipBXihzXitmXiJBXjBeXipEXipXXipKXiJkXiQlXip7Xi14Xi12XiZaXiJFXiRmXipBXiY4",
      "byte_length": 99
    },
    {
      "unit_id": "DLG_79d81e82a5ad",
      "text": "那麼",
      "encoded_ascii": "^)!^.T",
      "encoded_base64": "XikhXi5U",
      "byte_length": 6
    },
    {
      "unit_id": "DLG_ef647bb73612",
      "text": "丘爾的暴徒綁架了我無辜的女兒，但如果你們沒在低層巢穴看到她，",
      "encoded_ascii": "^5(^&/^&Z^$m^#d^-K^%\"^*D^$%^%}^66^&Z^#\"^++^*A^!I^#$^%!^*F^*{^%\\^\"d^!K^#B^#G^'&^*Q^!u^+h^*A",
      "encoded_base64": "XjUoXiYvXiZaXiRtXiNkXi1LXiUiXipEXiQlXiV9XjY2XiZaXiMiXisrXipBXiFJXiMkXiUhXipGXip7XiVcXiJkXiFLXiNCXiNHXicmXipRXiF1XitoXipB",
      "byte_length": 90
    },
    {
      "unit_id": "DLG_36d25e9724eb",
      "text": " 那她肯定落到了米奎茲爾的手裡……噢，情況比我想像的還要糟糕！",
      "encoded_ascii": " ^)!^+h^-Z^#.^-`^!u^*D^'4^5B^/D^&/^&Z^$+^-j^*o^*o^+]^*A^,0^,q^,m^$%^,1^!`^&Z^.7^(C^-E^4\\^*W",
      "encoded_base64": "IF4pIV4raF4tWl4jLl4tYF4hdV4qRF4nNF41Ql4vRF4mL14mWl4kK14tal4qb14qb14rXV4qQV4sMF4scV4sbV4kJV4sMV4hYF4mWl4uN14oQ14tRV40XF4qVw==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_fbfbfce8e8f0",
      "text": "是低層巢穴的巢穴主管丘爾幹的。",
      "encoded_ascii": "^,X^!K^#B^#G^'&^&Z^#G^'&^!-^-D^5(^&/^,!^&Z^!\"",
      "encoded_base64": "XixYXiFLXiNCXiNHXicmXiZaXiNHXicmXiEtXi1EXjUoXiYvXiwhXiZaXiEi",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_b8fea2874b46",
      "text": "低層巢穴就在這裡的東南方，但我從沒去過他的巢穴。丘爾與城衛軍走得太近， ",
      "encoded_ascii": "^!K^#B^#G^'&^*J^\"d^(s^-j^&Z^,`^\"/^$]^*A^!I^$%^#f^%\\^\"6^(x^!@^&Z^#G^'&^!\"^5(^&/^'p^+_^(=^..^.&^#e^+f^(l^*A ",
      "encoded_base64": "XiFLXiNCXiNHXicmXipKXiJkXihzXi1qXiZaXixgXiIvXiRdXipBXiFJXiQlXiNmXiVcXiI2Xih4XiFAXiZaXiNHXicmXiEiXjUoXiYvXidwXitfXig9Xi4uXi4mXiNlXitmXihsXipBIA==",
      "byte_length": 106
    },
    {
      "unit_id": "DLG_8f7dc67e1269",
      "text": "導致我們根本不敢輕易涉足那一帶。",
      "encoded_ascii": "^10^'o^$%^*{^%)^$x^!)^/m^(g^,W^3O^(^^)!^!%^#N^!\"",
      "encoded_base64": "XjEwXidvXiQlXip7XiUpXiR4XiEpXi9tXihnXixXXjNPXiheXikhXiElXiNOXiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_3e980ba92e2c",
      "text": "幾個月前米奎茲爾潛入了下水道，開始招募鼠人去崇拜特克圖克特雷。 ",
      "encoded_ascii": "^#T^!V^/p^!z^'4^5B^/D^&/^7:^!f^*D^!(^%V^(y^*A^)F^+k^,D^9S^*=^!<^\"6^13^,E^&5^!d^\"b^!d^&5^)c^!\" ",
      "encoded_base64": "XiNUXiFWXi9wXiF6Xic0XjVCXi9EXiYvXjc6XiFmXipEXiEoXiVWXih5XipBXilGXitrXixEXjlTXio9XiE8XiI2XjEzXixFXiY1XiFkXiJiXiFkXiY1XiljXiEiIA==",
      "byte_length": 94
    },
    {
      "unit_id": "DLG_0d1d41241c14",
      "text": "那些狂信徒行事狂熱瘋癲，只要可能，我們都會盡量避開他們。",
      "encoded_ascii": "^)!^!8^&8^!U^#d^(;^*r^&8^&$^-/^4Y^*A^\"?^(C^\"A^'b^*A^$%^*{^)$^$r^-1^)*^0F^)F^!@^*{^!\"",
      "encoded_base64": "XikhXiE4XiY4XiFVXiNkXig7XipyXiY4XiYkXi0vXjRZXipBXiI/XihDXiJBXidiXipBXiQlXip7XikkXiRyXi0xXikqXjBGXilGXiFAXip7XiEi",
      "byte_length": 84
    },
    {
      "unit_id": "DLG_dbd9eaa7e116",
      "text": "她當時正從頭骨神廟返回，丘爾的暴徒半路將她強行擄走。他們屠殺了我手下最優秀的勇士， ",
      "encoded_ascii": "^+h^&N^$f^%H^#f^)t^*$^&w^0[^7J^\"\\^*A^5(^&/^&Z^$m^#d^\"-^(a^#7^+h^#]^(;^92^.&^!\"^!@^*{^#A^%M^*D^$%^$+^!(^$q^+)^-9^&Z^\"$^+a^*A ",
      "encoded_base64": "XitoXiZOXiRmXiVIXiNmXil0XiokXiZ3XjBbXjdKXiJcXipBXjUoXiYvXiZaXiRtXiNkXiItXihhXiM3XitoXiNdXig7XjkyXi4mXiEiXiFAXip7XiNBXiVNXipEXiQlXiQrXiEoXiRxXispXi05XiZaXiIkXithXipBIA==",
      "byte_length": 124
    },
    {
      "unit_id": "DLG_19a506b81021",
      "text": "隨後消失無蹤。我甚至連一張勒索信都沒收到！",
      "encoded_ascii": "^)X^#b^%k^\"|^%}^(b^!\"^$%^/|^'n^.0^!%^,(^=j^'>^!U^)$^%\\^$M^!u^*W",
      "encoded_base64": "XilYXiNiXiVrXiJ8XiV9XihiXiEiXiQlXi98XiduXi4wXiElXiwoXj1qXic+XiFVXikkXiVcXiRNXiF1XipX",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_0d019be4d9f2",
      "text": "除了她絕世的美貌之外，他們根本沒有理由抓她。到目前為止， ",
      "encoded_ascii": "^)Q^*D^+h^-I^*p^&Z^-P^-~^!/^\"w^*A^!@^*{^%)^$x^%\\^$s^&A^&I^$2^+h^!\"^!u^&^^!z^%{^%G^*A ",
      "encoded_base64": "XilRXipEXitoXi1JXipwXiZaXi1QXi1+XiEvXiJ3XipBXiFAXip7XiUpXiR4XiVcXiRzXiZBXiZJXiQyXitoXiEiXiF1XiZeXiF6XiV7XiVHXipBIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_d35abfff24da",
      "text": "他們也沒有提出任何贖回她的要求。",
      "encoded_ascii": "^!@^*{^!1^%\\^$s^$A^!q^!C^!L^3-^\"\\^+h^&Z^(C^,n^!\"",
      "encoded_base64": "XiFAXip7XiExXiVcXiRzXiRBXiFxXiFDXiFMXjMtXiJcXitoXiZaXihDXixuXiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_9a24411462b0",
      "text": "誰知道那些狂信徒腦袋裡在想些什麼！只要有任何人不宣誓效忠於特克圖克特雷， ",
      "encoded_ascii": "^-y^&h^(y^)!^!8^&8^!U^#d^2@^(?^-j^\"d^,1^!8^!=^.T^*W^\"?^(C^$s^!C^!L^!<^!)^2d^-w^$Q^.d^$^^&5^!d^\"b^!d^&5^)c^*A ",
      "encoded_base64": "Xi15XiZoXih5XikhXiE4XiY4XiFVXiNkXjJAXig/Xi1qXiJkXiwxXiE4XiE9Xi5UXipXXiI/XihDXiRzXiFDXiFMXiE8XiEpXjJkXi13XiRRXi5kXiReXiY1XiFkXiJiXiFkXiY1XiljXipBIA==",
      "byte_length": 109
    },
    {
      "unit_id": "DLG_95063a59848f",
      "text": "他們就會群起圍攻。",
      "encoded_ascii": "^!@^*{^*J^$r^'R^.(^\"`^$O^!\"",
      "encoded_base64": "XiFAXip7XipKXiRyXidSXi4oXiJgXiRPXiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_8f10059961bc",
      "text": "不，我求求你們。你們是唯一能救她性命的人！ ",
      "encoded_ascii": "^!)^*A^$%^,n^,n^*F^*{^!\"^*F^*{^,X^+O^!%^'b^,Q^+h^#r^\"N^&Z^!<^*W ",
      "encoded_base64": "XiEpXipBXiQlXixuXixuXipGXip7XiEiXipGXip7XixYXitPXiElXidiXixRXitoXiNyXiJOXiZaXiE8XipXIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_f6af7f4e7278",
      "text": "只要能救回我女兒，我願傾家蕩產奉獻所有。",
      "encoded_ascii": "^\"?^(C^'b^,Q^\"\\^$%^#\"^++^*A^$%^.H^2U^+s^1X^&G^1+^-(^$)^$s^!\"",
      "encoded_base64": "XiI/XihDXidiXixRXiJcXiQlXiMiXisrXipBXiQlXi5IXjJVXitzXjFYXiZHXjErXi0oXiQpXiRzXiEi",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_2fcb62953825",
      "text": "求求你們！救救我們免遭狂信徒毒手！你們一定要阻止他們！",
      "encoded_ascii": "^,n^,n^*F^*{^*W^,Q^,Q^$%^*{^!e^(}^&8^!U^#d^%Q^$+^*W^*F^*{^!%^#.^(C^)L^%G^!@^*{^*W",
      "encoded_base64": "XixuXixuXipGXip7XipXXixRXixRXiQlXip7XiFlXih9XiY4XiFVXiNkXiVRXiQrXipXXipGXip7XiElXiMuXihDXilMXiVHXiFAXip7XipX",
      "byte_length": 81
    },
    {
      "unit_id": "DLG_9e06177e60b9",
      "text": "你們好，勇士們。 ",
      "encoded_ascii": "^*F^*{^+i^*A^\"$^+a^*{^!\" ",
      "encoded_base64": "XipGXip7XitpXipBXiIkXithXip7XiEiIA==",
      "byte_length": 25
    },
    {
      "unit_id": "DLG_cc95ad7e3882",
      "text": "  你們的酋長在哪裡？",
      "encoded_ascii": "  ^*F^*{^&Z^=5^)C^\"d^+I^-j^.V",
      "encoded_base64": "ICBeKkZeKnteJlpePTVeKUNeImReK0leLWpeLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_30221a76039e",
      "text": "  跟我說說你們酋長的事。",
      "encoded_ascii": "  ^.+^$%^-x^-x^*F^*{^=5^)C^&Z^*r^!\"",
      "encoded_base64": "ICBeLiteJCVeLXheLXheKkZeKntePTVeKUNeJlpeKnJeISI=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_d0b59955fbf8",
      "text": "  什麼是長老？",
      "encoded_ascii": "  ^!=^.T^,X^)C^'U^.V",
      "encoded_base64": "ICBeIT1eLlReLFheKUNeJ1VeLlY=",
      "byte_length": 20
    },
    {
      "unit_id": "DLG_e129fed93cc8",
      "text": "  這裡環境真不錯。",
      "encoded_ascii": "  ^(s^-j^&B^\"q^-2^!)^)5^!\"",
      "encoded_base64": "ICBeKHNeLWpeJkJeInFeLTJeISleKTVeISI=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_bc148189f881",
      "text": "  跟我說說酋長女兒的事。",
      "encoded_ascii": "  ^.+^$%^-x^-x^=5^)C^#\"^++^&Z^*r^!\"",
      "encoded_base64": "ICBeLiteJCVeLXheLXhePTVeKUNeIyJeKyteJlpeKnJeISI=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_253fd7c74f2c",
      "text": "很高興能與你們交談。再見。",
      "encoded_ascii": "^*K^*+^-]^'b^'p^*F^*{^0P^0;^!\"^!l^-m^!\"",
      "encoded_base64": "XipLXiorXi1dXidiXidwXipGXip7XjBQXjA7XiEiXiFsXi1tXiEi",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_5b7e83a100df",
      "text": "我們對你們的感激之情永生難報。你們是 ",
      "encoded_ascii": "^$%^*{^#:^*F^*{^&Z^#{^1H^!/^,0^%W^&F^)a^+`^!\"^*F^*{^,X ",
      "encoded_base64": "XiQlXip7XiM6XipGXip7XiZaXiN7XjFIXiEvXiwwXiVXXiZGXilhXitgXiEiXipGXip7XixYIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_940be22f3b98",
      "text": "無畏的英雄，並讓我們明白並非所有地表居民都 ",
      "encoded_ascii": "^%}^7@^&Z^'y^)\\^*A^!+^-}^$%^*{^$c^&X^!+^)i^$)^$s^\"e^-i^+w^%T^)$ ",
      "encoded_base64": "XiV9XjdAXiZaXid5XilcXipBXiErXi19XiQlXip7XiRjXiZYXiErXilpXiQpXiRzXiJlXi1pXit3XiVUXikkIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_cdec95dd9bca",
      "text": "殘酷又自私。",
      "encoded_ascii": "^,l^1b^+;^'l^&~^!\"",
      "encoded_base64": "XixsXjFiXis7XidsXiZ+XiEi",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_b0b678405a46",
      "text": "他的巢穴在 ",
      "encoded_ascii": "^!@^&Z^#G^'&^\"d ",
      "encoded_base64": "XiFAXiZaXiNHXicmXiJkIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_e8ab7e63c07b",
      "text": "東方",
      "encoded_ascii": "^,`^$]",
      "encoded_base64": "XixgXiRd",
      "byte_length": 6
    },
    {
      "unit_id": "DLG_a84713e38b63",
      "text": "，就在頭骨神廟的正南方。",
      "encoded_ascii": "^*A^*J^\"d^)t^*$^&w^0[^&Z^%H^\"/^$]^!\"",
      "encoded_base64": "XipBXipKXiJkXil0XiokXiZ3XjBbXiZaXiVIXiIvXiRdXiEi",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_651c97d7177a",
      "text": "酋長是鼠人中最英勇且最睿智的，等到時候一到，他必定會成為 ",
      "encoded_ascii": "^=5^)C^,X^*=^!<^!,^$q^'y^\"$^!*^$q^/=^$i^&Z^*A^'-^!u^$f^*|^!%^!u^*A^!@^#l^#.^$r^$$^%{ ",
      "encoded_base64": "Xj01XilDXixYXio9XiE8XiEsXiRxXid5XiIkXiEqXiRxXi89XiRpXiZaXipBXictXiF1XiRmXip8XiElXiF1XipBXiFAXiNsXiMuXiRyXiQkXiV7IA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_ef2cc5c897e1",
      "text": "一名長老。",
      "encoded_ascii": "^!%^\"F^)C^'U^!\"",
      "encoded_base64": "XiElXiJGXilDXidVXiEi",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_82063a27f818",
      "text": "長老是那些先行者，是引導並教誨我們的前輩。",
      "encoded_ascii": "^)C^'U^,X^)!^!8^!b^(;^'V^*A^,X^#Z^10^!+^,R^<F^$%^*{^&Z^!z^8t^!\"",
      "encoded_base64": "XilDXidVXixYXikhXiE4XiFiXig7XidWXipBXixYXiNaXjEwXiErXixSXjxGXiQlXip7XiZaXiF6Xjh0XiEi",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_760e6b88c700",
      "text": "我們以這裡的家園為榮。這絕對是一條極佳的下水道。 ",
      "encoded_ascii": "^$%^*{^!B^(s^-j^&Z^+s^41^%{^,e^!\"^(s^-I^#:^,X^!%^%.^1D^7P^&Z^!(^%V^(y^!\" ",
      "encoded_base64": "XiQlXip7XiFCXihzXi1qXiZaXitzXjQxXiV7XixlXiEiXihzXi1JXiM6XixYXiElXiUuXjFEXjdQXiZaXiEoXiVWXih5XiEiIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_c0dbc86c8d50",
      "text": "上方城邦裡的富人們把財寶順著排水管倒了下來。 ",
      "encoded_ascii": "^!'^$]^+_^1a^-j^&Z^3C^!<^*{^$1^0=^#4^.D^-a^$<^%V^-D^!X^*D^!(^!O^!\" ",
      "encoded_base64": "XiEnXiRdXitfXjFhXi1qXiZaXjNDXiE8Xip7XiQxXjA9XiM0Xi5EXi1hXiQ8XiVWXi1EXiFYXipEXiEoXiFPXiEiIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_858e99b394fc",
      "text": "我們所要做的就是把東西撈起來。",
      "encoded_ascii": "^$%^*{^$)^(C^*~^&Z^*J^,X^$1^,`^-l^5S^.(^!O^!\"",
      "encoded_base64": "XiQlXip7XiQpXihDXip+XiZaXipKXixYXiQxXixgXi1sXjVTXi4oXiFPXiEi",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_4908a7f09fcc",
      "text": "我只知道底層巢穴的暴徒抓走了酋長的女兒。 ",
      "encoded_ascii": "^$%^\"?^&h^(y^/^^#B^#G^'&^&Z^$m^#d^$2^.&^*D^=5^)C^&Z^#\"^++^!\" ",
      "encoded_base64": "XiQlXiI/XiZoXih5Xi9eXiNCXiNHXicmXiZaXiRtXiNkXiQyXi4mXipEXj01XilDXiZaXiMiXisrXiEiIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_30eb0f4343b6",
      "text": "她非常美麗。",
      "encoded_ascii": "^+h^)i^#O^-P^0z^!\"",
      "encoded_base64": "XitoXilpXiNPXi1QXjB6XiEi",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_c334470250bc",
      "text": "出路？根本沒有離開下水道的辦法。 ",
      "encoded_ascii": "^!q^(a^.V^%)^$x^%\\^$s^)`^)F^!(^%V^(y^&Z^2L^%b^!\" ",
      "encoded_base64": "XiFxXihhXi5WXiUpXiR4XiVcXiRzXilgXilGXiEoXiVWXih5XiZaXjJMXiViXiEiIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_ff435fbf22a8",
      "text": "你們為什麼會想離開下水道？",
      "encoded_ascii": "^*F^*{^%{^!=^.T^$r^,1^)`^)F^!(^%V^(y^.V",
      "encoded_base64": "XipGXip7XiV7XiE9Xi5UXiRyXiwxXilgXilGXiEoXiVWXih5Xi5W",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_5111a3420d4f",
      "text": "這卷以工整筆跡書寫的卷軸已經被蟲蛀蝕，邊緣也被 ",
      "encoded_ascii": "^(s^\"3^!B^+y^$T^-A^(`^$p^/]^&Z^\"3^(e^#J^'D^(@^(8^=v^(4^*A^.8^9J^!1^(@ ",
      "encoded_base64": "XihzXiIzXiFCXit5XiRUXi1BXihgXiRwXi9dXiZaXiIzXihlXiNKXidEXihAXig4Xj12Xig0XipBXi44XjlKXiExXihAIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_7d81c8cec5ae",
      "text": "老鼠啃得殘破不堪。不過， ",
      "encoded_ascii": "^'U^*=^7T^#e^,l^&n^!)^6O^!\"^!)^(x^*A ",
      "encoded_base64": "XidVXio9XjdUXiNlXixsXiZuXiEpXjZPXiEiXiEpXih4XipBIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_954419a9c5e6",
      "text": " 仍然能辨讀其中的大部分內容。",
      "encoded_ascii": " ^!?^&\"^'b^6{^7I^!j^!,^&Z^\"z^)#^!s^!g^+t^!\"",
      "encoded_base64": "IF4hP14mIl4nYl42e143SV4hal4hLF4mWl4iel4pI14hc14hZ14rdF4hIg==",
      "byte_length": 43
    },
    {
      "unit_id": "DLG_9a9fde4749e3",
      "text": "我找到了我兄弟的巢穴，狡詐地隱匿在一座水池 ",
      "encoded_ascii": "^$%^$/^!u^*D^$%^1!^16^&Z^#G^'&^*A^::^6(^\"e^)Y^7%^\"d^!%^/_^%V^%X ",
      "encoded_base64": "XiQlXiQvXiF1XipEXiQlXjEhXjE2XiZaXiNHXicmXipBXjo6XjYoXiJlXilZXjclXiJkXiElXi9fXiVWXiVYIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_5596c37c144f",
      "text": "之下。很快，我就要當面質問達戈拉爾的罪惡以及他製造的那些 ",
      "encoded_ascii": "^!/^!(^!\"^*K^*L^*A^$%^*J^(C^&N^)j^(Z^*Z^(z^*M^$6^&/^&Z^5x^#y^!B^\"7^!@^(B^(v^&Z^)!^!8 ",
      "encoded_base64": "XiEvXiEoXiEiXipLXipMXipBXiQlXipKXihDXiZOXilqXihaXipaXih6XipNXiQ2XiYvXiZaXjV4XiN5XiFCXiI3XiFAXihCXih2XiZaXikhXiE4IA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_4df58817f35b",
      "text": "畸形怪物。他絕不能拒絕自己的親兄弟！",
      "encoded_ascii": "^=u^#_^#s^&4^!\"^!@^-I^!)^'b^5Q^-I^'l^#I^&Z^(F^1!^16^*W",
      "encoded_base64": "Xj11XiNfXiNzXiY0XiEiXiFAXi1JXiEpXidiXjVRXi1JXidsXiNJXiZaXihGXjEhXjE2XipX",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_4a6f142f11de",
      "text": "我恐怕必須先把分離之杖藏好，然後再進入 ",
      "encoded_ascii": "^$%^#t^0^^#l^)r^!b^$1^!s^)`^!/^${^-f^+i^*A^&\"^#b^!l^(w^!f ",
      "encoded_base64": "XiQlXiN0XjBeXiNsXilyXiFiXiQxXiFzXilgXiEvXiR7Xi1mXitpXipBXiYiXiNiXiFsXih3XiFmIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_9fea5c050e66",
      "text": "達戈拉爾的坑道。我兄弟極有可能扭曲其 ",
      "encoded_ascii": "^(z^*M^$6^&/^&Z^5>^(y^!\"^$%^1!^16^1D^$s^\"A^'b^1;^$n^!j ",
      "encoded_base64": "Xih6XipNXiQ2XiYvXiZaXjU+Xih5XiEiXiQlXjEhXjE2XjFEXiRzXiJBXidiXjE7XiRuXiFqIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_6e5b749a6225",
      "text": "魔力，所以我只能寄望於運氣，祈禱沒有人找到法杖並 ",
      "encoded_ascii": "^*0^!~^*A^$)^!B^$%^\"?^'b^9k^,]^$^^.4^%U^*A^&u^&|^%\\^$s^!<^$/^!u^%b^${^!+ ",
      "encoded_base64": "XiowXiF+XipBXiQpXiFCXiQlXiI/XidiXjlrXixdXiReXi40XiVVXipBXiZ1XiZ8XiVcXiRzXiE8XiQvXiF1XiViXiR7XiErIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_b67c1311cf57",
      "text": "尾隨我闖入達戈拉爾的巢穴。",
      "encoded_ascii": "^5J^)X^$%^.z^!f^(z^*M^$6^&/^&Z^#G^'&^!\"",
      "encoded_base64": "XjVKXilYXiQlXi56XiFmXih6XipNXiQ2XiYvXiZaXiNHXicmXiEi",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_704114f43186",
      "text": "羊皮紙的大部分內容都難以辨認。不過， ",
      "encoded_ascii": "^8M^&[^0+^&Z^\"z^)#^!s^!g^+t^)$^)a^!B^6{^(O^!\"^!)^(x^*A ",
      "encoded_base64": "XjhNXiZbXjArXiZaXiJ6XikjXiFzXiFnXit0XikkXilhXiFCXjZ7XihPXiEiXiEpXih4XipBIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_5835773948b4",
      "text": " 還是能透過污跡與潦草的筆跡辨認出幾行字。",
      "encoded_ascii": " ^.7^,X^'b^(q^(x^0h^(`^'p^;/^*f^&Z^-A^(`^6{^(O^!q^#T^(;^#)^!\"",
      "encoded_base64": "IF4uN14sWF4nYl4ocV4oeF4waF4oYF4ncF47L14qZl4mWl4tQV4oYF42e14oT14hcV4jVF4oO14jKV4hIg==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_44e71c2d3f0c",
      "text": "那些骯髒的鼠人！我發現了他們的秘密。一根魔法法杖，我將會 ",
      "encoded_ascii": "^)!^!8^0L^0M^&Z^*=^!<^*W^$%^&W^&?^*D^!@^*{^&Z^1O^#0^!\"^!%^%)^*0^%b^%b^${^*A^$%^#7^$r ",
      "encoded_base64": "XikhXiE4XjBMXjBNXiZaXio9XiE8XipXXiQlXiZXXiY/XipEXiFAXip7XiZaXjFPXiMwXiEiXiElXiUpXiowXiViXiViXiR7XipBXiQlXiM3XiRyIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_33928a156000",
      "text": "從他們崇拜的那些噁心頭骨手中奪走它。這樣我就能向 ",
      "encoded_ascii": "^#f^!@^*{^13^,E^&Z^)!^!8^1p^#k^)t^*$^$+^!,^1,^.&^+o^!\"^(s^,f^$%^*J^'b^+? ",
      "encoded_base64": "XiNmXiFAXip7XjEzXixFXiZaXikhXiE4XjFwXiNrXil0XiokXiQrXiEsXjEsXi4mXitvXiEiXihzXixmXiQlXipKXidiXis/IA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_341a333d88fb",
      "text": "特克圖克特雷證明我的價值，揭發潛伏在德拉吉下水道深處的褻瀆者 ",
      "encoded_ascii": "^&5^!d^\"b^!d^&5^)c^-{^$c^$%^&Z^+&^!Z^*A^$B^&W^7:^3c^\"d^#j^$6^\"D^!(^%V^(y^2*^(,^&Z^-k^,~^'V ",
      "encoded_base64": "XiY1XiFkXiJiXiFkXiY1XiljXi17XiRjXiQlXiZaXismXiFaXipBXiRCXiZXXjc6XjNjXiJkXiNqXiQ2XiJEXiEoXiVWXih5XjIqXigsXiZaXi1rXix+XidWIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_ffab8b892e86",
      "text": "達戈拉爾。如此滔天大罪，我一定要親手殺了達戈拉爾！",
      "encoded_ascii": "^(z^*M^$6^&/^!\"^#$^%I^2t^+e^\"z^5x^*A^$%^!%^#.^(C^(F^$+^%M^*D^(z^*M^$6^&/^*W",
      "encoded_base64": "Xih6XipNXiQ2XiYvXiEiXiMkXiVJXjJ0XitlXiJ6XjV4XipBXiQlXiElXiMuXihDXihGXiQrXiVNXipEXih6XipNXiQ2XiYvXipX",
      "byte_length": 75
    },
    {
      "unit_id": "DLG_b7e4d449b02d",
      "text": " 隔著鐵柵幾乎什麼也看不清，但一股惡臭伴隨著隱約的慘叫聲 ",
      "encoded_ascii": " ^9e^-a^)?^%(^#T^!0^!=^.T^!1^*Q^!)^,u^*A^!I^!%^'_^#y^'m^1h^)X^-a^)Y^-F^&Z^,4^+<^-W ",
      "encoded_base64": "IF45ZV4tYV4pP14lKF4jVF4hMF4hPV4uVF4hMV4qUV4hKV4sdV4qQV4hSV4hJV4nX14jeV4nbV4xaF4pWF4tYV4pWV4tRl4mWl4sNF4rPF4tVyA=",
      "byte_length": 83
    },
    {
      "unit_id": "DLG_e96b480b3234",
      "text": "從洞口陣陣傳來。",
      "encoded_ascii": "^#f^%h^\"<^)P^)P^+$^!O^!\"",
      "encoded_base64": "XiNmXiVoXiI8XilQXilQXiskXiFPXiEi",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_f5c623a4337b",
      "text": "我才不要進去那裡！那是丘爾的巢穴！",
      "encoded_ascii": "^$%^$,^!)^(C^(w^\"6^)!^-j^*W^)!^,X^5(^&/^&Z^#G^'&^*W",
      "encoded_base64": "XiQlXiQsXiEpXihDXih3XiI2XikhXi1qXipXXikhXixYXjUoXiYvXiZaXiNHXicmXipX",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_42f5c3028337",
      "text": "我要去找我父親。",
      "encoded_ascii": "^$%^(C^\"6^$/^$%^5d^(F^!\"",
      "encoded_base64": "XiQlXihDXiI2XiQvXiQlXjVkXihGXiEi",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_b9b9ce7b2919",
      "text": "你好，陌生人。你也是來加入我們，一同頌揚 ",
      "encoded_ascii": "^*F^+i^*A^9z^&F^!<^!\"^*F^!1^,X^!O^\"\"^!f^$%^*{^*A^!%^\"E^7\"^2k ",
      "encoded_base64": "XipGXitpXipBXjl6XiZGXiE8XiEiXipGXiExXixYXiFPXiIiXiFmXiQlXip7XipBXiElXiJFXjciXjJrIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_878dfe6246b9",
      "text": "偉大且全能的特克圖克特雷嗎？",
      "encoded_ascii": "^*}^\"z^!*^!h^'b^&Z^&5^!d^\"b^!d^&5^)c^+X^.V",
      "encoded_base64": "Xip9XiJ6XiEqXiFoXidiXiZaXiY1XiFkXiJiXiFkXiY1XiljXitYXi5W",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_6e68d5bf51f1",
      "text": "  讚美偉大的特克圖克特雷！",
      "encoded_ascii": "  ^8'^-P^*}^\"z^&Z^&5^!d^\"b^!d^&5^)c^*W",
      "encoded_base64": "ICBeOCdeLVBeKn1eInpeJlpeJjVeIWReImJeIWReJjVeKWNeKlc=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_802b97302566",
      "text": "  你們崇拜那隻狒狒？",
      "encoded_ascii": "  ^*F^*{^13^,E^)!^)[^=t^=t^.V",
      "encoded_base64": "ICBeKkZeKnteMTNeLEVeKSFeKVtePXRePXReLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_9b1964b9b5b8",
      "text": "  去告訴你們的首領，我來見他了。",
      "encoded_ascii": "  ^\"6^+B^-t^*F^*{^&Z^)~^)s^*A^$%^!O^-m^!@^*D^!\"",
      "encoded_base64": "ICBeIjZeK0JeLXReKkZeKnteJlpeKX5eKXNeKkFeJCVeIU9eLW1eIUBeKkReISI=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_3631179595d5",
      "text": "  滾開，骯髒的鼠人！",
      "encoded_ascii": "  ^,z^)F^*A^0L^0M^&Z^*=^!<^*W",
      "encoded_base64": "ICBeLHpeKUZeKkFeMExeME1eJlpeKj1eITxeKlc=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_ff87e6d69d44",
      "text": "我有什麼能為你們效勞的嗎？",
      "encoded_ascii": "^$%^$s^!=^.T^'b^%{^*F^*{^$Q^/R^&Z^+X^.V",
      "encoded_base64": "XiQlXiRzXiE9Xi5UXidiXiV7XipGXip7XiRRXi9SXiZaXitYXi5W",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_9cb1ad3207b0",
      "text": "讚美特克圖克特雷！生命之父兼雙月之主！ ",
      "encoded_ascii": "^8'^-P^&5^!d^\"b^!d^&5^)c^*W^&F^\"N^!/^5d^<4^)_^/p^!/^!-^*W ",
      "encoded_base64": "XjgnXi1QXiY1XiFkXiJiXiFkXiY1XiljXipXXiZGXiJOXiEvXjVkXjw0XilfXi9wXiEvXiEtXipXIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_1c044cf825c2",
      "text": "你們膽敢侵犯我們的聖所？！特克圖克特雷的尊嚴 ",
      "encoded_ascii": "^*F^*{^-[^/m^.X^-%^$%^*{^&Z^'Z^$)^.V^*W^&5^!d^\"b^!d^&5^)c^&Z^+u^1* ",
      "encoded_base64": "XipGXip7Xi1bXi9tXi5YXi0lXiQlXip7XiZaXidaXiQpXi5WXipXXiY1XiFkXiJiXiFkXiY1XiljXiZaXit1XjEqIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_bd02ea774238",
      "text": "必將討回血債！",
      "encoded_ascii": "^#l^#7^-o^\"\\^(:^<d^*W",
      "encoded_base64": "XiNsXiM3Xi1vXiJcXig6XjxkXipX",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_315ebd6a45d5",
      "text": "你竟敢嘲弄特克圖克特雷！ ",
      "encoded_ascii": "^*F^28^/m^+Z^/`^&5^!d^\"b^!d^&5^)c^*W ",
      "encoded_base64": "XipGXjI4Xi9tXitaXi9gXiY1XiFkXiJiXiFkXiY1XiljXipXIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_0dfc1a49b8cd",
      "text": "異端！異教徒！",
      "encoded_ascii": "^&M^5o^*W^&M^,R^#d^*W",
      "encoded_base64": "XiZNXjVvXipXXiZNXixSXiNkXipX",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_8798d2898166",
      "text": "米奎茲爾大人何必理會你們？",
      "encoded_ascii": "^'4^5B^/D^&/^\"z^!<^!L^#l^&A^$r^*F^*{^.V",
      "encoded_base64": "Xic0XjVCXi9EXiYvXiJ6XiE8XiFMXiNsXiZBXiRyXipGXip7Xi5W",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_18b602dbb436",
      "text": "你們膽敢侮辱生命之父兼 ",
      "encoded_ascii": "^*F^*{^-[^/m^9+^3`^&F^\"N^!/^5d^<4 ",
      "encoded_base64": "XipGXip7Xi1bXi9tXjkrXjNgXiZGXiJOXiEvXjVkXjw0IA==",
      "byte_length": 34
    },
    {
      "unit_id": "DLG_046b378c3f79",
      "text": "雙月之主的忠誠僕從！特克圖克特雷必將降下復仇！",
      "encoded_ascii": "^)_^/p^!/^!-^&Z^.d^2E^+%^#f^*W^&5^!d^\"b^!d^&5^)c^#l^#7^)N^!(^#g^1g^*W",
      "encoded_base64": "XilfXi9wXiEvXiEtXiZaXi5kXjJFXislXiNmXipXXiY1XiFkXiJiXiFkXiY1XiljXiNsXiM3XilOXiEoXiNnXjFnXipX",
      "byte_length": 69
    },
    {
      "unit_id": "DLG_23610c73603d",
      "text": "  我該如何加入你們信徒的行列？",
      "encoded_ascii": "  ^$%^(M^#$^!L^\"\"^!f^*F^*{^!U^#d^&Z^(;^8f^.V",
      "encoded_base64": "ICBeJCVeKE1eIyReIUxeIiJeIWZeKkZeKnteIVVeI2ReJlpeKDteOGZeLlY=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_4278853d7a56",
      "text": "  少管閒事！米奎茲爾在哪裡？",
      "encoded_ascii": "  ^#<^-D^6A^*r^*W^'4^5B^/D^&/^\"d^+I^-j^.V",
      "encoded_base64": "ICBeIzxeLUReNkFeKnJeKldeJzReNUJeL0ReJi9eImReK0leLWpeLlY=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_f3929665f16c",
      "text": "  我在哪裡能找到米奎茲爾？",
      "encoded_ascii": "  ^$%^\"d^+I^-j^'b^$/^!u^'4^5B^/D^&/^.V",
      "encoded_base64": "ICBeJCVeImReK0leLWpeJ2JeJC9eIXVeJzReNUJeL0ReJi9eLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_8bea347f374c",
      "text": "  這裡為什麼到處扔滿了頭骨？",
      "encoded_ascii": "  ^(s^-j^%{^!=^.T^!u^(,^8{^,{^*D^)t^*$^.V",
      "encoded_base64": "ICBeKHNeLWpeJXteIT1eLlReIXVeKCxeOHteLHteKkReKXReKiReLlY=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_81a30231c2e5",
      "text": "  你們透過崇拜能達成什麼目的？",
      "encoded_ascii": "  ^*F^*{^(q^(x^13^,E^'b^(z^$$^!=^.T^&^^&Z^.V",
      "encoded_base64": "ICBeKkZeKnteKHFeKHheMTNeLEVeJ2JeKHpeJCReIT1eLlReJl5eJlpeLlY=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_f0d9b56eed81",
      "text": "  你們能從中得到什麼好處？",
      "encoded_ascii": "  ^*F^*{^'b^#f^!,^#e^!u^!=^.T^+i^(,^.V",
      "encoded_base64": "ICBeKkZeKnteJ2JeI2ZeISxeI2VeIXVeIT1eLlReK2leKCxeLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_f345fa1c137e",
      "text": "  你們的糧食是從哪裡弄來的？",
      "encoded_ascii": "  ^*F^*{^&Z^5s^0J^,X^#f^+I^-j^/`^!O^&Z^.V",
      "encoded_base64": "ICBeKkZeKnteJlpeNXNeMEpeLFheI2ZeK0leLWpeL2BeIU9eJlpeLlY=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_942fa411f64d",
      "text": " 我必須回去繼續虔誠祈禱了。 ",
      "encoded_ascii": " ^$%^#l^)r^\"\\^\"6^-O^'M^=`^2E^&u^&|^*D^!\" ",
      "encoded_base64": "IF4kJV4jbF4pcl4iXF4iNl4tT14nTV49YF4yRV4mdV4mfF4qRF4hIiA=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_4b6bcc6a43e8",
      "text": "去神廟吧。米奎茲爾大人會主持血之入會儀式。 ",
      "encoded_ascii": "^\"6^&w^0[^*I^!\"^'4^5B^/D^&/^\"z^!<^$r^!-^$7^(:^!/^!f^$r^+'^#X^!\" ",
      "encoded_base64": "XiI2XiZ3XjBbXipJXiEiXic0XjVCXi9EXiYvXiJ6XiE8XiRyXiEtXiQ3Xig6XiEvXiFmXiRyXisnXiNYXiEiIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_e0ed6f5c7c62",
      "text": "讚美生命之父！你們將獲得新生！",
      "encoded_ascii": "^8'^-P^&F^\"N^!/^5d^*W^*F^*{^#7^&:^#e^$\\^&F^*W",
      "encoded_base64": "XjgnXi1QXiZGXiJOXiEvXjVkXipXXipGXip7XiM3XiY6XiNlXiRcXiZGXipX",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_f7342a9dc11e",
      "text": "請原諒我。米奎茲爾大人一直試圖教導我謙卑，正如我背上的傷疤 ",
      "encoded_ascii": "^*S^\"5^0<^$%^!\"^'4^5B^/D^&/^\"z^!<^!%^&`^-u^\"b^,R^10^$%^6x^\".^*A^%H^#$^$%^.r^!'^&Z^!^^5g ",
      "encoded_base64": "XipTXiI1XjA8XiQlXiEiXic0XjVCXi9EXiYvXiJ6XiE8XiElXiZgXi11XiJiXixSXjEwXiQlXjZ4XiIuXipBXiVIXiMkXiQlXi5yXiEnXiZaXiFeXjVnIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_7511aa0af480",
      "text": "所證明的那樣，但我一心只想為他效勞。",
      "encoded_ascii": "^$)^-{^$c^&Z^)!^,f^*A^!I^$%^!%^#k^\"?^,1^%{^!@^$Q^/R^!\"",
      "encoded_base64": "XiQpXi17XiRjXiZaXikhXixmXipBXiFJXiQlXiElXiNrXiI/XiwxXiV7XiFAXiRRXi9SXiEi",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_66a3024fc2da",
      "text": "米奎茲爾大人就在東北方的神廟裡。",
      "encoded_ascii": "^'4^5B^/D^&/^\"z^!<^*J^\"d^,`^+6^$]^&Z^&w^0[^-j^!\"",
      "encoded_base64": "Xic0XjVCXi9EXiYvXiJ6XiE8XipKXiJkXixgXis2XiRdXiZaXiZ3XjBbXi1qXiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_afc8cd0ee5af",
      "text": "那些是我們獻給榮耀的特克圖克特雷的祭品殘骸。",
      "encoded_ascii": "^)!^!8^,X^$%^*{^-(^'A^,e^7D^&Z^&5^!d^\"b^!d^&5^)c^&Z^&x^\"R^,l^*'^!\"",
      "encoded_base64": "XikhXiE4XixYXiQlXip7Xi0oXidBXixlXjdEXiZaXiY1XiFkXiJiXiFkXiY1XiljXiZaXiZ4XiJSXixsXionXiEi",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_1d04ebbbde59",
      "text": "米奎茲爾大人正準備降下我們偉大主宰的賜福，那就是 ",
      "encoded_ascii": "^'4^5B^/D^&/^\"z^!<^%H^,x^+\"^)N^!(^$%^*{^*}^\"z^!-^1w^&Z^.#^&z^*A^)!^*J^,X ",
      "encoded_base64": "Xic0XjVCXi9EXiYvXiJ6XiE8XiVIXix4XisiXilOXiEoXiQlXip7Xip9XiJ6XiEtXjF3XiZaXi4jXiZ6XipBXikhXipKXixYIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_7840fcc74a46",
      "text": "特克圖克特雷。",
      "encoded_ascii": "^&5^!d^\"b^!d^&5^)c^!\"",
      "encoded_base64": "XiY1XiFkXiJiXiFkXiY1XiljXiEi",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_531636f113b8",
      "text": "我們將共享特克圖克特雷恩賜的榮耀與 ",
      "encoded_ascii": "^$%^*{^#7^3d^!;^&5^!d^\"b^!d^&5^)c^#v^.#^&Z^,e^7D^'p ",
      "encoded_base64": "XiQlXip7XiM3XjNkXiE7XiY1XiFkXiJiXiFkXiY1XiljXiN2Xi4jXiZaXixlXjdEXidwIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_79c2c75cc3d0",
      "text": "豐饒！米奎茲爾大人已經帶領我們找到了成堆的糧食。",
      "encoded_ascii": "^4!^.M^*W^'4^5B^/D^&/^\"z^!<^#J^'D^#N^)s^$%^*{^$/^!u^*D^$$^*[^&Z^5s^0J^!\"",
      "encoded_base64": "XjQhXi5NXipXXic0XjVCXi9EXiYvXiJ6XiE8XiNKXidEXiNOXilzXiQlXip7XiQvXiF1XipEXiQkXipbXiZaXjVzXjBKXiEi",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_8d5399ce4477",
      "text": "我們是從不信者那裡奪來的！信徒必須強大起來，才能 ",
      "encoded_ascii": "^$%^*{^,X^#f^!)^!U^'V^)!^-j^1,^!O^&Z^*W^!U^#d^#l^)r^#]^\"z^.(^!O^*A^$,^'b ",
      "encoded_base64": "XiQlXip7XixYXiNmXiEpXiFVXidWXikhXi1qXjEsXiFPXiZaXipXXiFVXiNkXiNsXilyXiNdXiJ6Xi4oXiFPXipBXiQsXidiIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_430bfd5609a1",
      "text": "貫徹雙月之主特克圖克特雷的偉業。",
      "encoded_ascii": "^;J^18^)_^/p^!/^!-^&5^!d^\"b^!d^&5^)c^&Z^*}^%5^!\"",
      "encoded_base64": "XjtKXjE4XilfXi9wXiEvXiEtXiY1XiFkXiJiXiFkXiY1XiljXiZaXip9XiU1XiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_4118dd95556d",
      "text": "他就在神廟裡，往 ",
      "encoded_ascii": "^!@^*J^\"d^&w^0[^-j^*A^,) ",
      "encoded_base64": "XiFAXipKXiJkXiZ3XjBbXi1qXipBXiwpIA==",
      "byte_length": 25
    },
    {
      "unit_id": "DLG_19239906524c",
      "text": "南方。",
      "encoded_ascii": "^\"/^$]^!\"",
      "encoded_base64": "XiIvXiRdXiEi",
      "byte_length": 9
    },
    {
      "unit_id": "DLG_35737b97dd6c",
      "text": "願你們在特克圖克特雷的光輝中尋得榮耀。",
      "encoded_ascii": "^.H^*F^*{^\"d^&5^!d^\"b^!d^&5^)c^&Z^!c^2K^!,^#9^#e^,e^7D^!\"",
      "encoded_base64": "Xi5IXipGXip7XiJkXiY1XiFkXiJiXiFkXiY1XiljXiZaXiFjXjJLXiEsXiM5XiNlXixlXjdEXiEi",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_d4268a380b94",
      "text": "謝謝你們救了我們！ ",
      "encoded_ascii": "^-z^-z^*F^*{^,Q^*D^$%^*{^*W ",
      "encoded_base64": "Xi16Xi16XipGXip7XixRXipEXiQlXip7XipXIA==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_1d55c49796c3",
      "text": "你們一定是面紗聯盟的成員！ ",
      "encoded_ascii": "^*F^*{^!%^#.^,X^)j^-G^-V^-0^&Z^$$^+G^*W ",
      "encoded_base64": "XipGXip7XiElXiMuXixYXilqXi1HXi1WXi0wXiZaXiQkXitHXipXIA==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_fb8e7f673188",
      "text": "我們必須趕快逃跑，否則又會被抓回去。再見。 ",
      "encoded_ascii": "^$%^*{^#l^)r^0u^*L^(p^(_^*A^\"H^!x^+;^$r^(@^$2^\"\\^\"6^!\"^!l^-m^!\" ",
      "encoded_base64": "XiQlXip7XiNsXilyXjB1XipMXihwXihfXipBXiJIXiF4Xis7XiRyXihAXiQyXiJcXiI2XiEiXiFsXi1tXiEiIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_4fbfd5b0d86c",
      "text": "求求你，別傷害我！ ",
      "encoded_ascii": "^,n^,n^*F^*A^*H^!^^#/^$%^*W ",
      "encoded_base64": "XixuXixuXipGXipBXipIXiFeXiMvXiQlXipXIA==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_26396d53c772",
      "text": "不，我現在不能說話——他們會打我的！ ",
      "encoded_ascii": "^!)^*A^$%^&?^\"d^!)^'b^-x^-v^*n^*n^!@^*{^$r^$-^$%^&Z^*W ",
      "encoded_base64": "XiEpXipBXiQlXiY/XiJkXiEpXidiXi14Xi12XipuXipuXiFAXip7XiRyXiQtXiQlXiZaXipXIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_d35ca5a4bc8e",
      "text": "我不能說話。我得在他們決定動手痛打我之前 ",
      "encoded_ascii": "^$%^!)^'b^-x^-v^!\"^$%^#e^\"d^!@^*{^,o^#.^\"%^$+^-.^$-^$%^!/^!z ",
      "encoded_base64": "XiQlXiEpXidiXi14Xi12XiEiXiQlXiNlXiJkXiFAXip7XixvXiMuXiIlXiQrXi0uXiQtXiQlXiEvXiF6IA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_dccb58b87cec",
      "text": "趕快回去幹活！",
      "encoded_ascii": "^0u^*L^\"\\^\"6^,!^%i^*W",
      "encoded_base64": "XjB1XipMXiJcXiI2XiwhXiVpXipX",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_729d7ea41b2e",
      "text": "安靜點，繼續幹活——否則我們大家都要挨鞭子了！",
      "encoded_ascii": "^+p^)h^*;^*A^-O^'M^,!^%i^*n^*n^\"H^!x^$%^*{^\"z^+s^)$^(C^7\\^)m^#(^*D^*W",
      "encoded_base64": "XitwXiloXio7XipBXi1PXidNXiwhXiVpXipuXipuXiJIXiF4XiQlXip7XiJ6XitzXikkXihDXjdcXiltXiMoXipEXipX",
      "byte_length": 69
    },
    {
      "unit_id": "DLG_d056602058a9",
      "text": "  聖堂武士跑到這種地方來做什麼？",
      "encoded_ascii": "  ^'Z^42^%J^+a^(_^!u^(s^'$^\"e^$]^!O^*~^!=^.T^.V",
      "encoded_base64": "ICBeJ1peNDJeJUpeK2FeKF9eIXVeKHNeJyReImVeJF1eIU9eKn5eIT1eLlReLlY=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_76668008c133",
      "text": "  我才不怕什麼聖堂武士。",
      "encoded_ascii": "  ^$%^$,^!)^0^^!=^.T^'Z^42^%J^+a^!\"",
      "encoded_base64": "ICBeJCVeJCxeISleMF5eIT1eLlReJ1peNDJeJUpeK2FeISI=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_029af48522c2",
      "text": "我會保持安靜的。再見。",
      "encoded_ascii": "^$%^$r^!T^$7^+p^)h^&Z^!\"^!l^-m^!\"",
      "encoded_base64": "XiQlXiRyXiFUXiQ3XitwXiloXiZaXiEiXiFsXi1tXiEi",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_9bf8861c5057",
      "text": "  他憑什麼認為這裡有銅礦？",
      "encoded_ascii": "  ^!@^,5^!=^.T^(O^%{^(s^-j^$s^0x^5m^.V",
      "encoded_base64": "ICBeIUBeLDVeIT1eLlReKE9eJXteKHNeLWpeJHNeMHheNW1eLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_6354d63ec63b",
      "text": "  別跟任何人提起我跟你們說過話。",
      "encoded_ascii": "  ^*H^.+^!C^!L^!<^$A^.(^$%^.+^*F^*{^-x^(x^-v^!\"",
      "encoded_base64": "ICBeKkheLiteIUNeIUxeITxeJEFeLiheJCVeLiteKkZeKnteLXheKHheLXZeISI=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_e7ec669f049c",
      "text": "  那個聖堂武士為什麼會在這裡？",
      "encoded_ascii": "  ^)!^!V^'Z^42^%J^+a^%{^!=^.T^$r^\"d^(s^-j^.V",
      "encoded_base64": "ICBeKSFeIVZeJ1peNDJeJUpeK2FeJXteIT1eLlReJHJeImReKHNeLWpeLlY=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_1bb116873fbc",
      "text": "  你們很快就會重獲自由了。 ",
      "encoded_ascii": "  ^*F^*{^*K^*L^*J^$r^))^&:^'l^&I^*D^!\" ",
      "encoded_base64": "ICBeKkZeKnteKkteKkxeKkpeJHJeKSleJjpeJ2xeJkleKkReISIg",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_84fc1282e404",
      "text": "  我是面紗聯盟的人！ ",
      "encoded_ascii": "  ^$%^,X^)j^-G^-V^-0^&Z^!<^*W ",
      "encoded_base64": "ICBeJCVeLFheKWpeLUdeLVZeLTBeJlpeITxeKlcg",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_b6a72d17f70c",
      "text": "  安靜點。事情很快就會明朗了。 ",
      "encoded_ascii": "  ^+p^)h^*;^!\"^*r^,0^*K^*L^*J^$r^$c^$t^*D^!\" ",
      "encoded_base64": "ICBeK3BeKWheKjteISJeKnJeLDBeKkteKkxeKkpeJHJeJGNeJHReKkReISIg",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_117e37b276aa",
      "text": "  據我所知，就只有我一個。 ",
      "encoded_ascii": "  ^5T^$%^$)^&h^*A^*J^\"?^$s^$%^!%^!V^!\" ",
      "encoded_base64": "ICBeNVReJCVeJCleJmheKkFeKkpeIj9eJHNeJCVeISVeIVZeISIg",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_3a6a9bda82dd",
      "text": "  沒有報酬？什麼都沒有嗎？ ",
      "encoded_ascii": "  ^%\\^$s^+`^7o^.V^!=^.T^)$^%\\^$s^+X^.V ",
      "encoded_base64": "ICBeJVxeJHNeK2BeN29eLlZeIT1eLlReKSReJVxeJHNeK1heLlYg",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_6e286a7943d8",
      "text": "呃……沒有。我們是奴隸，記得嗎？奴隸的酬勞可是少得可憐。 ",
      "encoded_ascii": "^3<^*o^*o^%\\^$s^!\"^$%^*{^,X^##^)Z^*A^(K^#e^+X^.V^##^)Z^&Z^7o^/R^\"A^,X^#<^#e^\"A^1}^!\" ",
      "encoded_base64": "XjM8XipvXipvXiVcXiRzXiEiXiQlXip7XixYXiMjXilaXipBXihLXiNlXitYXi5WXiMjXilaXiZaXjdvXi9SXiJBXixYXiM8XiNlXiJBXjF9XiEiIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_c10db9744b0b",
      "text": "就你？沒別人了？整個亞斯就只有你？我們死定了……全都死定了…… ",
      "encoded_ascii": "^*J^*F^.V^%\\^*H^!<^*D^.V^$T^!V^!9^$[^*J^\"?^$s^*F^.V^$%^*{^%L^#.^*D^*o^*o^!h^)$^%L^#.^*D^*o^*o ",
      "encoded_base64": "XipKXipGXi5WXiVcXipIXiE8XipEXi5WXiRUXiFWXiE5XiRbXipKXiI/XiRzXipGXi5WXiQlXip7XiVMXiMuXipEXipvXipvXiFoXikkXiVMXiMuXipEXipvXipvIA==",
      "byte_length": 94
    },
    {
      "unit_id": "DLG_9e666c8c9ae6",
      "text": "他以為階梯溫泉底下有銅礦。他真是 ",
      "encoded_ascii": "^!@^!B^%{^=b^3u^%s^%a^/^^!(^$s^0x^5m^!\"^!@^-2^,X ",
      "encoded_base64": "XiFAXiFCXiV7Xj1iXjN1XiVzXiVhXi9eXiEoXiRzXjB4XjVtXiEiXiFAXi0yXixYIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_2202bb785157",
      "text": "貪婪瘋了！他逼著我們日以繼夜地開採。",
      "encoded_ascii": "^1^^1-^-/^*D^*W^!@^.1^-a^$%^*{^$a^!B^-O^+c^\"e^)F^5R^!\"",
      "encoded_base64": "XjFeXjEtXi0vXipEXipXXiFAXi4xXi1hXiQlXip7XiRhXiFCXi1PXitjXiJlXilGXjVSXiEi",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_fdd5e0386e5b",
      "text": "自由？你是什麼意思？這怎麼可能？你為什麼要幫我們？ ",
      "encoded_ascii": "^'l^&I^.V^*F^,X^!=^.T^#z^#q^.V^(s^,,^.T^\"A^'b^.V^*F^%{^!=^.T^(C^+}^$%^*{^.V ",
      "encoded_base64": "XidsXiZJXi5WXipGXixYXiE9Xi5UXiN6XiNxXi5WXihzXiwsXi5UXiJBXidiXi5WXipGXiV7XiE9Xi5UXihDXit9XiQlXip7Xi5WIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_81ff8d5db0ae",
      "text": "噢對了……沒錯……抱歉。 ",
      "encoded_ascii": "^+]^#:^*D^*o^*o^%\\^)5^*o^*o^,@^,h^!\" ",
      "encoded_base64": "XitdXiM6XipEXipvXipvXiVcXik1XipvXipvXixAXixoXiEiIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_296b3de776cb",
      "text": "這就說得通了。只有面紗聯盟才會為了幾乎沒有回報的可能， ",
      "encoded_ascii": "^(s^*J^-x^#e^(t^*D^!\"^\"?^$s^)j^-G^-V^-0^$,^$r^%{^*D^#T^!0^%\\^$s^\"\\^+`^&Z^\"A^'b^*A ",
      "encoded_base64": "XihzXipKXi14XiNlXih0XipEXiEiXiI/XiRzXilqXi1HXi1WXi0wXiQsXiRyXiV7XipEXiNUXiEwXiVcXiRzXiJcXitgXiZaXiJBXidiXipBIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_9e583af85252",
      "text": "而奮戰去解救其他人。話說回來，聯盟裡到底有多少人？ ",
      "encoded_ascii": "^'W^+g^$(^\"6^(I^,Q^!j^!@^!<^!\"^-v^-x^\"\\^!O^*A^-V^-0^-j^!u^/^^$s^\"x^#<^!<^.V ",
      "encoded_base64": "XidXXitnXiQoXiI2XihJXixRXiFqXiFAXiE8XiEiXi12Xi14XiJcXiFPXipBXi1WXi0wXi1qXiF1Xi9eXiRzXiJ4XiM8XiE8Xi5WIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_5844dbaccabe",
      "text": "你確定嗎？上次他抓到入侵者時，他把他們的皮給 ",
      "encoded_ascii": "^*F^-6^#.^+X^.V^!'^%D^!@^$2^!u^!f^.X^'V^$f^*A^!@^$1^!@^*{^&Z^&[^'A ",
      "encoded_base64": "XipGXi02XiMuXitYXi5WXiEnXiVEXiFAXiQyXiF1XiFmXi5YXidWXiRmXipBXiFAXiQxXiFAXip7XiZaXiZbXidBIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_012b8f434ab4",
      "text": "剝下來掛在小屋的牆上示眾。",
      "encoded_ascii": "^=s^!(^!O^$=^\"d^#;^8y^&Z^&0^!'^&s^&e^!\"",
      "encoded_base64": "Xj1zXiEoXiFPXiQ9XiJkXiM7Xjh5XiZaXiYwXiEnXiZzXiZlXiEi",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_bc62ea2aa7f5",
      "text": "誰在乎呢？不管他是不是對的，我們都得幹活。",
      "encoded_ascii": "^-y^\"d^!0^+C^.V^!)^-D^!@^,X^!)^,X^#:^&Z^*A^$%^*{^)$^#e^,!^%i^!\"",
      "encoded_base64": "Xi15XiJkXiEwXitDXi5WXiEpXi1EXiFAXixYXiEpXixYXiM6XiZaXipBXiQlXip7XikkXiNlXiwhXiVpXiEi",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_6533594d2c74",
      "text": "我什麼都不會說的，但趁他們抓到你們之前快滾吧！",
      "encoded_ascii": "^$%^!=^.T^)$^!)^$r^-x^&Z^*A^!I^.)^!@^*{^$2^!u^*F^*{^!/^!z^*L^,z^*I^*W",
      "encoded_base64": "XiQlXiE9Xi5UXikkXiEpXiRyXi14XiZaXipBXiFJXi4pXiFAXip7XiQyXiF1XipGXip7XiEvXiF6XipMXix6XipJXipX",
      "byte_length": 69
    },
    {
      "unit_id": "DLG_6d2d9d0aae1c",
      "text": "別殺我！求求你！ ",
      "encoded_ascii": "^*H^%M^$%^*W^,n^,n^*F^*W ",
      "encoded_base64": "XipIXiVNXiQlXipXXixuXixuXipGXipXIA==",
      "byte_length": 25
    },
    {
      "unit_id": "DLG_f12f7d3af537",
      "text": "我們得在追兵被派來搜捕我們之前 ",
      "encoded_ascii": "^$%^*{^#e^\"d^(o^+,^(@^.n^!O^/h^4?^$%^*{^!/^!z ",
      "encoded_base64": "XiQlXip7XiNlXiJkXihvXissXihAXi5uXiFPXi9oXjQ/XiQlXip7XiEvXiF6IA==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_3a37b22182c7",
      "text": "趕快逃離這裡！你們也別在這裡久留了。祝你們好運！",
      "encoded_ascii": "^0u^*L^(p^)`^(s^-j^*W^*F^*{^!1^*H^\"d^(s^-j^!.^-+^*D^!\"^&v^*F^*{^+i^.4^*W",
      "encoded_base64": "XjB1XipMXihwXilgXihzXi1qXipXXipGXip7XiExXipIXiJkXihzXi1qXiEuXi0rXipEXiEiXiZ2XipGXip7XitpXi40XipX",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_7cd5cf12d0a5",
      "text": "我們不能久留——我們必須逃得越遠越好， ",
      "encoded_ascii": "^$%^*{^!)^'b^!.^-+^*n^*n^$%^*{^#l^)r^(p^#e^(]^({^(]^+i^*A ",
      "encoded_base64": "XiQlXip7XiEpXidiXiEuXi0rXipuXipuXiQlXip7XiNsXilyXihwXiNlXihdXih7XihdXitpXipBIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_28ac89662afc",
      "text": "免得追兵趕來搜捕我們。你們也該走了， ",
      "encoded_ascii": "^!e^#e^(o^+,^0u^!O^/h^4?^$%^*{^!\"^*F^*{^!1^(M^.&^*D^*A ",
      "encoded_base64": "XiFlXiNlXihvXissXjB1XiFPXi9oXjQ/XiQlXip7XiEiXipGXip7XiExXihNXi4mXipEXipBIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_fdac6765ad5a",
      "text": "祝你們好運！",
      "encoded_ascii": "^&v^*F^*{^+i^.4^*W",
      "encoded_base64": "XiZ2XipGXip7XitpXi40XipX",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_7f82922c8884",
      "text": "多謝你們把我們從那個瘋子手裡解救出來！",
      "encoded_ascii": "^\"x^-z^*F^*{^$1^$%^*{^#f^)!^!V^-/^#(^$+^-j^(I^,Q^!q^!O^*W",
      "encoded_base64": "XiJ4Xi16XipGXip7XiQxXiQlXip7XiNmXikhXiFWXi0vXiMoXiQrXi1qXihJXixRXiFxXiFPXipX",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_fe24f2a410c2",
      "text": "  加入反抗德拉吉的聯盟吧。",
      "encoded_ascii": "  ^\"\"^!f^\"9^$4^#j^$6^\"D^&Z^-V^-0^*I^!\"",
      "encoded_base64": "ICBeIiJeIWZeIjleJDReI2peJDZeIkReJlpeLVZeLTBeKkleISI=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_5c36c90e88c7",
      "text": "  你們願意跟我一起走嗎？",
      "encoded_ascii": "  ^*F^*{^.H^#z^.+^$%^!%^.(^.&^+X^.V",
      "encoded_base64": "ICBeKkZeKnteLkheI3peLiteJCVeISVeLiheLiZeK1heLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_c4277437e5b3",
      "text": "  下次可別再惹麻煩了。再見。",
      "encoded_ascii": "  ^!(^%D^\"A^*H^!l^3s^*6^-!^*D^!\"^!l^-m^!\"",
      "encoded_base64": "ICBeISheJUReIkFeKkheIWxeM3NeKjZeLSFeKkReISJeIWxeLW1eISI=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_1fe99b305536",
      "text": "  去提奎茲爾加入我的盟友吧。",
      "encoded_ascii": "  ^\"6^$A^5B^/D^&/^\"\"^!f^$%^&Z^-0^\"8^*I^!\"",
      "encoded_base64": "ICBeIjZeJEFeNUJeL0ReJi9eIiJeIWZeJCVeJlpeLTBeIjheKkleISI=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_785b2ea9963c",
      "text": "  跟我一起去尋找更多盟友吧。",
      "encoded_ascii": "  ^.+^$%^!%^.(^\"6^#9^$/^$o^\"x^-0^\"8^*I^!\"",
      "encoded_base64": "ICBeLiteJCVeISVeLiheIjZeIzleJC9eJG9eInheLTBeIjheKkleISI=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_129eff89179f",
      "text": "  算了。我才不想要你們當盟友。",
      "encoded_ascii": "  ^-C^*D^!\"^$%^$,^!)^,1^(C^*F^*{^&N^-0^\"8^!\"",
      "encoded_base64": "ICBeLUNeKkReISJeJCVeJCxeISleLDFeKENeKkZeKnteJk5eLTBeIjheISI=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_1a1cb8240328",
      "text": "我們至少欠你們這份恩情——我們會加入你們的志業。我們該去哪裡 ",
      "encoded_ascii": "^$%^*{^'n^#<^,g^*F^*{^(s^*x^#v^,0^*n^*n^$%^*{^$r^\"\"^!f^*F^*{^&Z^#m^%5^!\"^$%^*{^(M^\"6^+I^-j ",
      "encoded_base64": "XiQlXip7XiduXiM8XixnXipGXip7XihzXip4XiN2XiwwXipuXipuXiQlXip7XiRyXiIiXiFmXipGXip7XiZaXiNtXiU1XiEiXiQlXip7XihNXiI2XitJXi1qIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_153a80f7b9d8",
      "text": "與聯盟中的其他人會合？",
      "encoded_ascii": "^'p^-V^-0^!,^&Z^!j^!@^!<^$r^\"C^.V",
      "encoded_base64": "XidwXi1WXi0wXiEsXiZaXiFqXiFAXiE8XiRyXiJDXi5W",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_df8a816d7aba",
      "text": "再見。",
      "encoded_ascii": "^!l^-m^!\"",
      "encoded_base64": "XiFsXi1tXiEi",
      "byte_length": 9
    },
    {
      "unit_id": "DLG_e0ba64de18a8",
      "text": "我們太虛弱、太疲憊了，幫不上你們什麼忙。我們最好留在後面。",
      "encoded_ascii": "^$%^*{^+f^-g^#\\^!!^+f^88^84^*D^*A^+}^!)^!'^*F^*{^!=^.T^,+^!\"^$%^*{^$q^+i^-+^\"d^#b^)j^!\"",
      "encoded_base64": "XiQlXip7XitmXi1nXiNcXiEhXitmXjg4Xjg0XipEXipBXit9XiEpXiEnXipGXip7XiE9Xi5UXiwrXiEiXiQlXip7XiRxXitpXi0rXiJkXiNiXilqXiEi",
      "byte_length": 87
    },
    {
      "unit_id": "DLG_dc25a331b34d",
      "text": "我們會直接去那裡。祝你們順利找到更多盟友。",
      "encoded_ascii": "^$%^*{^$r^&`^$?^\"6^)!^-j^!\"^&v^*F^*{^.D^!t^$/^!u^$o^\"x^-0^\"8^!\"",
      "encoded_base64": "XiQlXip7XiRyXiZgXiQ/XiI2XikhXi1qXiEiXiZ2XipGXip7Xi5EXiF0XiQvXiF1XiRvXiJ4Xi0wXiI4XiEi",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_b02019898820",
      "text": "那我們要在追兵被派來搜捕我們之前離開這裡了。",
      "encoded_ascii": "^)!^$%^*{^(C^\"d^(o^+,^(@^.n^!O^/h^4?^$%^*{^!/^!z^)`^)F^(s^-j^*D^!\"",
      "encoded_base64": "XikhXiQlXip7XihDXiJkXihvXissXihAXi5uXiFPXi9oXjQ/XiQlXip7XiEvXiF6XilgXilGXihzXi1qXipEXiEi",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_0796b445b789",
      "text": "廢墟就在正前方。跟我來，去消滅 ",
      "encoded_ascii": "^#W^\"t^*J^\"d^%H^!z^$]^!\"^.+^$%^!O^*A^\"6^%k^%t ",
      "encoded_base64": "XiNXXiJ0XipKXiJkXiVIXiF6XiRdXiEiXi4rXiQlXiFPXipBXiI2XiVrXiV0IA==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_d90e74932b0c",
      "text": "那些神靈。",
      "encoded_ascii": "^)!^!8^&w^)g^!\"",
      "encoded_base64": "XikhXiE4XiZ3XilnXiEi",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_e67ff8fcb511",
      "text": "消滅那些神靈，然後回來！ ",
      "encoded_ascii": "^%k^%t^)!^!8^&w^)g^*A^&\"^#b^\"\\^!O^*W ",
      "encoded_base64": "XiVrXiV0XikhXiE4XiZ3XilnXipBXiYiXiNiXiJcXiFPXipXIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_87f93a0a1764",
      "text": "我是碎牙部族的薩滿。你們為何來此？",
      "encoded_ascii": "^$%^,X^&o^&3^)#^5V^&Z^-e^,{^!\"^*F^*{^%{^!L^!O^%I^.V",
      "encoded_base64": "XiQlXixYXiZvXiYzXikjXjVWXiZaXi1lXix7XiEiXipGXip7XiV7XiFMXiFPXiVJXi5W",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_2e7d64648982",
      "text": "  我想要廢墟裡的寶藏。",
      "encoded_ascii": "  ^$%^,1^(C^#W^\"t^-j^&Z^#4^-f^!\"",
      "encoded_base64": "ICBeJCVeLDFeKENeI1deInReLWpeJlpeIzReLWZeISI=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_26d04b8245c2",
      "text": "  你為什麼不在你們村子裡？",
      "encoded_ascii": "  ^*F^%{^!=^.T^!)^\"d^*F^*{^$z^#(^-j^.V",
      "encoded_base64": "ICBeKkZeJXteIT1eLlReISleImReKkZeKnteJHpeIyheLWpeLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_8d6a937ad7b7",
      "text": "  我是來消滅那些古老神靈的。",
      "encoded_ascii": "  ^$%^,X^!O^%k^%t^)!^!8^\"=^'U^&w^)g^&Z^!\"",
      "encoded_base64": "ICBeJCVeLFheIU9eJWteJXReKSFeITheIj1eJ1VeJndeKWdeJlpeISI=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_4aac6052d961",
      "text": "  為什麼廢墟裡會有神靈？",
      "encoded_ascii": "  ^%{^!=^.T^#W^\"t^-j^$r^$s^&w^)g^.V",
      "encoded_base64": "ICBeJXteIT1eLlReI1deInReLWpeJHJeJHNeJndeKWdeLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_694188ba39b7",
      "text": "  你們為什麼不自己消滅那些神靈？",
      "encoded_ascii": "  ^*F^*{^%{^!=^.T^!)^'l^#I^%k^%t^)!^!8^&w^)g^.V",
      "encoded_base64": "ICBeKkZeKnteJXteIT1eLlReISleJ2xeI0leJWteJXReKSFeITheJndeKWdeLlY=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_1ebbae449577",
      "text": "  那真是個愚蠢的迷信。",
      "encoded_ascii": "  ^)!^-2^,X^!V^/a^.u^&Z^(n^!U^!\"",
      "encoded_base64": "ICBeKSFeLTJeLFheIVZeL2FeLnVeJlpeKG5eIVVeISI=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_5d752107e447",
      "text": "神靈本該供我們請教與庇護。我們隱藏在廢墟中的 ",
      "encoded_ascii": "^&w^)g^$x^(M^!P^$%^*{^*S^,R^'p^,\"^(T^!\"^$%^*{^)Y^-f^\"d^#W^\"t^!,^&Z ",
      "encoded_base64": "XiZ3XilnXiR4XihNXiFQXiQlXip7XipTXixSXidwXiwiXihUXiEiXiQlXip7XilZXi1mXiJkXiNXXiJ0XiEsXiZaIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_bfb252d49ede",
      "text": "聖物寶藏，過去也同樣受到神靈庇護。如今，他們辜負了我們。 ",
      "encoded_ascii": "^'Z^&4^#4^-f^*A^(x^\"6^!1^\"E^,f^\";^!u^&w^)g^,\"^(T^!\"^#$^*E^*A^!@^*{^66^(W^*D^$%^*{^!\" ",
      "encoded_base64": "XidaXiY0XiM0Xi1mXipBXih4XiI2XiExXiJFXixmXiI7XiF1XiZ3XilnXiwiXihUXiEiXiMkXipFXipBXiFAXip7XjY2XihXXipEXiQlXip7XiEiIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_bb435c1565f1",
      "text": "他們必須被消滅。 ",
      "encoded_ascii": "^!@^*{^#l^)r^(@^%k^%t^!\" ",
      "encoded_base64": "XiFAXip7XiNsXilyXihAXiVrXiV0XiEiIA==",
      "byte_length": 25
    },
    {
      "unit_id": "DLG_88d682da75ef",
      "text": "廢墟是神聖的！這種不敬的念頭會要了你們的命！",
      "encoded_ascii": "^#W^\"t^,X^&w^'Z^&Z^*W^(s^'$^!)^*O^&Z^1z^)t^$r^(C^*D^*F^*{^&Z^\"N^*W",
      "encoded_base64": "XiNXXiJ0XixYXiZ3XidaXiZaXipXXihzXickXiEpXipPXiZaXjF6Xil0XiRyXihDXipEXipGXip7XiZaXiJOXipX",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_cfd907ce3c33",
      "text": "我們的神靈辜負了我們。城邦軍隊蹂躪我們的村落，莊稼枯萎， ",
      "encoded_ascii": "^$%^*{^&Z^&w^)g^66^(W^*D^$%^*{^!\"^+_^1a^..^)U^=x^=y^$%^*{^&Z^$z^-`^*A^6l^9a^5Z^<D^*A ",
      "encoded_base64": "XiQlXip7XiZaXiZ3XilnXjY2XihXXipEXiQlXip7XiEiXitfXjFhXi4uXilVXj14Xj15XiQlXip7XiZaXiR6Xi1gXipBXjZsXjlhXjVaXjxEXipBIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_1cd58f38ffd9",
      "text": "凶兆頻現。預言提及將有異鄉旅者到來，消滅廢墟裡的 ",
      "encoded_ascii": "^3e^5/^=z^&?^!\"^.E^1Y^$A^\"7^#7^$s^&M^6<^2m^'V^!u^!O^*A^%k^%t^#W^\"t^-j^&Z ",
      "encoded_base64": "XjNlXjUvXj16XiY/XiEiXi5FXjFZXiRBXiI3XiM3XiRzXiZNXjY8XjJtXidWXiF1XiFPXipBXiVrXiV0XiNXXiJ0Xi1qXiZaIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_0e8884f9af76",
      "text": "古老神靈。我一直在等待那些旅者的到來。 ",
      "encoded_ascii": "^\"=^'U^&w^)g^!\"^$%^!%^&`^\"d^'-^,*^)!^!8^2m^'V^&Z^!u^!O^!\" ",
      "encoded_base64": "XiI9XidVXiZ3XilnXiEiXiQlXiElXiZgXiJkXictXiwqXikhXiE4XjJtXidWXiZaXiF1XiFPXiEiIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_fe303b7b8306",
      "text": "預言終於應驗了！來吧，我會帶你們去廢墟，讓你們 ",
      "encoded_ascii": "^.E^1Y^-H^$^^0`^.P^*D^*W^!O^*I^*A^$%^$r^#N^*F^*{^\"6^#W^\"t^*A^-}^*F^*{ ",
      "encoded_base64": "Xi5FXjFZXi1IXiReXjBgXi5QXipEXipXXiFPXipJXipBXiQlXiRyXiNOXipGXip7XiI2XiNXXiJ0XipBXi19XipGXip7IA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_7ebc4feecb67",
      "text": "得以消滅那些邪惡的神靈。",
      "encoded_ascii": "^#e^!B^%k^%t^)!^!8^)\"^#y^&Z^&w^)g^!\"",
      "encoded_base64": "XiNlXiFCXiVrXiV0XikhXiE4XikiXiN5XiZaXiZ3XilnXiEi",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_60eba80261c5",
      "text": "預言嚴禁我們自行妄動。我們必須等待天選之人被 ",
      "encoded_ascii": "^.E^1Y^1*^&y^$%^*{^'l^(;^+j^\"%^!\"^$%^*{^#l^)r^'-^,*^+e^.6^!/^!<^(@ ",
      "encoded_base64": "Xi5FXjFZXjEqXiZ5XiQlXip7XidsXig7XitqXiIlXiEiXiQlXip7XiNsXilyXictXiwqXitlXi42XiEvXiE8XihAIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_3d2f28a7359a",
      "text": "派來消滅這些神靈，並以善靈取而代之。",
      "encoded_ascii": "^.n^!O^%k^%t^(s^!8^&w^)g^*A^!+^!B^1(^)g^\":^'W^*v^!/^!\"",
      "encoded_base64": "Xi5uXiFPXiVrXiV0XihzXiE4XiZ3XilnXipBXiErXiFCXjEoXilnXiI6XidXXip2XiEvXiEi",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_2295c69c8553",
      "text": "異端！你竟敢嘲笑我們神聖的信仰？！ ",
      "encoded_ascii": "^&M^5o^*W^*F^28^/m^+Z^-@^$%^*{^&w^'Z^&Z^!U^4,^.V^*W ",
      "encoded_base64": "XiZNXjVvXipXXipGXjI4Xi9tXitaXi1AXiQlXip7XiZ3XidaXiZaXiFVXjQsXi5WXipXIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_3cc673d9fbf1",
      "text": "你們現在必須進入並消滅那些古老神靈。這是預言所注定的！",
      "encoded_ascii": "^*F^*{^&?^\"d^#l^)r^(w^!f^!+^%k^%t^)!^!8^\"=^'U^&w^)g^!\"^(s^,X^.E^1Y^$)^%e^#.^&Z^*W",
      "encoded_base64": "XipGXip7XiY/XiJkXiNsXilyXih3XiFmXiErXiVrXiV0XikhXiE4XiI9XidVXiZ3XilnXiEiXihzXixYXi5FXjFZXiQpXiVlXiMuXiZaXipX",
      "byte_length": 81
    },
    {
      "unit_id": "DLG_06157337633a",
      "text": "哼！你們不肯跟來！很顯然你們根本不是來消滅神靈的！ ",
      "encoded_ascii": "^+K^*W^*F^*{^!)^-Z^.+^!O^*W^*K^4&^&\"^*F^*{^%)^$x^!)^,X^!O^%k^%t^&w^)g^&Z^*W ",
      "encoded_base64": "XitLXipXXipGXip7XiEpXi1aXi4rXiFPXipXXipLXjQmXiYiXipGXip7XiUpXiR4XiEpXixYXiFPXiVrXiV0XiZ3XilnXiZaXipXIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_90c314d298e7",
      "text": "你們必須被毀滅！ ",
      "encoded_ascii": "^*F^*{^#l^)r^(@^%N^%t^*W ",
      "encoded_base64": "XipGXip7XiNsXilyXihAXiVOXiV0XipXIA==",
      "byte_length": 25
    },
    {
      "unit_id": "DLG_0aadc03a1a4e",
      "text": "預言已化為傳奇！舊神靈辜負了我們，而你們 ",
      "encoded_ascii": "^.E^1Y^#J^\")^%{^+$^\"}^*W^02^&w^)g^66^(W^*D^$%^*{^*A^'W^*F^*{ ",
      "encoded_base64": "Xi5FXjFZXiNKXiIpXiV7XiskXiJ9XipXXjAyXiZ3XilnXjY2XihXXipEXiQlXip7XipBXidXXipGXip7IA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_228cce895939",
      "text": "消滅了他們。你們的英靈將取代他們，我們將永遠 ",
      "encoded_ascii": "^%k^%t^*D^!@^*{^!\"^*F^*{^&Z^'y^)g^#7^\":^*v^!@^*{^*A^$%^*{^#7^%W^({ ",
      "encoded_base64": "XiVrXiV0XipEXiFAXip7XiEiXipGXip7XiZaXid5XilnXiM3XiI6Xip2XiFAXip7XipBXiQlXip7XiM3XiVXXih7IA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_8e36b4281e31",
      "text": "尊奉你們。 ",
      "encoded_ascii": "^+u^1+^*F^*{^!\" ",
      "encoded_base64": "Xit1XjErXipGXip7XiEiIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_f50096c3bfb5",
      "text": "只有不配之人臨陣退縮逃離神靈。你們根本不是預言中的 ",
      "encoded_ascii": "^\"?^$s^!)^)&^!/^!<^1U^)P^*V^3X^(p^)`^&w^)g^!\"^*F^*{^%)^$x^!)^,X^.E^1Y^!,^&Z ",
      "encoded_base64": "XiI/XiRzXiEpXikmXiEvXiE8XjFVXilQXipWXjNYXihwXilgXiZ3XilnXiEiXipGXip7XiUpXiR4XiEpXixYXi5FXjFZXiEsXiZaIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_f51f3b8641ab",
      "text": "天選之人！既然你們見過了我們的神靈，就必須受死！ ",
      "encoded_ascii": "^+e^.6^!/^!<^*W^,U^&\"^*F^*{^-m^(x^*D^$%^*{^&Z^&w^)g^*A^*J^#l^)r^\";^%L^*W ",
      "encoded_base64": "XitlXi42XiEvXiE8XipXXixVXiYiXipGXip7Xi1tXih4XipEXiQlXip7XiZaXiZ3XilnXipBXipKXiNsXilyXiI7XiVMXipXIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_e7fc8f0a394b",
      "text": "你想要離開城堡嗎？",
      "encoded_ascii": "^*F^,1^(C^)`^)F^+_^\"m^+X^.V",
      "encoded_base64": "XipGXiwxXihDXilgXilGXitfXiJtXitYXi5W",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_404ea3745411",
      "text": "你想要上樓嗎？",
      "encoded_ascii": "^*F^,1^(C^!'^0g^+X^.V",
      "encoded_base64": "XipGXiwxXihDXiEnXjBnXitYXi5W",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_8e9d67b541d7",
      "text": "我會試著在樓下拖住衛兵…… ",
      "encoded_ascii": "^$%^$r^-u^-a^\"d^0g^!(^.f^*z^(=^+,^*o^*o ",
      "encoded_base64": "XiQlXiRyXi11Xi1hXiJkXjBnXiEoXi5mXip6Xig9XissXipvXipvIA==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_e687e545b03a",
      "text": "趁著你們在樓上的時候。",
      "encoded_ascii": "^.)^-a^*F^*{^\"d^0g^!'^&Z^$f^*|^!\"",
      "encoded_base64": "Xi4pXi1hXipGXip7XiJkXjBnXiEnXiZaXiRmXip8XiEi",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_8672587a9628",
      "text": " 我只是很遺憾那些雙足飛龍不得不被殺死。",
      "encoded_ascii": " ^$%^\"?^,X^*K^0v^0_^)!^!8^)_^(^^)z^*>^!)^#e^!)^(@^%M^%L^!\"",
      "encoded_base64": "IF4kJV4iP14sWF4qS14wdl4wX14pIV4hOF4pX14oXl4pel4qPl4hKV4jZV4hKV4oQF4lTV4lTF4hIg==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_ec76c80cecf8",
      "text": "好讓你們能夠脫身逃走。",
      "encoded_ascii": "^+i^-}^*F^*{^'b^+d^'c^(c^(p^.&^!\"",
      "encoded_base64": "XitpXi19XipGXip7XidiXitkXidjXihjXihwXi4mXiEi",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_fb425afdb533",
      "text": " 祝好運！",
      "encoded_ascii": " ^&v^+i^.4^*W",
      "encoded_base64": "IF4mdl4raV4uNF4qVw==",
      "byte_length": 13
    },
    {
      "unit_id": "DLG_e123d4c97a20",
      "text": " 多謝你也幫我弄了一隻雙足飛龍！我會確保…… ",
      "encoded_ascii": " ^\"x^-z^*F^!1^+}^$%^/`^*D^!%^)[^)_^(^^)z^*>^*W^$%^$r^-6^!T^*o^*o ",
      "encoded_base64": "IF4ieF4tel4qRl4hMV4rfV4kJV4vYF4qRF4hJV4pW14pX14oXl4pel4qPl4qV14kJV4kcl4tNl4hVF4qb14qbyA=",
      "byte_length": 65
    },
    {
      "unit_id": "DLG_00a5275d047c",
      "text": "牠們全都被釋放出來。",
      "encoded_ascii": "^-#^*{^!h^)$^(@^0w^$P^!q^!O^!\"",
      "encoded_base64": "Xi0jXip7XiFoXikkXihAXjB3XiRQXiFxXiFPXiEi",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_72d98e1bc2e8",
      "text": "你想要下樓嗎？",
      "encoded_ascii": "^*F^,1^(C^!(^0g^+X^.V",
      "encoded_base64": "XipGXiwxXihDXiEoXjBnXitYXi5W",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_dc6856a35828",
      "text": "快點走！",
      "encoded_ascii": "^*L^*;^.&^*W",
      "encoded_base64": "XipMXio7Xi4mXipX",
      "byte_length": 12
    },
    {
      "unit_id": "DLG_a1c87aa04385",
      "text": "你們可以過去了。",
      "encoded_ascii": "^*F^*{^\"A^!B^(x^\"6^*D^!\"",
      "encoded_base64": "XipGXip7XiJBXiFCXih4XiI2XipEXiEi",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_c17190a18441",
      "text": "你們在這裡做什麼？陌生人禁止擅入此地。 ",
      "encoded_ascii": "^*F^*{^\"d^(s^-j^*~^!=^.T^.V^9z^&F^!<^&y^%G^2$^!f^%I^\"e^!\" ",
      "encoded_base64": "XipGXip7XiJkXihzXi1qXip+XiE9Xi5UXi5WXjl6XiZGXiE8XiZ5XiVHXjIkXiFmXiVJXiJlXiEiIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_d47c09a471bf",
      "text": "  主營地在哪裡？",
      "encoded_ascii": "  ^!-^&'^\"e^\"d^+I^-j^.V",
      "encoded_base64": "ICBeIS1eJideImVeImReK0leLWpeLlY=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_59e0053db87d",
      "text": "  我是來見你們首領的。",
      "encoded_ascii": "  ^$%^,X^!O^-m^*F^*{^)~^)s^&Z^!\"",
      "encoded_base64": "ICBeJCVeLFheIU9eLW1eKkZeKnteKX5eKXNeJlpeISI=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_9ba6c2b7e392",
      "text": "  我必須見你們首領。你能幫忙嗎？",
      "encoded_ascii": "  ^$%^#l^)r^-m^*F^*{^)~^)s^!\"^*F^'b^+}^,+^+X^.V",
      "encoded_base64": "ICBeJCVeI2xeKXJeLW1eKkZeKnteKX5eKXNeISJeKkZeJ2JeK31eLCteK1heLlY=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_15112b819d3b",
      "text": "  我奉命不得向任何人透露。",
      "encoded_ascii": "  ^$%^1+^\"N^!)^#e^+?^!C^!L^!<^(q^.B^!\"",
      "encoded_base64": "ICBeJCVeMSteIk5eISleI2VeKz9eIUNeIUxeITxeKHFeLkJeISI=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_f872ed72e632",
      "text": "  我想問幾個問題。放我們走。",
      "encoded_ascii": "  ^$%^,1^*Z^#T^!V^*Z^.G^!\"^$P^$%^*{^.&^!\"",
      "encoded_base64": "ICBeJCVeLDFeKlpeI1ReIVZeKlpeLkdeISJeJFBeJCVeKnteLiZeISI=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_26ba6503e352",
      "text": "  抱歉，我這就離開。",
      "encoded_ascii": "  ^,@^,h^*A^$%^(s^*J^)`^)F^!\"",
      "encoded_base64": "ICBeLEBeLGheKkFeJCVeKHNeKkpeKWBeKUZeISI=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_56dd33bb1fb8",
      "text": "  好吧。把你們首領找來，他會把事情解釋清楚的。",
      "encoded_ascii": "  ^+i^*I^!\"^$1^*F^*{^)~^)s^$/^!O^*A^!@^$r^$1^*r^,0^(I^0w^,u^,c^&Z^!\"",
      "encoded_base64": "ICBeK2leKkleISJeJDFeKkZeKnteKX5eKXNeJC9eIU9eKkFeIUBeJHJeJDFeKnJeLDBeKEleMHdeLHVeLGNeJlpeISI=",
      "byte_length": 68
    },
    {
      "unit_id": "DLG_93ab3f4026fd",
      "text": "  我誰也不服從！",
      "encoded_ascii": "  ^$%^-y^!1^!)^,\\^#f^*W",
      "encoded_base64": "ICBeJCVeLXleITFeISleLFxeI2ZeKlc=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_66d32805a585",
      "text": "你們去主營地想幹什麼？ ",
      "encoded_ascii": "^*F^*{^\"6^!-^&'^\"e^,1^,!^!=^.T^.V ",
      "encoded_base64": "XipGXip7XiI2XiEtXiYnXiJlXiwxXiwhXiE9Xi5UXi5WIA==",
      "byte_length": 34
    },
    {
      "unit_id": "DLG_ddba68dad492",
      "text": "你們找他有什麼事？ ",
      "encoded_ascii": "^*F^*{^$/^!@^$s^!=^.T^*r^.V ",
      "encoded_base64": "XipGXip7XiQvXiFAXiRzXiE9Xi5UXipyXi5WIA==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_b8865b31ec90",
      "text": "放下你們的隨身物品，給我進這個欄裡！你們哪裡也 ",
      "encoded_ascii": "^$P^!(^*F^*{^&Z^)X^(c^&4^\"R^*A^'A^$%^(w^(s^!V^%C^-j^*W^*F^*{^+I^-j^!1 ",
      "encoded_base64": "XiRQXiEoXipGXip7XiZaXilYXihjXiY0XiJSXipBXidBXiQlXih3XihzXiFWXiVDXi1qXipXXipGXip7XitJXi1qXiExIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_abf6d37feae8",
      "text": "別想去！ ",
      "encoded_ascii": "^*H^,1^\"6^*W ",
      "encoded_base64": "XipIXiwxXiI2XipXIA==",
      "byte_length": 13
    },
    {
      "unit_id": "DLG_b17878465f13",
      "text": "你們很快就會見到我們首領了——等他親自來給你們烙印的時候！ ",
      "encoded_ascii": "^*F^*{^*K^*L^*J^$r^-m^!u^$%^*{^)~^)s^*D^*n^*n^'-^!@^(F^'l^!O^'A^*F^*{^7>^1%^&Z^$f^*|^*W ",
      "encoded_base64": "XipGXip7XipLXipMXipKXiRyXi1tXiF1XiQlXip7Xil+XilzXipEXipuXipuXictXiFAXihGXidsXiFPXidBXipGXip7Xjc+XjElXiZaXiRmXip8XipXIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_cbb7ee74651c",
      "text": "廢話少說！放下你們的隨身物品，給我進欄裡去。立刻！ ",
      "encoded_ascii": "^#W^-v^#<^-x^*W^$P^!(^*F^*{^&Z^)X^(c^&4^\"R^*A^'A^$%^(w^%C^-j^\"6^!\"^0'^.Y^*W ",
      "encoded_base64": "XiNXXi12XiM8Xi14XipXXiRQXiEoXipGXip7XiZaXilYXihjXiY0XiJSXipBXidBXiQlXih3XiVDXi1qXiI2XiEiXjAnXi5ZXipXIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_009b8771f36e",
      "text": "唔……好吧，快走。別再到處亂晃了。 ",
      "encoded_ascii": "^+N^*o^*o^+i^*I^*A^*L^.&^!\"^*H^!l^!u^(,^!3^=:^*D^!\" ",
      "encoded_base64": "XitOXipvXipvXitpXipJXipBXipMXi4mXiEiXipIXiFsXiF1XigsXiEzXj06XipEXiEiIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_9b157ccb5146",
      "text": "立刻放下你們的裝備，奴隸們！ ",
      "encoded_ascii": "^0'^.Y^$P^!(^*F^*{^&Z^(A^+\"^*A^##^)Z^*{^*W ",
      "encoded_base64": "XjAnXi5ZXiRQXiEoXipGXip7XiZaXihBXisiXipBXiMjXilaXip7XipXIA==",
      "byte_length": 43
    },
    {
      "unit_id": "DLG_9b45984e1d4e",
      "text": "  好吧，我們放下裝備。",
      "encoded_ascii": "  ^+i^*I^*A^$%^*{^$P^!(^(A^+\"^!\"",
      "encoded_base64": "ICBeK2leKkleKkFeJCVeKnteJFBeISheKEFeKyJeISI=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_25232a1e8faf",
      "text": "  做夢！我們可不是你們的奴隸！ ",
      "encoded_ascii": "  ^*~^\"y^*W^$%^*{^\"A^!)^,X^*F^*{^&Z^##^)Z^*W ",
      "encoded_base64": "ICBeKn5eInleKldeJCVeKnteIkFeISleLFheKkZeKnteJlpeIyNeKVpeKlcg",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_e9d43567bb5b",
      "text": "  蠢貨！我說過我們不是任何人的奴隸！",
      "encoded_ascii": "  ^.u^.w^*W^$%^-x^(x^$%^*{^!)^,X^!C^!L^!<^&Z^##^)Z^*W",
      "encoded_base64": "ICBeLnVeLndeKldeJCVeLXheKHheJCVeKnteISleLFheIUNeIUxeITxeJlpeIyNeKVpeKlc=",
      "byte_length": 53
    },
    {
      "unit_id": "DLG_f6f19667035c",
      "text": "你以為不是嗎？ ",
      "encoded_ascii": "^*F^!B^%{^!)^,X^+X^.V ",
      "encoded_base64": "XipGXiFCXiV7XiEpXixYXitYXi5WIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_a0b8cb2f0ee6",
      "text": "你們就是！衛兵！ ",
      "encoded_ascii": "^*F^*{^*J^,X^*W^(=^+,^*W ",
      "encoded_base64": "XipGXip7XipKXixYXipXXig9XissXipXIA==",
      "byte_length": 25
    },
    {
      "unit_id": "DLG_109a92fa5729",
      "text": "好吧，多謝你們出手相助，但我得走了。不用替我擔心—— ",
      "encoded_ascii": "^+i^*I^*A^\"x^-z^*F^*{^!q^$+^&a^\"#^*A^!I^$%^#e^.&^*D^!\"^!)^&H^2o^$%^*N^#k^*n^*n ",
      "encoded_base64": "XitpXipJXipBXiJ4Xi16XipGXip7XiFxXiQrXiZhXiIjXipBXiFJXiQlXiNlXi4mXipEXiEiXiEpXiZIXjJvXiQlXipOXiNrXipuXipuIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_8f3637f85ed7",
      "text": "對付任何怪物我都不在話下。我本想給你們幾條在荒野中求生的建議， ",
      "encoded_ascii": "^#:^*u^!C^!L^#s^&4^$%^)$^!)^\"d^-v^!(^!\"^$%^$x^,1^'A^*F^*{^#T^%.^\"d^1W^.:^!,^,n^&F^&Z^,'^-|^*A ",
      "encoded_base64": "XiM6Xip1XiFDXiFMXiNzXiY0XiQlXikkXiEpXiJkXi12XiEoXiEiXiQlXiR4XiwxXidBXipGXip7XiNUXiUuXiJkXjFXXi46XiEsXixuXiZGXiZaXiwnXi18XipBIA==",
      "byte_length": 94
    },
    {
      "unit_id": "DLG_967a46b680c4",
      "text": "但恐怕對你們這群野蠻人來說太專業了。祝好運。 ",
      "encoded_ascii": "^!I^#t^0^^#:^*F^*{^(s^'R^.:^/H^!<^!O^-x^+f^#8^%5^*D^!\"^&v^+i^.4^!\" ",
      "encoded_base64": "XiFJXiN0XjBeXiM6XipGXip7XihzXidSXi46Xi9IXiE8XiFPXi14XitmXiM4XiU1XipEXiEiXiZ2XitpXi40XiEiIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_2f28d4f5d1c9",
      "text": "嘿！沙子動了！ ",
      "encoded_ascii": "^+\\^*W^%]^#(^\"%^*D^*W ",
      "encoded_base64": "XitcXipXXiVdXiMoXiIlXipEXipXIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_61533c9e0cf5",
      "text": "你聽見遠處傳來一聲慘叫，某個倒楣的農奴被一口活吞了下去。 ",
      "encoded_ascii": "^*F^-X^-m^({^(,^+$^!O^!%^-W^,4^+<^*A^%$^!V^!X^/r^&Z^4i^##^(@^!%^\"<^%i^:-^*D^!(^\"6^!\" ",
      "encoded_base64": "XipGXi1YXi1tXih7XigsXiskXiFPXiElXi1XXiw0Xis8XipBXiUkXiFWXiFYXi9yXiZaXjRpXiMjXihAXiElXiI8XiVpXjotXipEXiEoXiI2XiEiIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_2545876bffd8",
      "text": "過去吧，但直接去主營地。",
      "encoded_ascii": "^(x^\"6^*I^*A^!I^&`^$?^\"6^!-^&'^\"e^!\"",
      "encoded_base64": "Xih4XiI2XipJXipBXiFJXiZgXiQ/XiI2XiEtXiYnXiJlXiEi",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_dd2ac4021b97",
      "text": "那邊那個！你在這裡做什麼？",
      "encoded_ascii": "^)!^.8^)!^!V^*W^*F^\"d^(s^-j^*~^!=^.T^.V",
      "encoded_base64": "XikhXi44XikhXiFWXipXXipGXiJkXihzXi1qXip+XiE9Xi5UXi5W",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_92964d270081",
      "text": "  我需要和你們首領談談。",
      "encoded_ascii": "  ^$%^)e^(C^\"O^*F^*{^)~^)s^0;^0;^!\"",
      "encoded_base64": "ICBeJCVeKWVeKENeIk9eKkZeKnteKX5eKXNeMDteMDteISI=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_a4545b3e7170",
      "text": "  我是一名角鬥士，特來求見你們首領。",
      "encoded_ascii": "  ^$%^,X^!%^\"F^(H^*,^+a^*A^&5^!O^,n^-m^*F^*{^)~^)s^!\"",
      "encoded_base64": "ICBeJCVeLFheISVeIkZeKEheKixeK2FeKkFeJjVeIU9eLG5eLW1eKkZeKnteKX5eKXNeISI=",
      "byte_length": 53
    },
    {
      "unit_id": "DLG_ba014f12b5b5",
      "text": "  那不關你的事！讓開！",
      "encoded_ascii": "  ^)!^!)^.>^*F^&Z^*r^*W^-}^)F^*W",
      "encoded_base64": "ICBeKSFeISleLj5eKkZeJlpeKnJeKldeLX1eKUZeKlc=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_ab48422e9eb6",
      "text": "  你們首領會知道這件事的！讓開！",
      "encoded_ascii": "  ^*F^*{^)~^)s^$r^&h^(y^(s^.W^*r^&Z^*W^-}^)F^*W",
      "encoded_base64": "ICBeKkZeKnteKX5eKXNeJHJeJmheKHleKHNeLldeKnJeJlpeKldeLX1eKUZeKlc=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_0338854240f4",
      "text": "沒事了。再見。",
      "encoded_ascii": "^%\\^*r^*D^!\"^!l^-m^!\"",
      "encoded_base64": "XiVcXipyXipEXiEiXiFsXi1tXiEi",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_5be0bb96863e",
      "text": "是嗎？你是誰？",
      "encoded_ascii": "^,X^+X^.V^*F^,X^-y^.V",
      "encoded_base64": "XixYXitYXi5WXipGXixYXi15Xi5W",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_a448ae9bf744",
      "text": "這裡發生的每件事都關我們的事，賤民。你在這裡 ",
      "encoded_ascii": "^(s^-j^&W^&F^&Z^%P^.W^*r^)$^.>^$%^*{^&Z^*r^*A^2G^%T^!\"^*F^\"d^(s^-j ",
      "encoded_base64": "XihzXi1qXiZXXiZGXiZaXiVQXi5XXipyXikkXi4+XiQlXip7XiZaXipyXipBXjJHXiVUXiEiXipGXiJkXihzXi1qIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_18fc1daf22e1",
      "text": "幹什麼？",
      "encoded_ascii": "^,!^!=^.T^.V",
      "encoded_base64": "XiwhXiE9Xi5UXi5W",
      "byte_length": 12
    },
    {
      "unit_id": "DLG_4717c36b9954",
      "text": "要是想活命，下次就離這裡遠點。",
      "encoded_ascii": "^(C^,X^,1^%i^\"N^*A^!(^%D^*J^)`^(s^-j^({^*;^!\"",
      "encoded_base64": "XihDXixYXiwxXiVpXiJOXipBXiEoXiVEXipKXilgXihzXi1qXih7Xio7XiEi",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_3e51cde11fe4",
      "text": "行。會有人帶你去見他的。衛兵！ ",
      "encoded_ascii": "^(;^!\"^$r^$s^!<^#N^*F^\"6^-m^!@^&Z^!\"^(=^+,^*W ",
      "encoded_base64": "Xig7XiEiXiRyXiRzXiE8XiNOXipGXiI2Xi1tXiFAXiZaXiEiXig9XissXipXIA==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_140fe874f845",
      "text": "那就去吧。但直接去主營地，別到處瞎窺探。",
      "encoded_ascii": "^)!^*J^\"6^*I^!\"^!I^&`^$?^\"6^!-^&'^\"e^*A^*H^!u^(,^2}^6f^$>^!\"",
      "encoded_base64": "XikhXipKXiI2XipJXiEiXiFJXiZgXiQ/XiI2XiEtXiYnXiJlXipBXipIXiF1XigsXjJ9XjZmXiQ+XiEi",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_9f8f024a3b43",
      "text": "營地有入侵者！抓住他們！ ",
      "encoded_ascii": "^&'^\"e^$s^!f^.X^'V^*W^$2^*z^!@^*{^*W ",
      "encoded_base64": "XiYnXiJlXiRzXiFmXi5YXidWXipXXiQyXip6XiFAXip7XipXIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_1738fe4b8b53",
      "text": "我們快走吧！我們浪費的時間夠多了！",
      "encoded_ascii": "^$%^*{^*L^.&^*I^*W^$%^*{^,r^.\"^&Z^$f^)G^+d^\"x^*D^*W",
      "encoded_base64": "XiQlXip7XipMXi4mXipJXipXXiQlXip7XixyXi4iXiZaXiRmXilHXitkXiJ4XipEXipX",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_c5e397960144",
      "text": "別擔心，那個奴隸很好對付。這趟差事會很輕鬆。 ",
      "encoded_ascii": "^*H^*N^#k^*A^)!^!V^##^)Z^*K^+i^#:^*u^!\"^(s^8)^48^*r^$r^*K^(g^.R^!\" ",
      "encoded_base64": "XipIXipOXiNrXipBXikhXiFWXiMjXilaXipLXitpXiM6Xip1XiEiXihzXjgpXjQ4XipyXiRyXipLXihnXi5SXiEiIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_e2bb86f5d3e3",
      "text": "那麼，匕首。我們終於見面了。儘管我們的地盤相鄰， ",
      "encoded_ascii": "^)!^.T^*A^\"(^)~^!\"^$%^*{^-H^$^^-m^)j^*D^!\"^+(^-D^$%^*{^&Z^\"e^1M^&a^)%^*A ",
      "encoded_base64": "XikhXi5UXipBXiIoXil+XiEiXiQlXip7Xi1IXiReXi1tXilqXipEXiEiXisoXi1EXiQlXip7XiZaXiJlXjFNXiZhXiklXipBIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_a2166136ad28",
      "text": "但在今天的買賣交集之前，我們從未謀面。我，白沙亡命之徒首領 ",
      "encoded_ascii": "^!I^\"d^*E^+e^&Z^.!^.$^0P^)]^!/^!z^*A^$%^*{^#f^,_^3~^)j^!\"^$%^*A^&X^%]^!:^\"N^!/^#d^)~^)s ",
      "encoded_base64": "XiFJXiJkXipFXitlXiZaXi4hXi4kXjBQXildXiEvXiF6XipBXiQlXip7XiNmXixfXjN+XilqXiEiXiQlXipBXiZYXiVdXiE6XiJOXiEvXiNkXil+XilzIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_b73a78d983b9",
      "text": "霍托托，向你致意。",
      "encoded_ascii": "^;%^/-^/-^*A^+?^*F^'o^#z^!\"",
      "encoded_base64": "XjslXi8tXi8tXipBXis/XipGXidvXiN6XiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_756ebf616a65",
      "text": "匕首在哪裡， ",
      "encoded_ascii": "^\"(^)~^\"d^+I^-j^*A ",
      "encoded_base64": "XiIoXil+XiJkXitJXi1qXipBIA==",
      "byte_length": 19
    },
    {
      "unit_id": "DLG_8915294d0f8e",
      "text": "蟲子",
      "encoded_ascii": "^(8^#(",
      "encoded_base64": "Xig4XiMo",
      "byte_length": 6
    },
    {
      "unit_id": "DLG_0a21ee83940e",
      "text": "女人",
      "encoded_ascii": "^#\"^!<",
      "encoded_base64": "XiMiXiE8",
      "byte_length": 6
    },
    {
      "unit_id": "DLG_bfc2e78a8f1d",
      "text": "？我還以為他會親自前來參加 ",
      "encoded_ascii": "^.V^$%^.7^!B^%{^!@^$r^(F^'l^!z^!O^6K^\"\" ",
      "encoded_base64": "Xi5WXiQlXi43XiFCXiV7XiFAXiRyXihGXidsXiF6XiFPXjZLXiIiIA==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_ad065221b3bf",
      "text": "他的部族與我——白沙亡命之徒首領霍托托之間的 ",
      "encoded_ascii": "^!@^&Z^)#^5V^'p^$%^*n^*n^&X^%]^!:^\"N^!/^#d^)~^)s^;%^/-^/-^!/^)G^&Z ",
      "encoded_base64": "XiFAXiZaXikjXjVWXidwXiQlXipuXipuXiZYXiVdXiE6XiJOXiEvXiNkXil+XilzXjslXi8tXi8tXiEvXilHXiZaIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_9d37a7bc48d4",
      "text": "首次會面呢！",
      "encoded_ascii": "^)~^%D^$r^)j^+C^*W",
      "encoded_base64": "Xil+XiVEXiRyXilqXitDXipX",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_b4e8873e2441",
      "text": "  你搞錯了。我不是匕首。",
      "encoded_ascii": "  ^*F^:R^)5^*D^!\"^$%^!)^,X^\"(^)~^!\"",
      "encoded_base64": "ICBeKkZeOlJeKTVeKkReISJeJCVeISleLFheIiheKX5eISI=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_3f1ac8438f97",
      "text": "  是的，我們終於見面了，霍托托。你好。",
      "encoded_ascii": "  ^,X^&Z^*A^$%^*{^-H^$^^-m^)j^*D^*A^;%^/-^/-^!\"^*F^+i^!\"",
      "encoded_base64": "ICBeLFheJlpeKkFeJCVeKnteLUheJF5eLW1eKWpeKkReKkFeOyVeLy1eLy1eISJeKkZeK2leISI=",
      "byte_length": 56
    },
    {
      "unit_id": "DLG_8cbaf815c8ee",
      "text": "  你是什麼意思？我可不替匕首賣命。",
      "encoded_ascii": "  ^*F^,X^!=^.T^#z^#q^.V^$%^\"A^!)^2o^\"(^)~^.$^\"N^!\"",
      "encoded_base64": "ICBeKkZeLFheIT1eLlReI3peI3FeLlZeJCVeIkFeISleMm9eIiheKX5eLiReIk5eISI=",
      "byte_length": 50
    },
    {
      "unit_id": "DLG_7f839b37c896",
      "text": "  我是匕首的副官。",
      "encoded_ascii": "  ^$%^,X^\"(^)~^&Z^52^#-^!\"",
      "encoded_base64": "ICBeJCVeLFheIiheKX5eJlpeNTJeIy1eISI=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_7c79dbc9bc9a",
      "text": "  我們是逃出德拉吉的前奴隸。",
      "encoded_ascii": "  ^$%^*{^,X^(p^!q^#j^$6^\"D^&Z^!z^##^)Z^!\"",
      "encoded_base64": "ICBeJCVeKnteLFheKHBeIXFeI2peJDZeIkReJlpeIXpeIyNeKVpeISI=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_9dc3750027cb",
      "text": "  我們是沙漠流浪者。",
      "encoded_ascii": "  ^$%^*{^,X^%]^,}^%j^,r^'V^!\"",
      "encoded_base64": "ICBeJCVeKnteLFheJV1eLH1eJWpeLHJeJ1ZeISI=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_341e82ec2196",
      "text": "再見。",
      "encoded_ascii": "^!l^-m^!\"",
      "encoded_base64": "XiFsXi1tXiEi",
      "byte_length": 9
    },
    {
      "unit_id": "DLG_b2f2c959a55e",
      "text": "那你們是誰？",
      "encoded_ascii": "^)!^*F^*{^,X^-y^.V",
      "encoded_base64": "XikhXipGXip7XixYXi15Xi5W",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_5cfdd79fecdb",
      "text": "我聽說你是個純種人類……但無所謂——真相與傳言之間 ",
      "encoded_ascii": "^$%^-X^-x^*F^,X^!V^3\"^'$^!<^)w^*o^*o^!I^%}^$)^0s^*n^*n^-2^&a^'p^+$^1Y^!/^)G ",
      "encoded_base64": "XiQlXi1YXi14XipGXixYXiFWXjMiXickXiE8Xil3XipvXipvXiFJXiV9XiQpXjBzXipuXipuXi0yXiZhXidwXiskXjFZXiEvXilHIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_96f3538e03ab",
      "text": "往往有所出入。 ",
      "encoded_ascii": "^,)^,)^$s^$)^!q^!f^!\" ",
      "encoded_base64": "XiwpXiwpXiRzXiQpXiFxXiFmXiEiIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_51ece980cf02",
      "text": "我們今天有正經買賣要辦。 ",
      "encoded_ascii": "^$%^*{^*E^+e^$s^%H^'D^.!^.$^(C^2L^!\" ",
      "encoded_base64": "XiQlXip7XipFXitlXiRzXiVIXidEXi4hXi4kXihDXjJMXiEiIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_2b80fcd331c4",
      "text": "這就是那位對我們共同雇主至關重要的奴隸。 ",
      "encoded_ascii": "^(s^*J^,X^)!^!J^#:^$%^*{^3d^\"E^6C^!-^'n^.>^))^(C^&Z^##^)Z^!\" ",
      "encoded_base64": "XihzXipKXixYXikhXiFKXiM6XiQlXip7XjNkXiJFXjZDXiEtXiduXi4+XikpXihDXiZaXiMjXilaXiEiIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_0dedc65b4191",
      "text": "我們已經平安護送他穿越了我們的地界， ",
      "encoded_ascii": "^$%^*{^#J^'D^0Y^+p^(T^./^!@^')^(]^*D^$%^*{^&Z^\"e^.p^*A ",
      "encoded_base64": "XiQlXip7XiNKXidEXjBZXitwXihUXi4vXiFAXicpXihdXipEXiQlXip7XiZaXiJlXi5wXipBIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_39bd4aa85ff6",
      "text": "現在輪到你們護送他穿過你們的地盤了。 ",
      "encoded_ascii": "^&?^\"d^(h^!u^*F^*{^(T^./^!@^')^(x^*F^*{^&Z^\"e^1M^*D^!\" ",
      "encoded_base64": "XiY/XiJkXihoXiF1XipGXip7XihUXi4vXiFAXicpXih4XipGXip7XiZaXiJlXjFNXipEXiEiIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_61cd6bc0a0fc",
      "text": "你們不是？好吧……很遺憾。既然如此，我們就絕不能留你們活口了。",
      "encoded_ascii": "^*F^*{^!)^,X^.V^+i^*I^*o^*o^*K^0v^0_^!\"^,U^&\"^#$^%I^*A^$%^*{^*J^-I^!)^'b^-+^*F^*{^%i^\"<^*D^!\"",
      "encoded_base64": "XipGXip7XiEpXixYXi5WXitpXipJXipvXipvXipLXjB2XjBfXiEiXixVXiYiXiMkXiVJXipBXiQlXip7XipKXi1JXiEpXidiXi0rXipGXip7XiVpXiI8XipEXiEi",
      "byte_length": 93
    },
    {
      "unit_id": "DLG_16a1d123bd9e",
      "text": "轉告匕首，他沒親自來讓我感到受了冒犯。不過，念在我們收到的 ",
      "encoded_ascii": "^(i^+B^\"(^)~^*A^!@^%\\^(F^'l^!O^-}^$%^#{^!u^\";^*D^/P^-%^!\"^!)^(x^*A^1z^\"d^$%^*{^$M^!u^&Z ",
      "encoded_base64": "XihpXitCXiIoXil+XipBXiFAXiVcXihGXidsXiFPXi19XiQlXiN7XiF1XiI7XipEXi9QXi0lXiEiXiEpXih4XipBXjF6XiJkXiQlXip7XiRNXiF1XiZaIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_524c69b168da",
      "text": "報酬很豐厚，何必讓這點不快耽誤了買賣？ ",
      "encoded_ascii": "^+`^7o^*K^4!^\"4^*A^!L^#l^-}^(s^*;^!)^*L^-T^(P^*D^.!^.$^.V ",
      "encoded_base64": "XitgXjdvXipLXjQhXiI0XipBXiFMXiNsXi19XihzXio7XiEpXipMXi1UXihQXipEXi4hXi4kXi5WIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_d5d076731717",
      "text": "你們也是個麻煩。在這次行動期間，絕不能有人目擊我們的 ",
      "encoded_ascii": "^*F^*{^!1^,X^!V^*6^-!^!\"^\"d^(s^%D^(;^\"%^$u^)G^*A^-I^!)^'b^$s^!<^&^^$F^$%^*{^&Z ",
      "encoded_base64": "XipGXip7XiExXixYXiFWXio2Xi0hXiEiXiJkXihzXiVEXig7XiIlXiR1XilHXipBXi1JXiEpXidiXiRzXiE8XiZeXiRGXiQlXip7XiZaIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_16e1970517d0",
      "text": "行蹤。很抱歉，你們必須死。",
      "encoded_ascii": "^(;^(b^!\"^*K^,@^,h^*A^*F^*{^#l^)r^%L^!\"",
      "encoded_base64": "Xig7XihiXiEiXipLXixAXixoXipBXipGXip7XiNsXilyXiVMXiEi",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_bd4d319e1a92",
      "text": "我突然意識到，你們根本不是我以為的那個人。 ",
      "encoded_ascii": "^$%^'*^&\"^#z^(R^!u^*A^*F^*{^%)^$x^!)^,X^$%^!B^%{^&Z^)!^!V^!<^!\" ",
      "encoded_base64": "XiQlXicqXiYiXiN6XihSXiF1XipBXipGXip7XiUpXiR4XiEpXixYXiQlXiFCXiV7XiZaXikhXiFWXiE8XiEiIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_195f430275d0",
      "text": "確實是我看走了眼，但這個錯誤得由你們拿命來抵償。",
      "encoded_ascii": "^-6^#3^,X^$%^*Q^.&^*D^&d^*A^!I^(s^!V^)5^(P^#e^&I^*F^*{^,G^\"N^!O^$5^5-^!\"",
      "encoded_base64": "Xi02XiMzXixYXiQlXipRXi4mXipEXiZkXipBXiFJXihzXiFWXik1XihQXiNlXiZJXipGXip7XixHXiJOXiFPXiQ1XjUtXiEi",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_1091db69f094",
      "text": "帶上這個奴隸快走吧。 ",
      "encoded_ascii": "^#N^!'^(s^!V^##^)Z^*L^.&^*I^!\" ",
      "encoded_base64": "XiNOXiEnXihzXiFWXiMjXilaXipMXi4mXipJXiEiIA==",
      "byte_length": 31
    },
    {
      "unit_id": "DLG_5c1d09687ecd",
      "text": "  他是誰？",
      "encoded_ascii": "  ^!@^,X^-y^.V",
      "encoded_base64": "ICBeIUBeLFheLXleLlY=",
      "byte_length": 14
    },
    {
      "unit_id": "DLG_62534452ef07",
      "text": "  你為什麼認為他如此重要？",
      "encoded_ascii": "  ^*F^%{^!=^.T^(O^%{^!@^#$^%I^))^(C^.V",
      "encoded_base64": "ICBeKkZeJXteIT1eLlReKE9eJXteIUBeIyReJUleKSleKENeLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_1f0ece3db904",
      "text": "  他的眼神為什麼如此呆滯？",
      "encoded_ascii": "  ^!@^&Z^&d^&w^%{^!=^.T^#$^%I^;)^:L^.V",
      "encoded_base64": "ICBeIUBeJlpeJmReJndeJXteIT1eLlReIyReJUleOyleOkxeLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_8decdd658c7b",
      "text": "  你們對他施了魅惑法術嗎？",
      "encoded_ascii": "  ^*F^*{^#:^!@^$_^*D^*/^#x^%b^(<^+X^.V",
      "encoded_base64": "ICBeKkZeKnteIzpeIUBeJF9eKkReKi9eI3heJWJeKDxeK1heLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_eefa455d0003",
      "text": "  我現在就帶他走。",
      "encoded_ascii": "  ^$%^&?^\"d^*J^#N^!@^.&^!\"",
      "encoded_base64": "ICBeJCVeJj9eImReKkpeI05eIUBeLiZeISI=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_626bf7a6e673",
      "text": "你也想打聽，是吧？這個人對我來說，跟對你們一樣是個 ",
      "encoded_ascii": "^*F^!1^,1^$-^-X^*A^,X^*I^.V^(s^!V^!<^#:^$%^!O^-x^*A^.+^#:^*F^*{^!%^,f^,X^!V ",
      "encoded_base64": "XipGXiExXiwxXiQtXi1YXipBXixYXipJXi5WXihzXiFWXiE8XiM6XiQlXiFPXi14XipBXi4rXiM6XipGXip7XiElXixmXixYXiFWIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_12c29d3be56c",
      "text": "大謎團。我只知道他要被送往德拉吉。不過，他肯定非同 ",
      "encoded_ascii": "^\"z^=w^0V^!\"^$%^\"?^&h^(y^!@^(C^(@^./^,)^#j^$6^\"D^!\"^!)^(x^*A^!@^-Z^#.^)i^\"E ",
      "encoded_base64": "XiJ6Xj13XjBWXiEiXiQlXiI/XiZoXih5XiFAXihDXihAXi4vXiwpXiNqXiQ2XiJEXiEiXiEpXih4XipBXiFAXi1aXiMuXilpXiJFIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_aa819c4d19e6",
      "text": "小可。",
      "encoded_ascii": "^#;^\"A^!\"",
      "encoded_base64": "XiM7XiJBXiEi",
      "byte_length": 9
    },
    {
      "unit_id": "DLG_6776044239bc",
      "text": "這難道不明顯嗎？我們的雇主為了確保這個奴隸能安全穿越荒漠， ",
      "encoded_ascii": "^(s^)a^(y^!)^$c^4&^+X^.V^$%^*{^&Z^6C^!-^%{^*D^-6^!T^(s^!V^##^)Z^'b^+p^!h^')^(]^1W^,}^*A ",
      "encoded_base64": "XihzXilhXih5XiEpXiRjXjQmXitYXi5WXiQlXip7XiZaXjZDXiEtXiV7XipEXi02XiFUXihzXiFWXiMjXilaXidiXitwXiFoXicpXihdXjFXXix9XipBIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_848e56eba78a",
      "text": "可是付出了天價的代價。",
      "encoded_ascii": "^\"A^,X^*u^!q^*D^+e^+&^&Z^*v^+&^!\"",
      "encoded_base64": "XiJBXixYXip1XiFxXipEXitlXismXiZaXip2XismXiEi",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_7929f81c4ca5",
      "text": "他看起來不像是個大麻煩，對吧？這個奴隸中了 ",
      "encoded_ascii": "^!@^*Q^.(^!O^!)^!`^,X^!V^\"z^*6^-!^*A^#:^*I^.V^(s^!V^##^)Z^!,^*D ",
      "encoded_base64": "XiFAXipRXi4oXiFPXiEpXiFgXixYXiFWXiJ6Xio2Xi0hXipBXiM6XipJXi5WXihzXiFWXiMjXilaXiEsXipEIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_69d89d470b7b",
      "text": "魅惑法術。你會發現他是一個溫順、哪怕一聲不吭的俘虜。",
      "encoded_ascii": "^*/^#x^%b^(<^!\"^*F^$r^&W^&?^!@^,X^!%^!V^%s^.D^!!^+I^0^^!%^-W^!)^:l^&Z^39^3[^!\"",
      "encoded_base64": "XiovXiN4XiViXig8XiEiXipGXiRyXiZXXiY/XiFAXixYXiElXiFWXiVzXi5EXiEhXitJXjBeXiElXi1XXiEpXjpsXiZaXjM5XjNbXiEi",
      "byte_length": 78
    },
    {
      "unit_id": "DLG_7c2ecc4b3a05",
      "text": "我們接手他的時候他就是這副模樣了。據我所知，他會一直保持 ",
      "encoded_ascii": "^$%^*{^$?^$+^!@^&Z^$f^*|^!@^*J^,X^(s^52^%:^,f^*D^!\"^5T^$%^$)^&h^*A^!@^$r^!%^&`^!T^$7 ",
      "encoded_base64": "XiQlXip7XiQ/XiQrXiFAXiZaXiRmXip8XiFAXipKXixYXihzXjUyXiU6XixmXipEXiEiXjVUXiQlXiQpXiZoXipBXiFAXiRyXiElXiZgXiFUXiQ3IA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_c1a7081bd087",
      "text": "這個狀態，直到被押抵德拉吉為止。",
      "encoded_ascii": "^(s^!V^&7^#|^*A^&`^!u^(@^7Z^$5^#j^$6^\"D^%{^%G^!\"",
      "encoded_base64": "XihzXiFWXiY3XiN8XipBXiZgXiF1XihAXjdaXiQ1XiNqXiQ2XiJEXiV7XiVHXiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_f87d493a4efa",
      "text": "很好……我們現在必須返回營地了。 ",
      "encoded_ascii": "^*K^+i^*o^*o^$%^*{^&?^\"d^#l^)r^7J^\"\\^&'^\"e^*D^!\" ",
      "encoded_base64": "XipLXitpXipvXipvXiQlXip7XiY/XiJkXiNsXilyXjdKXiJcXiYnXiJlXipEXiEiIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_b8608d7397f4",
      "text": "後會有期，匕首。願你們的路途像我們一樣順利。",
      "encoded_ascii": "^#b^$r^$s^$u^*A^\"(^)~^!\"^.H^*F^*{^&Z^(a^3.^!`^$%^*{^!%^,f^.D^!t^!\"",
      "encoded_base64": "XiNiXiRyXiRzXiR1XipBXiIoXil+XiEiXi5IXipGXip7XiZaXihhXjMuXiFgXiQlXip7XiElXixmXi5EXiF0XiEi",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_f42376c2197f",
      "text": "走吧。帶走這個奴隸。他現在是匕首的責任了。",
      "encoded_ascii": "^.&^*I^!\"^#N^.&^(s^!V^##^)Z^!\"^!@^&?^\"d^,X^\"(^)~^&Z^0>^!C^*D^!\"",
      "encoded_base64": "Xi4mXipJXiEiXiNOXi4mXihzXiFWXiMjXilaXiEiXiFAXiY/XiJkXixYXiIoXil+XiZaXjA+XiFDXipEXiEi",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_315c0a388fa2",
      "text": "匕首，別急著走……你會帶走這個奴隸的，對吧？",
      "encoded_ascii": "^\"(^)~^*A^*H^3p^-a^.&^*o^*o^*F^$r^#N^.&^(s^!V^##^)Z^&Z^*A^#:^*I^.V",
      "encoded_base64": "XiIoXil+XipBXipIXjNwXi1hXi4mXipvXipvXipGXiRyXiNOXi4mXihzXiFWXiMjXilaXiZaXipBXiM6XipJXi5W",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_a244107a41e8",
      "text": "等等！我們的買賣還沒辦完！身為匕首的代理人，你 ",
      "encoded_ascii": "^'-^'-^*W^$%^*{^&Z^.!^.$^.7^%\\^2L^#,^*W^(c^%{^\"(^)~^&Z^*v^&A^!<^*A^*F ",
      "encoded_base64": "XictXictXipXXiQlXip7XiZaXi4hXi4kXi43XiVcXjJMXiMsXipXXihjXiV7XiIoXil+XiZaXip2XiZBXiE8XipBXipGIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_b39291c99912",
      "text": "必須履行他的業務。毫無疑問，你會帶走這個奴隸吧？",
      "encoded_ascii": "^#l^)r^5L^(;^!@^&Z^%5^+4^!\"^/t^%}^0p^*Z^*A^*F^$r^#N^.&^(s^!V^##^)Z^*I^.V",
      "encoded_base64": "XiNsXilyXjVMXig7XiFAXiZaXiU1Xis0XiEiXi90XiV9XjBwXipaXipBXipGXiRyXiNOXi4mXihzXiFWXiMjXilaXipJXi5W",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_60a03b53d341",
      "text": "這是什麼背叛背信的行徑？我絕不能容忍！",
      "encoded_ascii": "^(s^,X^!=^.T^.r^.Z^.r^!U^&Z^(;^#c^.V^$%^-I^!)^'b^+t^1y^*W",
      "encoded_base64": "XihzXixYXiE9Xi5UXi5yXi5aXi5yXiFVXiZaXig7XiNjXi5WXiQlXi1JXiEpXidiXit0XjF5XipX",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_9af344f4d642",
      "text": "你周圍的沙土翻動，幾名男子猛然從地下破土而出。其中一人衣著 ",
      "encoded_ascii": "^*F^\"L^\"`^&Z^%]^\"c^-Q^\"%^*A^#T^\"F^&K^#(^*P^&\"^#f^\"e^!(^&n^\"c^'W^!q^!\"^!j^!,^!%^!<^(>^-a ",
      "encoded_base64": "XipGXiJMXiJgXiZaXiVdXiJjXi1RXiIlXipBXiNUXiJGXiZLXiMoXipQXiYiXiNmXiJlXiEoXiZuXiJjXidXXiFxXiEiXiFqXiEsXiElXiE8Xig+Xi1hIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_438e1c0875be",
      "text": "與其他人不同，眼神呆滯地望向你的身後。",
      "encoded_ascii": "^'p^!j^!@^!<^!)^\"E^*A^&d^&w^;)^:L^\"e^,]^+?^*F^&Z^(c^#b^!\"",
      "encoded_base64": "XidwXiFqXiFAXiE8XiEpXiJFXipBXiZkXiZ3XjspXjpMXiJlXixdXis/XipGXiZaXihjXiNiXiEi",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_ea912f1f748c",
      "text": "另一群人悄然出現在空曠的沙地上，手中的刀劍早已出鞘備戰。",
      "encoded_ascii": "^\">^!%^'R^!<^3r^&\"^!q^&?^\"d^'(^9\\^&Z^%]^\"e^!'^*A^$+^!,^&Z^7Q^!|^,V^#J^!q^=~^+\"^$(^!\"",
      "encoded_base64": "XiI+XiElXidSXiE8XjNyXiYiXiFxXiY/XiJkXicoXjlcXiZaXiVdXiJlXiEnXipBXiQrXiEsXiZaXjdRXiF8XixWXiNKXiFxXj1+XisiXiQoXiEi",
      "byte_length": 84
    },
    {
      "unit_id": "DLG_ddd68d65c0f2",
      "text": "【完】",
      "encoded_ascii": "^;M^#,^;N",
      "encoded_base64": "XjtNXiMsXjtO",
      "byte_length": 9
    },
    {
      "unit_id": "DLG_2fa6246a7ebb",
      "text": "我真不明白我們為什麼不現在就宰了這幫人渣。 ",
      "encoded_ascii": "^$%^-2^!)^$c^&X^$%^*{^%{^!=^.T^!)^&?^\"d^*J^1w^*D^(s^+}^!<^,v^!\" ",
      "encoded_base64": "XiQlXi0yXiEpXiRjXiZYXiQlXip7XiV7XiE9Xi5UXiEpXiY/XiJkXipKXjF3XipEXihzXit9XiE8Xix2XiEiIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_510213f51f0c",
      "text": "他對你的聲音毫無反應。",
      "encoded_ascii": "^!@^#:^*F^&Z^-W^34^/t^%}^\"9^0`^!\"",
      "encoded_base64": "XiFAXiM6XipGXiZaXi1XXjM0Xi90XiV9XiI5XjBgXiEi",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_6f2f5c86f9a3",
      "text": "奴隸晃了晃腦袋，眼神隨後聚焦在你們身上。",
      "encoded_ascii": "^##^)Z^=:^*D^=:^2@^(?^*A^&d^&w^)X^#b^'[^%~^\"d^*F^*{^(c^!'^!\"",
      "encoded_base64": "XiMjXilaXj06XipEXj06XjJAXig/XipBXiZkXiZ3XilYXiNiXidbXiV+XiJkXipGXip7XihjXiEnXiEi",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_22137f7ec92f",
      "text": "這些天來我簡直生不如死！就像是行走在一片 ",
      "encoded_ascii": "^(s^!8^+e^!O^$%^3y^&`^&F^!)^#$^%L^*W^*J^!`^,X^(;^.&^\"d^!%^&1 ",
      "encoded_base64": "XihzXiE4XitlXiFPXiQlXjN5XiZgXiZGXiEpXiMkXiVMXipXXipKXiFgXixYXig7Xi4mXiJkXiElXiYxIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_7d0abfdf9eb6",
      "text": "泥沼之海中。眼前一片虛無，不斷地往下沉淪。",
      "encoded_ascii": "^%d^=|^!/^6`^!,^!\"^&d^!z^!%^&1^-g^%}^*A^!)^,T^\"e^,)^!(^%Z^2)^!\"",
      "encoded_base64": "XiVkXj18XiEvXjZgXiEsXiEiXiZkXiF6XiElXiYxXi1nXiV9XipBXiEpXixUXiJlXiwpXiEoXiVaXjIpXiEi",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_588650886e34",
      "text": "你是怎麼淪為奴隸的？",
      "encoded_ascii": "^*F^,X^,,^.T^2)^%{^##^)Z^&Z^.V",
      "encoded_base64": "XipGXixYXiwsXi5UXjIpXiV7XiMjXilaXiZaXi5W",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_121603ce436d",
      "text": "你聽到了什麼傳言？",
      "encoded_ascii": "^*F^-X^!u^*D^!=^.T^+$^1Y^.V",
      "encoded_base64": "XipGXi1YXiF1XipEXiE9Xi5UXiskXjFZXi5W",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_fa96fe712318",
      "text": "捕奴隊對你格外小心翼翼。",
      "encoded_ascii": "^4?^##^)U^#:^*F^%*^\"w^#;^#k^'T^'T^!\"",
      "encoded_base64": "XjQ/XiMjXilVXiM6XipGXiUqXiJ3XiM7XiNrXidUXidUXiEi",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_8e55a1bbd8be",
      "text": "你有烏里克城邦的消息嗎？",
      "encoded_ascii": "^*F^$s^/4^)(^!d^+_^1a^&Z^%k^#w^+X^.V",
      "encoded_base64": "XipGXiRzXi80XikoXiFkXitfXjFhXiZaXiVrXiN3XitYXi5W",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_b08a0356695a",
      "text": "為什麼你對這些捕奴販子如此重要？",
      "encoded_ascii": "^%{^!=^.T^*F^#:^(s^!8^4?^##^6.^#(^#$^%I^))^(C^.V",
      "encoded_base64": "XiV7XiE9Xi5UXipGXiM6XihzXiE4XjQ/XiMjXjYuXiMoXiMkXiVJXikpXihDXi5W",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_56e1581989a5",
      "text": "好了，我必須離開了。 ",
      "encoded_ascii": "^+i^*D^*A^$%^#l^)r^)`^)F^*D^!\" ",
      "encoded_base64": "XitpXipEXipBXiQlXiNsXilyXilgXilGXipEXiEiIA==",
      "byte_length": 31
    },
    {
      "unit_id": "DLG_2827b7eecefe",
      "text": "請原諒我方才未作自我介紹！我是涅爾韋利，烏里克的一名 ",
      "encoded_ascii": "^*S^\"5^0<^$%^$]^$,^,_^!M^'l^$%^!>^<s^*W^$%^,X^4O^&/^>!^!t^*A^/4^)(^!d^&Z^!%^\"F ",
      "encoded_base64": "XipTXiI1XjA8XiQlXiRdXiQsXixfXiFNXidsXiQlXiE+XjxzXipXXiQlXixYXjRPXiYvXj4hXiF0XipBXi80XikoXiFkXiZaXiElXiJGIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_3c43b1e52f66",
      "text": "貴族。我恐怕這場淪為奴隸的遭遇會讓我失去領地。許多人 ",
      "encoded_ascii": "^2F^5V^!\"^$%^#t^0^^(s^\"n^2)^%{^##^)Z^&Z^(}^.2^$r^-}^$%^\"|^\"6^)s^\"e^!\"^-s^\"x^!< ",
      "encoded_base64": "XjJGXjVWXiEiXiQlXiN0XjBeXihzXiJuXjIpXiV7XiMjXilaXiZaXih9Xi4yXiRyXi19XiQlXiJ8XiI2XilzXiJlXiEiXi1zXiJ4XiE8IA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_8173191ca09a",
      "text": "都巴不得我永遠消失。 ",
      "encoded_ascii": "^)$^#K^!)^#e^$%^%W^({^%k^\"|^!\" ",
      "encoded_base64": "XikkXiNLXiEpXiNlXiQlXiVXXih7XiVrXiJ8XiEiIA==",
      "byte_length": 31
    },
    {
      "unit_id": "DLG_3f8f80b8c9a9",
      "text": "我的一個姪子觸怒了一名高階聖堂武士。那傢伙的報復手段就是 ",
      "encoded_ascii": "^$%^&Z^!%^!V^={^#(^(J^#o^*D^!%^\"F^*+^=b^'Z^42^%J^+a^!\"^)!^+#^*y^&Z^+`^#g^$+^.l^*J^,X ",
      "encoded_base64": "XiQlXiZaXiElXiFWXj17XiMoXihKXiNvXipEXiElXiJGXiorXj1iXidaXjQyXiVKXithXiEiXikhXisjXip5XiZaXitgXiNnXiQrXi5sXipKXixYIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_de53e9aa46e9",
      "text": "查封了我們家族的宅邸，並將我們賣進了黑曜石礦坑。 ",
      "encoded_ascii": "^%&^#5^*D^$%^*{^+s^5V^&Z^='^=}^*A^!+^#7^$%^*{^.$^(w^*D^*:^5X^&k^5m^5>^!\" ",
      "encoded_base64": "XiUmXiM1XipEXiQlXip7XitzXjVWXiZaXj0nXj19XipBXiErXiM3XiQlXip7Xi4kXih3XipEXio6XjVYXiZrXjVtXjU+XiEiIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_b11bfd478551",
      "text": "據說特克圖克特雷偏好用貴族出身的奴隸來活祭。 ",
      "encoded_ascii": "^5T^-x^&5^!d^\"b^!d^&5^)c^![^+i^&H^2F^5V^!q^(c^&Z^##^)Z^!O^%i^&x^!\" ",
      "encoded_base64": "XjVUXi14XiY1XiFkXiJiXiFkXiY1XiljXiFbXitpXiZIXjJGXjVWXiFxXihjXiZaXiMjXilaXiFPXiVpXiZ4XiEiIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_bb60479fa272",
      "text": "我恐怕本該被押上金字塔階梯，任由黑曜石利刃穿心。我的 ",
      "encoded_ascii": "^$%^#t^0^^$x^(M^(@^7Z^!'^)+^#)^\"o^=b^3u^*A^!C^&I^*:^5X^&k^!t^!r^')^#k^!\"^$%^&Z ",
      "encoded_base64": "XiQlXiN0XjBeXiR4XihNXihAXjdaXiEnXikrXiMpXiJvXj1iXjN1XipBXiFDXiZJXio6XjVYXiZrXiF0XiFyXicpXiNrXiEiXiQlXiZaIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_abcc60a4577f",
      "text": "心臟本會淪為他寵物的食糧。 ",
      "encoded_ascii": "^#k^3Y^$x^$r^2)^%{^!@^6U^&4^&Z^0J^5s^!\" ",
      "encoded_base64": "XiNrXjNZXiR4XiRyXjIpXiV7XiFAXjZVXiY0XiZaXjBKXjVzXiEiIA==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_eaa6237782dc",
      "text": "是的。他們肯定在礦場時給我下了藥。剛才那一陣混亂與刺激， ",
      "encoded_ascii": "^,X^&Z^!\"^!@^*{^-Z^#.^\"d^5m^\"n^$f^'A^$%^!(^*D^()^!\"^+0^$,^)!^!%^)P^%n^!3^'p^!w^1H^*A ",
      "encoded_base64": "XixYXiZaXiEiXiFAXip7Xi1aXiMuXiJkXjVtXiJuXiRmXidBXiQlXiEoXipEXigpXiEiXiswXiQsXikhXiElXilQXiVuXiEzXidwXiF3XjFIXipBIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_fffedbe74eab",
      "text": "總算讓我神智清醒了過來。 ",
      "encoded_ascii": "^-M^-C^-}^$%^&w^$i^,u^.9^*D^(x^!O^!\" ",
      "encoded_base64": "Xi1NXi1DXi19XiQlXiZ3XiRpXix1Xi45XipEXih4XiFPXiEiIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_3b7285cd44cc",
      "text": "只有關於礦坑的傳聞。那裡恐怖至極。黑曜石碎片會割爛人的手 ",
      "encoded_ascii": "^\"?^$s^.>^$^^5m^5>^&Z^+$^4^^!\"^)!^-j^#t^#p^'n^1D^!\"^*:^5X^&k^&o^&1^$r^+1^&-^!<^&Z^$+ ",
      "encoded_base64": "XiI/XiRzXi4+XiReXjVtXjU+XiZaXiskXjReXiEiXikhXi1qXiN0XiNwXiduXjFEXiEiXio6XjVYXiZrXiZvXiYxXiRyXisxXiYtXiE8XiZaXiQrIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_4e6bc1d963d9",
      "text": "和腳。在陡坡上摔倒甚至會把人割成無數碎片。 ",
      "encoded_ascii": "^\"O^00^!\"^\"d^9d^7u^!'^/i^!X^/|^'n^$r^$1^!<^+1^$$^%}^$V^&o^&1^!\" ",
      "encoded_base64": "XiJPXjAwXiEiXiJkXjlkXjd1XiEnXi9pXiFYXi98XiduXiRyXiQxXiE8XisxXiQkXiV9XiRWXiZvXiYxXiEiIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_16f26e3de9df",
      "text": "我懷疑我的家族本在設法將我從礦坑裡贖出來。而我的 ",
      "encoded_ascii": "^$%^,9^0p^$%^&Z^+s^5V^$x^\"d^4e^%b^#7^$%^#f^5m^5>^-j^3-^!q^!O^!\"^'W^$%^&Z ",
      "encoded_base64": "XiQlXiw5XjBwXiQlXiZaXitzXjVWXiR4XiJkXjRlXiViXiM3XiQlXiNmXjVtXjU+Xi1qXjMtXiFxXiFPXiEiXidXXiQlXiZaIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_8f85b6b5a64a",
      "text": "政敵肯定一手策劃了這趟押解。我恐怕在德拉吉有極其可怕的厄運等著 ",
      "encoded_ascii": "^,P^$U^-Z^#.^!%^$+^5p^4s^*D^(s^8)^7Z^(I^!\"^$%^#t^0^^\"d^#j^$6^\"D^$s^1D^!j^\"A^0^^&Z^80^.4^'-^-a ",
      "encoded_base64": "XixQXiRVXi1aXiMuXiElXiQrXjVwXjRzXipEXihzXjgpXjdaXihJXiEiXiQlXiN0XjBeXiJkXiNqXiQ2XiJEXiRzXjFEXiFqXiJBXjBeXiZaXjgwXi40XictXi1hIA==",
      "byte_length": 94
    },
    {
      "unit_id": "DLG_8bb12203ce33",
      "text": "我。 ",
      "encoded_ascii": "^$%^!\" ",
      "encoded_base64": "XiQlXiEiIA==",
      "byte_length": 7
    },
    {
      "unit_id": "DLG_2f6f9a7a620b",
      "text": "再見，再次感謝你們！我這就動身前往烏里克奪回我的領地！",
      "encoded_ascii": "^!l^-m^*A^!l^%D^#{^-z^*F^*{^*W^$%^(s^*J^\"%^(c^!z^,)^/4^)(^!d^1,^\"\\^$%^&Z^)s^\"e^*W",
      "encoded_base64": "XiFsXi1tXipBXiFsXiVEXiN7Xi16XipGXip7XipXXiQlXihzXipKXiIlXihjXiF6XiwpXi80XikoXiFkXjEsXiJcXiQlXiZaXilzXiJlXipX",
      "byte_length": 81
    },
    {
      "unit_id": "DLG_84fe5609c151",
      "text": "立刻滾出我的地盤！",
      "encoded_ascii": "^0'^.Y^,z^!q^$%^&Z^\"e^1M^*W",
      "encoded_base64": "XjAnXi5ZXix6XiFxXiQlXiZaXiJlXjFNXipX",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_f642c5c59347",
      "text": "蠢貨！你竟然讓那個奴隸死了。我早就想宰了你們， ",
      "encoded_ascii": "^.u^.w^*W^*F^28^&\"^-}^)!^!V^##^)Z^%L^*D^!\"^$%^,V^*J^,1^1w^*D^*F^*{^*A ",
      "encoded_base64": "Xi51Xi53XipXXipGXjI4XiYiXi19XikhXiFWXiMjXilaXiVMXipEXiEiXiQlXixWXipKXiwxXjF3XipEXipGXip7XipBIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_f311e509eb19",
      "text": "想了很久，現在終於能如願了！ ",
      "encoded_ascii": "^,1^*D^*K^!.^*A^&?^\"d^-H^$^^'b^#$^.H^*D^*W ",
      "encoded_base64": "XiwxXipEXipLXiEuXipBXiY/XiJkXi1IXiReXidiXiMkXi5IXipEXipXIA==",
      "byte_length": 43
    },
    {
      "unit_id": "DLG_d6c2752ff7f5",
      "text": "哈哈！後會有期！謝啦，這個奴隸歸我們了！ ",
      "encoded_ascii": "^+F^+F^*W^#b^$r^$s^$u^*W^-z^+R^*A^(s^!V^##^)Z^%K^$%^*{^*D^*W ",
      "encoded_base64": "XitGXitGXipXXiNiXiRyXiRzXiR1XipXXi16XitSXipBXihzXiFWXiMjXilaXiVLXiQlXip7XipEXipXIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_8ba3f0a8aa9e",
      "text": " 我願意付你的罰金。",
      "encoded_ascii": " ^$%^.H^#z^*u^*F^&Z^0-^)+^!\"",
      "encoded_base64": "IF4kJV4uSF4jel4qdV4qRl4mWl4wLV4pK14hIg==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_1d27579920fd",
      "text": "後會有期，霍托托！我們下次再見時，場面可就不會這麼客氣了！ ",
      "encoded_ascii": "^#b^$r^$s^$u^*A^;%^/-^/-^*W^$%^*{^!(^%D^!l^-m^$f^*A^\"n^)j^\"A^*J^!)^$r^(s^.T^+q^%U^*D^*W ",
      "encoded_base64": "XiNiXiRyXiRzXiR1XipBXjslXi8tXi8tXipXXiQlXip7XiEoXiVEXiFsXi1tXiRmXipBXiJuXilqXiJBXipKXiEpXiRyXihzXi5UXitxXiVVXipEXipXIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_2c566458de83",
      "text": "哈哈哈！ ",
      "encoded_ascii": "^+F^+F^+F^*W ",
      "encoded_base64": "XitGXitGXitGXipXIA==",
      "byte_length": 13
    },
    {
      "unit_id": "DLG_0ef020168187",
      "text": "站住，霍托托！站在你面前的是匕首！我們本該在彼此地盤的交界處 ",
      "encoded_ascii": "^->^*z^*A^;%^/-^/-^*W^->^\"d^*F^)j^!z^&Z^,X^\"(^)~^*W^$%^*{^$x^(M^\"d^:E^%I^\"e^1M^&Z^0P^.p^(, ",
      "encoded_base64": "Xi0+Xip6XipBXjslXi8tXi8tXipXXi0+XiJkXipGXilqXiF6XiZaXixYXiIoXil+XipXXiQlXip7XiR4XihNXiJkXjpFXiVJXiJlXjFNXiZaXjBQXi5wXigsIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_e6f02e01cde7",
      "text": "碰頭，而不是在我地盤的腹深處！",
      "encoded_ascii": "^-5^)t^*A^'W^!)^,X^\"d^$%^\"e^1M^&Z^3%^2*^(,^*W",
      "encoded_base64": "Xi01Xil0XipBXidXXiEpXixYXiJkXiQlXiJlXjFNXiZaXjMlXjIqXigsXipX",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_0323304bba56",
      "text": "站住！你們侵入了匕首的地盤！亮明身分，否則 ",
      "encoded_ascii": "^->^*z^*W^*F^*{^.X^!f^*D^\"(^)~^&Z^\"e^1M^*W^*t^$c^(c^!s^*A^\"H^!x ",
      "encoded_base64": "Xi0+Xip6XipXXipGXip7Xi5YXiFmXipEXiIoXil+XiZaXiJlXjFNXipXXip0XiRjXihjXiFzXipBXiJIXiF4IA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_752b8c5b3d0d",
      "text": "受死吧！",
      "encoded_ascii": "^\";^%L^*I^*W",
      "encoded_base64": "XiI7XiVMXipJXipX",
      "byte_length": 12
    },
    {
      "unit_id": "DLG_0e98293a5e0f",
      "text": "  我不是霍托托。",
      "encoded_ascii": "  ^$%^!)^,X^;%^/-^/-^!\"",
      "encoded_base64": "ICBeJCVeISleLFheOyVeLy1eLy1eISI=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_a708b5a2286a",
      "text": "  胡說，匕首！明明是你侵入了我的地盤！",
      "encoded_ascii": "  ^3}^-x^*A^\"(^)~^*W^$c^$c^,X^*F^.X^!f^*D^$%^&Z^\"e^1M^*W",
      "encoded_base64": "ICBeM31eLXheKkFeIiheKX5eKldeJGNeJGNeLFheKkZeLlheIWZeKkReJCVeJlpeImVeMU1eKlc=",
      "byte_length": 56
    },
    {
      "unit_id": "DLG_5027cfea942a",
      "text": "  我是霍托托的副官。",
      "encoded_ascii": "  ^$%^,X^;%^/-^/-^&Z^52^#-^!\"",
      "encoded_base64": "ICBeJCVeLFheOyVeLy1eLy1eJlpeNTJeIy1eISI=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_1dfb5e105385",
      "text": "  我只是個旅人。",
      "encoded_ascii": "  ^$%^\"?^,X^!V^2m^!<^!\"",
      "encoded_base64": "ICBeJCVeIj9eLFheIVZeMm1eITxeISI=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_2bcba3008167",
      "text": "  我無意擅闖。請見諒。",
      "encoded_ascii": "  ^$%^%}^#z^2$^.z^!\"^*S^-m^0<^!\"",
      "encoded_base64": "ICBeJCVeJX1eI3peMiReLnpeISJeKlNeLW1eMDxeISI=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_676acedbcb6f",
      "text": "你不是？！那你就得去死！",
      "encoded_ascii": "^*F^!)^,X^.V^*W^)!^*F^*J^#e^\"6^%L^*W",
      "encoded_base64": "XipGXiEpXixYXi5WXipXXikhXipGXipKXiNlXiI2XiVMXipX",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_6d1da199607e",
      "text": "也許你說得對，霍托托……但這筆帳我們改天 ",
      "encoded_ascii": "^!1^-s^*F^-x^#e^#:^*A^;%^/-^/-^*o^*o^!I^(s^-A^8Y^$%^*{^$N^+e ",
      "encoded_base64": "XiExXi1zXipGXi14XiNlXiM6XipBXjslXi8tXi8tXipvXipvXiFJXihzXi1BXjhZXiQlXip7XiROXitlIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_999b9531fce4",
      "text": "再算！眼下我們有正經買賣要辦。 ",
      "encoded_ascii": "^!l^-C^*W^&d^!(^$%^*{^$s^%H^'D^.!^.$^(C^2L^!\" ",
      "encoded_base64": "XiFsXi1DXipXXiZkXiEoXiQlXip7XiRzXiVIXidEXi4hXi4kXihDXjJMXiEiIA==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_8a4c67a3086d",
      "text": "你竟敢質疑我的話！今天就是你的死期，霍托托，你的地盤 ",
      "encoded_ascii": "^*F^28^/m^(Z^0p^$%^&Z^-v^*W^*E^+e^*J^,X^*F^&Z^%L^$u^*A^;%^/-^/-^*A^*F^&Z^\"e^1M ",
      "encoded_base64": "XipGXjI4Xi9tXihaXjBwXiQlXiZaXi12XipXXipFXitlXipKXixYXipGXiZaXiVMXiR1XipBXjslXi8tXi8tXipBXipGXiZaXiJlXjFNIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_eb302b7da0ea",
      "text": "將歸我所有！",
      "encoded_ascii": "^#7^%K^$%^$)^$s^*W",
      "encoded_base64": "XiM3XiVLXiQlXiQpXiRzXipX",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_5c2e59aba149",
      "text": " 他死了。",
      "encoded_ascii": " ^!@^%L^*D^!\"",
      "encoded_base64": "IF4hQF4lTF4qRF4hIg==",
      "byte_length": 13
    },
    {
      "unit_id": "DLG_557f90e947cd",
      "text": " 他逃跑了。",
      "encoded_ascii": " ^!@^(p^(_^*D^!\"",
      "encoded_base64": "IF4hQF4ocF4oX14qRF4hIg==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_f41bf642d1ca",
      "text": " 去死吧，奴隸販子！",
      "encoded_ascii": " ^\"6^%L^*I^*A^##^)Z^6.^#(^*W",
      "encoded_base64": "IF4iNl4lTF4qSV4qQV4jI14pWl42Ll4jKF4qVw==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_c49a4e5fb985",
      "text": "把奴隸交出來，這樁奇怪的買賣就算了結了。",
      "encoded_ascii": "^$1^##^)Z^0P^!q^!O^*A^(s^%7^\"}^#s^&Z^.!^.$^*J^-C^*D^'@^*D^!\"",
      "encoded_base64": "XiQxXiMjXilaXjBQXiFxXiFPXipBXihzXiU3XiJ9XiNzXiZaXi4hXi4kXipKXi1DXipEXidAXipEXiEi",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_fdc3def693cc",
      "text": "但是奴隸在哪裡？我怎麼沒看見他！",
      "encoded_ascii": "^!I^,X^##^)Z^\"d^+I^-j^.V^$%^,,^.T^%\\^*Q^-m^!@^*W",
      "encoded_base64": "XiFJXixYXiMjXilaXiJkXitJXi1qXi5WXiQlXiwsXi5UXiVcXipRXi1tXiFAXipX",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_447664fe8e1e",
      "text": "首領……那個奴隸已經死了！我感應到這幫人絕對脫不了 ",
      "encoded_ascii": "^)~^)s^*o^*o^)!^!V^##^)Z^#J^'D^%L^*D^*W^$%^#{^0`^!u^(s^+}^!<^-I^#:^'c^!)^*D ",
      "encoded_base64": "Xil+XilzXipvXipvXikhXiFWXiMjXilaXiNKXidEXiVMXipEXipXXiQlXiN7XjBgXiF1XihzXit9XiE8Xi1JXiM6XidjXiEpXipEIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_5da8d0d099db",
      "text": "干係！",
      "encoded_ascii": "^#R^38^*W",
      "encoded_base64": "XiNSXjM4XipX",
      "byte_length": 9
    },
    {
      "unit_id": "DLG_125ab3af5e9b",
      "text": "你在撒謊！",
      "encoded_ascii": "^*F^\"d^<>^3*^*W",
      "encoded_base64": "XipGXiJkXjw+XjMqXipX",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_be96cf2edfb5",
      "text": "死了？！你這個無能的蠢貨！現在我們一毛錢也拿不到了！",
      "encoded_ascii": "^%L^*D^.V^*W^*F^(s^!V^%}^'b^&Z^.u^.w^*W^&?^\"d^$%^*{^!%^%R^.<^!1^,G^!)^!u^*D^*W",
      "encoded_base64": "XiVMXipEXi5WXipXXipGXihzXiFWXiV9XidiXiZaXi51Xi53XipXXiY/XiJkXiQlXip7XiElXiVSXi48XiExXixHXiEpXiF1XipEXipX",
      "byte_length": 78
    },
    {
      "unit_id": "DLG_7e2b00c5b7cd",
      "text": "首領，我感應到那個奴隸就在西邊不遠處！",
      "encoded_ascii": "^)~^)s^*A^$%^#{^0`^!u^)!^!V^##^)Z^*J^\"d^-l^.8^!)^({^(,^*W",
      "encoded_base64": "Xil+XilzXipBXiQlXiN7XjBgXiF1XikhXiFWXiMjXilaXipKXiJkXi1sXi44XiEpXih7XigsXipX",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_43a4eda2ec28",
      "text": "幹得好……我們去抓他。霍托托，如果你想見識見識 ",
      "encoded_ascii": "^,!^#e^+i^*o^*o^$%^*{^\"6^$2^!@^!\"^;%^/-^/-^*A^#$^%!^*F^,1^-m^(R^-m^(R ",
      "encoded_base64": "XiwhXiNlXitpXipvXipvXiQlXip7XiI2XiQyXiFAXiEiXjslXi8tXi8tXipBXiMkXiUhXipGXiwxXi1tXihSXi1tXihSIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_cf34d00ee4ce",
      "text": "專業捕奴隊是怎麼幹活的，就跟著來吧！",
      "encoded_ascii": "^#8^%5^4?^##^)U^,X^,,^.T^,!^%i^&Z^*A^*J^.+^-a^!O^*I^*W",
      "encoded_base64": "XiM4XiU1XjQ/XiMjXilVXixYXiwsXi5UXiwhXiVpXiZaXipBXipKXi4rXi1hXiFPXipJXipX",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_0d870cd005b4",
      "text": "逃跑了，是嗎？ ",
      "encoded_ascii": "^(p^(_^*D^*A^,X^+X^.V ",
      "encoded_base64": "XihwXihfXipEXipBXixYXitYXi5WIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_c5abb586ddd4",
      "text": "無能的蠢貨！真討厭，居然要我來替你收拾爛攤子。",
      "encoded_ascii": "^%}^'b^&Z^.u^.w^*W^-2^-o^+9^*A^+w^&\"^(C^$%^!O^2o^*F^$M^7[^&-^<U^#(^!\"",
      "encoded_base64": "XiV9XidiXiZaXi51Xi53XipXXi0yXi1vXis5XipBXit3XiYiXihDXiQlXiFPXjJvXipGXiRNXjdbXiYtXjxVXiMoXiEi",
      "byte_length": 69
    },
    {
      "unit_id": "DLG_0f5c1c43667f",
      "text": "霍托托……你不僅無能，還毫無智謀可言！",
      "encoded_ascii": "^;%^/-^/-^*o^*o^*F^!)^!_^%}^'b^*A^.7^/t^%}^$i^3~^\"A^1Y^*W",
      "encoded_base64": "XjslXi8tXi8tXipvXipvXipGXiEpXiFfXiV9XidiXipBXi43Xi90XiV9XiRpXjN+XiJBXjFZXipX",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_3861800d9724",
      "text": "匕首朝他手下的一名戰士呼喊。 ",
      "encoded_ascii": "^\"(^)~^,^^!@^$+^!(^&Z^!%^\"F^$(^+a^\"M^+S^!\" ",
      "encoded_base64": "XiIoXil+XixeXiFAXiQrXiEoXiZaXiElXiJGXiQoXithXiJNXitTXiEiIA==",
      "byte_length": 43
    },
    {
      "unit_id": "DLG_e8760a0cb822",
      "text": "阿帕拉，替匕首找出那個奴隸的位置！",
      "encoded_ascii": "^)M^#L^$6^*A^2o^\"(^)~^$/^!q^)!^!V^##^)Z^&Z^!J^'Q^*W",
      "encoded_base64": "XilNXiNMXiQ2XipBXjJvXiIoXil+XiQvXiFxXikhXiFWXiMjXilaXiZaXiFKXidRXipX",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_bf150232cd23",
      "text": "一名戰士走上前來，凝神專注了片刻。 ",
      "encoded_ascii": "^!%^\"F^$(^+a^.&^!'^!z^!O^*A^!o^&w^#8^%e^*D^&1^.Y^!\" ",
      "encoded_base64": "XiElXiJGXiQoXithXi4mXiEnXiF6XiFPXipBXiFvXiZ3XiM4XiVlXipEXiYxXi5ZXiEiIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_75ab25ed369b",
      "text": "我不接受任何哭哭啼啼的道歉！ ",
      "encoded_ascii": "^$%^!)^$?^\";^!C^!L^/U^/U^40^40^&Z^(y^,h^*W ",
      "encoded_base64": "XiQlXiEpXiQ/XiI7XiFDXiFMXi9VXi9VXjQwXjQwXiZaXih5XixoXipXIA==",
      "byte_length": 43
    },
    {
      "unit_id": "DLG_addf90d1bee6",
      "text": "我要收賠償金！五千枚陶幣 ",
      "encoded_ascii": "^$%^(C^$M^62^5-^)+^*W^!6^+7^$~^)R^+| ",
      "encoded_base64": "XiQlXihDXiRNXjYyXjUtXikrXipXXiE2Xis3XiR+XilSXit8IA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_76d022e4f16a",
      "text": "才能平息我的怒火。付錢，否則你們被曬白的枯骨將會留在荒漠 ",
      "encoded_ascii": "^$,^'b^0Y^#w^$%^&Z^#o^%x^!\"^*u^.<^*A^\"H^!x^*F^*{^(@^,Z^&X^&Z^5Z^*$^#7^$r^-+^\"d^1W^,} ",
      "encoded_base64": "XiQsXidiXjBZXiN3XiQlXiZaXiNvXiV4XiEiXip1Xi48XipBXiJIXiF4XipGXip7XihAXixaXiZYXiZaXjVaXiokXiM3XiRyXi0rXiJkXjFXXix9IA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_fb46c00067d2",
      "text": "當裝飾！",
      "encoded_ascii": "^&N^(A^)|^*W",
      "encoded_base64": "XiZOXihBXil8XipX",
      "byte_length": 12
    },
    {
      "unit_id": "DLG_d94a90be6cfa",
      "text": "  講點道理。我們之間有買賣要談。",
      "encoded_ascii": "  ^6+^*;^(y^&A^!\"^$%^*{^!/^)G^$s^.!^.$^(C^0;^!\"",
      "encoded_base64": "ICBeNiteKjteKHleJkFeISJeJCVeKnteIS9eKUdeJHNeLiFeLiReKENeMDteISI=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_d5c62f66466c",
      "text": "  該死的人是你，匕首！",
      "encoded_ascii": "  ^(M^%L^&Z^!<^,X^*F^*A^\"(^)~^*W",
      "encoded_base64": "ICBeKE1eJUxeJlpeITxeLFheKkZeKkFeIiheKX5eKlc=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_60dce62cb253",
      "text": "  很好。我就留你們一條活命。",
      "encoded_ascii": "  ^*K^+i^!\"^$%^*J^-+^*F^*{^!%^%.^%i^\"N^!\"",
      "encoded_base64": "ICBeKkteK2leISJeJCVeKkpeLSteKkZeKnteISVeJS5eJWleIk5eISI=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_df7b1c82b5f6",
      "text": "  你們帶的錢根本不夠！竟敢妄圖詐騙我？！",
      "encoded_ascii": "  ^*F^*{^#N^&Z^.<^%)^$x^!)^+d^*W^28^/m^+j^\"b^6(^.{^$%^.V^*W",
      "encoded_base64": "ICBeKkZeKnteI05eJlpeLjxeJSleJHheISleK2ReKldeMjheL21eK2peImJeNiheLnteJCVeLlZeKlc=",
      "byte_length": 59
    },
    {
      "unit_id": "DLG_9e0123dc2926",
      "text": "沒錯，你們確實該把奴隸移交給我們……但我懷疑你們能不能 ",
      "encoded_ascii": "^%\\^)5^*A^*F^*{^-6^#3^(M^$1^##^)Z^'\"^0P^'A^$%^*{^*o^*o^!I^$%^,9^0p^*F^*{^'b^!)^'b ",
      "encoded_base64": "XiVcXik1XipBXipGXip7Xi02XiMzXihNXiQxXiMjXilaXiciXjBQXidBXiQlXip7XipvXipvXiFJXiQlXiw5XjBwXipGXip7XidiXiEpXidiIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_8e9c52931ec2",
      "text": "阻止我們直接把他搶過來！付錢，否則我會像沙塵暴摧折蘆葦一樣 ",
      "encoded_ascii": "^)L^%G^$%^*{^&`^$?^$1^!@^1?^(x^!O^*W^*u^.<^*A^\"H^!x^$%^$r^!`^%]^\"p^$m^$E^,?^(*^($^!%^,f ",
      "encoded_base64": "XilMXiVHXiQlXip7XiZgXiQ/XiQxXiFAXjE/Xih4XiFPXipXXip1Xi48XipBXiJIXiF4XiQlXiRyXiFgXiVdXiJwXiRtXiRFXiw/XigqXigkXiElXixmIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_7b446377ed85",
      "text": "碾碎你們！",
      "encoded_ascii": "^0$^&o^*F^*{^*W",
      "encoded_base64": "XjAkXiZvXipGXip7XipX",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_b3474bb74a12",
      "text": "不可能！我會先碾碎你，匕首！",
      "encoded_ascii": "^!)^\"A^'b^*W^$%^$r^!b^0$^&o^*F^*A^\"(^)~^*W",
      "encoded_base64": "XiEpXiJBXidiXipXXiQlXiRyXiFiXjAkXiZvXipGXipBXiIoXil+XipX",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_ca247908cb8b",
      "text": "很好。跟識相的勇士打交道就是痛快。把那個奴隸移交給 ",
      "encoded_ascii": "^*K^+i^!\"^.+^(R^&a^&Z^\"$^+a^$-^0P^(y^*J^,X^-.^*L^!\"^$1^)!^!V^##^)Z^'\"^0P^'A ",
      "encoded_base64": "XipLXitpXiEiXi4rXihSXiZhXiZaXiIkXithXiQtXjBQXih5XipKXixYXi0uXipMXiEiXiQxXikhXiFWXiMjXilaXiciXjBQXidBIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_bbe26b118e26",
      "text": "我們，這樁奇怪的差事就算徹底了結了！",
      "encoded_ascii": "^$%^*{^*A^(s^%7^\"}^#s^&Z^48^*r^*J^-C^18^/^^*D^'@^*D^*W",
      "encoded_base64": "XiQlXip7XipBXihzXiU3XiJ9XiNzXiZaXjQ4XipyXipKXi1DXjE4Xi9eXipEXidAXipEXipX",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_1eb93e201cff",
      "text": "把奴隸帶走吧。",
      "encoded_ascii": "^$1^##^)Z^#N^.&^*I^!\"",
      "encoded_base64": "XiQxXiMjXilaXiNOXi4mXipJXiEi",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_37f366be0c15",
      "text": "不行！我是奴隸制度的死敵！受死吧！",
      "encoded_ascii": "^!)^(;^*W^$%^,X^##^)Z^!v^#V^&Z^%L^$U^*W^\";^%L^*I^*W",
      "encoded_base64": "XiEpXig7XipXXiQlXixYXiMjXilaXiF2XiNWXiZaXiVMXiRVXipXXiI7XiVMXipJXipX",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_8cac53814f12",
      "text": "很好。 ",
      "encoded_ascii": "^*K^+i^!\" ",
      "encoded_base64": "XipLXitpXiEiIA==",
      "byte_length": 10
    },
    {
      "unit_id": "DLG_070a413b87df",
      "text": "替我向霍托托問好。",
      "encoded_ascii": "^2o^$%^+?^;%^/-^/-^*Z^+i^!\"",
      "encoded_base64": "XjJvXiQlXis/XjslXi8tXi8tXipaXitpXiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_4e4e16afe4b9",
      "text": "我們改天還會再做買賣的，霍托托。",
      "encoded_ascii": "^$%^*{^$N^+e^.7^$r^!l^*~^.!^.$^&Z^*A^;%^/-^/-^!\"",
      "encoded_base64": "XiQlXip7XiROXitlXi43XiRyXiFsXip+Xi4hXi4kXiZaXipBXjslXi8tXi8tXiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_406ba6870120",
      "text": " 過來，奴隸！我們帶你去展開你的新生！",
      "encoded_ascii": " ^(x^!O^*A^##^)Z^*W^$%^*{^#N^*F^\"6^+x^)F^*F^&Z^$\\^&F^*W",
      "encoded_base64": "IF4oeF4hT14qQV4jI14pWl4qV14kJV4qe14jTl4qRl4iNl4reF4pRl4qRl4mWl4kXF4mRl4qVw==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_22588d78b155",
      "text": "匕首對 ",
      "encoded_ascii": "^\"(^)~^#: ",
      "encoded_base64": "XiIoXil+XiM6IA==",
      "byte_length": 10
    },
    {
      "unit_id": "DLG_001aad38f80e",
      "text": "你的實力深感佩服。 ",
      "encoded_ascii": "^*F^&Z^#3^!~^2*^#{^.}^,\\^!\" ",
      "encoded_base64": "XipGXiZaXiMzXiF+XjIqXiN7Xi59XixcXiEiIA==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_1748a996c3a2",
      "text": "哼，跑腿的走狗，你侵入了我的地盤！我要求賠償。五千枚 ",
      "encoded_ascii": "^+K^*A^(_^'h^&Z^.&^-&^*A^*F^.X^!f^*D^$%^&Z^\"e^1M^*W^$%^(C^,n^62^5-^!\"^!6^+7^$~ ",
      "encoded_base64": "XitLXipBXihfXidoXiZaXi4mXi0mXipBXipGXi5YXiFmXipEXiQlXiZaXiJlXjFNXipXXiQlXihDXixuXjYyXjUtXiEiXiE2Xis3XiR+IA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_19b4496cd361",
      "text": "陶幣才能平息我的怒氣。",
      "encoded_ascii": "^)R^+|^$,^'b^0Y^#w^$%^&Z^#o^%U^!\"",
      "encoded_base64": "XilSXit8XiQsXidiXjBZXiN3XiQlXiZaXiNvXiVVXiEi",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_e26c8898f611",
      "text": " 不行！我會碾碎你！",
      "encoded_ascii": " ^!)^(;^*W^$%^$r^0$^&o^*F^*W",
      "encoded_base64": "IF4hKV4oO14qV14kJV4kcl4wJF4mb14qRl4qVw==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_c8d82afd7754",
      "text": "現在我們得處理這起移交差事了。 ",
      "encoded_ascii": "^&?^\"d^$%^*{^#e^(,^&A^(s^.(^'\"^0P^48^*r^*D^!\" ",
      "encoded_base64": "XiY/XiJkXiQlXip7XiNlXigsXiZBXihzXi4oXiciXjBQXjQ4XipyXipEXiEiIA==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_4bf6ef1b4899",
      "text": "「旅人」，是吧？蠢貨！平時我肯定把你們抓去當奴隸，但 ",
      "encoded_ascii": "^!#^2m^!<^!$^*A^,X^*I^.V^.u^.w^*W^0Y^$f^$%^-Z^#.^$1^*F^*{^$2^\"6^&N^##^)Z^*A^!I ",
      "encoded_base64": "XiEjXjJtXiE8XiEkXipBXixYXipJXi5WXi51Xi53XipXXjBZXiRmXiQlXi1aXiMuXiQxXipGXip7XiQyXiI2XiZOXiMjXilaXipBXiFJIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_687f840e1a90",
      "text": "我們的任務太重要了，絕不能留下任何活口。你們必須死！",
      "encoded_ascii": "^$%^*{^&Z^!C^+4^+f^))^(C^*D^*A^-I^!)^'b^-+^!(^!C^!L^%i^\"<^!\"^*F^*{^#l^)r^%L^*W",
      "encoded_base64": "XiQlXip7XiZaXiFDXis0XitmXikpXihDXipEXipBXi1JXiEpXidiXi0rXiEoXiFDXiFMXiVpXiI8XiEiXipGXip7XiNsXilyXiVMXipX",
      "byte_length": 78
    },
    {
      "unit_id": "DLG_3e97ba0930a5",
      "text": "匕首抓住了那個奴隸，奴隸毫不反抗地立刻投降了。",
      "encoded_ascii": "^\"(^)~^$2^*z^*D^)!^!V^##^)Z^*A^##^)Z^/t^!)^\"9^$4^\"e^0'^.Y^$3^)N^*D^!\"",
      "encoded_base64": "XiIoXil+XiQyXip6XipEXikhXiFWXiMjXilaXipBXiMjXilaXi90XiEpXiI5XiQ0XiJlXjAnXi5ZXiQzXilOXipEXiEi",
      "byte_length": 69
    },
    {
      "unit_id": "DLG_df9ec6f105a9",
      "text": "  試圖營救那個奴隸。",
      "encoded_ascii": "  ^-u^\"b^&'^,Q^)!^!V^##^)Z^!\"",
      "encoded_base64": "ICBeLXVeImJeJideLFFeKSFeIVZeIyNeKVpeISI=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_b18735dd5667",
      "text": "  任由捕奴隊帶走那個奴隸。",
      "encoded_ascii": "  ^!C^&I^4?^##^)U^#N^.&^)!^!V^##^)Z^!\"",
      "encoded_base64": "ICBeIUNeJkleND9eIyNeKVVeI05eLiZeKSFeIVZeIyNeKVpeISI=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_c09fe6bad4d4",
      "text": "捕奴隊離開了，並帶走了那個奴隸。",
      "encoded_ascii": "^4?^##^)U^)`^)F^*D^*A^!+^#N^.&^*D^)!^!V^##^)Z^!\"",
      "encoded_base64": "XjQ/XiMjXilVXilgXilGXipEXipBXiErXiNOXi4mXipEXikhXiFWXiMjXilaXiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_44e96f245373",
      "text": "！給我滾上來！輪到你們進競技場了！ ",
      "encoded_ascii": "^*W^'A^$%^,z^!'^!O^*W^(h^!u^*F^*{^(w^-?^,>^\"n^*D^*W ",
      "encoded_base64": "XipXXidBXiQlXix6XiEnXiFPXipXXihoXiF1XipGXip7Xih3Xi0/Xiw+XiJuXipEXipXIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_3f75daf94ca0",
      "text": "既然你叫了我，那就是開打的時候了！ ",
      "encoded_ascii": "^,U^&\"^*F^+<^*D^$%^*A^)!^*J^,X^)F^$-^&Z^$f^*|^*D^*W ",
      "encoded_base64": "XixVXiYiXipGXis8XipEXiQlXipBXikhXipKXixYXilGXiQtXiZaXiRmXip8XipEXipXIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_57163620c8ce",
      "text": "碎腿者！去把角鬥士押上來！",
      "encoded_ascii": "^&o^'h^'V^*W^\"6^$1^(H^*,^+a^7Z^!'^!O^*W",
      "encoded_base64": "XiZvXidoXidWXipXXiI2XiQxXihIXiosXithXjdaXiEnXiFPXipX",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_ca73b28ad1cd",
      "text": "我可不是閒著沒事在這裡乾等的。快滾進去給我打！ ",
      "encoded_ascii": "^$%^\"A^!)^,X^6A^-a^%\\^*r^\"d^(s^-j^*X^'-^&Z^!\"^*L^,z^(w^\"6^'A^$%^$-^*W ",
      "encoded_base64": "XiQlXiJBXiEpXixYXjZBXi1hXiVcXipyXiJkXihzXi1qXipYXictXiZaXiEiXipMXix6Xih3XiI2XidBXiQlXiQtXipXIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_024cdf419ea4",
      "text": "我剛才還看見他們呢。他們肯定是企圖逃跑。 ",
      "encoded_ascii": "^$%^+0^$,^.7^*Q^-m^!@^*{^+C^!\"^!@^*{^-Z^#.^,X^4-^\"b^(p^(_^!\" ",
      "encoded_base64": "XiQlXiswXiQsXi43XipRXi1tXiFAXip7XitDXiEiXiFAXip7Xi1aXiMuXixYXjQtXiJiXihwXihfXiEiIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_e06f4451e1e4",
      "text": "夠了！時間到了！",
      "encoded_ascii": "^+d^*D^*W^$f^)G^!u^*D^*W",
      "encoded_base64": "XitkXipEXipXXiRmXilHXiF1XipEXipX",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_4ace9102c60a",
      "text": "不聽話的角鬥士！壞角鬥士！ ",
      "encoded_ascii": "^!)^-X^-v^&Z^(H^*,^+a^*W^\"v^(H^*,^+a^*W ",
      "encoded_base64": "XiEpXi1YXi12XiZaXihIXiosXithXipXXiJ2XihIXiosXithXipXIA==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_fd590bffda6b",
      "text": "庫爾扎克叫我把你們帶進競技場。要是你們不肯去， ",
      "encoded_ascii": "^,#^&/^,=^!d^+<^$%^$1^*F^*{^#N^(w^-?^,>^\"n^!\"^(C^,X^*F^*{^!)^-Z^\"6^*A ",
      "encoded_base64": "XiwjXiYvXiw9XiFkXis8XiQlXiQxXipGXip7XiNOXih3Xi0/Xiw+XiJuXiEiXihDXixYXipGXip7XiEpXi1aXiI2XipBIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_998931d39f4b",
      "text": "你們可就有大麻煩了。",
      "encoded_ascii": "^*F^*{^\"A^*J^$s^\"z^*6^-!^*D^!\"",
      "encoded_base64": "XipGXip7XiJBXipKXiRzXiJ6Xio2Xi0hXipEXiEi",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_c2a5d2e2e7f6",
      "text": "我已經警告過你們了。現在快去。",
      "encoded_ascii": "^$%^#J^'D^(S^+B^(x^*F^*{^*D^!\"^&?^\"d^*L^\"6^!\"",
      "encoded_base64": "XiQlXiNKXidEXihTXitCXih4XipGXip7XipEXiEiXiY/XiJkXipMXiI2XiEi",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_a820e4f4b35a",
      "text": "你們該找的人是庫爾扎克。我只不過是個訓獸師。 ",
      "encoded_ascii": "^*F^*{^(M^$/^&Z^!<^,X^,#^&/^,=^!d^!\"^$%^\"?^!)^(x^,X^!V^-p^&<^#M^!\" ",
      "encoded_base64": "XipGXip7XihNXiQvXiZaXiE8XixYXiwjXiYvXiw9XiFkXiEiXiQlXiI/XiEpXih4XixYXiFWXi1wXiY8XiNNXiEiIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_4cd26b2f929a",
      "text": "  我該信任米爾隆嗎？ ",
      "encoded_ascii": "  ^$%^(M^!U^!C^'4^&/^)T^+X^.V ",
      "encoded_base64": "ICBeJCVeKE1eIVVeIUNeJzReJi9eKVReK1heLlYg",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_15fafbfe1c36",
      "text": "  我下一場要對付什麼對手？",
      "encoded_ascii": "  ^$%^!(^!%^\"n^(C^#:^*u^!=^.T^#:^$+^.V",
      "encoded_base64": "ICBeJCVeISheISVeIm5eKENeIzpeKnVeIT1eLlReIzpeJCteLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_ef91d95dd653",
      "text": "  我該怎麼逃離這裡？ ",
      "encoded_ascii": "  ^$%^(M^,,^.T^(p^)`^(s^-j^.V ",
      "encoded_base64": "ICBeJCVeKE1eLCxeLlReKHBeKWBeKHNeLWpeLlYg",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_4f8a3b44d15f",
      "text": "再見，角鬥士。 ",
      "encoded_ascii": "^!l^-m^*A^(H^*,^+a^!\" ",
      "encoded_base64": "XiFsXi1tXipBXihIXiosXithXiEiIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_f6bc539060ab",
      "text": "我不知道。 ",
      "encoded_ascii": "^$%^!)^&h^(y^!\" ",
      "encoded_base64": "XiQlXiEpXiZoXih5XiEiIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_2ede7875949d",
      "text": "我不知道。現在說還太早了。 ",
      "encoded_ascii": "^$%^!)^&h^(y^!\"^&?^\"d^-x^.7^+f^,V^*D^!\" ",
      "encoded_base64": "XiQlXiEpXiZoXih5XiEiXiY/XiJkXi14Xi43XitmXixWXipEXiEiIA==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_4bc93b99d3a6",
      "text": "那是個驚喜。",
      "encoded_ascii": "^)!^,X^!V^.Q^+V^!\"",
      "encoded_base64": "XikhXixYXiFWXi5RXitWXiEi",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_1513f1779e4d",
      "text": "我想他們會扔幾個穆爾人和半身人來跟你們對決吧。",
      "encoded_ascii": "^$%^,1^!@^*{^$r^8{^#T^!V^8K^&/^!<^\"O^\"-^(c^!<^!O^.+^*F^*{^#:^,o^*I^!\"",
      "encoded_base64": "XiQlXiwxXiFAXip7XiRyXjh7XiNUXiFWXjhLXiYvXiE8XiJPXiItXihjXiE8XiFPXi4rXipGXip7XiM6XixvXipJXiEi",
      "byte_length": 69
    },
    {
      "unit_id": "DLG_3493fc4895c4",
      "text": "你們會對上他們剛抓到的 ",
      "encoded_ascii": "^*F^*{^$r^#:^!'^!@^*{^+0^$2^!u^&Z ",
      "encoded_base64": "XipGXip7XiRyXiM6XiEnXiFAXip7XiswXiQyXiF1XiZaIA==",
      "byte_length": 34
    },
    {
      "unit_id": "DLG_8145cfb8f1fd",
      "text": "螳螂人與托爾螳螂人。",
      "encoded_ascii": "^8O^8N^!<^'p^/-^&/^8O^8N^!<^!\"",
      "encoded_base64": "XjhPXjhOXiE8XidwXi8tXiYvXjhPXjhOXiE8XiEi",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_b7328a141f87",
      "text": "他們決定用一隻山脈追蹤者和幾隻 ",
      "encoded_ascii": "^!@^*{^,o^#.^&H^!%^)[^11^6i^(o^(b^'V^\"O^#T^)[ ",
      "encoded_base64": "XiFAXip7XixvXiMuXiZIXiElXilbXjExXjZpXihvXihiXidWXiJPXiNUXilbIA==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_a2e5053ff77a",
      "text": "斯拉格人來試試你們的身手——看看你們是不是真有自己吹的那麼厲害。",
      "encoded_ascii": "^$[^$6^%*^!<^!O^-u^-u^*F^*{^&Z^(c^$+^*n^*n^*Q^*Q^*F^*{^,X^!)^,X^-2^$s^'l^#I^+A^&Z^)!^.T^+:^#/^!\"",
      "encoded_base64": "XiRbXiQ2XiUqXiE8XiFPXi11Xi11XipGXip7XiZaXihjXiQrXipuXipuXipRXipRXipGXip7XixYXiEpXixYXi0yXiRzXidsXiNJXitBXiZaXikhXi5UXis6XiMvXiEi",
      "byte_length": 96
    },
    {
      "unit_id": "DLG_23644315eb54",
      "text": "我也不清楚他們給你們準備了什麼。我只希望等我得把你們的屍體 ",
      "encoded_ascii": "^$%^!1^!)^,u^,c^!@^*{^'A^*F^*{^,x^+\"^*D^!=^.T^!\"^$%^\"?^+{^,]^'-^$%^#e^$1^*F^*{^&Z^#?^** ",
      "encoded_base64": "XiQlXiExXiEpXix1XixjXiFAXip7XidBXipGXip7Xix4XisiXipEXiE9Xi5UXiEiXiQlXiI/Xit7XixdXictXiQlXiNlXiQxXipGXip7XiZaXiM/XioqIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_371bef9b21da",
      "text": "拖出來的時候，你們的屍身別太沉重就好。",
      "encoded_ascii": "^.f^!q^!O^&Z^$f^*|^*A^*F^*{^&Z^#?^(c^*H^+f^%Z^))^*J^+i^!\"",
      "encoded_base64": "Xi5mXiFxXiFPXiZaXiRmXip8XipBXipGXip7XiZaXiM/XihjXipIXitmXiVaXikpXipKXitpXiEi",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_cd31cf89b7fc",
      "text": "我都記不清了。反正不管是什麼你們都能打贏的。 ",
      "encoded_ascii": "^$%^)$^(K^!)^,u^*D^!\"^\"9^%H^!)^-D^,X^!=^.T^*F^*{^)$^'b^$-^.%^&Z^!\" ",
      "encoded_base64": "XiQlXikkXihLXiEpXix1XipEXiEiXiI5XiVIXiEpXi1EXixYXiE9Xi5UXipGXip7XikkXidiXiQtXi4lXiZaXiEiIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_41bd7536daae",
      "text": "你們是我們這裡見過最棒的！ ",
      "encoded_ascii": "^*F^*{^,X^$%^*{^(s^-j^-m^(x^$q^%1^&Z^*W ",
      "encoded_base64": "XipGXip7XixYXiQlXip7XihzXi1qXi1tXih4XiRxXiUxXiZaXipXIA==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_58dfc5cedec0",
      "text": "草堆裡沒有別的東西了。 ",
      "encoded_ascii": "^*f^*[^-j^%\\^$s^*H^&Z^,`^-l^*D^!\" ",
      "encoded_base64": "XipmXipbXi1qXiVcXiRzXipIXiZaXixgXi1sXipEXiEiIA==",
      "byte_length": 34
    },
    {
      "unit_id": "DLG_a2804df9f5d5",
      "text": "要搜尋草堆嗎？ ",
      "encoded_ascii": "^(C^/h^#9^*f^*[^+X^.V ",
      "encoded_base64": "XihDXi9oXiM5XipmXipbXitYXi5WIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_65922b5f6d7f",
      "text": "戰鬥進行中你無法搜尋草堆。 ",
      "encoded_ascii": "^$(^*,^(w^(;^!,^*F^%}^%b^/h^#9^*f^*[^!\" ",
      "encoded_base64": "XiQoXiosXih3Xig7XiEsXipGXiV9XiViXi9oXiM5XipmXipbXiEiIA==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_f6083cd472cb",
      "text": "喂——離那東西遠點，不然我只好宰了你！",
      "encoded_ascii": "^;c^*n^*n^)`^)!^,`^-l^({^*;^*A^!)^&\"^$%^\"?^+i^1w^*D^*F^*W",
      "encoded_base64": "XjtjXipuXipuXilgXikhXixgXi1sXih7Xio7XipBXiEpXiYiXiQlXiI/XitpXjF3XipEXipGXipX",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_9c4a23936800",
      "text": "無論如何都要翻查草堆嗎？ ",
      "encoded_ascii": "^%}^1\\^#$^!L^)$^(C^-Q^%&^*f^*[^+X^.V ",
      "encoded_base64": "XiV9XjFcXiMkXiFMXikkXihDXi1RXiUmXipmXipbXitYXi5WIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_18b55037135d",
      "text": "你找到了一大袋陶幣。 ",
      "encoded_ascii": "^*F^$/^!u^*D^!%^\"z^(?^)R^+|^!\" ",
      "encoded_base64": "XipGXiQvXiF1XipEXiElXiJ6Xig/XilSXit8XiEiIA==",
      "byte_length": 31
    },
    {
      "unit_id": "DLG_90159f5c4697",
      "text": "戰鬥進行中你無法打開格柵門。",
      "encoded_ascii": "^$(^*,^(w^(;^!,^*F^%}^%b^$-^)F^%*^%(^)D^!\"",
      "encoded_base64": "XiQoXiosXih3Xig7XiEsXipGXiV9XiViXiQtXilGXiUqXiUoXilEXiEi",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_9d579d4f7f1e",
      "text": "格柵門鎖住了。",
      "encoded_ascii": "^%*^%(^)D^)8^*z^*D^!\"",
      "encoded_base64": "XiUqXiUoXilEXik4Xip6XipEXiEi",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_c3a2dc497970",
      "text": "你要進入下水道嗎？",
      "encoded_ascii": "^*F^(C^(w^!f^!(^%V^(y^+X^.V",
      "encoded_base64": "XipGXihDXih3XiFmXiEoXiVWXih5XitYXi5W",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_bdfd8887f2f6",
      "text": "你已逃離了奴隸欄",
      "encoded_ascii": "^*F^#J^(p^)`^*D^##^)Z^%C",
      "encoded_base64": "XipGXiNKXihwXilgXipEXiMjXilaXiVD",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_9b92e411e3d1",
      "text": " 且未驚動警報",
      "encoded_ascii": " ^!*^,_^.Q^\"%^(S^+`",
      "encoded_base64": "IF4hKl4sX14uUV4iJV4oU14rYA==",
      "byte_length": 19
    },
    {
      "unit_id": "DLG_f762fe08b393",
      "text": "你沒有進入格柵門。 ",
      "encoded_ascii": "^*F^%\\^$s^(w^!f^%*^%(^)D^!\" ",
      "encoded_base64": "XipGXiVcXiRzXih3XiFmXiUqXiUoXilEXiEiIA==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_872f76f485ac",
      "text": "格柵門打開了。 ",
      "encoded_ascii": "^%*^%(^)D^$-^)F^*D^!\" ",
      "encoded_base64": "XiUqXiUoXilEXiQtXilGXipEXiEiIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_0402e7fb2135",
      "text": "你要打開格柵門嗎？",
      "encoded_ascii": "^*F^(C^$-^)F^%*^%(^)D^+X^.V",
      "encoded_base64": "XipGXihDXiQtXilGXiUqXiUoXilEXitYXi5W",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_e7e3c63f08ee",
      "text": "  嘗試撬開鎖。",
      "encoded_ascii": "  ^1o^-u^6]^)F^)8^!\"",
      "encoded_base64": "ICBeMW9eLXVeNl1eKUZeKTheISI=",
      "byte_length": 20
    },
    {
      "unit_id": "DLG_f4d26da5cd9d",
      "text": "  硬扯開來。",
      "encoded_ascii": "  ^25^.e^)F^!O^!\"",
      "encoded_base64": "ICBeMjVeLmVeKUZeIU9eISI=",
      "byte_length": 17
    },
    {
      "unit_id": "DLG_380619793630",
      "text": "  砍斷鎖頭。",
      "encoded_ascii": "  ^&l^,T^)8^)t^!\"",
      "encoded_base64": "ICBeJmxeLFReKTheKXReISI=",
      "byte_length": 17
    },
    {
      "unit_id": "DLG_eea79467b66c",
      "text": "離開格柵門。",
      "encoded_ascii": "^)`^)F^%*^%(^)D^!\"",
      "encoded_base64": "XilgXilGXiUqXiUoXilEXiEi",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_5fd299027463",
      "text": " 成功撬開了鎖。 ",
      "encoded_ascii": " ^$$^\"!^6]^)F^*D^)8^!\" ",
      "encoded_base64": "IF4kJF4iIV42XV4pRl4qRF4pOF4hIiA=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_64cd6dce7ad1",
      "text": " 無法撬開這把鎖。 ",
      "encoded_ascii": " ^%}^%b^6]^)F^(s^$1^)8^!\" ",
      "encoded_base64": "IF4lfV4lYl42XV4pRl4oc14kMV4pOF4hIiA=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_40586c147ac7",
      "text": " 成功砍斷了鎖頭，使用的是他的 ",
      "encoded_ascii": " ^$$^\"!^&l^,T^*D^)8^)t^*A^!N^&H^&Z^,X^!@^&Z ",
      "encoded_base64": "IF4kJF4iIV4mbF4sVF4qRF4pOF4pdF4qQV4hTl4mSF4mWl4sWF4hQF4mWiA=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_0f4f9bf01125",
      "text": " 在格柵門上撞碎了。 ",
      "encoded_ascii": " ^\"d^%*^%(^)D^!'^/l^&o^*D^!\" ",
      "encoded_base64": "IF4iZF4lKl4lKF4pRF4hJ14vbF4mb14qRF4hIiA=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_fe49e2dc2c5b",
      "text": " 硬生生掰斷了鎖頭。 ",
      "encoded_ascii": " ^25^&F^&F^>,^,T^*D^)8^)t^!\" ",
      "encoded_base64": "IF4yNV4mRl4mRl4+LF4sVF4qRF4pOF4pdF4hIiA=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_20ea7f1ccf2e",
      "text": " 弄傷了 ",
      "encoded_ascii": " ^/`^!^^*D ",
      "encoded_base64": "IF4vYF4hXl4qRCA=",
      "byte_length": 11
    },
    {
      "unit_id": "DLG_7237305c5f82",
      "text": "他的 ",
      "encoded_ascii": "^!@^&Z ",
      "encoded_base64": "XiFAXiZaIA==",
      "byte_length": 7
    },
    {
      "unit_id": "DLG_c523b98d0d42",
      "text": "她的 ",
      "encoded_ascii": "^+h^&Z ",
      "encoded_base64": "XitoXiZaIA==",
      "byte_length": 7
    },
    {
      "unit_id": "DLG_408cd9ac5f35",
      "text": "手，試圖硬扯開格柵門。但門依然上鎖著。 ",
      "encoded_ascii": "^$+^*A^-u^\"b^25^.e^)F^%*^%(^)D^!\"^!I^)D^!Q^&\"^!'^)8^-a^!\" ",
      "encoded_base64": "XiQrXipBXi11XiJiXjI1Xi5lXilGXiUqXiUoXilEXiEiXiFJXilEXiFRXiYiXiEnXik4Xi1hXiEiIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_cd0c702fe292",
      "text": " 砸壞了鎖頭。 ",
      "encoded_ascii": " ^0#^\"v^*D^)8^)t^!\" ",
      "encoded_base64": "IF4wI14idl4qRF4pOF4pdF4hIiA=",
      "byte_length": 20
    },
    {
      "unit_id": "DLG_8a7d0a5d5f61",
      "text": "未能破壞鎖頭。 ",
      "encoded_ascii": "^,_^'b^&n^\"v^)8^)t^!\" ",
      "encoded_base64": "XixfXidiXiZuXiJ2Xik4Xil0XiEiIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_da6bc1d91fbb",
      "text": "要進入競技場嗎？",
      "encoded_ascii": "^(C^(w^!f^-?^,>^\"n^+X^.V",
      "encoded_base64": "XihDXih3XiFmXi0/Xiw+XiJuXitYXi5W",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_78496ee40108",
      "text": "通往競技場的大門在你們身後砰然關閉。 ",
      "encoded_ascii": "^(t^,)^-?^,>^\"n^&Z^\"z^)D^\"d^*F^*{^(c^#b^>-^&\"^.>^.=^!\" ",
      "encoded_base64": "Xih0XiwpXi0/Xiw+XiJuXiZaXiJ6XilEXiJkXipGXip7XihjXiNiXj4tXiYiXi4+Xi49XiEiIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_0efe63b11bee",
      "text": "這場混戰結束後，你們可以往北走，我們往南走。 ",
      "encoded_ascii": "^(s^\"n^%n^$(^'@^$|^#b^*A^*F^*{^\"A^!B^,)^+6^.&^*A^$%^*{^,)^\"/^.&^!\" ",
      "encoded_base64": "XihzXiJuXiVuXiQoXidAXiR8XiNiXipBXipGXip7XiJBXiFCXiwpXis2Xi4mXipBXiQlXip7XiwpXiIvXi4mXiEiIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_2dce9246eb35",
      "text": "我們的道路就在這裡分開了。你們繼續往北走。我們則會嘗試 ",
      "encoded_ascii": "^$%^*{^&Z^(y^(a^*J^\"d^(s^-j^!s^)F^*D^!\"^*F^*{^-O^'M^,)^+6^.&^!\"^$%^*{^!x^$r^1o^-u ",
      "encoded_base64": "XiQlXip7XiZaXih5XihhXipKXiJkXihzXi1qXiFzXilGXipEXiEiXipGXip7Xi1PXidNXiwpXis2Xi4mXiEiXiQlXip7XiF4XiRyXjFvXi11IA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_0d385f8e972f",
      "text": "往南逃脫。祝好運！",
      "encoded_ascii": "^,)^\"/^(p^'c^!\"^&v^+i^.4^*W",
      "encoded_base64": "XiwpXiIvXihwXidjXiEiXiZ2XitpXi40XipX",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_ec431c08c7d3",
      "text": "聖堂武士 ",
      "encoded_ascii": "^'Z^42^%J^+a ",
      "encoded_base64": "XidaXjQyXiVKXithIA==",
      "byte_length": 13
    },
    {
      "unit_id": "DLG_766056d5fc12",
      "text": "守衛 ",
      "encoded_ascii": "^#+^(= ",
      "encoded_base64": "XiMrXig9IA==",
      "byte_length": 7
    },
    {
      "unit_id": "DLG_c9077a47725e",
      "text": "試圖呼救，但噴泉的轟鳴聲掩蓋了他的聲音。",
      "encoded_ascii": "^-u^\"b^\"M^,Q^*A^!I^\"W^%a^&Z^.y^.|^-W^9~^-d^*D^!@^&Z^-W^34^!\"",
      "encoded_base64": "Xi11XiJiXiJNXixRXipBXiFJXiJXXiVhXiZaXi55Xi58Xi1XXjl+Xi1kXipEXiFAXiZaXi1XXjM0XiEi",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_3a1e35f49b6d",
      "text": "救命！有人快敲響警報！快叫增援！ ",
      "encoded_ascii": "^,Q^\"N^*W^$s^!<^*L^1A^)o^(S^+`^*W^*L^+<^\"s^$C^*W ",
      "encoded_base64": "XixRXiJOXipXXiRzXiE8XipMXjFBXilvXihTXitgXipXXipMXis8XiJzXiRDXipXIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_deb98a49bd99",
      "text": "敲響警報！有囚犯逃跑了！",
      "encoded_ascii": "^1A^)o^(S^+`^*W^$s^\"Z^-%^(p^(_^*D^*W",
      "encoded_base64": "XjFBXilvXihTXitgXipXXiRzXiJaXi0lXihwXihfXipEXipX",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_dc267f4e6f56",
      "text": "忘恩負義的雜種！我們供你吃喝，正午還讓你乘涼，你就是這樣 ",
      "encoded_ascii": "^0]^#v^(W^2<^&Z^0G^'$^*W^$%^*{^!P^*F^2^^6M^*A^%H^+8^.7^-}^*F^0O^,s^*A^*F^*J^,X^(s^,f ",
      "encoded_base64": "XjBdXiN2XihXXjI8XiZaXjBHXickXipXXiQlXip7XiFQXipGXjJeXjZNXipBXiVIXis4Xi43Xi19XipGXjBPXixzXipBXipGXipKXixYXihzXixmIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_9178a9638b2d",
      "text": "報答我們的！ ",
      "encoded_ascii": "^+`^-B^$%^*{^&Z^*W ",
      "encoded_base64": "XitgXi1CXiQlXip7XiZaXipXIA==",
      "byte_length": 19
    },
    {
      "unit_id": "DLG_caca3048b253",
      "text": "你們活不了多久的，角鬥士們。 ",
      "encoded_ascii": "^*F^*{^%i^!)^*D^\"x^!.^&Z^*A^(H^*,^+a^*{^!\" ",
      "encoded_base64": "XipGXip7XiVpXiEpXipEXiJ4XiEuXiZaXipBXihIXiosXithXip7XiEiIA==",
      "byte_length": 43
    },
    {
      "unit_id": "DLG_d9db54becf3f",
      "text": "等我收拾完你們，你們就等著給山脈追蹤者當點心吧！ ",
      "encoded_ascii": "^'-^$%^$M^7[^#,^*F^*{^*A^*F^*{^*J^'-^-a^'A^11^6i^(o^(b^'V^&N^*;^#k^*I^*W ",
      "encoded_base64": "XictXiQlXiRNXjdbXiMsXipGXip7XipBXipGXip7XipKXictXi1hXidBXjExXjZpXihvXihiXidWXiZOXio7XiNrXipJXipXIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_511235bc5317",
      "text": "沒人問你話，就不准開口！",
      "encoded_ascii": "^%\\^!<^*Z^*F^-v^*A^*J^!)^/Q^)F^\"<^*W",
      "encoded_base64": "XiVcXiE8XipaXipGXi12XipBXipKXiEpXi9RXilGXiI8XipX",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_112302778299",
      "text": "安靜點，你！只管往前走！",
      "encoded_ascii": "^+p^)h^*;^*A^*F^*W^\"?^-D^,)^!z^.&^*W",
      "encoded_base64": "XitwXiloXio7XipBXipGXipXXiI/Xi1EXiwpXiF6Xi4mXipX",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_0457d6c4c71c",
      "text": "守衛不理睬你。 ",
      "encoded_ascii": "^#+^(=^!)^&A^:}^*F^!\" ",
      "encoded_base64": "XiMrXig9XiEpXiZBXjp9XipGXiEiIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_ac2cdb2b8394",
      "text": "守衛瞪著你並發出咆哮。 ",
      "encoded_ascii": "^#+^(=^:V^-a^*F^!+^&W^!q^.[^.\\^!\" ",
      "encoded_base64": "XiMrXig9XjpWXi1hXipGXiErXiZXXiFxXi5bXi5cXiEiIA==",
      "byte_length": 34
    },
    {
      "unit_id": "DLG_26a61c49d2a0",
      "text": "這是通往奴隸欄的正門。 ",
      "encoded_ascii": "^(s^,X^(t^,)^##^)Z^%C^&Z^%H^)D^!\" ",
      "encoded_base64": "XihzXixYXih0XiwpXiMjXilaXiVDXiZaXiVIXilEXiEiIA==",
      "byte_length": 34
    },
    {
      "unit_id": "DLG_4bc511b1c662",
      "text": "  把庫爾扎克叫來！我想打一場！ ",
      "encoded_ascii": "  ^$1^,#^&/^,=^!d^+<^!O^*W^$%^,1^$-^!%^\"n^*W ",
      "encoded_base64": "ICBeJDFeLCNeJi9eLD1eIWReKzxeIU9eKldeJCVeLDFeJC1eISVeIm5eKlcg",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_ee2ae1874bcb",
      "text": "  放我進去！是米爾隆派我來的。 ",
      "encoded_ascii": "  ^$P^$%^(w^\"6^*W^,X^'4^&/^)T^.n^$%^!O^&Z^!\" ",
      "encoded_base64": "ICBeJFBeJCVeKHdeIjZeKldeLFheJzReJi9eKVReLm5eJCVeIU9eJlpeISIg",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_003418d51434",
      "text": "  帶我去競技場！我想戰鬥！",
      "encoded_ascii": "  ^#N^$%^\"6^-?^,>^\"n^*W^$%^,1^$(^*,^*W",
      "encoded_base64": "ICBeI05eJCVeIjZeLT9eLD5eIm5eKldeJCVeLDFeJCheKixeKlc=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_dbbcc3444265",
      "text": "  啊，沒事。",
      "encoded_ascii": "  ^+Q^*A^%\\^*r^!\"",
      "encoded_base64": "ICBeK1FeKkFeJVxeKnJeISI=",
      "byte_length": 17
    },
    {
      "unit_id": "DLG_615f7a2995b1",
      "text": "很好——庫爾扎克馬上就到！能把那個 ",
      "encoded_ascii": "^*K^+i^*n^*n^,#^&/^,=^!d^*\"^!'^*J^!u^*W^'b^$1^)!^!V ",
      "encoded_base64": "XipLXitpXipuXipuXiwjXiYvXiw9XiFkXioiXiEnXipKXiF1XipXXidiXiQxXikhXiFWIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_ff0140b7b1d0",
      "text": "肥胖的豺狼雜種開膛破肚，一定大快人心！哈哈！ ",
      "encoded_ascii": "^-Y^>.^&Z^>/^21^0G^'$^)F^=2^&n^=1^*A^!%^#.^\"z^*L^!<^#k^*W^+F^+F^*W ",
      "encoded_base64": "Xi1ZXj4uXiZaXj4vXjIxXjBHXickXilGXj0yXiZuXj0xXipBXiElXiMuXiJ6XipMXiE8XiNrXipXXitGXitGXipXIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_8e61db18aa87",
      "text": "我這就來了，奴隸！ ",
      "encoded_ascii": "^$%^(s^*J^!O^*D^*A^##^)Z^*W ",
      "encoded_base64": "XiQlXihzXipKXiFPXipEXipBXiMjXilaXipXIA==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_1c15d1e9e498",
      "text": "如果不想打，就別敲門！",
      "encoded_ascii": "^#$^%!^!)^,1^$-^*A^*J^*H^1A^)D^*W",
      "encoded_base64": "XiMkXiUhXiEpXiwxXiQtXipBXipKXipIXjFBXilEXipX",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_0a06a6907788",
      "text": " 離開了此區域。 ",
      "encoded_ascii": " ^)`^)F^*D^%I^\"+^\"k^!\" ",
      "encoded_base64": "IF4pYF4pRl4qRF4lSV4iK14ia14hIiA=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_80e3a9e32b9a",
      "text": " 聽見密門關閉並上鎖的聲音。 ",
      "encoded_ascii": " ^-X^-m^#0^)D^.>^.=^!+^!'^)8^&Z^-W^34^!\" ",
      "encoded_base64": "IF4tWF4tbV4jMF4pRF4uPl4uPV4hK14hJ14pOF4mWl4tV14zNF4hIiA=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_9050b187965c",
      "text": " 發現了一扇密門。",
      "encoded_ascii": " ^&W^&?^*D^!%^$*^#0^)D^!\"",
      "encoded_base64": "IF4mV14mP14qRF4hJV4kKl4jMF4pRF4hIg==",
      "byte_length": 25
    },
    {
      "unit_id": "DLG_4341e261f244",
      "text": " 距離太遠，按不到按鈕。 ",
      "encoded_ascii": " ^2I^)`^+f^({^*A^$9^!)^!u^$9^).^!\" ",
      "encoded_base64": "IF4ySV4pYF4rZl4oe14qQV4kOV4hKV4hdV4kOV4pLl4hIiA=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_07a57a420426",
      "text": " 聽見一聲喀噠聲，西側的密門打開了。 ",
      "encoded_ascii": " ^-X^-m^!%^-W^:u^>*^-W^*A^-l^!\\^&Z^#0^)D^$-^)F^*D^!\" ",
      "encoded_base64": "IF4tWF4tbV4hJV4tV146dV4+Kl4tV14qQV4tbF4hXF4mWl4jMF4pRF4kLV4pRl4qRF4hIiA=",
      "byte_length": 53
    },
    {
      "unit_id": "DLG_7b97e774434a",
      "text": " 按下了按鈕，但什麼也沒發生。 ",
      "encoded_ascii": " ^$9^!(^*D^$9^).^*A^!I^!=^.T^!1^%\\^&W^&F^!\" ",
      "encoded_base64": "IF4kOV4hKF4qRF4kOV4pLl4qQV4hSV4hPV4uVF4hMV4lXF4mV14mRl4hIiA=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_67af55d81823",
      "text": " 發現牆上有幾道可疑的裂痕。經過一番 ",
      "encoded_ascii": " ^&W^&?^&0^!'^$s^#T^(y^\"A^0p^&Z^8r^3v^!\"^'D^(x^!%^2{ ",
      "encoded_base64": "IF4mV14mP14mMF4hJ14kc14jVF4oeV4iQV4wcF4mWl44cl4zdl4hIl4nRF4oeF4hJV4yeyA=",
      "byte_length": 53
    },
    {
      "unit_id": "DLG_f5c31b232a4b",
      "text": "摸索搜尋後， ",
      "encoded_ascii": "^/j^'>^/h^#9^#b^*A ",
      "encoded_base64": "Xi9qXic+Xi9oXiM5XiNiXipBIA==",
      "byte_length": 19
    },
    {
      "unit_id": "DLG_98df933f4a99",
      "text": "她 ",
      "encoded_ascii": "^+h ",
      "encoded_base64": "XitoIA==",
      "byte_length": 4
    },
    {
      "unit_id": "DLG_ee2f3b0a8ab1",
      "text": "在北面牆上找到了按鈕。 ",
      "encoded_ascii": "^\"d^+6^)j^&0^!'^$/^!u^*D^$9^).^!\" ",
      "encoded_base64": "XiJkXis2XilqXiYwXiEnXiQvXiF1XipEXiQ5XikuXiEiIA==",
      "byte_length": 34
    },
    {
      "unit_id": "DLG_ab4d4fb5fa0e",
      "text": " 找到了密門的位置。 ",
      "encoded_ascii": " ^$/^!u^*D^#0^)D^&Z^!J^'Q^!\" ",
      "encoded_base64": "IF4kL14hdV4qRF4jMF4pRF4mWl4hSl4nUV4hIiA=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_ad9c43db7811",
      "text": "你要把水壺裝滿嗎？",
      "encoded_ascii": "^*F^(C^$1^%V^>+^(A^,{^+X^.V",
      "encoded_base64": "XipGXihDXiQxXiVWXj4rXihBXix7XitYXi5W",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_9d475863a494",
      "text": "你必須靠近水源才能將水壺裝滿。",
      "encoded_ascii": "^*F^#l^)r^.C^(l^%V^%q^$,^'b^#7^%V^>+^(A^,{^!\"",
      "encoded_base64": "XipGXiNsXilyXi5DXihsXiVWXiVxXiQsXidiXiM3XiVWXj4rXihBXix7XiEi",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_edddb9cf01af",
      "text": "這扇門太堅固了，無法強行砸開。",
      "encoded_ascii": "^(s^$*^)D^+f^\"l^3>^*D^*A^%}^%b^#]^(;^0#^)F^!\"",
      "encoded_base64": "XihzXiQqXilEXitmXiJsXjM+XipEXipBXiV9XiViXiNdXig7XjAjXilGXiEi",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_3f68c7b9ac31",
      "text": "你的遠程武器擊中了門，但未能造成損害。 ",
      "encoded_ascii": "^*F^&Z^({^'#^%J^\"V^$F^!,^*D^)D^*A^!I^,_^'b^(v^$$^$D^#/^!\" ",
      "encoded_base64": "XipGXiZaXih7XicjXiVKXiJWXiRGXiEsXipEXilEXipBXiFJXixfXidiXih2XiQkXiREXiMvXiEiIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_fe873ed9de70",
      "text": "你把門砸爛了！ ",
      "encoded_ascii": "^*F^$1^)D^0#^&-^*D^*W ",
      "encoded_base64": "XipGXiQxXilEXjAjXiYtXipEXipXIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_128666c3cad7",
      "text": "你試圖撞倒門時撞傷了肩膀。 ",
      "encoded_ascii": "^*F^-u^\"b^/l^!X^)D^$f^/l^!^^*D^:#^96^!\" ",
      "encoded_base64": "XipGXi11XiJiXi9sXiFYXilEXiRmXi9sXiFeXipEXjojXjk2XiEiIA==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_b4feac6d658e",
      "text": "門絲毫未損。 ",
      "encoded_ascii": "^)D^'C^/t^,_^$D^!\" ",
      "encoded_base64": "XilEXidDXi90XixfXiREXiEiIA==",
      "byte_length": 19
    },
    {
      "unit_id": "DLG_b8593a886a75",
      "text": "鑰匙順暢滑入鎖孔中。門打開了。 ",
      "encoded_ascii": "^)@^\"*^.D^7x^%u^!f^)8^5G^!,^!\"^)D^$-^)F^*D^!\" ",
      "encoded_base64": "XilAXiIqXi5EXjd4XiV1XiFmXik4XjVHXiEsXiEiXilEXiQtXilGXipEXiEiIA==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_d923972d5cdf",
      "text": "完全吻合。門輕易解鎖了。 ",
      "encoded_ascii": "^#,^!h^;t^\"C^!\"^)D^(g^,W^(I^)8^*D^!\" ",
      "encoded_base64": "XiMsXiFoXjt0XiJDXiEiXilEXihnXixXXihJXik4XipEXiEiIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_216889074416",
      "text": "門鎖住了。它看起來相當堅固。 ",
      "encoded_ascii": "^)D^)8^*z^*D^!\"^+o^*Q^.(^!O^&a^&N^\"l^3>^!\" ",
      "encoded_base64": "XilEXik4Xip6XipEXiEiXitvXipRXi4oXiFPXiZhXiZOXiJsXjM+XiEiIA==",
      "byte_length": 43
    },
    {
      "unit_id": "DLG_3d9590e91727",
      "text": "要嘗試撬鎖嗎？ ",
      "encoded_ascii": "^(C^1o^-u^6]^)8^+X^.V ",
      "encoded_base64": "XihDXjFvXi11XjZdXik4XitYXi5WIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_2c4b720c9184",
      "text": "你成功撬開了鎖。 ",
      "encoded_ascii": "^*F^$$^\"!^6]^)F^*D^)8^!\" ",
      "encoded_base64": "XipGXiQkXiIhXjZdXilGXipEXik4XiEiIA==",
      "byte_length": 25
    },
    {
      "unit_id": "DLG_d67c30989027",
      "text": "門依然鎖著。 ",
      "encoded_ascii": "^)D^!Q^&\"^)8^-a^!\" ",
      "encoded_base64": "XilEXiFRXiYiXik4Xi1hXiEiIA==",
      "byte_length": 19
    },
    {
      "unit_id": "DLG_0e701878a077",
      "text": "門卡住了，保持敞開狀態！ ",
      "encoded_ascii": "^)D^\"0^*z^*D^*A^!T^$7^*d^)F^&7^#|^*W ",
      "encoded_base64": "XilEXiIwXip6XipEXipBXiFUXiQ3XipkXilGXiY3XiN8XipXIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_0bdf3ef909aa",
      "text": "要嘗試鬆開它嗎？",
      "encoded_ascii": "^(C^1o^-u^.R^)F^+o^+X^.V",
      "encoded_base64": "XihDXjFvXi11Xi5SXilGXitvXitYXi5W",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_76da3ff091b8",
      "text": "你成功關上了門。門在你們身後上鎖了。 ",
      "encoded_ascii": "^*F^$$^\"!^.>^!'^*D^)D^!\"^)D^\"d^*F^*{^(c^#b^!'^)8^*D^!\" ",
      "encoded_base64": "XipGXiQkXiIhXi4+XiEnXipEXilEXiEiXilEXiJkXipGXip7XihjXiNiXiEnXik4XipEXiEiIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_7130e41c4099",
      "text": "你無法把門關上。 ",
      "encoded_ascii": "^*F^%}^%b^$1^)D^.>^!'^!\" ",
      "encoded_base64": "XipGXiV9XiViXiQxXilEXi4+XiEnXiEiIA==",
      "byte_length": 25
    },
    {
      "unit_id": "DLG_fe64ac8ab722",
      "text": "噢，那扇門通往噴泉和聖堂武士長那裡。 ",
      "encoded_ascii": "^+]^*A^)!^$*^)D^(t^,)^\"W^%a^\"O^'Z^42^%J^+a^)C^)!^-j^!\" ",
      "encoded_base64": "XitdXipBXikhXiQqXilEXih0XiwpXiJXXiVhXiJPXidaXjQyXiVKXithXilDXikhXi1qXiEiIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_ebfac3345f39",
      "text": "只有特權管事、聖堂武士長和庫爾扎克有鑰匙。 ",
      "encoded_ascii": "^\"?^$s^&5^1E^-D^*r^!!^'Z^42^%J^+a^)C^\"O^,#^&/^,=^!d^$s^)@^\"*^!\" ",
      "encoded_base64": "XiI/XiRzXiY1XjFFXi1EXipyXiEhXidaXjQyXiVKXithXilDXiJPXiwjXiYvXiw9XiFkXiRzXilAXiIqXiEiIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_36a52708fc8f",
      "text": "門依然立著未倒。 ",
      "encoded_ascii": "^)D^!Q^&\"^0'^-a^,_^!X^!\" ",
      "encoded_base64": "XilEXiFRXiYiXjAnXi1hXixfXiFYXiEiIA==",
      "byte_length": 25
    },
    {
      "unit_id": "DLG_a4fdf3fff1d5",
      "text": "要是我，就不會開那扇門。 ",
      "encoded_ascii": "^(C^,X^$%^*A^*J^!)^$r^)F^)!^$*^)D^!\" ",
      "encoded_base64": "XihDXixYXiQlXipBXipKXiEpXiRyXilGXikhXiQqXilEXiEiIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_a4bb5164ec3f",
      "text": "  為什麼不？ ",
      "encoded_ascii": "  ^%{^!=^.T^!)^.V ",
      "encoded_base64": "ICBeJXteIT1eLlReISleLlYg",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_de4eb723dad2",
      "text": "  所以你才到現在都還是個奴隸。 ",
      "encoded_ascii": "  ^$)^!B^*F^$,^!u^&?^\"d^)$^.7^,X^!V^##^)Z^!\" ",
      "encoded_base64": "ICBeJCleIUJeKkZeJCxeIXVeJj9eImReKSReLjdeLFheIVZeIyNeKVpeISIg",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_27a6c337a2f3",
      "text": "  謝了。 ",
      "encoded_ascii": "  ^-z^*D^!\" ",
      "encoded_base64": "ICBeLXpeKkReISIg",
      "byte_length": 12
    },
    {
      "unit_id": "DLG_fff18f62ad97",
      "text": "嘗試開門嗎？ ",
      "encoded_ascii": "^1o^-u^)F^)D^+X^.V ",
      "encoded_base64": "XjFvXi11XilGXilEXitYXi5WIA==",
      "byte_length": 19
    },
    {
      "unit_id": "DLG_0e378659c6f3",
      "text": "門打不開，它看起來很堅固。 ",
      "encoded_ascii": "^)D^$-^!)^)F^*A^+o^*Q^.(^!O^*K^\"l^3>^!\" ",
      "encoded_base64": "XilEXiQtXiEpXilGXipBXitvXipRXi4oXiFPXipLXiJsXjM+XiEiIA==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_557a606e9694",
      "text": "門的這一側沒有把手！ ",
      "encoded_ascii": "^)D^&Z^(s^!%^!\\^%\\^$s^$1^$+^*W ",
      "encoded_base64": "XilEXiZaXihzXiElXiFcXiVcXiRzXiQxXiQrXipXIA==",
      "byte_length": 31
    },
    {
      "unit_id": "DLG_5fd843e05113",
      "text": "  撬鎖。 ",
      "encoded_ascii": "  ^6]^)8^!\" ",
      "encoded_base64": "ICBeNl1eKTheISIg",
      "byte_length": 12
    },
    {
      "unit_id": "DLG_d812fa2898e3",
      "text": "  大喊『開門！』",
      "encoded_ascii": "  ^\"z^+S^<_^)F^)D^*W^<`",
      "encoded_base64": "ICBeInpeK1NePF9eKUZeKUReKldePGA=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_c182bda29716",
      "text": "  敲門。 ",
      "encoded_ascii": "  ^1A^)D^!\" ",
      "encoded_base64": "ICBeMUFeKUReISIg",
      "byte_length": 12
    },
    {
      "unit_id": "DLG_88391f43add1",
      "text": "  拆下門上的鉸鏈。 ",
      "encoded_ascii": "  ^=o^!(^)D^!'^&Z^>0^)<^!\" ",
      "encoded_base64": "ICBePW9eISheKUReISdeJlpePjBeKTxeISIg",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_7e73d0fa1342",
      "text": "喂——別那樣做！住在裡面的不管是什麼東西，都會把我們全殺光的！ ",
      "encoded_ascii": "^;c^*n^*n^*H^)!^,f^*~^*W^*z^\"d^-j^)j^&Z^!)^-D^,X^!=^.T^,`^-l^*A^)$^$r^$1^$%^*{^!h^%M^!c^&Z^*W ",
      "encoded_base64": "XjtjXipuXipuXipIXikhXixmXip+XipXXip6XiJkXi1qXilqXiZaXiEpXi1EXixYXiE9Xi5UXixgXi1sXipBXikkXiRyXiQxXiQlXip7XiFoXiVNXiFjXiZaXipXIA==",
      "byte_length": 94
    },
    {
      "unit_id": "DLG_5a536156d2cf",
      "text": "  是喔，難道裡面鬧鬼不成？ ",
      "encoded_ascii": "  ^,X^+T^*A^)a^(y^-j^)j^6G^*-^!)^$$^.V ",
      "encoded_base64": "ICBeLFheK1ReKkFeKWFeKHleLWpeKWpeNkdeKi1eISleJCReLlYg",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_a3a132fb6fe4",
      "text": "  你很強悍，你挺得住的！ ",
      "encoded_ascii": "  ^*F^*K^#]^,-^*A^*F^,I^#e^*z^&Z^*W ",
      "encoded_base64": "ICBeKkZeKkteI11eLC1eKkFeKkZeLEleI2VeKnpeJlpeKlcg",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_0c042b024521",
      "text": "  好吧，放輕鬆。我不會開門的。 ",
      "encoded_ascii": "  ^+i^*I^*A^$P^(g^.R^!\"^$%^!)^$r^)F^)D^&Z^!\" ",
      "encoded_base64": "ICBeK2leKkleKkFeJFBeKGdeLlJeISJeJCVeISleJHJeKUZeKUReJlpeISIg",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_7624a53214c5",
      "text": "費了一點工夫，你把整扇門完全拆了下來。 ",
      "encoded_ascii": "^.\"^*D^!%^*;^+y^\"{^*A^*F^$1^$T^$*^)D^#,^!h^=o^*D^!(^!O^!\" ",
      "encoded_base64": "Xi4iXipEXiElXio7Xit5XiJ7XipBXipGXiQxXiRUXiQqXilEXiMsXiFoXj1vXipEXiEoXiFPXiEiIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_dd636bca99a3",
      "text": "沒人回應你的呼喊。",
      "encoded_ascii": "^%\\^!<^\"\\^0`^*F^&Z^\"M^+S^!\"",
      "encoded_base64": "XiVcXiE8XiJcXjBgXipGXiZaXiJNXitTXiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_ae636df19cc7",
      "text": "裡面就是鬧鬼，明擺著的事。沒什麼好說的了。 ",
      "encoded_ascii": "^-j^)j^*J^,X^6G^*-^*A^$c^1@^-a^&Z^*r^!\"^%\\^!=^.T^+i^-x^&Z^*D^!\" ",
      "encoded_base64": "Xi1qXilqXipKXixYXjZHXiotXipBXiRjXjFAXi1hXiZaXipyXiEiXiVcXiE9Xi5UXitpXi14XiZaXipEXiEiIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_3b193c336215",
      "text": "隨你的便。 ",
      "encoded_ascii": "^)X^*F^&Z^!R^!\" ",
      "encoded_base64": "XilYXipGXiZaXiFSXiEiIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_c4a00ab8785c",
      "text": "我只是好心替你著想。 ",
      "encoded_ascii": "^$%^\"?^,X^+i^#k^2o^*F^-a^,1^!\" ",
      "encoded_base64": "XiQlXiI/XixYXitpXiNrXjJvXipGXi1hXiwxXiEiIA==",
      "byte_length": 31
    },
    {
      "unit_id": "DLG_5150a20dc286",
      "text": "很好，我現在碰到的麻煩戰鬥已經夠多了，不需要再來更多。 ",
      "encoded_ascii": "^*K^+i^*A^$%^&?^\"d^-5^!u^&Z^*6^-!^$(^*,^#J^'D^+d^\"x^*D^*A^!)^)e^(C^!l^!O^$o^\"x^!\" ",
      "encoded_base64": "XipLXitpXipBXiQlXiY/XiJkXi01XiF1XiZaXio2Xi0hXiQoXiosXiNKXidEXitkXiJ4XipEXipBXiEpXillXihDXiFsXiFPXiRvXiJ4XiEiIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_465fe2962975",
      "text": "沒錯——早餐過後我親眼看過三次有屍體從那間牢房裡 ",
      "encoded_ascii": "^%\\^)5^*n^*n^,V^.K^(x^#b^$%^(F^&d^*Q^(x^!&^%D^$s^#?^**^#f^)!^)G^-$^,<^-j ",
      "encoded_base64": "XiVcXik1XipuXipuXixWXi5LXih4XiNiXiQlXihGXiZkXipRXih4XiEmXiVEXiRzXiM/XioqXiNmXikhXilHXi0kXiw8Xi1qIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_ced84d3f932e",
      "text": "被清理出來，這就是鐵證！ ",
      "encoded_ascii": "^(@^,u^&A^!q^!O^*A^(s^*J^,X^)?^-{^*W ",
      "encoded_base64": "XihAXix1XiZBXiFxXiFPXipBXihzXipKXixYXik/Xi17XipXIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_0fcb04d2f51d",
      "text": "過了一會兒，門緩緩地打開了。 ",
      "encoded_ascii": "^(x^*D^!%^$r^++^*A^)D^'J^'J^\"e^$-^)F^*D^!\" ",
      "encoded_base64": "Xih4XipEXiElXiRyXisrXipBXilEXidKXidKXiJlXiQtXilGXipEXiEiIA==",
      "byte_length": 43
    },
    {
      "unit_id": "DLG_6ab6e195e085",
      "text": "房裡突然吹起一陣微風，把門給關上了。 ",
      "encoded_ascii": "^,<^-j^'*^&\"^+A^.(^!%^)P^#i^)y^*A^$1^)D^'A^.>^!'^*D^!\" ",
      "encoded_base64": "Xiw8Xi1qXicqXiYiXitBXi4oXiElXilQXiNpXil5XipBXiQxXilEXidBXi4+XiEnXipEXiEiIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_7e18648feba5",
      "text": "迪諾斯將雙手放在吉拉爾的頭上，全神貫注。 ",
      "encoded_ascii": "^(m^7k^$[^#7^)_^$+^$P^\"d^\"D^$6^&/^&Z^)t^!'^*A^!h^&w^;J^%e^!\" ",
      "encoded_base64": "XihtXjdrXiRbXiM3XilfXiQrXiRQXiJkXiJEXiQ2XiYvXiZaXil0XiEnXipBXiFoXiZ3XjtKXiVlXiEiIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_39bf71766c59",
      "text": "過了一會兒，吉拉爾恢復了神智，隨後他轉身 ",
      "encoded_ascii": "^(x^*D^!%^$r^++^*A^\"D^$6^&/^#u^#g^*D^&w^$i^*A^)X^#b^!@^(i^(c ",
      "encoded_base64": "Xih4XipEXiElXiRyXisrXipBXiJEXiQ2XiYvXiN1XiNnXipEXiZ3XiRpXipBXilYXiNiXiFAXihpXihjIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_82c29fdebacb",
      "text": "準備離開。 ",
      "encoded_ascii": "^,x^+\"^)`^)F^!\" ",
      "encoded_base64": "Xix4XisiXilgXilGXiEiIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_3f90b6a41251",
      "text": "起作用了。我現在必須走了。",
      "encoded_ascii": "^.(^!M^&H^*D^!\"^$%^&?^\"d^#l^)r^.&^*D^!\"",
      "encoded_base64": "Xi4oXiFNXiZIXipEXiEiXiQlXiY/XiJkXiNsXilyXi4mXipEXiEi",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_86abfbf8c29c",
      "text": "要是我也是個角鬥士，你敢那樣襲擊我，我一定殺了你！ ",
      "encoded_ascii": "^(C^,X^$%^!1^,X^!V^(H^*,^+a^*A^*F^/m^)!^,f^08^$F^$%^*A^$%^!%^#.^%M^*D^*F^*W ",
      "encoded_base64": "XihDXixYXiQlXiExXixYXiFWXihIXiosXithXipBXipGXi9tXikhXixmXjA4XiRGXiQlXipBXiQlXiElXiMuXiVNXipEXipGXipXIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_ad99a81ebf41",
      "text": "稍等一下再跟我說話。",
      "encoded_ascii": "^-:^'-^!%^!(^!l^.+^$%^-x^-v^!\"",
      "encoded_base64": "Xi06XictXiElXiEoXiFsXi4rXiQlXi14Xi12XiEi",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_f4870bed6cee",
      "text": "庫爾扎克正在找你們。你們最好趕緊去戰鬥，免得他派出 ",
      "encoded_ascii": "^,#^&/^,=^!d^%H^\"d^$/^*F^*{^!\"^*F^*{^$q^+i^0u^0r^\"6^$(^*,^*A^!e^#e^!@^.n^!q ",
      "encoded_base64": "XiwjXiYvXiw9XiFkXiVIXiJkXiQvXipGXip7XiEiXipGXip7XiRxXitpXjB1XjByXiI2XiQoXiosXipBXiFlXiNlXiFAXi5uXiFxIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_de4c881fb739",
      "text": "碎腿者。 ",
      "encoded_ascii": "^&o^'h^'V^!\" ",
      "encoded_base64": "XiZvXidoXidWXiEiIA==",
      "byte_length": 13
    },
    {
      "unit_id": "DLG_8fa0120709ee",
      "text": "你有聽見有人在尖叫嗎？ ",
      "encoded_ascii": "^*F^$s^-X^-m^$s^!<^\"d^#=^+<^+X^.V ",
      "encoded_base64": "XipGXiRzXi1YXi1tXiRzXiE8XiJkXiM9Xis8XitYXi5WIA==",
      "byte_length": 34
    },
    {
      "unit_id": "DLG_09cb3516ccd1",
      "text": "你為什麼要殺了吉拉爾？她根本沒招惹你！ ",
      "encoded_ascii": "^*F^%{^!=^.T^(C^%M^*D^\"D^$6^&/^.V^+h^%)^$x^%\\^,D^3s^*F^*W ",
      "encoded_base64": "XipGXiV7XiE9Xi5UXihDXiVNXipEXiJEXiQ2XiYvXi5WXitoXiUpXiR4XiVcXixEXjNzXipGXipXIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_295de01b5494",
      "text": "你好，很高興認識你。我這裡平時可難得有訪客。 ",
      "encoded_ascii": "^*F^+i^*A^*K^*+^-]^(O^(R^*F^!\"^$%^(s^-j^0Y^$f^\"A^)a^#e^$s^4d^+q^!\" ",
      "encoded_base64": "XipGXitpXipBXipLXiorXi1dXihPXihSXipGXiEiXiQlXihzXi1qXjBZXiRmXiJBXilhXiNlXiRzXjRkXitxXiEiIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_43a3600711cb",
      "text": "噢，又是你們。我有什麼能幫忙的嗎？ ",
      "encoded_ascii": "^+]^*A^+;^,X^*F^*{^!\"^$%^$s^!=^.T^'b^+}^,+^&Z^+X^.V ",
      "encoded_base64": "XitdXipBXis7XixYXipGXip7XiEiXiQlXiRzXiE9Xi5UXidiXit9XiwrXiZaXitYXi5WIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_ee85c4ec6793",
      "text": "順便提一句，你們大可不必把我的門給砸了。特權管事 ",
      "encoded_ascii": "^.D^!R^$A^!%^2]^*A^*F^*{^\"z^\"A^!)^#l^$1^$%^&Z^)D^'A^0#^*D^!\"^&5^1E^-D^*r ",
      "encoded_base64": "Xi5EXiFSXiRBXiElXjJdXipBXipGXip7XiJ6XiJBXiEpXiNsXiQxXiQlXiZaXilEXidBXjAjXipEXiEiXiY1XjFFXi1EXipyIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_68b8e59948a4",
      "text": "那裡確實有鑰匙。 ",
      "encoded_ascii": "^)!^-j^-6^#3^$s^)@^\"*^!\" ",
      "encoded_base64": "XikhXi1qXi02XiMzXiRzXilAXiIqXiEiIA==",
      "byte_length": 25
    },
    {
      "unit_id": "DLG_f1f027996ede",
      "text": "我們必須趕到吉拉爾那裡去。 ",
      "encoded_ascii": "^$%^*{^#l^)r^0u^!u^\"D^$6^&/^)!^-j^\"6^!\" ",
      "encoded_base64": "XiQlXip7XiNsXilyXjB1XiF1XiJEXiQ2XiYvXikhXi1qXiI2XiEiIA==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_7308c1930f46",
      "text": "  我正趕著呢。 ",
      "encoded_ascii": "  ^$%^%H^0u^-a^+C^!\" ",
      "encoded_base64": "ICBeJCVeJUheMHVeLWFeK0NeISIg",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_9e35461a0102",
      "text": "  我得先辦點別的事。 ",
      "encoded_ascii": "  ^$%^#e^!b^2L^*;^*H^&Z^*r^!\" ",
      "encoded_base64": "ICBeJCVeI2VeIWJeMkxeKjteKkheJlpeKnJeISIg",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_e798abdbd94c",
      "text": "  別擋我的路！我待會兒再去找你。",
      "encoded_ascii": "  ^*H^$G^$%^&Z^(a^*W^$%^,*^$r^++^!l^\"6^$/^*F^!\"",
      "encoded_base64": "ICBeKkheJEdeJCVeJlpeKGFeKldeJCVeLCpeJHJeKyteIWxeIjZeJC9eKkZeISI=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_234650835ab4",
      "text": "現在不是時候。我晚點再來找你。 ",
      "encoded_ascii": "^&?^\"d^!)^,X^$f^*|^!\"^$%^,Y^*;^!l^!O^$/^*F^!\" ",
      "encoded_base64": "XiY/XiJkXiEpXixYXiRmXip8XiEiXiQlXixZXio7XiFsXiFPXiQvXipGXiEiIA==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_bfd58f78b9f1",
      "text": "如果你非辦不可就快點，抓緊時間。 ",
      "encoded_ascii": "^#$^%!^*F^)i^2L^!)^\"A^*J^*L^*;^*A^$2^0r^$f^)G^!\" ",
      "encoded_base64": "XiMkXiUhXipGXilpXjJMXiEpXiJBXipKXipMXio7XipBXiQyXjByXiRmXilHXiEiIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_52b8fc4f6dd5",
      "text": "儘快回我的牢房來。 ",
      "encoded_ascii": "^+(^*L^\"\\^$%^&Z^-$^,<^!O^!\" ",
      "encoded_base64": "XisoXipMXiJcXiQlXiZaXi0kXiw8XiFPXiEiIA==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_934b9292e24f",
      "text": "我很高興能幫上吉拉爾的忙。 ",
      "encoded_ascii": "^$%^*K^*+^-]^'b^+}^!'^\"D^$6^&/^&Z^,+^!\" ",
      "encoded_base64": "XiQlXipLXiorXi1dXidiXit9XiEnXiJEXiQ2XiYvXiZaXiwrXiEiIA==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_4013aed511d8",
      "text": "  我就是想殺了她。 ",
      "encoded_ascii": "  ^$%^*J^,X^,1^%M^*D^+h^!\" ",
      "encoded_base64": "ICBeJCVeKkpeLFheLDFeJU1eKkReK2heISIg",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_613ded446162",
      "text": "  那純屬一場意外。 ",
      "encoded_ascii": "  ^)!^3\"^#C^!%^\"n^#z^\"w^!\" ",
      "encoded_base64": "ICBeKSFeMyJeI0NeISVeIm5eI3peIndeISIg",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_395869929efe",
      "text": "  你要是不老實交代，我也把你給宰了。",
      "encoded_ascii": "  ^*F^(C^,X^!)^'U^#3^0P^*v^*A^$%^!1^$1^*F^'A^1w^*D^!\"",
      "encoded_base64": "ICBeKkZeKENeLFheISleJ1VeIzNeMFBeKnZeKkFeJCVeITFeJDFeKkZeJ0FeMXdeKkReISI=",
      "byte_length": 53
    },
    {
      "unit_id": "DLG_4802eeba07ea",
      "text": "  你是怎麼治好吉拉爾的？ ",
      "encoded_ascii": "  ^*F^,X^,,^.T^%_^+i^\"D^$6^&/^&Z^.V ",
      "encoded_base64": "ICBeKkZeLFheLCxeLlReJV9eK2leIkReJDZeJi9eJlpeLlYg",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_74e6002925e7",
      "text": "  如果她掌握情報，你為什麼沒去問她？",
      "encoded_ascii": "  ^#$^%!^+h^$;^1>^,0^+`^*A^*F^%{^!=^.T^%\\^\"6^*Z^+h^.V",
      "encoded_base64": "ICBeIyReJSFeK2heJDteMT5eLDBeK2BeKkFeKkZeJXteIT1eLlReJVxeIjZeKlpeK2heLlY=",
      "byte_length": 53
    },
    {
      "unit_id": "DLG_9bfd53f8c244",
      "text": "  你是怎麼看出來的？",
      "encoded_ascii": "  ^*F^,X^,,^.T^*Q^!q^!O^&Z^.V",
      "encoded_base64": "ICBeKkZeLFheLCxeLlReKlFeIXFeIU9eJlpeLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_90799294c5f5",
      "text": "  吉拉爾剛才一直在痛苦尖叫。",
      "encoded_ascii": "  ^\"D^$6^&/^+0^$,^!%^&`^\"d^-.^.t^#=^+<^!\"",
      "encoded_base64": "ICBeIkReJDZeJi9eKzBeJCxeISVeJmBeImReLS5eLnReIz1eKzxeISI=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_febca9609839",
      "text": "  你為什麼會被關在這裡？",
      "encoded_ascii": "  ^*F^%{^!=^.T^$r^(@^.>^\"d^(s^-j^.V",
      "encoded_base64": "ICBeKkZeJXteIT1eLlReJHJeKEBeLj5eImReKHNeLWpeLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_bb18ebd9b95a",
      "text": "  為什麼你的牢房環境這麼好？ ",
      "encoded_ascii": "  ^%{^!=^.T^*F^&Z^-$^,<^&B^\"q^(s^.T^+i^.V ",
      "encoded_base64": "ICBeJXteIT1eLlReKkZeJlpeLSReLDxeJkJeInFeKHNeLlReK2leLlYg",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_5b82f6b661aa",
      "text": "  你在這裡被關多久了？",
      "encoded_ascii": "  ^*F^\"d^(s^-j^(@^.>^\"x^!.^*D^.V",
      "encoded_base64": "ICBeKkZeImReKHNeLWpeKEBeLj5eInheIS5eKkReLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_bac39d6616bf",
      "text": "  你在競技場裡打過仗嗎？",
      "encoded_ascii": "  ^*F^\"d^-?^,>^\"n^-j^$-^(x^0|^+X^.V",
      "encoded_base64": "ICBeKkZeImReLT9eLD5eIm5eLWpeJC1eKHheMHxeK1heLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_1e3f8cffb4ad",
      "text": "  我在哪裡可以弄到水？ ",
      "encoded_ascii": "  ^$%^\"d^+I^-j^\"A^!B^/`^!u^%V^.V ",
      "encoded_base64": "ICBeJCVeImReK0leLWpeIkFeIUJeL2BeIXVeJVZeLlYg",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_49d282dfd59c",
      "text": "  這裡還有誰被關著？",
      "encoded_ascii": "  ^(s^-j^.7^$s^-y^(@^.>^-a^.V",
      "encoded_base64": "ICBeKHNeLWpeLjdeJHNeLXleKEBeLj5eLWFeLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_cd7796c36942",
      "text": "  曾有人從這裡逃脫過嗎？",
      "encoded_ascii": "  ^.j^$s^!<^#f^(s^-j^(p^'c^(x^+X^.V",
      "encoded_base64": "ICBeLmpeJHNeITxeI2ZeKHNeLWpeKHBeJ2NeKHheK1heLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_837defd12718",
      "text": "  你為什麼不嘗試逃跑？ ",
      "encoded_ascii": "  ^*F^%{^!=^.T^!)^1o^-u^(p^(_^.V ",
      "encoded_base64": "ICBeKkZeJXteIT1eLlReISleMW9eLXVeKHBeKF9eLlYg",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_e7dadd0fb976",
      "text": "聽起來真像編出來的鬼話。 ",
      "encoded_ascii": "^-X^.(^!O^-2^!`^5u^!q^!O^&Z^*-^-v^!\" ",
      "encoded_base64": "Xi1YXi4oXiFPXi0yXiFgXjV1XiFxXiFPXiZaXiotXi12XiEiIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_ed01835bb495",
      "text": "毫不意外。 ",
      "encoded_ascii": "^/t^!)^#z^\"w^!\" ",
      "encoded_base64": "Xi90XiEpXiN6XiJ3XiEiIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_a69b5e3401c2",
      "text": "呃，嗯，我明白你的意思了。那麼……你想知道些什麼？ ",
      "encoded_ascii": "^3<^*A^6N^*A^$%^$c^&X^*F^&Z^#z^#q^*D^!\"^)!^.T^*o^*o^*F^,1^&h^(y^!8^!=^.T^.V ",
      "encoded_base64": "XjM8XipBXjZOXipBXiQlXiRjXiZYXipGXiZaXiN6XiNxXipEXiEiXikhXi5UXipvXipvXipGXiwxXiZoXih5XiE4XiE9Xi5UXi5WIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_225bcf5cac82",
      "text": "這還有什麼意義？你都殺了她。我真搞不懂你當初為什麼要讓我 ",
      "encoded_ascii": "^(s^.7^$s^!=^.T^#z^2<^.V^*F^)$^%M^*D^+h^!\"^$%^-2^:R^!)^,6^*F^&N^1\"^%{^!=^.T^(C^-}^$% ",
      "encoded_base64": "XihzXi43XiRzXiE9Xi5UXiN6XjI8Xi5WXipGXikkXiVNXipEXitoXiEiXiQlXi0yXjpSXiEpXiw2XipGXiZOXjEiXiV7XiE9Xi5UXihDXi19XiQlIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_17440bf288fa",
      "text": "費那麼大工夫去救她。 ",
      "encoded_ascii": "^.\"^)!^.T^\"z^+y^\"{^\"6^,Q^+h^!\" ",
      "encoded_base64": "Xi4iXikhXi5UXiJ6Xit5XiJ7XiI2XixRXitoXiEiIA==",
      "byte_length": 31
    },
    {
      "unit_id": "DLG_2566c919ec0c",
      "text": "這是我與生俱來的某種天賦。吉拉爾的心智被聖堂武士給封閉了， ",
      "encoded_ascii": "^(s^,X^$%^'p^&F^<3^!O^&Z^%$^'$^+e^(Y^!\"^\"D^$6^&/^&Z^#k^$i^(@^'Z^42^%J^+a^'A^#5^.=^*D^*A ",
      "encoded_base64": "XihzXixYXiQlXidwXiZGXjwzXiFPXiZaXiUkXickXitlXihZXiEiXiJEXiQ2XiYvXiZaXiNrXiRpXihAXidaXjQyXiVKXithXidBXiM1Xi49XipEXipBIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_98221f48eef3",
      "text": "這樣他們就不用殺死她。她掌握了某些太過重要的秘密， ",
      "encoded_ascii": "^(s^,f^!@^*{^*J^!)^&H^%M^%L^+h^!\"^+h^$;^1>^*D^%$^!8^+f^(x^))^(C^&Z^1O^#0^*A ",
      "encoded_base64": "XihzXixmXiFAXip7XipKXiEpXiZIXiVNXiVMXitoXiEiXitoXiQ7XjE+XipEXiUkXiE4XitmXih4XikpXihDXiZaXjFPXiMwXipBIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_41b7671adc33",
      "text": "是聖堂武士絕不允許任何人知曉的。 ",
      "encoded_ascii": "^,X^'Z^42^%J^+a^-I^!)^/\"^-s^!C^!L^!<^&h^7y^&Z^!\" ",
      "encoded_base64": "XixYXidaXjQyXiVKXithXi1JXiEpXi8iXi1zXiFDXiFMXiE8XiZoXjd5XiZaXiEiIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_dc9c38e95418",
      "text": "順帶一提， ",
      "encoded_ascii": "^.D^#N^!%^$A^*A ",
      "encoded_base64": "Xi5EXiNOXiElXiRBXipBIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_18b9ad867502",
      "text": "知識既寶貴又危險。我在這牢欄裡過得很舒坦。 ",
      "encoded_ascii": "^&h^(R^,U^#4^2F^+;^2\\^*m^!\"^$%^\"d^(s^-$^%C^-j^(x^#e^*K^</^7&^!\" ",
      "encoded_base64": "XiZoXihSXixVXiM0XjJGXis7XjJcXiptXiEiXiQlXiJkXihzXi0kXiVDXi1qXih4XiNlXipLXjwvXjcmXiEiIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_f708b1ff118f",
      "text": "何必去探知那些可能改變現狀的秘密呢？ ",
      "encoded_ascii": "^!L^#l^\"6^$>^&h^)!^!8^\"A^'b^$N^(U^&?^&7^&Z^1O^#0^+C^.V ",
      "encoded_base64": "XiFMXiNsXiI2XiQ+XiZoXikhXiE4XiJBXidiXiROXihVXiY/XiY3XiZaXjFPXiMwXitDXi5WIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_441997c80b7a",
      "text": "抱歉，我現在沒心情閒聊。 ",
      "encoded_ascii": "^,@^,h^*A^$%^&?^\"d^%\\^#k^,0^6A^-U^!\" ",
      "encoded_base64": "XixAXixoXipBXiQlXiY/XiJkXiVcXiNrXiwwXjZBXi1VXiEiIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_7e36d121f960",
      "text": "我負責給聖堂武士長下廚，所以他確保了我不會 ",
      "encoded_ascii": "^$%^(W^0>^'A^'Z^42^%J^+a^)C^!(^,%^*A^$)^!B^!@^-6^!T^*D^$%^!)^$r ",
      "encoded_base64": "XiQlXihXXjA+XidBXidaXjQyXiVKXithXilDXiEoXiwlXipBXiQpXiFCXiFAXi02XiFUXipEXiQlXiEpXiRyIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_b77ede75ae19",
      "text": "被其他人幹掉。這裡房間是不錯，但我還是被鎖在裡面。 ",
      "encoded_ascii": "^(@^!j^!@^!<^,!^/e^!\"^(s^-j^,<^)G^,X^!)^)5^*A^!I^$%^.7^,X^(@^)8^\"d^-j^)j^!\" ",
      "encoded_base64": "XihAXiFqXiFAXiE8XiwhXi9lXiEiXihzXi1qXiw8XilHXixYXiEpXik1XipBXiFJXiQlXi43XixYXihAXik4XiJkXi1qXilqXiEiIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_e708eeffcf89",
      "text": "我是迪諾斯。 ",
      "encoded_ascii": "^$%^,X^(m^7k^$[^!\" ",
      "encoded_base64": "XiQlXixYXihtXjdrXiRbXiEiIA==",
      "byte_length": 19
    },
    {
      "unit_id": "DLG_00baa0d6294c",
      "text": "我是迪諾斯。你們一定是新來的吧。",
      "encoded_ascii": "^$%^,X^(m^7k^$[^!\"^*F^*{^!%^#.^,X^$\\^!O^&Z^*I^!\"",
      "encoded_base64": "XiQlXixYXihtXjdrXiRbXiEiXipGXip7XiElXiMuXixYXiRcXiFPXiZaXipJXiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_0523e7420dae",
      "text": "這麼說吧，你們看起來還有點乳臭未乾。 ",
      "encoded_ascii": "^(s^.T^-x^*I^*A^*F^*{^*Q^.(^!O^.7^$s^*;^!2^'m^,_^*X^!\" ",
      "encoded_base64": "XihzXi5UXi14XipJXipBXipGXip7XipRXi4oXiFPXi43XiRzXio7XiEyXidtXixfXipYXiEiIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_f7fd92ab34d7",
      "text": "雖然我也沒資格對別人品頭論足就是了。",
      "encoded_ascii": "^.A^&\"^$%^!1^%\\^(X^%*^#:^*H^!<^\"R^)t^1\\^(^^*J^,X^*D^!\"",
      "encoded_base64": "Xi5BXiYiXiQlXiExXiVcXihYXiUqXiM6XipIXiE8XiJSXil0XjFcXiheXipKXixYXipEXiEi",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_75adfc70bf95",
      "text": "吉拉爾？她還好嗎？",
      "encoded_ascii": "^\"D^$6^&/^.V^+h^.7^+i^+X^.V",
      "encoded_base64": "XiJEXiQ2XiYvXi5WXitoXi43XitpXitYXi5W",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_910afc0ac96c",
      "text": "我真的沒興趣跟你們說話。 ",
      "encoded_ascii": "^$%^-2^&Z^%\\^-]^.*^.+^*F^*{^-x^-v^!\" ",
      "encoded_base64": "XiQlXi0yXiZaXiVcXi1dXi4qXi4rXipGXip7Xi14Xi12XiEiIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_5ef51123b177",
      "text": "我以前是德拉吉紅羽毛客棧的主廚。某位高階聖堂武士點了 ",
      "encoded_ascii": "^$%^!B^!z^,X^#j^$6^\"D^3!^'S^%R^+q^>5^&Z^!-^,%^!\"^%$^!J^*+^=b^'Z^42^%J^+a^*;^*D ",
      "encoded_base64": "XiQlXiFCXiF6XixYXiNqXiQ2XiJEXjMhXidTXiVSXitxXj41XiZaXiEtXiwlXiEiXiUkXiFKXiorXj1iXidaXjQyXiVKXithXio7XipEIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_1cee84d00193",
      "text": "店裡最好的佳餚，也就是哈菲隆鳥。誰知那位聖堂武士對 ",
      "encoded_ascii": "^>4^-j^$q^+i^&Z^7P^>8^*A^!1^*J^,X^+F^8q^)T^4p^!\"^-y^&h^)!^!J^'Z^42^%J^+a^#: ",
      "encoded_base64": "Xj40Xi1qXiRxXitpXiZaXjdQXj44XipBXiExXipKXixYXitGXjhxXilUXjRwXiEiXi15XiZoXikhXiFKXidaXjQyXiVKXithXiM6IA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_0a2666704bae",
      "text": "哈菲隆鳥肉過敏，便一口咬定我是想蓄意害他 ",
      "encoded_ascii": "^+F^8q^)T^4p^'^^(x^//^*A^!R^!%^\"<^\"Q^#.^$%^,X^,1^2B^#z^#/^!@ ",
      "encoded_base64": "XitGXjhxXilUXjRwXideXih4Xi8vXipBXiFSXiElXiI8XiJRXiMuXiQlXixYXiwxXjJCXiN6XiMvXiFAIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_32a9664bf7c1",
      "text": "染病。我當場就被逮捕入獄了。",
      "encoded_ascii": "^%%^&R^!\"^$%^&N^\"n^*J^(@^;]^4?^!f^3Q^*D^!\"",
      "encoded_base64": "XiUlXiZSXiEiXiQlXiZOXiJuXipKXihAXjtdXjQ/XiFmXjNRXipEXiEi",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_7fd5b1c2308b",
      "text": "我在這裡待了大約一年， ",
      "encoded_ascii": "^$%^\"d^(s^-j^,*^*D^\"z^-F^!%^+~^*A ",
      "encoded_base64": "XiQlXiJkXihzXi1qXiwqXipEXiJ6Xi1GXiElXit+XipBIA==",
      "byte_length": 34
    },
    {
      "unit_id": "DLG_699be0e1579f",
      "text": "但你們是我所見過最殘忍嗜殺的一夥人了。 ",
      "encoded_ascii": "^!I^*F^*{^,X^$%^$)^-m^(x^$q^,l^1y^>3^%M^&Z^!%^5?^!<^*D^!\" ",
      "encoded_base64": "XiFJXipGXip7XixYXiQlXiQpXi1tXih4XiRxXixsXjF5Xj4zXiVNXiZaXiElXjU/XiE8XipEXiEiIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_eb2e33508db8",
      "text": "老實告訴你們，這裡的伙食非常美味。 ",
      "encoded_ascii": "^'U^#3^+B^-t^*F^*{^*A^(s^-j^&Z^*y^0J^)i^#O^-P^1n^!\" ",
      "encoded_base64": "XidVXiMzXitCXi10XipGXip7XipBXihzXi1qXiZaXip5XjBKXilpXiNPXi1QXjFuXiEiIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_a12ff42633f0",
      "text": "沒有。要是我也是個角鬥士，你敢傷害吉拉爾，我一定宰了你。 ",
      "encoded_ascii": "^%\\^$s^!\"^(C^,X^$%^!1^,X^!V^(H^*,^+a^*A^*F^/m^!^^#/^\"D^$6^&/^*A^$%^!%^#.^1w^*D^*F^!\" ",
      "encoded_base64": "XiVcXiRzXiEiXihDXixYXiQlXiExXixYXiFWXihIXiosXithXipBXipGXi9tXiFeXiMvXiJEXiQ2XiYvXipBXiQlXiElXiMuXjF3XipEXipGXiEiIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_ec20fffd7caf",
      "text": "老天啊，怎麼可能，我根本沒在競技場上打過！我又不是角鬥士。 ",
      "encoded_ascii": "^'U^+e^+Q^*A^,,^.T^\"A^'b^*A^$%^%)^$x^%\\^\"d^-?^,>^\"n^!'^$-^(x^*W^$%^+;^!)^,X^(H^*,^+a^!\" ",
      "encoded_base64": "XidVXitlXitRXipBXiwsXi5UXiJBXidiXipBXiQlXiUpXiR4XiVcXiJkXi0/Xiw+XiJuXiEnXiQtXih4XipXXiQlXis7XiEpXixYXihIXiosXithXiEiIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_3a2210cc1346",
      "text": "要是把我也扔進競技場，那就是白白浪費我的才華了。 ",
      "encoded_ascii": "^(C^,X^$1^$%^!1^8{^(w^-?^,>^\"n^*A^)!^*J^,X^&X^&X^,r^.\"^$%^&Z^$,^3'^*D^!\" ",
      "encoded_base64": "XihDXixYXiQxXiQlXiExXjh7Xih3Xi0/Xiw+XiJuXipBXikhXipKXixYXiZYXiZYXixyXi4iXiQlXiZaXiQsXjMnXipEXiEiIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_75e3db3013ea",
      "text": "我廚藝太精湛了，而他們心知肚明。 ",
      "encoded_ascii": "^$%^,%^3Z^+f^'7^<o^*D^*A^'W^!@^*{^#k^&h^=1^$c^!\" ",
      "encoded_base64": "XiQlXiwlXjNaXitmXic3XjxvXipEXipBXidXXiFAXip7XiNrXiZoXj0xXiRjXiEiIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_bc53557aab67",
      "text": "此處東邊的房間裡有一個水槽。只要把空水罐推進水裡泡一下， ",
      "encoded_ascii": "^%I^(,^,`^.8^&Z^,<^)G^-j^$s^!%^!V^%V^%6^!\"^\"?^(C^$1^'(^%V^'O^,J^(w^%V^-j^2s^!%^!(^*A ",
      "encoded_base64": "XiVJXigsXixgXi44XiZaXiw8XilHXi1qXiRzXiElXiFWXiVWXiU2XiEiXiI/XihDXiQxXicoXiVWXidPXixKXih3XiVWXi1qXjJzXiElXiEoXipBIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_26c5e8de2e9e",
      "text": "就能把它裝滿了。 ",
      "encoded_ascii": "^*J^'b^$1^+o^(A^,{^*D^!\" ",
      "encoded_base64": "XipKXidiXiQxXitvXihBXix7XipEXiEiIA==",
      "byte_length": 25
    },
    {
      "unit_id": "DLG_89d3e2132cd5",
      "text": "吉拉爾以前就住在這，但你們把她給殺了！ ",
      "encoded_ascii": "^\"D^$6^&/^!B^!z^*J^*z^\"d^(s^*A^!I^*F^*{^$1^+h^'A^%M^*D^*W ",
      "encoded_base64": "XiJEXiQ2XiYvXiFCXiF6XipKXip6XiJkXihzXipBXiFJXipGXip7XiQxXitoXidBXiVNXipEXipXIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_8b123fff6e13",
      "text": "如果想打聽這牢房裡的任何一個人，我絕對是你們該請教的 ",
      "encoded_ascii": "^#$^%!^,1^$-^-X^(s^-$^,<^-j^&Z^!C^!L^!%^!V^!<^*A^$%^-I^#:^,X^*F^*{^(M^*S^,R^&Z ",
      "encoded_base64": "XiMkXiUhXiwxXiQtXi1YXihzXi0kXiw8Xi1qXiZaXiFDXiFMXiElXiFWXiE8XipBXiQlXi1JXiM6XixYXipGXip7XihNXipTXixSXiZaIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_53a47d5181f0",
      "text": "第一個人選。我對這裡的每個人都瞭若指掌。 ",
      "encoded_ascii": "^',^!%^!V^!<^.6^!\"^$%^#:^(s^-j^&Z^%P^!V^!<^)$^<p^'x^$8^$;^!\" ",
      "encoded_base64": "XicsXiElXiFWXiE8Xi42XiEiXiQlXiM6XihzXi1qXiZaXiVQXiFWXiE8XikkXjxwXid4XiQ4XiQ7XiEiIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_29da325c9078",
      "text": "以前常在牢房周圍巡視的那傢伙是特權管事。",
      "encoded_ascii": "^!B^!z^#O^\"d^-$^,<^\"L^\"`^8g^(E^&Z^)!^+#^*y^,X^&5^1E^-D^*r^!\"",
      "encoded_base64": "XiFCXiF6XiNPXiJkXi0kXiw8XiJMXiJgXjhnXihFXiZaXikhXisjXip5XixYXiY1XjFFXi1EXipyXiEi",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_ac1f06922a02",
      "text": "常在牢房周圍巡視的那傢伙就是特權管事。",
      "encoded_ascii": "^#O^\"d^-$^,<^\"L^\"`^8g^(E^&Z^)!^+#^*y^*J^,X^&5^1E^-D^*r^!\"",
      "encoded_base64": "XiNPXiJkXi0kXiw8XiJMXiJgXjhnXihFXiZaXikhXisjXip5XipKXixYXiY1XjFFXi1EXipyXiEi",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_b6190871364e",
      "text": "你們是這奴隸欄裡唯一剩下的一夥勢力了。刀疤、 ",
      "encoded_ascii": "^*F^*{^,X^(s^##^)Z^%C^-j^+O^!%^8U^!(^&Z^!%^5?^\"&^!~^*D^!\"^7Q^5g^!! ",
      "encoded_base64": "XipGXip7XixYXihzXiMjXilaXiVDXi1qXitPXiElXjhVXiEoXiZaXiElXjU/XiImXiF+XipEXiEiXjdRXjVnXiEhIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_1417bfecb7a1",
      "text": "梅爾佐爾以及他們的黨羽全死光了。 ",
      "encoded_ascii": "^%-^&/^>1^&/^!B^\"7^!@^*{^&Z^:e^'S^!h^%L^!c^*D^!\" ",
      "encoded_base64": "XiUtXiYvXj4xXiYvXiFCXiI3XiFAXip7XiZaXjplXidTXiFoXiVMXiFjXipEXiEiIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_8aecd4631150",
      "text": "刀疤的幫派統治著奴隸欄。梅爾佐爾和他的人都死了。 ",
      "encoded_ascii": "^7Q^5g^&Z^+}^.n^'B^%_^-a^##^)Z^%C^!\"^%-^&/^>1^&/^\"O^!@^&Z^!<^)$^%L^*D^!\" ",
      "encoded_base64": "XjdRXjVnXiZaXit9Xi5uXidCXiVfXi1hXiMjXilaXiVDXiEiXiUtXiYvXj4xXiYvXiJPXiFAXiZaXiE8XikkXiVMXipEXiEiIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_d7f864a7f9b8",
      "text": "基本上是梅爾佐爾和他的人把持著奴隸欄。刀疤和他的幫派已經死絕了。",
      "encoded_ascii": "^/'^$x^!'^,X^%-^&/^>1^&/^\"O^!@^&Z^!<^$1^$7^-a^##^)Z^%C^!\"^7Q^5g^\"O^!@^&Z^+}^.n^#J^'D^%L^-I^*D^!\"",
      "encoded_base64": "Xi8nXiR4XiEnXixYXiUtXiYvXj4xXiYvXiJPXiFAXiZaXiE8XiQxXiQ3Xi1hXiMjXilaXiVDXiEiXjdRXjVnXiJPXiFAXiZaXit9Xi5uXiNKXidEXiVMXi1JXipEXiEi",
      "byte_length": 96
    },
    {
      "unit_id": "DLG_2e2f8256881e",
      "text": "這裡有兩大幫派：梅爾佐爾的派系和刀疤的派系。 ",
      "encoded_ascii": "^(s^-j^$s^!i^\"z^+}^.n^*B^%-^&/^>1^&/^&Z^.n^'9^\"O^7Q^5g^&Z^.n^'9^!\" ",
      "encoded_base64": "XihzXi1qXiRzXiFpXiJ6Xit9Xi5uXipCXiUtXiYvXj4xXiYvXiZaXi5uXic5XiJPXjdRXjVnXiZaXi5uXic5XiEiIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_c6a7c73ab3ea",
      "text": "另外還有米爾隆和吉拉爾，他們向來獨來獨往。 ",
      "encoded_ascii": "^\">^\"w^.7^$s^'4^&/^)T^\"O^\"D^$6^&/^*A^!@^*{^+?^!O^/z^!O^/z^,)^!\" ",
      "encoded_base64": "XiI+XiJ3Xi43XiRzXic0XiYvXilUXiJPXiJEXiQ2XiYvXipBXiFAXip7Xis/XiFPXi96XiFPXi96XiwpXiEiIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_e4ae85753b0a",
      "text": "以前還有另外兩個叫吉拉爾和米爾隆的人。你們知道吉拉爾發生了 ",
      "encoded_ascii": "^!B^!z^.7^$s^\">^\"w^!i^!V^+<^\"D^$6^&/^\"O^'4^&/^)T^&Z^!<^!\"^*F^*{^&h^(y^\"D^$6^&/^&W^&F^*D ",
      "encoded_base64": "XiFCXiF6Xi43XiRzXiI+XiJ3XiFpXiFWXis8XiJEXiQ2XiYvXiJPXic0XiYvXilUXiZaXiE8XiEiXipGXip7XiZoXih5XiJEXiQ2XiYvXiZXXiZGXipEIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_d5310dbf4909",
      "text": "什麼事。 ",
      "encoded_ascii": "^!=^.T^*r^!\" ",
      "encoded_base64": "XiE9Xi5UXipyXiEiIA==",
      "byte_length": 13
    },
    {
      "unit_id": "DLG_bd35a0209987",
      "text": "在米爾隆與吉拉爾兩人之中，只有 ",
      "encoded_ascii": "^\"d^'4^&/^)T^'p^\"D^$6^&/^!i^!<^!/^!,^*A^\"?^$s ",
      "encoded_base64": "XiJkXic0XiYvXilUXidwXiJEXiQ2XiYvXiFpXiE8XiEvXiEsXipBXiI/XiRzIA==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_6b24358d970c",
      "text": "吉拉爾 ",
      "encoded_ascii": "^\"D^$6^&/ ",
      "encoded_base64": "XiJEXiQ2XiYvIA==",
      "byte_length": 10
    },
    {
      "unit_id": "DLG_fe8eb118058f",
      "text": "米爾隆 ",
      "encoded_ascii": "^'4^&/^)T ",
      "encoded_base64": "Xic0XiYvXilUIA==",
      "byte_length": 10
    },
    {
      "unit_id": "DLG_706ecfe7c67a",
      "text": "還活著。另一個人已經過世了。 ",
      "encoded_ascii": "^.7^%i^-a^!\"^\">^!%^!V^!<^#J^'D^(x^*p^*D^!\" ",
      "encoded_base64": "Xi43XiVpXi1hXiEiXiI+XiElXiFWXiE8XiNKXidEXih4XipwXipEXiEiIA==",
      "byte_length": 43
    },
    {
      "unit_id": "DLG_f210dba17e4e",
      "text": "吉拉爾本來可能會告訴你們些線索的，但你們把她殺了！ ",
      "encoded_ascii": "^\"D^$6^&/^$x^!O^\"A^'b^$r^+B^-t^*F^*{^!8^'I^'>^&Z^*A^!I^*F^*{^$1^+h^%M^*D^*W ",
      "encoded_base64": "XiJEXiQ2XiYvXiR4XiFPXiJBXidiXiRyXitCXi10XipGXip7XiE4XidJXic+XiZaXipBXiFJXipGXip7XiQxXitoXiVNXipEXipXIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_96501ffcb602",
      "text": "我聽過過去有人逃脫的傳言，但我敢肯定那絕不是 ",
      "encoded_ascii": "^$%^-X^(x^(x^\"6^$s^!<^(p^'c^&Z^+$^1Y^*A^!I^$%^/m^-Z^#.^)!^-I^!)^,X ",
      "encoded_base64": "XiQlXi1YXih4Xih4XiI2XiRzXiE8XihwXidjXiZaXiskXjFZXipBXiFJXiQlXi9tXi1aXiMuXikhXi1JXiEpXixYIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_f7d3de3dee08",
      "text": "真的。廚房裡有一個專門用來倒垃圾的洞口，直通往 ",
      "encoded_ascii": "^-2^&Z^!\"^,%^,<^-j^$s^!%^!V^#8^)D^&H^!O^!X^\"i^\"f^&Z^%h^\"<^*A^&`^(t^,) ",
      "encoded_base64": "Xi0yXiZaXiEiXiwlXiw8Xi1qXiRzXiElXiFWXiM4XilEXiZIXiFPXiFYXiJpXiJmXiZaXiVoXiI8XipBXiZgXih0XiwpIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_c735d106bb52",
      "text": "下水道。不過最近上面裝了格柵門，就是為了防堵人鑽 ",
      "encoded_ascii": "^!(^%V^(y^!\"^!)^(x^$q^(l^!'^)j^(A^*D^%*^%(^)D^*A^*J^,X^%{^*D^)K^;u^!<^7L ",
      "encoded_base64": "XiEoXiVWXih5XiEiXiEpXih4XiRxXihsXiEnXilqXihBXipEXiUqXiUoXilEXipBXipKXixYXiV7XipEXilLXjt1XiE8XjdMIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_0dc6b9909234",
      "text": "進去。 ",
      "encoded_ascii": "^(w^\"6^!\" ",
      "encoded_base64": "Xih3XiI2XiEiIA==",
      "byte_length": 10
    },
    {
      "unit_id": "DLG_ec4b08416a5f",
      "text": "平常會有守衛押送我到廚房，並在我做飯時盯著我。 ",
      "encoded_ascii": "^0Y^#O^$r^$s^#+^(=^7Z^./^$%^!u^,%^,<^*A^!+^\"d^$%^*~^9;^$f^:U^-a^$%^!\" ",
      "encoded_base64": "XjBZXiNPXiRyXiRzXiMrXig9XjdaXi4vXiQlXiF1XiwlXiw8XipBXiErXiJkXiQlXip+Xjk7XiRmXjpVXi1hXiQlXiEiIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_96e372b66f71",
      "text": "其餘時候廚房是沒有人看守的。何況，我很清楚自己在後方待遇 ",
      "encoded_ascii": "^!j^1e^$f^*|^,%^,<^,X^%\\^$s^!<^*Q^#+^&Z^!\"^!L^,q^*A^$%^*K^,u^,c^'l^#I^\"d^#b^$]^,*^.2 ",
      "encoded_base64": "XiFqXjFlXiRmXip8XiwlXiw8XixYXiVcXiRzXiE8XipRXiMrXiZaXiEiXiFMXixxXipBXiQlXipLXix1XixjXidsXiNJXiJkXiNiXiRdXiwqXi4yIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_2bc2482abdee",
      "text": "有多好。我雖然是個奴隸，卻備受禮遇。要是讓我到荒野裡苦苦掙扎求生， ",
      "encoded_ascii": "^$s^\"x^+i^!\"^$%^.A^&\"^,X^!V^##^)Z^*A^1&^+\"^\";^-8^.2^!\"^(C^,X^-}^$%^!u^1W^.:^-j^.t^.t^.g^,=^,n^&F^*A ",
      "encoded_base64": "XiRzXiJ4XitpXiEiXiQlXi5BXiYiXixYXiFWXiMjXilaXipBXjEmXisiXiI7Xi04Xi4yXiEiXihDXixYXi19XiQlXiF1XjFXXi46Xi1qXi50Xi50Xi5nXiw9XixuXiZGXipBIA==",
      "byte_length": 100
    },
    {
      "unit_id": "DLG_070bd8ad4378",
      "text": "我可不會感到快活。",
      "encoded_ascii": "^$%^\"A^!)^$r^#{^!u^*L^%i^!\"",
      "encoded_base64": "XiQlXiJBXiEpXiRyXiN7XiF1XipMXiVpXiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_55778b85c913",
      "text": "  關於吉拉爾，你知道些什麼？",
      "encoded_ascii": "  ^.>^$^^\"D^$6^&/^*A^*F^&h^(y^!8^!=^.T^.V",
      "encoded_base64": "ICBeLj5eJF5eIkReJDZeJi9eKkFeKkZeJmheKHleITheIT1eLlReLlY=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_d045746f79b1",
      "text": "  關於米爾隆，你知道些什麼？",
      "encoded_ascii": "  ^.>^$^^'4^&/^)T^*A^*F^&h^(y^!8^!=^.T^.V",
      "encoded_base64": "ICBeLj5eJF5eJzReJi9eKVReKkFeKkZeJmheKHleITheIT1eLlReLlY=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_7256d47bbac8",
      "text": "  關於刀疤，你知道些什麼？",
      "encoded_ascii": "  ^.>^$^^7Q^5g^*A^*F^&h^(y^!8^!=^.T^.V",
      "encoded_base64": "ICBeLj5eJF5eN1FeNWdeKkFeKkZeJmheKHleITheIT1eLlReLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_2b5b4612d810",
      "text": "  關於梅爾佐爾，你知道些什麼？",
      "encoded_ascii": "  ^.>^$^^%-^&/^>1^&/^*A^*F^&h^(y^!8^!=^.T^.V",
      "encoded_base64": "ICBeLj5eJF5eJS1eJi9ePjFeJi9eKkFeKkZeJmheKHleITheIT1eLlReLlY=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_5049d00dbdc9",
      "text": "  關於特權管事，你知道些什麼？",
      "encoded_ascii": "  ^.>^$^^&5^1E^-D^*r^*A^*F^&h^(y^!8^!=^.T^.V",
      "encoded_base64": "ICBeLj5eJF5eJjVeMUVeLUReKnJeKkFeKkZeJmheKHleITheIT1eLlReLlY=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_e677ebc2d07f",
      "text": "他是個退役角鬥士。過去他曾在奴隸欄東北側盤踞著一夥勢力， ",
      "encoded_ascii": "^!@^,X^!V^*V^17^(H^*,^+a^!\"^(x^\"6^!@^.j^\"d^##^)Z^%C^,`^+6^!\\^1M^1_^-a^!%^5?^\"&^!~^*A ",
      "encoded_base64": "XiFAXixYXiFWXipWXjE3XihIXiosXithXiEiXih4XiI2XiFAXi5qXiJkXiMjXilaXiVDXixgXis2XiFcXjFNXjFfXi1hXiElXjU/XiImXiF+XipBIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_f6ff4d2a38da",
      "text": "掌管一個幫派。 ",
      "encoded_ascii": "^$;^-D^!%^!V^+}^.n^!\" ",
      "encoded_base64": "XiQ7Xi1EXiElXiFWXit9Xi5uXiEiIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_988251347a81",
      "text": "他是個退伍老兵，因為欠下賭債而被貶入奴隸欄。 ",
      "encoded_ascii": "^!@^,X^!V^*V^!F^'U^+,^*A^\"]^%{^,g^!(^=L^<d^'W^(@^>7^!f^##^)Z^%C^!\" ",
      "encoded_base64": "XiFAXixYXiFWXipWXiFGXidVXissXipBXiJdXiV7XixnXiEoXj1MXjxkXidXXihAXj43XiFmXiMjXilaXiVDXiEiIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_f5530b333cb0",
      "text": "他的幫派成員全由德拉吉的前守衛組成——他們對他誓死效忠， ",
      "encoded_ascii": "^!@^&Z^+}^.n^$$^+G^!h^&I^#j^$6^\"D^&Z^!z^#+^(=^2;^$$^*n^*n^!@^*{^#:^!@^-w^%L^$Q^.d^*A ",
      "encoded_base64": "XiFAXiZaXit9Xi5uXiQkXitHXiFoXiZJXiNqXiQ2XiJEXiZaXiF6XiMrXig9XjI7XiQkXipuXipuXiFAXip7XiM6XiFAXi13XiVMXiRRXi5kXipBIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_2906e7c85a9a",
      "text": "忠心耿耿。 ",
      "encoded_ascii": "^.d^#k^=!^=!^!\" ",
      "encoded_base64": "Xi5kXiNrXj0hXj0hXiEiIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_e6877c7b9858",
      "text": "你們心裡很清楚吉拉爾遭遇了什麼！我是說，呃，那個—— ",
      "encoded_ascii": "^*F^*{^#k^-j^*K^,u^,c^\"D^$6^&/^(}^.2^*D^!=^.T^*W^$%^,X^-x^*A^3<^*A^)!^!V^*n^*n ",
      "encoded_base64": "XipGXip7XiNrXi1qXipLXix1XixjXiJEXiQ2XiYvXih9Xi4yXipEXiE9Xi5UXipXXiQlXixYXi14XipBXjM8XipBXikhXiFWXipuXipuIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_3f63e6c971f2",
      "text": "我絕沒有冒犯的意思。 ",
      "encoded_ascii": "^$%^-I^%\\^$s^/P^-%^&Z^#z^#q^!\" ",
      "encoded_base64": "XiQlXi1JXiVcXiRzXi9QXi0lXiZaXiN6XiNxXiEiIA==",
      "byte_length": 31
    },
    {
      "unit_id": "DLG_454cc4634750",
      "text": "吉拉爾以前是個角鬥士。我就只知道這麼多。 ",
      "encoded_ascii": "^\"D^$6^&/^!B^!z^,X^!V^(H^*,^+a^!\"^$%^*J^\"?^&h^(y^(s^.T^\"x^!\" ",
      "encoded_base64": "XiJEXiQ2XiYvXiFCXiF6XixYXiFWXihIXiosXithXiEiXiQlXipKXiI/XiZoXih5XihzXi5UXiJ4XiEiIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_fe3e6336a41a",
      "text": "你們自己都見過她了。到了這個地步，你們知道的不比我少。 ",
      "encoded_ascii": "^*F^*{^'l^#I^)$^-m^(x^+h^*D^!\"^!u^*D^(s^!V^\"e^,i^*A^*F^*{^&h^(y^&Z^!)^,m^$%^#<^!\" ",
      "encoded_base64": "XipGXip7XidsXiNJXikkXi1tXih4XitoXipEXiEiXiF1XipEXihzXiFWXiJlXixpXipBXipGXip7XiZoXih5XiZaXiEpXixtXiQlXiM8XiEiIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_3cd925e04872",
      "text": "既然我已經治好了她，你們現在該去跟她談談。 ",
      "encoded_ascii": "^,U^&\"^$%^#J^'D^%_^+i^*D^+h^*A^*F^*{^&?^\"d^(M^\"6^.+^+h^0;^0;^!\" ",
      "encoded_base64": "XixVXiYiXiQlXiNKXidEXiVfXitpXipEXitoXipBXipGXip7XiY/XiJkXihNXiI2Xi4rXitoXjA7XjA7XiEiIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_4c157759f06e",
      "text": "吉拉爾的情況很奇特。有一陣子她原本還好好的。後來她失蹤了幾天， ",
      "encoded_ascii": "^\"D^$6^&/^&Z^,0^,q^*K^\"}^&5^!\"^$s^!%^)P^#(^+h^\"5^$x^.7^+i^+i^&Z^!\"^#b^!O^+h^\"|^(b^*D^#T^+e^*A ",
      "encoded_base64": "XiJEXiQ2XiYvXiZaXiwwXixxXipLXiJ9XiY1XiEiXiRzXiElXilQXiMoXitoXiI1XiR4Xi43XitpXitpXiZaXiEiXiNiXiFPXitoXiJ8XihiXipEXiNUXitlXipBIA==",
      "byte_length": 94
    },
    {
      "unit_id": "DLG_99066a40289e",
      "text": "從那之後她就徹底變了一個人。看到有人變成那樣真令人唏噓。 ",
      "encoded_ascii": "^#f^)!^!/^#b^+h^*J^18^/^^(U^*D^!%^!V^!<^!\"^*Q^!u^$s^!<^(U^$$^)!^,f^-2^*w^!<^>2^/W^!\" ",
      "encoded_base64": "XiNmXikhXiEvXiNiXitoXipKXjE4Xi9eXihVXipEXiElXiFWXiE8XiEiXipRXiF1XiRzXiE8XihVXiQkXikhXixmXi0yXip3XiE8Xj4yXi9XXiEiIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_d88c6450a75b",
      "text": "看到有人變成那種模樣真令人難過。她根本記不得超過 ",
      "encoded_ascii": "^*Q^!u^$s^!<^(U^$$^)!^'$^%:^,f^-2^*w^!<^)a^(x^!\"^+h^%)^$x^(K^!)^#e^(\\^(x ",
      "encoded_base64": "XipRXiF1XiRzXiE8XihVXiQkXikhXickXiU6XixmXi0yXip3XiE8XilhXih4XiEiXitoXiUpXiR4XihLXiEpXiNlXihcXih4IA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_f7e90c47830b",
      "text": "一天的任何事。她甚至不知道我是誰。",
      "encoded_ascii": "^!%^+e^&Z^!C^!L^*r^!\"^+h^/|^'n^!)^&h^(y^$%^,X^-y^!\"",
      "encoded_base64": "XiElXitlXiZaXiFDXiFMXipyXiEiXitoXi98XiduXiEpXiZoXih5XiQlXixYXi15XiEi",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_e2c74472eb5c",
      "text": "我最近沒聽說他的消息。看來他似乎遭遇了某種 ",
      "encoded_ascii": "^$%^$q^(l^%\\^-X^-x^!@^&Z^%k^#w^!\"^*Q^!O^!@^!H^!0^(}^.2^*D^%$^'$ ",
      "encoded_base64": "XiQlXiRxXihsXiVcXi1YXi14XiFAXiZaXiVrXiN3XiEiXipRXiFPXiFAXiFIXiEwXih9Xi4yXipEXiUkXickIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_77dcd9f3dbae",
      "text": "意外事故。 ",
      "encoded_ascii": "^#z^\"w^*r^5U^!\" ",
      "encoded_base64": "XiN6XiJ3XipyXjVVXiEiIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_23c2397ee7cb",
      "text": "米爾隆才剛被關進來不久。還沒人真正跟他深談過。去打聽看看 ",
      "encoded_ascii": "^'4^&/^)T^$,^+0^(@^.>^(w^!O^!)^!.^!\"^.7^%\\^!<^-2^%H^.+^!@^2*^0;^(x^!\"^\"6^$-^-X^*Q^*Q ",
      "encoded_base64": "Xic0XiYvXilUXiQsXiswXihAXi4+Xih3XiFPXiEpXiEuXiEiXi43XiVcXiE8Xi0yXiVIXi4rXiFAXjIqXjA7Xih4XiEiXiI2XiQtXi1YXipRXipRIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_01855766c358",
      "text": "你能查到些什麼，再回頭告訴我。",
      "encoded_ascii": "^*F^'b^%&^!u^!8^!=^.T^*A^!l^\"\\^)t^+B^-t^$%^!\"",
      "encoded_base64": "XipGXidiXiUmXiF1XiE4XiE9Xi5UXipBXiFsXiJcXil0XitCXi10XiQlXiEi",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_1c4419736a77",
      "text": "在你們出現之前，他一直是這牢欄的霸主。 ",
      "encoded_ascii": "^\"d^*F^*{^!q^&?^!/^!z^*A^!@^!%^&`^,X^(s^-$^%C^&Z^33^!-^!\" ",
      "encoded_base64": "XiJkXipGXip7XiFxXiY/XiEvXiF6XipBXiFAXiElXiZgXixYXihzXi0kXiVDXiZaXjMzXiEtXiEiIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_2c4579f70ed4",
      "text": "既然梅爾佐爾也死了，我想這意味著你們成了奴隸欄的新霸主。 ",
      "encoded_ascii": "^,U^&\"^%-^&/^>1^&/^!1^%L^*D^*A^$%^,1^(s^#z^1n^-a^*F^*{^$$^*D^##^)Z^%C^&Z^$\\^33^!-^!\" ",
      "encoded_base64": "XixVXiYiXiUtXiYvXj4xXiYvXiExXiVMXipEXipBXiQlXiwxXihzXiN6XjFuXi1hXipGXip7XiQkXipEXiMjXilaXiVDXiZaXiRcXjMzXiEtXiEiIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_2525596d7c3b",
      "text": "梅爾佐爾現在被公認為這兒最強悍的硬漢。",
      "encoded_ascii": "^%-^&/^>1^&/^&?^\"d^(@^3:^(O^%{^(s^++^$q^#]^,-^&Z^25^4Q^!\"",
      "encoded_base64": "XiUtXiYvXj4xXiYvXiY/XiJkXihAXjM6XihPXiV7XihzXisrXiRxXiNdXiwtXiZaXjI1XjRRXiEi",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_c5ea53a5ef9e",
      "text": "刀疤和他的黨羽是奴隸欄裡戰鬥力最強悍的角鬥士。 ",
      "encoded_ascii": "^7Q^5g^\"O^!@^&Z^:e^'S^,X^##^)Z^%C^-j^$(^*,^!~^$q^#]^,-^&Z^(H^*,^+a^!\" ",
      "encoded_base64": "XjdRXjVnXiJPXiFAXiZaXjplXidTXixYXiMjXilaXiVDXi1qXiQoXiosXiF+XiRxXiNdXiwtXiZaXihIXiosXithXiEiIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_07fa702e8862",
      "text": "他們在八個月前被尊封為『牢欄之王』，那時他們擊敗了整整 ",
      "encoded_ascii": "^!@^*{^\"d^50^!V^/p^!z^(@^+u^#5^%{^<_^-$^%C^!/^-)^<`^*A^)!^$f^!@^*{^$F^$R^*D^$T^$T ",
      "encoded_base64": "XiFAXip7XiJkXjUwXiFWXi9wXiF6XihAXit1XiM1XiV7XjxfXi0kXiVDXiEvXi0pXjxgXipBXikhXiRmXiFAXip7XiRGXiRSXipEXiRUXiRUIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_a9b7a1e104cd",
      "text": "一打的山脈追蹤者，那是其他任何角鬥小隊都從未達成過的 ",
      "encoded_ascii": "^!%^$-^&Z^11^6i^(o^(b^'V^*A^)!^,X^!j^!@^!C^!L^(H^*,^#;^)U^)$^#f^,_^(z^$$^(x^&Z ",
      "encoded_base64": "XiElXiQtXiZaXjExXjZpXihvXihiXidWXipBXikhXixYXiFqXiFAXiFDXiFMXihIXiosXiM7XilVXikkXiNmXixfXih6XiQkXih4XiZaIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_f69c6fcace86",
      "text": "壯舉。",
      "encoded_ascii": "^+b^01^!\"",
      "encoded_base64": "XitiXjAxXiEi",
      "byte_length": 9
    },
    {
      "unit_id": "DLG_ddaaf0a60ee9",
      "text": "他的屍體在走廊上被發現，血肉模糊堆成一團，慘不忍睹。 ",
      "encoded_ascii": "^!@^&Z^#?^**^\"d^.&^,$^!'^(@^&W^&?^*A^(:^'^^%:^'8^*[^$$^!%^0V^*A^,4^!)^1y^>6^!\" ",
      "encoded_base64": "XiFAXiZaXiM/XioqXiJkXi4mXiwkXiEnXihAXiZXXiY/XipBXig6XideXiU6Xic4XipbXiQkXiElXjBWXipBXiw0XiEpXjF5Xj42XiEiIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_aee204ecd8ba",
      "text": "那不是守衛幹的——肯定是某個心狠手辣的角鬥士下的毒手。 ",
      "encoded_ascii": "^)!^!)^,X^#+^(=^,!^&Z^*n^*n^-Z^#.^,X^%$^!V^#k^4T^$+^67^&Z^(H^*,^+a^!(^&Z^%Q^$+^!\" ",
      "encoded_base64": "XikhXiEpXixYXiMrXig9XiwhXiZaXipuXipuXi1aXiMuXixYXiUkXiFWXiNrXjRUXiQrXjY3XiZaXihIXiosXithXiEoXiZaXiVRXiQrXiEiIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_3617c6ac4ef3",
      "text": "特權管事是個年邁的退役角鬥士。曾有一隻山脈追蹤者襲擊了他和 ",
      "encoded_ascii": "^&5^1E^-D^*r^,X^!V^+~^2N^&Z^*V^17^(H^*,^+a^!\"^.j^$s^!%^)[^11^6i^(o^(b^'V^08^$F^*D^!@^\"O ",
      "encoded_base64": "XiY1XjFFXi1EXipyXixYXiFWXit+XjJOXiZaXipWXjE3XihIXiosXithXiEiXi5qXiRzXiElXilbXjExXjZpXihvXihiXidWXjA4XiRGXipEXiFAXiJPIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_7f2c1f475978",
      "text": "總教頭。管事斬殺了那隻凶獸，救了總教頭一命， ",
      "encoded_ascii": "^-M^,R^)t^!\"^-D^*r^9B^%M^*D^)!^)[^3e^&<^*A^,Q^*D^-M^,R^)t^!%^\"N^*A ",
      "encoded_base64": "Xi1NXixSXil0XiEiXi1EXipyXjlCXiVNXipEXikhXilbXjNlXiY8XipBXixRXipEXi1NXixSXil0XiElXiJOXipBIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_ce6445f550a4",
      "text": "自己卻落下了重度殘疾。教頭因此允許管事繼續留在奴隸欄裡， ",
      "encoded_ascii": "^'l^#I^1&^-`^!(^*D^))^#V^,l^&Q^!\"^,R^)t^\"]^%I^/\"^-s^-D^*r^-O^'M^-+^\"d^##^)Z^%C^-j^*A ",
      "encoded_base64": "XidsXiNJXjEmXi1gXiEoXipEXikpXiNWXixsXiZRXiEiXixSXil0XiJdXiVJXi8iXi1zXi1EXipyXi1PXidNXi0rXiJkXiMjXilaXiVDXi1qXipBIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_beb42963c9d9",
      "text": "充當打雜差役。",
      "encoded_ascii": "^5.^&N^$-^0G^48^17^!\"",
      "encoded_base64": "XjUuXiZOXiQtXjBHXjQ4XjE3XiEi",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_06ad857372e6",
      "text": "那就這樣吧。",
      "encoded_ascii": "^)!^*J^(s^,f^*I^!\"",
      "encoded_base64": "XikhXipKXihzXixmXipJXiEi",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_ba00076e550b",
      "text": "  她很好。",
      "encoded_ascii": "  ^+h^*K^+i^!\"",
      "encoded_base64": "ICBeK2heKkteK2leISI=",
      "byte_length": 14
    },
    {
      "unit_id": "DLG_30075a77ce6c",
      "text": "  你打聽這個幹什麼？",
      "encoded_ascii": "  ^*F^$-^-X^(s^!V^,!^!=^.T^.V",
      "encoded_base64": "ICBeKkZeJC1eLVheKHNeIVZeLCFeIT1eLlReLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_7f60b8089e2e",
      "text": "  她痛苦萬分。",
      "encoded_ascii": "  ^+h^-.^.t^-_^!s^!\"",
      "encoded_base64": "ICBeK2heLS5eLnReLV9eIXNeISI=",
      "byte_length": 20
    },
    {
      "unit_id": "DLG_b24106af97c7",
      "text": "  她頭部劇痛。",
      "encoded_ascii": "  ^+h^)t^)#^1#^-.^!\"",
      "encoded_base64": "ICBeK2heKXReKSNeMSNeLS5eISI=",
      "byte_length": 20
    },
    {
      "unit_id": "DLG_c65a8036e88b",
      "text": "  只要她一想到逃跑，頭痛就會發作。",
      "encoded_ascii": "  ^\"?^(C^+h^!%^,1^!u^(p^(_^*A^)t^-.^*J^$r^&W^!M^!\"",
      "encoded_base64": "ICBeIj9eKENeK2heISVeLDFeIXVeKHBeKF9eKkFeKXReLS5eKkpeJHJeJldeIU1eISI=",
      "byte_length": 50
    },
    {
      "unit_id": "DLG_2b5a42405a48",
      "text": "  太好了！跟我來。",
      "encoded_ascii": "  ^+f^+i^*D^*W^.+^$%^!O^!\"",
      "encoded_base64": "ICBeK2ZeK2leKkReKldeLiteJCVeIU9eISI=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_8e981a935fda",
      "text": "  你能怎麼幫助她？",
      "encoded_ascii": "  ^*F^'b^,,^.T^+}^\"#^+h^.V",
      "encoded_base64": "ICBeKkZeJ2JeLCxeLlReK31eIiNeK2heLlY=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_2a6d881c1982",
      "text": "那真是太好了。發生了什麼事？",
      "encoded_ascii": "^)!^-2^,X^+f^+i^*D^!\"^&W^&F^*D^!=^.T^*r^.V",
      "encoded_base64": "XikhXi0yXixYXitmXitpXipEXiEiXiZXXiZGXipEXiE9Xi5UXipyXi5W",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_332869f2f93d",
      "text": "這麼說吧，我可不希望看到像她那樣迷人的 ",
      "encoded_ascii": "^(s^.T^-x^*I^*A^$%^\"A^!)^+{^,]^*Q^!u^!`^+h^)!^,f^(n^!<^&Z ",
      "encoded_base64": "XihzXi5UXi14XipJXipBXiQlXiJBXiEpXit7XixdXipRXiF1XiFgXitoXikhXixmXihuXiE8XiZaIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_b70339ef722c",
      "text": "年輕女子遭遇任何不測。 ",
      "encoded_ascii": "^+~^(g^#\"^#(^(}^.2^!C^!L^!)^%p^!\" ",
      "encoded_base64": "Xit+XihnXiMiXiMoXih9Xi4yXiFDXiFMXiEpXiVwXiEiIA==",
      "byte_length": 34
    },
    {
      "unit_id": "DLG_fb19d5360f3f",
      "text": "沒時間多說了！立刻帶我去找她。",
      "encoded_ascii": "^%\\^$f^)G^\"x^-x^*D^*W^0'^.Y^#N^$%^\"6^$/^+h^!\"",
      "encoded_base64": "XiVcXiRmXilHXiJ4Xi14XipEXipXXjAnXi5ZXiNOXiQlXiI2XiQvXitoXiEi",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_4bc1be3bf113",
      "text": "要帶迪諾斯去找吉拉爾嗎？",
      "encoded_ascii": "^(C^#N^(m^7k^$[^\"6^$/^\"D^$6^&/^+X^.V",
      "encoded_base64": "XihDXiNOXihtXjdrXiRbXiI2XiQvXiJEXiQ2XiYvXitYXi5W",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_4be0a2e5d9a5",
      "text": "她知道為什麼會發生這種事嗎？",
      "encoded_ascii": "^+h^&h^(y^%{^!=^.T^$r^&W^&F^(s^'$^*r^+X^.V",
      "encoded_base64": "XitoXiZoXih5XiV7XiE9Xi5UXiRyXiZXXiZGXihzXickXipyXitYXi5W",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_5892e985b0b0",
      "text": "一想到逃跑就發作？嗯……",
      "encoded_ascii": "^!%^,1^!u^(p^(_^*J^&W^!M^.V^6N^*o^*o",
      "encoded_base64": "XiElXiwxXiF1XihwXihfXipKXiZXXiFNXi5WXjZOXipvXipv",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_a959d1bbaaa6",
      "text": "她曾失蹤了幾天。也許她真的逃跑過！我敢肯定， ",
      "encoded_ascii": "^+h^.j^\"|^(b^*D^#T^+e^!\"^!1^-s^+h^-2^&Z^(p^(_^(x^*W^$%^/m^-Z^#.^*A ",
      "encoded_base64": "XitoXi5qXiJ8XihiXipEXiNUXitlXiEiXiExXi1zXitoXi0yXiZaXihwXihfXih4XipXXiQlXi9tXi1aXiMuXipBIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_fbffb06296fa",
      "text": "聖堂武士絕對跟她所承受的痛苦脫不了干係。帶我去找她吧， ",
      "encoded_ascii": "^'Z^42^%J^+a^-I^#:^.+^+h^$)^$0^\";^&Z^-.^.t^'c^!)^*D^#R^38^!\"^#N^$%^\"6^$/^+h^*I^*A ",
      "encoded_base64": "XidaXjQyXiVKXithXi1JXiM6Xi4rXitoXiQpXiQwXiI7XiZaXi0uXi50XidjXiEpXipEXiNSXjM4XiEiXiNOXiQlXiI2XiQvXitoXipJXipBIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_8e88df36f854",
      "text": "我想我能幫上忙。",
      "encoded_ascii": "^$%^,1^$%^'b^+}^!'^,+^!\"",
      "encoded_base64": "XiQlXiwxXiQlXidiXit9XiEnXiwrXiEi",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_f91e8037a46d",
      "text": "我不太確定自己是怎麼做到的，但我以前確實治好過頭腦心智有病患的 ",
      "encoded_ascii": "^$%^!)^+f^-6^#.^'l^#I^,X^,,^.T^*~^!u^&Z^*A^!I^$%^!B^!z^-6^#3^%_^+i^(x^)t^2@^#k^$i^$s^&R^;Q^&Z ",
      "encoded_base64": "XiQlXiEpXitmXi02XiMuXidsXiNJXixYXiwsXi5UXip+XiF1XiZaXipBXiFJXiQlXiFCXiF6Xi02XiMzXiVfXitpXih4Xil0XjJAXiNrXiRpXiRzXiZSXjtRXiZaIA==",
      "byte_length": 94
    },
    {
      "unit_id": "DLG_58166fe0b246",
      "text": "人。俗話說：『嘗試又不是受刑，何妨一試。』",
      "encoded_ascii": "^!<^!\"^8e^-v^-x^*B^<_^1o^-u^+;^!)^,X^\";^9|^*A^!L^5D^!%^-u^!\"^<`",
      "encoded_base64": "XiE8XiEiXjhlXi12Xi14XipCXjxfXjFvXi11Xis7XiEpXixYXiI7Xjl8XipBXiFMXjVEXiElXi11XiEiXjxg",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_0309b661879f",
      "text": "噓。前面的衛兵要是看見你們，會放雙足飛龍咬你們的…… ",
      "encoded_ascii": "^/W^!\"^!z^)j^&Z^(=^+,^(C^,X^*Q^-m^*F^*{^*A^$r^$P^)_^(^^)z^*>^\"Q^*F^*{^&Z^*o^*o ",
      "encoded_base64": "Xi9XXiEiXiF6XilqXiZaXig9XissXihDXixYXipRXi1tXipGXip7XipBXiRyXiRQXilfXiheXil6Xio+XiJRXipGXip7XiZaXipvXipvIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_9fc2dde4bc60",
      "text": "快，躲進最後這個欄舍，我去引開他們。我會跟他們說雙足飛龍…… ",
      "encoded_ascii": "^*L^*A^0C^(w^$q^#b^(s^!V^%C^03^*A^$%^\"6^#Z^)F^!@^*{^!\"^$%^$r^.+^!@^*{^-x^)_^(^^)z^*>^*o^*o ",
      "encoded_base64": "XipMXipBXjBDXih3XiRxXiNiXihzXiFWXiVDXjAzXipBXiQlXiI2XiNaXilGXiFAXip7XiEiXiQlXiRyXi4rXiFAXip7Xi14XilfXiheXil6Xio+XipvXipvIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_58c10a814738",
      "text": "大師需要牠們還是怎麼著。",
      "encoded_ascii": "^\"z^#M^)e^(C^-#^*{^.7^,X^,,^.T^-a^!\"",
      "encoded_base64": "XiJ6XiNNXillXihDXi0jXip7Xi43XixYXiwsXi5UXi1hXiEi",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_adaf3261588d",
      "text": "那邊那個！站住！",
      "encoded_ascii": "^)!^.8^)!^!V^*W^->^*z^*W",
      "encoded_base64": "XikhXi44XikhXiFWXipXXi0+Xip6XipX",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_c5f1c3fc71c7",
      "text": "克雷格，快去拉拉桿，把雙足飛龍放出來！",
      "encoded_ascii": "^!d^)c^%*^*A^*L^\"6^$6^$6^%,^*A^$1^)_^(^^)z^*>^$P^!q^!O^*W",
      "encoded_base64": "XiFkXiljXiUqXipBXipMXiI2XiQ2XiQ2XiUsXipBXiQxXilfXiheXil6Xio+XiRQXiFxXiFPXipX",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_e9e3f023a660",
      "text": "快！躲進這裡。",
      "encoded_ascii": "^*L^*W^0C^(w^(s^-j^!\"",
      "encoded_base64": "XipMXipXXjBDXih3XihzXi1qXiEi",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_c516acfd5b9e",
      "text": "衛兵！衛兵！我抓到他們了！",
      "encoded_ascii": "^(=^+,^*W^(=^+,^*W^$%^$2^!u^!@^*{^*D^*W",
      "encoded_base64": "Xig9XissXipXXig9XissXipXXiQlXiQyXiF1XiFAXip7XipEXipX",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_3a160fcae70c",
      "text": " 猛力撞倒了門！",
      "encoded_ascii": " ^*P^!~^/l^!X^*D^)D^*W",
      "encoded_base64": "IF4qUF4hfl4vbF4hWF4qRF4pRF4qVw==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_45bafa2287a5",
      "text": " 猛捶著房門。衛兵嘲弄著你們徒勞無功的逃跑舉動。",
      "encoded_ascii": " ^*P^/d^-a^,<^)D^!\"^(=^+,^+Z^/`^-a^*F^*{^#d^/R^%}^\"!^&Z^(p^(_^01^\"%^!\"",
      "encoded_base64": "IF4qUF4vZF4tYV4sPF4pRF4hIl4oPV4rLF4rWl4vYF4tYV4qRl4qe14jZF4vUl4lfV4iIV4mWl4ocF4oX14wMV4iJV4hIg==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_b91258a61090",
      "text": "是誰在那裡？",
      "encoded_ascii": "^,X^-y^\"d^)!^-j^.V",
      "encoded_base64": "XixYXi15XiJkXikhXi1qXi5W",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_e57308d59c4b",
      "text": "有入侵者！醒醒！快醒醒！",
      "encoded_ascii": "^$s^!f^.X^'V^*W^.9^.9^*W^*L^.9^.9^*W",
      "encoded_base64": "XiRzXiFmXi5YXidWXipXXi45Xi45XipXXipMXi45Xi45XipX",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_33409f90aecd",
      "text": "求求你們，快走開！",
      "encoded_ascii": "^,n^,n^*F^*{^*A^*L^.&^)F^*W",
      "encoded_base64": "XixuXixuXipGXip7XipBXipMXi4mXilGXipX",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_b15c22963460",
      "text": "什、什麼事？現在不是我值班。",
      "encoded_ascii": "^!=^!!^!=^.T^*r^.V^&?^\"d^!)^,X^$%^!Z^/{^!\"",
      "encoded_base64": "XiE9XiEhXiE9Xi5UXipyXi5WXiY/XiJkXiEpXixYXiQlXiFaXi97XiEi",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_7849974c6973",
      "text": "  閉嘴，不然我殺了你！",
      "encoded_ascii": "  ^.=^+[^*A^!)^&\"^$%^%M^*D^*F^*W",
      "encoded_base64": "ICBeLj1eK1teKkFeISleJiJeJCVeJU1eKkReKkZeKlc=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_f7ba9f1fee09",
      "text": "  拜託，我只是想跟你談談。",
      "encoded_ascii": "  ^,E^-q^*A^$%^\"?^,X^,1^.+^*F^0;^0;^!\"",
      "encoded_base64": "ICBeLEVeLXFeKkFeJCVeIj9eLFheLDFeLiteKkZeMDteMDteISI=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_dd6983ac2fc9",
      "text": "  你這人渣，要嘛招供，要嘛受死！",
      "encoded_ascii": "  ^*F^(s^!<^,v^*A^(C^+Y^,D^!P^*A^(C^+Y^\";^%L^*W",
      "encoded_base64": "ICBeKkZeKHNeITxeLHZeKkFeKENeK1leLEReIVBeKkFeKENeK1leIjteJUxeKlc=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_9992658d1752",
      "text": "  求求你，我保證不會傷害你。",
      "encoded_ascii": "  ^,n^,n^*F^*A^$%^!T^-{^!)^$r^!^^#/^*F^!\"",
      "encoded_base64": "ICBeLG5eLG5eKkZeKkFeJCVeIVReLXteISleJHJeIV5eIy9eKkZeISI=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_03277e1e9f1e",
      "text": "  回去睡覺吧。",
      "encoded_ascii": "  ^\"\\^\"6^-3^(G^*I^!\"",
      "encoded_base64": "ICBeIlxeIjZeLTNeKEdeKkleISI=",
      "byte_length": 20
    },
    {
      "unit_id": "DLG_dd1bf4c98801",
      "text": "不，別殺我！求求你，我發誓絕不告訴任何人你們在這裡！",
      "encoded_ascii": "^!)^*A^*H^%M^$%^*W^,n^,n^*F^*A^$%^&W^-w^-I^!)^+B^-t^!C^!L^!<^*F^*{^\"d^(s^-j^*W",
      "encoded_base64": "XiEpXipBXipIXiVNXiQlXipXXixuXixuXipGXipBXiQlXiZXXi13Xi1JXiEpXitCXi10XiFDXiFMXiE8XipGXip7XiJkXihzXi1qXipX",
      "byte_length": 78
    },
    {
      "unit_id": "DLG_920bc3f5a20a",
      "text": "  跟我說說雙足飛龍大師的事。",
      "encoded_ascii": "  ^.+^$%^-x^-x^)_^(^^)z^*>^\"z^#M^&Z^*r^!\"",
      "encoded_base64": "ICBeLiteJCVeLXheLXheKV9eKF5eKXpeKj5eInpeI01eJlpeKnJeISI=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_ee3da9732ce6",
      "text": "  大師是如何控制雙足飛龍的？",
      "encoded_ascii": "  ^\"z^#M^,X^#$^!L^$@^!v^)_^(^^)z^*>^&Z^.V",
      "encoded_base64": "ICBeInpeI01eLFheIyReIUxeJEBeIXZeKV9eKF5eKXpeKj5eJlpeLlY=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_19220685d726",
      "text": "  查耶羅是誰？",
      "encoded_ascii": "  ^%&^0.^/?^,X^-y^.V",
      "encoded_base64": "ICBeJSZeMC5eLz9eLFheLXleLlY=",
      "byte_length": 20
    },
    {
      "unit_id": "DLG_5dad12737561",
      "text": "  這座城堡是誰建造的？",
      "encoded_ascii": "  ^(s^/_^+_^\"m^,X^-y^,'^(v^&Z^.V",
      "encoded_base64": "ICBeKHNeL19eK19eIm1eLFheLXleLCdeKHZeJlpeLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_f110c20364e7",
      "text": "  黑色迷宮是什麼？",
      "encoded_ascii": "  ^*:^'s^(n^/\\^,X^!=^.T^.V",
      "encoded_base64": "ICBeKjpeJ3NeKG5eL1xeLFheIT1eLlReLlY=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_127c87f228a3",
      "text": "  塔拉是誰？",
      "encoded_ascii": "  ^\"o^$6^,X^-y^.V",
      "encoded_base64": "ICBeIm9eJDZeLFheLXleLlY=",
      "byte_length": 17
    },
    {
      "unit_id": "DLG_3a5f7b9c8d29",
      "text": "回去睡吧，你只是在做噩夢。",
      "encoded_ascii": "^\"\\^\"6^-3^*I^*A^*F^\"?^,X^\"d^*~^/X^\"y^!\"",
      "encoded_base64": "XiJcXiI2Xi0zXipJXipBXipGXiI/XixYXiJkXip+Xi9YXiJ5XiEi",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_b552e4144127",
      "text": "我才不跟偷偷摸摸靠過來的盜賊說話！",
      "encoded_ascii": "^$%^$,^!)^.+^/O^/O^/j^/j^.C^(x^!O^&Z^0!^0?^-x^-v^*W",
      "encoded_base64": "XiQlXiQsXiEpXi4rXi9PXi9PXi9qXi9qXi5DXih4XiFPXiZaXjAhXjA/Xi14Xi12XipX",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_4f57be068430",
      "text": "我才不信你！",
      "encoded_ascii": "^$%^$,^!)^!U^*F^*W",
      "encoded_base64": "XiQlXiQsXiEpXiFVXipGXipX",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_dfa4c4d71cd7",
      "text": "好讓你割開我的喉嚨嗎？",
      "encoded_ascii": "^+i^-}^*F^+1^)F^$%^&Z^/V^/Y^+X^.V",
      "encoded_base64": "XitpXi19XipGXisxXilGXiQlXiZaXi9WXi9ZXitYXi5W",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_673005e31288",
      "text": "救命！有入侵者！",
      "encoded_ascii": "^,Q^\"N^*W^$s^!f^.X^'V^*W",
      "encoded_base64": "XixRXiJOXipXXiRzXiFmXi5YXidWXipX",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_84c56cb6956a",
      "text": "求求你，我發誓絕不告訴任何人你們來過，但是……",
      "encoded_ascii": "^,n^,n^*F^*A^$%^&W^-w^-I^!)^+B^-t^!C^!L^!<^*F^*{^!O^(x^*A^!I^,X^*o^*o",
      "encoded_base64": "XixuXixuXipGXipBXiQlXiZXXi13Xi1JXiEpXitCXi10XiFDXiFMXiE8XipGXip7XiFPXih4XipBXiFJXixYXipvXipv",
      "byte_length": 69
    },
    {
      "unit_id": "DLG_31c786faea22",
      "text": " 我沒什麼好再說的了。其他衛兵會聽見的！",
      "encoded_ascii": " ^$%^%\\^!=^.T^+i^!l^-x^&Z^*D^!\"^!j^!@^(=^+,^$r^-X^-m^&Z^*W",
      "encoded_base64": "IF4kJV4lXF4hPV4uVF4raV4hbF4teF4mWl4qRF4hIl4hal4hQF4oPV4rLF4kcl4tWF4tbV4mWl4qVw==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_a9da92a49718",
      "text": "雙足飛龍大師在城堡上層有獨立的住處。",
      "encoded_ascii": "^)_^(^^)z^*>^\"z^#M^\"d^+_^\"m^!'^#B^$s^/z^0'^&Z^*z^(,^!\"",
      "encoded_base64": "XilfXiheXil6Xio+XiJ6XiNNXiJkXitfXiJtXiEnXiNCXiRzXi96XjAnXiZaXip6XigsXiEi",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_8187299d4542",
      "text": "那段知識早已永遠湮滅。我有一次讓一隻雙足飛龍死掉，大師就把…… ",
      "encoded_ascii": "^)!^.l^&h^(R^,V^#J^%W^({^/u^%t^!\"^$%^$s^!%^%D^-}^!%^)[^)_^(^^)z^*>^%L^/e^*A^\"z^#M^*J^$1^*o^*o ",
      "encoded_base64": "XikhXi5sXiZoXihSXixWXiNKXiVXXih7Xi91XiV0XiEiXiQlXiRzXiElXiVEXi19XiElXilbXilfXiheXil6Xio+XiVMXi9lXipBXiJ6XiNNXipKXiQxXipvXipvIA==",
      "byte_length": 94
    },
    {
      "unit_id": "DLG_247d7e588c25",
      "text": "我丟進黑色迷宮當作懲罰。那裡的食屍鬼般可怖生物對我說話…… ",
      "encoded_ascii": "^$%^*q^(w^*:^'s^(n^/\\^&N^!M^/b^0-^!\"^)!^-j^&Z^0J^#?^*-^'r^\"A^#p^&F^&4^#:^$%^-x^-v^*o^*o ",
      "encoded_base64": "XiQlXipxXih3Xio6XidzXihuXi9cXiZOXiFNXi9iXjAtXiEiXikhXi1qXiZaXjBKXiM/XiotXidyXiJBXiNwXiZGXiY0XiM6XiQlXi14Xi12XipvXipvIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_6ce326f5130d",
      "text": "告訴我這座城堡甚至在牠們活著的年代就已經是古蹟了。",
      "encoded_ascii": "^+B^-t^$%^(s^/_^+_^\"m^/|^'n^\"d^-#^*{^%i^-a^&Z^+~^*v^*J^#J^'D^,X^\"=^0B^*D^!\"",
      "encoded_base64": "XitCXi10XiQlXihzXi9fXitfXiJtXi98XiduXiJkXi0jXip7XiVpXi1hXiZaXit+Xip2XipKXiNKXidEXixYXiI9XjBCXipEXiEi",
      "byte_length": 75
    },
    {
      "unit_id": "DLG_9337cc7fa99f",
      "text": "穿過守護符文後的走廊被稱為黑色迷宮。那裡…… ",
      "encoded_ascii": "^')^(x^#+^(T^'+^$W^#b^&Z^.&^,$^(@^0&^%{^*:^'s^(n^/\\^!\"^)!^-j^*o^*o ",
      "encoded_base64": "XicpXih4XiMrXihUXicrXiRXXiNiXiZaXi4mXiwkXihAXjAmXiV7Xio6XidzXihuXi9cXiEiXikhXi1qXipvXipvIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_2e53818a68bb",
      "text": "那裡囚禁著塔拉的信徒……他們全都瘋了！ ",
      "encoded_ascii": "^)!^-j^\"Z^&y^-a^\"o^$6^&Z^!U^#d^*o^*o^!@^*{^!h^)$^-/^*D^*W ",
      "encoded_base64": "XikhXi1qXiJaXiZ5Xi1hXiJvXiQ2XiZaXiFVXiNkXipvXipvXiFAXip7XiFoXikkXi0vXipEXipXIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_c071387b9bb9",
      "text": "數百年的歲月腐蝕了他們的心智與身軀。",
      "encoded_ascii": "^$V^&Y^+~^&Z^,j^/p^0/^(4^*D^!@^*{^&Z^#k^$i^'p^(c^(d^!\"",
      "encoded_base64": "XiRWXiZZXit+XiZaXixqXi9wXjAvXig0XipEXiFAXip7XiZaXiNrXiRpXidwXihjXihkXiEi",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_602515a3647e",
      "text": "我不知道。大師曾提過她，但他語氣中的恐懼…… ",
      "encoded_ascii": "^$%^!)^&h^(y^!\"^\"z^#M^.j^$A^(x^+h^*A^!I^!@^0:^%U^!,^&Z^#t^$#^*o^*o ",
      "encoded_base64": "XiQlXiEpXiZoXih5XiEiXiJ6XiNNXi5qXiRBXih4XitoXipBXiFJXiFAXjA6XiVVXiEsXiZaXiN0XiQjXipvXipvIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_4784ce7ca9e8",
      "text": "讓我不敢追問太多。",
      "encoded_ascii": "^-}^$%^!)^/m^(o^*Z^+f^\"x^!\"",
      "encoded_base64": "Xi19XiQlXiEpXi9tXihvXipaXitmXiJ4XiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_2c85b6cd3da6",
      "text": "大師找到了這座城堡並把我們帶到這裡。他控制了…… ",
      "encoded_ascii": "^\"z^#M^$/^!u^*D^(s^/_^+_^\"m^!+^$1^$%^*{^#N^!u^(s^-j^!\"^!@^$@^!v^*D^*o^*o ",
      "encoded_base64": "XiJ6XiNNXiQvXiF1XipEXihzXi9fXitfXiJtXiErXiQxXiQlXip7XiNOXiF1XihzXi1qXiEiXiFAXiRAXiF2XipEXipvXipvIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_b2e786622b46",
      "text": "雙足飛龍，我們也因此發了大財。",
      "encoded_ascii": "^)_^(^^)z^*>^*A^$%^*{^!1^\"]^%I^&W^*D^\"z^0=^!\"",
      "encoded_base64": "XilfXiheXil6Xio+XipBXiQlXip7XiExXiJdXiVJXiZXXipEXiJ6XjA9XiEi",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_581987f2edf3",
      "text": "他有一根控制魔獸的魔法騎鉤。查耶羅可能…… ",
      "encoded_ascii": "^!@^$s^!%^%)^$@^!v^*0^&<^&Z^*0^%b^0K^)/^!\"^%&^0.^/?^\"A^'b^*o^*o ",
      "encoded_base64": "XiFAXiRzXiElXiUpXiRAXiF2XiowXiY8XiZaXiowXiViXjBLXikvXiEiXiUmXjAuXi8/XiJBXidiXipvXipvIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_afe5f8fd70f4",
      "text": "知道得更多。",
      "encoded_ascii": "^&h^(y^#e^$o^\"x^!\"",
      "encoded_base64": "XiZoXih5XiNlXiRvXiJ4XiEi",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_40b5ba7f5cba",
      "text": "只是我們幫派的一員。他是負責照料雙足飛龍的人。你…… ",
      "encoded_ascii": "^\"?^,X^$%^*{^+}^.n^&Z^!%^+G^!\"^!@^,X^(W^0>^/x^/n^)_^(^^)z^*>^&Z^!<^!\"^*F^*o^*o ",
      "encoded_base64": "XiI/XixYXiQlXip7Xit9Xi5uXiZaXiElXitHXiEiXiFAXixYXihXXjA+Xi94Xi9uXilfXiheXil6Xio+XiZaXiE8XiEiXipGXipvXipvIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_a71f79bc5354",
      "text": "大概可以在起飛室找到他，我們在那裡存放雙足飛龍的騎具…… ",
      "encoded_ascii": "^\"z^,d^\"A^!B^\"d^.(^)z^+r^$/^!u^!@^*A^$%^*{^\"d^)!^-j^#*^$P^)_^(^^)z^*>^&Z^0K^!k^*o^*o ",
      "encoded_base64": "XiJ6XixkXiJBXiFCXiJkXi4oXil6XityXiQvXiF1XiFAXipBXiQlXip7XiJkXikhXi1qXiMqXiRQXilfXiheXil6Xio+XiZaXjBLXiFrXipvXipvIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_caa6a6af0c99",
      "text": "騎具並整備牠們準備突襲。",
      "encoded_ascii": "^0K^!k^!+^$T^+\"^-#^*{^,x^+\"^'*^08^!\"",
      "encoded_base64": "XjBLXiFrXiErXiRUXisiXi0jXip7Xix4XisiXicqXjA4XiEi",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_f4f2f548511f",
      "text": "沒問題。我根本沒看見你們。",
      "encoded_ascii": "^%\\^*Z^.G^!\"^$%^%)^$x^%\\^*Q^-m^*F^*{^!\"",
      "encoded_base64": "XiVcXipaXi5HXiEiXiQlXiUpXiR4XiVcXipRXi1tXipGXip7XiEi",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_6b477c556bd9",
      "text": " 求求你，我說的難道還不夠多嗎？",
      "encoded_ascii": " ^,n^,n^*F^*A^$%^-x^&Z^)a^(y^.7^!)^+d^\"x^+X^.V",
      "encoded_base64": "IF4sbl4sbl4qRl4qQV4kJV4teF4mWl4pYV4oeV4uN14hKV4rZF4ieF4rWF4uVg==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_5e67a6245800",
      "text": "  問題由我來問，你這渣滓！",
      "encoded_ascii": "  ^*Z^.G^&I^$%^!O^*Z^*A^*F^(s^,v^,y^*W",
      "encoded_base64": "ICBeKlpeLkdeJkleJCVeIU9eKlpeKkFeKkZeKHNeLHZeLHleKlc=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_7f76eaec1c24",
      "text": "  好吧，我讓你回去睡覺。",
      "encoded_ascii": "  ^+i^*I^*A^$%^-}^*F^\"\\^\"6^-3^(G^!\"",
      "encoded_base64": "ICBeK2leKkleKkFeJCVeLX1eKkZeIlxeIjZeLTNeKEdeISI=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_d2d26db09a10",
      "text": "好吧，我不是有意要冒犯你。請原諒我。",
      "encoded_ascii": "^+i^*I^*A^$%^!)^,X^$s^#z^(C^/P^-%^*F^!\"^*S^\"5^0<^$%^!\"",
      "encoded_base64": "XitpXipJXipBXiQlXiEpXixYXiRzXiN6XihDXi9QXi0lXipGXiEiXipTXiI1XjA8XiQlXiEi",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_7b1ddb8d9efb",
      "text": "你輕易地殺死了這個女人。 ",
      "encoded_ascii": "^*F^(g^,W^\"e^%M^%L^*D^(s^!V^#\"^!<^!\" ",
      "encoded_base64": "XipGXihnXixXXiJlXiVNXiVMXipEXihzXiFWXiMiXiE8XiEiIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_f1f878782c57",
      "text": "你們最好趕快離開這裡！守衛遲早會大批趕來的。 ",
      "encoded_ascii": "^*F^*{^$q^+i^0u^*L^)`^)F^(s^-j^*W^#+^(=^.5^,V^$r^\"z^2i^0u^!O^&Z^!\" ",
      "encoded_base64": "XipGXip7XiRxXitpXjB1XipMXilgXilGXihzXi1qXipXXiMrXig9Xi41XixWXiRyXiJ6XjJpXjB1XiFPXiZaXiEiIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_70d3dc9946e5",
      "text": "你怎麼能殺了迪諾斯？他是個多麼善良又慷慨的人啊！ ",
      "encoded_ascii": "^*F^,,^.T^'b^%M^*D^(m^7k^$[^.V^!@^,X^!V^\"x^.T^1(^1V^+;^70^7/^&Z^!<^+Q^*W ",
      "encoded_base64": "XipGXiwsXi5UXidiXiVNXipEXihtXjdrXiRbXi5WXiFAXixYXiFWXiJ4Xi5UXjEoXjFWXis7XjcwXjcvXiZaXiE8XitRXipXIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_b83c62cf6d94",
      "text": "快去競技場戰鬥吧，庫爾扎克正在找你們呢。等你們回來時，我會 ",
      "encoded_ascii": "^*L^\"6^-?^,>^\"n^$(^*,^*I^*A^,#^&/^,=^!d^%H^\"d^$/^*F^*{^+C^!\"^'-^*F^*{^\"\\^!O^$f^*A^$%^$r ",
      "encoded_base64": "XipMXiI2Xi0/Xiw+XiJuXiQoXiosXipJXipBXiwjXiYvXiw9XiFkXiVIXiJkXiQvXipGXip7XitDXiEiXictXipGXip7XiJcXiFPXiRmXipBXiQlXiRyIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_f0f1bdf742d6",
      "text": "一直待在這兒。 ",
      "encoded_ascii": "^!%^&`^,*^\"d^(s^++^!\" ",
      "encoded_base64": "XiElXiZgXiwqXiJkXihzXisrXiEiIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_e72601af0add",
      "text": "我每次只要一思考，頭痛就會加劇。等我感覺好些時 ",
      "encoded_ascii": "^$%^%P^%D^\"?^(C^!%^#q^-R^*A^)t^-.^*J^$r^\"\"^1#^!\"^'-^$%^#{^(G^+i^!8^$f ",
      "encoded_base64": "XiQlXiVQXiVEXiI/XihDXiElXiNxXi1SXipBXil0Xi0uXipKXiRyXiIiXjEjXiEiXictXiQlXiN7XihHXitpXiE4XiRmIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_ae1e88656f69",
      "text": "再跟你們說話。",
      "encoded_ascii": "^!l^.+^*F^*{^-x^-v^!\"",
      "encoded_base64": "XiFsXi4rXipGXip7Xi14Xi12XiEi",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_0051432aad37",
      "text": "你們好。你們是誰，想要做什麼？",
      "encoded_ascii": "^*F^*{^+i^!\"^*F^*{^,X^-y^*A^,1^(C^*~^!=^.T^.V",
      "encoded_base64": "XipGXip7XitpXiEiXipGXip7XixYXi15XipBXiwxXihDXip+XiE9Xi5UXi5W",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_52d7fb066d0a",
      "text": "很高興又見到你們。 ",
      "encoded_ascii": "^*K^*+^-]^+;^-m^!u^*F^*{^!\" ",
      "encoded_base64": "XipLXiorXi1dXis7Xi1tXiF1XipGXip7XiEiIA==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_0810fa73fe72",
      "text": "  我該怎麼再次進入競技場戰鬥？",
      "encoded_ascii": "  ^$%^(M^,,^.T^!l^%D^(w^!f^-?^,>^\"n^$(^*,^.V",
      "encoded_base64": "ICBeJCVeKE1eLCxeLlReIWxeJUReKHdeIWZeLT9eLD5eIm5eJCheKixeLlY=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_89956f8bcdd4",
      "text": "  你有聽說什麼新消息嗎？ ",
      "encoded_ascii": "  ^*F^$s^-X^-x^!=^.T^$\\^%k^#w^+X^.V ",
      "encoded_base64": "ICBeKkZeJHNeLVheLXheIT1eLlReJFxeJWteI3deK1heLlYg",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_8d6bb92606cc",
      "text": "  你在這裡被關多久了？",
      "encoded_ascii": "  ^*F^\"d^(s^-j^(@^.>^\"x^!.^*D^.V",
      "encoded_base64": "ICBeKkZeImReKHNeLWpeKEBeLj5eInheIS5eKkReLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_4e9d7721c700",
      "text": "  這些稻草全是用來做什麼的？ ",
      "encoded_ascii": "  ^(s^!8^>:^*f^!h^,X^&H^!O^*~^!=^.T^&Z^.V ",
      "encoded_base64": "ICBeKHNeIThePjpeKmZeIWheLFheJkheIU9eKn5eIT1eLlReJlpeLlYg",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_eff4bd23ccbe",
      "text": "  角鬥士平時都要與什麼生物戰鬥？",
      "encoded_ascii": "  ^(H^*,^+a^0Y^$f^)$^(C^'p^!=^.T^&F^&4^$(^*,^.V",
      "encoded_base64": "ICBeKEheKixeK2FeMFleJGZeKSReKENeJ3BeIT1eLlReJkZeJjReJCheKixeLlY=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_23ec251f7075",
      "text": "  奴隸欄裡還有誰被關著？",
      "encoded_ascii": "  ^##^)Z^%C^-j^.7^$s^-y^(@^.>^-a^.V",
      "encoded_base64": "ICBeIyNeKVpeJUNeLWpeLjdeJHNeLXleKEBeLj5eLWFeLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_6268a512fd8e",
      "text": "  這裡有很多守衛嗎？",
      "encoded_ascii": "  ^(s^-j^$s^*K^\"x^#+^(=^+X^.V",
      "encoded_base64": "ICBeKHNeLWpeJHNeKkteInheIyteKD1eK1heLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_774d269af0c6",
      "text": "只要走到北面牆上的大門前敲門就行。庫爾扎克馬上就會來 ",
      "encoded_ascii": "^\"?^(C^.&^!u^+6^)j^&0^!'^&Z^\"z^)D^!z^1A^)D^*J^(;^!\"^,#^&/^,=^!d^*\"^!'^*J^$r^!O ",
      "encoded_base64": "XiI/XihDXi4mXiF1Xis2XilqXiYwXiEnXiZaXiJ6XilEXiF6XjFBXilEXipKXig7XiEiXiwjXiYvXiw9XiFkXioiXiEnXipKXiRyXiFPIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_2b4c4886e108",
      "text": "應門。 ",
      "encoded_ascii": "^0`^)D^!\" ",
      "encoded_base64": "XjBgXilEXiEiIA==",
      "byte_length": 10
    },
    {
      "unit_id": "DLG_dbdbeadaafad",
      "text": "沒有，自從上次跟你們說話後就沒聽到什麼新消息。 ",
      "encoded_ascii": "^%\\^$s^*A^'l^#f^!'^%D^.+^*F^*{^-x^-v^#b^*J^%\\^-X^!u^!=^.T^$\\^%k^#w^!\" ",
      "encoded_base64": "XiVcXiRzXipBXidsXiNmXiEnXiVEXi4rXipGXip7Xi14Xi12XiNiXipKXiVcXi1YXiF1XiE9Xi5UXiRcXiVrXiN3XiEiIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_b66df3aa3fa2",
      "text": "很高興認識你， ",
      "encoded_ascii": "^*K^*+^-]^(O^(R^*F^*A ",
      "encoded_base64": "XipLXiorXi1dXihPXihSXipGXipBIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_27ba1dd6bd64",
      "text": "。我是吉拉爾。",
      "encoded_ascii": "^!\"^$%^,X^\"D^$6^&/^!\"",
      "encoded_base64": "XiEiXiQlXixYXiJEXiQ2XiYvXiEi",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_45751f43b988",
      "text": "我偷了一條麵包來養活家人。他們那時快要餓死了。我根本 ",
      "encoded_ascii": "^$%^/O^*D^!%^%.^*5^\"'^!O^.I^%i^+s^!<^!\"^!@^*{^)!^$f^*L^(C^2R^%L^*D^!\"^$%^%)^$x ",
      "encoded_base64": "XiQlXi9PXipEXiElXiUuXio1XiInXiFPXi5JXiVpXitzXiE8XiEiXiFAXip7XikhXiRmXipMXihDXjJSXiVMXipEXiEiXiQlXiUpXiR4IA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_8af718418ce3",
      "text": "別無選擇。鄰居為了懸賞賞金把我給告發了。而他的家人， ",
      "encoded_ascii": "^*H^%}^.6^,N^!\"^)%^+w^%{^*D^0a^*T^*T^)+^$1^$%^'A^+B^&W^*D^!\"^'W^!@^&Z^+s^!<^*A ",
      "encoded_base64": "XipIXiV9Xi42XixOXiEiXiklXit3XiV7XipEXjBhXipUXipUXikrXiQxXiQlXidBXitCXiZXXipEXiEiXidXXiFAXiZaXitzXiE8XipBIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_8c6c798c70b9",
      "text": "當時同樣也挨著餓。",
      "encoded_ascii": "^&N^$f^\"E^,f^!1^7\\^-a^2R^!\"",
      "encoded_base64": "XiZOXiRmXiJFXixmXiExXjdcXi1hXjJSXiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_fd50dda532cd",
      "text": "我在這裡被關了幾個月了。",
      "encoded_ascii": "^$%^\"d^(s^-j^(@^.>^*D^#T^!V^/p^*D^!\"",
      "encoded_base64": "XiQlXiJkXihzXi1qXihAXi4+XipEXiNUXiFWXi9wXipEXiEi",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_b2a85c736f83",
      "text": "當然是用來睡覺鋪地的。德拉吉的角鬥士或許受人尊崇， ",
      "encoded_ascii": "^&N^&\"^,X^&H^!O^-3^(G^<1^\"e^&Z^!\"^#j^$6^\"D^&Z^(H^*,^+a^$'^-s^\";^!<^+u^13^*A ",
      "encoded_base64": "XiZOXiYiXixYXiZIXiFPXi0zXihHXjwxXiJlXiZaXiEiXiNqXiQ2XiJEXiZaXihIXiosXithXiQnXi1zXiI7XiE8Xit1XjEzXipBIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_5bc130dc0812",
      "text": "但我們依然只能睡在冰冷的泥地上。 ",
      "encoded_ascii": "^!I^$%^*{^!Q^&\"^\"?^'b^-3^\"d^!m^!n^&Z^%d^\"e^!'^!\" ",
      "encoded_base64": "XiFJXiQlXip7XiFRXiYiXiI/XidiXi0zXiJkXiFtXiFuXiZaXiVkXiJlXiEnXiEiIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_b088007b1a73",
      "text": "我被捕之後，立刻和其他五名角鬥士一起被扔進競技場， ",
      "encoded_ascii": "^$%^(@^4?^!/^#b^*A^0'^.Y^\"O^!j^!@^!6^\"F^(H^*,^+a^!%^.(^(@^8{^(w^-?^,>^\"n^*A ",
      "encoded_base64": "XiQlXihAXjQ/XiEvXiNiXipBXjAnXi5ZXiJPXiFqXiFAXiE2XiJGXihIXiosXithXiElXi4oXihAXjh7Xih3Xi0/Xiw+XiJuXipBIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_b96b89d11b04",
      "text": "與一群尖叫甲蟲搏鬥。我是唯一的倖存者。 ",
      "encoded_ascii": "^'p^!%^'R^#=^+<^&J^(8^,K^*,^!\"^$%^,X^+O^!%^&Z^5+^#*^'V^!\" ",
      "encoded_base64": "XidwXiElXidSXiM9Xis8XiZKXig4XixLXiosXiEiXiQlXixYXitPXiElXiZaXjUrXiMqXidWXiEiIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_7687b92bf59c",
      "text": "萬幸的是，從那之後我就再沒上場打過了。",
      "encoded_ascii": "^-_^15^&Z^,X^*A^#f^)!^!/^#b^$%^*J^!l^%\\^!'^\"n^$-^(x^*D^!\"",
      "encoded_base64": "Xi1fXjE1XiZaXixYXipBXiNmXikhXiEvXiNiXiQlXipKXiFsXiVcXiEnXiJuXiQtXih4XipEXiEi",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_8eda29bc9440",
      "text": "剛開始的時候，你們要對付的就只有尖叫甲蟲和斯拉格人。之後， ",
      "encoded_ascii": "^+0^)F^+k^&Z^$f^*|^*A^*F^*{^(C^#:^*u^&Z^*J^\"?^$s^#=^+<^&J^(8^\"O^$[^$6^%*^!<^!\"^!/^#b^*A ",
      "encoded_base64": "XiswXilGXitrXiZaXiRmXip8XipBXipGXip7XihDXiM6Xip1XiZaXipKXiI/XiRzXiM9Xis8XiZKXig4XiJPXiRbXiQ2XiUqXiE8XiEiXiEvXiNiXipBIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_374fa5cb8d32",
      "text": "他們會放些野蠻的穆爾人和叛變的半身人來對付你們。一旦你們的表現 ",
      "encoded_ascii": "^!@^*{^$r^$P^!8^.:^/H^&Z^8K^&/^!<^\"O^.Z^(U^&Z^\"-^(c^!<^!O^#:^*u^*F^*{^!\"^!%^1C^*F^*{^&Z^-i^&? ",
      "encoded_base64": "XiFAXip7XiRyXiRQXiE4Xi46Xi9IXiZaXjhLXiYvXiE8XiJPXi5aXihVXiZaXiItXihjXiE8XiFPXiM6Xip1XipGXip7XiEiXiElXjFDXipGXip7XiZaXi1pXiY/IA==",
      "byte_length": 94
    },
    {
      "unit_id": "DLG_aeaa88fc94f3",
      "text": "非常出色，他們就會開始安排你們跟像山脈追蹤者那樣的凶獸 ",
      "encoded_ascii": "^)i^#O^!q^'s^*A^!@^*{^*J^$r^)F^+k^+p^$<^*F^*{^.+^!`^11^6i^(o^(b^'V^)!^,f^&Z^3e^&< ",
      "encoded_base64": "XilpXiNPXiFxXidzXipBXiFAXip7XipKXiRyXilGXitrXitwXiQ8XipGXip7Xi4rXiFgXjExXjZpXihvXihiXidWXikhXixmXiZaXjNlXiY8IA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_fc8fc9192f93",
      "text": "搏殺。我很慶幸自己沒走到那一步——否則我絕不可能活著挺過 ",
      "encoded_ascii": "^,K^%M^!\"^$%^*K^5P^15^'l^#I^%\\^.&^!u^)!^!%^,i^*n^*n^\"H^!x^$%^-I^!)^\"A^'b^%i^-a^,I^(x ",
      "encoded_base64": "XixLXiVNXiEiXiQlXipLXjVQXjE1XidsXiNJXiVcXi4mXiF1XikhXiElXixpXipuXipuXiJIXiF4XiQlXi1JXiEpXiJBXidiXiVpXi1hXixJXih4IA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_f488bb2ad4f0",
      "text": "來。",
      "encoded_ascii": "^!O^!\"",
      "encoded_base64": "XiFPXiEi",
      "byte_length": 6
    },
    {
      "unit_id": "DLG_6763a924e89a",
      "text": "我唯一說過話的另一個人就是特權管事。",
      "encoded_ascii": "^$%^+O^!%^-x^(x^-v^&Z^\">^!%^!V^!<^*J^,X^&5^1E^-D^*r^!\"",
      "encoded_base64": "XiQlXitPXiElXi14Xih4Xi12XiZaXiI+XiElXiFWXiE8XipKXixYXiY1XjFFXi1EXipyXiEi",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_cbc681ec694e",
      "text": " 你們是誰？",
      "encoded_ascii": " ^*F^*{^,X^-y^.V",
      "encoded_base64": "IF4qRl4qe14sWF4teV4uVg==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_0f7e035a55fd",
      "text": "我不太確定。我是被庫爾扎克帶到這裡來的，我只看見北邊的衛兵哨站裡 ",
      "encoded_ascii": "^$%^!)^+f^-6^#.^!\"^$%^,X^(@^,#^&/^,=^!d^#N^!u^(s^-j^!O^&Z^*A^$%^\"?^*Q^-m^+6^.8^&Z^(=^+,^:Q^->^-j ",
      "encoded_base64": "XiQlXiEpXitmXi02XiMuXiEiXiQlXixYXihAXiwjXiYvXiw9XiFkXiNOXiF1XihzXi1qXiFPXiZaXipBXiQlXiI/XipRXi1tXis2Xi44XiZaXig9XissXjpRXi0+Xi1qIA==",
      "byte_length": 97
    },
    {
      "unit_id": "DLG_23838c20a8a8",
      "text": "有幾個守衛。除了他們之外，我就不清楚了。",
      "encoded_ascii": "^$s^#T^!V^#+^(=^!\"^)Q^*D^!@^*{^!/^\"w^*A^$%^*J^!)^,u^,c^*D^!\"",
      "encoded_base64": "XiRzXiNUXiFWXiMrXig9XiEiXilRXipEXiFAXip7XiEvXiJ3XipBXiQlXipKXiEpXix1XixjXipEXiEi",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_abebeeed9ed5",
      "text": "有沒有人逃跑過？我想……我……",
      "encoded_ascii": "^$s^%\\^$s^!<^(p^(_^(x^.V^$%^,1^*o^*o^$%^*o^*o",
      "encoded_base64": "XiRzXiVcXiRzXiE8XihwXihfXih4Xi5WXiQlXiwxXipvXipvXiQlXipvXipv",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_51581a498d18",
      "text": "噢，我的頭！好痛！",
      "encoded_ascii": "^+]^*A^$%^&Z^)t^*W^+i^-.^*W",
      "encoded_base64": "XitdXipBXiQlXiZaXil0XipXXitpXi0uXipX",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_d426c1103a1f",
      "text": "  你還好嗎？",
      "encoded_ascii": "  ^*F^.7^+i^+X^.V",
      "encoded_base64": "ICBeKkZeLjdeK2leK1heLlY=",
      "byte_length": 17
    },
    {
      "unit_id": "DLG_e6830efe82a3",
      "text": "  發生了什麼事？",
      "encoded_ascii": "  ^&W^&F^*D^!=^.T^*r^.V",
      "encoded_base64": "ICBeJldeJkZeKkReIT1eLlReKnJeLlY=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_9897944f959e",
      "text": "  以前也發生過這種情況嗎？",
      "encoded_ascii": "  ^!B^!z^!1^&W^&F^(x^(s^'$^,0^,q^+X^.V",
      "encoded_base64": "ICBeIUJeIXpeITFeJldeJkZeKHheKHNeJyReLDBeLHFeK1heLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_40ea4762105d",
      "text": "我不知道。我現在感覺好多了。",
      "encoded_ascii": "^$%^!)^&h^(y^!\"^$%^&?^\"d^#{^(G^+i^\"x^*D^!\"",
      "encoded_base64": "XiQlXiEpXiZoXih5XiEiXiQlXiY/XiJkXiN7XihHXitpXiJ4XipEXiEi",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_41fdfe167c0e",
      "text": "一陣劇烈的灼痛刺穿了我的腦袋。",
      "encoded_ascii": "^!%^)P^1#^%|^&Z^9^^-.^!w^')^*D^$%^&Z^2@^(?^!\"",
      "encoded_base64": "XiElXilQXjEjXiV8XiZaXjleXi0uXiF3XicpXipEXiQlXiZaXjJAXig/XiEi",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_fc5c0d0b0491",
      "text": "我只有在想到逃跑的時候才會感到劇痛……",
      "encoded_ascii": "^$%^\"?^$s^\"d^,1^!u^(p^(_^&Z^$f^*|^$,^$r^#{^!u^1#^-.^*o^*o",
      "encoded_base64": "XiQlXiI/XiRzXiJkXiwxXiF1XihwXihfXiZaXiRmXip8XiQsXiRyXiN7XiF1XjEjXi0uXipvXipv",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_de543820a9bc",
      "text": "謝謝你們的幫助。你們真是難得一見的好心人。 ",
      "encoded_ascii": "^-z^-z^*F^*{^&Z^+}^\"#^!\"^*F^*{^-2^,X^)a^#e^!%^-m^&Z^+i^#k^!<^!\" ",
      "encoded_base64": "Xi16Xi16XipGXip7XiZaXit9XiIjXiEiXipGXip7Xi0yXixYXilhXiNlXiElXi1tXiZaXitpXiNrXiE8XiEiIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_8f581d2e1a60",
      "text": "  你現在感覺如何？",
      "encoded_ascii": "  ^*F^&?^\"d^#{^(G^#$^!L^.V",
      "encoded_base64": "ICBeKkZeJj9eImReI3teKEdeIyReIUxeLlY=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_18e80560ad58",
      "text": "  再跟我說一次逃脫的路線。",
      "encoded_ascii": "  ^!l^.+^$%^-x^!%^%D^(p^'c^&Z^(a^'I^!\"",
      "encoded_base64": "ICBeIWxeLiteJCVeLXheISVeJUReKHBeJ2NeJlpeKGFeJ0leISI=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_db0755df01da",
      "text": "  逃跑是怎麼一回事？",
      "encoded_ascii": "  ^(p^(_^,X^,,^.T^!%^\"\\^*r^.V",
      "encoded_base64": "ICBeKHBeKF9eLFheLCxeLlReISVeIlxeKnJeLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_d613d0ccb8c8",
      "text": "  你逃到了多遠的地方？",
      "encoded_ascii": "  ^*F^(p^!u^*D^\"x^({^&Z^\"e^$]^.V",
      "encoded_base64": "ICBeKkZeKHBeIXVeKkReInheKHteJlpeImVeJF1eLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_cb46a04cf606",
      "text": "  跟我一起走吧。我打算逃出去。",
      "encoded_ascii": "  ^.+^$%^!%^.(^.&^*I^!\"^$%^$-^-C^(p^!q^\"6^!\"",
      "encoded_base64": "ICBeLiteJCVeISVeLiheLiZeKkleISJeJCVeJC1eLUNeKHBeIXFeIjZeISI=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_fd64f7e6387e",
      "text": "  我正計畫逃脫。",
      "encoded_ascii": "  ^$%^%H^-n^-,^(p^'c^!\"",
      "encoded_base64": "ICBeJCVeJUheLW5eLSxeKHBeJ2NeISI=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_2e833bfa263e",
      "text": "  荒野是什麼樣子的？",
      "encoded_ascii": "  ^1W^.:^,X^!=^.T^,f^#(^&Z^.V",
      "encoded_base64": "ICBeMVdeLjpeLFheIT1eLlReLGZeIyheJlpeLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_90ffd6c11f20",
      "text": "  那些村落有多大？",
      "encoded_ascii": "  ^)!^!8^$z^-`^$s^\"x^\"z^.V",
      "encoded_base64": "ICBeKSFeITheJHpeLWBeJHNeInheInpeLlY=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_ea4608623a9c",
      "text": "  這些村落安全嗎？",
      "encoded_ascii": "  ^(s^!8^$z^-`^+p^!h^+X^.V",
      "encoded_base64": "ICBeKHNeITheJHpeLWBeK3BeIWheK1heLlY=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_aaeabdbd6f72",
      "text": "  這些傳言是怎麼回事？",
      "encoded_ascii": "  ^(s^!8^+$^1Y^,X^,,^.T^\"\\^*r^.V",
      "encoded_base64": "ICBeKHNeITheKyReMVleLFheLCxeLlReIlxeKnJeLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_6069e23de65d",
      "text": "  他們為什麼不聯合起來對抗他？",
      "encoded_ascii": "  ^!@^*{^%{^!=^.T^!)^-V^\"C^.(^!O^#:^$4^!@^.V",
      "encoded_base64": "ICBeIUBeKnteJXteIT1eLlReISleLVZeIkNeLiheIU9eIzpeJDReIUBeLlY=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_c8c44d8c3bec",
      "text": "  但是，他們可以遷移到新的地方。",
      "encoded_ascii": "  ^!I^,X^*A^!@^*{^\"A^!B^;~^'\"^!u^$\\^&Z^\"e^$]^!\"",
      "encoded_base64": "ICBeIUleLFheKkFeIUBeKnteIkFeIUJeO35eJyJeIXVeJFxeJlpeImVeJF1eISI=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_1ba791d6e0d2",
      "text": "  他們可以結盟共同奮戰。",
      "encoded_ascii": "  ^!@^*{^\"A^!B^'@^-0^3d^\"E^+g^$(^!\"",
      "encoded_base64": "ICBeIUBeKnteIkFeIUJeJ0BeLTBeM2ReIkVeK2deJCheISI=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_7987c414f093",
      "text": "他們怎麼可能互相信任？如果真有人能促成這件事，那將是足以 ",
      "encoded_ascii": "^!@^*{^,,^.T^\"A^'b^*s^&a^!U^!C^.V^#$^%!^-2^$s^!<^'b^2T^$$^(s^.W^*r^*A^)!^#7^,X^(^^!B ",
      "encoded_base64": "XiFAXip7XiwsXi5UXiJBXidiXipzXiZhXiFVXiFDXi5WXiMkXiUhXi0yXiRzXiE8XidiXjJUXiQkXihzXi5XXipyXipBXikhXiM3XixYXiheXiFCIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_353a814b4fab",
      "text": "世代傳頌的偉大壯舉。從來沒有人能夠把各個村落徹底 ",
      "encoded_ascii": "^*p^*v^+$^7\"^&Z^*}^\"z^+b^01^!\"^#f^!O^%\\^$s^!<^'b^+d^$1^+>^!V^$z^-`^18^/^ ",
      "encoded_base64": "XipwXip2XiskXjciXiZaXip9XiJ6XitiXjAxXiEiXiNmXiFPXiVcXiRzXiE8XidiXitkXiQxXis+XiFWXiR6Xi1gXjE4Xi9eIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_0e15e256c494",
      "text": "聯合結盟起來！",
      "encoded_ascii": "^-V^\"C^'@^-0^.(^!O^*W",
      "encoded_base64": "Xi1WXiJDXidAXi0wXi4oXiFPXipX",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_88ae7eab2702",
      "text": "我想也是，但他們其實根本無處可去。",
      "encoded_ascii": "^$%^,1^!1^,X^*A^!I^!@^*{^!j^#3^%)^$x^%}^(,^\"A^\"6^!\"",
      "encoded_base64": "XiQlXiwxXiExXixYXipBXiFJXiFAXip7XiFqXiMzXiUpXiR4XiV9XigsXiJBXiI2XiEi",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_2f4b7f8eba1e",
      "text": "你在說什麼？",
      "encoded_ascii": "^*F^\"d^-x^!=^.T^.V",
      "encoded_base64": "XipGXiJkXi14XiE9Xi5UXi5W",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_5b2db7a1fa48",
      "text": "我就只知道這些了。如果傳言屬實，那可就太不幸了。面對特克圖克特雷所能召集 ",
      "encoded_ascii": "^$%^*J^\"?^&h^(y^(s^!8^*D^!\"^#$^%!^+$^1Y^#C^#3^*A^)!^\"A^*J^+f^!)^15^*D^!\"^)j^#:^&5^!d^\"b^!d^&5^)c^$)^'b^\"@^)] ",
      "encoded_base64": "XiQlXipKXiI/XiZoXih5XihzXiE4XipEXiEiXiMkXiUhXiskXjFZXiNDXiMzXipBXikhXiJBXipKXitmXiEpXjE1XipEXiEiXilqXiM6XiY1XiFkXiJiXiFkXiY1XiljXiQpXidiXiJAXildIA==",
      "byte_length": 109
    },
    {
      "unit_id": "DLG_9ede51d893e0",
      "text": "的那種規模的大軍，那些散落的村落單憑自己根本無法獨力 ",
      "encoded_ascii": "^&Z^)!^'$^6'^%:^&Z^\"z^..^*A^)!^!8^$S^-`^&Z^$z^-`^2a^,5^'l^#I^%)^$x^%}^%b^/z^!~ ",
      "encoded_base64": "XiZaXikhXickXjYnXiU6XiZaXiJ6Xi4uXipBXikhXiE4XiRTXi1gXiZaXiR6Xi1gXjJhXiw1XidsXiNJXiUpXiR4XiV9XiViXi96XiF+IA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_2859680851b4",
      "text": "抵擋。",
      "encoded_ascii": "^$5^$G^!\"",
      "encoded_base64": "XiQ1XiRHXiEi",
      "byte_length": 9
    },
    {
      "unit_id": "DLG_3ce10f5b38ce",
      "text": "並不安全。但不管怎樣，總比待在這裡好。",
      "encoded_ascii": "^!+^!)^+p^!h^!\"^!I^!)^-D^,,^,f^*A^-M^,m^,*^\"d^(s^-j^+i^!\"",
      "encoded_base64": "XiErXiEpXitwXiFoXiEiXiFJXiEpXi1EXiwsXixmXipBXi1NXixtXiwqXiJkXihzXi1qXitpXiEi",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_cc5cb6f938a3",
      "text": "我其實不太清楚。我在城裡長大，那裡的人根本不關心 ",
      "encoded_ascii": "^$%^!j^#3^!)^+f^,u^,c^!\"^$%^\"d^+_^-j^)C^\"z^*A^)!^-j^&Z^!<^%)^$x^!)^.>^#k ",
      "encoded_base64": "XiQlXiFqXiMzXiEpXitmXix1XixjXiEiXiQlXiJkXitfXi1qXilDXiJ6XipBXikhXi1qXiZaXiE8XiUpXiR4XiEpXi4+XiNrIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_e22de196c1a1",
      "text": "城外的任何事情。他們盡量無視荒野。特別是在開始傳出 ",
      "encoded_ascii": "^+_^\"w^&Z^!C^!L^*r^,0^!\"^!@^*{^-1^)*^%}^(E^1W^.:^!\"^&5^*H^,X^\"d^)F^+k^+$^!q ",
      "encoded_base64": "XitfXiJ3XiZaXiFDXiFMXipyXiwwXiEiXiFAXip7Xi0xXikqXiV9XihFXjFXXi46XiEiXiY1XipIXixYXiJkXilGXitrXiskXiFxIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_213cb2e4b120",
      "text": "特克圖克特雷打算集結一支大軍，  ",
      "encoded_ascii": "^&5^!d^\"b^!d^&5^)c^$-^-C^)]^'@^!%^$L^\"z^..^*A  ",
      "encoded_base64": "XiY1XiFkXiJiXiFkXiY1XiljXiQtXi1DXildXidAXiElXiRMXiJ6Xi4uXipBICA=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_c7cd27b63795",
      "text": "企圖踏平那些村落的流言之後。",
      "encoded_ascii": "^4-^\"b^.,^0Y^)!^!8^$z^-`^&Z^%j^1Y^!/^#b^!\"",
      "encoded_base64": "XjQtXiJiXi4sXjBZXikhXiE4XiR6Xi1gXiZaXiVqXjFZXiEvXiNiXiEi",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_b0a462f1d65b",
      "text": "這很難說。大多數村落都很小，居民們僅能勉強餬口。 ",
      "encoded_ascii": "^(s^*K^)a^-x^!\"^\"z^\"x^$V^$z^-`^)$^*K^#;^*A^+w^%T^*{^!_^'b^9>^#]^>;^\"<^!\" ",
      "encoded_base64": "XihzXipLXilhXi14XiEiXiJ6XiJ4XiRWXiR6Xi1gXikkXipLXiM7XipBXit3XiVUXip7XiFfXidiXjk+XiNdXj47XiI8XiEiIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_9f7ef9c1993f",
      "text": "荒野中的水源根本不足以讓許多人長期集中生活在一起。 ",
      "encoded_ascii": "^1W^.:^!,^&Z^%V^%q^%)^$x^!)^(^^!B^-}^-s^\"x^!<^)C^$u^)]^!,^&F^%i^\"d^!%^.(^!\" ",
      "encoded_base64": "XjFXXi46XiEsXiZaXiVWXiVxXiUpXiR4XiEpXiheXiFCXi19Xi1zXiJ4XiE8XilDXiR1XildXiEsXiZGXiVpXiJkXiElXi4oXiEiIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_bc7389afb89e",
      "text": "不過，我聽說北方有一個村子，那裡有個人 ",
      "encoded_ascii": "^!)^(x^*A^$%^-X^-x^+6^$]^$s^!%^!V^$z^#(^*A^)!^-j^$s^!V^!< ",
      "encoded_base64": "XiEpXih4XipBXiQlXi1YXi14Xis2XiRdXiRzXiElXiFWXiR6XiMoXipBXikhXi1qXiRzXiFWXiE8IA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_e5802bbaca64",
      "text": "挖掘了一口井， ",
      "encoded_ascii": "^2!^=@^*D^!%^\"<^!7^*A ",
      "encoded_base64": "XjIhXj1AXipEXiElXiI8XiE3XipBIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_ded9343e9e40",
      "text": "而且維持了好幾年——我想他的名字似乎叫多米尼。但是， ",
      "encoded_ascii": "^'W^!*^'F^$7^*D^+i^#T^+~^*n^*n^$%^,1^!@^&Z^\"F^#)^!H^!0^+<^\"x^'4^#>^!\"^!I^,X^*A ",
      "encoded_base64": "XidXXiEqXidGXiQ3XipEXitpXiNUXit+XipuXipuXiQlXiwxXiFAXiZaXiJGXiMpXiFIXiEwXis8XiJ4Xic0XiM+XiEiXiFJXixYXipBIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_40b5b1fe1437",
      "text": "這大概不是真的，沒有人能辦得到那種事。",
      "encoded_ascii": "^(s^\"z^,d^!)^,X^-2^&Z^*A^%\\^$s^!<^'b^2L^#e^!u^)!^'$^*r^!\"",
      "encoded_base64": "XihzXiJ6XixkXiEpXixYXi0yXiZaXipBXiVcXiRzXiE8XidiXjJMXiNlXiF1XikhXickXipyXiEi",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_09ce9977a1ba",
      "text": "嗯，我並沒有逃出太遠，但我聽說有些村落住了很多 ",
      "encoded_ascii": "^6N^*A^$%^!+^%\\^$s^(p^!q^+f^({^*A^!I^$%^-X^-x^$s^!8^$z^-`^*z^*D^*K^\"x ",
      "encoded_base64": "XjZOXipBXiQlXiErXiVcXiRzXihwXiFxXitmXih7XipBXiFJXiQlXi1YXi14XiRzXiE4XiR6Xi1gXip6XipEXipLXiJ4IA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_e1d06190fcf0",
      "text": "逃脫出來的奴隸。 ",
      "encoded_ascii": "^(p^'c^!q^!O^&Z^##^)Z^!\" ",
      "encoded_base64": "XihwXidjXiFxXiFPXiZaXiMjXilaXiEiIA==",
      "byte_length": 25
    },
    {
      "unit_id": "DLG_ce8576155052",
      "text": "我感覺棒極了！這是我好長一段時間以來感覺最好的一刻；多虧了迪諾斯，我的 ",
      "encoded_ascii": "^$%^#{^(G^%1^1D^*D^*W^(s^,X^$%^+i^)C^!%^.l^$f^)G^!B^!O^#{^(G^$q^+i^&Z^!%^.Y^*C^\"x^9N^*D^(m^7k^$[^*A^$%^&Z ",
      "encoded_base64": "XiQlXiN7XihHXiUxXjFEXipEXipXXihzXixYXiQlXitpXilDXiElXi5sXiRmXilHXiFCXiFPXiN7XihHXiRxXitpXiZaXiElXi5ZXipDXiJ4XjlOXipEXihtXjdrXiRbXipBXiQlXiZaIA==",
      "byte_length": 106
    },
    {
      "unit_id": "DLG_0345945f0ee7",
      "text": "頭腦現在無比清醒。",
      "encoded_ascii": "^)t^2@^&?^\"d^%}^,m^,u^.9^!\"",
      "encoded_base64": "Xil0XjJAXiY/XiJkXiV9XixtXix1Xi45XiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_736f9b6d9c56",
      "text": "正如我之前告訴過你們的…… ",
      "encoded_ascii": "^%H^#$^$%^!/^!z^+B^-t^(x^*F^*{^&Z^*o^*o ",
      "encoded_base64": "XiVIXiMkXiQlXiEvXiF6XitCXi10Xih4XipGXip7XiZaXipvXipvIA==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_2a3a7f4dbee4",
      "text": "在最北側的怪獸牢欄裡，有一條密道 ",
      "encoded_ascii": "^\"d^$q^+6^!\\^&Z^#s^&<^-$^%C^-j^*A^$s^!%^%.^#0^(y ",
      "encoded_base64": "XiJkXiRxXis2XiFcXiZaXiNzXiY8Xi0kXiVDXi1qXipBXiRzXiElXiUuXiMwXih5IA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_0f145dc6b3bf",
      "text": "直通往下水道入口。那是位於牢欄西北角、 ",
      "encoded_ascii": "^&`^(t^,)^!(^%V^(y^!f^\"<^!\"^)!^,X^!J^$^^-$^%C^-l^+6^(H^!! ",
      "encoded_base64": "XiZgXih0XiwpXiEoXiVWXih5XiFmXiI8XiEiXikhXixYXiFKXiReXi0kXiVDXi1sXis2XihIXiEhIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_f85b26010f04",
      "text": "廚房西側的一個大洞。你們只要按下牢欄角落裡的按鈕， ",
      "encoded_ascii": "^,%^,<^-l^!\\^&Z^!%^!V^\"z^%h^!\"^*F^*{^\"?^(C^$9^!(^-$^%C^(H^-`^-j^&Z^$9^).^*A ",
      "encoded_base64": "XiwlXiw8Xi1sXiFcXiZaXiElXiFWXiJ6XiVoXiEiXipGXip7XiI/XihDXiQ5XiEoXi0kXiVDXihIXi1gXi1qXiZaXiQ5XikuXipBIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_4be6865247ef",
      "text": "它就會打開。",
      "encoded_ascii": "^+o^*J^$r^$-^)F^!\"",
      "encoded_base64": "XitvXipKXiRyXiQtXilGXiEi",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_656448cd2218",
      "text": "小心駐守在那裡的守衛。我當時不得不打碎東西來分散他的注意， ",
      "encoded_ascii": "^#;^#k^1f^#+^\"d^)!^-j^&Z^#+^(=^!\"^$%^&N^$f^!)^#e^!)^$-^&o^,`^-l^!O^!s^$S^!@^&Z^%e^#z^*A ",
      "encoded_base64": "XiM7XiNrXjFmXiMrXiJkXikhXi1qXiZaXiMrXig9XiEiXiQlXiZOXiRmXiEpXiNlXiEpXiQtXiZvXixgXi1sXiFPXiFzXiRTXiFAXiZaXiVlXiN6XipBIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_ca7551feb5cf",
      "text": "但你們大概可以直接把他宰了。",
      "encoded_ascii": "^!I^*F^*{^\"z^,d^\"A^!B^&`^$?^$1^!@^1w^*D^!\"",
      "encoded_base64": "XiFJXipGXip7XiJ6XixkXiJBXiFCXiZgXiQ/XiQxXiFAXjF3XipEXiEi",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_ed6c22690972",
      "text": "我一路逃到了北面的荒漠。當時有什麼東西驚嚇到了我， ",
      "encoded_ascii": "^$%^!%^(a^(p^!u^*D^+6^)j^&Z^1W^,}^!\"^&N^$f^$s^!=^.T^,`^-l^.Q^\"X^!u^*D^$%^*A ",
      "encoded_base64": "XiQlXiElXihhXihwXiF1XipEXis2XilqXiZaXjFXXix9XiEiXiZOXiRmXiRzXiE9Xi5UXixgXi1sXi5RXiJYXiF1XipEXiQlXipBIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_dab270e70b95",
      "text": "我急忙跳到一塊岩石後方。結果我跌下了堤坡，摔斷了我的 ",
      "encoded_ascii": "^$%^3p^,+^0@^!u^!%^/Z^#D^&k^#b^$]^!\"^'@^%!^$%^:a^!(^*D^>9^7u^*A^/i^,T^*D^$%^&Z ",
      "encoded_base64": "XiQlXjNwXiwrXjBAXiF1XiElXi9aXiNEXiZrXiNiXiRdXiEiXidAXiUhXiQlXjphXiEoXipEXj45Xjd1XipBXi9pXixUXipEXiQlXiZaIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_9f20970aa6eb",
      "text": "腿。城裡的衛兵隔天發現了我。聖堂武士治好了我的腿， ",
      "encoded_ascii": "^'h^!\"^+_^-j^&Z^(=^+,^9e^+e^&W^&?^*D^$%^!\"^'Z^42^%J^+a^%_^+i^*D^$%^&Z^'h^*A ",
      "encoded_base64": "XidoXiEiXitfXi1qXiZaXig9XissXjllXitlXiZXXiY/XipEXiQlXiEiXidaXjQyXiVKXithXiVfXitpXipEXiQlXiZaXidoXipBIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_3f1b7e980215",
      "text": "並在我的腦袋裡植入了某種記憶封印，好讓我 ",
      "encoded_ascii": "^!+^\"d^$%^&Z^2@^(?^-j^%3^!f^*D^%$^'$^(K^$\"^#5^1%^*A^+i^-}^$% ",
      "encoded_base64": "XiErXiJkXiQlXiZaXjJAXig/Xi1qXiUzXiFmXipEXiUkXickXihLXiQiXiM1XjElXipBXitpXi19XiQlIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_62e4c52f821d",
      "text": "無法向任何人講出我的遭遇。",
      "encoded_ascii": "^%}^%b^+?^!C^!L^!<^6+^!q^$%^&Z^(}^.2^!\"",
      "encoded_base64": "XiV9XiViXis/XiFDXiFMXiE8XjYrXiFxXiQlXiZaXih9Xi4yXiEi",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_d23c7fd21cf7",
      "text": "我不確定自己還能不能再承受那種折磨。如果我再次逃跑並被抓回來， ",
      "encoded_ascii": "^$%^!)^-6^#.^'l^#I^.7^'b^!)^'b^!l^$0^\";^)!^'$^,?^-7^!\"^#$^%!^$%^!l^%D^(p^(_^!+^(@^$2^\"\\^!O^*A ",
      "encoded_base64": "XiQlXiEpXi02XiMuXidsXiNJXi43XidiXiEpXidiXiFsXiQwXiI7XikhXickXiw/Xi03XiEiXiMkXiUhXiQlXiFsXiVEXihwXihfXiErXihAXiQyXiJcXiFPXipBIA==",
      "byte_length": 94
    },
    {
      "unit_id": "DLG_bd5cf932dda9",
      "text": "我一定會被當場處死。但我還是祝你們一切順利、 ",
      "encoded_ascii": "^$%^!%^#.^$r^(@^&N^\"n^(,^%L^!\"^!I^$%^.7^,X^&v^*F^*{^!%^+.^.D^!t^!! ",
      "encoded_base64": "XiQlXiElXiMuXiRyXihAXiZOXiJuXigsXiVMXiEiXiFJXiQlXi43XixYXiZ2XipGXip7XiElXisuXi5EXiF0XiEhIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_a317bae7d9c2",
      "text": "萬事大吉。",
      "encoded_ascii": "^-_^*r^\"z^\"D^!\"",
      "encoded_base64": "Xi1fXipyXiJ6XiJEXiEi",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_14f1ee92b962",
      "text": "保重。",
      "encoded_ascii": "^!T^))^!\"",
      "encoded_base64": "XiFUXikpXiEi",
      "byte_length": 9
    },
    {
      "unit_id": "DLG_c4fb6d857964",
      "text": "給我們上演一場好戲吧——把戰鬥時間拖長一點，才夠 ",
      "encoded_ascii": "^'A^$%^*{^!'^1G^!%^\"n^+i^,;^*I^*n^*n^$1^$(^*,^$f^)G^.f^)C^!%^*;^*A^$,^+d ",
      "encoded_base64": "XidBXiQlXip7XiEnXjFHXiElXiJuXitpXiw7XipJXipuXipuXiQxXiQoXiosXiRmXilHXi5mXilDXiElXio7XipBXiQsXitkIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_1950962bcaf0",
      "text": "精彩。 ",
      "encoded_ascii": "^'7^#`^!\" ",
      "encoded_base64": "Xic3XiNgXiEiIA==",
      "byte_length": 10
    },
    {
      "unit_id": "DLG_7dc7b496c4a0",
      "text": "喲！這一次你們居然活下來了。跟我來。你們該回 ",
      "encoded_ascii": "^>=^*W^(s^!%^%D^*F^*{^+w^&\"^%i^!(^!O^*D^!\"^.+^$%^!O^!\"^*F^*{^(M^\"\\ ",
      "encoded_base64": "Xj49XipXXihzXiElXiVEXipGXip7Xit3XiYiXiVpXiEoXiFPXipEXiEiXi4rXiQlXiFPXiEiXipGXip7XihNXiJcIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_29f28b43a7ad",
      "text": "奴隸欄了。",
      "encoded_ascii": "^##^)Z^%C^*D^!\"",
      "encoded_base64": "XiMjXilaXiVDXipEXiEi",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_053062c754f6",
      "text": "看來你們挺過來了。好吧，回奴隸欄待著，直到下一場戰鬥。",
      "encoded_ascii": "^*Q^!O^*F^*{^,I^(x^!O^*D^!\"^+i^*I^*A^\"\\^##^)Z^%C^,*^-a^*A^&`^!u^!(^!%^\"n^$(^*,^!\"",
      "encoded_base64": "XipRXiFPXipGXip7XixJXih4XiFPXipEXiEiXitpXipJXipBXiJcXiMjXilaXiVDXiwqXi1hXipBXiZgXiF1XiEoXiElXiJuXiQoXiosXiEi",
      "byte_length": 81
    },
    {
      "unit_id": "DLG_9a626ee62682",
      "text": "把你們送回奴隸欄吧。你們顯然需要好好歇息。",
      "encoded_ascii": "^$1^*F^*{^./^\"\\^##^)Z^%C^*I^!\"^*F^*{^4&^&\"^)e^(C^+i^+i^%E^#w^!\"",
      "encoded_base64": "XiQxXipGXip7Xi4vXiJcXiMjXilaXiVDXipJXiEiXipGXip7XjQmXiYiXillXihDXitpXitpXiVFXiN3XiEi",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_b1b7b8de6adc",
      "text": "這裡就是奴隸欄。我是庫爾扎克，守衛們的頭領。 ",
      "encoded_ascii": "^(s^-j^*J^,X^##^)Z^%C^!\"^$%^,X^,#^&/^,=^!d^*A^#+^(=^*{^&Z^)t^)s^!\" ",
      "encoded_base64": "XihzXi1qXipKXixYXiMjXilaXiVDXiEiXiQlXixYXiwjXiYvXiw9XiFkXipBXiMrXig9Xip7XiZaXil0XilzXiEiIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_58ee8c07f6a2",
      "text": "跟我來。我來帶你們去你們的牢房。",
      "encoded_ascii": "^.+^$%^!O^!\"^$%^!O^#N^*F^*{^\"6^*F^*{^&Z^-$^,<^!\"",
      "encoded_base64": "Xi4rXiQlXiFPXiEiXiQlXiFPXiNOXipGXip7XiI2XipGXip7XiZaXi0kXiw8XiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_e0136787ccf3",
      "text": "很好！競技場之戰打得很順利。我把這兒的一切都打點好了。 ",
      "encoded_ascii": "^*K^+i^*W^-?^,>^\"n^!/^$(^$-^#e^*K^.D^!t^!\"^$%^$1^(s^++^&Z^!%^+.^)$^$-^*;^+i^*D^!\" ",
      "encoded_base64": "XipLXitpXipXXi0/Xiw+XiJuXiEvXiQoXiQtXiNlXipLXi5EXiF0XiEiXiQlXiQxXihzXisrXiZaXiElXisuXikkXiQtXio7XitpXipEXiEiIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_fc27bb9ba916",
      "text": "我絕不會再向任何人多提半個字！ ",
      "encoded_ascii": "^$%^-I^!)^$r^!l^+?^!C^!L^!<^\"x^$A^\"-^!V^#)^*W ",
      "encoded_base64": "XiQlXi1JXiEpXiRyXiFsXis/XiFDXiFMXiE8XiJ4XiRBXiItXiFWXiMpXipXIA==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_081df8bcf035",
      "text": "好了，穿過那扇門。沿著東面走廊走有一處歇腳的地方。",
      "encoded_ascii": "^+i^*D^*A^')^(x^)!^$*^)D^!\"^%`^-a^,`^)j^.&^,$^.&^$s^!%^(,^%E^00^&Z^\"e^$]^!\"",
      "encoded_base64": "XitpXipEXipBXicpXih4XikhXiQqXilEXiEiXiVgXi1hXixgXilqXi4mXiwkXi4mXiRzXiElXigsXiVFXjAwXiZaXiJlXiRdXiEi",
      "byte_length": 75
    },
    {
      "unit_id": "DLG_b0a39ca45f97",
      "text": "等到了下一場戰鬥的時間，我會來找你們。如果在此之前你們想提前 ",
      "encoded_ascii": "^'-^!u^*D^!(^!%^\"n^$(^*,^&Z^$f^)G^*A^$%^$r^!O^$/^*F^*{^!\"^#$^%!^\"d^%I^!/^!z^*F^*{^,1^$A^!z ",
      "encoded_base64": "XictXiF1XipEXiEoXiElXiJuXiQoXiosXiZaXiRmXilHXipBXiQlXiRyXiFPXiQvXipGXip7XiEiXiMkXiUhXiJkXiVJXiEvXiF6XipGXip7XiwxXiRBXiF6IA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_6ad1eca9bdaf",
      "text": "出戰，就敲敲那扇門。 ",
      "encoded_ascii": "^!q^$(^*A^*J^1A^1A^)!^$*^)D^!\" ",
      "encoded_base64": "XiFxXiQoXipBXipKXjFBXjFBXikhXiQqXilEXiEiIA==",
      "byte_length": 31
    },
    {
      "unit_id": "DLG_a6e7d40adbad",
      "text": "你們來得真快！很高興看到有角鬥士這麼迫不及待想戰鬥！ ",
      "encoded_ascii": "^*F^*{^!O^#e^-2^*L^*W^*K^*+^-]^*Q^!u^$s^(H^*,^+a^(s^.T^1`^!)^\"7^,*^,1^$(^*,^*W ",
      "encoded_base64": "XipGXip7XiFPXiNlXi0yXipMXipXXipLXiorXi1dXipRXiF1XiRzXihIXiosXithXihzXi5UXjFgXiEpXiI3XiwqXiwxXiQoXiosXipXIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_af45c48f961b",
      "text": "你們來得正好。我本來還以為非得派出 ",
      "encoded_ascii": "^*F^*{^!O^#e^%H^+i^!\"^$%^$x^!O^.7^!B^%{^)i^#e^.n^!q ",
      "encoded_base64": "XipGXip7XiFPXiNlXiVIXitpXiEiXiQlXiR4XiFPXi43XiFCXiV7XilpXiNlXi5uXiFxIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_b16d3df614df",
      "text": "碎腿者不可了呢。 ",
      "encoded_ascii": "^&o^'h^'V^!)^\"A^*D^+C^!\" ",
      "encoded_base64": "XiZvXidoXidWXiEpXiJBXipEXitDXiEiIA==",
      "byte_length": 25
    },
    {
      "unit_id": "DLG_a5e782f05dce",
      "text": "我剛才不得不派碎腿者去抓你們。你們能在被我親自堵到之前主動過來找我， ",
      "encoded_ascii": "^$%^+0^$,^!)^#e^!)^.n^&o^'h^'V^\"6^$2^*F^*{^!\"^*F^*{^'b^\"d^(@^$%^(F^'l^;u^!u^!/^!z^!-^\"%^(x^!O^$/^$%^*A ",
      "encoded_base64": "XiQlXiswXiQsXiEpXiNlXiEpXi5uXiZvXidoXidWXiI2XiQyXipGXip7XiEiXipGXip7XidiXiJkXihAXiQlXihGXidsXjt1XiF1XiEvXiF6XiEtXiIlXih4XiFPXiQvXiQlXipBIA==",
      "byte_length": 103
    },
    {
      "unit_id": "DLG_72ea37e88e02",
      "text": "算你們識相。 ",
      "encoded_ascii": "^-C^*F^*{^(R^&a^!\" ",
      "encoded_base64": "Xi1DXipGXip7XihSXiZhXiEiIA==",
      "byte_length": 19
    },
    {
      "unit_id": "DLG_3130af40a5a5",
      "text": "我很高興你們聽進了碎腿者的話。我最討厭以那種愚蠢的方式折損角鬥士 ",
      "encoded_ascii": "^$%^*K^*+^-]^*F^*{^-X^(w^*D^&o^'h^'V^&Z^-v^!\"^$%^$q^-o^+9^!B^)!^'$^/a^.u^&Z^$]^#X^,?^$D^(H^*,^+a ",
      "encoded_base64": "XiQlXipLXiorXi1dXipGXip7Xi1YXih3XipEXiZvXidoXidWXiZaXi12XiEiXiQlXiRxXi1vXis5XiFCXikhXickXi9hXi51XiZaXiRdXiNYXiw/XiREXihIXiosXithIA==",
      "byte_length": 97
    },
    {
      "unit_id": "DLG_0f9e5cc83fe5",
      "text": "了。 ",
      "encoded_ascii": "^*D^!\" ",
      "encoded_base64": "XipEXiEiIA==",
      "byte_length": 7
    },
    {
      "unit_id": "DLG_ec2b3550ef4e",
      "text": "觀眾都在等著呢！動作快點！",
      "encoded_ascii": "^*R^&e^)$^\"d^'-^-a^+C^*W^\"%^!M^*L^*;^*W",
      "encoded_base64": "XipSXiZlXikkXiJkXictXi1hXitDXipXXiIlXiFNXipMXio7XipX",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_8d877130287d",
      "text": "快點吧，別愣在那裡發呆。 ",
      "encoded_ascii": "^*L^*;^*I^*A^*H^<w^\"d^)!^-j^&W^;)^!\" ",
      "encoded_base64": "XipMXio7XipJXipBXipIXjx3XiJkXikhXi1qXiZXXjspXiEiIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_74a73a4e3cb2",
      "text": "什麼鬼——有人逃獄！ ",
      "encoded_ascii": "^!=^.T^*-^*n^*n^$s^!<^(p^3Q^*W ",
      "encoded_base64": "XiE9Xi5UXiotXipuXipuXiRzXiE8XihwXjNRXipXIA==",
      "byte_length": 31
    },
    {
      "unit_id": "DLG_661edfd21a17",
      "text": "哎呀哈！ ",
      "encoded_ascii": "^3i^3h^+F^*W ",
      "encoded_base64": "XjNpXjNoXitGXipXIA==",
      "byte_length": 13
    },
    {
      "unit_id": "DLG_ba4a1c3d8a15",
      "text": "這麼說，你們準備好再打一場了，是吧？跟我到競技場去吧， ",
      "encoded_ascii": "^(s^.T^-x^*A^*F^*{^,x^+\"^+i^!l^$-^!%^\"n^*D^*A^,X^*I^.V^.+^$%^!u^-?^,>^\"n^\"6^*I^*A ",
      "encoded_base64": "XihzXi5UXi14XipBXipGXip7Xix4XisiXitpXiFsXiQtXiElXiJuXipEXipBXixYXipJXi5WXi4rXiQlXiF1Xi0/Xiw+XiJuXiI2XipJXipBIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_c25b921229da",
      "text": "奴隸。 ",
      "encoded_ascii": "^##^)Z^!\" ",
      "encoded_base64": "XiMjXilaXiEiIA==",
      "byte_length": 10
    },
    {
      "unit_id": "DLG_73da8c55b40c",
      "text": "我最討厭看到優秀的角鬥士白白送命。但那些蠢蛋卻總是讓這種事不斷 ",
      "encoded_ascii": "^$%^$q^-o^+9^*Q^!u^+)^-9^&Z^(H^*,^+a^&X^&X^./^\"N^!\"^!I^)!^!8^.u^6\"^1&^-M^,X^-}^(s^'$^*r^!)^,T ",
      "encoded_base64": "XiQlXiRxXi1vXis5XipRXiF1XispXi05XiZaXihIXiosXithXiZYXiZYXi4vXiJOXiEiXiFJXikhXiE4Xi51XjYiXjEmXi1NXixYXi19XihzXickXipyXiEpXixUIA==",
      "byte_length": 94
    },
    {
      "unit_id": "DLG_90da8de964d2",
      "text": "發生。",
      "encoded_ascii": "^&W^&F^!\"",
      "encoded_base64": "XiZXXiZGXiEi",
      "byte_length": 9
    },
    {
      "unit_id": "DLG_97c1c544d1a0",
      "text": "想怎麼做隨你們便。我也懶得勸阻你們。 ",
      "encoded_ascii": "^,1^,,^.T^*~^)X^*F^*{^!R^!\"^$%^!1^9Y^#e^;?^)L^*F^*{^!\" ",
      "encoded_base64": "XiwxXiwsXi5UXip+XilYXipGXip7XiFSXiEiXiQlXiExXjlZXiNlXjs/XilMXipGXip7XiEiIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_3f81cfcd46c3",
      "text": "你們想要什麼？ ",
      "encoded_ascii": "^*F^*{^,1^(C^!=^.T^.V ",
      "encoded_base64": "XipGXip7XiwxXihDXiE9Xi5UXi5WIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_9758bc1b741f",
      "text": "  幫我逃出去，否則我宰了你！",
      "encoded_ascii": "  ^+}^$%^(p^!q^\"6^*A^\"H^!x^$%^1w^*D^*F^*W",
      "encoded_base64": "ICBeK31eJCVeKHBeIXFeIjZeKkFeIkheIXheJCVeMXdeKkReKkZeKlc=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_d6ea3f054f4d",
      "text": "  跟我說說你的差事。",
      "encoded_ascii": "  ^.+^$%^-x^-x^*F^&Z^48^*r^!\"",
      "encoded_base64": "ICBeLiteJCVeLXheLXheKkZeJlpeNDheKnJeISI=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_71705722fc40",
      "text": "  你的報酬肯定不高吧。",
      "encoded_ascii": "  ^*F^&Z^+`^7o^-Z^#.^!)^*+^*I^!\"",
      "encoded_base64": "ICBeKkZeJlpeK2BeN29eLVpeIy5eISleKiteKkleISI=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_06010fbddf20",
      "text": "  那個半巨人是誰？ ",
      "encoded_ascii": "  ^)!^!V^\"-^#H^!<^,X^-y^.V ",
      "encoded_base64": "ICBeKSFeIVZeIi1eI0heITxeLFheLXleLlYg",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_154be31149b4",
      "text": "  曾有許多奴隸逃脫過嗎？",
      "encoded_ascii": "  ^.j^$s^-s^\"x^##^)Z^(p^'c^(x^+X^.V",
      "encoded_base64": "ICBeLmpeJHNeLXNeInheIyNeKVpeKHBeJ2NeKHheK1heLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_48e563e38616",
      "text": "  各個出口的守衛森嚴嗎？",
      "encoded_ascii": "  ^+>^!V^!q^\"<^&Z^#+^(=^4H^1*^+X^.V",
      "encoded_base64": "ICBeKz5eIVZeIXFeIjxeJlpeIyteKD1eNEheMSpeK1heLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_bff9f525b33d",
      "text": "  去修造金字塔？",
      "encoded_ascii": "  ^\"6^.~^(v^)+^#)^\"o^.V",
      "encoded_base64": "ICBeIjZeLn5eKHZeKSteIyleIm9eLlY=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_e33a952670fa",
      "text": "  建造那座金字塔是為了什麼？",
      "encoded_ascii": "  ^,'^(v^)!^/_^)+^#)^\"o^,X^%{^*D^!=^.T^.V",
      "encoded_base64": "ICBeLCdeKHZeKSFeL19eKSteIyleIm9eLFheJXteKkReIT1eLlReLlY=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_9c0e91fd33ee",
      "text": "  你能幫我弄點水來嗎？ ",
      "encoded_ascii": "  ^*F^'b^+}^$%^/`^*;^%V^!O^+X^.V ",
      "encoded_base64": "ICBeKkZeJ2JeK31eJCVeL2BeKjteJVZeIU9eK1heLlYg",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_cffc30b807bb",
      "text": "這麼說，你和米爾隆是拜把兄弟囉？ ",
      "encoded_ascii": "^(s^.T^-x^*A^*F^\"O^'4^&/^)T^,X^,E^$1^1!^16^3j^.V ",
      "encoded_base64": "XihzXi5UXi14XipBXipGXiJPXic0XiYvXilUXixYXixFXiQxXjEhXjE2XjNqXi5WIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_68d7827a6003",
      "text": "  是啊，我要離開這骯髒的鬼地方了！ ",
      "encoded_ascii": "  ^,X^+Q^*A^$%^(C^)`^)F^(s^0L^0M^&Z^*-^\"e^$]^*D^*W ",
      "encoded_base64": "ICBeLFheK1FeKkFeJCVeKENeKWBeKUZeKHNeMExeME1eJlpeKi1eImVeJF1eKkReKlcg",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_3faf5ae43fce",
      "text": "  不，只是合作夥伴。 ",
      "encoded_ascii": "  ^!)^*A^\"?^,X^\"C^!M^5?^1h^!\" ",
      "encoded_base64": "ICBeISleKkFeIj9eLFheIkNeIU1eNT9eMWheISIg",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_b16f80af0c1d",
      "text": "  我不知道，他值得信任嗎？ ",
      "encoded_ascii": "  ^$%^!)^&h^(y^*A^!@^!Z^#e^!U^!C^+X^.V ",
      "encoded_base64": "ICBeJCVeISleJmheKHleKkFeIUBeIVpeI2VeIVVeIUNeK1heLlYg",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_b03cc225eca8",
      "text": "少管閒事，臭坎克嘴。",
      "encoded_ascii": "^#<^-D^6A^*r^*A^'m^/%^!d^+[^!\"",
      "encoded_base64": "XiM8Xi1EXjZBXipyXipBXidtXi8lXiFkXitbXiEi",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_ca418c1ae522",
      "text": "呵呵。好吧，我希望這份友誼能維持得長久點。 ",
      "encoded_ascii": "^+D^+D^!\"^+i^*I^*A^$%^+{^,]^(s^*x^\"8^=4^'b^'F^$7^#e^)C^!.^*;^!\" ",
      "encoded_base64": "XitEXitEXiEiXitpXipJXipBXiQlXit7XixdXihzXip4XiI4Xj00XidiXidGXiQ3XiNlXilDXiEuXio7XiEiIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_6567947e992b",
      "text": "不足為奇。米爾隆確實是個值得信賴的人。 ",
      "encoded_ascii": "^!)^(^^%{^\"}^!\"^'4^&/^)T^-6^#3^,X^!V^!Z^#e^!U^0t^&Z^!<^!\" ",
      "encoded_base64": "XiEpXiheXiV7XiJ9XiEiXic0XiYvXilUXi02XiMzXixYXiFWXiFaXiNlXiFVXjB0XiZaXiE8XiEiIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_136706e7720b",
      "text": "夥伴關係往往只維持到其中一方得到好處為止。 ",
      "encoded_ascii": "^5?^1h^.>^38^,)^,)^\"?^'F^$7^!u^!j^!,^!%^$]^#e^!u^+i^(,^%{^%G^!\" ",
      "encoded_base64": "XjU/XjFoXi4+XjM4XiwpXiwpXiI/XidGXiQ3XiF1XiFqXiEsXiElXiRdXiNlXiF1XitpXigsXiV7XiVHXiEiIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_395f2f2ce048",
      "text": "我唯一敢託付性命的，只有真正交心的朋友。 ",
      "encoded_ascii": "^$%^+O^!%^/m^-q^*u^#r^\"N^&Z^*A^\"?^$s^-2^%H^0P^#k^&Z^,[^\"8^!\" ",
      "encoded_base64": "XiQlXitPXiElXi9tXi1xXip1XiNyXiJOXiZaXipBXiI/XiRzXi0yXiVIXjBQXiNrXiZaXixbXiI4XiEiIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_ab4694962f72",
      "text": "換作是我絕不信。不過話說回來，我本來就不相信任何人。 ",
      "encoded_ascii": "^4@^!M^,X^$%^-I^!)^!U^!\"^!)^(x^-v^-x^\"\\^!O^*A^$%^$x^!O^*J^!)^&a^!U^!C^!L^!<^!\" ",
      "encoded_base64": "XjRAXiFNXixYXiQlXi1JXiEpXiFVXiEiXiEpXih4Xi12Xi14XiJcXiFPXipBXiQlXiR4XiFPXipKXiEpXiZhXiFVXiFDXiFMXiE8XiEiIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_c1234709c6b2",
      "text": "庫爾扎克迅速朝米爾隆瞥了一眼。 ",
      "encoded_ascii": "^,#^&/^,=^!d^(j^(u^,^^'4^&/^)T^:`^*D^!%^&d^!\" ",
      "encoded_base64": "XiwjXiYvXiw9XiFkXihqXih1XixeXic0XiYvXilUXjpgXipEXiElXiZkXiEiIA==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_8a38e6e4545d",
      "text": "當然可以。他就宛如手足兄弟。 ",
      "encoded_ascii": "^&N^&\"^\"A^!B^!\"^!@^*J^1v^#$^$+^(^^1!^16^!\" ",
      "encoded_base64": "XiZOXiYiXiJBXiFCXiEiXiFAXipKXjF2XiMkXiQrXiheXjEhXjE2XiEiIA==",
      "byte_length": 43
    },
    {
      "unit_id": "DLG_d87c8b3c0150",
      "text": "怎麼，跟米爾隆搭上了線，就覺得自己身價高貴不屑跟我們說話了？ ",
      "encoded_ascii": "^,,^.T^*A^.+^'4^&/^)T^8\\^!'^*D^'I^*A^*J^(G^#e^'l^#I^(c^+&^*+^2F^!)^:x^.+^$%^*{^-x^-v^*D^.V ",
      "encoded_base64": "XiwsXi5UXipBXi4rXic0XiYvXilUXjhcXiEnXipEXidJXipBXipKXihHXiNlXidsXiNJXihjXismXiorXjJGXiEpXjp4Xi4rXiQlXip7Xi14Xi12XipEXi5WIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_d2a0e5021962",
      "text": "我懂你們的意思了。 ",
      "encoded_ascii": "^$%^,6^*F^*{^&Z^#z^#q^*D^!\" ",
      "encoded_base64": "XiQlXiw2XipGXip7XiZaXiN6XiNxXipEXiEiIA==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_b0fd331c04f9",
      "text": "噢，那是訓獸師。他的名字叫碎腿者。 ",
      "encoded_ascii": "^+]^*A^)!^,X^-p^&<^#M^!\"^!@^&Z^\"F^#)^+<^&o^'h^'V^!\" ",
      "encoded_base64": "XitdXipBXikhXixYXi1wXiY8XiNNXiEiXiFAXiZaXiJGXiMpXis8XiZvXidoXidWXiEiIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_0a624852471d",
      "text": "他腦子不太靈光，但調教起怪物來倒是很有一手。 ",
      "encoded_ascii": "^!@^2@^#(^!)^+f^)g^!c^*A^!I^(Q^,R^.(^#s^&4^!O^!X^,X^*K^$s^!%^$+^!\" ",
      "encoded_base64": "XiFAXjJAXiMoXiEpXitmXilnXiFjXipBXiFJXihRXixSXi4oXiNzXiY0XiFPXiFYXixYXipLXiRzXiElXiQrXiEiIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_d20edad24234",
      "text": "只管往前走。你們的命是用在競技場上搏殺的， ",
      "encoded_ascii": "^\"?^-D^,)^!z^.&^!\"^*F^*{^&Z^\"N^,X^&H^\"d^-?^,>^\"n^!'^,K^%M^&Z^*A ",
      "encoded_base64": "XiI/Xi1EXiwpXiF6Xi4mXiEiXipGXip7XiZaXiJOXixYXiZIXiJkXi0/Xiw+XiJuXiEnXixLXiVNXiZaXipBIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_c7ce769a32f9",
      "text": "不是用來在牢欄裡跟守衛糾纏的。 ",
      "encoded_ascii": "^!)^,X^&H^!O^\"d^-$^%C^-j^.+^#+^(=^3U^'N^&Z^!\" ",
      "encoded_base64": "XiEpXixYXiZIXiFPXiJkXi0kXiVDXi1qXi4rXiMrXig9XjNVXidOXiZaXiEiIA==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_11de31a3d026",
      "text": "  道歉，否則就去死！",
      "encoded_ascii": "  ^(y^,h^*A^\"H^!x^*J^\"6^%L^*W",
      "encoded_base64": "ICBeKHleLGheKkFeIkheIXheKkpeIjZeJUxeKlc=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_b05051fbd771",
      "text": "  遵命，長官！",
      "encoded_ascii": "  ^4#^\"N^*A^)C^#-^*W",
      "encoded_base64": "ICBeNCNeIk5eKkFeKUNeIy1eKlc=",
      "byte_length": 20
    },
    {
      "unit_id": "DLG_e02da998bfbb",
      "text": "  抱歉。我沒有別的意思。",
      "encoded_ascii": "  ^,@^,h^!\"^$%^%\\^$s^*H^&Z^#z^#q^!\"",
      "encoded_base64": "ICBeLEBeLGheISJeJCVeJVxeJHNeKkheJlpeI3peI3FeISI=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_f136a0ab4925",
      "text": "  給點小錢能把這事擺平嗎？",
      "encoded_ascii": "  ^'A^*;^#;^.<^'b^$1^(s^*r^1@^0Y^+X^.V",
      "encoded_base64": "ICBeJ0FeKjteIzteLjxeJ2JeJDFeKHNeKnJeMUBeMFleK1heLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_dbf91a80d09b",
      "text": "抱歉。請繼續帶路吧。",
      "encoded_ascii": "^,@^,h^!\"^*S^-O^'M^#N^(a^*I^!\"",
      "encoded_base64": "XixAXixoXiEiXipTXi1PXidNXiNOXihhXipJXiEi",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_a60df518540e",
      "text": "你想現在就被串成肉串嗎？",
      "encoded_ascii": "^*F^,1^&?^\"d^*J^(@^><^$$^'^^><^+X^.V",
      "encoded_base64": "XipGXiwxXiY/XiJkXipKXihAXj48XiQkXideXj48XitYXi5W",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_ef8fe4de7388",
      "text": "那就說話客氣點。",
      "encoded_ascii": "^)!^*J^-x^-v^+q^%U^*;^!\"",
      "encoded_base64": "XikhXipKXi14Xi12XitxXiVVXio7XiEi",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_f9ebf0136537",
      "text": "很好。保持應有的敬意。 ",
      "encoded_ascii": "^*K^+i^!\"^!T^$7^0`^$s^&Z^*O^#z^!\" ",
      "encoded_base64": "XipLXitpXiEiXiFUXiQ3XjBgXiRzXiZaXipPXiN6XiEiIA==",
      "byte_length": 34
    },
    {
      "unit_id": "DLG_095e3e81c2b5",
      "text": "我總算明白像你這種人渣為什麼會被扔進競技場了。動起來！",
      "encoded_ascii": "^$%^-M^-C^$c^&X^!`^*F^(s^'$^!<^,v^%{^!=^.T^$r^(@^8{^(w^-?^,>^\"n^*D^!\"^\"%^.(^!O^*W",
      "encoded_base64": "XiQlXi1NXi1DXiRjXiZYXiFgXipGXihzXickXiE8Xix2XiV7XiE9Xi5UXiRyXihAXjh7Xih3Xi0/Xiw+XiJuXipEXiEiXiIlXi4oXiFPXipX",
      "byte_length": 81
    },
    {
      "unit_id": "DLG_1b32d86af74d",
      "text": "當守衛的差事挺例行的。我把他們押去競技場。有時 ",
      "encoded_ascii": "^&N^#+^(=^&Z^48^*r^,I^9h^(;^&Z^!\"^$%^$1^!@^*{^7Z^\"6^-?^,>^\"n^!\"^$s^$f ",
      "encoded_base64": "XiZOXiMrXig9XiZaXjQ4XipyXixJXjloXig7XiZaXiEiXiQlXiQxXiFAXip7XjdaXiI2Xi0/Xiw+XiJuXiEiXiRzXiRmIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_3cb6d7cdc6ac",
      "text": "再把活下來的帶回牢房。這總比去修造金字塔強多了。",
      "encoded_ascii": "^!l^$1^%i^!(^!O^&Z^#N^\"\\^-$^,<^!\"^(s^-M^,m^\"6^.~^(v^)+^#)^\"o^#]^\"x^*D^!\"",
      "encoded_base64": "XiFsXiQxXiVpXiEoXiFPXiZaXiNOXiJcXi0kXiw8XiEiXihzXi1NXixtXiI2Xi5+Xih2XikrXiMpXiJvXiNdXiJ4XipEXiEi",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_c5ec0caebf11",
      "text": "我對這份工作的熱愛就是我最好的報酬。",
      "encoded_ascii": "^$%^#:^(s^*x^+y^!M^&Z^&$^,2^*J^,X^$%^$q^+i^&Z^+`^7o^!\"",
      "encoded_base64": "XiQlXiM6XihzXip4Xit5XiFNXiZaXiYkXiwyXipKXixYXiQlXiRxXitpXiZaXitgXjdvXiEi",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_506f1a7a7fcb",
      "text": "  你熱愛你的工作？",
      "encoded_ascii": "  ^*F^&$^,2^*F^&Z^+y^!M^.V",
      "encoded_base64": "ICBeKkZeJiReLDJeKkZeJlpeK3leIU1eLlY=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_7a30d786e89c",
      "text": "  那我只好宰了你。",
      "encoded_ascii": "  ^)!^$%^\"?^+i^1w^*D^*F^!\"",
      "encoded_base64": "ICBeKSFeJCVeIj9eK2leMXdeKkReKkZeISI=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_3fef0a6d1cb6",
      "text": "  如此敬業值得一份犒賞。",
      "encoded_ascii": "  ^#$^%I^*O^%5^!Z^#e^!%^*x^>>^*T^!\"",
      "encoded_base64": "ICBeIyReJUleKk9eJTVeIVpeI2VeISVeKnhePj5eKlReISI=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_941f4a759daf",
      "text": "  你到底要不要收買路錢？",
      "encoded_ascii": "  ^*F^!u^/^^(C^!)^(C^$M^.!^(a^.<^.V",
      "encoded_base64": "ICBeKkZeIXVeL15eKENeISleKENeJE1eLiFeKGFeLjxeLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_1beda87696d5",
      "text": "是啊，我很喜歡看你們在競技場裡搏殺。這日子不算最糟。 ",
      "encoded_ascii": "^,X^+Q^*A^$%^*K^+V^%F^*Q^*F^*{^\"d^-?^,>^\"n^-j^,K^%M^!\"^(s^$a^#(^!)^-C^$q^-E^!\" ",
      "encoded_base64": "XixYXitRXipBXiQlXipLXitWXiVGXipRXipGXip7XiJkXi0/Xiw+XiJuXi1qXixLXiVNXiEiXihzXiRhXiMoXiEpXi1DXiRxXi1FXiEiIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_48091073808e",
      "text": " 現在快走！",
      "encoded_ascii": " ^&?^\"d^*L^.&^*W",
      "encoded_base64": "IF4mP14iZF4qTF4uJl4qVw==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_269bc8e00fb1",
      "text": "沒錯，我想有 ",
      "encoded_ascii": "^%\\^)5^*A^$%^,1^$s ",
      "encoded_base64": "XiVcXik1XipBXiQlXiwxXiRzIA==",
      "byte_length": 19
    },
    {
      "unit_id": "DLG_0d2a9af9b211",
      "text": " 枚陶幣總是令人歡迎的。",
      "encoded_ascii": " ^$~^)R^+|^-M^,X^*w^!<^%F^(k^&Z^!\"",
      "encoded_base64": "IF4kfl4pUl4rfF4tTV4sWF4qd14hPF4lRl4oa14mWl4hIg==",
      "byte_length": 34
    },
    {
      "unit_id": "DLG_6e26c9b8d3df",
      "text": "要把錢給他嗎？",
      "encoded_ascii": "^(C^$1^.<^'A^!@^+X^.V",
      "encoded_base64": "XihDXiQxXi48XidBXiFAXitYXi5W",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_1ff6b5e3612a",
      "text": "謝了。這筆錢派得上用場。 ",
      "encoded_ascii": "^-z^*D^!\"^(s^-A^.<^.n^#e^!'^&H^\"n^!\" ",
      "encoded_base64": "Xi16XipEXiEiXihzXi1BXi48Xi5uXiNlXiEnXiZIXiJuXiEiIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_179c178693d6",
      "text": "那就快走吧，可憐蟲們！我還有正經事要辦，沒閒工夫聽你們 ",
      "encoded_ascii": "^)!^*J^*L^.&^*I^*A^\"A^1}^(8^*{^*W^$%^.7^$s^%H^'D^*r^(C^2L^*A^%\\^6A^+y^\"{^-X^*F^*{ ",
      "encoded_base64": "XikhXipKXipMXi4mXipJXipBXiJBXjF9Xig4Xip7XipXXiQlXi43XiRzXiVIXidEXipyXihDXjJMXipBXiVcXjZBXit5XiJ7Xi1YXipGXip7IA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_50eba8441df4",
      "text": "在這胡扯。",
      "encoded_ascii": "^\"d^(s^3}^.e^!\"",
      "encoded_base64": "XiJkXihzXjN9Xi5lXiEi",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_419f3f3a7d4f",
      "text": "我希望你們戰鬥的本事比你們談判的口才好；就算我放你們 ",
      "encoded_ascii": "^$%^+{^,]^*F^*{^$(^*,^&Z^$x^*r^,m^*F^*{^0;^1k^&Z^\"<^$,^+i^*C^*J^-C^$%^$P^*F^*{ ",
      "encoded_base64": "XiQlXit7XixdXipGXip7XiQoXiosXiZaXiR4XipyXixtXipGXip7XjA7XjFrXiZaXiI8XiQsXitpXipDXipKXi1DXiQlXiRQXipGXip7IA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_e50dd261e9e1",
      "text": "走，你們大概也很快就會被抓回來。交出 ",
      "encoded_ascii": "^.&^*A^*F^*{^\"z^,d^!1^*K^*L^*J^$r^(@^$2^\"\\^!O^!\"^0P^!q ",
      "encoded_base64": "Xi4mXipBXipGXip7XiJ6XixkXiExXipLXipMXipKXiRyXihAXiQyXiJcXiFPXiEiXjBQXiFxIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_923171b6be3b",
      "text": " 枚陶幣，我們就能成為朋友。",
      "encoded_ascii": " ^$~^)R^+|^*A^$%^*{^*J^'b^$$^%{^,[^\"8^!\"",
      "encoded_base64": "IF4kfl4pUl4rfF4qQV4kJV4qe14qSl4nYl4kJF4le14sW14iOF4hIg==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_549c41b3f87b",
      "text": "你們活不了多久的。",
      "encoded_ascii": "^*F^*{^%i^!)^*D^\"x^!.^&Z^!\"",
      "encoded_base64": "XipGXip7XiVpXiEpXipEXiJ4XiEuXiZaXiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_4755a257f398",
      "text": "確實有幾個人溜出去了， ",
      "encoded_ascii": "^-6^#3^$s^#T^!V^!<^%r^!q^\"6^*D^*A ",
      "encoded_base64": "Xi02XiMzXiRzXiNUXiFWXiE8XiVyXiFxXiI2XipEXipBIA==",
      "byte_length": 34
    },
    {
      "unit_id": "DLG_7f501256910d",
      "text": "但我們的追蹤者把他們大多數都抓了回來—— ",
      "encoded_ascii": "^!I^$%^*{^&Z^(o^(b^'V^$1^!@^*{^\"z^\"x^$V^)$^$2^*D^\"\\^!O^*n^*n ",
      "encoded_base64": "XiFJXiQlXip7XiZaXihvXihiXidWXiQxXiFAXip7XiJ6XiJ4XiRWXikkXiQyXipEXiJcXiFPXipuXipuIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_b4f870237c75",
      "text": "不然就是在荒漠裡找到他們的屍體。",
      "encoded_ascii": "^!)^&\"^*J^,X^\"d^1W^,}^-j^$/^!u^!@^*{^&Z^#?^**^!\"",
      "encoded_base64": "XiEpXiYiXipKXixYXiJkXjFXXix9Xi1qXiQvXiF1XiFAXip7XiZaXiM/XioqXiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_3b50c0fe0255",
      "text": "沒有人逃得掉！乖乖排好隊，否則後果自負！",
      "encoded_ascii": "^%\\^$s^!<^(p^#e^/e^*W^0{^0{^$<^+i^)U^*A^\"H^!x^#b^%!^'l^(W^*W",
      "encoded_base64": "XiVcXiRzXiE8XihwXiNlXi9lXipXXjB7XjB7XiQ8XitpXilVXipBXiJIXiF4XiNiXiUhXidsXihXXipX",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_d44798afadbe",
      "text": "有些逃奴找到了一條秘密通路。我們很快就會找到並把它給堵死。 ",
      "encoded_ascii": "^$s^!8^(p^##^$/^!u^*D^!%^%.^1O^#0^(t^(a^!\"^$%^*{^*K^*L^*J^$r^$/^!u^!+^$1^+o^'A^;u^%L^!\" ",
      "encoded_base64": "XiRzXiE4XihwXiMjXiQvXiF1XipEXiElXiUuXjFPXiMwXih0XihhXiEiXiQlXip7XipLXipMXipKXiRyXiQvXiF1XiErXiQxXitvXidBXjt1XiVMXiEiIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_a2f73cc81677",
      "text": "一旦拉響警報，所有大門都會徹底封閉。哪怕是一支軍隊 ",
      "encoded_ascii": "^!%^1C^$6^)o^(S^+`^*A^$)^$s^\"z^)D^)$^$r^18^/^^#5^.=^!\"^+I^0^^,X^!%^$L^..^)U ",
      "encoded_base64": "XiElXjFDXiQ2XilvXihTXitgXipBXiQpXiRzXiJ6XilEXikkXiRyXjE4Xi9eXiM1Xi49XiEiXitJXjBeXixYXiElXiRMXi4uXilVIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_eecfac9d3c8b",
      "text": "也休想撼動分毫。",
      "encoded_ascii": "^!1^!G^,1^:i^\"%^!s^/t^!\"",
      "encoded_base64": "XiExXiFHXiwxXjppXiIlXiFzXi90XiEi",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_2af38874773a",
      "text": "你們唯一能見到的出口，就是殺死你們的那隻怪獸。",
      "encoded_ascii": "^*F^*{^+O^!%^'b^-m^!u^&Z^!q^\"<^*A^*J^,X^%M^%L^*F^*{^&Z^)!^)[^#s^&<^!\"",
      "encoded_base64": "XipGXip7XitPXiElXidiXi1tXiF1XiZaXiFxXiI8XipBXipKXixYXiVNXiVMXipGXip7XiZaXikhXilbXiNzXiY8XiEi",
      "byte_length": 69
    },
    {
      "unit_id": "DLG_838c8f530f9e",
      "text": "沒錯。大多數人都是被派去那裡幹活的。",
      "encoded_ascii": "^%\\^)5^!\"^\"z^\"x^$V^!<^)$^,X^(@^.n^\"6^)!^-j^,!^%i^&Z^!\"",
      "encoded_base64": "XiVcXik1XiEiXiJ6XiJ4XiRWXiE8XikkXixYXihAXi5uXiI2XikhXi1qXiwhXiVpXiZaXiEi",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_d6cf18068a7a",
      "text": "那座金字塔是為巫王修造的。自從他失蹤之後，所有工程進度都 ",
      "encoded_ascii": "^)!^/_^)+^#)^\"o^,X^%{^14^-)^.~^(v^&Z^!\"^'l^#f^!@^\"|^(b^!/^#b^*A^$)^$s^+y^'#^(w^#V^)$ ",
      "encoded_base64": "XikhXi9fXikrXiMpXiJvXixYXiV7XjE0Xi0pXi5+Xih2XiZaXiEiXidsXiNmXiFAXiJ8XihiXiEvXiNiXipBXiQpXiRzXit5XicjXih3XiNWXikkIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_87a8c7e95285",
      "text": "放緩了下來。",
      "encoded_ascii": "^$P^'J^*D^!(^!O^!\"",
      "encoded_base64": "XiRQXidKXipEXiEoXiFPXiEi",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_70d73ce6fe5f",
      "text": "但你們有權知道的也就只有這麼多了。",
      "encoded_ascii": "^!I^*F^*{^$s^1E^&h^(y^&Z^!1^*J^\"?^$s^(s^.T^\"x^*D^!\"",
      "encoded_base64": "XiFJXipGXip7XiRzXjFFXiZoXih5XiZaXiExXipKXiI/XiRzXihzXi5UXiJ4XipEXiEi",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_1af1adb80119",
      "text": "我又不是你們打雜送水的奴僕！不過，如果你們有 40 枚陶幣的話，我倒可以賣給你們一個 ",
      "encoded_ascii": "^$%^+;^!)^,X^*F^*{^$-^0G^./^%V^&Z^##^+%^*W^!)^(x^*A^#$^%!^*F^*{^$s 40 ^$~^)R^+|^&Z^-v^*A^$%^!X^\"A^!B^.$^'A^*F^*{^!%^!V ",
      "encoded_base64": "XiQlXis7XiEpXixYXipGXip7XiQtXjBHXi4vXiVWXiZaXiMjXislXipXXiEpXih4XipBXiMkXiUhXipGXip7XiRzIDQwIF4kfl4pUl4rfF4mWl4tdl4qQV4kJV4hWF4iQV4hQl4uJF4nQV4qRl4qe14hJV4hViA=",
      "byte_length": 119
    },
    {
      "unit_id": "DLG_97481893879a",
      "text": "空水罐。 ",
      "encoded_ascii": "^'(^%V^'O^!\" ",
      "encoded_base64": "XicoXiVWXidPXiEiIA==",
      "byte_length": 13
    },
    {
      "unit_id": "DLG_553cb431d415",
      "text": "  我買了。 ",
      "encoded_ascii": "  ^$%^.!^*D^!\" ",
      "encoded_base64": "ICBeJCVeLiFeKkReISIg",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_298da34faf88",
      "text": "  我出 20 枚陶幣跟你買。 ",
      "encoded_ascii": "  ^$%^!q 20 ^$~^)R^+|^.+^*F^.!^!\" ",
      "encoded_base64": "ICBeJCVeIXEgMjAgXiR+XilSXit8Xi4rXipGXi4hXiEiIA==",
      "byte_length": 34
    },
    {
      "unit_id": "DLG_85ebb4e36582",
      "text": "  我沒興趣。",
      "encoded_ascii": "  ^$%^%\\^-]^.*^!\"",
      "encoded_base64": "ICBeJCVeJVxeLV1eLipeISI=",
      "byte_length": 17
    },
    {
      "unit_id": "DLG_751dcf685e1c",
      "text": "太棒了。 ",
      "encoded_ascii": "^+f^%1^*D^!\" ",
      "encoded_base64": "XitmXiUxXipEXiEiIA==",
      "byte_length": 13
    },
    {
      "unit_id": "DLG_4f947b8135c5",
      "text": "要把錢給他嗎？ ",
      "encoded_ascii": "^(C^$1^.<^'A^!@^+X^.V ",
      "encoded_base64": "XihDXiQxXi48XidBXiFAXitYXi5WIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_be921a64b729",
      "text": "多謝這筆陶幣了。 ",
      "encoded_ascii": "^\"x^-z^(s^-A^)R^+|^*D^!\" ",
      "encoded_base64": "XiJ4Xi16XihzXi1BXilSXit8XipEXiEiIA==",
      "byte_length": 25
    },
    {
      "unit_id": "DLG_b6550b209af8",
      "text": "嘿！你身上根本沒有那麼多錢！ ",
      "encoded_ascii": "^+\\^*W^*F^(c^!'^%)^$x^%\\^$s^)!^.T^\"x^.<^*W ",
      "encoded_base64": "XitcXipXXipGXihjXiEnXiUpXiR4XiVcXiRzXikhXi5UXiJ4Xi48XipXIA==",
      "byte_length": 43
    },
    {
      "unit_id": "DLG_90d061942709",
      "text": "二十枚陶幣就二十枚吧！你可真會殺價。 ",
      "encoded_ascii": "^!5^*Y^$~^)R^+|^*J^!5^*Y^$~^*I^*W^*F^\"A^-2^$r^%M^+&^!\" ",
      "encoded_base64": "XiE1XipZXiR+XilSXit8XipKXiE1XipZXiR+XipJXipXXipGXiJBXi0yXiRyXiVNXismXiEiIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_c8b9b7536937",
      "text": "看來你並不是那麼急需這個水罐嘛。 ",
      "encoded_ascii": "^*Q^!O^*F^!+^!)^,X^)!^.T^3p^)e^(s^!V^%V^'O^+Y^!\" ",
      "encoded_base64": "XipRXiFPXipGXiErXiEpXixYXikhXi5UXjNwXillXihzXiFWXiVWXidPXitZXiEiIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_1d55c7dfe6fd",
      "text": "好吧。隨你的便。 ",
      "encoded_ascii": "^+i^*I^!\"^)X^*F^&Z^!R^!\" ",
      "encoded_base64": "XitpXipJXiEiXilYXipGXiZaXiFSXiEiIA==",
      "byte_length": 25
    },
    {
      "unit_id": "DLG_3e0f848064d1",
      "text": "快走吧！我得回去幹活了。",
      "encoded_ascii": "^*L^.&^*I^*W^$%^#e^\"\\^\"6^,!^%i^*D^!\"",
      "encoded_base64": "XipMXi4mXipJXipXXiQlXiNlXiJcXiI2XiwhXiVpXipEXiEi",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_c9fa5a467e03",
      "text": "你這次可惹錯敵人了！ ",
      "encoded_ascii": "^*F^(s^%D^\"A^3s^)5^$U^!<^*D^*W ",
      "encoded_base64": "XipGXihzXiVEXiJBXjNzXik1XiRVXiE8XipEXipXIA==",
      "byte_length": 31
    },
    {
      "unit_id": "DLG_857584998b6f",
      "text": "怎麼，你又回來討打了？ ",
      "encoded_ascii": "^,,^.T^*A^*F^+;^\"\\^!O^-o^$-^*D^.V ",
      "encoded_base64": "XiwsXi5UXipBXipGXis7XiJcXiFPXi1vXiQtXipEXi5WIA==",
      "byte_length": 34
    },
    {
      "unit_id": "DLG_4da0520b3721",
      "text": "周圍守衛太多不能說話。所有人都在搜捕你們。 ",
      "encoded_ascii": "^\"L^\"`^#+^(=^+f^\"x^!)^'b^-x^-v^!\"^$)^$s^!<^)$^\"d^/h^4?^*F^*{^!\" ",
      "encoded_base64": "XiJMXiJgXiMrXig9XitmXiJ4XiEpXidiXi14Xi12XiEiXiQpXiRzXiE8XikkXiJkXi9oXjQ/XipGXip7XiEiIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_3cfb43b78a43",
      "text": "去競技場戰鬥吧。 ",
      "encoded_ascii": "^\"6^-?^,>^\"n^$(^*,^*I^!\" ",
      "encoded_base64": "XiI2Xi0/Xiw+XiJuXiQoXiosXipJXiEiIA==",
      "byte_length": 25
    },
    {
      "unit_id": "DLG_c1fa16b5920b",
      "text": "你們最好快點離開這裡！警報響了！",
      "encoded_ascii": "^*F^*{^$q^+i^*L^*;^)`^)F^(s^-j^*W^(S^+`^)o^*D^*W",
      "encoded_base64": "XipGXip7XiRxXitpXipMXio7XilgXilGXihzXi1qXipXXihTXitgXilvXipEXipX",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_47685236dcc2",
      "text": "警報響了！你們最好快逃！",
      "encoded_ascii": "^(S^+`^)o^*D^*W^*F^*{^$q^+i^*L^(p^*W",
      "encoded_base64": "XihTXitgXilvXipEXipXXipGXip7XiRxXitpXipMXihwXipX",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_b67616481c03",
      "text": "去跟疤面和他的手下談談吧——也許他們正好需要一些 ",
      "encoded_ascii": "^\"6^.+^5g^)j^\"O^!@^&Z^$+^!(^0;^0;^*I^*n^*n^!1^-s^!@^*{^%H^+i^)e^(C^!%^!8 ",
      "encoded_base64": "XiI2Xi4rXjVnXilqXiJPXiFAXiZaXiQrXiEoXjA7XjA7XipJXipuXipuXiExXi1zXiFAXip7XiVIXitpXillXihDXiElXiE4IA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_c9bb6179bf14",
      "text": "菜鳥新兵。哈！ ",
      "encoded_ascii": "^>?^4p^$\\^+,^!\"^+F^*W ",
      "encoded_base64": "Xj4/XjRwXiRcXissXiEiXitGXipXIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_cb32eff00b7a",
      "text": "等你在競技場裡證明了自己，我們再來談。 ",
      "encoded_ascii": "^'-^*F^\"d^-?^,>^\"n^-j^-{^$c^*D^'l^#I^*A^$%^*{^!l^!O^0;^!\" ",
      "encoded_base64": "XictXipGXiJkXi0/Xiw+XiJuXi1qXi17XiRjXipEXidsXiNJXipBXiQlXip7XiFsXiFPXjA7XiEiIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_4d21664235d8",
      "text": "如果你能在下一場戰鬥中活下來，或許還算有點 ",
      "encoded_ascii": "^#$^%!^*F^'b^\"d^!(^!%^\"n^$(^*,^!,^%i^!(^!O^*A^$'^-s^.7^-C^$s^*; ",
      "encoded_base64": "XiMkXiUhXipGXidiXiJkXiEoXiElXiJuXiQoXiosXiEsXiVpXiEoXiFPXipBXiQnXi1zXi43Xi1DXiRzXio7IA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_39db9647b6ec",
      "text": "價值。",
      "encoded_ascii": "^+&^!Z^!\"",
      "encoded_base64": "XismXiFaXiEi",
      "byte_length": 9
    },
    {
      "unit_id": "DLG_ee20210e4d17",
      "text": "我們得想辦法逃出去！ ",
      "encoded_ascii": "^$%^*{^#e^,1^2L^%b^(p^!q^\"6^*W ",
      "encoded_base64": "XiQlXip7XiNlXiwxXjJMXiViXihwXiFxXiI2XipXIA==",
      "byte_length": 31
    },
    {
      "unit_id": "DLG_4f6588de71f1",
      "text": "你們打算什麼時候越獄？算我們一份！ ",
      "encoded_ascii": "^*F^*{^$-^-C^!=^.T^$f^*|^(]^3Q^.V^-C^$%^*{^!%^*x^*W ",
      "encoded_base64": "XipGXip7XiQtXi1DXiE9Xi5UXiRmXip8XihdXjNRXi5WXi1DXiQlXip7XiElXip4XipXIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_8766b614b9fa",
      "text": " 還有就像我說的……那乾草堆裡裝了什麼，根本不關你的事！ ",
      "encoded_ascii": " ^.7^$s^*J^!`^$%^-x^&Z^*o^*o^)!^*X^*f^*[^-j^(A^*D^!=^.T^*A^%)^$x^!)^.>^*F^&Z^*r^*W ",
      "encoded_base64": "IF4uN14kc14qSl4hYF4kJV4teF4mWl4qb14qb14pIV4qWF4qZl4qW14tal4oQV4qRF4hPV4uVF4qQV4lKV4keF4hKV4uPl4qRl4mWl4qcl4qVyA=",
      "byte_length": 83
    },
    {
      "unit_id": "DLG_1374a03ce71e",
      "text": "  聽著，史拉蟾餌！這裡由我說了算。 ",
      "encoded_ascii": "  ^-X^-a^*A^1m^$6^>@^.J^*W^(s^-j^&I^$%^-x^*D^-C^!\" ",
      "encoded_base64": "ICBeLVheLWFeKkFeMW1eJDZePkBeLkpeKldeKHNeLWpeJkleJCVeLXheKkReLUNeISIg",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_8118b5ad68db",
      "text": "  閉嘴，你這愚蠢的乞丐雜種！ ",
      "encoded_ascii": "  ^.=^+[^*A^*F^(s^/a^.u^&Z^4+^4*^0G^'$^*W ",
      "encoded_base64": "ICBeLj1eK1teKkFeKkZeKHNeL2FeLnVeJlpeNCteNCpeMEdeJyReKlcg",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_6c36f5017e82",
      "text": "  我要怎麼離開這裡？",
      "encoded_ascii": "  ^$%^(C^,,^.T^)`^)F^(s^-j^.V",
      "encoded_base64": "ICBeJCVeKENeLCxeLlReKWBeKUZeKHNeLWpeLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_8115e5b97b64",
      "text": "  我聽見你們在談論越獄的事。",
      "encoded_ascii": "  ^$%^-X^-m^*F^*{^\"d^0;^1\\^(]^3Q^&Z^*r^!\"",
      "encoded_base64": "ICBeJCVeLVheLW1eKkZeKnteImReMDteMVxeKF1eM1FeJlpeKnJeISI=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_721c056bdd91",
      "text": "  你在乾草堆裡藏了什麼？",
      "encoded_ascii": "  ^*F^\"d^*X^*f^*[^-j^-f^*D^!=^.T^.V",
      "encoded_base64": "ICBeKkZeImReKlheKmZeKlteLWpeLWZeKkReIT1eLlReLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_670af3f8522a",
      "text": "我稍後再來。 ",
      "encoded_ascii": "^$%^-:^#b^!l^!O^!\" ",
      "encoded_base64": "XiQlXi06XiNiXiFsXiFPXiEiIA==",
      "byte_length": 19
    },
    {
      "unit_id": "DLG_898b8af37ab5",
      "text": "我？乞丐雜種？要真是那樣我還算走運了！ ",
      "encoded_ascii": "^$%^.V^4+^4*^0G^'$^.V^(C^-2^,X^)!^,f^$%^.7^-C^.&^.4^*D^*W ",
      "encoded_base64": "XiQlXi5WXjQrXjQqXjBHXickXi5WXihDXi0yXixYXikhXixmXiQlXi43Xi1DXi4mXi40XipEXipXIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_7119ed84c84b",
      "text": "我看你最好去找個在乎你想法的人說話吧。 ",
      "encoded_ascii": "^$%^*Q^*F^$q^+i^\"6^$/^!V^\"d^!0^*F^,1^%b^&Z^!<^-x^-v^*I^!\" ",
      "encoded_base64": "XiQlXipRXipGXiRxXitpXiI2XiQvXiFWXiJkXiEwXipGXiwxXiViXiZaXiE8Xi14Xi12XipJXiEiIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_8407d776f624",
      "text": "這麼說，你聽說了我們的越獄計畫？我跟你說好了—— ",
      "encoded_ascii": "^(s^.T^-x^*A^*F^-X^-x^*D^$%^*{^&Z^(]^3Q^-n^-,^.V^$%^.+^*F^-x^+i^*D^*n^*n ",
      "encoded_base64": "XihzXi5UXi14XipBXipGXi1YXi14XipEXiQlXip7XiZaXihdXjNRXi1uXi0sXi5WXiQlXi4rXipGXi14XitpXipEXipuXipuIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_fe5f9bf3e6ba",
      "text": "我幫派裡的每個人都進過競技場三次。你只要在競技場裡 ",
      "encoded_ascii": "^$%^+}^.n^-j^&Z^%P^!V^!<^)$^(w^(x^-?^,>^\"n^!&^%D^!\"^*F^\"?^(C^\"d^-?^,>^\"n^-j ",
      "encoded_base64": "XiQlXit9Xi5uXi1qXiZaXiVQXiFWXiE8XikkXih3Xih4Xi0/Xiw+XiJuXiEmXiVEXiEiXipGXiI/XihDXiJkXi0/Xiw+XiJuXi1qIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_1cddfe94d92a",
      "text": "再打完 ",
      "encoded_ascii": "^!l^$-^#, ",
      "encoded_base64": "XiFsXiQtXiMsIA==",
      "byte_length": 10
    },
    {
      "unit_id": "DLG_7eef0018c38d",
      "text": "兩場戰鬥",
      "encoded_ascii": "^!i^\"n^$(^*,",
      "encoded_base64": "XiFpXiJuXiQoXios",
      "byte_length": 12
    },
    {
      "unit_id": "DLG_49c7550464d5",
      "text": "一場戰鬥",
      "encoded_ascii": "^!%^\"n^$(^*,",
      "encoded_base64": "XiElXiJuXiQoXios",
      "byte_length": 12
    },
    {
      "unit_id": "DLG_752b9c806d5b",
      "text": " 後回來，就能加入我們的幫派，跟我們一起逃走。 ",
      "encoded_ascii": " ^#b^\"\\^!O^*A^*J^'b^\"\"^!f^$%^*{^&Z^+}^.n^*A^.+^$%^*{^!%^.(^(p^.&^!\" ",
      "encoded_base64": "IF4jYl4iXF4hT14qQV4qSl4nYl4iIl4hZl4kJV4qe14mWl4rfV4ubl4qQV4uK14kJV4qe14hJV4uKF4ocF4uJl4hIiA=",
      "byte_length": 68
    },
    {
      "unit_id": "DLG_eb8a7567a1d7",
      "text": "既然你回來了。那麼，計畫是什麼？ ",
      "encoded_ascii": "^,U^&\"^*F^\"\\^!O^*D^!\"^)!^.T^*A^-n^-,^,X^!=^.T^.V ",
      "encoded_base64": "XixVXiYiXipGXiJcXiFPXipEXiEiXikhXi5UXipBXi1uXi0sXixYXiE9Xi5UXi5WIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_a678924a1a0e",
      "text": "  我們走西北邊的下水道！",
      "encoded_ascii": "  ^$%^*{^.&^-l^+6^.8^&Z^!(^%V^(y^*W",
      "encoded_base64": "ICBeJCVeKnteLiZeLWxeKzZeLjheJlpeISheJVZeKHleKlc=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_d7ca73d57d98",
      "text": "  我們往南走如何？ ",
      "encoded_ascii": "  ^$%^*{^,)^\"/^.&^#$^!L^.V ",
      "encoded_base64": "ICBeJCVeKnteLCleIi9eLiZeIyReIUxeLlYg",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_f8955eb4a8c7",
      "text": "  我們伏擊庫爾扎克。 ",
      "encoded_ascii": "  ^$%^*{^3c^$F^,#^&/^,=^!d^!\" ",
      "encoded_base64": "ICBeJCVeKnteM2NeJEZeLCNeJi9eLD1eIWReISIg",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_36fd02e7159d",
      "text": "  我們往北走，穿過大門。 ",
      "encoded_ascii": "  ^$%^*{^,)^+6^.&^*A^')^(x^\"z^)D^!\" ",
      "encoded_base64": "ICBeJCVeKnteLCleKzZeLiZeKkFeJyleKHheInpeKUReISIg",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_90a09097fb95",
      "text": "我管你叫什麼名字？我是梅爾佐爾，是你這輩子遇過最狠的 ",
      "encoded_ascii": "^$%^-D^*F^+<^!=^.T^\"F^#)^.V^$%^,X^%-^&/^>1^&/^*A^,X^*F^(s^8t^#(^.2^(x^$q^4T^&Z ",
      "encoded_base64": "XiQlXi1EXipGXis8XiE9Xi5UXiJGXiMpXi5WXiQlXixYXiUtXiYvXj4xXiYvXipBXixYXipGXihzXjh0XiMoXi4yXih4XiRxXjRUXiZaIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_600104cbee26",
      "text": "暴虐獸養的硬漢！",
      "encoded_ascii": "^$m^3)^&<^.I^&Z^25^4Q^*W",
      "encoded_base64": "XiRtXjMpXiY8Xi5JXiZaXjI1XjRRXipX",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_b56e1b94bc8d",
      "text": "很高興能跟你面對面說話。我是梅爾佐爾。",
      "encoded_ascii": "^*K^*+^-]^'b^.+^*F^)j^#:^)j^-x^-v^!\"^$%^,X^%-^&/^>1^&/^!\"",
      "encoded_base64": "XipLXiorXi1dXidiXi4rXipGXilqXiM6XilqXi14Xi12XiEiXiQlXixYXiUtXiYvXj4xXiYvXiEi",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_f47b5e006919",
      "text": "好吧，要是你不肯回答我的問題，那我只好動手殺了 ",
      "encoded_ascii": "^+i^*I^*A^(C^,X^*F^!)^-Z^\"\\^-B^$%^&Z^*Z^.G^*A^)!^$%^\"?^+i^\"%^$+^%M^*D ",
      "encoded_base64": "XitpXipJXipBXihDXixYXipGXiEpXi1aXiJcXi1CXiQlXiZaXipaXi5HXipBXikhXiQlXiI/XitpXiIlXiQrXiVNXipEIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_454897481b71",
      "text": "你。 ",
      "encoded_ascii": "^*F^!\" ",
      "encoded_base64": "XipGXiEiIA==",
      "byte_length": 7
    },
    {
      "unit_id": "DLG_ba2c792f97ed",
      "text": "沒了我，這個幫派什麼都不是！儘管放馬過來吧。 ",
      "encoded_ascii": "^%\\^*D^$%^*A^(s^!V^+}^.n^!=^.T^)$^!)^,X^*W^+(^-D^$P^*\"^(x^!O^*I^!\" ",
      "encoded_base64": "XiVcXipEXiQlXipBXihzXiFWXit9Xi5uXiE9Xi5UXikkXiEpXixYXipXXisoXi1EXiRQXioiXih4XiFPXipJXiEiIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_fbff8466479c",
      "text": "我以前總是把錢全押在競技場的比賽上。結果我聽信了爛內線消息， ",
      "encoded_ascii": "^$%^!B^!z^-M^,X^$1^.<^!h^7Z^\"d^-?^,>^\"n^&Z^,m^*U^!'^!\"^'@^%!^$%^-X^!U^*D^&-^!g^'I^%k^#w^*A ",
      "encoded_base64": "XiQlXiFCXiF6Xi1NXixYXiQxXi48XiFoXjdaXiJkXi0/Xiw+XiJuXiZaXixtXipVXiEnXiEiXidAXiUhXiQlXi1YXiFVXipEXiYtXiFnXidJXiVrXiN3XipBIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_0c44de18d057",
      "text": "下注遠遠超出了我的承受能力。我輸掉了那場賭局，而且根本付不出來。為了抵償 ",
      "encoded_ascii": "^!(^%e^({^({^(\\^!q^*D^$%^&Z^$0^\";^'b^!~^!\"^$%^>A^/e^*D^)!^\"n^=L^._^*A^'W^!*^%)^$x^*u^!)^!q^!O^!\"^%{^*D^$5^5- ",
      "encoded_base64": "XiEoXiVlXih7Xih7XihcXiFxXipEXiQlXiZaXiQwXiI7XidiXiF+XiEiXiQlXj5BXi9lXipEXikhXiJuXj1MXi5fXipBXidXXiEqXiUpXiR4Xip1XiEpXiFxXiFPXiEiXiV7XipEXiQ1XjUtIA==",
      "byte_length": 109
    },
    {
      "unit_id": "DLG_873681ae2853",
      "text": "我的債務，聖堂武士長就把我賣去當了奴隸。 ",
      "encoded_ascii": "^$%^&Z^<d^+4^*A^'Z^42^%J^+a^)C^*J^$1^$%^.$^\"6^&N^*D^##^)Z^!\" ",
      "encoded_base64": "XiQlXiZaXjxkXis0XipBXidaXjQyXiVKXithXilDXipKXiQxXiQlXi4kXiI2XiZOXipEXiMjXilaXiEiIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_b133513a922f",
      "text": "要是我知道，我自己早就去做了！不過一旦我們有了計畫，你就可以跟我們一起逃走！ ",
      "encoded_ascii": "^(C^,X^$%^&h^(y^*A^$%^'l^#I^,V^*J^\"6^*~^*D^*W^!)^(x^!%^1C^$%^*{^$s^*D^-n^-,^*A^*F^*J^\"A^!B^.+^$%^*{^!%^.(^(p^.&^*W ",
      "encoded_base64": "XihDXixYXiQlXiZoXih5XipBXiQlXidsXiNJXixWXipKXiI2Xip+XipEXipXXiEpXih4XiElXjFDXiQlXip7XiRzXipEXi1uXi0sXipBXipGXipKXiJBXiFCXi4rXiQlXip7XiElXi4oXihwXi4mXipXIA==",
      "byte_length": 115
    },
    {
      "unit_id": "DLG_7ce1cb2408b5",
      "text": "我只知道如果你去敲 ",
      "encoded_ascii": "^$%^\"?^&h^(y^#$^%!^*F^\"6^1A ",
      "encoded_base64": "XiQlXiI/XiZoXih5XiMkXiUhXipGXiI2XjFBIA==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_76f76f3390a2",
      "text": "前門，庫爾扎克就會以為你準備好去戰鬥而把門打開。 ",
      "encoded_ascii": "^!z^)D^*A^,#^&/^,=^!d^*J^$r^!B^%{^*F^,x^+\"^+i^\"6^$(^*,^'W^$1^)D^$-^)F^!\" ",
      "encoded_base64": "XiF6XilEXipBXiwjXiYvXiw9XiFkXipKXiRyXiFCXiV7XipGXix4XisiXitpXiI2XiQoXiosXidXXiQxXilEXiQtXilGXiEiIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_6cd2fce44a5d",
      "text": "我說等門一開，我們就直接把他給宰了！ ",
      "encoded_ascii": "^$%^-x^'-^)D^!%^)F^*A^$%^*{^*J^&`^$?^$1^!@^'A^1w^*D^*W ",
      "encoded_base64": "XiQlXi14XictXilEXiElXilGXipBXiQlXip7XipKXiZgXiQ/XiQxXiFAXidBXjF3XipEXipXIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_cd60ff44e865",
      "text": "  那我們接下來該怎麼辦？",
      "encoded_ascii": "  ^)!^$%^*{^$?^!(^!O^(M^,,^.T^2L^.V",
      "encoded_base64": "ICBeKSFeJCVeKnteJD9eISheIU9eKE1eLCxeLlReMkxeLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_c6050abd3b6d",
      "text": "  很好——西北邊有個下水道！",
      "encoded_ascii": "  ^*K^+i^*n^*n^-l^+6^.8^$s^!V^!(^%V^(y^*W",
      "encoded_base64": "ICBeKkteK2leKm5eKm5eLWxeKzZeLjheJHNeIVZeISheJVZeKHleKlc=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_349c597dccb6",
      "text": "我不知道——我們乾脆把守衛全部殺光，把這裡佔領下來！哈哈！",
      "encoded_ascii": "^$%^!)^&h^(y^*n^*n^$%^*{^*X^2?^$1^#+^(=^!h^)#^%M^!c^*A^$1^(s^-j^0R^)s^!(^!O^*W^+F^+F^*W",
      "encoded_base64": "XiQlXiEpXiZoXih5XipuXipuXiQlXip7XipYXjI/XiQxXiMrXig9XiFoXikjXiVNXiFjXipBXiQxXihzXi1qXjBSXilzXiEoXiFPXipXXitGXitGXipX",
      "byte_length": 87
    },
    {
      "unit_id": "DLG_05cac7e4075e",
      "text": "  真高明——我們會被屠殺殆盡的。 ",
      "encoded_ascii": "  ^-2^*+^$c^*n^*n^$%^*{^$r^(@^#A^%M^8H^-1^&Z^!\" ",
      "encoded_base64": "ICBeLTJeKiteJGNeKm5eKm5eJCVeKnteJHJeKEBeI0FeJU1eOEheLTFeJlpeISIg",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_5e793c59eb6c",
      "text": "  我們改天再談這個吧。 ",
      "encoded_ascii": "  ^$%^*{^$N^+e^!l^0;^(s^!V^*I^!\" ",
      "encoded_base64": "ICBeJCVeKnteJE5eK2VeIWxeMDteKHNeIVZeKkleISIg",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_7b18f56a4aa7",
      "text": "  好主意。我們出發！ ",
      "encoded_ascii": "  ^+i^!-^#z^!\"^$%^*{^!q^&W^*W ",
      "encoded_base64": "ICBeK2leIS1eI3peISJeJCVeKnteIXFeJldeKlcg",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_913523a02a26",
      "text": "要是你有更好的主意，就來告訴我！",
      "encoded_ascii": "^(C^,X^*F^$s^$o^+i^&Z^!-^#z^*A^*J^!O^+B^-t^$%^*W",
      "encoded_base64": "XihDXixYXipGXiRzXiRvXitpXiZaXiEtXiN6XipBXipKXiFPXitCXi10XiQlXipX",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_0ab455cb8e35",
      "text": "太好了！我們現在就走！",
      "encoded_ascii": "^+f^+i^*D^*W^$%^*{^&?^\"d^*J^.&^*W",
      "encoded_base64": "XitmXitpXipEXipXXiQlXip7XiY/XiJkXipKXi4mXipX",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_a611b161ac25",
      "text": "  我們先緩緩。",
      "encoded_ascii": "  ^$%^*{^!b^'J^'J^!\"",
      "encoded_base64": "ICBeJCVeKnteIWJeJ0peJ0peISI=",
      "byte_length": 20
    },
    {
      "unit_id": "DLG_769bd7daba8d",
      "text": "  沒錯——我們出發。 ",
      "encoded_ascii": "  ^%\\^)5^*n^*n^$%^*{^!q^&W^!\" ",
      "encoded_base64": "ICBeJVxeKTVeKm5eKm5eJCVeKnteIXFeJldeISIg",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_8fed15527dcf",
      "text": "隨你怎麼說。準備好了就回來。 ",
      "encoded_ascii": "^)X^*F^,,^.T^-x^!\"^,x^+\"^+i^*D^*J^\"\\^!O^!\" ",
      "encoded_base64": "XilYXipGXiwsXi5UXi14XiEiXix4XisiXitpXipEXipKXiJcXiFPXiEiIA==",
      "byte_length": 43
    },
    {
      "unit_id": "DLG_0a3474899bdf",
      "text": "太好了，我們在大門邊等你。 ",
      "encoded_ascii": "^+f^+i^*D^*A^$%^*{^\"d^\"z^)D^.8^'-^*F^!\" ",
      "encoded_base64": "XitmXitpXipEXipBXiQlXip7XiJkXiJ6XilEXi44XictXipGXiEiIA==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_8dca420b9449",
      "text": "好的！我們在那裡會合！",
      "encoded_ascii": "^+i^&Z^*W^$%^*{^\"d^)!^-j^$r^\"C^*W",
      "encoded_base64": "XitpXiZaXipXXiQlXip7XiJkXikhXi1qXiRyXiJDXipX",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_eb218df6eb57",
      "text": "那跟往北走一樣糟糕！那裡有聖堂武士、一大堆守衛，其他就沒 ",
      "encoded_ascii": "^)!^.+^,)^+6^.&^!%^,f^-E^4\\^*W^)!^-j^$s^'Z^42^%J^+a^!!^!%^\"z^*[^#+^(=^*A^!j^!@^*J^%\\ ",
      "encoded_base64": "XikhXi4rXiwpXis2Xi4mXiElXixmXi1FXjRcXipXXikhXi1qXiRzXidaXjQyXiVKXithXiEhXiElXiJ6XipbXiMrXig9XipBXiFqXiFAXipKXiVcIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_060cfe652602",
      "text": "什麼東西了！ ",
      "encoded_ascii": "^!=^.T^,`^-l^*D^*W ",
      "encoded_base64": "XiE9Xi5UXixgXi1sXipEXipXIA==",
      "byte_length": 19
    },
    {
      "unit_id": "DLG_0997e020225e",
      "text": "  無論如何我們還是試試看！",
      "encoded_ascii": "  ^%}^1\\^#$^!L^$%^*{^.7^,X^-u^-u^*Q^*W",
      "encoded_base64": "ICBeJX1eMVxeIyReIUxeJCVeKnteLjdeLFheLXVeLXVeKlFeKlc=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_6f7dab867dc8",
      "text": "  我知道一條秘密通道。 ",
      "encoded_ascii": "  ^$%^&h^(y^!%^%.^1O^#0^(t^(y^!\" ",
      "encoded_base64": "ICBeJCVeJmheKHleISVeJS5eMU9eIzBeKHReKHleISIg",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_078eb8830f23",
      "text": "  你說得對——這是個蠢主意。 ",
      "encoded_ascii": "  ^*F^-x^#e^#:^*n^*n^(s^,X^!V^.u^!-^#z^!\" ",
      "encoded_base64": "ICBeKkZeLXheI2VeIzpeKm5eKm5eKHNeLFheIVZeLnVeIS1eI3peISIg",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_5eb15d3b6940",
      "text": "你自己去試吧——等你有了更好的計畫再來找我們！ ",
      "encoded_ascii": "^*F^'l^#I^\"6^-u^*I^*n^*n^'-^*F^$s^*D^$o^+i^&Z^-n^-,^!l^!O^$/^$%^*{^*W ",
      "encoded_base64": "XipGXidsXiNJXiI2Xi11XipJXipuXipuXictXipGXiRzXipEXiRvXitpXiZaXi1uXi0sXiFsXiFPXiQvXiQlXip7XipXIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_8f0f84a8d720",
      "text": "一條秘密通道，嗯？值得一試！我們要怎麼把門打開？ ",
      "encoded_ascii": "^!%^%.^1O^#0^(t^(y^*A^6N^.V^!Z^#e^!%^-u^*W^$%^*{^(C^,,^.T^$1^)D^$-^)F^.V ",
      "encoded_base64": "XiElXiUuXjFPXiMwXih0Xih5XipBXjZOXi5WXiFaXiNlXiElXi11XipXXiQlXip7XihDXiwsXi5UXiQxXilEXiQtXilGXi5WIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_3df67439c5f7",
      "text": "  我不知道。",
      "encoded_ascii": "  ^$%^!)^&h^(y^!\"",
      "encoded_base64": "ICBeJCVeISleJmheKHleISI=",
      "byte_length": 17
    },
    {
      "unit_id": "DLG_457b2ca57d1a",
      "text": "  特權管事有一把通往南邊的鑰匙！",
      "encoded_ascii": "  ^&5^1E^-D^*r^$s^!%^$1^(t^,)^\"/^.8^&Z^)@^\"*^*W",
      "encoded_base64": "ICBeJjVeMUVeLUReKnJeJHNeISVeJDFeKHReLCleIi9eLjheJlpeKUBeIipeKlc=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_de700e4485a9",
      "text": "  那道門可以強行破開。 ",
      "encoded_ascii": "  ^)!^(y^)D^\"A^!B^#]^(;^&n^)F^!\" ",
      "encoded_base64": "ICBeKSFeKHleKUReIkFeIUJeI11eKDteJm5eKUZeISIg",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_06b27faefaa1",
      "text": "  我已經把門打開了。 ",
      "encoded_ascii": "  ^$%^#J^'D^$1^)D^$-^)F^*D^!\" ",
      "encoded_base64": "ICBeJCVeI0peJ0ReJDFeKUReJC1eKUZeKkReISIg",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_e1a294e690a6",
      "text": "沒錯——他負責清理迪諾斯的牢房，對吧？這值得一試…… ",
      "encoded_ascii": "^%\\^)5^*n^*n^!@^(W^0>^,u^&A^(m^7k^$[^&Z^-$^,<^*A^#:^*I^.V^(s^!Z^#e^!%^-u^*o^*o ",
      "encoded_base64": "XiVcXik1XipuXipuXiFAXihXXjA+Xix1XiZBXihtXjdrXiRbXiZaXi0kXiw8XipBXiM6XipJXi5WXihzXiFaXiNlXiElXi11XipvXipvIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_689912120773",
      "text": "我們會在南門附近等你！ ",
      "encoded_ascii": "^$%^*{^$r^\"d^\"/^)D^.?^(l^'-^*F^*W ",
      "encoded_base64": "XiQlXip7XiRyXiJkXiIvXilEXi4/XihsXictXipGXipXIA==",
      "byte_length": 34
    },
    {
      "unit_id": "DLG_e6f79936e30a",
      "text": "隨你怎麼說。 ",
      "encoded_ascii": "^)X^*F^,,^.T^-x^!\" ",
      "encoded_base64": "XilYXipGXiwsXi5UXi14XiEiIA==",
      "byte_length": 19
    },
    {
      "unit_id": "DLG_fd76f5f1d5ab",
      "text": "在競技場裡至少再打一場之前，別白費心機去嘗試了。 ",
      "encoded_ascii": "^\"d^-?^,>^\"n^-j^'n^#<^!l^$-^!%^\"n^!/^!z^*A^*H^&X^.\"^#k^%>^\"6^1o^-u^*D^!\" ",
      "encoded_base64": "XiJkXi0/Xiw+XiJuXi1qXiduXiM8XiFsXiQtXiElXiJuXiEvXiF6XipBXipIXiZYXi4iXiNrXiU+XiI2XjFvXi11XipEXiEiIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_10678c09838e",
      "text": "你現在根本不知道自己在做什麼。",
      "encoded_ascii": "^*F^&?^\"d^%)^$x^!)^&h^(y^'l^#I^\"d^*~^!=^.T^!\"",
      "encoded_base64": "XipGXiY/XiJkXiUpXiR4XiEpXiZoXih5XidsXiNJXiJkXip+XiE9Xi5UXiEi",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_f29d861e96f3",
      "text": "祝你好運。 ",
      "encoded_ascii": "^&v^*F^+i^.4^!\" ",
      "encoded_base64": "XiZ2XipGXitpXi40XiEiIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_fe7b233c52f3",
      "text": "祝你們好運！我們在德拉吉城外見！ ",
      "encoded_ascii": "^&v^*F^*{^+i^.4^*W^$%^*{^\"d^#j^$6^\"D^+_^\"w^-m^*W ",
      "encoded_base64": "XiZ2XipGXip7XitpXi40XipXXiQlXip7XiJkXiNqXiQ2XiJEXitfXiJ3Xi1tXipXIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_7cdb5d8aab0d",
      "text": "繼續前進！要是我們不快點出去，就永遠逃不掉了！ ",
      "encoded_ascii": "^-O^'M^!z^(w^*W^(C^,X^$%^*{^!)^*L^*;^!q^\"6^*A^*J^%W^({^(p^!)^/e^*D^*W ",
      "encoded_base64": "Xi1PXidNXiF6Xih3XipXXihDXixYXiQlXip7XiEpXipMXio7XiFxXiI2XipBXipKXiVXXih7XihwXiEpXi9lXipEXipXIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_5ab7dc0e5094",
      "text": "別跟我說話——去跟梅爾佐爾談。 ",
      "encoded_ascii": "^*H^.+^$%^-x^-v^*n^*n^\"6^.+^%-^&/^>1^&/^0;^!\" ",
      "encoded_base64": "XipIXi4rXiQlXi14Xi12XipuXipuXiI2Xi4rXiUtXiYvXj4xXiYvXjA7XiEiIA==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_94dd6074ecfd",
      "text": "老大才是你該找的人。 ",
      "encoded_ascii": "^'U^\"z^$,^,X^*F^(M^$/^&Z^!<^!\" ",
      "encoded_base64": "XidVXiJ6XiQsXixYXipGXihNXiQvXiZaXiE8XiEiIA==",
      "byte_length": 31
    },
    {
      "unit_id": "DLG_1a8fe7ca29ab",
      "text": "你把東西藏進乾草堆裡了嗎？ ",
      "encoded_ascii": "^*F^$1^,`^-l^-f^(w^*X^*f^*[^-j^*D^+X^.V ",
      "encoded_base64": "XipGXiQxXixgXi1sXi1mXih3XipYXipmXipbXi1qXipEXitYXi5WIA==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_a223967a9fdf",
      "text": "安靜——門外有人！ ",
      "encoded_ascii": "^+p^)h^*n^*n^)D^\"w^$s^!<^*W ",
      "encoded_base64": "XitwXiloXipuXipuXilEXiJ3XiRzXiE8XipXIA==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_5f7f136147b8",
      "text": "越獄的時間到了嗎？",
      "encoded_ascii": "^(]^3Q^&Z^$f^)G^!u^*D^+X^.V",
      "encoded_base64": "XihdXjNRXiZaXiRmXilHXiF1XipEXitYXi5W",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_793f29c5dff6",
      "text": "噓，還沒！ ",
      "encoded_ascii": "^/W^*A^.7^%\\^*W ",
      "encoded_base64": "Xi9XXipBXi43XiVcXipXIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_fdb3136aa1c6",
      "text": "  我們繼續走！ ",
      "encoded_ascii": "  ^$%^*{^-O^'M^.&^*W ",
      "encoded_base64": "ICBeJCVeKnteLU9eJ01eLiZeKlcg",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_c8805f7d184f",
      "text": "  這樣行不通——退回去！",
      "encoded_ascii": "  ^(s^,f^(;^!)^(t^*n^*n^*V^\"\\^\"6^*W",
      "encoded_base64": "ICBeKHNeLGZeKDteISleKHReKm5eKm5eKlZeIlxeIjZeKlc=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_603ed0896d01",
      "text": "  我們應該分頭行動。 ",
      "encoded_ascii": "  ^$%^*{^0`^(M^!s^)t^(;^\"%^!\" ",
      "encoded_base64": "ICBeJCVeKnteMGBeKE1eIXNeKXReKDteIiVeISIg",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_cdf81c1683ea",
      "text": "我們就在你身後！ ",
      "encoded_ascii": "^$%^*{^*J^\"d^*F^(c^#b^*W ",
      "encoded_base64": "XiQlXip7XipKXiJkXipGXihjXiNiXipXIA==",
      "byte_length": 25
    },
    {
      "unit_id": "DLG_28a12de6fdc6",
      "text": "警報已經響了——我們不能退回去！ ",
      "encoded_ascii": "^(S^+`^#J^'D^)o^*D^*n^*n^$%^*{^!)^'b^*V^\"\\^\"6^*W ",
      "encoded_base64": "XihTXitgXiNKXidEXilvXipEXipuXipuXiQlXip7XiEpXidiXipWXiJcXiI2XipXIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_ddb625fd6ba3",
      "text": "要是你覺得這樣最好，那我們就回頭。",
      "encoded_ascii": "^(C^,X^*F^(G^#e^(s^,f^$q^+i^*A^)!^$%^*{^*J^\"\\^)t^!\"",
      "encoded_base64": "XihDXixYXipGXihHXiNlXihzXixmXiRxXitpXipBXikhXiQlXip7XipKXiJcXil0XiEi",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_c7aeb87572d7",
      "text": "好主意，我們在另一邊碰頭！",
      "encoded_ascii": "^+i^!-^#z^*A^$%^*{^\"d^\">^!%^.8^-5^)t^*W",
      "encoded_base64": "XitpXiEtXiN6XipBXiQlXip7XiJkXiI+XiElXi44Xi01Xil0XipX",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_40891b1cddf1",
      "text": "我們要趁警報響起前趕回牢房。 ",
      "encoded_ascii": "^$%^*{^(C^.)^(S^+`^)o^.(^!z^0u^\"\\^-$^,<^!\" ",
      "encoded_base64": "XiQlXip7XihDXi4pXihTXitgXilvXi4oXiF6XjB1XiJcXi0kXiw8XiEiIA==",
      "byte_length": 43
    },
    {
      "unit_id": "DLG_13f90af504b8",
      "text": "嗯……乾草堆？什麼乾草堆？噢……那個乾草堆。等等！ ",
      "encoded_ascii": "^6N^*o^*o^*X^*f^*[^.V^!=^.T^*X^*f^*[^.V^+]^*o^*o^)!^!V^*X^*f^*[^!\"^'-^'-^*W ",
      "encoded_base64": "XjZOXipvXipvXipYXipmXipbXi5WXiE9Xi5UXipYXipmXipbXi5WXitdXipvXipvXikhXiFWXipYXipmXipbXiEiXictXictXipXIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_a852275ac9aa",
      "text": "你憑什麼認為乾草堆裡有東西！你在暗中 ",
      "encoded_ascii": "^*F^,5^!=^.T^(O^%{^*X^*f^*[^-j^$s^,`^-l^*W^*F^\"d^$k^!, ",
      "encoded_base64": "XipGXiw1XiE9Xi5UXihPXiV7XipYXipmXipbXi1qXiRzXixgXi1sXipXXipGXiJkXiRrXiEsIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_e17b91e16bc0",
      "text": "監視我們嗎？ ",
      "encoded_ascii": "^2|^(E^$%^*{^+X^.V ",
      "encoded_base64": "XjJ8XihFXiQlXip7XitYXi5WIA==",
      "byte_length": 19
    },
    {
      "unit_id": "DLG_bcfc1d133abc",
      "text": "  別叫我傻子，小矮子！ ",
      "encoded_ascii": "  ^*H^+<^$%^7$^#(^*A^#;^&j^#(^*W ",
      "encoded_base64": "ICBeKkheKzxeJCVeNyReIyheKkFeIzteJmpeIyheKlcg",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_d55046f24888",
      "text": "  我們都有乾草堆。那是用來睡覺的。",
      "encoded_ascii": "  ^$%^*{^)$^$s^*X^*f^*[^!\"^)!^,X^&H^!O^-3^(G^&Z^!\"",
      "encoded_base64": "ICBeJCVeKnteKSReJHNeKlheKmZeKlteISJeKSFeLFheJkheIU9eLTNeKEdeJlpeISI=",
      "byte_length": 50
    },
    {
      "unit_id": "DLG_0b4f26ea1a5e",
      "text": "  身為一名法力強大的法師，我用占卜術窺探到的。 ",
      "encoded_ascii": "  ^(c^%{^!%^\"F^%b^!~^#]^\"z^&Z^%b^#M^*A^$%^&H^54^53^(<^6f^$>^!u^&Z^!\" ",
      "encoded_base64": "ICBeKGNeJXteISVeIkZeJWJeIX5eI11eInpeJlpeJWJeI01eKkFeJCVeJkheNTReNTNeKDxeNmZeJD5eIXVeJlpeISIg",
      "byte_length": 69
    },
    {
      "unit_id": "DLG_afdd134b5b3f",
      "text": "  我能看透你內心深處的想法。 ",
      "encoded_ascii": "  ^$%^'b^*Q^(q^*F^!g^#k^2*^(,^&Z^,1^%b^!\" ",
      "encoded_base64": "ICBeJCVeJ2JeKlFeKHFeKkZeIWdeI2teMipeKCxeJlpeLDFeJWJeISIg",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_6be26ed9bf1b",
      "text": "  我無意間聽到了你們的談話。 ",
      "encoded_ascii": "  ^$%^%}^#z^)G^-X^!u^*D^*F^*{^&Z^0;^-v^!\" ",
      "encoded_base64": "ICBeJCVeJX1eI3peKUdeLVheIXVeKkReKkZeKnteJlpeMDteLXZeISIg",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_cfb8c3bd7b18",
      "text": "  你什麼都不是，我要宰了你。 ",
      "encoded_ascii": "  ^*F^!=^.T^)$^!)^,X^*A^$%^(C^1w^*D^*F^!\" ",
      "encoded_base64": "ICBeKkZeIT1eLlReKSReISleLFheKkFeJCVeKENeMXdeKkReKkZeISIg",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_3e430bfed309",
      "text": "換個話題。 ",
      "encoded_ascii": "^4@^!V^-v^.G^!\" ",
      "encoded_base64": "XjRAXiFWXi12Xi5HXiEiIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_32b389d0b121",
      "text": "慢著。我想知道你怎麼會曉得那乾草堆的事。 ",
      "encoded_ascii": "^#~^-a^!\"^$%^,1^&h^(y^*F^,,^.T^$r^7y^#e^)!^*X^*f^*[^&Z^*r^!\" ",
      "encoded_base64": "XiN+Xi1hXiEiXiQlXiwxXiZoXih5XipGXiwsXi5UXiRyXjd5XiNlXikhXipYXipmXipbXiZaXipyXiEiIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_5262f666f14c",
      "text": "我真正想說的是，呃，嗯，你到底是怎麼知道的？ ",
      "encoded_ascii": "^$%^-2^%H^,1^-x^&Z^,X^*A^3<^*A^6N^*A^*F^!u^/^^,X^,,^.T^&h^(y^&Z^.V ",
      "encoded_base64": "XiQlXi0yXiVIXiwxXi14XiZaXixYXipBXjM8XipBXjZOXipBXipGXiF1Xi9eXixYXiwsXi5UXiZoXih5XiZaXi5WIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_b79458cde07f",
      "text": "啊，一位法師！一位強大的盟友！ ",
      "encoded_ascii": "^+Q^*A^!%^!J^%b^#M^*W^!%^!J^#]^\"z^&Z^-0^\"8^*W ",
      "encoded_base64": "XitRXipBXiElXiFKXiViXiNNXipXXiElXiFKXiNdXiJ6XiZaXi0wXiI4XipXIA==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_c93862d214ca",
      "text": "一位靈法師！我一見到你就知道了！ ",
      "encoded_ascii": "^!%^!J^)g^%b^#M^*W^$%^!%^-m^!u^*F^*J^&h^(y^*D^*W ",
      "encoded_base64": "XiElXiFKXilnXiViXiNNXipXXiQlXiElXi1tXiF1XipGXipKXiZoXih5XipEXipXIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_8372a62192f5",
      "text": "你在偷聽我們的談話？ 要是再讓我抓到你 ",
      "encoded_ascii": "^*F^\"d^/O^-X^$%^*{^&Z^0;^-v^.V ^(C^,X^!l^-}^$%^$2^!u^*F ",
      "encoded_base64": "XipGXiJkXi9PXi1YXiQlXip7XiZaXjA7Xi12Xi5WIF4oQ14sWF4hbF4tfV4kJV4kMl4hdV4qRiA=",
      "byte_length": 56
    },
    {
      "unit_id": "DLG_8d5bbceff53d",
      "text": "幹這種事，我就得宰了你！",
      "encoded_ascii": "^,!^(s^'$^*r^*A^$%^*J^#e^1w^*D^*F^*W",
      "encoded_base64": "XiwhXihzXickXipyXipBXiQlXipKXiNlXjF3XipEXipGXipX",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_f7dca6780ec5",
      "text": "我真不敢相信居然有蠢笨的半巨人想跟我鬥智！ ",
      "encoded_ascii": "^$%^-2^!)^/m^&a^!U^+w^&\"^$s^.u^5#^&Z^\"-^#H^!<^,1^.+^$%^*,^$i^*W ",
      "encoded_base64": "XiQlXi0yXiEpXi9tXiZhXiFVXit3XiYiXiRzXi51XjUjXiZaXiItXiNIXiE8XiwxXi4rXiQlXiosXiRpXipXIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_d5ac46d68162",
      "text": "少跟我耍小聰明！你問的是那處特定的乾草堆！ ",
      "encoded_ascii": "^#<^.+^$%^7E^#;^2=^$c^*W^*F^*Z^&Z^,X^)!^(,^&5^#.^&Z^*X^*f^*[^*W ",
      "encoded_base64": "XiM8Xi4rXiQlXjdFXiM7XjI9XiRjXipXXipGXipaXiZaXixYXikhXigsXiY1XiMuXiZaXipYXipmXipbXipXIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_a11d54be194e",
      "text": "你到底是怎麼知道的？ ",
      "encoded_ascii": "^*F^!u^/^^,X^,,^.T^&h^(y^&Z^.V ",
      "encoded_base64": "XipGXiF1Xi9eXixYXiwsXi5UXiZoXih5XiZaXi5WIA==",
      "byte_length": 31
    },
    {
      "unit_id": "DLG_6127b5dede62",
      "text": "這足以補償發生過的一切了。 ",
      "encoded_ascii": "^(s^(^^!B^6&^5-^&W^&F^(x^&Z^!%^+.^*D^!\" ",
      "encoded_base64": "XihzXiheXiFCXjYmXjUtXiZXXiZGXih4XiZaXiElXisuXipEXiEiIA==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_98a2f415ceba",
      "text": "多謝你的寶石。 ",
      "encoded_ascii": "^\"x^-z^*F^&Z^#4^&k^!\" ",
      "encoded_base64": "XiJ4Xi16XipGXiZaXiM0XiZrXiEiIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_2a274f18ffa9",
      "text": "你已經履行了你的約定。 ",
      "encoded_ascii": "^*F^#J^'D^5L^(;^*D^*F^&Z^-F^#.^!\" ",
      "encoded_base64": "XipGXiNKXidEXjVMXig7XipEXipGXiZaXi1GXiMuXiEiIA==",
      "byte_length": 34
    },
    {
      "unit_id": "DLG_4256e8f03908",
      "text": "我在城裡有一位秘密庇護者，他賄賂了 ",
      "encoded_ascii": "^$%^\"d^+_^-j^$s^!%^!J^1O^#0^,\"^(T^'V^*A^!@^61^60^*D ",
      "encoded_base64": "XiQlXiJkXitfXi1qXiRzXiElXiFKXjFPXiMwXiwiXihUXidWXipBXiFAXjYxXjYwXipEIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_aa24aa0238bc",
      "text": "守衛隊長。即便如此，可能還是會有些麻煩，所以我們分頭走會 ",
      "encoded_ascii": "^#+^(=^)U^)C^!\"^\"1^!R^#$^%I^*A^\"A^'b^.7^,X^$r^$s^!8^*6^-!^*A^$)^!B^$%^*{^!s^)t^.&^$r ",
      "encoded_base64": "XiMrXig9XilVXilDXiEiXiIxXiFSXiMkXiVJXipBXiJBXidiXi43XixYXiRyXiRzXiE4Xio2Xi0hXipBXiQpXiFCXiQlXip7XiFzXil0Xi4mXiRyIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_719f8edcf0cb",
      "text": "比較妥當。 ",
      "encoded_ascii": "^,m^(f^5C^&N^!\" ",
      "encoded_base64": "XixtXihmXjVDXiZOXiEiIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_85b7dfc33c03",
      "text": "只要你在競技場打完一場戰鬥，就可以離開。他們正等著你呢。 ",
      "encoded_ascii": "^\"?^(C^*F^\"d^-?^,>^\"n^$-^#,^!%^\"n^$(^*,^*A^*J^\"A^!B^)`^)F^!\"^!@^*{^%H^'-^-a^*F^+C^!\" ",
      "encoded_base64": "XiI/XihDXipGXiJkXi0/Xiw+XiJuXiQtXiMsXiElXiJuXiQoXiosXipBXipKXiJBXiFCXilgXilGXiEiXiFAXip7XiVIXictXi1hXipGXitDXiEiIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_e9310a55feff",
      "text": "你們現在可以離開了。",
      "encoded_ascii": "^*F^*{^&?^\"d^\"A^!B^)`^)F^*D^!\"",
      "encoded_base64": "XipGXip7XiY/XiJkXiJBXiFCXilgXilGXipEXiEi",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_c9b098b6507b",
      "text": "啊啊啊，誰來救救我！ ",
      "encoded_ascii": "^+Q^+Q^+Q^*A^-y^!O^,Q^,Q^$%^*W ",
      "encoded_base64": "XitRXitRXitRXipBXi15XiFPXixRXixRXiQlXipXIA==",
      "byte_length": 31
    },
    {
      "unit_id": "DLG_38e120025a35",
      "text": "拉響警報！米爾隆遭到攻擊了！ ",
      "encoded_ascii": "^$6^)o^(S^+`^*W^'4^&/^)T^(}^!u^$O^$F^*D^*W ",
      "encoded_base64": "XiQ2XilvXihTXitgXipXXic0XiYvXilUXih9XiF1XiRPXiRGXipEXipXIA==",
      "byte_length": 43
    },
    {
      "unit_id": "DLG_bad209c1d654",
      "text": "傷害泰克圖克提特萊的僕人，你們會付出代價的！",
      "encoded_ascii": "^!^^#/^%f^!d^\"b^!d^$A^&5^(!^&Z^+%^!<^*A^*F^*{^$r^*u^!q^*v^+&^&Z^*W",
      "encoded_base64": "XiFeXiMvXiVmXiFkXiJiXiFkXiRBXiY1XighXiZaXislXiE8XipBXipGXip7XiRyXip1XiFxXip2XismXiZaXipX",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_76441912f6cc",
      "text": "幹得好！你宰了那隻告密的小耗子！我們最好快點把你押進競技場 ",
      "encoded_ascii": "^,!^#e^+i^*W^*F^1w^*D^)!^)[^+B^#0^&Z^#;^'X^#(^*W^$%^*{^$q^+i^*L^*;^$1^*F^7Z^(w^-?^,>^\"n ",
      "encoded_base64": "XiwhXiNlXitpXipXXipGXjF3XipEXikhXilbXitCXiMwXiZaXiM7XidYXiMoXipXXiQlXip7XiRxXitpXipMXio7XiQxXipGXjdaXih3Xi0/Xiw+XiJuIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_8165ebba6347",
      "text": "打一場。 ",
      "encoded_ascii": "^$-^!%^\"n^!\" ",
      "encoded_base64": "XiQtXiElXiJuXiEiIA==",
      "byte_length": 13
    },
    {
      "unit_id": "DLG_c012792ac55e",
      "text": "行行好，求求你別傷害我！ ",
      "encoded_ascii": "^(;^(;^+i^*A^,n^,n^*F^*H^!^^#/^$%^*W ",
      "encoded_base64": "Xig7Xig7XitpXipBXixuXixuXipGXipIXiFeXiMvXiQlXipXIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_fb220034399f",
      "text": "拜託，別再打我了！我對疼痛的忍受度很低！",
      "encoded_ascii": "^,E^-q^*A^*H^!l^$-^$%^*D^*W^$%^#:^>E^-.^&Z^1y^\";^#V^*K^!K^*W",
      "encoded_base64": "XixFXi1xXipBXipIXiFsXiQtXiQlXipEXipXXiQlXiM6Xj5FXi0uXiZaXjF5XiI7XiNWXipLXiFLXipX",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_dd0311acbec8",
      "text": "在你在競技場打完那一場戰鬥之前，我不能跟你說話。 ",
      "encoded_ascii": "^\"d^*F^\"d^-?^,>^\"n^$-^#,^)!^!%^\"n^$(^*,^!/^!z^*A^$%^!)^'b^.+^*F^-x^-v^!\" ",
      "encoded_base64": "XiJkXipGXiJkXi0/Xiw+XiJuXiQtXiMsXikhXiElXiJuXiQoXiosXiEvXiF6XipBXiQlXiEpXidiXi4rXipGXi14Xi12XiEiIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_f99bd9315180",
      "text": "考慮到你和其他奴隸的打交道情況， ",
      "encoded_ascii": "^-R^19^!u^*F^\"O^!j^!@^##^)Z^&Z^$-^0P^(y^,0^,q^*A ",
      "encoded_base64": "Xi1SXjE5XiF1XipGXiJPXiFqXiFAXiMjXilaXiZaXiQtXjBQXih5XiwwXixxXipBIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_05eecdf3e640",
      "text": "我現在跟你說話可不是明智之舉。 ",
      "encoded_ascii": "^$%^&?^\"d^.+^*F^-x^-v^\"A^!)^,X^$c^$i^!/^01^!\" ",
      "encoded_base64": "XiQlXiY/XiJkXi4rXipGXi14Xi12XiJBXiEpXixYXiRjXiRpXiEvXjAxXiEiIA==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_6685f56e57a1",
      "text": "很快一切都會真相大白。繼續往前走吧。",
      "encoded_ascii": "^*K^*L^!%^+.^)$^$r^-2^&a^\"z^&X^!\"^-O^'M^,)^!z^.&^*I^!\"",
      "encoded_base64": "XipLXipMXiElXisuXikkXiRyXi0yXiZhXiJ6XiZYXiEiXi1PXidNXiwpXiF6Xi4mXipJXiEi",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_48550de4d8dd",
      "text": "噓！在我們穿過庫爾扎克身邊之前，保持安靜。 ",
      "encoded_ascii": "^/W^*W^\"d^$%^*{^')^(x^,#^&/^,=^!d^(c^.8^!/^!z^*A^!T^$7^+p^)h^!\" ",
      "encoded_base64": "Xi9XXipXXiJkXiQlXip7XicpXih4XiwjXiYvXiw9XiFkXihjXi44XiEvXiF6XipBXiFUXiQ3XitwXiloXiEiIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_df45ab5fa9f9",
      "text": "去敲門吧。告訴庫爾扎克是我叫你去的。 ",
      "encoded_ascii": "^\"6^1A^)D^*I^!\"^+B^-t^,#^&/^,=^!d^,X^$%^+<^*F^\"6^&Z^!\" ",
      "encoded_base64": "XiI2XjFBXilEXipJXiEiXitCXi10XiwjXiYvXiw9XiFkXixYXiQlXis8XipGXiI2XiZaXiEiIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_2e711ddc5f83",
      "text": "我們這就出發。 ",
      "encoded_ascii": "^$%^*{^(s^*J^!q^&W^!\" ",
      "encoded_base64": "XiQlXip7XihzXipKXiFxXiZXXiEiIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_94650dd96fb7",
      "text": "  我本來應該做什麼？ ",
      "encoded_ascii": "  ^$%^$x^!O^0`^(M^*~^!=^.T^.V ",
      "encoded_base64": "ICBeJCVeJHheIU9eMGBeKE1eKn5eIT1eLlReLlYg",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_f762ccb19912",
      "text": "  我改變主意了。 ",
      "encoded_ascii": "  ^$%^$N^(U^!-^#z^*D^!\" ",
      "encoded_base64": "ICBeJCVeJE5eKFVeIS1eI3peKkReISIg",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_3af0398819e1",
      "text": "你好啊！很高興見到你。請原諒我這副邋遢模樣，我已經在 ",
      "encoded_ascii": "^*F^+i^+Q^*W^*K^*+^-]^-m^!u^*F^!\"^*S^\"5^0<^$%^(s^52^>G^>F^%:^,f^*A^$%^#J^'D^\"d ",
      "encoded_base64": "XipGXitpXitRXipXXipLXiorXi1dXi1tXiF1XipGXiEiXipTXiI1XjA8XiQlXihzXjUyXj5HXj5GXiU6XixmXipBXiQlXiNKXidEXiJkIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_1a7b778c281d",
      "text": "這裡關了好一陣子了。 ",
      "encoded_ascii": "^(s^-j^.>^*D^+i^!%^)P^#(^*D^!\" ",
      "encoded_base64": "XihzXi1qXi4+XipEXitpXiElXilQXiMoXipEXiEiIA==",
      "byte_length": 31
    },
    {
      "unit_id": "DLG_1156f837c291",
      "text": "很抱歉我的氣色看起來還是不太好，在這地方他們根本不給 ",
      "encoded_ascii": "^*K^,@^,h^$%^&Z^%U^'s^*Q^.(^!O^.7^,X^!)^+f^+i^*A^\"d^(s^\"e^$]^!@^*{^%)^$x^!)^'A ",
      "encoded_base64": "XipLXixAXixoXiQlXiZaXiVVXidzXipRXi4oXiFPXi43XixYXiEpXitmXitpXipBXiJkXihzXiJlXiRdXiFAXip7XiUpXiR4XiEpXidBIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_12b6888d5a4d",
      "text": "你多少梳洗清理的機會。",
      "encoded_ascii": "^*F^\"x^#<^>C^0j^,u^&A^&Z^%>^$r^!\"",
      "encoded_base64": "XipGXiJ4XiM8Xj5DXjBqXix1XiZBXiZaXiU+XiRyXiEi",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_1d510e2b8633",
      "text": "我還以為你們早就逃出去了！我想不出你們找我有什麼 ",
      "encoded_ascii": "^$%^.7^!B^%{^*F^*{^,V^*J^(p^!q^\"6^*D^*W^$%^,1^!)^!q^*F^*{^$/^$%^$s^!=^.T ",
      "encoded_base64": "XiQlXi43XiFCXiV7XipGXip7XixWXipKXihwXiFxXiI2XipEXipXXiQlXiwxXiEpXiFxXipGXip7XiQvXiQlXiRzXiE9Xi5UIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_c29ca09fb2e2",
      "text": "指教。 ",
      "encoded_ascii": "^$8^,R^!\" ",
      "encoded_base64": "XiQ4XixSXiEiIA==",
      "byte_length": 10
    },
    {
      "unit_id": "DLG_3633d0427d12",
      "text": "  我們來談談越獄吧。",
      "encoded_ascii": "  ^$%^*{^!O^0;^0;^(]^3Q^*I^!\"",
      "encoded_base64": "ICBeJCVeKnteIU9eMDteMDteKF1eM1FeKkleISI=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_7d559e67fbb7",
      "text": "  你的這位庇護者是誰？",
      "encoded_ascii": "  ^*F^&Z^(s^!J^,\"^(T^'V^,X^-y^.V",
      "encoded_base64": "ICBeKkZeJlpeKHNeIUpeLCJeKFReJ1ZeLFheLXleLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_39eb8971f26f",
      "text": "  我必須多了解一下這位庇護者的事。",
      "encoded_ascii": "  ^$%^#l^)r^\"x^*D^(I^!%^!(^(s^!J^,\"^(T^'V^&Z^*r^!\"",
      "encoded_base64": "ICBeJCVeI2xeKXJeInheKkReKEleISVeISheKHNeIUpeLCJeKFReJ1ZeJlpeKnJeISI=",
      "byte_length": 50
    },
    {
      "unit_id": "DLG_445882f3ce1a",
      "text": "  為什麼你的家族會被解散？",
      "encoded_ascii": "  ^%{^!=^.T^*F^&Z^+s^5V^$r^(@^(I^$S^.V",
      "encoded_base64": "ICBeJXteIT1eLlReKkZeJlpeK3NeNVZeJHJeKEBeKEleJFNeLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_7ac47b865b5f",
      "text": "  你能幫我嗎？",
      "encoded_ascii": "  ^*F^'b^+}^$%^+X^.V",
      "encoded_base64": "ICBeKkZeJ2JeK31eJCVeK1heLlY=",
      "byte_length": 20
    },
    {
      "unit_id": "DLG_df8ff2989d3c",
      "text": "  我該怎麼弄到錢？ ",
      "encoded_ascii": "  ^$%^(M^,,^.T^/`^!u^.<^.V ",
      "encoded_base64": "ICBeJCVeKE1eLCxeLlReL2BeIXVeLjxeLlYg",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_6282d9dc288a",
      "text": "  我拿到寶石了。 ",
      "encoded_ascii": "  ^$%^,G^!u^#4^&k^*D^!\" ",
      "encoded_base64": "ICBeJCVeLEdeIXVeIzReJmteKkReISIg",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_c69727d888f3",
      "text": "  那顆寶石在哪裡？ ",
      "encoded_ascii": "  ^)!^)u^#4^&k^\"d^+I^-j^.V ",
      "encoded_base64": "ICBeKSFeKXVeIzReJmteImReK0leLWpeLlYg",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_8d7b9583d53f",
      "text": "  我還沒拿到寶石。",
      "encoded_ascii": "  ^$%^.7^%\\^,G^!u^#4^&k^!\"",
      "encoded_base64": "ICBeJCVeLjdeJVxeLEdeIXVeIzReJmteISI=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_448dda563de8",
      "text": "  你不一起來嗎？",
      "encoded_ascii": "  ^*F^!)^!%^.(^!O^+X^.V",
      "encoded_base64": "ICBeKkZeISleISVeLiheIU9eK1heLlY=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_7971bd4d32a6",
      "text": "  你得跟我一起走！ ",
      "encoded_ascii": "  ^*F^#e^.+^$%^!%^.(^.&^*W ",
      "encoded_base64": "ICBeKkZeI2VeLiteJCVeISVeLiheLiZeKlcg",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_360865a836d7",
      "text": "  沒門！你必須跟我一起走。",
      "encoded_ascii": "  ^%\\^)D^*W^*F^#l^)r^.+^$%^!%^.(^.&^!\"",
      "encoded_base64": "ICBeJVxeKUReKldeKkZeI2xeKXJeLiteJCVeISVeLiheLiZeISI=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_a10130fb8c20",
      "text": "  我要怎麼去那裡？ ",
      "encoded_ascii": "  ^$%^(C^,,^.T^\"6^)!^-j^.V ",
      "encoded_base64": "ICBeJCVeKENeLCxeLlReIjZeKSFeLWpeLlYg",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_fbba01218eca",
      "text": "  你能重複一下剛才的方向指引嗎？",
      "encoded_ascii": "  ^*F^'b^))^6s^!%^!(^+0^$,^&Z^$]^+?^$8^#Z^+X^.V",
      "encoded_base64": "ICBeKkZeJ2JeKSleNnNeISVeISheKzBeJCxeJlpeJF1eKz9eJDheI1peK1heLlY=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_bb15fb880299",
      "text": "抱歉，走錯牢房了。",
      "encoded_ascii": "^,@^,h^*A^.&^)5^-$^,<^*D^!\"",
      "encoded_base64": "XixAXixoXipBXi4mXik1Xi0kXiw8XipEXiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_ad56153102bf",
      "text": "成交！我很快就回來。 ",
      "encoded_ascii": "^$$^0P^*W^$%^*K^*L^*J^\"\\^!O^!\" ",
      "encoded_base64": "XiQkXjBQXipXXiQlXipLXipMXipKXiJcXiFPXiEiIA==",
      "byte_length": 31
    },
    {
      "unit_id": "DLG_e32e9506b48b",
      "text": "我沒什麼好談的了。告辭。",
      "encoded_ascii": "^$%^%\\^!=^.T^+i^0;^&Z^*D^!\"^+B^2M^!\"",
      "encoded_base64": "XiQlXiVcXiE9Xi5UXitpXjA7XiZaXipEXiEiXitCXjJNXiEi",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_ca371713d158",
      "text": "去敲大門，告訴庫爾扎克是我叫你去的。 ",
      "encoded_ascii": "^\"6^1A^\"z^)D^*A^+B^-t^,#^&/^,=^!d^,X^$%^+<^*F^\"6^&Z^!\" ",
      "encoded_base64": "XiI2XjFBXiJ6XilEXipBXitCXi10XiwjXiYvXiw9XiFkXixYXiQlXis8XipGXiI2XiZaXiEiIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_dbfe3e67dcab",
      "text": " 耐心點！庫爾扎克正在開門。 ",
      "encoded_ascii": " ^-S^#k^*;^*W^,#^&/^,=^!d^%H^\"d^)F^)D^!\" ",
      "encoded_base64": "IF4tU14ja14qO14qV14sI14mL14sPV4hZF4lSF4iZF4pRl4pRF4hIiA=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_73b6de40ecf5",
      "text": "跟著我就行了。 ",
      "encoded_ascii": "^.+^-a^$%^*J^(;^*D^!\" ",
      "encoded_base64": "Xi4rXi1hXiQlXipKXig7XipEXiEiIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_83f3d4d2c977",
      "text": "相信聖堂武士長！他是朋友。 ",
      "encoded_ascii": "^&a^!U^'Z^42^%J^+a^)C^*W^!@^,X^,[^\"8^!\" ",
      "encoded_base64": "XiZhXiFVXidaXjQyXiVKXithXilDXipXXiFAXixYXixbXiI4XiEiIA==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_91ad44a4a904",
      "text": "這有點麻煩了。我要先回我的牢房去。 ",
      "encoded_ascii": "^(s^$s^*;^*6^-!^*D^!\"^$%^(C^!b^\"\\^$%^&Z^-$^,<^\"6^!\" ",
      "encoded_base64": "XihzXiRzXio7Xio2Xi0hXipEXiEiXiQlXihDXiFiXiJcXiQlXiZaXi0kXiw8XiI2XiEiIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_720462f3b7bb",
      "text": "別擔心，你幹得很好！ ",
      "encoded_ascii": "^*H^*N^#k^*A^*F^,!^#e^*K^+i^*W ",
      "encoded_base64": "XipIXipOXiNrXipBXipGXiwhXiNlXipLXitpXipXIA==",
      "byte_length": 31
    },
    {
      "unit_id": "DLG_f91cebac17c6",
      "text": "這是我的榮幸， ",
      "encoded_ascii": "^(s^,X^$%^&Z^,e^15^*A ",
      "encoded_base64": "XihzXixYXiQlXiZaXixlXjE1XipBIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_568c5221c343",
      "text": "別著急。你遲早會找到它的。 ",
      "encoded_ascii": "^*H^-a^3p^!\"^*F^.5^,V^$r^$/^!u^+o^&Z^!\" ",
      "encoded_base64": "XipIXi1hXjNwXiEiXipGXi41XixWXiRyXiQvXiF1XitvXiZaXiEiIA==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_8fc9f6390455",
      "text": "你們最好快點。競技場的戰鬥很快就會變得困難得多。",
      "encoded_ascii": "^*F^*{^$q^+i^*L^*;^!\"^-?^,>^\"n^&Z^$(^*,^*K^*L^*J^$r^(U^#e^\"^^)a^#e^\"x^!\"",
      "encoded_base64": "XipGXip7XiRxXitpXipMXio7XiEiXi0/Xiw+XiJuXiZaXiQoXiosXipLXipMXipKXiRyXihVXiNlXiJeXilhXiNlXiJ4XiEi",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_d44a87d059cb",
      "text": "越獄？我確實考慮過，但光憑我一個人並沒有多大成功的 ",
      "encoded_ascii": "^(]^3Q^.V^$%^-6^#3^-R^19^(x^*A^!I^!c^,5^$%^!%^!V^!<^!+^%\\^$s^\"x^\"z^$$^\"!^&Z ",
      "encoded_base64": "XihdXjNRXi5WXiQlXi02XiMzXi1SXjE5Xih4XipBXiFJXiFjXiw1XiQlXiElXiFWXiE8XiErXiVcXiRzXiJ4XiJ6XiQkXiIhXiZaIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_9e2dc05e7be3",
      "text": "機會。如果我們聯手，肯定能辦得到！我受夠了這個鬼地方。 ",
      "encoded_ascii": "^%>^$r^!\"^#$^%!^$%^*{^-V^$+^*A^-Z^#.^'b^2L^#e^!u^*W^$%^\";^+d^*D^(s^!V^*-^\"e^$]^!\" ",
      "encoded_base64": "XiU+XiRyXiEiXiMkXiUhXiQlXip7Xi1WXiQrXipBXi1aXiMuXidiXjJMXiNlXiF1XipXXiQlXiI7XitkXipEXihzXiFWXiotXiJlXiRdXiEiIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_b5c22149588f",
      "text": "不過，首先我們得弄到錢。 ",
      "encoded_ascii": "^!)^(x^*A^)~^!b^$%^*{^#e^/`^!u^.<^!\" ",
      "encoded_base64": "XiEpXih4XipBXil+XiFiXiQlXip7XiNlXi9gXiF1Xi48XiEiIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_603a70aea4b9",
      "text": " 順便說一句，我的名字叫米爾隆。 ",
      "encoded_ascii": " ^.D^!R^-x^!%^2]^*A^$%^&Z^\"F^#)^+<^'4^&/^)T^!\" ",
      "encoded_base64": "IF4uRF4hUl4teF4hJV4yXV4qQV4kJV4mWl4iRl4jKV4rPF4nNF4mL14pVF4hIiA=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_728d8c64cbc5",
      "text": "那是個爛主意。我可不想摻和。任何企圖越獄的人 ",
      "encoded_ascii": "^)!^,X^!V^&-^!-^#z^!\"^$%^\"A^!)^,1^>B^\"O^!\"^!C^!L^4-^\"b^(]^3Q^&Z^!< ",
      "encoded_base64": "XikhXixYXiFWXiYtXiEtXiN6XiEiXiQlXiJBXiEpXiwxXj5CXiJPXiEiXiFDXiFMXjQtXiJiXihdXjNRXiZaXiE8IA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_dcf77a07eab4",
      "text": "都會被處決。我留在競技場的生存機會還大一些。 ",
      "encoded_ascii": "^)$^$r^(@^(,^,o^!\"^$%^-+^\"d^-?^,>^\"n^&Z^&F^#*^%>^$r^.7^\"z^!%^!8^!\" ",
      "encoded_base64": "XikkXiRyXihAXigsXixvXiEiXiQlXi0rXiJkXi0/Xiw+XiJuXiZaXiZGXiMqXiU+XiRyXi43XiJ6XiElXiE4XiEiIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_4218a07ca10a",
      "text": "我不能說。要是他的身分曝光，他會失去很多—— ",
      "encoded_ascii": "^$%^!)^'b^-x^!\"^(C^,X^!@^&Z^(c^!s^/o^!c^*A^!@^$r^\"|^\"6^*K^\"x^*n^*n ",
      "encoded_base64": "XiQlXiEpXidiXi14XiEiXihDXixYXiFAXiZaXihjXiFzXi9vXiFjXipBXiFAXiRyXiJ8XiI2XipLXiJ4XipuXipuIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_3a84f1e67983",
      "text": "很可能連性命都不保！",
      "encoded_ascii": "^*K^\"A^'b^.0^#r^\"N^)$^!)^!T^*W",
      "encoded_base64": "XipLXiJBXidiXi4wXiNyXiJOXikkXiEpXiFUXipX",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_102ff66a3981",
      "text": "我可以告訴你一些，但我希望你嘴巴夠緊別到處宣揚。我以前 ",
      "encoded_ascii": "^$%^\"A^!B^+B^-t^*F^!%^!8^*A^!I^$%^+{^,]^*F^+[^#K^+d^0r^*H^!u^(,^2d^2k^!\"^$%^!B^!z ",
      "encoded_base64": "XiQlXiJBXiFCXitCXi10XipGXiElXiE4XipBXiFJXiQlXit7XixdXipGXitbXiNLXitkXjByXipIXiF1XigsXjJkXjJrXiEiXiQlXiFCXiF6IA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_9135c2c6e9a0",
      "text": "並不總是奴隸。我的家族曾是貴族，直到泰克圖克提特萊下令強行 ",
      "encoded_ascii": "^!+^!)^-M^,X^##^)Z^!\"^$%^&Z^+s^5V^.j^,X^2F^5V^*A^&`^!u^%f^!d^\"b^!d^$A^&5^(!^!(^*w^#]^(; ",
      "encoded_base64": "XiErXiEpXi1NXixYXiMjXilaXiEiXiQlXiZaXitzXjVWXi5qXixYXjJGXjVWXipBXiZgXiF1XiVmXiFkXiJiXiFkXiRBXiY1XighXiEoXip3XiNdXig7IA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_1f22836243e8",
      "text": "解散我們的氏族。我的庇護者是仍然站在我們這邊的人。 ",
      "encoded_ascii": "^(I^$S^$%^*{^&Z^>D^5V^!\"^$%^&Z^,\"^(T^'V^,X^!?^&\"^->^\"d^$%^*{^(s^.8^&Z^!<^!\" ",
      "encoded_base64": "XihJXiRTXiQlXip7XiZaXj5EXjVWXiEiXiQlXiZaXiwiXihUXidWXixYXiE/XiYiXi0+XiJkXiQlXip7XihzXi44XiZaXiE8XiEiIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_54ea7fe84aa1",
      "text": "就這些了……關於他我不能再多說了！",
      "encoded_ascii": "^*J^(s^!8^*D^*o^*o^.>^$^^!@^$%^!)^'b^!l^\"x^-x^*D^*W",
      "encoded_base64": "XipKXihzXiE4XipEXipvXipvXi4+XiReXiFAXiQlXiEpXidiXiFsXiJ4Xi14XipEXipX",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_a976b00d03b4",
      "text": "我們公開反對聖堂武士的殘暴行徑。 ",
      "encoded_ascii": "^$%^*{^3:^)F^\"9^#:^'Z^42^%J^+a^&Z^,l^$m^(;^#c^!\" ",
      "encoded_base64": "XiQlXip7XjM6XilGXiI5XiM6XidaXjQyXiVKXithXiZaXixsXiRtXig7XiNjXiEiIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_6dfa75969413",
      "text": "我不確定。我有什麼能幫你的？",
      "encoded_ascii": "^$%^!)^-6^#.^!\"^$%^$s^!=^.T^'b^+}^*F^&Z^.V",
      "encoded_base64": "XiQlXiEpXi02XiMuXiEiXiQlXiRzXiE9Xi5UXidiXit9XipGXiZaXi5W",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_a57fe3e73bbd",
      "text": "我很懷疑。我可不太擅長出謀劃策。",
      "encoded_ascii": "^$%^*K^,9^0p^!\"^$%^\"A^!)^+f^2$^)C^!q^3~^4s^5p^!\"",
      "encoded_base64": "XiQlXipLXiw5XjBwXiEiXiQlXiJBXiEpXitmXjIkXilDXiFxXjN+XjRzXjVwXiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_462869859758",
      "text": "嗯，我碰巧知道一顆極其珍貴的寶石下落。 ",
      "encoded_ascii": "^6N^*A^$%^-5^3D^&h^(y^!%^)u^1D^!j^/7^2F^&Z^#4^&k^!(^-`^!\" ",
      "encoded_base64": "XjZOXipBXiQlXi01XjNEXiZoXih5XiElXil1XjFEXiFqXi83XjJGXiZaXiM0XiZrXiEoXi1gXiEiIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_5c3cb21f8ed9",
      "text": "如果你能找到它並帶給我，我就能用來打點適當的賄賂， ",
      "encoded_ascii": "^#$^%!^*F^'b^$/^!u^+o^!+^#N^'A^$%^*A^$%^*J^'b^&H^!O^$-^*;^(|^&N^&Z^61^60^*A ",
      "encoded_base64": "XiMkXiUhXipGXidiXiQvXiF1XitvXiErXiNOXidBXiQlXipBXiQlXipKXidiXiZIXiFPXiQtXio7Xih8XiZOXiZaXjYxXjYwXipBIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_46522137b510",
      "text": "順利安排一場越獄。 ",
      "encoded_ascii": "^.D^!t^+p^$<^!%^\"n^(]^3Q^!\" ",
      "encoded_base64": "Xi5EXiF0XitwXiQ8XiElXiJuXihdXjNRXiEiIA==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_9714fcc599d8",
      "text": "很好，我就收下了。 ",
      "encoded_ascii": "^*K^+i^*A^$%^*J^$M^!(^*D^!\" ",
      "encoded_base64": "XipLXitpXipBXiQlXipKXiRNXiEoXipEXiEiIA==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_2a6d65030f0d",
      "text": "把寶石交給米爾隆？",
      "encoded_ascii": "^$1^#4^&k^0P^'A^'4^&/^)T^.V",
      "encoded_base64": "XiQxXiM0XiZrXjBQXidBXic0XiYvXilUXi5W",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_7bb132728026",
      "text": "太好了，計畫是這樣的。 ",
      "encoded_ascii": "^+f^+i^*D^*A^-n^-,^,X^(s^,f^&Z^!\" ",
      "encoded_base64": "XitmXitpXipEXipBXi1uXi0sXixYXihzXixmXiZaXiEiIA==",
      "byte_length": 34
    },
    {
      "unit_id": "DLG_1c563584d154",
      "text": "我們分頭走會比較妥當。你們現在可以離開了。 ",
      "encoded_ascii": "^$%^*{^!s^)t^.&^$r^,m^(f^5C^&N^!\"^*F^*{^&?^\"d^\"A^!B^)`^)F^*D^!\" ",
      "encoded_base64": "XiQlXip7XiFzXil0Xi4mXiRyXixtXihmXjVDXiZOXiEiXipGXip7XiY/XiJkXiJBXiFCXilgXilGXipEXiEiIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_455aa18091fb",
      "text": "我還以為你說過想逃出去。等你真的考慮清楚認真想逃了， ",
      "encoded_ascii": "^$%^.7^!B^%{^*F^-x^(x^,1^(p^!q^\"6^!\"^'-^*F^-2^&Z^-R^19^,u^,c^(O^-2^,1^(p^*D^*A ",
      "encoded_base64": "XiQlXi43XiFCXiV7XipGXi14Xih4XiwxXihwXiFxXiI2XiEiXictXipGXi0yXiZaXi1SXjE5Xix1XixjXihPXi0yXiwxXihwXipEXipBIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_284a0bf475aa",
      "text": "再來找我吧。 ",
      "encoded_ascii": "^!l^!O^$/^$%^*I^!\" ",
      "encoded_base64": "XiFsXiFPXiQvXiQlXipJXiEiIA==",
      "byte_length": 19
    },
    {
      "unit_id": "DLG_1b46d231ddb8",
      "text": "那顆寶石原屬於一個名叫賽蒙的奴隸——他被鎖在 ",
      "encoded_ascii": "^)!^)u^#4^&k^\"5^#C^$^^!%^!V^\"F^+<^*U^-c^&Z^##^)Z^*n^*n^!@^(@^)8^\"d ",
      "encoded_base64": "XikhXil1XiM0XiZrXiI1XiNDXiReXiElXiFWXiJGXis8XipVXi1jXiZaXiMjXilaXipuXipuXiFAXihAXik4XiJkIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_a39061f5aee4",
      "text": "競技場裡。那東西很可能還在他身上。 ",
      "encoded_ascii": "^-?^,>^\"n^-j^!\"^)!^,`^-l^*K^\"A^'b^.7^\"d^!@^(c^!'^!\" ",
      "encoded_base64": "Xi0/Xiw+XiJuXi1qXiEiXikhXixgXi1sXipLXiJBXidiXi43XiJkXiFAXihjXiEnXiEiIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_9a07808ce4ef",
      "text": "那麼，拿定主意吧！你到底要不要我跟你一起走？！ ",
      "encoded_ascii": "^)!^.T^*A^,G^#.^!-^#z^*I^*W^*F^!u^/^^(C^!)^(C^$%^.+^*F^!%^.(^.&^.V^*W ",
      "encoded_base64": "XikhXi5UXipBXixHXiMuXiEtXiN6XipJXipXXipGXiF1Xi9eXihDXiEpXihDXiQlXi4rXipGXiElXi4oXi4mXi5WXipXIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_fa687b7791d8",
      "text": "不，現在還不行。我還有一些瑣事得處理妥當。你們應該現在就 ",
      "encoded_ascii": "^!)^*A^&?^\"d^.7^!)^(;^!\"^$%^.7^$s^!%^!8^9_^*r^#e^(,^&A^5C^&N^!\"^*F^*{^0`^(M^&?^\"d^*J ",
      "encoded_base64": "XiEpXipBXiY/XiJkXi43XiEpXig7XiEiXiQlXi43XiRzXiElXiE4XjlfXipyXiNlXigsXiZBXjVDXiZOXiEiXipGXip7XjBgXihNXiY/XiJkXipKIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_88703c107248",
      "text": "動身。 ",
      "encoded_ascii": "^\"%^(c^!\" ",
      "encoded_base64": "XiIlXihjXiEiIA==",
      "byte_length": 10
    },
    {
      "unit_id": "DLG_7ff4830a7fd4",
      "text": "好吧，我會跟著你走過庫爾扎克身邊，然後由我在前面帶路。 ",
      "encoded_ascii": "^+i^*I^*A^$%^$r^.+^-a^*F^.&^(x^,#^&/^,=^!d^(c^.8^*A^&\"^#b^&I^$%^\"d^!z^)j^#N^(a^!\" ",
      "encoded_base64": "XitpXipJXipBXiQlXiRyXi4rXi1hXipGXi4mXih4XiwjXiYvXiw9XiFkXihjXi44XipBXiYiXiNiXiZJXiQlXiJkXiF6XilqXiNOXihhXiEiIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_3e7fd5bf1301",
      "text": "照著這個做： ",
      "encoded_ascii": "^/x^-a^(s^!V^*~^*B ",
      "encoded_base64": "Xi94Xi1hXihzXiFWXip+XipCIA==",
      "byte_length": 19
    },
    {
      "unit_id": "DLG_748104d8ff3a",
      "text": "沒問題。 ",
      "encoded_ascii": "^%\\^*Z^.G^!\" ",
      "encoded_base64": "XiVcXipaXi5HXiEiIA==",
      "byte_length": 13
    },
    {
      "unit_id": "DLG_5a7f6bd5e079",
      "text": "走到大門 ",
      "encoded_ascii": "^.&^!u^\"z^)D ",
      "encoded_base64": "Xi4mXiF1XiJ6XilEIA==",
      "byte_length": 13
    },
    {
      "unit_id": "DLG_99a101e82691",
      "text": "那裡，告訴庫爾扎克是我叫你去的。穿過西邊的門，然後 ",
      "encoded_ascii": "^)!^-j^*A^+B^-t^,#^&/^,=^!d^,X^$%^+<^*F^\"6^&Z^!\"^')^(x^-l^.8^&Z^)D^*A^&\"^#b ",
      "encoded_base64": "XikhXi1qXipBXitCXi10XiwjXiYvXiw9XiFkXixYXiQlXis8XipGXiI2XiZaXiEiXicpXih4Xi1sXi44XiZaXilEXipBXiYiXiNiIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_67f62f71aeba",
      "text": "往南轉。沿著主通道走，接著向西轉，再往南轉。 ",
      "encoded_ascii": "^,)^\"/^(i^!\"^%`^-a^!-^(t^(y^.&^*A^$?^-a^+?^-l^(i^*A^!l^,)^\"/^(i^!\" ",
      "encoded_base64": "XiwpXiIvXihpXiEiXiVgXi1hXiEtXih0Xih5Xi4mXipBXiQ/Xi1hXis/Xi1sXihpXipBXiFsXiwpXiIvXihpXiEiIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_46bcea3f3888",
      "text": "走到通道盡頭往西轉。我們的庇護者會在那裡等著。 ",
      "encoded_ascii": "^.&^!u^(t^(y^-1^)t^,)^-l^(i^!\"^$%^*{^&Z^,\"^(T^'V^$r^\"d^)!^-j^'-^-a^!\" ",
      "encoded_base64": "Xi4mXiF1Xih0Xih5Xi0xXil0XiwpXi1sXihpXiEiXiQlXip7XiZaXiwiXihUXidWXiRyXiJkXikhXi1qXictXi1hXiEiIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_d99c78720c77",
      "text": "噢！沒造成什麼傷害。",
      "encoded_ascii": "^+]^*W^%\\^(v^$$^!=^.T^!^^#/^!\"",
      "encoded_base64": "XitdXipXXiVcXih2XiQkXiE9Xi5UXiFeXiMvXiEi",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_f49f9fb65422",
      "text": "祝你好運！ ",
      "encoded_ascii": "^&v^*F^+i^.4^*W ",
      "encoded_base64": "XiZ2XipGXitpXi40XipXIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_f00cb10f6753",
      "text": "很遺憾你這麼想。 ",
      "encoded_ascii": "^*K^0v^0_^*F^(s^.T^,1^!\" ",
      "encoded_base64": "XipLXjB2XjBfXipGXihzXi5UXiwxXiEiIA==",
      "byte_length": 25
    },
    {
      "unit_id": "DLG_b728116cc06b",
      "text": "聖堂武士……人不見了！這太可怕了！我現在該怎麼辦？ ",
      "encoded_ascii": "^'Z^42^%J^+a^*o^*o^!<^!)^-m^*D^*W^(s^+f^\"A^0^^*D^*W^$%^&?^\"d^(M^,,^.T^2L^.V ",
      "encoded_base64": "XidaXjQyXiVKXithXipvXipvXiE8XiEpXi1tXipEXipXXihzXitmXiJBXjBeXipEXipXXiQlXiY/XiJkXihNXiwsXi5UXjJMXi5WIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_180bedbbdf7c",
      "text": "那個康克蟲養的雜種還欠我 500 枚陶幣，因為我給你們設套……呃，我是說， ",
      "encoded_ascii": "^)!^!V^5N^!d^(8^.I^&Z^0G^'$^.7^,g^$% 500 ^$~^)R^+|^*A^\"]^%{^$%^'A^*F^*{^4e^#!^*o^*o^3<^*A^$%^,X^-x^*A ",
      "encoded_base64": "XikhXiFWXjVOXiFkXig4Xi5JXiZaXjBHXickXi43XixnXiQlIDUwMCBeJH5eKVJeK3xeKkFeIl1eJXteJCVeJ0FeKkZeKnteNGVeIyFeKm9eKm9eMzxeKkFeJCVeLFheLXheKkEg",
      "byte_length": 102
    },
    {
      "unit_id": "DLG_14b4e3de4231",
      "text": "也就是說，是在我們小時候我救了他一命的報酬。對，沒錯。就是救了他的命。 ",
      "encoded_ascii": "^!1^*J^,X^-x^*A^,X^\"d^$%^*{^#;^$f^*|^$%^,Q^*D^!@^!%^\"N^&Z^+`^7o^!\"^#:^*A^%\\^)5^!\"^*J^,X^,Q^*D^!@^&Z^\"N^!\" ",
      "encoded_base64": "XiExXipKXixYXi14XipBXixYXiJkXiQlXip7XiM7XiRmXip8XiQlXixRXipEXiFAXiElXiJOXiZaXitgXjdvXiEiXiM6XipBXiVcXik1XiEiXipKXixYXixRXipEXiFAXiZaXiJOXiEiIA==",
      "byte_length": 106
    },
    {
      "unit_id": "DLG_d67f7ca544a4",
      "text": "繼續前進，前面路還長著呢。 ",
      "encoded_ascii": "^-O^'M^!z^(w^*A^!z^)j^(a^.7^)C^-a^+C^!\" ",
      "encoded_base64": "Xi1PXidNXiF6Xih3XipBXiF6XilqXihhXi43XilDXi1hXitDXiEiIA==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_03b0e3fd86bc",
      "text": "就在這條走廊下面。然後我們左轉。 ",
      "encoded_ascii": "^*J^\"d^(s^%.^.&^,$^!(^)j^!\"^&\"^#b^$%^*{^;w^(i^!\" ",
      "encoded_base64": "XipKXiJkXihzXiUuXi4mXiwkXiEoXilqXiEiXiYiXiNiXiQlXip7Xjt3XihpXiEiIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_961beb51fab1",
      "text": "就在這邊——不遠了。 ",
      "encoded_ascii": "^*J^\"d^(s^.8^*n^*n^!)^({^*D^!\" ",
      "encoded_base64": "XipKXiJkXihzXi44XipuXipuXiEpXih7XipEXiEiIA==",
      "byte_length": 31
    },
    {
      "unit_id": "DLG_f03f7c20743a",
      "text": "你們其實並不需要我的幫助——不過我能理解你們的顧慮。 ",
      "encoded_ascii": "^*F^*{^!j^#3^!+^!)^)e^(C^$%^&Z^+}^\"#^*n^*n^!)^(x^$%^'b^&A^(I^*F^*{^&Z^4n^19^!\" ",
      "encoded_base64": "XipGXip7XiFqXiMzXiErXiEpXillXihDXiQlXiZaXit9XiIjXipuXipuXiEpXih4XiQlXidiXiZBXihJXipGXip7XiZaXjRuXjE5XiEiIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_9fe966bb2323",
      "text": "我們很快就到了。 ",
      "encoded_ascii": "^$%^*{^*K^*L^*J^!u^*D^!\" ",
      "encoded_base64": "XiQlXip7XipLXipMXipKXiF1XipEXiEiIA==",
      "byte_length": 25
    },
    {
      "unit_id": "DLG_56c189188785",
      "text": "就在這個房間裡。 ",
      "encoded_ascii": "^*J^\"d^(s^!V^,<^)G^-j^!\" ",
      "encoded_base64": "XipKXiJkXihzXiFWXiw8XilHXi1qXiEiIA==",
      "byte_length": 25
    },
    {
      "unit_id": "DLG_1d8753609e5e",
      "text": "我們這就逃出去！",
      "encoded_ascii": "^$%^*{^(s^*J^(p^!q^\"6^*W",
      "encoded_base64": "XiQlXip7XihzXipKXihwXiFxXiI2XipX",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_0ad92a590b23",
      "text": "快動起來！趕到西北邊的鐵柵欄那裡！",
      "encoded_ascii": "^*L^\"%^.(^!O^*W^0u^!u^-l^+6^.8^&Z^)?^%(^%C^)!^-j^*W",
      "encoded_base64": "XipMXiIlXi4oXiFPXipXXjB1XiF1Xi1sXis2Xi44XiZaXik/XiUoXiVDXikhXi1qXipX",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_dc18f944608e",
      "text": "要是你光站在那裡發呆，就永遠也逃不出去了！",
      "encoded_ascii": "^(C^,X^*F^!c^->^\"d^)!^-j^&W^;)^*A^*J^%W^({^!1^(p^!)^!q^\"6^*D^*W",
      "encoded_base64": "XihDXixYXipGXiFjXi0+XiJkXikhXi1qXiZXXjspXipBXipKXiVXXih7XiExXihwXiEpXiFxXiI2XipEXipX",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_ee453563a3f6",
      "text": "我要宰了你。 ",
      "encoded_ascii": "^$%^(C^1w^*D^*F^!\" ",
      "encoded_base64": "XiQlXihDXjF3XipEXipGXiEiIA==",
      "byte_length": 19
    },
    {
      "unit_id": "DLG_4fd8d9a95f6c",
      "text": "去競技場戰鬥吧。相信我，那沒那麼糟糕。 ",
      "encoded_ascii": "^\"6^-?^,>^\"n^$(^*,^*I^!\"^&a^!U^$%^*A^)!^%\\^)!^.T^-E^4\\^!\" ",
      "encoded_base64": "XiI2Xi0/Xiw+XiJuXiQoXiosXipJXiEiXiZhXiFVXiQlXipBXikhXiVcXikhXi5UXi1FXjRcXiEiIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_c11f865d3926",
      "text": "繼續戰鬥——我們幹得漂亮！",
      "encoded_ascii": "^-O^'M^$(^*,^*n^*n^$%^*{^,!^#e^,|^*t^*W",
      "encoded_base64": "Xi1PXidNXiQoXiosXipuXipuXiQlXip7XiwhXiNlXix8Xip0XipX",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_68640d1c790a",
      "text": "我聽說你現在正跟梅爾佐爾聯手——我信不過 ",
      "encoded_ascii": "^$%^-X^-x^*F^&?^\"d^%H^.+^%-^&/^>1^&/^-V^$+^*n^*n^$%^!U^!)^(x ",
      "encoded_base64": "XiQlXi1YXi14XipGXiY/XiJkXiVIXi4rXiUtXiYvXj4xXiYvXi1WXiQrXipuXipuXiQlXiFVXiEpXih4IA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_5c0e2891075b",
      "text": "他，也信不過你。給我滾開。 ",
      "encoded_ascii": "^!@^*A^!1^!U^!)^(x^*F^!\"^'A^$%^,z^)F^!\" ",
      "encoded_base64": "XiFAXipBXiExXiFVXiEpXih4XipGXiEiXidBXiQlXix6XilGXiEiIA==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_247dc7cab033",
      "text": "我們不該被看見聚在一起說話——照著計畫進行就是了！ ",
      "encoded_ascii": "^$%^*{^!)^(M^(@^*Q^-m^'[^\"d^!%^.(^-x^-v^*n^*n^/x^-a^-n^-,^(w^(;^*J^,X^*D^*W ",
      "encoded_base64": "XiQlXip7XiEpXihNXihAXipRXi1tXidbXiJkXiElXi4oXi14Xi12XipuXipuXi94Xi1hXi1uXi0sXih3Xig7XipKXixYXipEXipXIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_583645f520f9",
      "text": "我看過你在競技場上的表現——你確實有兩把刷子。 ",
      "encoded_ascii": "^$%^*Q^(x^*F^\"d^-?^,>^\"n^!'^&Z^-i^&?^*n^*n^*F^-6^#3^$s^!i^$1^>H^#(^!\" ",
      "encoded_base64": "XiQlXipRXih4XipGXiJkXi0/Xiw+XiJuXiEnXiZaXi1pXiY/XipuXipuXipGXi02XiMzXiRzXiFpXiQxXj5IXiMoXiEiIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_6db5b3233285",
      "text": "我能用得上你。",
      "encoded_ascii": "^$%^'b^&H^#e^!'^*F^!\"",
      "encoded_base64": "XiQlXidiXiZIXiNlXiEnXipGXiEi",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_8bc80cfa347b",
      "text": "我不認得你——你肯定是新來的角鬥士吧。 ",
      "encoded_ascii": "^$%^!)^(O^#e^*F^*n^*n^*F^-Z^#.^,X^$\\^!O^&Z^(H^*,^+a^*I^!\" ",
      "encoded_base64": "XiQlXiEpXihPXiNlXipGXipuXipuXipGXi1aXiMuXixYXiRcXiFPXiZaXihIXiosXithXipJXiEiIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_a316e81ffc1f",
      "text": "我是疤面，這些牢欄歸我管。別惹我，就 ",
      "encoded_ascii": "^$%^,X^5g^)j^*A^(s^!8^-$^%C^%K^$%^-D^!\"^*H^3s^$%^*A^*J ",
      "encoded_base64": "XiQlXixYXjVnXilqXipBXihzXiE4Xi0kXiVDXiVLXiQlXi1EXiEiXipIXjNzXiQlXipBXipKIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_976a07eea0d6",
      "text": "不會有任何麻煩，聽懂了嗎？也許等你再去競技場打過兩次之後， ",
      "encoded_ascii": "^!)^$r^$s^!C^!L^*6^-!^*A^-X^,6^*D^+X^.V^!1^-s^'-^*F^!l^\"6^-?^,>^\"n^$-^(x^!i^%D^!/^#b^*A ",
      "encoded_base64": "XiEpXiRyXiRzXiFDXiFMXio2Xi0hXipBXi1YXiw2XipEXitYXi5WXiExXi1zXictXipGXiFsXiI2Xi0/Xiw+XiJuXiQtXih4XiFpXiVEXiEvXiNiXipBIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_6076d5d51bcd",
      "text": "我們再來談談。 ",
      "encoded_ascii": "^$%^*{^!l^!O^0;^0;^!\" ",
      "encoded_base64": "XiQlXip7XiFsXiFPXjA7XjA7XiEiIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_eae3eeb2e8a5",
      "text": "再去打個幾場戰鬥後再回來吧。 ",
      "encoded_ascii": "^!l^\"6^$-^!V^#T^\"n^$(^*,^#b^!l^\"\\^!O^*I^!\" ",
      "encoded_base64": "XiFsXiI2XiQtXiFWXiNUXiJuXiQoXiosXiNiXiFsXiJcXiFPXipJXiEiIA==",
      "byte_length": 43
    },
    {
      "unit_id": "DLG_efc5db6b335f",
      "text": "耐心點。等你在競技場裡再打過幾場對決之後再來找我。 ",
      "encoded_ascii": "^-S^#k^*;^!\"^'-^*F^\"d^-?^,>^\"n^-j^!l^$-^(x^#T^\"n^#:^,o^!/^#b^!l^!O^$/^$%^!\" ",
      "encoded_base64": "Xi1TXiNrXio7XiEiXictXipGXiJkXi0/Xiw+XiJuXi1qXiFsXiQtXih4XiNUXiJuXiM6XixvXiEvXiNiXiFsXiFPXiQvXiQlXiEiIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_9b7870072782",
      "text": "記住——保持移動。 ",
      "encoded_ascii": "^(K^*z^*n^*n^!T^$7^'\"^\"%^!\" ",
      "encoded_base64": "XihLXip6XipuXipuXiFUXiQ3XiciXiIlXiEiIA==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_edc8553b9f2c",
      "text": "  你說的「用得上我」是什麼意思？",
      "encoded_ascii": "  ^*F^-x^&Z^!#^&H^#e^!'^$%^!$^,X^!=^.T^#z^#q^.V",
      "encoded_base64": "ICBeKkZeLXheJlpeISNeJkheI2VeISdeJCVeISReLFheIT1eLlReI3peI3FeLlY=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_16eea8eb5aad",
      "text": "  我是這裡最強悍的。照我說的做！",
      "encoded_ascii": "  ^$%^,X^(s^-j^$q^#]^,-^&Z^!\"^/x^$%^-x^&Z^*~^*W",
      "encoded_base64": "ICBeJCVeLFheKHNeLWpeJHFeI11eLC1eJlpeISJeL3heJCVeLXheJlpeKn5eKlc=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_1fc7798b9e56",
      "text": "  我們一起突襲守衛，一路砍殺出去。",
      "encoded_ascii": "  ^$%^*{^!%^.(^'*^08^#+^(=^*A^!%^(a^&l^%M^!q^\"6^!\"",
      "encoded_base64": "ICBeJCVeKnteISVeLiheJypeMDheIyteKD1eKkFeISVeKGFeJmxeJU1eIXFeIjZeISI=",
      "byte_length": 50
    },
    {
      "unit_id": "DLG_962ff8b35a3d",
      "text": "  我還以為你可能會有什麼主意。",
      "encoded_ascii": "  ^$%^.7^!B^%{^*F^\"A^'b^$r^$s^!=^.T^!-^#z^!\"",
      "encoded_base64": "ICBeJCVeLjdeIUJeJXteKkZeIkFeJ2JeJHJeJHNeIT1eLlReIS1eI3peISI=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_7e6367398711",
      "text": "我們要走了。再見。",
      "encoded_ascii": "^$%^*{^(C^.&^*D^!\"^!l^-m^!\"",
      "encoded_base64": "XiQlXip7XihDXi4mXipEXiEiXiFsXi1tXiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_d456e615f20a",
      "text": "開門見山，嗯？你的計畫是什麼？",
      "encoded_ascii": "^)F^)D^-m^11^*A^6N^.V^*F^&Z^-n^-,^,X^!=^.T^.V",
      "encoded_base64": "XilGXilEXi1tXjExXipBXjZOXi5WXipGXiZaXi1uXi0sXixYXiE9Xi5UXi5W",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_1bfeb24998a7",
      "text": "那就走著瞧吧！",
      "encoded_ascii": "^)!^*J^.&^-a^-4^*I^*W",
      "encoded_base64": "XikhXipKXi4mXi1hXi00XipJXipX",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_da6ed3c2bc2e",
      "text": "疤面和他的幫派成員紛紛把手伸向了武器。 ",
      "encoded_ascii": "^5g^)j^\"O^!@^&Z^+}^.n^$$^+G^7d^7d^$1^$+^/N^+?^*D^%J^\"V^!\" ",
      "encoded_base64": "XjVnXilqXiJPXiFAXiZaXit9Xi5uXiQkXitHXjdkXjdkXiQxXiQrXi9OXis/XipEXiVKXiJWXiEiIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_aa58155977c6",
      "text": "說點什麼嗎？ ",
      "encoded_ascii": "^-x^*;^!=^.T^+X^.V ",
      "encoded_base64": "Xi14Xio7XiE9Xi5UXitYXi5WIA==",
      "byte_length": 19
    },
    {
      "unit_id": "DLG_092143b480d1",
      "text": "  我們應該攜手合作。 ",
      "encoded_ascii": "  ^$%^*{^0`^(M^0e^$+^\"C^!M^!\" ",
      "encoded_base64": "ICBeJCVeKnteMGBeKE1eMGVeJCteIkNeIU1eISIg",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_2c6727bb7a9e",
      "text": "  我不是那個意思。 ",
      "encoded_ascii": "  ^$%^!)^,X^)!^!V^#z^#q^!\" ",
      "encoded_base64": "ICBeJCVeISleLFheKSFeIVZeI3peI3FeISIg",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_fd3d6984d29c",
      "text": "  別逼我宰了你。 ",
      "encoded_ascii": "  ^*H^.1^$%^1w^*D^*F^!\" ",
      "encoded_base64": "ICBeKkheLjFeJCVeMXdeKkReKkZeISIg",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_8b8d2aae5fe0",
      "text": "疤面目光銳利地盯著你看……然後將佩劍收回了鞘中。 ",
      "encoded_ascii": "^5g^)j^&^^!c^;W^!t^\"e^:U^-a^*F^*Q^*o^*o^&\"^#b^#7^.}^!|^$M^\"\\^*D^=~^!,^!\" ",
      "encoded_base64": "XjVnXilqXiZeXiFjXjtXXiF0XiJlXjpVXi1hXipGXipRXipvXipvXiYiXiNiXiM3Xi59XiF8XiRNXiJcXipEXj1+XiEsXiEiIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_a80eeb11c2f4",
      "text": "贊成。 ",
      "encoded_ascii": "^>K^$$^!\" ",
      "encoded_base64": "Xj5LXiQkXiEiIA==",
      "byte_length": 10
    },
    {
      "unit_id": "DLG_ea4a9b6ff95e",
      "text": "別惹我發笑！ ",
      "encoded_ascii": "^*H^3s^$%^&W^-@^*W ",
      "encoded_base64": "XipIXjNzXiQlXiZXXi1AXipXIA==",
      "byte_length": 19
    },
    {
      "unit_id": "DLG_17a7eac60f8d",
      "text": "就憑那樣？要是你夠硬朗而且守衛全在打瞌睡的話， ",
      "encoded_ascii": "^*J^,5^)!^,f^.V^(C^,X^*F^+d^25^$t^'W^!*^#+^(=^!h^\"d^$-^=<^-3^&Z^-v^*A ",
      "encoded_base64": "XipKXiw1XikhXixmXi5WXihDXixYXipGXitkXjI1XiR0XidXXiEqXiMrXig9XiFoXiJkXiQtXj08Xi0zXiZaXi12XipBIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_03af81f0ee74",
      "text": "你或許還真能跑出一小段路。不過我可沒興趣奉陪。 ",
      "encoded_ascii": "^*F^$'^-s^.7^-2^'b^(_^!q^!%^#;^.l^(a^!\"^!)^(x^$%^\"A^%\\^-]^.*^1+^8.^!\" ",
      "encoded_base64": "XipGXiQnXi1zXi43Xi0yXidiXihfXiFxXiElXiM7Xi5sXihhXiEiXiEpXih4XiQlXiJBXiVcXi1dXi4qXjErXjguXiEiIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_bcaaf554a527",
      "text": "所以你想逃離這裡，卻又想不出任何辦法，就像這裡的其他所有人 ",
      "encoded_ascii": "^$)^!B^*F^,1^(p^)`^(s^-j^*A^1&^+;^,1^!)^!q^!C^!L^2L^%b^*A^*J^!`^(s^-j^&Z^!j^!@^$)^$s^!< ",
      "encoded_base64": "XiQpXiFCXipGXiwxXihwXilgXihzXi1qXipBXjEmXis7XiwxXiEpXiFxXiFDXiFMXjJMXiViXipBXipKXiFgXihzXi1qXiZaXiFqXiFAXiQpXiRzXiE8IA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_1eb02be61523",
      "text": "一樣。等你在競技場多打幾場之後再回來吧。 ",
      "encoded_ascii": "^!%^,f^!\"^'-^*F^\"d^-?^,>^\"n^\"x^$-^#T^\"n^!/^#b^!l^\"\\^!O^*I^!\" ",
      "encoded_base64": "XiElXixmXiEiXictXipGXiJkXi0/Xiw+XiJuXiJ4XiQtXiNUXiJuXiEvXiNiXiFsXiJcXiFPXipJXiEiIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_372cfb57d8b5",
      "text": "我有個計畫。 ",
      "encoded_ascii": "^$%^$s^!V^-n^-,^!\" ",
      "encoded_base64": "XiQlXiRzXiFWXi1uXi0sXiEiIA==",
      "byte_length": 19
    },
    {
      "unit_id": "DLG_34d20753675a",
      "text": "聽著。我可以安排我們在競技場裡互為對手交戰。 ",
      "encoded_ascii": "^-X^-a^!\"^$%^\"A^!B^+p^$<^$%^*{^\"d^-?^,>^\"n^-j^*s^%{^#:^$+^0P^$(^!\" ",
      "encoded_base64": "Xi1YXi1hXiEiXiQlXiJBXiFCXitwXiQ8XiQlXip7XiJkXi0/Xiw+XiJuXi1qXipzXiV7XiM6XiQrXjBQXiQoXiEiIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_8e22fb1f4b3f",
      "text": "我知道怎麼從西門逃出去——他們現在不用那道門了，那裡的守備應該 ",
      "encoded_ascii": "^$%^&h^(y^,,^.T^#f^-l^)D^(p^!q^\"6^*n^*n^!@^*{^&?^\"d^!)^&H^)!^(y^)D^*D^*A^)!^-j^&Z^#+^+\"^0`^(M ",
      "encoded_base64": "XiQlXiZoXih5XiwsXi5UXiNmXi1sXilEXihwXiFxXiI2XipuXipuXiFAXip7XiY/XiJkXiEpXiZIXikhXih5XilEXipEXipBXikhXi1qXiZaXiMrXisiXjBgXihNIA==",
      "byte_length": 94
    },
    {
      "unit_id": "DLG_b8730eb1c10e",
      "text": "很薄弱。我們在競技場碰頭，然後一路殺出去！ ",
      "encoded_ascii": "^*K^6o^#\\^!\"^$%^*{^\"d^-?^,>^\"n^-5^)t^*A^&\"^#b^!%^(a^%M^!q^\"6^*W ",
      "encoded_base64": "XipLXjZvXiNcXiEiXiQlXip7XiJkXi0/Xiw+XiJuXi01Xil0XipBXiYiXiNiXiElXihhXiVNXiFxXiI2XipXIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_426c3711994e",
      "text": "  真蠢。",
      "encoded_ascii": "  ^-2^.u^!\"",
      "encoded_base64": "ICBeLTJeLnVeISI=",
      "byte_length": 11
    },
    {
      "unit_id": "DLG_cb2dee280c35",
      "text": "  我喜歡。我們什麼時候開始？",
      "encoded_ascii": "  ^$%^+V^%F^!\"^$%^*{^!=^.T^$f^*|^)F^+k^.V",
      "encoded_base64": "ICBeJCVeK1ZeJUZeISJeJCVeKnteIT1eLlReJGZeKnxeKUZeK2teLlY=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_96aac192e14c",
      "text": "  我們沒什麼好談的了。再見！",
      "encoded_ascii": "  ^$%^*{^%\\^!=^.T^+i^0;^&Z^*D^!\"^!l^-m^*W",
      "encoded_base64": "ICBeJCVeKnteJVxeIT1eLlReK2leMDteJlpeKkReISJeIWxeLW1eKlc=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_235cd79726b7",
      "text": "  我得考慮一下。",
      "encoded_ascii": "  ^$%^#e^-R^19^!%^!(^!\"",
      "encoded_base64": "ICBeJCVeI2VeLVJeMTleISVeISheISI=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_da703ba606a5",
      "text": "聽著，小鬼們，建造這鬼地方就是為了防止越獄。要是你們想在牢欄裡硬闖 ",
      "encoded_ascii": "^-X^-a^*A^#;^*-^*{^*A^,'^(v^(s^*-^\"e^$]^*J^,X^%{^*D^)K^%G^(]^3Q^!\"^(C^,X^*F^*{^,1^\"d^-$^%C^-j^25^.z ",
      "encoded_base64": "Xi1YXi1hXipBXiM7XiotXip7XipBXiwnXih2XihzXiotXiJlXiRdXipKXixYXiV7XipEXilLXiVHXihdXjNRXiEiXihDXixYXipGXip7XiwxXiJkXi0kXiVDXi1qXjI1Xi56IA==",
      "byte_length": 100
    },
    {
      "unit_id": "DLG_cf0583c7996f",
      "text": "對付守衛，你們會被剁成碎肉的。 ",
      "encoded_ascii": "^#:^*u^#+^(=^*A^*F^*{^$r^(@^=G^$$^&o^'^^&Z^!\" ",
      "encoded_base64": "XiM6Xip1XiMrXig9XipBXipGXip7XiRyXihAXj1HXiQkXiZvXideXiZaXiEiIA==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_b64496a3277f",
      "text": "你到底同不同意這個計畫？",
      "encoded_ascii": "^*F^!u^/^^\"E^!)^\"E^#z^(s^!V^-n^-,^.V",
      "encoded_base64": "XipGXiF1Xi9eXiJFXiEpXiJFXiN6XihzXiFWXi1uXi0sXi5W",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_ba48409d5230",
      "text": "  這依然是個蠢主意。",
      "encoded_ascii": "  ^(s^!Q^&\"^,X^!V^.u^!-^#z^!\"",
      "encoded_base64": "ICBeKHNeIVFeJiJeLFheIVZeLnVeIS1eI3peISI=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_22a26df10819",
      "text": "  好吧，我照你的方式做。",
      "encoded_ascii": "  ^+i^*I^*A^$%^/x^*F^&Z^$]^#X^*~^!\"",
      "encoded_base64": "ICBeK2leKkleKkFeJCVeL3heKkZeJlpeJF1eI1heKn5eISI=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_64f78fd26c71",
      "text": "  你滾一邊去，滿嘴康克臭氣的傢伙。我自己一個人逃。",
      "encoded_ascii": "  ^*F^,z^!%^.8^\"6^*A^,{^+[^5N^!d^'m^%U^&Z^+#^*y^!\"^$%^'l^#I^!%^!V^!<^(p^!\"",
      "encoded_base64": "ICBeKkZeLHpeISVeLjheIjZeKkFeLHteK1teNU5eIWReJ21eJVVeJlpeKyNeKnleISJeJCVeJ2xeI0leISVeIVZeITxeKHBeISI=",
      "byte_length": 74
    },
    {
      "unit_id": "DLG_45beacb9ec90",
      "text": "我會在你們的屍體前放聲大笑。給我滾出去！",
      "encoded_ascii": "^$%^$r^\"d^*F^*{^&Z^#?^**^!z^$P^-W^\"z^-@^!\"^'A^$%^,z^!q^\"6^*W",
      "encoded_base64": "XiQlXiRyXiJkXipGXip7XiZaXiM/XioqXiF6XiRQXi1XXiJ6Xi1AXiEiXidBXiQlXix6XiFxXiI2XipX",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_a9c89f07683a",
      "text": "很好。就像個稱職的角鬥士那樣繼續在競技場裡戰鬥吧， ",
      "encoded_ascii": "^*K^+i^!\"^*J^!`^!V^0&^'\\^&Z^(H^*,^+a^)!^,f^-O^'M^\"d^-?^,>^\"n^-j^$(^*,^*I^*A ",
      "encoded_base64": "XipLXitpXiEiXipKXiFgXiFWXjAmXidcXiZaXihIXiosXithXikhXixmXi1PXidNXiJkXi0/Xiw+XiJuXi1qXiQoXiosXipJXipBIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_2b9980fad005",
      "text": "等你看見我們的時候，就做好往西門狂奔的準備！ ",
      "encoded_ascii": "^'-^*F^*Q^-m^$%^*{^&Z^$f^*|^*A^*J^*~^+i^,)^-l^)D^&8^2b^&Z^,x^+\"^*W ",
      "encoded_base64": "XictXipGXipRXi1tXiQlXip7XiZaXiRmXip8XipBXipKXip+XitpXiwpXi1sXilEXiY4XjJiXiZaXix4XisiXipXIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_d45eb88bd394",
      "text": "慢慢考慮吧。直到我們之中有人死在競技場之前，你都有時間。",
      "encoded_ascii": "^#~^#~^-R^19^*I^!\"^&`^!u^$%^*{^!/^!,^$s^!<^%L^\"d^-?^,>^\"n^!/^!z^*A^*F^)$^$s^$f^)G^!\"",
      "encoded_base64": "XiN+XiN+Xi1SXjE5XipJXiEiXiZgXiF1XiQlXip7XiEvXiEsXiRzXiE8XiVMXiJkXi0/Xiw+XiJuXiEvXiF6XipBXipGXikkXiRzXiRmXilHXiEi",
      "byte_length": 84
    },
    {
      "unit_id": "DLG_380d3da626d2",
      "text": "你們這群膽小的幼崽……別進我的牢房！",
      "encoded_ascii": "^*F^*{^(s^'R^-[^#;^&Z^9@^>I^*o^*o^*H^(w^$%^&Z^-$^,<^*W",
      "encoded_base64": "XipGXip7XihzXidSXi1bXiM7XiZaXjlAXj5JXipvXipvXipIXih3XiQlXiZaXi0kXiw8XipX",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_3c1739f6b628",
      "text": "我們還會再見面的。",
      "encoded_ascii": "^$%^*{^.7^$r^!l^-m^)j^&Z^!\"",
      "encoded_base64": "XiQlXip7Xi43XiRyXiFsXi1tXilqXiZaXiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_667c4e96834e",
      "text": "老大說你們該死，所以我要宰了你們。",
      "encoded_ascii": "^'U^\"z^-x^*F^*{^(M^%L^*A^$)^!B^$%^(C^1w^*D^*F^*{^!\"",
      "encoded_base64": "XidVXiJ6Xi14XipGXip7XihNXiVMXipBXiQpXiFCXiQlXihDXjF3XipEXipGXip7XiEi",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_7c8e389bec58",
      "text": "去跟老大談。他就在大廳對面。",
      "encoded_ascii": "^\"6^.+^'U^\"z^0;^!\"^!@^*J^\"d^\"z^0\\^#:^)j^!\"",
      "encoded_base64": "XiI2Xi4rXidVXiJ6XjA7XiEiXiFAXipKXiJkXiJ6XjBcXiM6XilqXiEi",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_c95d5efcacae",
      "text": "疤面才是你該找的人。他是老大。",
      "encoded_ascii": "^5g^)j^$,^,X^*F^(M^$/^&Z^!<^!\"^!@^,X^'U^\"z^!\"",
      "encoded_base64": "XjVnXilqXiQsXixYXipGXihNXiQvXiZaXiE8XiEiXiFAXixYXidVXiJ6XiEi",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_f8ccbcc1088f",
      "text": "嘿，要是疤面沒吩咐，我們什麼都不會說。",
      "encoded_ascii": "^+\\^*A^(C^,X^5g^)j^%\\^:.^:/^*A^$%^*{^!=^.T^)$^!)^$r^-x^!\"",
      "encoded_base64": "XitcXipBXihDXixYXjVnXilqXiVcXjouXjovXipBXiQlXip7XiE9Xi5UXikkXiEpXiRyXi14XiEi",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_beb1a65ccbb1",
      "text": "既然老大已經死了，我不想跟任何人說話。",
      "encoded_ascii": "^,U^&\"^'U^\"z^#J^'D^%L^*D^*A^$%^!)^,1^.+^!C^!L^!<^-x^-v^!\"",
      "encoded_base64": "XixVXiYiXidVXiJ6XiNKXidEXiVMXipEXipBXiQlXiEpXiwxXi4rXiFDXiFMXiE8Xi14Xi12XiEi",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_7a32de75af2c",
      "text": "向你們信仰的任何神祇祈禱吧——你們的死期已經近了！",
      "encoded_ascii": "^+?^*F^*{^!U^4,^&Z^!C^!L^&w^>J^&u^&|^*I^*n^*n^*F^*{^&Z^%L^$u^#J^'D^(l^*D^*W",
      "encoded_base64": "Xis/XipGXip7XiFVXjQsXiZaXiFDXiFMXiZ3Xj5KXiZ1XiZ8XipJXipuXipuXipGXip7XiZaXiVMXiR1XiNKXidEXihsXipEXipX",
      "byte_length": 75
    },
    {
      "unit_id": "DLG_cf55abe882f3",
      "text": "沒想到你們居然自投羅網！為了查出你們的下落，我把奴隸牢欄裡 ",
      "encoded_ascii": "^%\\^,1^!u^*F^*{^+w^&\"^'l^$3^/?^'G^*W^%{^*D^%&^!q^*F^*{^&Z^!(^-`^*A^$%^$1^##^)Z^-$^%C^-j ",
      "encoded_base64": "XiVcXiwxXiF1XipGXip7Xit3XiYiXidsXiQzXi8/XidHXipXXiV7XipEXiUmXiFxXipGXip7XiZaXiEoXi1gXipBXiQlXiQxXiMjXilaXi0kXiVDXi1qIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_67f2c23bc5a4",
      "text": "的每個奴隸都嚴刑拷打致死，而你們竟然自己跑回來了！ ",
      "encoded_ascii": "^&Z^%P^!V^##^)Z^)$^1*^9|^*b^$-^'o^%L^*A^'W^*F^*{^28^&\"^'l^#I^(_^\"\\^!O^*D^*W ",
      "encoded_base64": "XiZaXiVQXiFWXiMjXilaXikkXjEqXjl8XipiXiQtXidvXiVMXipBXidXXipGXip7XjI4XiYiXidsXiNJXihfXiJcXiFPXipEXipXIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_4696afa81494",
      "text": "你們曾是很值錢的財產——但我絕不能留你們活命。 ",
      "encoded_ascii": "^*F^*{^.j^,X^*K^!Z^.<^&Z^0=^&G^*n^*n^!I^$%^-I^!)^'b^-+^*F^*{^%i^\"N^!\" ",
      "encoded_base64": "XipGXip7Xi5qXixYXipLXiFaXi48XiZaXjA9XiZHXipuXipuXiFJXiQlXi1JXiEpXidiXi0rXipGXip7XiVpXiJOXiEiIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_00a75cef671f",
      "text": "這麼說，你們逃出來了！ ",
      "encoded_ascii": "^(s^.T^-x^*A^*F^*{^(p^!q^!O^*D^*W ",
      "encoded_base64": "XihzXi5UXi14XipBXipGXip7XihwXiFxXiFPXipEXipXIA==",
      "byte_length": 34
    },
    {
      "unit_id": "DLG_0c61ed4811dd",
      "text": "我很欣賞你們的足智多謀和過人身手。 ",
      "encoded_ascii": "^$%^*K^2'^*T^*F^*{^&Z^(^^$i^\"x^3~^\"O^(x^!<^(c^$+^!\" ",
      "encoded_base64": "XiQlXipLXjInXipUXipGXip7XiZaXiheXiRpXiJ4XjN+XiJPXih4XiE8XihjXiQrXiEiIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_10dec73c2062",
      "text": "我準備賜予你們自由，外加四顆治療芭樂。作為回報，你們 ",
      "encoded_ascii": "^$%^,x^+\"^.#^!4^*F^*{^'l^&I^*A^\"w^\"\"^\"[^)u^%_^&U^'v^%8^!\"^!M^%{^\"\\^+`^*A^*F^*{ ",
      "encoded_base64": "XiQlXix4XisiXi4jXiE0XipGXip7XidsXiZJXipBXiJ3XiIiXiJbXil1XiVfXiZVXid2XiU4XiEiXiFNXiV7XiJcXitgXipBXipGXip7IA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_3022eac3c2b1",
      "text": "必須前往主城區的無頭巨人酒館。告訴那裡的酒保， ",
      "encoded_ascii": "^#l^)r^!z^,)^!-^+_^\"+^&Z^%}^)t^#H^!<^6=^>L^!\"^+B^-t^)!^-j^&Z^6=^!T^*A ",
      "encoded_base64": "XiNsXilyXiF6XiwpXiEtXitfXiIrXiZaXiV9Xil0XiNIXiE8XjY9Xj5MXiEiXitCXi10XikhXi1qXiZaXjY9XiFUXipBIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_fbd5822dc316",
      "text": "是「佩圖克爾」派你們去的。我正好用得上像你們這樣的勇士。 ",
      "encoded_ascii": "^,X^!#^.}^\"b^!d^&/^!$^.n^*F^*{^\"6^&Z^!\"^$%^%H^+i^&H^#e^!'^!`^*F^*{^(s^,f^&Z^\"$^+a^!\" ",
      "encoded_base64": "XixYXiEjXi59XiJiXiFkXiYvXiEkXi5uXipGXip7XiI2XiZaXiEiXiQlXiVIXitpXiZIXiNlXiEnXiFgXipGXip7XihzXixmXiZaXiIkXithXiEiIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_21c792921de1",
      "text": "  如果我現在就殺了你呢？",
      "encoded_ascii": "  ^#$^%!^$%^&?^\"d^*J^%M^*D^*F^+C^.V",
      "encoded_base64": "ICBeIyReJSFeJCVeJj9eImReKkpeJU1eKkReKkZeK0NeLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_c08d5891d543",
      "text": "  我接受這項提議。",
      "encoded_ascii": "  ^$%^$?^\";^(s^)q^$A^-|^!\"",
      "encoded_base64": "ICBeJCVeJD9eIjteKHNeKXFeJEFeLXxeISI=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_ba764136f6ea",
      "text": "  多告訴我一些關於這任務的事。",
      "encoded_ascii": "  ^\"x^+B^-t^$%^!%^!8^.>^$^^(s^!C^+4^&Z^*r^!\"",
      "encoded_base64": "ICBeInheK0JeLXReJCVeISVeITheLj5eJF5eKHNeIUNeKzReJlpeKnJeISI=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_5770476fc6ff",
      "text": "  聖堂武士都是人渣！受死吧！",
      "encoded_ascii": "  ^'Z^42^%J^+a^)$^,X^!<^,v^*W^\";^%L^*I^*W",
      "encoded_base64": "ICBeJ1peNDJeJUpeK2FeKSReLFheITxeLHZeKldeIjteJUxeKkleKlc=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_8cf75f7a4c2c",
      "text": "  我不只要這些芭樂。",
      "encoded_ascii": "  ^$%^!)^\"?^(C^(s^!8^'v^%8^!\"",
      "encoded_base64": "ICBeJCVeISleIj9eKENeKHNeITheJ3ZeJTheISI=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_a7c47facc2a4",
      "text": "  我想要更多。",
      "encoded_ascii": "  ^$%^,1^(C^$o^\"x^!\"",
      "encoded_base64": "ICBeJCVeLDFeKENeJG9eInheISI=",
      "byte_length": 20
    },
    {
      "unit_id": "DLG_6ca8dfa5c0f9",
      "text": "  護送我到大門。",
      "encoded_ascii": "  ^(T^./^$%^!u^\"z^)D^!\"",
      "encoded_base64": "ICBeKFReLi9eJCVeIXVeInpeKUReISI=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_ee48de63584e",
      "text": "  我已經付過贖身換取自由的代價了。 ",
      "encoded_ascii": "  ^$%^#J^'D^*u^(x^3-^(c^4@^\":^'l^&I^&Z^*v^+&^*D^!\" ",
      "encoded_base64": "ICBeJCVeI0peJ0ReKnVeKHheMy1eKGNeNEBeIjpeJ2xeJkleJlpeKnZeKyZeKkReISIg",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_900b2ab24770",
      "text": "  我必須考慮一下。",
      "encoded_ascii": "  ^$%^#l^)r^-R^19^!%^!(^!\"",
      "encoded_base64": "ICBeJCVeI2xeKXJeLVJeMTleISVeISheISI=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_6603e26fb2a9",
      "text": "我願意冒這個險。既然你們能走到這一步，說明你們確實有本事。 ",
      "encoded_ascii": "^$%^.H^#z^/P^(s^!V^*m^!\"^,U^&\"^*F^*{^'b^.&^!u^(s^!%^,i^*A^-x^$c^*F^*{^-6^#3^$s^$x^*r^!\" ",
      "encoded_base64": "XiQlXi5IXiN6Xi9QXihzXiFWXiptXiEiXixVXiYiXipGXip7XidiXi4mXiF1XihzXiElXixpXipBXi14XiRjXipGXip7Xi02XiMzXiRzXiR4XipyXiEiIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_2c13f4c4a2fe",
      "text": "我願意給你們一個重新開始的機會。我不叫守衛進來，就是展現我的 ",
      "encoded_ascii": "^$%^.H^#z^'A^*F^*{^!%^!V^))^$\\^)F^+k^&Z^%>^$r^!\"^$%^!)^+<^#+^(=^(w^!O^*A^*J^,X^+x^&?^$%^&Z ",
      "encoded_base64": "XiQlXi5IXiN6XidBXipGXip7XiElXiFWXikpXiRcXilGXitrXiZaXiU+XiRyXiEiXiQlXiEpXis8XiMrXig9Xih3XiFPXipBXipKXixYXit4XiY/XiQlXiZaIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_10b27d628038",
      "text": "信任。",
      "encoded_ascii": "^!U^!C^!\"",
      "encoded_base64": "XiFVXiFDXiEi",
      "byte_length": 9
    },
    {
      "unit_id": "DLG_760e3514e159",
      "text": "明智的決定。這是我承諾給你們的芭樂。記住要去無頭巨人 ",
      "encoded_ascii": "^$c^$i^&Z^,o^#.^!\"^(s^,X^$%^$0^7k^'A^*F^*{^&Z^'v^%8^!\"^(K^*z^(C^\"6^%}^)t^#H^!< ",
      "encoded_base64": "XiRjXiRpXiZaXixvXiMuXiEiXihzXixYXiQlXiQwXjdrXidBXipGXip7XiZaXid2XiU4XiEiXihLXip6XihDXiI2XiV9Xil0XiNIXiE8IA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_edea3126b244",
      "text": "酒館。無盡的財富正等著你們。我會命令守衛不得 ",
      "encoded_ascii": "^6=^>L^!\"^%}^-1^&Z^0=^3C^%H^'-^-a^*F^*{^!\"^$%^$r^\"N^*w^#+^(=^!)^#e ",
      "encoded_base64": "XjY9Xj5MXiEiXiV9Xi0xXiZaXjA9XjNDXiVIXictXi1hXipGXip7XiEiXiQlXiRyXiJOXip3XiMrXig9XiEpXiNlIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_1c94e6875217",
      "text": "發動攻擊。跟我來。 ",
      "encoded_ascii": "^&W^\"%^$O^$F^!\"^.+^$%^!O^!\" ",
      "encoded_base64": "XiZXXiIlXiRPXiRGXiEiXi4rXiQlXiFPXiEiIA==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_cce0b4eb943d",
      "text": "我們的巫王泰克圖克提特萊已經離開了——也許永遠不回來了。現在正是 ",
      "encoded_ascii": "^$%^*{^&Z^14^-)^%f^!d^\"b^!d^$A^&5^(!^#J^'D^)`^)F^*D^*n^*n^!1^-s^%W^({^!)^\"\\^!O^*D^!\"^&?^\"d^%H^,X ",
      "encoded_base64": "XiQlXip7XiZaXjE0Xi0pXiVmXiFkXiJiXiFkXiRBXiY1XighXiNKXidEXilgXilGXipEXipuXipuXiExXi1zXiVXXih7XiEpXiJcXiFPXipEXiEiXiY/XiJkXiVIXixYIA==",
      "byte_length": 97
    },
    {
      "unit_id": "DLG_21382eca1bea",
      "text": "有野心之輩招兵買馬的時機。你們將被用來徹底除掉 ",
      "encoded_ascii": "^$s^.:^#k^!/^8t^,D^+,^.!^*\"^&Z^$f^%>^!\"^*F^*{^#7^(@^&H^!O^18^/^^)Q^/e ",
      "encoded_base64": "XiRzXi46XiNrXiEvXjh0XixEXissXi4hXioiXiZaXiRmXiU+XiEiXipGXip7XiM3XihAXiZIXiFPXjE4Xi9eXilRXi9lIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_c5357f011b4a",
      "text": "我的政敵對手。",
      "encoded_ascii": "^$%^&Z^,P^$U^#:^$+^!\"",
      "encoded_base64": "XiQlXiZaXixQXiRVXiM6XiQrXiEi",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_2105f45a314d",
      "text": "當心別太不知分寸。自信與自尋死路之間只有一線之隔。 ",
      "encoded_ascii": "^&N^#k^*H^+f^!)^&h^!s^=(^!\"^'l^!U^'p^'l^#9^%L^(a^!/^)G^\"?^$s^!%^'I^!/^9e^!\" ",
      "encoded_base64": "XiZOXiNrXipIXitmXiEpXiZoXiFzXj0oXiEiXidsXiFVXidwXidsXiM5XiVMXihhXiEvXilHXiI/XiRzXiElXidJXiEvXjllXiEiIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_9ce08d409e63",
      "text": "不過，在酒館那裡仍有 5000 枚陶幣正等著 ",
      "encoded_ascii": "^!)^(x^*A^\"d^6=^>L^)!^-j^!?^$s 5000 ^$~^)R^+|^%H^'-^-a ",
      "encoded_base64": "XiEpXih4XipBXiJkXjY9Xj5MXikhXi1qXiE/XiRzIDUwMDAgXiR+XilSXit8XiVIXictXi1hIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_4c8d0a210d2f",
      "text": "你們。 ",
      "encoded_ascii": "^*F^*{^!\" ",
      "encoded_base64": "XipGXip7XiEiIA==",
      "byte_length": 10
    },
    {
      "unit_id": "DLG_50657d80ac77",
      "text": "你們太愚蠢了。接受眼前的條件，否則你們休想得到我的相助。 ",
      "encoded_ascii": "^*F^*{^+f^/a^.u^*D^!\"^$?^\";^&d^!z^&Z^%.^.W^*A^\"H^!x^*F^*{^!G^,1^#e^!u^$%^&Z^&a^\"#^!\" ",
      "encoded_base64": "XipGXip7XitmXi9hXi51XipEXiEiXiQ/XiI7XiZkXiF6XiZaXiUuXi5XXipBXiJIXiF4XipGXip7XiFHXiwxXiNlXiF1XiQlXiZaXiZhXiIjXiEiIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_85fc4efc5cc9",
      "text": "立刻做出抉擇！",
      "encoded_ascii": "^0'^.Y^*~^!q^:F^,N^*W",
      "encoded_base64": "XjAnXi5ZXip+XiFxXjpGXixOXipX",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_64baef8e3cc1",
      "text": "  我接受。",
      "encoded_ascii": "  ^$%^$?^\";^!\"",
      "encoded_base64": "ICBeJCVeJD9eIjteISI=",
      "byte_length": 14
    },
    {
      "unit_id": "DLG_22d5af03dd34",
      "text": "  你的幫助一文不值。",
      "encoded_ascii": "  ^*F^&Z^+}^\"#^!%^$W^!)^!Z^!\"",
      "encoded_base64": "ICBeKkZeJlpeK31eIiNeISVeJFdeISleIVpeISI=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_be12a1644f89",
      "text": "  所有的聖堂武士都是騙子。去死吧！",
      "encoded_ascii": "  ^$)^$s^&Z^'Z^42^%J^+a^)$^,X^.{^#(^!\"^\"6^%L^*I^*W",
      "encoded_base64": "ICBeJCleJHNeJlpeJ1peNDJeJUpeK2FeKSReLFheLnteIyheISJeIjZeJUxeKkleKlc=",
      "byte_length": 50
    },
    {
      "unit_id": "DLG_9f3aeaf8427e",
      "text": "我本以為你們會更聰明一些。守衛！",
      "encoded_ascii": "^$%^$x^!B^%{^*F^*{^$r^$o^2=^$c^!%^!8^!\"^#+^(=^*W",
      "encoded_base64": "XiQlXiR4XiFCXiV7XipGXip7XiRyXiRvXjI9XiRjXiElXiE4XiEiXiMrXig9XipX",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_41281567d1ef",
      "text": "在你們回答我之前，哪兒也別想去。",
      "encoded_ascii": "^\"d^*F^*{^\"\\^-B^$%^!/^!z^*A^+I^++^!1^*H^,1^\"6^!\"",
      "encoded_base64": "XiJkXipGXip7XiJcXi1CXiQlXiEvXiF6XipBXitJXisrXiExXipIXiwxXiI2XiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_5d7dccdc7f26",
      "text": "你們耗不過我的。耐心正是我的強項。 ",
      "encoded_ascii": "^*F^*{^'X^!)^(x^$%^&Z^!\"^-S^#k^%H^,X^$%^&Z^#]^)q^!\" ",
      "encoded_base64": "XipGXip7XidYXiEpXih4XiQlXiZaXiEiXi1TXiNrXiVIXixYXiQlXiZaXiNdXilxXiEiIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_c350815ac5dc",
      "text": "你們想考慮多久都行。我多的是時間。 ",
      "encoded_ascii": "^*F^*{^,1^-R^19^\"x^!.^)$^(;^!\"^$%^\"x^&Z^,X^$f^)G^!\" ",
      "encoded_base64": "XipGXip7XiwxXi1SXjE5XiJ4XiEuXikkXig7XiEiXiQlXiJ4XiZaXixYXiRmXilHXiEiIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_23c561bc47ab",
      "text": "拖延時間對你們毫無好處。 ",
      "encoded_ascii": "^.f^,&^$f^)G^#:^*F^*{^/t^%}^+i^(,^!\" ",
      "encoded_base64": "Xi5mXiwmXiRmXilHXiM6XipGXip7Xi90XiV9XitpXigsXiEiIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_aeec3bc90806",
      "text": "我付出的很多，索求的卻極少。眼下我唯一要求的，只是 ",
      "encoded_ascii": "^$%^*u^!q^&Z^*K^\"x^*A^'>^,n^&Z^1&^1D^#<^!\"^&d^!(^$%^+O^!%^(C^,n^&Z^*A^\"?^,X ",
      "encoded_base64": "XiQlXip1XiFxXiZaXipLXiJ4XipBXic+XixuXiZaXjEmXjFEXiM8XiEiXiZkXiEoXiQlXitPXiElXihDXixuXiZaXipBXiI/XixYIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_3366679c468a",
      "text": "要你們去那間酒館。",
      "encoded_ascii": "^(C^*F^*{^\"6^)!^)G^6=^>L^!\"",
      "encoded_base64": "XihDXipGXip7XiI2XikhXilHXjY9Xj5MXiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_bb3caf1d1b02",
      "text": "比起你們身為角鬥士時的處境，這已經自由得多了。沒有人 ",
      "encoded_ascii": "^,m^.(^*F^*{^(c^%{^(H^*,^+a^$f^&Z^(,^\"q^*A^(s^#J^'D^'l^&I^#e^\"x^*D^!\"^%\\^$s^!< ",
      "encoded_base64": "XixtXi4oXipGXip7XihjXiV7XihIXiosXithXiRmXiZaXigsXiJxXipBXihzXiNKXidEXidsXiZJXiNlXiJ4XipEXiEiXiVcXiRzXiE8IA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_3425c390cbbf",
      "text": "是真正自由的。 ",
      "encoded_ascii": "^,X^-2^%H^'l^&I^&Z^!\" ",
      "encoded_base64": "XixYXi0yXiVIXidsXiZJXiZaXiEiIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_baeb5e6ba159",
      "text": "在離開這個房間之前你們必須做出決定。要是你們擅自離開，我就會拉響 ",
      "encoded_ascii": "^\"d^)`^)F^(s^!V^,<^)G^!/^!z^*F^*{^#l^)r^*~^!q^,o^#.^!\"^(C^,X^*F^*{^2$^'l^)`^)F^*A^$%^*J^$r^$6^)o ",
      "encoded_base64": "XiJkXilgXilGXihzXiFWXiw8XilHXiEvXiF6XipGXip7XiNsXilyXip+XiFxXixvXiMuXiEiXihDXixYXipGXip7XjIkXidsXilgXilGXipBXiQlXipKXiRyXiQ2XilvIA==",
      "byte_length": 97
    },
    {
      "unit_id": "DLG_a9bf5698bbc5",
      "text": "警報，而且絕不會在守衛面前保護你們。",
      "encoded_ascii": "^(S^+`^*A^'W^!*^-I^!)^$r^\"d^#+^(=^)j^!z^!T^(T^*F^*{^!\"",
      "encoded_base64": "XihTXitgXipBXidXXiEqXi1JXiEpXiRyXiJkXiMrXig9XilqXiF6XiFUXihUXipGXip7XiEi",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_006579e78d41",
      "text": "我理解你們的不信任。當然，跟我來吧。 ",
      "encoded_ascii": "^$%^&A^(I^*F^*{^&Z^!)^!U^!C^!\"^&N^&\"^*A^.+^$%^!O^*I^!\" ",
      "encoded_base64": "XiQlXiZBXihJXipGXip7XiZaXiEpXiFVXiFDXiEiXiZOXiYiXipBXi4rXiQlXiFPXipJXiEiIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_5e877a3fd48c",
      "text": "你們做出決定了嗎？我快失去耐性了。",
      "encoded_ascii": "^*F^*{^*~^!q^,o^#.^*D^+X^.V^$%^*L^\"|^\"6^-S^#r^*D^!\"",
      "encoded_base64": "XipGXip7Xip+XiFxXixvXiMuXipEXitYXi5WXiQlXipMXiJ8XiI2Xi1TXiNyXipEXiEi",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_3baaa346e583",
      "text": "  我決定自己單獨行動。",
      "encoded_ascii": "  ^$%^,o^#.^'l^#I^2a^/z^(;^\"%^!\"",
      "encoded_base64": "ICBeJCVeLG9eIy5eJ2xeI0leMmFeL3peKDteIiVeISI=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_4c23e03d09f7",
      "text": "  我接受你的提議。",
      "encoded_ascii": "  ^$%^$?^\";^*F^&Z^$A^-|^!\"",
      "encoded_base64": "ICBeJCVeJD9eIjteKkZeJlpeJEFeLXxeISI=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_f9aeb663eeda",
      "text": "  我必須再多考慮一下。",
      "encoded_ascii": "  ^$%^#l^)r^!l^\"x^-R^19^!%^!(^!\"",
      "encoded_base64": "ICBeJCVeI2xeKXJeIWxeInheLVJeMTleISVeISheISI=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_5a3013bc1bfe",
      "text": "  你為什麼要為我做這些？",
      "encoded_ascii": "  ^*F^%{^!=^.T^(C^%{^$%^*~^(s^!8^.V",
      "encoded_base64": "ICBeKkZeJXteIT1eLlReKENeJXteJCVeKn5eKHNeITheLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_0afe23ad3862",
      "text": "  我受夠你了。去死吧！",
      "encoded_ascii": "  ^$%^\";^+d^*F^*D^!\"^\"6^%L^*I^*W",
      "encoded_base64": "ICBeJCVeIjteK2ReKkZeKkReISJeIjZeJUxeKkleKlc=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_acba0fc3fbb5",
      "text": "別自作多情了。我真正在乎的，是你們在競技場上的出色表現， ",
      "encoded_ascii": "^*H^'l^!M^\"x^,0^*D^!\"^$%^-2^%H^\"d^!0^&Z^*A^,X^*F^*{^\"d^-?^,>^\"n^!'^&Z^!q^'s^-i^&?^*A ",
      "encoded_base64": "XipIXidsXiFNXiJ4XiwwXipEXiEiXiQlXi0yXiVIXiJkXiEwXiZaXipBXixYXipGXip7XiJkXi0/Xiw+XiJuXiEnXiZaXiFxXidzXi1pXiY/XipBIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_48f4db8b9541",
      "text": "以及在對抗我的守衛時展現出的力量與狡黠。 ",
      "encoded_ascii": "^!B^\"7^\"d^#:^$4^$%^&Z^#+^(=^$f^+x^&?^!q^&Z^!~^)*^'p^::^:A^!\" ",
      "encoded_base64": "XiFCXiI3XiJkXiM6XiQ0XiQlXiZaXiMrXig9XiRmXit4XiY/XiFxXiZaXiF+XikqXidwXjo6XjpBXiEiIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_769fef4291bd",
      "text": "一支戰鬥隊伍裡正需要你們這樣的人才。",
      "encoded_ascii": "^!%^$L^$(^*,^)U^!F^-j^%H^)e^(C^*F^*{^(s^,f^&Z^!<^$,^!\"",
      "encoded_base64": "XiElXiRMXiQoXiosXilVXiFGXi1qXiVIXillXihDXipGXip7XihzXixmXiZaXiE8XiQsXiEi",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_e1464a5ee97c",
      "text": "看來關在奴隸牢欄裡已經把你們的腦子給逼瘋了。真是可惜。",
      "encoded_ascii": "^*Q^!O^.>^\"d^##^)Z^-$^%C^-j^#J^'D^$1^*F^*{^&Z^2@^#(^'A^.1^-/^*D^!\"^-2^,X^\"A^7X^!\"",
      "encoded_base64": "XipRXiFPXi4+XiJkXiMjXilaXi0kXiVDXi1qXiNKXidEXiQxXipGXip7XiZaXjJAXiMoXidBXi4xXi0vXipEXiEiXi0yXixYXiJBXjdYXiEi",
      "byte_length": 81
    },
    {
      "unit_id": "DLG_00840fef1b46",
      "text": "我們很快就到大門了。 ",
      "encoded_ascii": "^$%^*{^*K^*L^*J^!u^\"z^)D^*D^!\" ",
      "encoded_base64": "XiQlXip7XipLXipMXipKXiF1XiJ6XilEXipEXiEiIA==",
      "byte_length": 31
    },
    {
      "unit_id": "DLG_6498829eaeb4",
      "text": "我們到終點了。你們真以為我會幫你們嗎？你們比我想像的還要 ",
      "encoded_ascii": "^$%^*{^!u^-H^*;^*D^!\"^*F^*{^-2^!B^%{^$%^$r^+}^*F^*{^+X^.V^*F^*{^,m^$%^,1^!`^&Z^.7^(C ",
      "encoded_base64": "XiQlXip7XiF1Xi1IXio7XipEXiEiXipGXip7Xi0yXiFCXiV7XiQlXiRyXit9XipGXip7XitYXi5WXipGXip7XixtXiQlXiwxXiFgXiZaXi43XihDIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_416d69a72e15",
      "text": "容易上當。我早該料到空有一身蠻力的人，腦袋瓜往往 ",
      "encoded_ascii": "^+t^,W^!'^&N^!\"^$%^,V^(M^/n^!u^'(^$s^!%^(c^/H^!~^&Z^!<^*A^2@^(?^<X^,)^,) ",
      "encoded_base64": "Xit0XixXXiEnXiZOXiEiXiQlXixWXihNXi9uXiF1XicoXiRzXiElXihjXi9IXiF+XiZaXiE8XipBXjJAXig/XjxYXiwpXiwpIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_ad3c1b3a04b0",
      "text": "都不太靈光！ ",
      "encoded_ascii": "^)$^!)^+f^)g^!c^*W ",
      "encoded_base64": "XikkXiEpXitmXilnXiFjXipXIA==",
      "byte_length": 19
    },
    {
      "unit_id": "DLG_d0aaeaf35782",
      "text": "嘿！你們沒聽見嗎？庫爾扎克正到處找你們呢。該去賺你們的伙食費了！ ",
      "encoded_ascii": "^+\\^*W^*F^*{^%\\^-X^-m^+X^.V^,#^&/^,=^!d^%H^!u^(,^$/^*F^*{^+C^!\"^(M^\"6^7m^*F^*{^&Z^*y^0J^.\"^*D^*W ",
      "encoded_base64": "XitcXipXXipGXip7XiVcXi1YXi1tXitYXi5WXiwjXiYvXiw9XiFkXiVIXiF1XigsXiQvXipGXip7XitDXiEiXihNXiI2XjdtXipGXip7XiZaXip5XjBKXi4iXipEXipXIA==",
      "byte_length": 97
    },
    {
      "unit_id": "DLG_69c321bf5ef1",
      "text": "我也很想多聊聊，但我得趕回去幹活了——在這鬼地方 ",
      "encoded_ascii": "^$%^!1^*K^,1^\"x^-U^-U^*A^!I^$%^#e^0u^\"\\^\"6^,!^%i^*D^*n^*n^\"d^(s^*-^\"e^$] ",
      "encoded_base64": "XiQlXiExXipLXiwxXiJ4Xi1VXi1VXipBXiFJXiQlXiNlXjB1XiJcXiI2XiwhXiVpXipEXipuXipuXiJkXihzXiotXiJlXiRdIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_7ee21a9b523c",
      "text": "可不會平白無故餵飽你！ ",
      "encoded_ascii": "^\"A^!)^$r^0Y^&X^%}^5U^.L^7r^*F^*W ",
      "encoded_base64": "XiJBXiEpXiRyXjBZXiZYXiV9XjVVXi5MXjdyXipGXipXIA==",
      "byte_length": 34
    },
    {
      "unit_id": "DLG_995311d6cd21",
      "text": "我看你們還活著。不過，沒有角鬥士能活得長久的。 ",
      "encoded_ascii": "^$%^*Q^*F^*{^.7^%i^-a^!\"^!)^(x^*A^%\\^$s^(H^*,^+a^'b^%i^#e^)C^!.^&Z^!\" ",
      "encoded_base64": "XiQlXipRXipGXip7Xi43XiVpXi1hXiEiXiEpXih4XipBXiVcXiRzXihIXiosXithXidiXiVpXiNlXilDXiEuXiZaXiEiIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_50b21c60909e",
      "text": "我聽說過你們的事。真驚訝我沒早點來找你們談談。 ",
      "encoded_ascii": "^$%^-X^-x^(x^*F^*{^&Z^*r^!\"^-2^.Q^-r^$%^%\\^,V^*;^!O^$/^*F^*{^0;^0;^!\" ",
      "encoded_base64": "XiQlXi1YXi14Xih4XipGXip7XiZaXipyXiEiXi0yXi5RXi1yXiQlXiVcXixWXio7XiFPXiQvXipGXip7XjA7XjA7XiEiIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_8f44f93f4c6f",
      "text": "待在德拉吉的牢欄裡，總好過待在某個注定毀滅的奴隸村落。 ",
      "encoded_ascii": "^,*^\"d^#j^$6^\"D^&Z^-$^%C^-j^*A^-M^+i^(x^,*^\"d^%$^!V^%e^#.^%N^%t^&Z^##^)Z^$z^-`^!\" ",
      "encoded_base64": "XiwqXiJkXiNqXiQ2XiJEXiZaXi0kXiVDXi1qXipBXi1NXitpXih4XiwqXiJkXiUkXiFWXiVlXiMuXiVOXiV0XiZaXiMjXilaXiR6Xi1gXiEiIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_dfa920525803",
      "text": "某處。 ",
      "encoded_ascii": "^%$^(,^!\" ",
      "encoded_base64": "XiUkXigsXiEiIA==",
      "byte_length": 10
    },
    {
      "unit_id": "DLG_dcb8b11d75f6",
      "text": "這麼說你們就是新來的角鬥士了。骨瘦如柴的。你們真該慶幸 ",
      "encoded_ascii": "^(s^.T^-x^*F^*{^*J^,X^$\\^!O^&Z^(H^*,^+a^*D^!\"^*$^>S^#$^4G^&Z^!\"^*F^*{^-2^(M^5P^15 ",
      "encoded_base64": "XihzXi5UXi14XipGXip7XipKXixYXiRcXiFPXiZaXihIXiosXithXipEXiEiXiokXj5TXiMkXjRHXiZaXiEiXipGXip7Xi0yXihNXjVQXjE1IA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_bd184907d35d",
      "text": "自己是在這裡，而不是在那些村落裡。 ",
      "encoded_ascii": "^'l^#I^,X^\"d^(s^-j^*A^'W^!)^,X^\"d^)!^!8^$z^-`^-j^!\" ",
      "encoded_base64": "XidsXiNJXixYXiJkXihzXi1qXipBXidXXiEpXixYXiJkXikhXiE4XiR6Xi1gXi1qXiEiIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_fa81593a28a3",
      "text": "為什麼要攻擊像我這樣無助的老頭子？我根本不會傷害你們！",
      "encoded_ascii": "^%{^!=^.T^(C^$O^$F^!`^$%^(s^,f^%}^\"#^&Z^'U^)t^#(^.V^$%^%)^$x^!)^$r^!^^#/^*F^*{^*W",
      "encoded_base64": "XiV7XiE9Xi5UXihDXiRPXiRGXiFgXiQlXihzXixmXiV9XiIjXiZaXidVXil0XiMoXi5WXiQlXiUpXiR4XiEpXiRyXiFeXiMvXipGXip7XipX",
      "byte_length": 81
    },
    {
      "unit_id": "DLG_eb47bb8f691d",
      "text": "警報響了。要是他們抓到你們，一定會把你們殺了。 ",
      "encoded_ascii": "^(S^+`^)o^*D^!\"^(C^,X^!@^*{^$2^!u^*F^*{^*A^!%^#.^$r^$1^*F^*{^%M^*D^!\" ",
      "encoded_base64": "XihTXitgXilvXipEXiEiXihDXixYXiFAXip7XiQyXiF1XipGXip7XipBXiElXiMuXiRyXiQxXipGXip7XiVNXipEXiEiIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_e1f5a7097da8",
      "text": "我留在這裡。我太老了，沒法在沙漠裡到處奔波。祝你們好運！",
      "encoded_ascii": "^$%^-+^\"d^(s^-j^!\"^$%^+f^'U^*D^*A^%\\^%b^\"d^%]^,}^-j^!u^(,^2b^%c^!\"^&v^*F^*{^+i^.4^*W",
      "encoded_base64": "XiQlXi0rXiJkXihzXi1qXiEiXiQlXitmXidVXipEXipBXiVcXiViXiJkXiVdXix9Xi1qXiF1XigsXjJiXiVjXiEiXiZ2XipGXip7XitpXi40XipX",
      "byte_length": 84
    },
    {
      "unit_id": "DLG_8e81abb31749",
      "text": "我有沒有跟你們說過 ",
      "encoded_ascii": "^$%^$s^%\\^$s^.+^*F^*{^-x^(x ",
      "encoded_base64": "XiQlXiRzXiVcXiRzXi4rXipGXip7Xi14Xih4IA==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_d2eefa2fcdd9",
      "text": "我是怎麼來到這裡的？ ",
      "encoded_ascii": "^$%^,X^,,^.T^!O^!u^(s^-j^&Z^.V ",
      "encoded_base64": "XiQlXixYXiwsXi5UXiFPXiF1XihzXi1qXiZaXi5WIA==",
      "byte_length": 31
    },
    {
      "unit_id": "DLG_ff4c510a67bc",
      "text": "我是怎麼當上特權管事的？",
      "encoded_ascii": "^$%^,X^,,^.T^&N^!'^&5^1E^-D^*r^&Z^.V",
      "encoded_base64": "XiQlXixYXiwsXi5UXiZOXiEnXiY1XjFFXi1EXipyXiZaXi5W",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_cf9247434211",
      "text": "我在進奴隸牢欄前的生活？ ",
      "encoded_ascii": "^$%^\"d^(w^##^)Z^-$^%C^!z^&Z^&F^%i^.V ",
      "encoded_base64": "XiQlXiJkXih3XiMjXilaXi0kXiVDXiF6XiZaXiZGXiVpXi5WIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_b9f185ee5570",
      "text": "關於奴隸牢欄的事？ ",
      "encoded_ascii": "^.>^$^^##^)Z^-$^%C^&Z^*r^.V ",
      "encoded_base64": "Xi4+XiReXiMjXilaXi0kXiVDXiZaXipyXi5WIA==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_84b288dfed86",
      "text": "好吧，這全都是真的，字字屬實！ ",
      "encoded_ascii": "^+i^*I^*A^(s^!h^)$^,X^-2^&Z^*A^#)^#)^#C^#3^*W ",
      "encoded_base64": "XitpXipJXipBXihzXiFoXikkXixYXi0yXiZaXipBXiMpXiMpXiNDXiMzXipXIA==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_291c9b8b2f65",
      "text": "我是情勢所迫的受害者。我受僱於 ",
      "encoded_ascii": "^$%^,X^,0^\"&^$)^1`^&Z^\";^#/^'V^!\"^$%^\";^=?^$^ ",
      "encoded_base64": "XiQlXixYXiwwXiImXiQpXjFgXiZaXiI7XiMvXidWXiEiXiQlXiI7Xj0/XiReIA==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_ed6bba801aec",
      "text": "一名需要去拉姆城嚮導的聖堂武士。他想給他的兄弟一個 ",
      "encoded_ascii": "^!%^\"F^)e^(C^\"6^$6^#%^+_^9j^10^&Z^'Z^42^%J^+a^!\"^!@^,1^'A^!@^&Z^1!^16^!%^!V ",
      "encoded_base64": "XiElXiJGXillXihDXiI2XiQ2XiMlXitfXjlqXjEwXiZaXidaXjQyXiVKXithXiEiXiFAXiwxXidBXiFAXiZaXjEhXjE2XiElXiFWIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_d3bc4bc2ebca",
      "text": "驚喜，所以只有我們兩個人上路。他正喋喋不休地抱怨著他有多麼 ",
      "encoded_ascii": "^.Q^+V^*A^$)^!B^\"?^$s^$%^*{^!i^!V^!<^!'^(a^!\"^!@^%H^>N^>N^!)^!G^\"e^,@^3F^-a^!@^$s^\"x^.T ",
      "encoded_base64": "Xi5RXitWXipBXiQpXiFCXiI/XiRzXiQlXip7XiFpXiFWXiE8XiEnXihhXiEiXiFAXiVIXj5OXj5OXiEpXiFHXiJlXixAXjNGXi1hXiFAXiRzXiJ4Xi5UIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_afd49468fb19",
      "text": "討厭走路，結果我們就遭到了群居托爾螳螂人的伏擊。 ",
      "encoded_ascii": "^-o^+9^.&^(a^*A^'@^%!^$%^*{^*J^(}^!u^*D^'R^+w^/-^&/^8O^8N^!<^&Z^3c^$F^!\" ",
      "encoded_base64": "Xi1vXis5Xi4mXihhXipBXidAXiUhXiQlXip7XipKXih9XiF1XipEXidSXit3Xi8tXiYvXjhPXjhOXiE8XiZaXjNjXiRGXiEiIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_9e8f8eb2773a",
      "text": "我擊退了其中六隻，但那聖堂武士還是死了。 ",
      "encoded_ascii": "^$%^$F^*V^*D^!j^!,^;>^)[^*A^!I^)!^'Z^42^%J^+a^.7^,X^%L^*D^!\" ",
      "encoded_base64": "XiQlXiRGXipWXipEXiFqXiEsXjs+XilbXipBXiFJXikhXidaXjQyXiVKXithXi43XixYXiVMXipEXiEiIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_24cf4dd0a617",
      "text": "在比武結束後，我被押送回這裡，這時一隻潛伏怪掙脫了出來。 ",
      "encoded_ascii": "^\"d^,m^%J^'@^$|^#b^*A^$%^(@^7Z^./^\"\\^(s^-j^*A^(s^$f^!%^)[^7:^3c^#s^.g^'c^*D^!q^!O^!\" ",
      "encoded_base64": "XiJkXixtXiVKXidAXiR8XiNiXipBXiQlXihAXjdaXi4vXiJcXihzXi1qXipBXihzXiRmXiElXilbXjc6XjNjXiNzXi5nXidjXipEXiFxXiFPXiEiIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_2d1b5fe989c3",
      "text": "牠襲擊了嚇得目瞪口呆的守衛隊長。我抄起他掉落的 ",
      "encoded_ascii": "^-#^08^$F^*D^\"X^#e^&^^:V^\"<^;)^&Z^#+^(=^)U^)C^!\"^$%^>P^.(^!@^/e^-`^&Z ",
      "encoded_base64": "Xi0jXjA4XiRGXipEXiJYXiNlXiZeXjpWXiI8XjspXiZaXiMrXig9XilVXilDXiEiXiQlXj5QXi4oXiFAXi9lXi1gXiZaIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_4f051ff53995",
      "text": "長劍，一劍斬殺了那隻潛伏怪。總守衛長因此 ",
      "encoded_ascii": "^)C^!|^*A^!%^!|^9B^%M^*D^)!^)[^7:^3c^#s^!\"^-M^#+^(=^)C^\"]^%I ",
      "encoded_base64": "XilDXiF8XipBXiElXiF8XjlCXiVNXipEXikhXilbXjc6XjNjXiNzXiEiXi1NXiMrXig9XilDXiJdXiVJIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_fcc13f134dbf",
      "text": "讓我留下來，在這牢欄裡擔任幫手。",
      "encoded_ascii": "^-}^$%^-+^!(^!O^*A^\"d^(s^-$^%C^-j^*N^!C^+}^$+^!\"",
      "encoded_base64": "Xi19XiQlXi0rXiEoXiFPXipBXiJkXihzXi0kXiVDXi1qXipOXiFDXit9XiQrXiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_ad7addf5715c",
      "text": "年輕時，我可是個荒原老手。我熟悉這裡到 ",
      "encoded_ascii": "^+~^(g^$f^*A^$%^\"A^,X^!V^1W^\"5^'U^$+^!\"^$%^-\"^2h^(s^-j^!u ",
      "encoded_base64": "Xit+XihnXiRmXipBXiQlXiJBXixYXiFWXjFXXiI1XidVXiQrXiEiXiQlXi0iXjJoXihzXi1qXiF1IA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_122b37a91baf",
      "text": "響鳴山脈之間的每一塊石頭。而且這在當時也是人盡皆知的。 ",
      "encoded_ascii": "^)o^.|^11^6i^!/^)G^&Z^%P^!%^/Z^&k^)t^!\"^'W^!*^(s^\"d^&N^$f^!1^,X^!<^-1^5j^&h^&Z^!\" ",
      "encoded_base64": "XilvXi58XjExXjZpXiEvXilHXiZaXiVQXiElXi9aXiZrXil0XiEiXidXXiEqXihzXiJkXiZOXiRmXiExXixYXiE8Xi0xXjVqXiZoXiZaXiEiIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_0c25ed0424b8",
      "text": "我為所有人帶路，去過所有地方。你可以說我是個超凡絕倫的嚮導。 ",
      "encoded_ascii": "^$%^%{^$)^$s^!<^#N^(a^*A^\"6^(x^$)^$s^\"e^$]^!\"^*F^\"A^!B^-x^$%^,X^!V^(\\^+-^-I^/!^&Z^9j^10^!\" ",
      "encoded_base64": "XiQlXiV7XiQpXiRzXiE8XiNOXihhXipBXiI2Xih4XiQpXiRzXiJlXiRdXiEiXipGXiJBXiFCXi14XiQlXixYXiFWXihcXistXi1JXi8hXiZaXjlqXjEwXiEiIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_1670a6b52402",
      "text": "可以這麼說。",
      "encoded_ascii": "^\"A^!B^(s^.T^-x^!\"",
      "encoded_base64": "XiJBXiFCXihzXi5UXi14XiEi",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_bb5b29aa3e1d",
      "text": "德拉吉城以其殘酷與暴力為傲。 ",
      "encoded_ascii": "^#j^$6^\"D^+_^!B^!j^,l^1b^'p^$m^!~^%{^1j^!\" ",
      "encoded_base64": "XiNqXiQ2XiJEXitfXiFCXiFqXixsXjFiXidwXiRtXiF+XiV7XjFqXiEiIA==",
      "byte_length": 43
    },
    {
      "unit_id": "DLG_195eba79aa29",
      "text": "德拉吉戰士據說令整個阿塔斯聞風喪膽。 ",
      "encoded_ascii": "^#j^$6^\"D^$(^+a^5T^-x^*w^$T^!V^)M^\"o^$[^4^^)y^1)^-[^!\" ",
      "encoded_base64": "XiNqXiQ2XiJEXiQoXithXjVUXi14Xip3XiRUXiFWXilNXiJvXiRbXjReXil5XjEpXi1bXiEiIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_d1f2fdfa2c90",
      "text": "競技場讓平民百姓沉迷狂歡，並用暴力滋養泰克圖克提特萊國王。 ",
      "encoded_ascii": "^-?^,>^\"n^-}^0Y^%T^&Y^6S^%Z^(n^&8^%F^*A^!+^&H^$m^!~^7|^.I^%f^!d^\"b^!d^$A^&5^(!^+^^-)^!\" ",
      "encoded_base64": "Xi0/Xiw+XiJuXi19XjBZXiVUXiZZXjZTXiVaXihuXiY4XiVGXipBXiErXiZIXiRtXiF+Xjd8Xi5JXiVmXiFkXiJiXiFkXiRBXiY1XighXiteXi0pXiEiIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_bebbef993354",
      "text": "的嗜血狂暴。 ",
      "encoded_ascii": "^&Z^>3^(:^&8^$m^!\" ",
      "encoded_base64": "XiZaXj4zXig6XiY4XiRtXiEiIA==",
      "byte_length": 19
    },
    {
      "unit_id": "DLG_c14b5b420a3b",
      "text": "  可是，我們今天才第一次見面！",
      "encoded_ascii": "  ^\"A^,X^*A^$%^*{^*E^+e^$,^',^!%^%D^-m^)j^*W",
      "encoded_base64": "ICBeIkFeLFheKkFeJCVeKnteKkVeK2VeJCxeJyxeISVeJUReLW1eKWpeKlc=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_54ae0527739c",
      "text": "  我在哪裡能弄到水？",
      "encoded_ascii": "  ^$%^\"d^+I^-j^'b^/`^!u^%V^.V",
      "encoded_base64": "ICBeJCVeImReK0leLWpeJ2JeL2BeIXVeJVZeLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_5e31d3cf6ae2",
      "text": "  我該怎麼去找迪諾斯？",
      "encoded_ascii": "  ^$%^(M^,,^.T^\"6^$/^(m^7k^$[^.V",
      "encoded_base64": "ICBeJCVeKE1eLCxeLlReIjZeJC9eKG1eN2teJFteLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_951eb091a096",
      "text": "  什麼村落？",
      "encoded_ascii": "  ^!=^.T^$z^-`^.V",
      "encoded_base64": "ICBeIT1eLlReJHpeLWBeLlY=",
      "byte_length": 17
    },
    {
      "unit_id": "DLG_737da6404b91",
      "text": "  我在哪裡可以休息？",
      "encoded_ascii": "  ^$%^\"d^+I^-j^\"A^!B^!G^#w^.V",
      "encoded_base64": "ICBeJCVeImReK0leLWpeIkFeIUJeIUdeI3deLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_3a6b9b744db3",
      "text": "  你剛才提到了村落，是什麼村落？",
      "encoded_ascii": "  ^*F^+0^$,^$A^!u^*D^$z^-`^*A^,X^!=^.T^$z^-`^.V",
      "encoded_base64": "ICBeKkZeKzBeJCxeJEFeIXVeKkReJHpeLWBeKkFeLFheIT1eLlReJHpeLWBeLlY=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_df9bb16aa5fb",
      "text": "  為什麼說我很幸運？ ",
      "encoded_ascii": "  ^%{^!=^.T^-x^$%^*K^15^.4^.V ",
      "encoded_base64": "ICBeJXteIT1eLlReLXheJCVeKkteMTVeLjReLlYg",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_b2b3e986001f",
      "text": "  你說我很幸運是什麼意思？",
      "encoded_ascii": "  ^*F^-x^$%^*K^15^.4^,X^!=^.T^#z^#q^.V",
      "encoded_base64": "ICBeKkZeLXheJCVeKkteMTVeLjReLFheIT1eLlReI3peI3FeLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_bf1fc42112c4",
      "text": "  你被指控謀殺？",
      "encoded_ascii": "  ^*F^(@^$8^$@^3~^%M^.V",
      "encoded_base64": "ICBeKkZeKEBeJDheJEBeM35eJU1eLlY=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_9abf205c5036",
      "text": "  那你為什麼會在這裡？",
      "encoded_ascii": "  ^)!^*F^%{^!=^.T^$r^\"d^(s^-j^.V",
      "encoded_base64": "ICBeKSFeKkZeJXteIT1eLlReJHJeImReKHNeLWpeLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_9c124d72d4b5",
      "text": "  你們真的遭到伏擊了嗎？",
      "encoded_ascii": "  ^*F^*{^-2^&Z^(}^!u^3c^$F^*D^+X^.V",
      "encoded_base64": "ICBeKkZeKnteLTJeJlpeKH1eIXVeM2NeJEZeKkReK1heLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_87a55f027662",
      "text": "  你贏得自由了嗎？",
      "encoded_ascii": "  ^*F^.%^#e^'l^&I^*D^+X^.V",
      "encoded_base64": "ICBeKkZeLiVeI2VeJ2xeJkleKkReK1heLlY=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_1200823bb905",
      "text": "  關於這牢欄你還知道些什麼？",
      "encoded_ascii": "  ^.>^$^^(s^-$^%C^*F^.7^&h^(y^!8^!=^.T^.V",
      "encoded_base64": "ICBeLj5eJF5eKHNeLSReJUNeKkZeLjdeJmheKHleITheIT1eLlReLlY=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_37681798bb05",
      "text": "  （扒竊特權管事的口袋）",
      "encoded_ascii": "  ^*?^;C^5n^&5^1E^-D^*r^&Z^\"<^(?^*@",
      "encoded_base64": "ICBeKj9eO0NeNW5eJjVeMUVeLUReKnJeJlpeIjxeKD9eKkA=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_b5a9952409ae",
      "text": "  德拉吉城外的地形是什麼樣子？",
      "encoded_ascii": "  ^#j^$6^\"D^+_^\"w^&Z^\"e^#_^,X^!=^.T^,f^#(^.V",
      "encoded_base64": "ICBeI2peJDZeIkReK19eIndeJlpeImVeI19eLFheIT1eLlReLGZeIyheLlY=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_0b7e12fe7faa",
      "text": "  那些村落能存活下來嗎？",
      "encoded_ascii": "  ^)!^!8^$z^-`^'b^#*^%i^!(^!O^+X^.V",
      "encoded_base64": "ICBeKSFeITheJHpeLWBeJ2JeIypeJWleISheIU9eK1heLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_31826a9b7fe1",
      "text": "  他們為什麼不團結起來作戰？",
      "encoded_ascii": "  ^!@^*{^%{^!=^.T^!)^0V^'@^.(^!O^!M^$(^.V",
      "encoded_base64": "ICBeIUBeKnteJXteIT1eLlReISleMFZeJ0BeLiheIU9eIU1eJCheLlY=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_9d92899534ec",
      "text": "你摸到了一把鑰匙！ ",
      "encoded_ascii": "^*F^/j^!u^*D^!%^$1^)@^\"*^*W ",
      "encoded_base64": "XipGXi9qXiF1XipEXiElXiQxXilAXiIqXipXIA==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_b48bd756e760",
      "text": "你扒竊特權管事口袋失敗了。 ",
      "encoded_ascii": "^*F^;C^5n^&5^1E^-D^*r^\"<^(?^\"|^$R^*D^!\" ",
      "encoded_base64": "XipGXjtDXjVuXiY1XjFFXi1EXipyXiI8Xig/XiJ8XiRSXipEXiEiIA==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_1e444fa8b7b3",
      "text": "那是東面牆上唯一的一扇門。 ",
      "encoded_ascii": "^)!^,X^,`^)j^&0^!'^+O^!%^&Z^!%^$*^)D^!\" ",
      "encoded_base64": "XikhXixYXixgXilqXiYwXiEnXitPXiElXiZaXiElXiQqXilEXiEiIA==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_2de5a864d41a",
      "text": "沿著這條走廊往東走，然後向北轉。門就在你的 ",
      "encoded_ascii": "^%`^-a^(s^%.^.&^,$^,)^,`^.&^*A^&\"^#b^+?^+6^(i^!\"^)D^*J^\"d^*F^&Z ",
      "encoded_base64": "XiVgXi1hXihzXiUuXi4mXiwkXiwpXixgXi4mXipBXiYiXiNiXis/Xis2XihpXiEiXilEXipKXiJkXipGXiZaIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_8f1d925fa230",
      "text": "右手邊。 ",
      "encoded_ascii": "^;s^$+^.8^!\" ",
      "encoded_base64": "XjtzXiQrXi44XiEiIA==",
      "byte_length": 13
    },
    {
      "unit_id": "DLG_556f7c97672d",
      "text": "沿著這條走廊向南走，然後左轉。順著走廊一直走直到再次向左轉。 ",
      "encoded_ascii": "^%`^-a^(s^%.^.&^,$^+?^\"/^.&^*A^&\"^#b^;w^(i^!\"^.D^-a^.&^,$^!%^&`^.&^&`^!u^!l^%D^+?^;w^(i^!\" ",
      "encoded_base64": "XiVgXi1hXihzXiUuXi4mXiwkXis/XiIvXi4mXipBXiYiXiNiXjt3XihpXiEiXi5EXi1hXi4mXiwkXiElXiZgXi4mXiZgXiF1XiFsXiVEXis/Xjt3XihpXiEiIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_d80a80a3591e",
      "text": "門就在你的右手邊。 ",
      "encoded_ascii": "^)D^*J^\"d^*F^&Z^;s^$+^.8^!\" ",
      "encoded_base64": "XilEXipKXiJkXipGXiZaXjtzXiQrXi44XiEiIA==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_2018f22026d2",
      "text": "沒錯，沒錯，我記得你們——我還沒老到記不住一個 ",
      "encoded_ascii": "^%\\^)5^*A^%\\^)5^*A^$%^(K^#e^*F^*{^*n^*n^$%^.7^%\\^'U^!u^(K^!)^*z^!%^!V ",
      "encoded_base64": "XiVcXik1XipBXiVcXik1XipBXiQlXihLXiNlXipGXip7XipuXipuXiQlXi43XiVcXidVXiF1XihLXiEpXip6XiElXiFWIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_31413960f7bb",
      "text": "名字…… ",
      "encoded_ascii": "^\"F^#)^*o^*o ",
      "encoded_base64": "XiJGXiMpXipvXipvIA==",
      "byte_length": 13
    },
    {
      "unit_id": "DLG_cf04372d766f",
      "text": "確實沒見過。不，嗯，我是特權管事，你們就這麼叫我好了—— ",
      "encoded_ascii": "^-6^#3^%\\^-m^(x^!\"^!)^*A^6N^*A^$%^,X^&5^1E^-D^*r^*A^*F^*{^*J^(s^.T^+<^$%^+i^*D^*n^*n ",
      "encoded_base64": "Xi02XiMzXiVcXi1tXih4XiEiXiEpXipBXjZOXipBXiQlXixYXiY1XjFFXi1EXipyXipBXipGXip7XipKXihzXi5UXis8XiQlXitpXipEXipuXipuIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_b8697424e5e7",
      "text": "因為我現在沒有別的名字了。沒有，沒有別的名字。 ",
      "encoded_ascii": "^\"]^%{^$%^&?^\"d^%\\^$s^*H^&Z^\"F^#)^*D^!\"^%\\^$s^*A^%\\^$s^*H^&Z^\"F^#)^!\" ",
      "encoded_base64": "XiJdXiV7XiQlXiY/XiJkXiVcXiRzXipIXiZaXiJGXiMpXipEXiEiXiVcXiRzXipBXiVcXiRzXipIXiZaXiJGXiMpXiEiIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_9547ef797881",
      "text": "這附近某個地方扔著一個空水罐。 ",
      "encoded_ascii": "^(s^.?^(l^%$^!V^\"e^$]^8{^-a^!%^!V^'(^%V^'O^!\" ",
      "encoded_base64": "XihzXi4/XihsXiUkXiFWXiJlXiRdXjh7Xi1hXiElXiFWXicoXiVWXidPXiEiIA==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_d1c200cc8266",
      "text": "你們可以從迪諾斯以前住的水槽那裡取水，在你們動手 ",
      "encoded_ascii": "^*F^*{^\"A^!B^#f^(m^7k^$[^!B^!z^*z^&Z^%V^%6^)!^-j^\":^%V^*A^\"d^*F^*{^\"%^$+ ",
      "encoded_base64": "XipGXip7XiJBXiFCXiNmXihtXjdrXiRbXiFCXiF6Xip6XiZaXiVWXiU2XikhXi1qXiI6XiVWXipBXiJkXipGXip7XiIlXiQrIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_e8179f472634",
      "text": "殺了他之前。只要把水罐帶過去裝滿就行。",
      "encoded_ascii": "^%M^*D^!@^!/^!z^!\"^\"?^(C^$1^%V^'O^#N^(x^\"6^(A^,{^*J^(;^!\"",
      "encoded_base64": "XiVNXipEXiFAXiEvXiF6XiEiXiI/XihDXiQxXiVWXidPXiNOXih4XiI2XihBXix7XipKXig7XiEi",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_573ea9c07f97",
      "text": "只要找到水罐 ",
      "encoded_ascii": "^\"?^(C^$/^!u^%V^'O ",
      "encoded_base64": "XiI/XihDXiQvXiF1XiVWXidPIA==",
      "byte_length": 19
    },
    {
      "unit_id": "DLG_c0092bef3c7f",
      "text": "讓迪諾斯幫忙裝滿就行。他能弄到水。 ",
      "encoded_ascii": "^-}^(m^7k^$[^+}^,+^(A^,{^*J^(;^!\"^!@^'b^/`^!u^%V^!\" ",
      "encoded_base64": "Xi19XihtXjdrXiRbXit9XiwrXihBXix7XipKXig7XiEiXiFAXidiXi9gXiF1XiVWXiEiIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_f9e4c46b3027",
      "text": "你們不知道那些村落的事？ ",
      "encoded_ascii": "^*F^*{^!)^&h^(y^)!^!8^$z^-`^&Z^*r^.V ",
      "encoded_base64": "XipGXip7XiEpXiZoXih5XikhXiE4XiR6Xi1gXiZaXipyXi5WIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_c36e573cae3c",
      "text": "我有提到村落嗎？ ",
      "encoded_ascii": "^$%^$s^$A^!u^$z^-`^+X^.V ",
      "encoded_base64": "XiQlXiRzXiRBXiF1XiR6Xi1gXitYXi5WIA==",
      "byte_length": 25
    },
    {
      "unit_id": "DLG_5973d10fa606",
      "text": "多年來有許多重獲自由的人民聚集在一起結成群體。 ",
      "encoded_ascii": "^\"x^+~^!O^$s^-s^\"x^))^&:^'l^&I^&Z^!<^%T^'[^)]^\"d^!%^.(^'@^$$^'R^**^!\" ",
      "encoded_base64": "XiJ4Xit+XiFPXiRzXi1zXiJ4XikpXiY6XidsXiZJXiZaXiE8XiVUXidbXildXiJkXiElXi4oXidAXiQkXidSXioqXiEiIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_51e4bf48b25b",
      "text": "城邦痛恨他們，因為他們比城裡人更能吃苦耐勞，而且不肯向 ",
      "encoded_ascii": "^+_^1a^-.^2g^!@^*{^*A^\"]^%{^!@^*{^,m^+_^-j^!<^$o^'b^2^^.t^-S^/R^*A^'W^!*^!)^-Z^+? ",
      "encoded_base64": "XitfXjFhXi0uXjJnXiFAXip7XipBXiJdXiV7XiFAXip7XixtXitfXi1qXiE8XiRvXidiXjJeXi50Xi1TXi9SXipBXidXXiEqXiEpXi1aXis/IA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_ad3efc013df5",
      "text": "泰克圖克提特萊屈膝臣服。 ",
      "encoded_ascii": "^%f^!d^\"b^!d^$A^&5^(!^5K^:<^.s^,\\^!\" ",
      "encoded_base64": "XiVmXiFkXiJiXiFkXiRBXiY1XighXjVLXjo8Xi5zXixcXiEiIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_0c016cc9e60e",
      "text": "他們為什麼要那麼做？我可不會跟一個我不認識的人並肩作戰， ",
      "encoded_ascii": "^!@^*{^%{^!=^.T^(C^)!^.T^*~^.V^$%^\"A^!)^$r^.+^!%^!V^$%^!)^(O^(R^&Z^!<^!+^:#^!M^$(^*A ",
      "encoded_base64": "XiFAXip7XiV7XiE9Xi5UXihDXikhXi5UXip+Xi5WXiQlXiJBXiEpXiRyXi4rXiElXiFWXiQlXiEpXihPXihSXiZaXiE8XiErXjojXiFNXiQoXipBIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_e9f5c4f8c393",
      "text": "其他人也不會。除非你跟某個人生活在一起過，否則你根本不可能 ",
      "encoded_ascii": "^!j^!@^!<^!1^!)^$r^!\"^)Q^)i^*F^.+^%$^!V^!<^&F^%i^\"d^!%^.(^(x^*A^\"H^!x^*F^%)^$x^!)^\"A^'b ",
      "encoded_base64": "XiFqXiFAXiE8XiExXiEpXiRyXiEiXilRXilpXipGXi4rXiUkXiFWXiE8XiZGXiVpXiJkXiElXi4oXih4XipBXiJIXiF4XipGXiUpXiR4XiEpXiJBXidiIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_ef48c4ece0ab",
      "text": "信任他。",
      "encoded_ascii": "^!U^!C^!@^!\"",
      "encoded_base64": "XiFVXiFDXiFAXiEi",
      "byte_length": 12
    },
    {
      "unit_id": "DLG_000baa402f1d",
      "text": "當然不行。有哪個村落能抵擋得了一整支軍隊？",
      "encoded_ascii": "^&N^&\"^!)^(;^!\"^$s^+I^!V^$z^-`^'b^$5^$G^#e^*D^!%^$T^$L^..^)U^.V",
      "encoded_base64": "XiZOXiYiXiEpXig7XiEiXiRzXitJXiFWXiR6Xi1gXidiXiQ1XiRHXiNlXipEXiElXiRUXiRMXi4uXilVXi5W",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_34689988a454",
      "text": "我剛才說的肯定是到處流傳的謠言。 ",
      "encoded_ascii": "^$%^+0^$,^-x^&Z^-Z^#.^,X^!u^(,^%j^+$^&Z^6,^1Y^!\" ",
      "encoded_base64": "XiQlXiswXiQsXi14XiZaXi1aXiMuXixYXiF1XigsXiVqXiskXiZaXjYsXjFZXiEiIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_2fecff958675",
      "text": "我聽說德拉吉正打算徹底收拾那些村落——而且很快就要動手。 ",
      "encoded_ascii": "^$%^-X^-x^#j^$6^\"D^%H^$-^-C^18^/^^$M^7[^)!^!8^$z^-`^*n^*n^'W^!*^*K^*L^*J^(C^\"%^$+^!\" ",
      "encoded_base64": "XiQlXi1YXi14XiNqXiQ2XiJEXiVIXiQtXi1DXjE4Xi9eXiRNXjdbXikhXiE4XiR6Xi1gXipuXipuXidXXiEqXipLXipMXipKXihDXiIlXiQrXiEiIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_026155e4af98",
      "text": "據說要是神廟完工前那些村落還沒被剷除，龍王就會殺了他的宰相—— ",
      "encoded_ascii": "^5T^-x^(C^,X^&w^0[^#,^+y^!z^)!^!8^$z^-`^.7^%\\^(@^2Y^)Q^*A^*>^-)^*J^$r^%M^*D^!@^&Z^1w^&a^*n^*n ",
      "encoded_base64": "XjVUXi14XihDXixYXiZ3XjBbXiMsXit5XiF6XikhXiE4XiR6Xi1gXi43XiVcXihAXjJZXilRXipBXio+Xi0pXipKXiRyXiVNXipEXiFAXiZaXjF3XiZhXipuXipuIA==",
      "byte_length": 94
    },
    {
      "unit_id": "DLG_4ca4ee359d14",
      "text": "而那座神廟就快要建成了。 ",
      "encoded_ascii": "^'W^)!^/_^&w^0[^*J^*L^(C^,'^$$^*D^!\" ",
      "encoded_base64": "XidXXikhXi9fXiZ3XjBbXipKXipMXihDXiwnXiQkXipEXiEiIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_23eba1af353b",
      "text": "沒錯。 ",
      "encoded_ascii": "^%\\^)5^!\" ",
      "encoded_base64": "XiVcXik1XiEiIA==",
      "byte_length": 10
    },
    {
      "unit_id": "DLG_9a63e1e44413",
      "text": "我回到這裡，把發生的一切告訴了聖堂武士長。他 ",
      "encoded_ascii": "^$%^\"\\^!u^(s^-j^*A^$1^&W^&F^&Z^!%^+.^+B^-t^*D^'Z^42^%J^+a^)C^!\"^!@ ",
      "encoded_base64": "XiQlXiJcXiF1XihzXi1qXipBXiQxXiZXXiZGXiZaXiElXisuXitCXi10XipEXidaXjQyXiVKXithXilDXiEiXiFAIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_58f4d0b3f9ad",
      "text": "指責是我策劃了那場伏擊，把我扔進了 ",
      "encoded_ascii": "^$8^0>^,X^$%^5p^4s^*D^)!^\"n^3c^$F^*A^$1^$%^8{^(w^*D ",
      "encoded_base64": "XiQ4XjA+XixYXiQlXjVwXjRzXipEXikhXiJuXjNjXiRGXipBXiQxXiQlXjh7Xih3XipEIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_fef879e04375",
      "text": "奴隸牢欄當角鬥士賣命。現在，我只是負責照料所有的 ",
      "encoded_ascii": "^##^)Z^-$^%C^&N^(H^*,^+a^.$^\"N^!\"^&?^\"d^*A^$%^\"?^,X^(W^0>^/x^/n^$)^$s^&Z ",
      "encoded_base64": "XiMjXilaXi0kXiVDXiZOXihIXiosXithXi4kXiJOXiEiXiY/XiJkXipBXiQlXiI/XixYXihXXjA+Xi94Xi9uXiQpXiRzXiZaIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_d1e6226654ee",
      "text": "角鬥士。",
      "encoded_ascii": "^(H^*,^+a^!\"",
      "encoded_base64": "XihIXiosXithXiEi",
      "byte_length": 12
    },
    {
      "unit_id": "DLG_6755ca188b72",
      "text": "是的，我們確實被伏擊了。托爾螳螂人狩獵群神出鬼沒難以捉摸。只要能得到食物， ",
      "encoded_ascii": "^,X^&Z^*A^$%^*{^-6^#3^(@^3c^$F^*D^!\"^/-^&/^8O^8N^!<^8l^&;^'R^&w^!q^*-^%\\^)a^!B^4>^/j^!\"^\"?^(C^'b^#e^!u^0J^&4^*A ",
      "encoded_base64": "XixYXiZaXipBXiQlXip7Xi02XiMzXihAXjNjXiRGXipEXiEiXi8tXiYvXjhPXjhOXiE8XjhsXiY7XidSXiZ3XiFxXiotXiVcXilhXiFCXjQ+Xi9qXiEiXiI/XihDXidiXiNlXiF1XjBKXiY0XipBIA==",
      "byte_length": 112
    },
    {
      "unit_id": "DLG_b6ade54bf3d0",
      "text": "牠們什麼地方都敢去。 ",
      "encoded_ascii": "^-#^*{^!=^.T^\"e^$]^)$^/m^\"6^!\" ",
      "encoded_base64": "Xi0jXip7XiE9Xi5UXiJlXiRdXikkXi9tXiI2XiEiIA==",
      "byte_length": 31
    },
    {
      "unit_id": "DLG_a3770eaa6c46",
      "text": "不。從來沒有人能從牢欄裡贏得自由。 ",
      "encoded_ascii": "^!)^!\"^#f^!O^%\\^$s^!<^'b^#f^-$^%C^-j^.%^#e^'l^&I^!\" ",
      "encoded_base64": "XiEpXiEiXiNmXiFPXiVcXiRzXiE8XidiXiNmXi0kXiVDXi1qXi4lXiNlXidsXiZJXiEiIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_7e1e6bccb4bc",
      "text": "反正我得趕回去幹活了。",
      "encoded_ascii": "^\"9^%H^$%^#e^0u^\"\\^\"6^,!^%i^*D^!\"",
      "encoded_base64": "XiI5XiVIXiQlXiNlXjB1XiJcXiI2XiwhXiVpXipEXiEi",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_a66506e2d644",
      "text": "你想知道什麼？",
      "encoded_ascii": "^*F^,1^&h^(y^!=^.T^.V",
      "encoded_base64": "XipGXiwxXiZoXih5XiE9Xi5UXi5W",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_ad7b74fb1829",
      "text": "  有人曾從這裡逃出去過嗎？",
      "encoded_ascii": "  ^$s^!<^.j^#f^(s^-j^(p^!q^\"6^(x^+X^.V",
      "encoded_base64": "ICBeJHNeITxeLmpeI2ZeKHNeLWpeKHBeIXFeIjZeKHheK1heLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_1c15e03dd76a",
      "text": "  有人活著離開過這裡嗎？",
      "encoded_ascii": "  ^$s^!<^%i^-a^)`^)F^(x^(s^-j^+X^.V",
      "encoded_base64": "ICBeJHNeITxeJWleLWFeKWBeKUZeKHheKHNeLWpeK1heLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_232c19a554ab",
      "text": "  這裡的防守有多嚴密？",
      "encoded_ascii": "  ^(s^-j^&Z^)K^#+^$s^\"x^1*^#0^.V",
      "encoded_base64": "ICBeKHNeLWpeJlpeKUteIyteJHNeInheMSpeIzBeLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_399605394d9d",
      "text": "  有任何守衛是可以被賄賂的嗎？",
      "encoded_ascii": "  ^$s^!C^!L^#+^(=^,X^\"A^!B^(@^61^60^&Z^+X^.V",
      "encoded_base64": "ICBeJHNeIUNeIUxeIyteKD1eLFheIkFeIUJeKEBeNjFeNjBeJlpeK1heLlY=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_c0af54c4ce31",
      "text": "  這裡有多少守衛？",
      "encoded_ascii": "  ^(s^-j^$s^\"x^#<^#+^(=^.V",
      "encoded_base64": "ICBeKHNeLWpeJHNeInheIzxeIyteKD1eLlY=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_c5ad073be232",
      "text": "  為什麼守衛正在被調走？",
      "encoded_ascii": "  ^%{^!=^.T^#+^(=^%H^\"d^(@^(Q^.&^.V",
      "encoded_base64": "ICBeJXteIT1eLlReIyteKD1eJUheImReKEBeKFFeLiZeLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_7afae8701db2",
      "text": "  誰是奴隸牢欄裡的頭目？",
      "encoded_ascii": "  ^-y^,X^##^)Z^-$^%C^-j^&Z^)t^&^^.V",
      "encoded_base64": "ICBeLXleLFheIyNeKVpeLSReJUNeLWpeJlpeKXReJl5eLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_4cee001c339a",
      "text": "當然有。他們每天都被拖去給農田當肥料。",
      "encoded_ascii": "^&N^&\"^$s^!\"^!@^*{^%P^+e^)$^(@^.f^\"6^'A^4i^;\\^&N^-Y^/n^!\"",
      "encoded_base64": "XiZOXiYiXiRzXiEiXiFAXip7XiVQXitlXikkXihAXi5mXiI2XidBXjRpXjtcXiZOXi1ZXi9uXiEi",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_7f40bcee4f88",
      "text": "有些人確實逃出去了。守衛聲稱抓回了所有人，但我知道有人成功了。 ",
      "encoded_ascii": "^$s^!8^!<^-6^#3^(p^!q^\"6^*D^!\"^#+^(=^-W^0&^$2^\"\\^*D^$)^$s^!<^*A^!I^$%^&h^(y^$s^!<^$$^\"!^*D^!\" ",
      "encoded_base64": "XiRzXiE4XiE8Xi02XiMzXihwXiFxXiI2XipEXiEiXiMrXig9Xi1XXjAmXiQyXiJcXipEXiQpXiRzXiE8XipBXiFJXiQlXiZoXih5XiRzXiE8XiQkXiIhXipEXiEiIA==",
      "byte_length": 94
    },
    {
      "unit_id": "DLG_d1db5e052265",
      "text": "不過他們必須躲藏在沙漠裡。要是留在城裡，聖堂武士 ",
      "encoded_ascii": "^!)^(x^!@^*{^#l^)r^0C^-f^\"d^%]^,}^-j^!\"^(C^,X^-+^\"d^+_^-j^*A^'Z^42^%J^+a ",
      "encoded_base64": "XiEpXih4XiFAXip7XiNsXilyXjBDXi1mXiJkXiVdXix9Xi1qXiEiXihDXixYXi0rXiJkXitfXi1qXipBXidaXjQyXiVKXithIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_2689fe7c9235",
      "text": "遲早會抓住他們。",
      "encoded_ascii": "^.5^,V^$r^$2^*z^!@^*{^!\"",
      "encoded_base64": "Xi41XixWXiRyXiQyXip6XiFAXip7XiEi",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_08fd6af9a8bc",
      "text": "戒備就跟任何奴隸牢欄一樣森嚴。不過在我待在這裡的這些年裡，倒也聽過 ",
      "encoded_ascii": "^$&^+\"^*J^.+^!C^!L^##^)Z^-$^%C^!%^,f^4H^1*^!\"^!)^(x^\"d^$%^,*^\"d^(s^-j^&Z^(s^!8^+~^-j^*A^!X^!1^-X^(x ",
      "encoded_base64": "XiQmXisiXipKXi4rXiFDXiFMXiMjXilaXi0kXiVDXiElXixmXjRIXjEqXiEiXiEpXih4XiJkXiQlXiwqXiJkXihzXi1qXiZaXihzXiE4Xit+Xi1qXipBXiFYXiExXi1YXih4IA==",
      "byte_length": 100
    },
    {
      "unit_id": "DLG_6ce3c2258523",
      "text": "有人逃脫的傳聞。",
      "encoded_ascii": "^$s^!<^(p^'c^&Z^+$^4^^!\"",
      "encoded_base64": "XiRzXiE8XihwXidjXiZaXiskXjReXiEi",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_7e0433711797",
      "text": "負責押送你們去競技場的庫爾扎克很貪財。不過別對他抱太大指望。 ",
      "encoded_ascii": "^(W^0>^7Z^./^*F^*{^\"6^-?^,>^\"n^&Z^,#^&/^,=^!d^*K^1^^0=^!\"^!)^(x^*H^#:^!@^,@^+f^\"z^$8^,]^!\" ",
      "encoded_base64": "XihXXjA+XjdaXi4vXipGXip7XiI2Xi0/Xiw+XiJuXiZaXiwjXiYvXiw9XiFkXipLXjFeXjA9XiEiXiEpXih4XipIXiM6XiFAXixAXitmXiJ6XiQ4XixdXiEiIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_5ef51d7ab9ce",
      "text": "想要買得自由，所需的錢可比你們有的全部加起來還要多得多，才夠 ",
      "encoded_ascii": "^,1^(C^.!^#e^'l^&I^*A^$)^)e^&Z^.<^\"A^,m^*F^*{^$s^&Z^!h^)#^\"\"^.(^!O^.7^(C^\"x^#e^\"x^*A^$,^+d ",
      "encoded_base64": "XiwxXihDXi4hXiNlXidsXiZJXipBXiQpXillXiZaXi48XiJBXixtXipGXip7XiRzXiZaXiFoXikjXiIiXi4oXiFPXi43XihDXiJ4XiNlXiJ4XipBXiQsXitkIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_7f166747f52a",
      "text": "買到自由。",
      "encoded_ascii": "^.!^!u^'l^&I^!\"",
      "encoded_base64": "Xi4hXiF1XidsXiZJXiEi",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_1c2ad359ee24",
      "text": "最近守衛沒有以前那麼多了。他們正在被一批批抽調出去， ",
      "encoded_ascii": "^$q^(l^#+^(=^%\\^$s^!B^!z^)!^.T^\"x^*D^!\"^!@^*{^%H^\"d^(@^!%^2i^2i^*_^(Q^!q^\"6^*A ",
      "encoded_base64": "XiRxXihsXiMrXig9XiVcXiRzXiFCXiF6XikhXi5UXiJ4XipEXiEiXiFAXip7XiVIXiJkXihAXiElXjJpXjJpXipfXihRXiFxXiI2XipBIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_324313497e91",
      "text": "每次調走幾個人。",
      "encoded_ascii": "^%P^%D^(Q^.&^#T^!V^!<^!\"",
      "encoded_base64": "XiVQXiVEXihRXi4mXiNUXiFWXiE8XiEi",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_346b54669369",
      "text": "我不知道。但大軍最近一直在進行大規模訓練。",
      "encoded_ascii": "^$%^!)^&h^(y^!\"^!I^\"z^..^$q^(l^!%^&`^\"d^(w^(;^\"z^6'^%:^-p^-L^!\"",
      "encoded_base64": "XiQlXiEpXiZoXih5XiEiXiFJXiJ6Xi4uXiRxXihsXiElXiZgXiJkXih3Xig7XiJ6XjYnXiU6Xi1wXi1MXiEi",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_94f1a289397b",
      "text": "聖堂武士掌控著所有重大決策，像是決定誰該進競技場廝殺。 ",
      "encoded_ascii": "^'Z^42^%J^+a^$;^$@^-a^$)^$s^))^\"z^,o^5p^*A^!`^,X^,o^#.^-y^(M^(w^-?^,>^\"n^>O^%M^!\" ",
      "encoded_base64": "XidaXjQyXiVKXithXiQ7XiRAXi1hXiQpXiRzXikpXiJ6XixvXjVwXipBXiFgXixYXixvXiMuXi15XihNXih3Xi0/Xiw+XiJuXj5PXiVNXiEiIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_586d314e66dc",
      "text": "庫爾扎克是總守衛長。除此以外，這裡就只有 ",
      "encoded_ascii": "^,#^&/^,=^!d^,X^-M^#+^(=^)C^!\"^)Q^%I^!B^\"w^*A^(s^-j^*J^\"?^$s ",
      "encoded_base64": "XiwjXiYvXiw9XiFkXixYXi1NXiMrXig9XilDXiEiXilRXiVJXiFCXiJ3XipBXihzXi1qXipKXiI/XiRzIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_300e680c4a6a",
      "text": "從事各類雜役的農奴了。",
      "encoded_ascii": "^#f^*r^+>^)w^0G^17^&Z^4i^##^*D^!\"",
      "encoded_base64": "XiNmXipyXis+Xil3XjBHXjE3XiZaXjRpXiMjXipEXiEi",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_6e31eb4d9708",
      "text": "就是 ",
      "encoded_ascii": "^*J^,X ",
      "encoded_base64": "XipKXixYIA==",
      "byte_length": 7
    },
    {
      "unit_id": "DLG_2968c45b90ca",
      "text": "那個獨自坐著的女人。 ",
      "encoded_ascii": "^)!^!V^/z^'l^8E^-a^&Z^#\"^!<^!\" ",
      "encoded_base64": "XikhXiFWXi96XidsXjhFXi1hXiZaXiMiXiE8XiEiIA==",
      "byte_length": 31
    },
    {
      "unit_id": "DLG_69c4b73181d1",
      "text": "疤面和他的手下 ",
      "encoded_ascii": "^5g^)j^\"O^!@^&Z^$+^!( ",
      "encoded_base64": "XjVnXilqXiJPXiFAXiZaXiQrXiEoIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_1a8f8cbf40c9",
      "text": "全都 ",
      "encoded_ascii": "^!h^)$ ",
      "encoded_base64": "XiFoXikkIA==",
      "byte_length": 7
    },
    {
      "unit_id": "DLG_ed3d1ad399ab",
      "text": "過去全都 ",
      "encoded_ascii": "^(x^\"6^!h^)$ ",
      "encoded_base64": "Xih4XiI2XiFoXikkIA==",
      "byte_length": 13
    },
    {
      "unit_id": "DLG_c9a2d1b337ab",
      "text": "關在西南邊的牢房裡。 ",
      "encoded_ascii": "^.>^\"d^-l^\"/^.8^&Z^-$^,<^-j^!\" ",
      "encoded_base64": "Xi4+XiJkXi1sXiIvXi44XiZaXi0kXiw8Xi1qXiEiIA==",
      "byte_length": 31
    },
    {
      "unit_id": "DLG_eec410a62b05",
      "text": "梅爾佐爾和他的手下 ",
      "encoded_ascii": "^%-^&/^>1^&/^\"O^!@^&Z^$+^!( ",
      "encoded_base64": "XiUtXiYvXj4xXiYvXiJPXiFAXiZaXiQrXiEoIA==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_e7df97c7988c",
      "text": "過去一直 ",
      "encoded_ascii": "^(x^\"6^!%^&` ",
      "encoded_base64": "Xih4XiI2XiElXiZgIA==",
      "byte_length": 13
    },
    {
      "unit_id": "DLG_4f0ffea4bde8",
      "text": "盤踞在東北邊。 ",
      "encoded_ascii": "^1M^1_^\"d^,`^+6^.8^!\" ",
      "encoded_base64": "XjFNXjFfXiJkXixgXis2Xi44XiEiIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_3359038fa054",
      "text": "迪諾斯 ",
      "encoded_ascii": "^(m^7k^$[ ",
      "encoded_base64": "XihtXjdrXiRbIA==",
      "byte_length": 10
    },
    {
      "unit_id": "DLG_cdd0eac93581",
      "text": "擁有一間 ",
      "encoded_ascii": "^,M^$s^!%^)G ",
      "encoded_base64": "XixNXiRzXiElXilHIA==",
      "byte_length": 13
    },
    {
      "unit_id": "DLG_6ec68631731f",
      "text": "曾擁有一間 ",
      "encoded_ascii": "^.j^,M^$s^!%^)G ",
      "encoded_base64": "Xi5qXixNXiRzXiElXilHIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_e6532e8233bd",
      "text": "位於西南邊的特殊牢房。 ",
      "encoded_ascii": "^!J^$^^-l^\"/^.8^&Z^&5^9!^-$^,<^!\" ",
      "encoded_base64": "XiFKXiReXi1sXiIvXi44XiZaXiY1XjkhXi0kXiw8XiEiIA==",
      "byte_length": 34
    },
    {
      "unit_id": "DLG_864049ed4859",
      "text": "至於米爾隆那隻狡猾的黃鼠狼， ",
      "encoded_ascii": "^'n^$^^'4^&/^)T^)!^)[^::^>Q^&Z^*7^*=^21^*A ",
      "encoded_base64": "XiduXiReXic0XiYvXilUXikhXilbXjo6Xj5RXiZaXio3Xio9XjIxXipBIA==",
      "byte_length": 43
    },
    {
      "unit_id": "DLG_e2463d221347",
      "text": "待在西邊房間裡的那傢伙。",
      "encoded_ascii": "^,*^\"d^-l^.8^,<^)G^-j^&Z^)!^+#^*y^!\"",
      "encoded_base64": "XiwqXiJkXi1sXi44Xiw8XilHXi1qXiZaXikhXisjXip5XiEi",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_32428950b9a0",
      "text": "這裡真的已經沒有任何活人了。你們把他們全殺光了。",
      "encoded_ascii": "^(s^-j^-2^&Z^#J^'D^%\\^$s^!C^!L^%i^!<^*D^!\"^*F^*{^$1^!@^*{^!h^%M^!c^*D^!\"",
      "encoded_base64": "XihzXi1qXi0yXiZaXiNKXidEXiVcXiRzXiFDXiFMXiVpXiE8XipEXiEiXipGXip7XiQxXiFAXip7XiFoXiVNXiFjXipEXiEi",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_b58dee666cc0",
      "text": "  關於迪諾斯你能告訴我些什麼？",
      "encoded_ascii": "  ^.>^$^^(m^7k^$[^*F^'b^+B^-t^$%^!8^!=^.T^.V",
      "encoded_base64": "ICBeLj5eJF5eKG1eN2teJFteKkZeJ2JeK0JeLXReJCVeITheIT1eLlReLlY=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_db71ad9c75d3",
      "text": "  迪諾斯是個怎樣的人？",
      "encoded_ascii": "  ^(m^7k^$[^,X^!V^,,^,f^&Z^!<^.V",
      "encoded_base64": "ICBeKG1eN2teJFteLFheIVZeLCxeLGZeJlpeITxeLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_8cdf0820eb24",
      "text": "  關於吉拉爾你能告訴我些什麼？",
      "encoded_ascii": "  ^.>^$^^\"D^$6^&/^*F^'b^+B^-t^$%^!8^!=^.T^.V",
      "encoded_base64": "ICBeLj5eJF5eIkReJDZeJi9eKkZeJ2JeK0JeLXReJCVeITheIT1eLlReLlY=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_fd1b83b2e347",
      "text": "  吉拉爾是個怎樣的人？",
      "encoded_ascii": "  ^\"D^$6^&/^,X^!V^,,^,f^&Z^!<^.V",
      "encoded_base64": "ICBeIkReJDZeJi9eLFheIVZeLCxeLGZeJlpeITxeLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_9642fe7a77b0",
      "text": "  關於梅爾佐爾你能告訴我些什麼？",
      "encoded_ascii": "  ^.>^$^^%-^&/^>1^&/^*F^'b^+B^-t^$%^!8^!=^.T^.V",
      "encoded_base64": "ICBeLj5eJF5eJS1eJi9ePjFeJi9eKkZeJ2JeK0JeLXReJCVeITheIT1eLlReLlY=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_802b1b1f45d5",
      "text": "  梅爾佐爾是個怎樣的人？",
      "encoded_ascii": "  ^%-^&/^>1^&/^,X^!V^,,^,f^&Z^!<^.V",
      "encoded_base64": "ICBeJS1eJi9ePjFeJi9eLFheIVZeLCxeLGZeJlpeITxeLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_6e38fe76ba18",
      "text": "  關於米爾隆你能告訴我些什麼？",
      "encoded_ascii": "  ^.>^$^^'4^&/^)T^*F^'b^+B^-t^$%^!8^!=^.T^.V",
      "encoded_base64": "ICBeLj5eJF5eJzReJi9eKVReKkZeJ2JeK0JeLXReJCVeITheIT1eLlReLlY=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_0eec9805d8c4",
      "text": "  米爾隆是個怎樣的人？",
      "encoded_ascii": "  ^'4^&/^)T^,X^!V^,,^,f^&Z^!<^.V",
      "encoded_base64": "ICBeJzReJi9eKVReLFheIVZeLCxeLGZeJlpeITxeLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_ccbc657af374",
      "text": "  關於疤面你能告訴我些什麼？",
      "encoded_ascii": "  ^.>^$^^5g^)j^*F^'b^+B^-t^$%^!8^!=^.T^.V",
      "encoded_base64": "ICBeLj5eJF5eNWdeKWpeKkZeJ2JeK0JeLXReJCVeITheIT1eLlReLlY=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_7a1fec35e89f",
      "text": "  我該如何去找迪諾斯？",
      "encoded_ascii": "  ^$%^(M^#$^!L^\"6^$/^(m^7k^$[^.V",
      "encoded_base64": "ICBeJCVeKE1eIyReIUxeIjZeJC9eKG1eN2teJFteLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_b228a929e4d4",
      "text": "迪諾斯是個廚藝非凡的名廚。 ",
      "encoded_ascii": "^(m^7k^$[^,X^!V^,%^3Z^)i^+-^&Z^\"F^,%^!\" ",
      "encoded_base64": "XihtXjdrXiRbXixYXiFWXiwlXjNaXilpXistXiZaXiJGXiwlXiEiIA==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_2b0c761b24bc",
      "text": "迪諾斯曾是個廚藝非凡的名廚。 ",
      "encoded_ascii": "^(m^7k^$[^.j^,X^!V^,%^3Z^)i^+-^&Z^\"F^,%^!\" ",
      "encoded_base64": "XihtXjdrXiRbXi5qXixYXiFWXiwlXjNaXilpXistXiZaXiJGXiwlXiEiIA==",
      "byte_length": 43
    },
    {
      "unit_id": "DLG_10ad43b96c17",
      "text": "當掌管牢欄的聖堂武士聽聞了他的非凡天賦後， ",
      "encoded_ascii": "^&N^$;^-D^-$^%C^&Z^'Z^42^%J^+a^-X^4^^*D^!@^&Z^)i^+-^+e^(Y^#b^*A ",
      "encoded_base64": "XiZOXiQ7Xi1EXi0kXiVDXiZaXidaXjQyXiVKXithXi1YXjReXipEXiFAXiZaXilpXistXitlXihZXiNiXipBIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_3d9e288921bb",
      "text": "就把迪諾斯收為自己的專屬私人廚師。從那之後迪諾斯就再也沒去競技場 ",
      "encoded_ascii": "^*J^$1^(m^7k^$[^$M^%{^'l^#I^&Z^#8^#C^&~^!<^,%^#M^!\"^#f^)!^!/^#b^(m^7k^$[^*J^!l^!1^%\\^\"6^-?^,>^\"n ",
      "encoded_base64": "XipKXiQxXihtXjdrXiRbXiRNXiV7XidsXiNJXiZaXiM4XiNDXiZ+XiE8XiwlXiNNXiEiXiNmXikhXiEvXiNiXihtXjdrXiRbXipKXiFsXiExXiVcXiI2Xi0/Xiw+XiJuIA==",
      "byte_length": 97
    },
    {
      "unit_id": "DLG_fd215cad6e13",
      "text": "戰鬥過。他被安置在南邊的一套套房裡。 ",
      "encoded_ascii": "^$(^*,^(x^!\"^!@^(@^+p^'Q^\"d^\"/^.8^&Z^!%^#!^#!^,<^-j^!\" ",
      "encoded_base64": "XiQoXiosXih4XiEiXiFAXihAXitwXidRXiJkXiIvXi44XiZaXiElXiMhXiMhXiw8Xi1qXiEiIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_f930468099db",
      "text": "門已經被打開了。就是東南邊的那扇門。",
      "encoded_ascii": "^)D^#J^'D^(@^$-^)F^*D^!\"^*J^,X^,`^\"/^.8^&Z^)!^$*^)D^!\"",
      "encoded_base64": "XilEXiNKXidEXihAXiQtXilGXipEXiEiXipKXixYXixgXiIvXi44XiZaXikhXiQqXilEXiEi",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_ec672a27b60c",
      "text": "我有鑰匙。往南走——我馬上就到。 ",
      "encoded_ascii": "^$%^$s^)@^\"*^!\"^,)^\"/^.&^*n^*n^$%^*\"^!'^*J^!u^!\" ",
      "encoded_base64": "XiQlXiRzXilAXiIqXiEiXiwpXiIvXi4mXipuXipuXiQlXioiXiEnXipKXiF1XiEiIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_2333600d5731",
      "text": "你想去見見迪諾斯嗎？",
      "encoded_ascii": "^*F^,1^\"6^-m^-m^(m^7k^$[^+X^.V",
      "encoded_base64": "XipGXiwxXiI2Xi1tXi1tXihtXjdrXiRbXitYXi5W",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_33123df2fa5e",
      "text": "她是一個離奇古怪的例子。她在這裡待了一週，在競技場的對決中奮戰。 ",
      "encoded_ascii": "^+h^,X^!%^!V^)`^\"}^\"=^#s^&Z^9h^#(^!\"^+h^\"d^(s^-j^,*^*D^!%^6|^*A^\"d^-?^,>^\"n^&Z^#:^,o^!,^+g^$(^!\" ",
      "encoded_base64": "XitoXixYXiElXiFWXilgXiJ9XiI9XiNzXiZaXjloXiMoXiEiXitoXiJkXihzXi1qXiwqXipEXiElXjZ8XipBXiJkXi0/Xiw+XiJuXiZaXiM6XixvXiEsXitnXiQoXiEiIA==",
      "byte_length": 97
    },
    {
      "unit_id": "DLG_73a967efacc1",
      "text": "後來她失蹤了大約一週，從那之後整個人就變得完全判若兩人了。 ",
      "encoded_ascii": "^#b^!O^+h^\"|^(b^*D^\"z^-F^!%^6|^*A^#f^)!^!/^#b^$T^!V^!<^*J^(U^#e^#,^!h^1k^'x^!i^!<^*D^!\" ",
      "encoded_base64": "XiNiXiFPXitoXiJ8XihiXipEXiJ6Xi1GXiElXjZ8XipBXiNmXikhXiEvXiNiXiRUXiFWXiE8XipKXihVXiNlXiMsXiFoXjFrXid4XiFpXiE8XipEXiEiIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_ff3607c1e70e",
      "text": "她就只是坐在那裡，不跟任何人說話。",
      "encoded_ascii": "^+h^*J^\"?^,X^8E^\"d^)!^-j^*A^!)^.+^!C^!L^!<^-x^-v^!\"",
      "encoded_base64": "XitoXipKXiI/XixYXjhFXiJkXikhXi1qXipBXiEpXi4rXiFDXiFMXiE8Xi14Xi12XiEi",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_ef9518835883",
      "text": "她大概是唯一能告訴你們如何逃脫的奴隸了。 ",
      "encoded_ascii": "^+h^\"z^,d^,X^+O^!%^'b^+B^-t^*F^*{^#$^!L^(p^'c^&Z^##^)Z^*D^!\" ",
      "encoded_base64": "XitoXiJ6XixkXixYXitPXiElXidiXitCXi10XipGXip7XiMkXiFMXihwXidjXiZaXiMjXilaXipEXiEiIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_9409855b16b9",
      "text": "她失蹤了一週，聖堂武士最後把她帶了回來。 ",
      "encoded_ascii": "^+h^\"|^(b^*D^!%^6|^*A^'Z^42^%J^+a^$q^#b^$1^+h^#N^*D^\"\\^!O^!\" ",
      "encoded_base64": "XitoXiJ8XihiXipEXiElXjZ8XipBXidaXjQyXiVKXithXiRxXiNiXiQxXitoXiNOXipEXiJcXiFPXiEiIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_ec64dae88e9d",
      "text": "從那之後她就一直非常安靜。 ",
      "encoded_ascii": "^#f^)!^!/^#b^+h^*J^!%^&`^)i^#O^+p^)h^!\" ",
      "encoded_base64": "XiNmXikhXiEvXiNiXitoXipKXiElXiZgXilpXiNPXitwXiloXiEiIA==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_572b3f29e2d0",
      "text": "米爾隆野心勃勃，但他就是個卑劣的毒菌小人。表現得極為 ",
      "encoded_ascii": "^'4^&/^)T^.:^#k^>M^>M^*A^!I^!@^*J^,X^!V^\".^+2^&Z^%Q^9M^#;^!<^!\"^-i^&?^#e^1D^%{ ",
      "encoded_base64": "Xic0XiYvXilUXi46XiNrXj5NXj5NXipBXiFJXiFAXipKXixYXiFWXiIuXisyXiZaXiVRXjlNXiM7XiE8XiEiXi1pXiY/XiNlXjFEXiV7IA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_ea280898476b",
      "text": "甜蜜又友善，直到他能從你身上撈到油水為止。 ",
      "encoded_ascii": "^>R^>T^+;^\"8^1(^*A^&`^!u^!@^'b^#f^*F^(c^!'^5S^!u^%^^%V^%{^%G^!\" ",
      "encoded_base64": "Xj5SXj5UXis7XiI4XjEoXipBXiZgXiF1XiFAXidiXiNmXipGXihjXiEnXjVTXiF1XiVeXiVWXiV7XiVHXiEiIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_fa75d0177e66",
      "text": "只要能賺五枚陶幣，他連自己的親兄弟都肯賣。 ",
      "encoded_ascii": "^\"?^(C^'b^7m^!6^$~^)R^+|^*A^!@^.0^'l^#I^&Z^(F^1!^16^)$^-Z^.$^!\" ",
      "encoded_base64": "XiI/XihDXidiXjdtXiE2XiR+XilSXit8XipBXiFAXi4wXidsXiNJXiZaXihGXjEhXjE2XikkXi1aXi4kXiEiIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_55c33fbd69af",
      "text": "你們宰了他真是大快人心。他就是個卑劣的毒菌小人， ",
      "encoded_ascii": "^*F^*{^1w^*D^!@^-2^,X^\"z^*L^!<^#k^!\"^!@^*J^,X^!V^\".^+2^&Z^%Q^9M^#;^!<^*A ",
      "encoded_base64": "XipGXip7XjF3XipEXiFAXi0yXixYXiJ6XipMXiE8XiNrXiEiXiFAXipKXixYXiFWXiIuXisyXiZaXiVRXjlNXiM7XiE8XipBIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_de84f3727974",
      "text": "他死了我很高興。 ",
      "encoded_ascii": "^!@^%L^*D^$%^*K^*+^-]^!\" ",
      "encoded_base64": "XiFAXiVMXipEXiQlXipLXiorXi1dXiEiIA==",
      "byte_length": 25
    },
    {
      "unit_id": "DLG_7ac72e5b342c",
      "text": "疤面是這裡最強悍的角鬥士，也是競技場裡最受群眾喜愛的 ",
      "encoded_ascii": "^5g^)j^,X^(s^-j^$q^#]^,-^&Z^(H^*,^+a^*A^!1^,X^-?^,>^\"n^-j^$q^\";^'R^&e^+V^,2^&Z ",
      "encoded_base64": "XjVnXilqXixYXihzXi1qXiRxXiNdXiwtXiZaXihIXiosXithXipBXiExXixYXi0/Xiw+XiJuXi1qXiRxXiI7XidSXiZlXitWXiwyXiZaIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_3648431f8971",
      "text": "明星。他統治著內層的奴隸牢欄。  ",
      "encoded_ascii": "^$c^$e^!\"^!@^'B^%_^-a^!g^#B^&Z^##^)Z^-$^%C^!\"  ",
      "encoded_base64": "XiRjXiRlXiEiXiFAXidCXiVfXi1hXiFnXiNCXiZaXiMjXilaXi0kXiVDXiEiICA=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_b69a8ae5554c",
      "text": "他曾統治著奴隸牢欄。他很強悍，但也講求公平。 ",
      "encoded_ascii": "^!@^.j^'B^%_^-a^##^)Z^-$^%C^!\"^!@^*K^#]^,-^*A^!I^!1^6+^,n^3:^0Y^!\" ",
      "encoded_base64": "XiFAXi5qXidCXiVfXi1hXiMjXilaXi0kXiVDXiEiXiFAXipLXiNdXiwtXipBXiFJXiExXjYrXixuXjM6XjBZXiEiIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_b25ae0bb2665",
      "text": "他是個勇猛的戰士，但腦袋不太靈光。他的幫眾很忠誠，由一些 ",
      "encoded_ascii": "^!@^,X^!V^\"$^*P^&Z^$(^+a^*A^!I^2@^(?^!)^+f^)g^!c^!\"^!@^&Z^+}^&e^*K^.d^2E^*A^&I^!%^!8 ",
      "encoded_base64": "XiFAXixYXiFWXiIkXipQXiZaXiQoXithXipBXiFJXjJAXig/XiEpXitmXilnXiFjXiEiXiFAXiZaXit9XiZlXipLXi5kXjJFXipBXiZJXiElXiE4IA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_f4781f9c227f",
      "text": "競技場裡頂尖的角鬥士組成。他本該成為這座牢欄的霸主， ",
      "encoded_ascii": "^-?^,>^\"n^-j^)p^#=^&Z^(H^*,^+a^2;^$$^!\"^!@^$x^(M^$$^%{^(s^/_^-$^%C^&Z^33^!-^*A ",
      "encoded_base64": "Xi0/Xiw+XiJuXi1qXilwXiM9XiZaXihIXiosXithXjI7XiQkXiEiXiFAXiR4XihNXiQkXiV7XihzXi9fXi0kXiVDXiZaXjMzXiEtXipBIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_872302dde3eb",
      "text": "但疤面的幫派紀律更嚴明，而且團隊配合得更好。 ",
      "encoded_ascii": "^!I^5g^)j^&Z^+}^.n^2:^7W^$o^1*^$c^*A^'W^!*^0V^)U^)&^\"C^#e^$o^+i^!\" ",
      "encoded_base64": "XiFJXjVnXilqXiZaXit9Xi5uXjI6XjdXXiRvXjEqXiRjXipBXidXXiEqXjBWXilVXikmXiJDXiNlXiRvXitpXiEiIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_552f1945068a",
      "text": "他過去是個橫行霸道的惡霸，但確實是個出色的角鬥士——僅次於疤面。 ",
      "encoded_ascii": "^!@^(x^\"6^,X^!V^/2^(;^33^(y^&Z^#y^33^*A^!I^-6^#3^,X^!V^!q^'s^&Z^(H^*,^+a^*n^*n^!_^%D^$^^5g^)j^!\" ",
      "encoded_base64": "XiFAXih4XiI2XixYXiFWXi8yXig7XjMzXih5XiZaXiN5XjMzXipBXiFJXi02XiMzXixYXiFWXiFxXidzXiZaXihIXiosXithXipuXipuXiFfXiVEXiReXjVnXilqXiEiIA==",
      "byte_length": 97
    },
    {
      "unit_id": "DLG_6b8e06975ff4",
      "text": "已經過了這麼久了。不過我相信我還記得。",
      "encoded_ascii": "^#J^'D^(x^*D^(s^.T^!.^*D^!\"^!)^(x^$%^&a^!U^$%^.7^(K^#e^!\"",
      "encoded_base64": "XiNKXidEXih4XipEXihzXi5UXiEuXipEXiEiXiEpXih4XiQlXiZhXiFVXiQlXi43XihLXiNlXiEi",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_d99385228f0e",
      "text": "  周邊一帶有些什麼？",
      "encoded_ascii": "  ^\"L^.8^!%^#N^$s^!8^!=^.T^.V",
      "encoded_base64": "ICBeIkxeLjheISVeI05eJHNeITheIT1eLlReLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_ec49905f9a0e",
      "text": "  那裡有哪些類型的地形？",
      "encoded_ascii": "  ^)!^-j^$s^+I^!8^)w^\"j^&Z^\"e^#_^.V",
      "encoded_base64": "ICBeKSFeLWpeJHNeK0leITheKXdeImpeJlpeImVeI19eLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_5287c36a5e23",
      "text": "  附近有任何城邦嗎？",
      "encoded_ascii": "  ^.?^(l^$s^!C^!L^+_^1a^+X^.V",
      "encoded_base64": "ICBeLj9eKGxeJHNeIUNeIUxeK19eMWFeK1heLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_5f69b6c6e79d",
      "text": "  軍隊？什麼軍隊？",
      "encoded_ascii": "  ^..^)U^.V^!=^.T^..^)U^.V",
      "encoded_base64": "ICBeLi5eKVVeLlZeIT1eLlReLi5eKVVeLlY=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_bda558ded853",
      "text": "  跟我說說這個傳聞。",
      "encoded_ascii": "  ^.+^$%^-x^-x^(s^!V^+$^4^^!\"",
      "encoded_base64": "ICBeLiteJCVeLXheLXheKHNeIVZeKyReNF5eISI=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_808d4e7ce118",
      "text": "嗯，就是泰克圖克提特萊正派遣大軍去踏平那些 ",
      "encoded_ascii": "^6N^*A^*J^,X^%f^!d^\"b^!d^$A^&5^(!^%H^.n^4k^\"z^..^\"6^.,^0Y^)!^!8 ",
      "encoded_base64": "XjZOXipBXipKXixYXiVmXiFkXiJiXiFkXiRBXiY1XighXiVIXi5uXjRrXiJ6Xi4uXiI2Xi4sXjBZXikhXiE4IA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_83ef487eb8be",
      "text": "奴隸村落。不過也就僅此而已了。",
      "encoded_ascii": "^##^)Z^$z^-`^!\"^!)^(x^!1^*J^!_^%I^'W^#J^*D^!\"",
      "encoded_base64": "XiMjXilaXiR6Xi1gXiEiXiEpXih4XiExXipKXiFfXiVJXidXXiNKXipEXiEi",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_79eb7725cc9d",
      "text": "噢！沒什麼。我不該多嘴的。只是我聽來的一個謠言罷了。反正很可能 ",
      "encoded_ascii": "^+]^*W^%\\^!=^.T^!\"^$%^!)^(M^\"x^+[^&Z^!\"^\"?^,X^$%^-X^!O^&Z^!%^!V^6,^1Y^1Q^*D^!\"^\"9^%H^*K^\"A^'b ",
      "encoded_base64": "XitdXipXXiVcXiE9Xi5UXiEiXiQlXiEpXihNXiJ4XitbXiZaXiEiXiI/XixYXiQlXi1YXiFPXiZaXiElXiFWXjYsXjFZXjFRXipEXiEiXiI5XiVIXipLXiJBXidiIA==",
      "byte_length": 94
    },
    {
      "unit_id": "DLG_2129246e15ca",
      "text": "不是真的。",
      "encoded_ascii": "^!)^,X^-2^&Z^!\"",
      "encoded_base64": "XiEpXixYXi0yXiZaXiEi",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_189b28870e53",
      "text": "沒什麼特別的。農田是靠近德拉吉城唯一值得一提的 ",
      "encoded_ascii": "^%\\^!=^.T^&5^*H^&Z^!\"^4i^;\\^,X^.C^(l^#j^$6^\"D^+_^+O^!%^!Z^#e^!%^$A^&Z ",
      "encoded_base64": "XiVcXiE9Xi5UXiY1XipIXiZaXiEiXjRpXjtcXixYXi5DXihsXiNqXiQ2XiJEXitfXitPXiElXiFaXiNlXiElXiRBXiZaIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_0d3936b3b2f6",
      "text": "區域了。只有農奴在那裡辛勤勞作，照料他們的莊稼。 ",
      "encoded_ascii": "^\"+^\"k^*D^!\"^\"?^$s^4i^##^\"d^)!^-j^6z^2Z^/R^!M^*A^/x^/n^!@^*{^&Z^6l^9a^!\" ",
      "encoded_base64": "XiIrXiJrXipEXiEiXiI/XiRzXjRpXiMjXiJkXikhXi1qXjZ6XjJaXi9SXiFNXipBXi94Xi9uXiFAXip7XiZaXjZsXjlhXiEiIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_3d2023eaad05",
      "text": "那裡有沙地、粉塵海、紅砂岩以及熔岩區域。 ",
      "encoded_ascii": "^)!^-j^$s^%]^\"e^!!^'5^\"p^6`^!!^3!^<-^#D^!B^\"7^&#^#D^\"+^\"k^!\" ",
      "encoded_base64": "XikhXi1qXiRzXiVdXiJlXiEhXic1XiJwXjZgXiEhXjMhXjwtXiNEXiFCXiI3XiYjXiNEXiIrXiJrXiEiIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_e0f4f9c33dc8",
      "text": "據我所記得的，周圍有幾座村落。一座沿著 ",
      "encoded_ascii": "^5T^$%^$)^(K^#e^&Z^*A^\"L^\"`^$s^#T^/_^$z^-`^!\"^!%^/_^%`^-a ",
      "encoded_base64": "XjVUXiQlXiQpXihLXiNlXiZaXipBXiJMXiJgXiRzXiNUXi9fXiR6Xi1gXiEiXiElXi9fXiVgXi1hIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_320c3c0a45f9",
      "text": "粉塵海邊緣，一座在彩繪荒原裡，還有一座就在 ",
      "encoded_ascii": "^'5^\"p^6`^.8^9J^*A^!%^/_^\"d^#`^0,^1W^\"5^-j^*A^.7^$s^!%^/_^*J^\"d ",
      "encoded_base64": "Xic1XiJwXjZgXi44XjlKXipBXiElXi9fXiJkXiNgXjAsXjFXXiI1Xi1qXipBXi43XiRzXiElXi9fXipKXiJkIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_f638aeb339aa",
      "text": "我們正北方的沙質沙漠正中央。我不知道他們到底是怎麼在那種鬼地方 ",
      "encoded_ascii": "^$%^*{^%H^+6^$]^&Z^%]^(Z^%]^,}^%H^!,^5@^!\"^$%^!)^&h^(y^!@^*{^!u^/^^,X^,,^.T^\"d^)!^'$^*-^\"e^$] ",
      "encoded_base64": "XiQlXip7XiVIXis2XiRdXiZaXiVdXihaXiVdXix9XiVIXiEsXjVAXiEiXiQlXiEpXiZoXih5XiFAXip7XiF1Xi9eXixYXiwsXi5UXiJkXikhXickXiotXiJlXiRdIA==",
      "byte_length": 94
    },
    {
      "unit_id": "DLG_b9d15f374fae",
      "text": "存活下來的。在泰克圖克提特萊的大軍出征時，我們正北方的那個很可能將會是第一個 ",
      "encoded_ascii": "^#*^%i^!(^!O^&Z^!\"^\"d^%f^!d^\"b^!d^$A^&5^(!^&Z^\"z^..^!q^.c^$f^*A^$%^*{^%H^+6^$]^&Z^)!^!V^*K^\"A^'b^#7^$r^,X^',^!%^!V ",
      "encoded_base64": "XiMqXiVpXiEoXiFPXiZaXiEiXiJkXiVmXiFkXiJiXiFkXiRBXiY1XighXiZaXiJ6Xi4uXiFxXi5jXiRmXipBXiQlXip7XiVIXis2XiRdXiZaXikhXiFWXipLXiJBXidiXiM3XiRyXixYXicsXiElXiFWIA==",
      "byte_length": 115
    },
    {
      "unit_id": "DLG_7fcc1c02368d",
      "text": "被消滅的。",
      "encoded_ascii": "^(@^%k^%t^&Z^!\"",
      "encoded_base64": "XihAXiVrXiV0XiZaXiEi",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_e3e3d43f57df",
      "text": "回頭見。 ",
      "encoded_ascii": "^\"\\^)t^-m^!\" ",
      "encoded_base64": "XiJcXil0Xi1tXiEiIA==",
      "byte_length": 13
    },
    {
      "unit_id": "DLG_f78fa3c866f7",
      "text": "噢，是你們！你們在這裡做什麼？ ",
      "encoded_ascii": "^+]^*A^,X^*F^*{^*W^*F^*{^\"d^(s^-j^*~^!=^.T^.V ",
      "encoded_base64": "XitdXipBXixYXipGXip7XipXXipGXip7XiJkXihzXi1qXip+XiE9Xi5UXi5WIA==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_8740b1e2ff39",
      "text": "  我正在尋找情報。 ",
      "encoded_ascii": "  ^$%^%H^\"d^#9^$/^,0^+`^!\" ",
      "encoded_base64": "ICBeJCVeJUheImReIzleJC9eLDBeK2BeISIg",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_d812b5f303f9",
      "text": "  我只是想隨處到處看看。 ",
      "encoded_ascii": "  ^$%^\"?^,X^,1^)X^(,^!u^(,^*Q^*Q^!\" ",
      "encoded_base64": "ICBeJCVeIj9eLFheLDFeKVheKCxeIXVeKCxeKlFeKlFeISIg",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_d730c8957522",
      "text": "  我回來救你們所有人了！ ",
      "encoded_ascii": "  ^$%^\"\\^!O^,Q^*F^*{^$)^$s^!<^*D^*W ",
      "encoded_base64": "ICBeJCVeIlxeIU9eLFFeKkZeKnteJCleJHNeITxeKkReKlcg",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_7fafd47c22b7",
      "text": "將特權管事從刑具上鬆綁解救下來嗎？ ",
      "encoded_ascii": "^#7^&5^1E^-D^*r^#f^9|^!k^!'^.R^-K^(I^,Q^!(^!O^+X^.V ",
      "encoded_base64": "XiM3XiY1XjFFXi1EXipyXiNmXjl8XiFrXiEnXi5SXi1LXihJXixRXiEoXiFPXitYXi5WIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_b010f30a40ad",
      "text": "嗯，要是我能舒服一點的話，我肯定能說得流暢得多……比方說， ",
      "encoded_ascii": "^6N^*A^(C^,X^$%^'b^</^,\\^!%^*;^&Z^-v^*A^$%^-Z^#.^'b^-x^#e^%j^7x^#e^\"x^*o^*o^,m^$]^-x^*A ",
      "encoded_base64": "XjZOXipBXihDXixYXiQlXidiXjwvXixcXiElXio7XiZaXi12XipBXiQlXi1aXiMuXidiXi14XiNlXiVqXjd4XiNlXiJ4XipvXipvXixtXiRdXi14XipBIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_95918dae8e05",
      "text": "先把我和這個刑具分開，放我下來。 ",
      "encoded_ascii": "^!b^$1^$%^\"O^(s^!V^9|^!k^!s^)F^*A^$P^$%^!(^!O^!\" ",
      "encoded_base64": "XiFiXiQxXiQlXiJPXihzXiFWXjl8XiFrXiFzXilGXipBXiRQXiQlXiEoXiFPXiEiIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_5de7c929e4b8",
      "text": "讓我帶你們參觀一下周圍的環境吧：這東西叫做 ",
      "encoded_ascii": "^-}^$%^#N^*F^*{^6K^*R^!%^!(^\"L^\"`^&Z^&B^\"q^*I^*B^(s^,`^-l^+<^*~ ",
      "encoded_base64": "Xi19XiQlXiNOXipGXip7XjZLXipSXiElXiEoXiJMXiJgXiZaXiZCXiJxXipJXipCXihzXixgXi1sXis8Xip+IA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_6e8c905164f5",
      "text": "「拉肢架」——是件刑具。痛得要命。那邊的是具 ",
      "encoded_ascii": "^!#^$6^;5^%\"^!$^*n^*n^,X^.W^9|^!k^!\"^-.^#e^(C^\"N^!\"^)!^.8^&Z^,X^!k ",
      "encoded_base64": "XiEjXiQ2Xjs1XiUiXiEkXipuXipuXixYXi5XXjl8XiFrXiEiXi0uXiNlXihDXiJOXiEiXikhXi44XiZaXixYXiFrIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_e4e470b917ea",
      "text": "鐵處女——那玩意兒也痛得要死。有時候他們還會把你的腦袋塞進那些 ",
      "encoded_ascii": "^)?^(,^#\"^*n^*n^)!^4U^#z^++^!1^-.^#e^(C^%L^!\"^$s^$f^*|^!@^*{^.7^$r^$1^*F^&Z^2@^(?^/(^(w^)!^!8 ",
      "encoded_base64": "Xik/XigsXiMiXipuXipuXikhXjRVXiN6XisrXiExXi0uXiNlXihDXiVMXiEiXiRzXiRmXip8XiFAXip7Xi43XiRyXiQxXipGXiZaXjJAXig/Xi8oXih3XikhXiE4IA==",
      "byte_length": 94
    },
    {
      "unit_id": "DLG_bddc30a3fdfc",
      "text": "鐵籠子裡。不過我忘了那些籠子叫什麼了。 ",
      "encoded_ascii": "^)?^'3^#(^-j^!\"^!)^(x^$%^0]^*D^)!^!8^'3^#(^+<^!=^.T^*D^!\" ",
      "encoded_base64": "Xik/XiczXiMoXi1qXiEiXiEpXih4XiQlXjBdXipEXikhXiE4XiczXiMoXis8XiE9Xi5UXipEXiEiIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_13656a2e7945",
      "text": "除了我以外，他們把所有人都殺了。那麼，你們還在等什麼？ ",
      "encoded_ascii": "^)Q^*D^$%^!B^\"w^*A^!@^*{^$1^$)^$s^!<^)$^%M^*D^!\"^)!^.T^*A^*F^*{^.7^\"d^'-^!=^.T^.V ",
      "encoded_base64": "XilRXipEXiQlXiFCXiJ3XipBXiFAXip7XiQxXiQpXiRzXiE8XikkXiVNXipEXiEiXikhXi5UXipBXipGXip7Xi43XiJkXictXiE9Xi5UXi5WIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_a118d13e00ff",
      "text": "快救我！ ",
      "encoded_ascii": "^*L^,Q^$%^*W ",
      "encoded_base64": "XipMXixRXiQlXipXIA==",
      "byte_length": 13
    },
    {
      "unit_id": "DLG_808e08bde8b1",
      "text": "等等——別把我就這樣扔在這裡！ ",
      "encoded_ascii": "^'-^'-^*n^*n^*H^$1^$%^*J^(s^,f^8{^\"d^(s^-j^*W ",
      "encoded_base64": "XictXictXipuXipuXipIXiQxXiQlXipKXihzXixmXjh7XiJkXihzXi1qXipXIA==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_e9bfbd7fc62e",
      "text": "我找不到我的鑰匙了！太可怕了，我必須找到它。 ",
      "encoded_ascii": "^$%^$/^!)^!u^$%^&Z^)@^\"*^*D^*W^+f^\"A^0^^*D^*A^$%^#l^)r^$/^!u^+o^!\" ",
      "encoded_base64": "XiQlXiQvXiEpXiF1XiQlXiZaXilAXiIqXipEXipXXitmXiJBXjBeXipEXipBXiQlXiNsXilyXiQvXiF1XitvXiEiIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_de129335fa60",
      "text": "就是牢欄南面牆上的那扇門。我馬上就到，等等我。 ",
      "encoded_ascii": "^*J^,X^-$^%C^\"/^)j^&0^!'^&Z^)!^$*^)D^!\"^$%^*\"^!'^*J^!u^*A^'-^'-^$%^!\" ",
      "encoded_base64": "XipKXixYXi0kXiVDXiIvXilqXiYwXiEnXiZaXikhXiQqXilEXiEiXiQlXioiXiEnXipKXiF1XipBXictXictXiQlXiEiIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_ad1541f04b43",
      "text": "皮鞭手下留情！我這就去！ ",
      "encoded_ascii": "^&[^)m^$+^!(^-+^,0^*W^$%^(s^*J^\"6^*W ",
      "encoded_base64": "XiZbXiltXiQrXiEoXi0rXiwwXipXXiQlXihzXipKXiI2XipXIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_3e45d03ab370",
      "text": "我得趕快逃離這裡！告辭！ ",
      "encoded_ascii": "^$%^#e^0u^*L^(p^)`^(s^-j^*W^+B^2M^*W ",
      "encoded_base64": "XiQlXiNlXjB1XipMXihwXilgXihzXi1qXipXXitCXjJNXipXIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_fb9445469fc3",
      "text": "這樣舒服多了！噢，剛才痛死我了！ ",
      "encoded_ascii": "^(s^,f^</^,\\^\"x^*D^*W^+]^*A^+0^$,^-.^%L^$%^*D^*W ",
      "encoded_base64": "XihzXixmXjwvXixcXiJ4XipEXipXXitdXipBXiswXiQsXi0uXiVMXiQlXipEXipXIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_4a3052c21626",
      "text": "  關於襲擊村落的事是怎麼回事？ ",
      "encoded_ascii": "  ^.>^$^^08^$F^$z^-`^&Z^*r^,X^,,^.T^\"\\^*r^.V ",
      "encoded_base64": "ICBeLj5eJF5eMDheJEZeJHpeLWBeJlpeKnJeLFheLCxeLlReIlxeKnJeLlYg",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_9e17f5023f89",
      "text": "  為什麼唯獨你倖免於難？ ",
      "encoded_ascii": "  ^%{^!=^.T^+O^/z^*F^5+^!e^$^^)a^.V ",
      "encoded_base64": "ICBeJXteIT1eLlReK09eL3peKkZeNSteIWVeJF5eKWFeLlYg",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_33031966aae8",
      "text": "  其他人都在哪裡？ ",
      "encoded_ascii": "  ^!j^!@^!<^)$^\"d^+I^-j^.V ",
      "encoded_base64": "ICBeIWpeIUBeITxeKSReImReK0leLWpeLlYg",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_7109ef300859",
      "text": "  所有人？",
      "encoded_ascii": "  ^$)^$s^!<^.V",
      "encoded_base64": "ICBeJCleJHNeITxeLlY=",
      "byte_length": 14
    },
    {
      "unit_id": "DLG_9703ab168561",
      "text": "德拉吉查出了三座奴隸村落的位置：塞德利特、 ",
      "encoded_ascii": "^#j^$6^\"D^%&^!q^*D^!&^/_^##^)Z^$z^-`^&Z^!J^'Q^*B^/(^#j^!t^&5^!! ",
      "encoded_base64": "XiNqXiQ2XiJEXiUmXiFxXipEXiEmXi9fXiMjXilaXiR6Xi1gXiZaXiFKXidRXipCXi8oXiNqXiF0XiY1XiEhIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_37da342ea7a9",
      "text": "提奎茲爾以及蓋德隆。不過襲擊將會從提奎茲爾開始。 ",
      "encoded_ascii": "^$A^5B^/D^&/^!B^\"7^-d^#j^)T^!\"^!)^(x^08^$F^#7^$r^#f^$A^5B^/D^&/^)F^+k^!\" ",
      "encoded_base64": "XiRBXjVCXi9EXiYvXiFCXiI3Xi1kXiNqXilUXiEiXiEpXih4XjA4XiRGXiM3XiRyXiNmXiRBXjVCXi9EXiYvXilGXitrXiEiIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_5a2c31adf60e",
      "text": "所有不肯淪為奴隸的人都將被處決殺死。 ",
      "encoded_ascii": "^$)^$s^!)^-Z^2)^%{^##^)Z^&Z^!<^)$^#7^(@^(,^,o^%M^%L^!\" ",
      "encoded_base64": "XiQpXiRzXiEpXi1aXjIpXiV7XiMjXilaXiZaXiE8XikkXiM3XihAXigsXixvXiVNXiVMXiEiIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_5db3eab04d61",
      "text": "  你是怎麼知道這些的？ ",
      "encoded_ascii": "  ^*F^,X^,,^.T^&h^(y^(s^!8^&Z^.V ",
      "encoded_base64": "ICBeKkZeLFheLCxeLlReJmheKHleKHNeITheJlpeLlYg",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_6dc2352c0024",
      "text": "  但我並不是面紗同盟的一員！ ",
      "encoded_ascii": "  ^!I^$%^!+^!)^,X^)j^-G^\"E^-0^&Z^!%^+G^*W ",
      "encoded_base64": "ICBeIUleJCVeISteISleLFheKWpeLUdeIkVeLTBeJlpeISVeK0deKlcg",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_07537e165afd",
      "text": "  在某種程度上，我就是同盟。 ",
      "encoded_ascii": "  ^\"d^%$^'$^'#^#V^!'^*A^$%^*J^,X^\"E^-0^!\" ",
      "encoded_base64": "ICBeImReJSReJyReJyNeI1ZeISdeKkFeJCVeKkpeLFheIkVeLTBeISIg",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_1d2b971d4a5a",
      "text": "  那不關我的事。 ",
      "encoded_ascii": "  ^)!^!)^.>^$%^&Z^*r^!\" ",
      "encoded_base64": "ICBeKSFeISleLj5eJCVeJlpeKnJeISIg",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_fe92b7f7f43e",
      "text": "  我們換個話題吧。 ",
      "encoded_ascii": "  ^$%^*{^4@^!V^-v^.G^*I^!\" ",
      "encoded_base64": "ICBeJCVeKnteNEBeIVZeLXZeLkdeKkleISIg",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_e6f45106f5cb",
      "text": "我可不算被饒了一命。受過專門訓練的拷問專家需要時間， ",
      "encoded_ascii": "^$%^\"A^!)^-C^(@^.M^*D^!%^\"N^!\"^\";^(x^#8^)D^-p^-L^&Z^*b^*Z^#8^+s^)e^(C^$f^)G^*A ",
      "encoded_base64": "XiQlXiJBXiEpXi1DXihAXi5NXipEXiElXiJOXiEiXiI7Xih4XiM4XilEXi1wXi1MXiZaXipiXipaXiM4XitzXillXihDXiRmXilHXipBIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_84582fe4e32c",
      "text": "才能好好地逐一審問並把二十名囚犯嚴刑拷打致死。他們只是 ",
      "encoded_ascii": "^$,^'b^+i^+i^\"e^(r^!%^7V^*Z^!+^$1^!5^*Y^\"F^\"Z^-%^1*^9|^*b^$-^'o^%L^!\"^!@^*{^\"?^,X ",
      "encoded_base64": "XiQsXidiXitpXitpXiJlXihyXiElXjdWXipaXiErXiQxXiE1XipZXiJGXiJaXi0lXjEqXjl8XipiXiQtXidvXiVMXiEiXiFAXip7XiI/XixYIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_2fe95862e09b",
      "text": "還沒輪到把我折磨死罷了。 ",
      "encoded_ascii": "^.7^%\\^(h^!u^$1^$%^,?^-7^%L^1Q^*D^!\" ",
      "encoded_base64": "Xi43XiVcXihoXiF1XiQxXiQlXiw/Xi03XiVMXjFRXipEXiEiIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_14f7e07d7244",
      "text": "他們全都被殺了。 ",
      "encoded_ascii": "^!@^*{^!h^)$^(@^%M^*D^!\" ",
      "encoded_base64": "XiFAXip7XiFoXikkXihAXiVNXipEXiEiIA==",
      "byte_length": 25
    },
    {
      "unit_id": "DLG_d8a689f80858",
      "text": "是的。一個不留。 ",
      "encoded_ascii": "^,X^&Z^!\"^!%^!V^!)^-+^!\" ",
      "encoded_base64": "XixYXiZaXiEiXiElXiFWXiEpXi0rXiEiIA==",
      "byte_length": 25
    },
    {
      "unit_id": "DLG_aac15b0cf140",
      "text": "嗯，確實有一個人逃出去了。看來角鬥士賽蒙趁著你們 ",
      "encoded_ascii": "^6N^*A^-6^#3^$s^!%^!V^!<^(p^!q^\"6^*D^!\"^*Q^!O^(H^*,^+a^*U^-c^.)^-a^*F^*{ ",
      "encoded_base64": "XjZOXipBXi02XiMzXiRzXiElXiFWXiE8XihwXiFxXiI2XipEXiEiXipRXiFPXihIXiosXithXipVXi1jXi4pXi1hXipGXip7IA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_13d4e8afe8ba",
      "text": "逃跑引發混亂時，穿過長椅溜了出去。我 ",
      "encoded_ascii": "^(p^(_^#Z^&W^%n^!3^$f^*A^')^(x^)C^<l^%r^*D^!q^\"6^!\"^$% ",
      "encoded_base64": "XihwXihfXiNaXiZXXiVuXiEzXiRmXipBXicpXih4XilDXjxsXiVyXipEXiFxXiI2XiEiXiQlIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_2d96da95430a",
      "text": "想他應該沒被抓回來。 ",
      "encoded_ascii": "^,1^!@^0`^(M^%\\^(@^$2^\"\\^!O^!\" ",
      "encoded_base64": "XiwxXiFAXjBgXihNXiVcXihAXiQyXiJcXiFPXiEiIA==",
      "byte_length": 31
    },
    {
      "unit_id": "DLG_7c3a2d2e5856",
      "text": "好吧。隨便你。 ",
      "encoded_ascii": "^+i^*I^!\"^)X^!R^*F^!\" ",
      "encoded_base64": "XitpXipJXiEiXilYXiFSXipGXiEiIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_c37e3d28f2a9",
      "text": "我在受刑時聽見了他們的談話。他們說多一兩個 ",
      "encoded_ascii": "^$%^\"d^\";^9|^$f^-X^-m^*D^!@^*{^&Z^0;^-v^!\"^!@^*{^-x^\"x^!%^!i^!V ",
      "encoded_base64": "XiQlXiJkXiI7Xjl8XiRmXi1YXi1tXipEXiFAXip7XiZaXjA7Xi12XiEiXiFAXip7Xi14XiJ4XiElXiFpXiFWIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_0816e2b3afee",
      "text": "面紗同盟的成員根本無關緊要。 ",
      "encoded_ascii": "^)j^-G^\"E^-0^&Z^$$^+G^%)^$x^%}^.>^0r^(C^!\" ",
      "encoded_base64": "XilqXi1HXiJFXi0wXiZaXiQkXitHXiUpXiR4XiV9Xi4+XjByXihDXiEiIA==",
      "byte_length": 43
    },
    {
      "unit_id": "DLG_3a15b1c72013",
      "text": "多謝你們救了我。我最好在被抓住之前趕快離開這裡。 ",
      "encoded_ascii": "^\"x^-z^*F^*{^,Q^*D^$%^!\"^$%^$q^+i^\"d^(@^$2^*z^!/^!z^0u^*L^)`^)F^(s^-j^!\" ",
      "encoded_base64": "XiJ4Xi16XipGXip7XixRXipEXiQlXiEiXiQlXiRxXitpXiJkXihAXiQyXip6XiEvXiF6XjB1XipMXilgXilGXihzXi1qXiEiIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_3aeec7e244b6",
      "text": "確實如此。 ",
      "encoded_ascii": "^-6^#3^#$^%I^!\" ",
      "encoded_base64": "Xi02XiMzXiMkXiVJXiEiIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_33d3e78113ea",
      "text": "你這麼想真是太遺憾了。任何能夠宣稱自己擊潰了 ",
      "encoded_ascii": "^*F^(s^.T^,1^-2^,X^+f^0v^0_^*D^!\"^!C^!L^'b^+d^2d^0&^'l^#I^$F^2-^*D ",
      "encoded_base64": "XipGXihzXi5UXiwxXi0yXixYXitmXjB2XjBfXipEXiEiXiFDXiFMXidiXitkXjJkXjAmXidsXiNJXiRGXjItXipEIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_a6e3b8b35072",
      "text": "德拉吉大軍的人，都會被視為真正的英雄。 ",
      "encoded_ascii": "^#j^$6^\"D^\"z^..^&Z^!<^*A^)$^$r^(@^(E^%{^-2^%H^&Z^'y^)\\^!\" ",
      "encoded_base64": "XiNqXiQ2XiJEXiJ6Xi4uXiZaXiE8XipBXikkXiRyXihAXihFXiV7Xi0yXiVIXiZaXid5XilcXiEiIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_9c6d6df562c0",
      "text": "那真的重要嗎？要是你們不去拯救那些村落，就沒有人會去救了。 ",
      "encoded_ascii": "^)!^-2^&Z^))^(C^+X^.V^(C^,X^*F^*{^!)^\"6^,F^,Q^)!^!8^$z^-`^*A^*J^%\\^$s^!<^$r^\"6^,Q^*D^!\" ",
      "encoded_base64": "XikhXi0yXiZaXikpXihDXitYXi5WXihDXixYXipGXip7XiEpXiI2XixGXixRXikhXiE4XiR6Xi1gXipBXipKXiVcXiRzXiE8XiRyXiI2XixRXipEXiEiIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_db0b1d2494fa",
      "text": "我要挖出你的心臟，踩在腳下碾碎，你這條豬狗！ ",
      "encoded_ascii": "^$%^(C^2!^!q^*F^&Z^#k^3Y^*A^0A^\"d^00^!(^0$^&o^*A^*F^(s^%.^8(^-&^*W ",
      "encoded_base64": "XiQlXihDXjIhXiFxXipGXiZaXiNrXjNZXipBXjBBXiJkXjAwXiEoXjAkXiZvXipBXipGXihzXiUuXjgoXi0mXipXIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_dd3eb240c9f8",
      "text": "去死吧，奴隸賤種！ ",
      "encoded_ascii": "^\"6^%L^*I^*A^##^)Z^2G^'$^*W ",
      "encoded_base64": "XiI2XiVMXipJXipBXiMjXilaXjJHXickXipXIA==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_b37d4a678035",
      "text": "榮耀盡歸聖堂武士團！ ",
      "encoded_ascii": "^,e^7D^-1^%K^'Z^42^%J^+a^0V^*W ",
      "encoded_base64": "XixlXjdEXi0xXiVLXidaXjQyXiVKXithXjBWXipXIA==",
      "byte_length": 31
    },
    {
      "unit_id": "DLG_91411047ba3a",
      "text": "快點！不許說話！去幹活！",
      "encoded_ascii": "^*L^*;^*W^!)^-s^-x^-v^*W^\"6^,!^%i^*W",
      "encoded_base64": "XipMXio7XipXXiEpXi1zXi14Xi12XipXXiI2XiwhXiVpXipX",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_520de1349477",
      "text": "站住！你們是誰？",
      "encoded_ascii": "^->^*z^*W^*F^*{^,X^-y^.V",
      "encoded_base64": "Xi0+Xip6XipXXipGXip7XixYXi15Xi5W",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_f800438e18ab",
      "text": "  我要求見聖堂武士。",
      "encoded_ascii": "  ^$%^(C^,n^-m^'Z^42^%J^+a^!\"",
      "encoded_base64": "ICBeJCVeKENeLG5eLW1eJ1peNDJeJUpeK2FeISI=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_9c10ac108eec",
      "text": "  你們的主人是誰？ ",
      "encoded_ascii": "  ^*F^*{^&Z^!-^!<^,X^-y^.V ",
      "encoded_base64": "ICBeKkZeKnteJlpeIS1eITxeLFheLXleLlYg",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_6aff215eed34",
      "text": "  我只跟聖堂武士說話。",
      "encoded_ascii": "  ^$%^\"?^.+^'Z^42^%J^+a^-x^-v^!\"",
      "encoded_base64": "ICBeJCVeIj9eLiteJ1peNDJeJUpeK2FeLXheLXZeISI=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_ead150a21d4c",
      "text": "  去死吧，奴隸販子人渣！哈啊！ ",
      "encoded_ascii": "  ^\"6^%L^*I^*A^##^)Z^6.^#(^!<^,v^*W^+F^+Q^*W ",
      "encoded_base64": "ICBeIjZeJUxeKkleKkFeIyNeKVpeNi5eIyheITxeLHZeKldeK0ZeK1FeKlcg",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_970fac44faa1",
      "text": "  我暫時先幹活。",
      "encoded_ascii": "  ^$%^$l^$f^!b^,!^%i^!\"",
      "encoded_base64": "ICBeJCVeJGxeJGZeIWJeLCFeJWleISI=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_a5e20fdf80e8",
      "text": "  我是自由民，不是奴隸。 ",
      "encoded_ascii": "  ^$%^,X^'l^&I^%T^*A^!)^,X^##^)Z^!\" ",
      "encoded_base64": "ICBeJCVeLFheJ2xeJkleJVReKkFeISleLFheIyNeKVpeISIg",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_29ec068597c1",
      "text": "  我憑什麼要讓你們把我抓去當奴隸？",
      "encoded_ascii": "  ^$%^,5^!=^.T^(C^-}^*F^*{^$1^$%^$2^\"6^&N^##^)Z^.V",
      "encoded_base64": "ICBeJCVeLDVeIT1eLlReKENeLX1eKkZeKnteJDFeJCVeJDJeIjZeJk5eIyNeKVpeLlY=",
      "byte_length": 50
    },
    {
      "unit_id": "DLG_59b70553968f",
      "text": "那名字我沒聽過。看你們這副模樣——不是戰士就是強盜。 ",
      "encoded_ascii": "^)!^\"F^#)^$%^%\\^-X^(x^!\"^*Q^*F^*{^(s^52^%:^,f^*n^*n^!)^,X^$(^+a^*J^,X^#]^0!^!\" ",
      "encoded_base64": "XikhXiJGXiMpXiQlXiVcXi1YXih4XiEiXipRXipGXip7XihzXjUyXiU6XixmXipuXipuXiEpXixYXiQoXithXipKXixYXiNdXjAhXiEiIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_7861a6ece63d",
      "text": "你們的主人是誰——老實交代，否則休想得到他的庇護，而且可能連性命都 ",
      "encoded_ascii": "^*F^*{^&Z^!-^!<^,X^-y^*n^*n^'U^#3^0P^*v^*A^\"H^!x^!G^,1^#e^!u^!@^&Z^,\"^(T^*A^'W^!*^\"A^'b^.0^#r^\"N^)$ ",
      "encoded_base64": "XipGXip7XiZaXiEtXiE8XixYXi15XipuXipuXidVXiMzXjBQXip2XipBXiJIXiF4XiFHXiwxXiNlXiF1XiFAXiZaXiwiXihUXipBXidXXiEqXiJBXidiXi4wXiNyXiJOXikkIA==",
      "byte_length": 100
    },
    {
      "unit_id": "DLG_294c66baff42",
      "text": "不保。 ",
      "encoded_ascii": "^!)^!T^!\" ",
      "encoded_base64": "XiEpXiFUXiEiIA==",
      "byte_length": 10
    },
    {
      "unit_id": "DLG_09cccffe3a41",
      "text": "  我是德拉吉的奴隸。 ",
      "encoded_ascii": "  ^$%^,X^#j^$6^\"D^&Z^##^)Z^!\" ",
      "encoded_base64": "ICBeJCVeLFheI2peJDZeIkReJlpeIyNeKVpeISIg",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_8d532459a2f1",
      "text": "  我是個自由民。 ",
      "encoded_ascii": "  ^$%^,X^!V^'l^&I^%T^!\" ",
      "encoded_base64": "ICBeJCVeLFheIVZeJ2xeJkleJVReISIg",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_5a5bfba0952d",
      "text": "  需要保護的人是你們！ ",
      "encoded_ascii": "  ^)e^(C^!T^(T^&Z^!<^,X^*F^*{^*W ",
      "encoded_base64": "ICBeKWVeKENeIVReKFReJlpeITxeLFheKkZeKnteKlcg",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_fa965d89f539",
      "text": "既然這樣，你們現在就是最偉大、最強盛的聖堂武士 ",
      "encoded_ascii": "^,U^&\"^(s^,f^*A^*F^*{^&?^\"d^*J^,X^$q^*}^\"z^!!^$q^#]^1L^&Z^'Z^42^%J^+a ",
      "encoded_base64": "XixVXiYiXihzXixmXipBXipGXip7XiY/XiJkXipKXixYXiRxXip9XiJ6XiEhXiRxXiNdXjFMXiZaXidaXjQyXiVKXithIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_cebf4c7cbcb7",
      "text": "提奧菲爾大人的奴隸了。 ",
      "encoded_ascii": "^$A^6Q^8q^&/^\"z^!<^&Z^##^)Z^*D^!\" ",
      "encoded_base64": "XiRBXjZRXjhxXiYvXiJ6XiE8XiZaXiMjXilaXipEXiEiIA==",
      "byte_length": 34
    },
    {
      "unit_id": "DLG_2b6affc8b36b",
      "text": "你們得替他開採礦山，為他帶來滾滾財富！ ",
      "encoded_ascii": "^*F^*{^#e^2o^!@^)F^5R^5m^11^*A^%{^!@^#N^!O^,z^,z^0=^3C^*W ",
      "encoded_base64": "XipGXip7XiNlXjJvXiFAXilGXjVSXjVtXjExXipBXiV7XiFAXiNOXiFPXix6Xix6XjA9XjNDXipXIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_2d25ba349e04",
      "text": "你們找聖堂武士有什麼公事？",
      "encoded_ascii": "^*F^*{^$/^'Z^42^%J^+a^$s^!=^.T^3:^*r^.V",
      "encoded_base64": "XipGXip7XiQvXidaXjQyXiVKXithXiRzXiE9Xi5UXjM6XipyXi5W",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_c3bf2d7de589",
      "text": "  我帶來了城裡的消息。",
      "encoded_ascii": "  ^$%^#N^!O^*D^+_^-j^&Z^%k^#w^!\"",
      "encoded_base64": "ICBeJCVeI05eIU9eKkReK19eLWpeJlpeJWteI3deISI=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_ae1b5d931418",
      "text": "  這不關你的事，雜種狗！ ",
      "encoded_ascii": "  ^(s^!)^.>^*F^&Z^*r^*A^0G^'$^-&^*W ",
      "encoded_base64": "ICBeKHNeISleLj5eKkZeJlpeKnJeKkFeMEdeJyReLSZeKlcg",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_a0a73d78f876",
      "text": "  我沒必要向你交代。 ",
      "encoded_ascii": "  ^$%^%\\^#l^(C^+?^*F^0P^*v^!\" ",
      "encoded_base64": "ICBeJCVeJVxeI2xeKENeKz9eKkZeMFBeKnZeISIg",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_b874381cbef2",
      "text": "我們的主人是提奧菲爾——聖堂武士團中至高尊貴且力量強大的 ",
      "encoded_ascii": "^$%^*{^&Z^!-^!<^,X^$A^6Q^8q^&/^*n^*n^'Z^42^%J^+a^0V^!,^'n^*+^+u^2F^!*^!~^)*^#]^\"z^&Z ",
      "encoded_base64": "XiQlXip7XiZaXiEtXiE8XixYXiRBXjZRXjhxXiYvXipuXipuXidaXjQyXiVKXithXjBWXiEsXiduXiorXit1XjJGXiEqXiF+XikqXiNdXiJ6XiZaIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_588808ca08da",
      "text": "大人物。 ",
      "encoded_ascii": "^\"z^!<^&4^!\" ",
      "encoded_base64": "XiJ6XiE8XiY0XiEiIA==",
      "byte_length": 13
    },
    {
      "unit_id": "DLG_24752de13134",
      "text": "你們休想離開，你們得為我們幹活，豬狗！ ",
      "encoded_ascii": "^*F^*{^!G^,1^)`^)F^*A^*F^*{^#e^%{^$%^*{^,!^%i^*A^8(^-&^*W ",
      "encoded_base64": "XipGXip7XiFHXiwxXilgXilGXipBXipGXip7XiNlXiV7XiQlXip7XiwhXiVpXipBXjgoXi0mXipXIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_d7ed47aebcbe",
      "text": "看你們的模樣，不是刺客就是逃跑的奴隸。 ",
      "encoded_ascii": "^*Q^*F^*{^&Z^%:^,f^*A^!)^,X^!w^+q^*J^,X^(p^(_^&Z^##^)Z^!\" ",
      "encoded_base64": "XipRXipGXip7XiZaXiU6XixmXipBXiEpXixYXiF3XitxXipKXixYXihwXihfXiZaXiMjXilaXiEiIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_8625dd02fe2f",
      "text": "不管是哪一種，我們正好缺勞工——你們得加入我們的 ",
      "encoded_ascii": "^!)^-D^,X^+I^!%^'$^*A^$%^*{^%H^+i^7e^/R^+y^*n^*n^*F^*{^#e^\"\"^!f^$%^*{^&Z ",
      "encoded_base64": "XiEpXi1EXixYXitJXiElXickXipBXiQlXip7XiVIXitpXjdlXi9SXit5XipuXipuXipGXip7XiNlXiIiXiFmXiQlXip7XiZaIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_3ad5fd05946c",
      "text": "勞役隊。順從或是受死！ ",
      "encoded_ascii": "^/R^17^)U^!\"^.D^#f^$'^,X^\";^%L^*W ",
      "encoded_base64": "Xi9SXjE3XilVXiEiXi5EXiNmXiQnXixYXiI7XiVMXipXIA==",
      "byte_length": 34
    },
    {
      "unit_id": "DLG_ebf681369915",
      "text": "我要教教你什麼叫尊重！ ",
      "encoded_ascii": "^$%^(C^,R^,R^*F^!=^.T^+<^+u^))^*W ",
      "encoded_base64": "XiQlXihDXixSXixSXipGXiE9Xi5UXis8Xit1XikpXipXIA==",
      "byte_length": 34
    },
    {
      "unit_id": "DLG_4b870ee9aae9",
      "text": "備戰！宰了這些叛徒！ ",
      "encoded_ascii": "^+\"^$(^*W^1w^*D^(s^!8^.Z^#d^*W ",
      "encoded_base64": "XisiXiQoXipXXjF3XipEXihzXiE4Xi5aXiNkXipXIA==",
      "byte_length": 31
    },
    {
      "unit_id": "DLG_bac3f008fb70",
      "text": "我從不回答像你這種沙漠耗子所提的 ",
      "encoded_ascii": "^$%^#f^!)^\"\\^-B^!`^*F^(s^'$^%]^,}^'X^#(^$)^$A^&Z ",
      "encoded_base64": "XiQlXiNmXiEpXiJcXi1CXiFgXipGXihzXickXiVdXix9XidYXiMoXiQpXiRBXiZaIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_4e4256a5b2d9",
      "text": "問題。 ",
      "encoded_ascii": "^*Z^.G^!\" ",
      "encoded_base64": "XipaXi5HXiEiIA==",
      "byte_length": 10
    },
    {
      "unit_id": "DLG_4f7dfda36ad3",
      "text": "既然這樣，你們就受死吧！",
      "encoded_ascii": "^,U^&\"^(s^,f^*A^*F^*{^*J^\";^%L^*I^*W",
      "encoded_base64": "XixVXiYiXihzXixmXipBXipGXip7XipKXiI7XiVMXipJXipX",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_170f3ec30fe4",
      "text": "你們要麼加入幹活，要麼死。",
      "encoded_ascii": "^*F^*{^(C^.T^\"\"^!f^,!^%i^*A^(C^.T^%L^!\"",
      "encoded_base64": "XipGXip7XihDXi5UXiIiXiFmXiwhXiVpXipBXihDXi5UXiVMXiEi",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_080660805234",
      "text": "那就閉嘴，拿起十字鎬幹活！",
      "encoded_ascii": "^)!^*J^.=^+[^*A^,G^.(^*Y^#)^*l^,!^%i^*W",
      "encoded_base64": "XikhXipKXi49XitbXipBXixHXi4oXipZXiMpXipsXiwhXiVpXipX",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_8f3265c46ff7",
      "text": "聖堂武士和他手下的部隊全都被消滅了。你們拯救了 ",
      "encoded_ascii": "^'Z^42^%J^+a^\"O^!@^$+^!(^&Z^)#^)U^!h^)$^(@^%k^%t^*D^!\"^*F^*{^,F^,Q^*D ",
      "encoded_base64": "XidaXjQyXiVKXithXiJPXiFAXiQrXiEoXiZaXikjXilVXiFoXikkXihAXiVrXiV0XipEXiEiXipGXip7XixGXixRXipEIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_5a322f7d490e",
      "text": "階梯溫泉！",
      "encoded_ascii": "^=b^3u^%s^%a^*W",
      "encoded_base64": "Xj1iXjN1XiVzXiVhXipX",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_43c0cd62f37e",
      "text": "衛兵——進攻！ ",
      "encoded_ascii": "^(=^+,^*n^*n^(w^$O^*W ",
      "encoded_base64": "Xig9XissXipuXipuXih3XiRPXipXIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_26e5597b032b",
      "text": "你這蠢笨的傢伙！夠了！把沙子鏟進袋子裡！ ",
      "encoded_ascii": "^*F^(s^.u^5#^&Z^+#^*y^*W^+d^*D^*W^$1^%]^#(^)=^(w^(?^#(^-j^*W ",
      "encoded_base64": "XipGXihzXi51XjUjXiZaXisjXip5XipXXitkXipEXipXXiQxXiVdXiMoXik9Xih3Xig/XiMoXi1qXipXIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_427f25abe202",
      "text": "已經沒有空間再堆放沙子了。 ",
      "encoded_ascii": "^#J^'D^%\\^$s^'(^)G^!l^*[^$P^%]^#(^*D^!\" ",
      "encoded_base64": "XiNKXidEXiVcXiRzXicoXilHXiFsXipbXiRQXiVdXiMoXipEXiEiIA==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_f835d6932cdc",
      "text": "鎬頭狠狠地鑿進了地面。 ",
      "encoded_ascii": "^*l^)t^4T^4T^\"e^6@^(w^*D^\"e^)j^!\" ",
      "encoded_base64": "XipsXil0XjRUXjRUXiJlXjZAXih3XipEXiJlXilqXiEiIA==",
      "byte_length": 34
    },
    {
      "unit_id": "DLG_a315599ee044",
      "text": "這是給你的最後警告，奴隸！要麼幹活，要麼受死！ ",
      "encoded_ascii": "^(s^,X^'A^*F^&Z^$q^#b^(S^+B^*A^##^)Z^*W^(C^.T^,!^%i^*A^(C^.T^\";^%L^*W ",
      "encoded_base64": "XihzXixYXidBXipGXiZaXiRxXiNiXihTXitCXipBXiMjXilaXipXXihDXi5UXiwhXiVpXipBXihDXi5UXiI7XiVMXipXIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_ca3fba860df5",
      "text": "我們留你活命可不是讓你在旁邊發呆看熱鬧的！ ",
      "encoded_ascii": "^$%^*{^-+^*F^%i^\"N^\"A^!)^,X^-}^*F^\"d^.h^.8^&W^;)^*Q^&$^6G^&Z^*W ",
      "encoded_base64": "XiQlXip7Xi0rXipGXiVpXiJOXiJBXiEpXixYXi19XipGXiJkXi5oXi44XiZXXjspXipRXiYkXjZHXiZaXipXIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_ecb3bf0cbef6",
      "text": "你沙子鏟得夠多了。把坑挖得更深一點。 ",
      "encoded_ascii": "^*F^%]^#(^)=^#e^+d^\"x^*D^!\"^$1^5>^2!^#e^$o^2*^!%^*;^!\" ",
      "encoded_base64": "XipGXiVdXiMoXik9XiNlXitkXiJ4XipEXiEiXiQxXjU+XjIhXiNlXiRvXjIqXiElXio7XiEiIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_f876ddd215f4",
      "text": "已經沒有空間可以挖掘了。 ",
      "encoded_ascii": "^#J^'D^%\\^$s^'(^)G^\"A^!B^2!^=@^*D^!\" ",
      "encoded_base64": "XiNKXidEXiVcXiRzXicoXilHXiJBXiFCXjIhXj1AXipEXiEiIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_d4290ed5c544",
      "text": "你離得太遠了。 ",
      "encoded_ascii": "^*F^)`^#e^+f^({^*D^!\" ",
      "encoded_base64": "XipGXilgXiNlXitmXih7XipEXiEiIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_5bdfddbcfac1",
      "text": "你輕易殺死了那個奴隸。",
      "encoded_ascii": "^*F^(g^,W^%M^%L^*D^)!^!V^##^)Z^!\"",
      "encoded_base64": "XipGXihnXixXXiVNXiVMXipEXikhXiFWXiMjXilaXiEi",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_d61633b7db9a",
      "text": "你這個白痴！那可是值錢的財產！在派你來幹活之前，我們真該好好 ",
      "encoded_ascii": "^*F^(s^!V^&X^<Y^*W^)!^\"A^,X^!Z^.<^&Z^0=^&G^*W^\"d^.n^*F^!O^,!^%i^!/^!z^*A^$%^*{^-2^(M^+i^+i ",
      "encoded_base64": "XipGXihzXiFWXiZYXjxZXipXXikhXiJBXixYXiFaXi48XiZaXjA9XiZHXipXXiJkXi5uXipGXiFPXiwhXiVpXiEvXiF6XipBXiQlXip7Xi0yXihNXitpXitpIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_bc556a6ede5d",
      "text": "管教訓練你一番。 ",
      "encoded_ascii": "^-D^,R^-p^-L^*F^!%^2{^!\" ",
      "encoded_base64": "Xi1EXixSXi1wXi1MXipGXiElXjJ7XiEiIA==",
      "byte_length": 25
    },
    {
      "unit_id": "DLG_ac2126d36b3c",
      "text": "立刻把那個給我！",
      "encoded_ascii": "^0'^.Y^$1^)!^!V^'A^$%^*W",
      "encoded_base64": "XjAnXi5ZXiQxXikhXiFWXidBXiQlXipX",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_5b5e39e0c407",
      "text": "  抱歉，我沒有別的意思。",
      "encoded_ascii": "  ^,@^,h^*A^$%^%\\^$s^*H^&Z^#z^#q^!\"",
      "encoded_base64": "ICBeLEBeLGheKkFeJCVeJVxeJHNeKkheJlpeI3peI3FeISI=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_d9d0c70f7f26",
      "text": "  我想拿什麼就拿什麼！",
      "encoded_ascii": "  ^$%^,1^,G^!=^.T^*J^,G^!=^.T^*W",
      "encoded_base64": "ICBeJCVeLDFeLEdeIT1eLlReKkpeLEdeIT1eLlReKlc=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_d6fbbb572b74",
      "text": "那就好。我可不想非得殺了你不可。",
      "encoded_ascii": "^)!^*J^+i^!\"^$%^\"A^!)^,1^)i^#e^%M^*D^*F^!)^\"A^!\"",
      "encoded_base64": "XikhXipKXitpXiEiXiQlXiJBXiEpXiwxXilpXiNlXiVNXipEXipGXiEpXiJBXiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_55b76d78ed57",
      "text": "樓梯就在這邊。",
      "encoded_ascii": "^0g^3u^*J^\"d^(s^.8^!\"",
      "encoded_base64": "XjBnXjN1XipKXiJkXihzXi44XiEi",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_6dfb1fd751e2",
      "text": "這是給你們的錢。我希望你們立刻離開，而且可別忘了， ",
      "encoded_ascii": "^(s^,X^'A^*F^*{^&Z^.<^!\"^$%^+{^,]^*F^*{^0'^.Y^)`^)F^*A^'W^!*^\"A^*H^0]^*D^*A ",
      "encoded_base64": "XihzXixYXidBXipGXip7XiZaXi48XiEiXiQlXit7XixdXipGXip7XjAnXi5ZXilgXilGXipBXidXXiEqXiJBXipIXjBdXipEXipBIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_0b53d869956a",
      "text": "要是你們不配合，我有的是手段強行落實我的意志。",
      "encoded_ascii": "^(C^,X^*F^*{^!)^)&^\"C^*A^$%^$s^&Z^,X^$+^.l^#]^(;^-`^#3^$%^&Z^#z^#m^!\"",
      "encoded_base64": "XihDXixYXipGXip7XiEpXikmXiJDXipBXiQlXiRzXiZaXixYXiQrXi5sXiNdXig7Xi1gXiMzXiQlXiZaXiN6XiNtXiEi",
      "byte_length": 69
    },
    {
      "unit_id": "DLG_23503dd692dd",
      "text": "我的藏寶室就在雙足飛龍欄舍的正東方。走下樓梯， ",
      "encoded_ascii": "^$%^&Z^-f^#4^+r^*J^\"d^)_^(^^)z^*>^%C^03^&Z^%H^,`^$]^!\"^.&^!(^0g^3u^*A ",
      "encoded_base64": "XiQlXiZaXi1mXiM0XityXipKXiJkXilfXiheXil6Xio+XiVDXjAzXiZaXiVIXixgXiRdXiEiXi4mXiEoXjBnXjN1XipBIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_aa0f9901c5b6",
      "text": "在走廊處向東轉，接著在第一個岔路向北。當你們 ",
      "encoded_ascii": "^\"d^.&^,$^(,^+?^,`^(i^*A^$?^-a^\"d^',^!%^!V^3m^(a^+?^+6^!\"^&N^*F^*{ ",
      "encoded_base64": "XiJkXi4mXiwkXigsXis/XixgXihpXipBXiQ/Xi1hXiJkXicsXiElXiFWXjNtXihhXis/Xis2XiEiXiZOXipGXip7IA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_3fc979d93426",
      "text": "敲響銅鑼時，我的守護者便會現身並 ",
      "encoded_ascii": "^1A^)o^0x^)B^$f^*A^$%^&Z^#+^(T^'V^!R^$r^&?^(c^!+ ",
      "encoded_base64": "XjFBXilvXjB4XilCXiRmXipBXiQlXiZaXiMrXihUXidWXiFSXiRyXiY/XihjXiErIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_69ec17c71ba7",
      "text": "回答你們的問題",
      "encoded_ascii": "^\"\\^-B^*F^*{^&Z^*Z^.G",
      "encoded_base64": "XiJcXi1CXipGXip7XiZaXipaXi5H",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_c7c0413be49c",
      "text": "讓你們挑選一件寶物",
      "encoded_ascii": "^-}^*F^*{^,H^.6^!%^.W^#4^&4",
      "encoded_base64": "Xi19XipGXip7XixIXi42XiElXi5XXiM0XiY0",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_59e7b26b9343",
      "text": "把錢交給你們",
      "encoded_ascii": "^$1^.<^0P^'A^*F^*{",
      "encoded_base64": "XiQxXi48XjBQXidBXipGXip7",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_fb306e948258",
      "text": "。這枚徽章能保護你們。現在快去吧，趁我的耐心耗盡之前。",
      "encoded_ascii": "^!\"^(s^$~^3o^3x^'b^!T^(T^*F^*{^!\"^&?^\"d^*L^\"6^*I^*A^.)^$%^&Z^-S^#k^'X^-1^!/^!z^!\"",
      "encoded_base64": "XiEiXihzXiR+XjNvXjN4XidiXiFUXihUXipGXip7XiEiXiY/XiJkXipMXiI2XipJXipBXi4pXiQlXiZaXi1TXiNrXidYXi0xXiEvXiF6XiEi",
      "byte_length": 81
    },
    {
      "unit_id": "DLG_f6f7232e1bc7",
      "text": "請稍安勿躁。你們馬上就能拿到錢了。",
      "encoded_ascii": "^*S^-:^+p^3f^4\"^!\"^*F^*{^*\"^!'^*J^'b^,G^!u^.<^*D^!\"",
      "encoded_base64": "XipTXi06XitwXjNmXjQiXiEiXipGXip7XioiXiEnXipKXidiXixHXiF1Xi48XipEXiEi",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_d0694b3e1ccc",
      "text": "藏寶室在樓下。來吧，我帶你們去。",
      "encoded_ascii": "^-f^#4^+r^\"d^0g^!(^!\"^!O^*I^*A^$%^#N^*F^*{^\"6^!\"",
      "encoded_base64": "Xi1mXiM0XityXiJkXjBnXiEoXiEiXiFPXipJXipBXiQlXiNOXipGXip7XiI2XiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_6c8dbdf6a619",
      "text": "我看出來了，你們比我想像的還要見錢眼開。不過，",
      "encoded_ascii": "^$%^*Q^!q^!O^*D^*A^*F^*{^,m^$%^,1^!`^&Z^.7^(C^-m^.<^&d^)F^!\"^!)^(x^*A",
      "encoded_base64": "XiQlXipRXiFxXiFPXipEXipBXipGXip7XixtXiQlXiwxXiFgXiZaXi43XihDXi1tXi48XiZkXilGXiEiXiEpXih4XipB",
      "byte_length": 69
    },
    {
      "unit_id": "DLG_6c52b43038ac",
      "text": "我已經跟你們達成交易了。沒什麼好再談的。你們打算 ",
      "encoded_ascii": "^$%^#J^'D^.+^*F^*{^(z^$$^0P^,W^*D^!\"^%\\^!=^.T^+i^!l^0;^&Z^!\"^*F^*{^$-^-C ",
      "encoded_base64": "XiQlXiNKXidEXi4rXipGXip7Xih6XiQkXjBQXixXXipEXiEiXiVcXiE9Xi5UXitpXiFsXjA7XiZaXiEiXipGXip7XiQtXi1DIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_57d3d660f4f6",
      "text": "遵守你們那一方的約定嗎？",
      "encoded_ascii": "^4#^#+^*F^*{^)!^!%^$]^&Z^-F^#.^+X^.V",
      "encoded_base64": "XjQjXiMrXipGXip7XikhXiElXiRdXiZaXi1GXiMuXitYXi5W",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_6cb24f587191",
      "text": "那你們最好快點動身！",
      "encoded_ascii": "^)!^*F^*{^$q^+i^*L^*;^\"%^(c^*W",
      "encoded_base64": "XikhXipGXip7XiRxXitpXipMXio7XiIlXihjXipX",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_f0254854efd7",
      "text": "啊！在這裡惹出所有麻煩的一定就是你們了。",
      "encoded_ascii": "^+Q^*W^\"d^(s^-j^3s^!q^$)^$s^*6^-!^&Z^!%^#.^*J^,X^*F^*{^*D^!\"",
      "encoded_base64": "XitRXipXXiJkXihzXi1qXjNzXiFxXiQpXiRzXio2Xi0hXiZaXiElXiMuXipKXixYXipGXip7XipEXiEi",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_30a6c45ed893",
      "text": "你們是怎麼到這裡來的？從來沒有人能抵達這座城堡！",
      "encoded_ascii": "^*F^*{^,X^,,^.T^!u^(s^-j^!O^&Z^.V^#f^!O^%\\^$s^!<^'b^$5^(z^(s^/_^+_^\"m^*W",
      "encoded_base64": "XipGXip7XixYXiwsXi5UXiF1XihzXi1qXiFPXiZaXi5WXiNmXiFPXiVcXiRzXiE8XidiXiQ1Xih6XihzXi9fXitfXiJtXipX",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_a878bcc6c963",
      "text": " 我相信有更合算、更有利可圖的辦法來解決這件事。",
      "encoded_ascii": " ^$%^&a^!U^$s^$o^\"C^-C^!!^$o^$s^!t^\"A^\"b^&Z^2L^%b^!O^(I^,o^(s^.W^*r^!\"",
      "encoded_base64": "IF4kJV4mYV4hVV4kc14kb14iQ14tQ14hIV4kb14kc14hdF4iQV4iYl4mWl4yTF4lYl4hT14oSV4sb14oc14uV14qcl4hIg==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_310aa079c0f6",
      "text": "  你不也到這裡來了嗎？",
      "encoded_ascii": "  ^*F^!)^!1^!u^(s^-j^!O^*D^+X^.V",
      "encoded_base64": "ICBeKkZeISleITFeIXVeKHNeLWpeIU9eKkReK1heLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_715fa494490a",
      "text": "  你建議我們該如何解決？",
      "encoded_ascii": "  ^*F^,'^-|^$%^*{^(M^#$^!L^(I^,o^.V",
      "encoded_base64": "ICBeKkZeLCdeLXxeJCVeKnteKE1eIyReIUxeKEleLG9eLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_b22300816159",
      "text": "  我絕不跟殺人凶手打交道！",
      "encoded_ascii": "  ^$%^-I^!)^.+^%M^!<^3e^$+^$-^0P^(y^*W",
      "encoded_base64": "ICBeJCVeLUleISleLiteJU1eITxeM2VeJCteJC1eMFBeKHleKlc=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_7f6e6f331592",
      "text": "  把飛龍騎鉤交給我！",
      "encoded_ascii": "  ^$1^)z^*>^0K^)/^0P^'A^$%^*W",
      "encoded_base64": "ICBeJDFeKXpeKj5eMEteKS9eMFBeJ0FeJCVeKlc=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_c70b76321107",
      "text": "  受死吧，口臭的雜碎！",
      "encoded_ascii": "  ^\";^%L^*I^*A^\"<^'m^&Z^0G^&o^*W",
      "encoded_base64": "ICBeIjteJUxeKkleKkFeIjxeJ21eJlpeMEdeJm9eKlc=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_876318347787",
      "text": " 我的隊伍正需要能幹的勇士。正如你們所見，回報極其 ",
      "encoded_ascii": " ^$%^&Z^)U^!F^%H^)e^(C^'b^,!^&Z^\"$^+a^!\"^%H^#$^*F^*{^$)^-m^*A^\"\\^+`^1D^!j ",
      "encoded_base64": "IF4kJV4mWl4pVV4hRl4lSF4pZV4oQ14nYl4sIV4mWl4iJF4rYV4hIl4lSF4jJF4qRl4qe14kKV4tbV4qQV4iXF4rYF4xRF4haiA=",
      "byte_length": 74
    },
    {
      "unit_id": "DLG_37885f5cd05f",
      "text": "豐厚。你們願意加入我的麾下嗎？",
      "encoded_ascii": "^4!^\"4^!\"^*F^*{^.H^#z^\"\"^!f^$%^&Z^4)^!(^+X^.V",
      "encoded_base64": "XjQhXiI0XiEiXipGXip7Xi5IXiN6XiIiXiFmXiQlXiZaXjQpXiEoXitYXi5W",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_6195256d1720",
      "text": "  不，我不想加入你的強盜團伙。",
      "encoded_ascii": "  ^!)^*A^$%^!)^,1^\"\"^!f^*F^&Z^#]^0!^0V^*y^!\"",
      "encoded_base64": "ICBeISleKkFeJCVeISleLDFeIiJeIWZeKkZeJlpeI11eMCFeMFZeKnleISI=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_255884f99236",
      "text": "  好啊，我願意加入你的隊伍。",
      "encoded_ascii": "  ^+i^+Q^*A^$%^.H^#z^\"\"^!f^*F^&Z^)U^!F^!\"",
      "encoded_base64": "ICBeK2leK1FeKkFeJCVeLkheI3peIiJeIWZeKkZeJlpeKVVeIUZeISI=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_fce4b4511cef",
      "text": "  把飛龍騎鉤交出來，否則我宰了你！",
      "encoded_ascii": "  ^$1^)z^*>^0K^)/^0P^!q^!O^*A^\"H^!x^$%^1w^*D^*F^*W",
      "encoded_base64": "ICBeJDFeKXpeKj5eMEteKS9eMFBeIXFeIU9eKkFeIkheIXheJCVeMXdeKkReKkZeKlc=",
      "byte_length": 50
    },
    {
      "unit_id": "DLG_0468590bb019",
      "text": "  我寧死也不會加入你們的匪幫！",
      "encoded_ascii": "  ^$%^3k^%L^!1^!)^$r^\"\"^!f^*F^*{^&Z^3g^+}^*W",
      "encoded_base64": "ICBeJCVeM2teJUxeITFeISleJHJeIiJeIWZeKkZeKnteJlpeM2deK31eKlc=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_c50cd9139a9d",
      "text": "那你們到底想要什麼？",
      "encoded_ascii": "^)!^*F^*{^!u^/^^,1^(C^!=^.T^.V",
      "encoded_base64": "XikhXipGXip7XiF1Xi9eXiwxXihDXiE9Xi5UXi5W",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_46d8f684314d",
      "text": "  我想要情報。",
      "encoded_ascii": "  ^$%^,1^(C^,0^+`^!\"",
      "encoded_base64": "ICBeJCVeLDFeKENeLDBeK2BeISI=",
      "byte_length": 20
    },
    {
      "unit_id": "DLG_88b3c2ccffa8",
      "text": "  開個價吧。",
      "encoded_ascii": "  ^)F^!V^+&^*I^!\"",
      "encoded_base64": "ICBeKUZeIVZeKyZeKkleISI=",
      "byte_length": 17
    },
    {
      "unit_id": "DLG_20927361b7e3",
      "text": "  滾出這座城堡，並停止你們的掠奪！",
      "encoded_ascii": "  ^,z^!q^(s^/_^+_^\"m^*A^!+^+!^%G^*F^*{^&Z^1<^1,^*W",
      "encoded_base64": "ICBeLHpeIXFeKHNeL19eK19eIm1eKkFeISteKyFeJUdeKkZeKnteJlpeMTxeMSxeKlc=",
      "byte_length": 50
    },
    {
      "unit_id": "DLG_2f577af468d3",
      "text": "太棒了！你我很快就會富可敵國，如同城邦巫王一般。為了鞏固 ",
      "encoded_ascii": "^+f^%1^*D^*W^*F^$%^*K^*L^*J^$r^3C^\"A^$U^+^^*A^#$^\"E^+_^1a^14^-)^!%^'r^!\"^%{^*D^3b^3> ",
      "encoded_base64": "XitmXiUxXipEXipXXipGXiQlXipLXipMXipKXiRyXjNDXiJBXiRVXiteXipBXiMkXiJFXitfXjFhXjE0Xi0pXiElXidyXiEiXiV7XipEXjNiXjM+IA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_897da71da4ae",
      "text": "我們的同盟，我准許你們前往我的藏寶室，先品嘗 ",
      "encoded_ascii": "^$%^*{^&Z^\"E^-0^*A^$%^/Q^-s^*F^*{^!z^,)^$%^&Z^-f^#4^+r^*A^!b^\"R^1o ",
      "encoded_base64": "XiQlXip7XiZaXiJFXi0wXipBXiQlXi9RXi1zXipGXip7XiF6XiwpXiQlXiZaXi1mXiM0XityXipBXiFiXiJSXjFvIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_a036e8135588",
      "text": "在我的統御下所能獲得的豐厚回報。請隨我來。",
      "encoded_ascii": "^\"d^$%^&Z^'B^3n^!(^$)^'b^&:^#e^&Z^4!^\"4^\"\\^+`^!\"^*S^)X^$%^!O^!\"",
      "encoded_base64": "XiJkXiQlXiZaXidCXjNuXiEoXiQpXidiXiY6XiNlXiZaXjQhXiI0XiJcXitgXiEiXipTXilYXiQlXiFPXiEi",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_ced873cb2b31",
      "text": " 你們願意加入我的匪幫嗎？",
      "encoded_ascii": " ^*F^*{^.H^#z^\"\"^!f^$%^&Z^3g^+}^+X^.V",
      "encoded_base64": "IF4qRl4qe14uSF4jel4iIl4hZl4kJV4mWl4zZ14rfV4rWF4uVg==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_cde00306cfd1",
      "text": "那你們就受死吧！",
      "encoded_ascii": "^)!^*F^*{^*J^\";^%L^*I^*W",
      "encoded_base64": "XikhXipGXip7XipKXiI7XiVMXipJXipX",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_9196b9adf0ce",
      "text": "說得沒錯。看來我們還有其他共同點。事實上，",
      "encoded_ascii": "^-x^#e^%\\^)5^!\"^*Q^!O^$%^*{^.7^$s^!j^!@^3d^\"E^*;^!\"^*r^#3^!'^*A",
      "encoded_base64": "Xi14XiNlXiVcXik1XiEiXipRXiFPXiQlXip7Xi43XiRzXiFqXiFAXjNkXiJFXio7XiEiXipyXiMzXiEnXipB",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_f00132cd4263",
      "text": "好吧，那也無關緊要。反正你們已經到這兒了，而且顯然絕非 ",
      "encoded_ascii": "^+i^*I^*A^)!^!1^%}^.>^0r^(C^!\"^\"9^%H^*F^*{^#J^'D^!u^(s^++^*D^*A^'W^!*^4&^&\"^-I^)i ",
      "encoded_base64": "XitpXipJXipBXikhXiExXiV9Xi4+XjByXihDXiEiXiI5XiVIXipGXip7XiNKXidEXiF1XihzXisrXipEXipBXidXXiEqXjQmXiYiXi1JXilpIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_73f3641b194d",
      "text": "尋常的小毛賊。",
      "encoded_ascii": "^#9^#O^&Z^#;^%R^0?^!\"",
      "encoded_base64": "XiM5XiNPXiZaXiM7XiVSXjA/XiEi",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_6d5b01a2dbbf",
      "text": "很簡單！我可以寬恕你們先前的冒犯，因為",
      "encoded_ascii": "^*K^3y^2a^*W^$%^\"A^!B^3l^3q^*F^*{^!b^!z^&Z^/P^-%^*A^\"]^%{",
      "encoded_base64": "XipLXjN5XjJhXipXXiQlXiJBXiFCXjNsXjNxXipGXip7XiFiXiF6XiZaXi9QXi0lXipBXiJdXiV7",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_8be0b6a81df5",
      "text": "那你們更願意直接去領教我的雙足飛龍與龍騎士的厲害囉？",
      "encoded_ascii": "^)!^*F^*{^$o^.H^#z^&`^$?^\"6^)s^,R^$%^&Z^)_^(^^)z^*>^'p^*>^0K^+a^&Z^+:^#/^3j^.V",
      "encoded_base64": "XikhXipGXip7XiRvXi5IXiN6XiZgXiQ/XiI2XilzXixSXiQlXiZaXilfXiheXil6Xio+XidwXio+XjBLXithXiZaXis6XiMvXjNqXi5W",
      "byte_length": 78
    },
    {
      "unit_id": "DLG_35d05534066f",
      "text": "看來你們既有腦子又有身手。那很好，因為",
      "encoded_ascii": "^*Q^!O^*F^*{^,U^$s^2@^#(^+;^$s^(c^$+^!\"^)!^*K^+i^*A^\"]^%{",
      "encoded_base64": "XipRXiFPXipGXip7XixVXiRzXjJAXiMoXis7XiRzXihjXiQrXiEiXikhXipLXitpXipBXiJdXiV7",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_c940a6e26158",
      "text": "飛龍騎鉤？我不知道你在胡扯些什麼。不過來吧，",
      "encoded_ascii": "^)z^*>^0K^)/^.V^$%^!)^&h^(y^*F^\"d^3}^.e^!8^!=^.T^!\"^!)^(x^!O^*I^*A",
      "encoded_base64": "Xil6Xio+XjBLXikvXi5WXiQlXiEpXiZoXih5XipGXiJkXjN9Xi5lXiE4XiE9Xi5UXiEiXiEpXih4XiFPXipJXipB",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_1f94cf81d776",
      "text": "衛兵！快過來保護我！",
      "encoded_ascii": "^(=^+,^*W^*L^(x^!O^!T^(T^$%^*W",
      "encoded_base64": "Xig9XissXipXXipMXih4XiFPXiFUXihUXiQlXipX",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_53a47689af70",
      "text": "我會盡量解釋我所知道的事，但我在此地經營的不過是筆小本生意。 ",
      "encoded_ascii": "^$%^$r^-1^)*^(I^0w^$%^$)^&h^(y^&Z^*r^*A^!I^$%^\"d^%I^\"e^'D^&'^&Z^!)^(x^,X^-A^#;^$x^&F^#z^!\" ",
      "encoded_base64": "XiQlXiRyXi0xXikqXihJXjB3XiQlXiQpXiZoXih5XiZaXipyXipBXiFJXiQlXiJkXiVJXiJlXidEXiYnXiZaXiEpXih4XixYXi1BXiM7XiR4XiZGXiN6XiEiIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_dd56e4fb0315",
      "text": "實在沒什麼好大書特書的。",
      "encoded_ascii": "^#3^\"d^%\\^!=^.T^+i^\"z^$p^&5^$p^&Z^!\"",
      "encoded_base64": "XiMzXiJkXiVcXiE9Xi5UXitpXiJ6XiRwXiY1XiRwXiZaXiEi",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_14ba6a905d78",
      "text": "  你是怎麼發現這座城堡的？",
      "encoded_ascii": "  ^*F^,X^,,^.T^&W^&?^(s^/_^+_^\"m^&Z^.V",
      "encoded_base64": "ICBeKkZeLFheLCxeLlReJldeJj9eKHNeL19eK19eIm1eJlpeLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_3ea3aed87ed1",
      "text": "  你是怎麼馴服那些雙足飛龍的？",
      "encoded_ascii": "  ^*F^,X^,,^.T^.N^,\\^)!^!8^)_^(^^)z^*>^&Z^.V",
      "encoded_base64": "ICBeKkZeLFheLCxeLlReLk5eLFxeKSFeITheKV9eKF5eKXpeKj5eJlpeLlY=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_09db7b8bdf64",
      "text": "  黑色迷宮裡有些什麼？",
      "encoded_ascii": "  ^*:^'s^(n^/\\^-j^$s^!8^!=^.T^.V",
      "encoded_base64": "ICBeKjpeJ3NeKG5eL1xeLWpeJHNeITheIT1eLlReLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_20e46a2973cf",
      "text": "  在你們到來之前，這座城堡住了些什麼人？",
      "encoded_ascii": "  ^\"d^*F^*{^!u^!O^!/^!z^*A^(s^/_^+_^\"m^*z^*D^!8^!=^.T^!<^.V",
      "encoded_base64": "ICBeImReKkZeKnteIXVeIU9eIS9eIXpeKkFeKHNeL19eK19eIm1eKnpeKkReITheIT1eLlReITxeLlY=",
      "byte_length": 59
    },
    {
      "unit_id": "DLG_45a6d82519b1",
      "text": "  我看你這張醜臉已經看煩了！",
      "encoded_ascii": "  ^$%^*Q^*F^(s^,(^2O^-\\^#J^'D^*Q^-!^*D^*W",
      "encoded_base64": "ICBeJCVeKlFeKkZeKHNeLCheMk9eLVxeI0peJ0ReKlFeLSFeKkReKlc=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_637668ff6767",
      "text": " 現在，我懇請你們識相地離開我的城堡。",
      "encoded_ascii": " ^&?^\"d^*A^$%^3t^*S^*F^*{^(R^&a^\"e^)`^)F^$%^&Z^+_^\"m^!\"",
      "encoded_base64": "IF4mP14iZF4qQV4kJV4zdF4qU14qRl4qe14oUl4mYV4iZV4pYF4pRl4kJV4mWl4rX14ibV4hIg==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_f8a32b43e9b4",
      "text": "你們在說笑吧！我絕不可能放棄如此暴利的行當。聽著， ",
      "encoded_ascii": "^*F^*{^\"d^-x^-@^*I^*W^$%^-I^!)^\"A^'b^$P^,a^#$^%I^$m^!t^&Z^(;^&N^!\"^-X^-a^*A ",
      "encoded_base64": "XipGXip7XiJkXi14Xi1AXipJXipXXiQlXi1JXiEpXiJBXidiXiRQXixhXiMkXiVJXiRtXiF0XiZaXig7XiZOXiEiXi1YXi1hXipBIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_91bf590290a5",
      "text": "只要你們離開城堡，並徹底忘記那群村民的事，我就給你們兩百枚 ",
      "encoded_ascii": "^\"?^(C^*F^*{^)`^)F^+_^\"m^*A^!+^18^/^^0]^(K^)!^'R^$z^%T^&Z^*r^*A^$%^*J^'A^*F^*{^!i^&Y^$~ ",
      "encoded_base64": "XiI/XihDXipGXip7XilgXilGXitfXiJtXipBXiErXjE4Xi9eXjBdXihLXikhXidSXiR6XiVUXiZaXipyXipBXiQlXipKXidBXipGXip7XiFpXiZZXiR+IA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_3b82d2c2986f",
      "text": "陶瓷幣。你們又不欠他們什麼，當然更犯不著 ",
      "encoded_ascii": "^)R^&E^+|^!\"^*F^*{^+;^!)^,g^!@^*{^!=^.T^*A^&N^&\"^$o^-%^!)^-a ",
      "encoded_base64": "XilSXiZFXit8XiEiXipGXip7Xis7XiEpXixnXiFAXip7XiE9Xi5UXipBXiZOXiYiXiRvXi0lXiEpXi1hIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_796384da840a",
      "text": "拿自己的性命去冒險。",
      "encoded_ascii": "^,G^'l^#I^&Z^#r^\"N^\"6^/P^*m^!\"",
      "encoded_base64": "XixHXidsXiNJXiZaXiNyXiJOXiI2Xi9QXiptXiEi",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_b23db086211d",
      "text": "  你這守財奴！我要更多錢！",
      "encoded_ascii": "  ^*F^(s^#+^0=^##^*W^$%^(C^$o^\"x^.<^*W",
      "encoded_base64": "ICBeKkZeKHNeIyteMD1eIyNeKldeJCVeKENeJG9eInheLjxeKlc=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_39956eb3954e",
      "text": "  聽起來很合理。我收下這筆錢。",
      "encoded_ascii": "  ^-X^.(^!O^*K^\"C^&A^!\"^$%^$M^!(^(s^-A^.<^!\"",
      "encoded_base64": "ICBeLVheLiheIU9eKkteIkNeJkFeISJeJCVeJE1eISheKHNeLUFeLjxeISI=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_70e13edd0b51",
      "text": "  我想要的根本不是錢。",
      "encoded_ascii": "  ^$%^,1^(C^&Z^%)^$x^!)^,X^.<^!\"",
      "encoded_base64": "ICBeJCVeLDFeKENeJlpeJSleJHheISleLFheLjxeISI=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_ae5c497016ed",
      "text": "  唯有取你狗命才能讓我滿意！",
      "encoded_ascii": "  ^+O^$s^\":^*F^-&^\"N^$,^'b^-}^$%^,{^#z^*W",
      "encoded_base64": "ICBeK09eJHNeIjpeKkZeLSZeIk5eJCxeJ2JeLX1eJCVeLHteI3peKlc=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_06ad868ac239",
      "text": "我很抱歉，我太習慣跟那些一般的毛賊打交道了。然而你們 ",
      "encoded_ascii": "^$%^*K^,@^,h^*A^$%^+f^3{^$!^.+^)!^!8^!%^'r^&Z^%R^0?^$-^0P^(y^*D^!\"^&\"^'W^*F^*{ ",
      "encoded_base64": "XiQlXipLXixAXixoXipBXiQlXitmXjN7XiQhXi4rXikhXiE4XiElXidyXiZaXiVSXjA/XiQtXjBQXih5XipEXiEiXiYiXidXXipGXip7IA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_4c50fcaf1176",
      "text": "不同凡響，值得更高的身價。一千枚陶瓷角幣 ",
      "encoded_ascii": "^!)^\"E^+-^)o^*A^!Z^#e^$o^*+^&Z^(c^+&^!\"^!%^+7^$~^)R^&E^(H^+| ",
      "encoded_base64": "XiEpXiJFXistXilvXipBXiFaXiNlXiRvXiorXiZaXihjXismXiEiXiElXis3XiR+XilSXiZFXihIXit8IA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_49c192f9dbdd",
      "text": "如何？這能滿足你們的胃口了吧？",
      "encoded_ascii": "^#$^!L^.V^(s^'b^,{^(^^*F^*{^&Z^3|^\"<^*D^*I^.V",
      "encoded_base64": "XiMkXiFMXi5WXihzXidiXix7XiheXipGXip7XiZaXjN8XiI8XipEXipJXi5W",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_06f47ad24c49",
      "text": "成交，但我身上可沒帶這麼多現錢。",
      "encoded_ascii": "^$$^0P^*A^!I^$%^(c^!'^\"A^%\\^#N^(s^.T^\"x^&?^.<^!\"",
      "encoded_base64": "XiQkXjBQXipBXiFJXiQlXihjXiEnXiJBXiVcXiNOXihzXi5UXiJ4XiY/Xi48XiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_6e2aa4842ea7",
      "text": "太好了！我親自護送你們前往城堡的下層—— ",
      "encoded_ascii": "^+f^+i^*D^*W^$%^(F^'l^(T^./^*F^*{^!z^,)^+_^\"m^&Z^!(^#B^*n^*n ",
      "encoded_base64": "XitmXitpXipEXipXXiQlXihGXidsXihUXi4vXipGXip7XiF6XiwpXitfXiJtXiZaXiEoXiNCXipuXipuIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_3b00f6355a67",
      "text": "當然，這樣衛兵就知道你們受我庇護了。 ",
      "encoded_ascii": "^&N^&\"^*A^(s^,f^(=^+,^*J^&h^(y^*F^*{^\";^$%^,\"^(T^*D^!\" ",
      "encoded_base64": "XiZOXiYiXipBXihzXixmXig9XissXipKXiZoXih5XipGXip7XiI7XiQlXiwiXihUXipEXiEiIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_36e9a9dc65df",
      "text": "等你們準備上路時，就能拿到你們的賞錢了。",
      "encoded_ascii": "^'-^*F^*{^,x^+\"^!'^(a^$f^*A^*J^'b^,G^!u^*F^*{^&Z^*T^.<^*D^!\"",
      "encoded_base64": "XictXipGXip7Xix4XisiXiEnXihhXiRmXipBXipKXidiXixHXiF1XipGXip7XiZaXipUXi48XipEXiEi",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_fce482f9f435",
      "text": "要是你們想要的是奇珍異寶，我可以帶你們前往我的藏寶室， ",
      "encoded_ascii": "^(C^,X^*F^*{^,1^(C^&Z^,X^\"}^/7^&M^#4^*A^$%^\"A^!B^#N^*F^*{^!z^,)^$%^&Z^-f^#4^+r^*A ",
      "encoded_base64": "XihDXixYXipGXip7XiwxXihDXiZaXixYXiJ9Xi83XiZNXiM0XipBXiQlXiJBXiFCXiNOXipGXip7XiF6XiwpXiQlXiZaXi1mXiM0XityXipBIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_11d5fdb9f433",
      "text": "讓你們挑一件中意的好東西。這提議合你們心意嗎？",
      "encoded_ascii": "^-}^*F^*{^,H^!%^.W^!,^#z^&Z^+i^,`^-l^!\"^(s^$A^-|^\"C^*F^*{^#k^#z^+X^.V",
      "encoded_base64": "Xi19XipGXip7XixIXiElXi5XXiEsXiN6XiZaXitpXixgXi1sXiEiXihzXiRBXi18XiJDXipGXip7XiNrXiN6XitYXi5W",
      "byte_length": 69
    },
    {
      "unit_id": "DLG_3c337bb7147a",
      "text": "我已經拿不出其他東西可以給你們了。",
      "encoded_ascii": "^$%^#J^'D^,G^!)^!q^!j^!@^,`^-l^\"A^!B^'A^*F^*{^*D^!\"",
      "encoded_base64": "XiQlXiNKXidEXixHXiEpXiFxXiFqXiFAXixgXi1sXiJBXiFCXidBXipGXip7XipEXiEi",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_402a4f2b87ed",
      "text": "雙足飛龍雖然凶猛駭人，但腦袋可不太靈光。降伏牠們需要的 ",
      "encoded_ascii": "^)_^(^^)z^*>^.A^&\"^3e^*P^4(^!<^*A^!I^2@^(?^\"A^!)^+f^)g^!c^!\"^)N^3c^-#^*{^)e^(C^&Z ",
      "encoded_base64": "XilfXiheXil6Xio+Xi5BXiYiXjNlXipQXjQoXiE8XipBXiFJXjJAXig/XiJBXiEpXitmXilnXiFjXiEiXilOXjNjXi0jXip7XillXihDXiZaIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_bb50c37d0500",
      "text": "不過是鋼鐵般的膽魄與過人的急智罷了。",
      "encoded_ascii": "^!)^(x^,X^)2^)?^'r^&Z^-[^.S^'p^(x^!<^&Z^3p^$i^1Q^*D^!\"",
      "encoded_base64": "XiEpXih4XixYXikyXik/XidyXiZaXi1bXi5TXidwXih4XiE8XiZaXjNwXiRpXjFRXipEXiEi",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_d7f25bf224d1",
      "text": "哎呀！我還從沒見過像你們這麼頑固難纏的傢伙。",
      "encoded_ascii": "^3i^3h^*W^$%^.7^#f^%\\^-m^(x^!`^*F^*{^(s^.T^4%^3>^)a^'N^&Z^+#^*y^!\"",
      "encoded_base64": "XjNpXjNoXipXXiQlXi43XiNmXiVcXi1tXih4XiFgXipGXip7XihzXi5UXjQlXjM+XilhXidOXiZaXisjXip5XiEi",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_d1da89f320b6",
      "text": "塔拉早就是陳年往事了。當我最初來到這座城堡時，我 ",
      "encoded_ascii": "^\"o^$6^,V^*J^,X^4$^+~^,)^*r^*D^!\"^&N^$%^$q^1\"^!O^!u^(s^/_^+_^\"m^$f^*A^$% ",
      "encoded_base64": "XiJvXiQ2XixWXipKXixYXjQkXit+XiwpXipyXipEXiEiXiZOXiQlXiRxXjEiXiFPXiF1XihzXi9fXitfXiJtXiRmXipBXiQlIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_6a5a5608b482",
      "text": "曾發現塔拉的魔法組織「內在之眼」留下的遺跡痕跡， ",
      "encoded_ascii": "^.j^&W^&?^\"o^$6^&Z^*0^%b^2;^3z^!#^!g^\"d^!/^&d^!$^-+^!(^&Z^0v^(`^3v^(`^*A ",
      "encoded_base64": "Xi5qXiZXXiY/XiJvXiQ2XiZaXiowXiViXjI7XjN6XiEjXiFnXiJkXiEvXiZkXiEkXi0rXiEoXiZaXjB2XihgXjN2XihgXipBIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_7a507b7c6f48",
      "text": "但她早在幾百年前就死透了。",
      "encoded_ascii": "^!I^+h^,V^\"d^#T^&Y^+~^!z^*J^%L^(q^*D^!\"",
      "encoded_base64": "XiFJXitoXixWXiJkXiNUXiZZXit+XiF6XipKXiVMXihxXipEXiEi",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_a76d162e866f",
      "text": "說來稀奇，那真是一段怪事。我被一隻弗洛魔抓到了這裡，當作 ",
      "encoded_ascii": "^-x^!O^3w^\"}^*A^)!^-2^,X^!%^.l^#s^*r^!\"^$%^(@^!%^)[^#[^%g^*0^$2^!u^*D^(s^-j^*A^&N^!M ",
      "encoded_base64": "Xi14XiFPXjN3XiJ9XipBXikhXi0yXixYXiElXi5sXiNzXipyXiEiXiQlXihAXiElXilbXiNbXiVnXiowXiQyXiF1XipEXihzXi1qXipBXiZOXiFNIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_d6283f52eb37",
      "text": "牠的一頓點心。那些惡魔至今還不時盤踞騷擾這座城堡。但那些 ",
      "encoded_ascii": "^-#^&Z^!%^.F^*;^#k^!\"^)!^!8^#y^*0^'n^*E^.7^!)^$f^1M^1_^0y^$K^(s^/_^+_^\"m^!\"^!I^)!^!8 ",
      "encoded_base64": "Xi0jXiZaXiElXi5GXio7XiNrXiEiXikhXiE4XiN5XiowXiduXipFXi43XiEpXiRmXjFNXjFfXjB5XiRLXihzXi9fXitfXiJtXiEiXiFJXikhXiE4IA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_70a824910ff2",
      "text": "雙足飛龍另有圖謀，我便趁著牠們混戰時悄悄溜之大吉。",
      "encoded_ascii": "^)_^(^^)z^*>^\">^$s^\"b^3~^*A^$%^!R^.)^-a^-#^*{^%n^$(^$f^3r^3r^%r^!/^\"z^\"D^!\"",
      "encoded_base64": "XilfXiheXil6Xio+XiI+XiRzXiJiXjN+XipBXiQlXiFSXi4pXi1hXi0jXip7XiVuXiQoXiRmXjNyXjNyXiVyXiEvXiJ6XiJEXiEi",
      "byte_length": 75
    },
    {
      "unit_id": "DLG_ee04717bfea9",
      "text": "城堡古代舊居民的冤魂幽靈，至少那些強盜 ",
      "encoded_ascii": "^+_^\"m^\"=^*v^02^+w^%T^&Z^3;^*.^2f^)g^*A^'n^#<^)!^!8^#]^0! ",
      "encoded_base64": "XitfXiJtXiI9Xip2XjAyXit3XiVUXiZaXjM7XiouXjJmXilnXipBXiduXiM8XikhXiE4XiNdXjAhIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_f65358a7e5cf",
      "text": "都是這麼深信不疑的。這正好成了一種方便的恐懼手段，讓我用來馭下管教。",
      "encoded_ascii": "^)$^,X^(s^.T^2*^!U^!)^0p^&Z^!\"^(s^%H^+i^$$^*D^!%^'$^$]^!R^&Z^#t^$#^$+^.l^*A^-}^$%^&H^!O^4'^!(^-D^,R^!\"",
      "encoded_base64": "XikkXixYXihzXi5UXjIqXiFVXiEpXjBwXiZaXiEiXihzXiVIXitpXiQkXipEXiElXickXiRdXiFSXiZaXiN0XiQjXiQrXi5sXipBXi19XiQlXiZIXiFPXjQnXiEoXi1EXixSXiEi",
      "byte_length": 102
    },
    {
      "unit_id": "DLG_8c4c9f14835b",
      "text": "就我所知，從前有一群法師住在此處。 ",
      "encoded_ascii": "^*J^$%^$)^&h^*A^#f^!z^$s^!%^'R^%b^#M^*z^\"d^%I^(,^!\" ",
      "encoded_base64": "XipKXiQlXiQpXiZoXipBXiNmXiF6XiRzXiElXidSXiViXiNNXip6XiJkXiVJXigsXiEiIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_9af9aa2d6831",
      "text": "統領他們的是一個名叫塔拉的邪惡女人。",
      "encoded_ascii": "^'B^)s^!@^*{^&Z^,X^!%^!V^\"F^+<^\"o^$6^&Z^)\"^#y^#\"^!<^!\"",
      "encoded_base64": "XidCXilzXiFAXip7XiZaXixYXiElXiFWXiJGXis8XiJvXiQ2XiZaXikiXiN5XiMiXiE8XiEi",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_b7c10750d4e5",
      "text": "那就快滾吧。老實說， ",
      "encoded_ascii": "^)!^*J^*L^,z^*I^!\"^'U^#3^-x^*A ",
      "encoded_base64": "XikhXipKXipMXix6XipJXiEiXidVXiMzXi14XipBIA==",
      "byte_length": 31
    },
    {
      "unit_id": "DLG_2ec40fd1e938",
      "text": "你們又來找我要那個騎鉤，但我對它一無所知。 ",
      "encoded_ascii": "^*F^*{^+;^!O^$/^$%^(C^)!^!V^0K^)/^*A^!I^$%^#:^+o^!%^%}^$)^&h^!\" ",
      "encoded_base64": "XipGXip7Xis7XiFPXiQvXiQlXihDXikhXiFWXjBLXikvXipBXiFJXiQlXiM6XitvXiElXiV9XiQpXiZoXiEiIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_c8919913543e",
      "text": "不過為了息事寧人，我准許你們去向我藏寶室的守護者 ",
      "encoded_ascii": "^!)^(x^%{^*D^#w^*r^3k^!<^*A^$%^/Q^-s^*F^*{^\"6^+?^$%^-f^#4^+r^&Z^#+^(T^'V ",
      "encoded_base64": "XiEpXih4XiV7XipEXiN3XipyXjNrXiE8XipBXiQlXi9RXi1zXipGXip7XiI2Xis/XiQlXi1mXiM0XityXiZaXiMrXihUXidWIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_e3730e87241f",
      "text": "當面打聽。這樣總該夠了吧？",
      "encoded_ascii": "^&N^)j^$-^-X^!\"^(s^,f^-M^(M^+d^*D^*I^.V",
      "encoded_base64": "XiZOXilqXiQtXi1YXiEiXihzXixmXi1NXihNXitkXipEXipJXi5W",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_95457987fe1c",
      "text": "很好。",
      "encoded_ascii": "^*K^+i^!\"",
      "encoded_base64": "XipLXitpXiEi",
      "byte_length": 9
    },
    {
      "unit_id": "DLG_b8f7a204518d",
      "text": " 如果你們跟我來，我會帶你們去我的藏寶室。",
      "encoded_ascii": " ^#$^%!^*F^*{^.+^$%^!O^*A^$%^$r^#N^*F^*{^\"6^$%^&Z^-f^#4^+r^!\"",
      "encoded_base64": "IF4jJF4lIV4qRl4qe14uK14kJV4hT14qQV4kJV4kcl4jTl4qRl4qe14iNl4kJV4mWl4tZl4jNF4rcl4hIg==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_99c11916ec47",
      "text": "我必須逃跑。請放過我吧。 ",
      "encoded_ascii": "^$%^#l^)r^(p^(_^!\"^*S^$P^(x^$%^*I^!\" ",
      "encoded_base64": "XiQlXiNsXilyXihwXihfXiEiXipTXiRQXih4XiQlXipJXiEiIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_7e0fd719de09",
      "text": "一名衣衫襤褸的男子突然從你眼前的沙土中衝破而出。 ",
      "encoded_ascii": "^!%^\"F^(>^*i^*k^*j^&Z^&K^#(^'*^&\"^#f^*F^&d^!z^&Z^%]^\"c^!,^-h^&n^'W^!q^!\" ",
      "encoded_base64": "XiElXiJGXig+XippXiprXipqXiZaXiZLXiMoXicqXiYiXiNmXipGXiZkXiF6XiZaXiVdXiJjXiEsXi1oXiZuXidXXiFxXiEiIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_0178a990501a",
      "text": "等等——安靜！我是朋友。你們就是從德拉吉競技場 ",
      "encoded_ascii": "^'-^'-^*n^*n^+p^)h^*W^$%^,X^,[^\"8^!\"^*F^*{^*J^,X^#f^#j^$6^\"D^-?^,>^\"n ",
      "encoded_base64": "XictXictXipuXipuXitwXiloXipXXiQlXixYXixbXiI4XiEiXipGXip7XipKXixYXiNmXiNqXiQ2XiJEXi0/Xiw+XiJuIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_14fa1a5a75ca",
      "text": "逃脫出來的人嗎？ ",
      "encoded_ascii": "^(p^'c^!q^!O^&Z^!<^+X^.V ",
      "encoded_base64": "XihwXidjXiFxXiFPXiZaXiE8XitYXi5WIA==",
      "byte_length": 25
    },
    {
      "unit_id": "DLG_3867f6ad1efe",
      "text": "噢，打擾老爺們了，十分抱歉。請原諒。 ",
      "encoded_ascii": "^+]^*A^$-^$K^'U^=S^*{^*D^*A^*Y^!s^,@^,h^!\"^*S^\"5^0<^!\" ",
      "encoded_base64": "XitdXipBXiQtXiRLXidVXj1TXip7XipEXipBXipZXiFzXixAXixoXiEiXipTXiI1XjA8XiEiIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_5252df5cac97",
      "text": "那麼你們也是面紗同盟的人了。我是卡夏。我剛從聖堂武士 ",
      "encoded_ascii": "^)!^.T^*F^*{^!1^,X^)j^-G^\"E^-0^&Z^!<^*D^!\"^$%^,X^\"0^/)^!\"^$%^+0^#f^'Z^42^%J^+a ",
      "encoded_base64": "XikhXi5UXipGXip7XiExXixYXilqXi1HXiJFXi0wXiZaXiE8XipEXiEiXiQlXixYXiIwXi8pXiEiXiQlXiswXiNmXidaXjQyXiVKXithIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_1b96fe058048",
      "text": "提奧菲爾手中逃脫。他深信你們眼前的這處溫泉底下埋藏著銅礦。 ",
      "encoded_ascii": "^$A^6Q^8q^&/^$+^!,^(p^'c^!\"^!@^2*^!U^*F^*{^&d^!z^&Z^(s^(,^%s^%a^/^^!(^1r^-f^-a^0x^5m^!\" ",
      "encoded_base64": "XiRBXjZRXjhxXiYvXiQrXiEsXihwXidjXiEiXiFAXjIqXiFVXipGXip7XiZkXiF6XiZaXihzXigsXiVzXiVhXi9eXiEoXjFyXi1mXi1hXjB4XjVtXiEiIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_aba830334930",
      "text": "他嚴刑拷問他的賢者，直到她預言出銅礦的存在，隨後便 ",
      "encoded_ascii": "^!@^1*^9|^*b^*Z^!@^&Z^>U^'V^*A^&`^!u^+h^.E^1Y^!q^0x^5m^&Z^#*^\"d^*A^)X^#b^!R ",
      "encoded_base64": "XiFAXjEqXjl8XipiXipaXiFAXiZaXj5VXidWXipBXiZgXiF1XitoXi5FXjFZXiFxXjB4XjVtXiZaXiMqXiJkXipBXilYXiNiXiFSIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_01b12ab8d1e4",
      "text": "開始強行開採這座溫泉。千萬小心——我必須趕快逃了。 ",
      "encoded_ascii": "^)F^+k^#]^(;^)F^5R^(s^/_^%s^%a^!\"^+7^-_^#;^#k^*n^*n^$%^#l^)r^0u^*L^(p^*D^!\" ",
      "encoded_base64": "XilGXitrXiNdXig7XilGXjVSXihzXi9fXiVzXiVhXiEiXis3Xi1fXiM7XiNrXipuXipuXiQlXiNsXilyXjB1XipMXihwXipEXiEiIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_0bda9bbcdf74",
      "text": "我討厭這份差事！",
      "encoded_ascii": "^$%^-o^+9^(s^*x^48^*r^*W",
      "encoded_base64": "XiQlXi1vXis5XihzXip4XjQ4XipyXipX",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_8056bc3f67f0",
      "text": "……所以我跟他說——把你的髒手從那些陶幣籌碼上拿開！",
      "encoded_ascii": "^*o^*o^$)^!B^$%^.+^!@^-x^*n^*n^$1^*F^&Z^0M^$+^#f^)!^!8^)R^+|^:W^94^!'^,G^)F^*W",
      "encoded_base64": "XipvXipvXiQpXiFCXiQlXi4rXiFAXi14XipuXipuXiQxXipGXiZaXjBNXiQrXiNmXikhXiE4XilSXit8XjpXXjk0XiEnXixHXilGXipX",
      "byte_length": 78
    },
    {
      "unit_id": "DLG_1086272a5d38",
      "text": "把嘴巴閉緊，你的舌頭就不會乾得那麼快！ ",
      "encoded_ascii": "^$1^+[^#K^.=^0r^*A^*F^&Z^'q^)t^*J^!)^$r^*X^#e^)!^.T^*L^*W ",
      "encoded_base64": "XiQxXitbXiNLXi49XjByXipBXipGXiZaXidxXil0XipKXiEpXiRyXipYXiNlXikhXi5UXipMXipXIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_6e02d2f15b63",
      "text": "沒錯，我把他們全幹掉了——聽好了，費林，那裡足足有 ",
      "encoded_ascii": "^%\\^)5^*A^$%^$1^!@^*{^!h^,!^/e^*D^*n^*n^-X^+i^*D^*A^.\"^/1^*A^)!^-j^(^^(^^$s ",
      "encoded_base64": "XiVcXik1XipBXiQlXiQxXiFAXip7XiFoXiwhXi9lXipEXipuXipuXi1YXitpXipEXipBXi4iXi8xXipBXikhXi1qXiheXiheXiRzIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_e58dd3db98ee",
      "text": " 個人，全都全副武裝、盔甲齊全。 ",
      "encoded_ascii": " ^!V^!<^*A^!h^)$^!h^52^%J^(A^!!^&]^&J^36^!h^!\" ",
      "encoded_base64": "IF4hVl4hPF4qQV4haF4pJF4haF41Ml4lSl4oQV4hIV4mXV4mSl4zNl4haF4hIiA=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_ccc56045de5f",
      "text": "烏佐馬打斷道： ",
      "encoded_ascii": "^/4^>1^*\"^$-^,T^(y^*B ",
      "encoded_base64": "Xi80Xj4xXioiXiQtXixUXih5XipCIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_f63701b6b4bd",
      "text": "排好隊，保持安靜！ ",
      "encoded_ascii": "^$<^+i^)U^*A^!T^$7^+p^)h^*W ",
      "encoded_base64": "XiQ8XitpXilVXipBXiFUXiQ3XitwXiloXipXIA==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_88662109a19d",
      "text": "下賤的叛徒！永遠不要信任僱傭兵，這是我一貫的主張！",
      "encoded_ascii": "^!(^2G^&Z^.Z^#d^*W^%W^({^!)^(C^!U^!C^=?^5,^+,^*A^(s^,X^$%^!%^;J^&Z^!-^,(^*W",
      "encoded_base64": "XiEoXjJHXiZaXi5aXiNkXipXXiVXXih7XiEpXihDXiFVXiFDXj0/XjUsXissXipBXihzXixYXiQlXiElXjtKXiZaXiEtXiwoXipX",
      "byte_length": 75
    },
    {
      "unit_id": "DLG_b27bcd72e1d4",
      "text": "好一個痛快熱鬧的下午，嗯？繼續賣力戰鬥，今晚我就給你們發配 ",
      "encoded_ascii": "^+i^!%^!V^-.^*L^&$^6G^&Z^!(^+8^*A^6N^.V^-O^'M^.$^!~^$(^*,^*A^*E^,Y^$%^*J^'A^*F^*{^&W^)& ",
      "encoded_base64": "XitpXiElXiFWXi0uXipMXiYkXjZHXiZaXiEoXis4XipBXjZOXi5WXi1PXidNXi4kXiF+XiQoXiosXipBXipFXixZXiQlXipKXidBXipGXip7XiZXXikmIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_13e47dcfc994",
      "text": "雙份配給口糧。 ",
      "encoded_ascii": "^)_^*x^)&^'A^\"<^5s^!\" ",
      "encoded_base64": "XilfXip4XikmXidBXiI8XjVzXiEiIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_06ee1aac7b8c",
      "text": "行軍時保持安靜！鹽灘的乾燥即使閉著嘴也能把你快速榨乾， ",
      "encoded_ascii": "^(;^..^$f^!T^$7^+p^)h^*W^*4^:j^&Z^*X^;0^\"1^!N^.=^-a^+[^!1^'b^$1^*F^*L^(u^8G^*X^*A ",
      "encoded_base64": "Xig7Xi4uXiRmXiFUXiQ3XitwXiloXipXXio0XjpqXiZaXipYXjswXiIxXiFOXi49Xi1hXitbXiExXidiXiQxXipGXipMXih1XjhHXipYXipBIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_0f7801e9e6e5",
      "text": "完全沒必要自找苦吃讓自己渴得更快！ ",
      "encoded_ascii": "^#,^!h^%\\^#l^(C^'l^$/^.t^2^^-}^'l^#I^,w^#e^$o^*L^*W ",
      "encoded_base64": "XiMsXiFoXiVcXiNsXihDXidsXiQvXi50XjJeXi19XidsXiNJXix3XiNlXiRvXipMXipXIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_29f1c6635900",
      "text": "向你們致敬，德拉吉的盟友……向泰克圖克提特萊致敬！我是烏佐馬，這支部隊的 ",
      "encoded_ascii": "^+?^*F^*{^'o^*O^*A^#j^$6^\"D^&Z^-0^\"8^*o^*o^+?^%f^!d^\"b^!d^$A^&5^(!^'o^*O^*W^$%^,X^/4^>1^*\"^*A^(s^$L^)#^)U^&Z ",
      "encoded_base64": "Xis/XipGXip7XidvXipPXipBXiNqXiQ2XiJEXiZaXi0wXiI4XipvXipvXis/XiVmXiFkXiJiXiFkXiRBXiY1XighXidvXipPXipXXiQlXixYXi80Xj4xXioiXipBXihzXiRMXikjXilVXiZaIA==",
      "byte_length": 109
    },
    {
      "unit_id": "DLG_c243dc601825",
      "text": "首領。我們正趕往德拉吉加入大軍，去踏平那些奴隸 ",
      "encoded_ascii": "^)~^)s^!\"^$%^*{^%H^0u^,)^#j^$6^\"D^\"\"^!f^\"z^..^*A^\"6^.,^0Y^)!^!8^##^)Z ",
      "encoded_base64": "Xil+XilzXiEiXiQlXip7XiVIXjB1XiwpXiNqXiQ2XiJEXiIiXiFmXiJ6Xi4uXipBXiI2Xi4sXjBZXikhXiE4XiMjXilaIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_a7ffc52691e0",
      "text": "村落。你們是誰？",
      "encoded_ascii": "^$z^-`^!\"^*F^*{^,X^-y^.V",
      "encoded_base64": "XiR6Xi1gXiEiXipGXip7XixYXi15Xi5W",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_319b99ddba49",
      "text": "我也一樣，是前往德拉吉的士兵。",
      "encoded_ascii": "^$%^!1^!%^,f^*A^,X^!z^,)^#j^$6^\"D^&Z^+a^+,^!\"",
      "encoded_base64": "XiQlXiExXiElXixmXipBXixYXiF6XiwpXiNqXiQ2XiJEXiZaXithXissXiEi",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_9586e0168246",
      "text": "我只是一個過路的旅人。",
      "encoded_ascii": "^$%^\"?^,X^!%^!V^(x^(a^&Z^2m^!<^!\"",
      "encoded_base64": "XiQlXiI/XixYXiElXiFWXih4XihhXiZaXjJtXiE8XiEi",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_477d17a0a67a",
      "text": "去死吧，德拉吉的人渣！",
      "encoded_ascii": "^\"6^%L^*I^*A^#j^$6^\"D^&Z^!<^,v^*W",
      "encoded_base64": "XiI2XiVMXipJXipBXiNqXiQ2XiJEXiZaXiE8Xix2XipX",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_151acaa2e66b",
      "text": "滾離這裡，否則我們就不得不宰了你們。 ",
      "encoded_ascii": "^,z^)`^(s^-j^*A^\"H^!x^$%^*{^*J^!)^#e^!)^1w^*D^*F^*{^!\" ",
      "encoded_base64": "Xix6XilgXihzXi1qXipBXiJIXiF4XiQlXip7XipKXiEpXiNlXiEpXjF3XipEXipGXip7XiEiIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_52bdfb671316",
      "text": "閉嘴，免得把沙丘收割者給引過來！到了營地再談。",
      "encoded_ascii": "^.=^+[^*A^!e^#e^$1^%]^5(^$M^+1^'V^'A^#Z^(x^!O^*W^!u^*D^&'^\"e^!l^0;^!\"",
      "encoded_base64": "Xi49XitbXipBXiFlXiNlXiQxXiVdXjUoXiRNXisxXidWXidBXiNaXih4XiFPXipXXiF1XipEXiYnXiJlXiFsXjA7XiEi",
      "byte_length": 69
    },
    {
      "unit_id": "DLG_ba645b333725",
      "text": "殺了他們！ ",
      "encoded_ascii": "^%M^*D^!@^*{^*W ",
      "encoded_base64": "XiVNXipEXiFAXip7XipXIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_956357bb72e9",
      "text": "那就繼續走你們的路吧。但記住，戰爭中沒有中立者。你們 ",
      "encoded_ascii": "^)!^*J^-O^'M^.&^*F^*{^&Z^(a^*I^!\"^!I^(K^*z^*A^$(^1I^!,^%\\^$s^!,^0'^'V^!\"^*F^*{ ",
      "encoded_base64": "XikhXipKXi1PXidNXi4mXipGXip7XiZaXihhXipJXiEiXiFJXihLXip6XipBXiQoXjFJXiEsXiVcXiRzXiEsXjAnXidWXiEiXipGXip7IA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_12ef1e0991e5",
      "text": "要麼為德拉吉效力，要麼與她為敵——而德拉吉是不可戰勝的！ ",
      "encoded_ascii": "^(C^.T^%{^#j^$6^\"D^$Q^!~^*A^(C^.T^'p^+h^%{^$U^*n^*n^'W^#j^$6^\"D^,X^!)^\"A^$(^+5^&Z^*W ",
      "encoded_base64": "XihDXi5UXiV7XiNqXiQ2XiJEXiRRXiF+XipBXihDXi5UXidwXitoXiV7XiRVXipuXipuXidXXiNqXiQ2XiJEXixYXiEpXiJBXiQoXis1XiZaXipXIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_e4b8fbdc4e03",
      "text": "要是再讓我們看見你們，你們就死定了。現在，滾吧！",
      "encoded_ascii": "^(C^,X^!l^-}^$%^*{^*Q^-m^*F^*{^*A^*F^*{^*J^%L^#.^*D^!\"^&?^\"d^*A^,z^*I^*W",
      "encoded_base64": "XihDXixYXiFsXi19XiQlXip7XipRXi1tXipGXip7XipBXipGXip7XipKXiVMXiMuXipEXiEiXiY/XiJkXipBXix6XipJXipX",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_e18d195fb588",
      "text": "很好！那就加入我們吧。沙丘收割者伏擊了我們，拖走了我的好幾個 ",
      "encoded_ascii": "^*K^+i^*W^)!^*J^\"\"^!f^$%^*{^*I^!\"^%]^5(^$M^+1^'V^3c^$F^*D^$%^*{^*A^.f^.&^*D^$%^&Z^+i^#T^!V ",
      "encoded_base64": "XipLXitpXipXXikhXipKXiIiXiFmXiQlXip7XipJXiEiXiVdXjUoXiRNXisxXidWXjNjXiRGXipEXiQlXip7XipBXi5mXi4mXipEXiQlXiZaXitpXiNUXiFWIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_498a9c225294",
      "text": "手下。在這片該死的詛咒沙漠裡，我們正需要你們的刀劍相助。",
      "encoded_ascii": "^$+^!(^!\"^\"d^(s^&1^(M^%L^&Z^(L^\"P^%]^,}^-j^*A^$%^*{^%H^)e^(C^*F^*{^&Z^7Q^!|^&a^\"#^!\"",
      "encoded_base64": "XiQrXiEoXiEiXiJkXihzXiYxXihNXiVMXiZaXihMXiJQXiVdXix9Xi1qXipBXiQlXip7XiVIXillXihDXipGXip7XiZaXjdRXiF8XiZhXiIjXiEi",
      "byte_length": 84
    },
    {
      "unit_id": "DLG_1f3c790c6a7f",
      "text": "  我願意與你們同行。",
      "encoded_ascii": "  ^$%^.H^#z^'p^*F^*{^\"E^(;^!\"",
      "encoded_base64": "ICBeJCVeLkheI3peJ3BeKkZeKnteIkVeKDteISI=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_d0d05fdf2968",
      "text": "  我是一個人獨行。",
      "encoded_ascii": "  ^$%^,X^!%^!V^!<^/z^(;^!\"",
      "encoded_base64": "ICBeJCVeLFheISVeIVZeITxeL3peKDteISI=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_013c598f5498",
      "text": "  想得美，人渣！受死吧！",
      "encoded_ascii": "  ^,1^#e^-P^*A^!<^,v^*W^\";^%L^*I^*W",
      "encoded_base64": "ICBeLDFeI2VeLVBeKkFeITxeLHZeKldeIjteJUxeKkleKlc=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_a2913ff440b5",
      "text": "很好。我們立刻出發。",
      "encoded_ascii": "^*K^+i^!\"^$%^*{^0'^.Y^!q^&W^!\"",
      "encoded_base64": "XipLXitpXiEiXiQlXip7XjAnXi5ZXiFxXiZXXiEi",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_0573992839b5",
      "text": "獨行？為什麼？",
      "encoded_ascii": "^/z^(;^.V^%{^!=^.T^.V",
      "encoded_base64": "Xi96Xig7Xi5WXiV7XiE9Xi5UXi5W",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_59b29fcccb1c",
      "text": "  我改變主意了。我跟你們一起走。",
      "encoded_ascii": "  ^$%^$N^(U^!-^#z^*D^!\"^$%^.+^*F^*{^!%^.(^.&^!\"",
      "encoded_base64": "ICBeJCVeJE5eKFVeIS1eI3peKkReISJeJCVeLiteKkZeKnteISVeLiheLiZeISI=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_7529c1b722e2",
      "text": "  我的任務是保密的。",
      "encoded_ascii": "  ^$%^&Z^!C^+4^,X^!T^#0^&Z^!\"",
      "encoded_base64": "ICBeJCVeJlpeIUNeKzReLFheIVReIzBeJlpeISI=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_a5caec86c8f3",
      "text": "  因為我要把你們殺光！",
      "encoded_ascii": "  ^\"]^%{^$%^(C^$1^*F^*{^%M^!c^*W",
      "encoded_base64": "ICBeIl1eJXteJCVeKENeJDFeKkZeKnteJU1eIWNeKlc=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_3df06865cb18",
      "text": "你打仗的本事也跟你說謊一樣差勁嗎？",
      "encoded_ascii": "^*F^$-^0|^&Z^$x^*r^!1^.+^*F^-x^3*^!%^,f^48^+3^+X^.V",
      "encoded_base64": "XipGXiQtXjB8XiZaXiR4XipyXiExXi4rXipGXi14XjMqXiElXixmXjQ4XiszXitYXi5W",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_a14da80e96d8",
      "text": "我不信任你。離我的隊伍遠一點。要是你敢跟在我們後面， ",
      "encoded_ascii": "^$%^!)^!U^!C^*F^!\"^)`^$%^&Z^)U^!F^({^!%^*;^!\"^(C^,X^*F^/m^.+^\"d^$%^*{^#b^)j^*A ",
      "encoded_base64": "XiQlXiEpXiFVXiFDXipGXiEiXilgXiQlXiZaXilVXiFGXih7XiElXio7XiEiXihDXixYXipGXi9tXi4rXiJkXiQlXip7XiNiXilqXipBIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_074215eb77bc",
      "text": "你就會變成沙丘收割者的新鮮美餐。",
      "encoded_ascii": "^*F^*J^$r^(U^$$^%]^5(^$M^+1^'V^&Z^$\\^35^-P^.K^!\"",
      "encoded_base64": "XipGXipKXiRyXihVXiQkXiVdXjUoXiRNXisxXidWXiZaXiRcXjM1Xi1QXi5LXiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_dfa42e75422d",
      "text": "這麼說，你們是間諜！我早該把你們宰了。",
      "encoded_ascii": "^(s^.T^-x^*A^*F^*{^,X^)G^>X^*W^$%^,V^(M^$1^*F^*{^1w^*D^!\"",
      "encoded_base64": "XihzXi5UXi14XipBXipGXip7XixYXilHXj5YXipXXiQlXixWXihNXiQxXipGXip7XjF3XipEXiEi",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_1999cabd8852",
      "text": "太好了，你們趕上來了！我們在等待時紮了營，但現在是 ",
      "encoded_ascii": "^+f^+i^*D^*A^*F^*{^0u^!'^!O^*D^*W^$%^*{^\"d^'-^,*^$f^8\"^*D^&'^*A^!I^&?^\"d^,X ",
      "encoded_base64": "XitmXitpXipEXipBXipGXip7XjB1XiEnXiFPXipEXipXXiQlXip7XiJkXictXiwqXiRmXjgiXipEXiYnXipBXiFJXiY/XiJkXixYIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_069a71d41e88",
      "text": "出發的時候了！",
      "encoded_ascii": "^!q^&W^&Z^$f^*|^*D^*W",
      "encoded_base64": "XiFxXiZXXiZaXiRmXip8XipEXipX",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_6ca01a565401",
      "text": "你看見一縷青煙從 ",
      "encoded_ascii": "^*F^*Q^-m^!%^6h^2Q^4S^#f ",
      "encoded_base64": "XipGXipRXi1tXiElXjZoXjJRXjRTXiNmIA==",
      "byte_length": 25
    },
    {
      "unit_id": "DLG_00fd75deae9a",
      "text": "附近升起",
      "encoded_ascii": "^.?^(l^\",^.(",
      "encoded_base64": "Xi4/XihsXiIsXi4o",
      "byte_length": 12
    },
    {
      "unit_id": "DLG_f6883838c168",
      "text": "對決 ",
      "encoded_ascii": "^#:^,o ",
      "encoded_base64": "XiM6XixvIA==",
      "byte_length": 7
    },
    {
      "unit_id": "DLG_e6f24037ecd0",
      "text": "。片刻之後，煙霧消失了。",
      "encoded_ascii": "^!\"^&1^.Y^!/^#b^*A^4S^)f^%k^\"|^*D^!\"",
      "encoded_base64": "XiEiXiYxXi5ZXiEvXiNiXipBXjRTXilmXiVrXiJ8XipEXiEi",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_d98a44ec8079",
      "text": "看前面！是附近奴隸村落的士兵。在他們能回去通報之前 ",
      "encoded_ascii": "^*Q^!z^)j^*W^,X^.?^(l^##^)Z^$z^-`^&Z^+a^+,^!\"^\"d^!@^*{^'b^\"\\^\"6^(t^+`^!/^!z ",
      "encoded_base64": "XipRXiF6XilqXipXXixYXi4/XihsXiMjXilaXiR6Xi1gXiZaXithXissXiEiXiJkXiFAXip7XidiXiJcXiI2Xih0XitgXiEvXiF6IA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_23fcb78f9948",
      "text": "宰了他們！",
      "encoded_ascii": "^1w^*D^!@^*{^*W",
      "encoded_base64": "XjF3XipEXiFAXip7XipX",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_25e46c855cf5",
      "text": "我是不是在哪裡見過你？ ",
      "encoded_ascii": "^$%^,X^!)^,X^\"d^+I^-j^-m^(x^*F^.V ",
      "encoded_base64": "XiQlXixYXiEpXixYXiJkXitJXi1qXi1tXih4XipGXi5WIA==",
      "byte_length": 34
    },
    {
      "unit_id": "DLG_ac04b6fbbff0",
      "text": "我肯定以前見過你。 ",
      "encoded_ascii": "^$%^-Z^#.^!B^!z^-m^(x^*F^!\" ",
      "encoded_base64": "XiQlXi1aXiMuXiFCXiF6Xi1tXih4XipGXiEiIA==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_66b339392fa5",
      "text": "德拉吉的人渣！你們休想打敗我們。 ",
      "encoded_ascii": "^#j^$6^\"D^&Z^!<^,v^*W^*F^*{^!G^,1^$-^$R^$%^*{^!\" ",
      "encoded_base64": "XiNqXiQ2XiJEXiZaXiE8Xix2XipXXipGXip7XiFHXiwxXiQtXiRSXiQlXip7XiEiIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_df2b529e9263",
      "text": "幹得漂亮！你們襲擊他們時，看到他們臉上的表情了嗎？ ",
      "encoded_ascii": "^,!^#e^,|^*t^*W^*F^*{^08^$F^!@^*{^$f^*A^*Q^!u^!@^*{^-\\^!'^&Z^-i^,0^*D^+X^.V ",
      "encoded_base64": "XiwhXiNlXix8Xip0XipXXipGXip7XjA4XiRGXiFAXip7XiRmXipBXipRXiF1XiFAXip7Xi1cXiEnXiZaXi1pXiwwXipEXitYXi5WIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_d036199465df",
      "text": "你們真是出色的戰士！",
      "encoded_ascii": "^*F^*{^-2^,X^!q^'s^&Z^$(^+a^*W",
      "encoded_base64": "XipGXip7Xi0yXixYXiFxXidzXiZaXiQoXithXipX",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_9fae76f5525c",
      "text": "感謝你們的相助。要是沒有你們，我們根本毫無勝算。 ",
      "encoded_ascii": "^#{^-z^*F^*{^&Z^&a^\"#^!\"^(C^,X^%\\^$s^*F^*{^*A^$%^*{^%)^$x^/t^%}^+5^-C^!\" ",
      "encoded_base64": "XiN7Xi16XipGXip7XiZaXiZhXiIjXiEiXihDXixYXiVcXiRzXipGXip7XipBXiQlXip7XiUpXiR4Xi90XiV9Xis1Xi1DXiEiIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_b4086d052d0e",
      "text": "叛徒！他們給了你們多少錢收買你們倒戈，人渣？ ",
      "encoded_ascii": "^.Z^#d^*W^!@^*{^'A^*D^*F^*{^\"x^#<^.<^$M^.!^*F^*{^!X^*M^*A^!<^,v^.V ",
      "encoded_base64": "Xi5aXiNkXipXXiFAXip7XidBXipEXipGXip7XiJ4XiM8Xi48XiRNXi4hXipGXip7XiFYXipNXipBXiE8Xix2Xi5WIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_889a5998bf82",
      "text": "你們會為此付出生命的代價！ ",
      "encoded_ascii": "^*F^*{^$r^%{^%I^*u^!q^&F^\"N^&Z^*v^+&^*W ",
      "encoded_base64": "XipGXip7XiRyXiV7XiVJXip1XiFxXiZGXiJOXiZaXip2XismXipXIA==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_11bbd3a6ebd4",
      "text": "我就知道我們不該信任你們！ ",
      "encoded_ascii": "^$%^*J^&h^(y^$%^*{^!)^(M^!U^!C^*F^*{^*W ",
      "encoded_base64": "XiQlXipKXiZoXih5XiQlXip7XiEpXihNXiFVXiFDXipGXip7XipXIA==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_be7dbe85d882",
      "text": "我們很快就會把那些小雜種打得抱頭鼠竄。 ",
      "encoded_ascii": "^$%^*{^*K^*L^*J^$r^$1^)!^!8^#;^0G^'$^$-^#e^,@^)t^*=^7c^!\" ",
      "encoded_base64": "XiQlXip7XipLXipMXipKXiRyXiQxXikhXiE4XiM7XjBHXickXiQtXiNlXixAXil0Xio9XjdjXiEiIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_00531b8637a1",
      "text": "英勇奮戰吧，劍友！ ",
      "encoded_ascii": "^'y^\"$^+g^$(^*I^*A^!|^\"8^*W ",
      "encoded_base64": "Xid5XiIkXitnXiQoXipJXipBXiF8XiI4XipXIA==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_159ae83061eb",
      "text": "我沒時間多聊。 ",
      "encoded_ascii": "^$%^%\\^$f^)G^\"x^-U^!\" ",
      "encoded_base64": "XiQlXiVcXiRmXilHXiJ4Xi1VXiEiIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_d86e7fb7e501",
      "text": "幹得漂亮，朋友們！當你們動手把那些走狗砍翻在地時，看到他們臉上的表情了嗎？ ",
      "encoded_ascii": "^,!^#e^,|^*t^*A^,[^\"8^*{^*W^&N^*F^*{^\"%^$+^$1^)!^!8^.&^-&^&l^-Q^\"d^\"e^$f^*A^*Q^!u^!@^*{^-\\^!'^&Z^-i^,0^*D^+X^.V ",
      "encoded_base64": "XiwhXiNlXix8Xip0XipBXixbXiI4Xip7XipXXiZOXipGXip7XiIlXiQrXiQxXikhXiE4Xi4mXi0mXiZsXi1RXiJkXiJlXiRmXipBXipRXiF1XiFAXip7Xi1cXiEnXiZaXi1pXiwwXipEXitYXi5WIA==",
      "byte_length": 112
    },
    {
      "unit_id": "DLG_447718bc422a",
      "text": "哈哈！",
      "encoded_ascii": "^+F^+F^*W",
      "encoded_base64": "XitGXitGXipX",
      "byte_length": 9
    },
    {
      "unit_id": "DLG_acbee5a61d9d",
      "text": "我們是來自提奎茲爾的巡邏隊，正準備回去。我們會將你們的義舉 ",
      "encoded_ascii": "^$%^*{^,X^!O^'l^$A^5B^/D^&/^&Z^8g^8u^)U^*A^%H^,x^+\"^\"\\^\"6^!\"^$%^*{^$r^#7^*F^*{^&Z^2<^01 ",
      "encoded_base64": "XiQlXip7XixYXiFPXidsXiRBXjVCXi9EXiYvXiZaXjhnXjh1XilVXipBXiVIXix4XisiXiJcXiI2XiEiXiQlXip7XiRyXiM3XipGXip7XiZaXjI8XjAxIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_7cb86909702c",
      "text": "如實相告。再會！",
      "encoded_ascii": "^#$^#3^&a^+B^!\"^!l^$r^*W",
      "encoded_base64": "XiMkXiMzXiZhXitCXiEiXiFsXiRyXipX",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_29adb92fdedd",
      "text": "我認得你們……你們是逃跑的奴隸！詛咒你們，叛徒！",
      "encoded_ascii": "^$%^(O^#e^*F^*{^*o^*o^*F^*{^,X^(p^(_^&Z^##^)Z^*W^(L^\"P^*F^*{^*A^.Z^#d^*W",
      "encoded_base64": "XiQlXihPXiNlXipGXip7XipvXipvXipGXip7XixYXihwXihfXiZaXiMjXilaXipXXihMXiJQXipGXip7XipBXi5aXiNkXipX",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_58cae4f4d409",
      "text": "我就知道！是間諜！宰了你們一定很痛快。",
      "encoded_ascii": "^$%^*J^&h^(y^*W^,X^)G^>X^*W^1w^*D^*F^*{^!%^#.^*K^-.^*L^!\"",
      "encoded_base64": "XiQlXipKXiZoXih5XipXXixYXilHXj5YXipXXjF3XipEXipGXip7XiElXiMuXipLXi0uXipMXiEi",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_17187448c0b1",
      "text": "我們會宰了你這叛徒！",
      "encoded_ascii": "^$%^*{^$r^1w^*D^*F^(s^.Z^#d^*W",
      "encoded_base64": "XiQlXip7XiRyXjF3XipEXipGXihzXi5aXiNkXipX",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_ba5b313e1669",
      "text": "你加入了德拉吉巡邏隊，一同襲擊提奎茲爾村民！",
      "encoded_ascii": "^*F^\"\"^!f^*D^#j^$6^\"D^8g^8u^)U^*A^!%^\"E^08^$F^$A^5B^/D^&/^$z^%T^*W",
      "encoded_base64": "XipGXiIiXiFmXipEXiNqXiQ2XiJEXjhnXjh1XilVXipBXiElXiJFXjA4XiRGXiRBXjVCXi9EXiYvXiR6XiVUXipX",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_cd8fd63ba7a5",
      "text": "你攻擊了德拉吉士兵，挺身保護提奎茲爾村的 ",
      "encoded_ascii": "^*F^$O^$F^*D^#j^$6^\"D^+a^+,^*A^,I^(c^!T^(T^$A^5B^/D^&/^$z^&Z ",
      "encoded_base64": "XipGXiRPXiRGXipEXiNqXiQ2XiJEXithXissXipBXixJXihjXiFUXihUXiRBXjVCXi9EXiYvXiR6XiZaIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_84ce1db9731e",
      "text": "巡邏隊。",
      "encoded_ascii": "^8g^8u^)U^!\"",
      "encoded_base64": "XjhnXjh1XilVXiEi",
      "byte_length": 12
    },
    {
      "unit_id": "DLG_8aaab3792328",
      "text": "奴隸逃跑了！ ",
      "encoded_ascii": "^##^)Z^(p^(_^*D^*W ",
      "encoded_base64": "XiMjXilaXihwXihfXipEXipXIA==",
      "byte_length": 19
    },
    {
      "unit_id": "DLG_f2081480f2a4",
      "text": "看來我只能親自跟你們動手了！ ",
      "encoded_ascii": "^*Q^!O^$%^\"?^'b^(F^'l^.+^*F^*{^\"%^$+^*D^*W ",
      "encoded_base64": "XipRXiFPXiQlXiI/XidiXihGXidsXi4rXipGXip7XiIlXiQrXipEXipXIA==",
      "byte_length": 43
    },
    {
      "unit_id": "DLG_db30791556fa",
      "text": "快來救我，衛兵！快殺了他們！",
      "encoded_ascii": "^*L^!O^,Q^$%^*A^(=^+,^*W^*L^%M^*D^!@^*{^*W",
      "encoded_base64": "XipMXiFPXixRXiQlXipBXig9XissXipXXipMXiVNXipEXiFAXip7XipX",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_c4c067f130e9",
      "text": "你們是誰？為什麼會在這裡？你們知道自己是在跟誰 ",
      "encoded_ascii": "^*F^*{^,X^-y^.V^%{^!=^.T^$r^\"d^(s^-j^.V^*F^*{^&h^(y^'l^#I^,X^\"d^.+^-y ",
      "encoded_base64": "XipGXip7XixYXi15Xi5WXiV7XiE9Xi5UXiRyXiJkXihzXi1qXi5WXipGXip7XiZoXih5XidsXiNJXixYXiJkXi4rXi15IA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_fb8ac2b1a941",
      "text": "說話嗎？你們不是間諜就是蠢蛋。 ",
      "encoded_ascii": "^-x^-v^+X^.V^*F^*{^!)^,X^)G^>X^*J^,X^.u^6\"^!\" ",
      "encoded_base64": "Xi14Xi12XitYXi5WXipGXip7XiEpXixYXilHXj5YXipKXixYXi51XjYiXiEiIA==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_72c90d407d81",
      "text": "等等……你們看起來不像普通的奴隸。看你們這副模樣， ",
      "encoded_ascii": "^'-^'-^*o^*o^*F^*{^*Q^.(^!O^!)^!`^$g^(t^&Z^##^)Z^!\"^*Q^*F^*{^(s^52^%:^,f^*A ",
      "encoded_base64": "XictXictXipvXipvXipGXip7XipRXi4oXiFPXiEpXiFgXiRnXih0XiZaXiMjXilaXiEiXipRXipGXip7XihzXjUyXiU6XixmXipBIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_3bc6862076b4",
      "text": "八成是我政敵派來的密探。 ",
      "encoded_ascii": "^50^$$^,X^$%^,P^$U^.n^!O^&Z^#0^$>^!\" ",
      "encoded_base64": "XjUwXiQkXixYXiQlXixQXiRVXi5uXiFPXiZaXiMwXiQ+XiEiIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_35a7f944f3b1",
      "text": "  話說回來，我到底是在跟誰說話？ ",
      "encoded_ascii": "  ^-v^-x^\"\\^!O^*A^$%^!u^/^^,X^\"d^.+^-y^-x^-v^.V ",
      "encoded_base64": "ICBeLXZeLXheIlxeIU9eKkFeJCVeIXVeL15eLFheImReLiteLXleLXheLXZeLlYg",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_9919a2b3573f",
      "text": "  我質疑你們毀壞這處溫泉的權力。 ",
      "encoded_ascii": "  ^$%^(Z^0p^*F^*{^%N^\"v^(s^(,^%s^%a^&Z^1E^!~^!\" ",
      "encoded_base64": "ICBeJCVeKFpeMHBeKkZeKnteJU5eInZeKHNeKCxeJXNeJWFeJlpeMUVeIX5eISIg",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_e20e2ba80362",
      "text": "  把你的嘴巴放乾淨點，否則我就把它扯出來！ ",
      "encoded_ascii": "  ^$1^*F^&Z^+[^#K^$P^*X^0k^*;^*A^\"H^!x^$%^*J^$1^+o^.e^!q^!O^*W ",
      "encoded_base64": "ICBeJDFeKkZeJlpeK1teI0teJFBeKlheMGteKjteKkFeIkheIXheJCVeKkpeJDFeK29eLmVeIXFeIU9eKlcg",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_42c4b606c1b4",
      "text": "  你們為什麼要在這處溫泉開礦？ ",
      "encoded_ascii": "  ^*F^*{^%{^!=^.T^(C^\"d^(s^(,^%s^%a^)F^5m^.V ",
      "encoded_base64": "ICBeKkZeKnteJXteIT1eLlReKENeImReKHNeKCxeJXNeJWFeKUZeNW1eLlYg",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_8357389e308d",
      "text": "  你憑什麼認為這裡有銅礦？",
      "encoded_ascii": "  ^*F^,5^!=^.T^(O^%{^(s^-j^$s^0x^5m^.V",
      "encoded_base64": "ICBeKkZeLDVeIT1eLlReKE9eJXteKHNeLWpeJHNeMHheNW1eLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_3654d7a767ce",
      "text": "  我不是間諜！",
      "encoded_ascii": "  ^$%^!)^,X^)G^>X^*W",
      "encoded_base64": "ICBeJCVeISleLFheKUdePlheKlc=",
      "byte_length": 20
    },
    {
      "unit_id": "DLG_2af132bdb245",
      "text": "  沒錯。我就是間諜。",
      "encoded_ascii": "  ^%\\^)5^!\"^$%^*J^,X^)G^>X^!\"",
      "encoded_base64": "ICBeJVxeKTVeISJeJCVeKkpeLFheKUdePlheISI=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_5308f6a6857e",
      "text": "  要是我能證明這裡根本沒有銅礦呢？ ",
      "encoded_ascii": "  ^(C^,X^$%^'b^-{^$c^(s^-j^%)^$x^%\\^$s^0x^5m^+C^.V ",
      "encoded_base64": "ICBeKENeLFheJCVeJ2JeLXteJGNeKHNeLWpeJSleJHheJVxeJHNeMHheNW1eK0NeLlYg",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_11666ffccf07",
      "text": "  這根魔杖能探測出所有的金屬。 ",
      "encoded_ascii": "  ^(s^%)^*0^${^'b^$>^%p^!q^$)^$s^&Z^)+^#C^!\" ",
      "encoded_base64": "ICBeKHNeJSleKjBeJHteJ2JeJD5eJXBeIXFeJCleJHNeJlpeKSteI0NeISIg",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_ffaa1ca49d06",
      "text": "那就滾吧，回去幹活。 ",
      "encoded_ascii": "^)!^*J^,z^*I^*A^\"\\^\"6^,!^%i^!\" ",
      "encoded_base64": "XikhXipKXix6XipJXipBXiJcXiI2XiwhXiVpXiEiIA==",
      "byte_length": 31
    },
    {
      "unit_id": "DLG_e31cdb5cab60",
      "text": "休得嘲弄我，人渣！ ",
      "encoded_ascii": "^!G^#e^+Z^/`^$%^*A^!<^,v^*W ",
      "encoded_base64": "XiFHXiNlXitaXi9gXiQlXipBXiE8Xix2XipXIA==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_2850e66edcaa",
      "text": "我是聖堂武士團的提奧菲爾！這些是我的守衛和奴隸。 ",
      "encoded_ascii": "^$%^,X^'Z^42^%J^+a^0V^&Z^$A^6Q^8q^&/^*W^(s^!8^,X^$%^&Z^#+^(=^\"O^##^)Z^!\" ",
      "encoded_base64": "XiQlXixYXidaXjQyXiVKXithXjBWXiZaXiRBXjZRXjhxXiYvXipXXihzXiE4XixYXiQlXiZaXiMrXig9XiJPXiMjXilaXiEiIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_da9a7a5a7a4f",
      "text": "凡你所見的一切，我皆以聖堂武士的權威據為己有！ ",
      "encoded_ascii": "^+-^*F^$)^-m^&Z^!%^+.^*A^$%^5j^!B^'Z^42^%J^+a^&Z^1E^#&^5T^%{^#I^$s^*W ",
      "encoded_base64": "XistXipGXiQpXi1tXiZaXiElXisuXipBXiQlXjVqXiFCXidaXjQyXiVKXithXiZaXjFFXiMmXjVUXiV7XiNJXiRzXipXIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_2a31fecc7844",
      "text": "你知道你在跟誰說話嗎？我是聖堂武士——我想做什麼就可以做什麼。 ",
      "encoded_ascii": "^*F^&h^(y^*F^\"d^.+^-y^-x^-v^+X^.V^$%^,X^'Z^42^%J^+a^*n^*n^$%^,1^*~^!=^.T^*J^\"A^!B^*~^!=^.T^!\" ",
      "encoded_base64": "XipGXiZoXih5XipGXiJkXi4rXi15Xi14Xi12XitYXi5WXiQlXixYXidaXjQyXiVKXithXipuXipuXiQlXiwxXip+XiE9Xi5UXipKXiJBXiFCXip+XiE9Xi5UXiEiIA==",
      "byte_length": 94
    },
    {
      "unit_id": "DLG_c6507e94c004",
      "text": "無人敢違抗我們至高正義的教團！",
      "encoded_ascii": "^%}^!<^/m^9P^$4^$%^*{^'n^*+^%H^2<^&Z^,R^0V^*W",
      "encoded_base64": "XiV9XiE8Xi9tXjlQXiQ0XiQlXip7XiduXiorXiVIXjI8XiZaXixSXjBWXipX",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_632b40946cda",
      "text": "我極其卑微地向您賠罪，老爺大人。 ",
      "encoded_ascii": "^$%^1D^!j^\".^#i^\"e^+?^4:^62^5x^*A^'U^=S^\"z^!<^!\" ",
      "encoded_base64": "XiQlXjFEXiFqXiIuXiNpXiJlXis/XjQ6XjYyXjV4XipBXidVXj1TXiJ6XiE8XiEiIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_d082b4e0a895",
      "text": "您為何要毀壞這處溫泉呢，正義的大人？",
      "encoded_ascii": "^4:^%{^!L^(C^%N^\"v^(s^(,^%s^%a^+C^*A^%H^2<^&Z^\"z^!<^.V",
      "encoded_base64": "XjQ6XiV7XiFMXihDXiVOXiJ2XihzXigsXiVzXiVhXitDXipBXiVIXjI8XiZaXiJ6XiE8Xi5W",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_3b4b84418446",
      "text": "我殺過的聖堂武士多得連我自己都數不清。 ",
      "encoded_ascii": "^$%^%M^(x^&Z^'Z^42^%J^+a^\"x^#e^.0^$%^'l^#I^)$^$V^!)^,u^!\" ",
      "encoded_base64": "XiQlXiVNXih4XiZaXidaXjQyXiVKXithXiJ4XiNlXi4wXiQlXidsXiNJXikkXiRWXiEpXix1XiEiIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_eb5387059f66",
      "text": "怎麼，這不是很明顯嗎？這處溫泉底下有銅礦。 ",
      "encoded_ascii": "^,,^.T^*A^(s^!)^,X^*K^$c^4&^+X^.V^(s^(,^%s^%a^/^^!(^$s^0x^5m^!\" ",
      "encoded_base64": "XiwsXi5UXipBXihzXiEpXixYXipLXiRjXjQmXitYXi5WXihzXigsXiVzXiVhXi9eXiEoXiRzXjB4XjVtXiEiIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_ad72d8dc551e",
      "text": "好吧，呃，既然你這麼說的話——衛兵！救命！",
      "encoded_ascii": "^+i^*I^*A^3<^*A^,U^&\"^*F^(s^.T^-x^&Z^-v^*n^*n^(=^+,^*W^,Q^\"N^*W",
      "encoded_base64": "XitpXipJXipBXjM8XipBXixVXiYiXipGXihzXi5UXi14XiZaXi12XipuXipuXig9XissXipXXixRXiJOXipX",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_5c799c285be5",
      "text": "我的賢者從岩石的靈光中占卜出銅礦的存在。 ",
      "encoded_ascii": "^$%^&Z^>U^'V^#f^#D^&k^&Z^)g^!c^!,^54^53^!q^0x^5m^&Z^#*^\"d^!\" ",
      "encoded_base64": "XiQlXiZaXj5VXidWXiNmXiNEXiZrXiZaXilnXiFjXiEsXjU0XjUzXiFxXjB4XjVtXiZaXiMqXiJkXiEiIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_f86f2faa6122",
      "text": "這一次她顯得格外篤定自信。 ",
      "encoded_ascii": "^(s^!%^%D^+h^4&^#e^%*^\"w^>W^#.^'l^!U^!\" ",
      "encoded_base64": "XihzXiElXiVEXitoXjQmXiNlXiUqXiJ3Xj5XXiMuXidsXiFVXiEiIA==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_283149c2fd24",
      "text": "你當然是！其他聖堂武士為了查出我在這裡幹什麼，可謂不擇手段。 ",
      "encoded_ascii": "^*F^&N^&\"^,X^*W^!j^!@^'Z^42^%J^+a^%{^*D^%&^!q^$%^\"d^(s^-j^,!^!=^.T^*A^\"A^0s^!)^,N^$+^.l^!\" ",
      "encoded_base64": "XipGXiZOXiYiXixYXipXXiFqXiFAXidaXjQyXiVKXithXiV7XipEXiUmXiFxXiQlXiJkXihzXi1qXiwhXiE9Xi5UXipBXiJBXjBzXiEpXixOXiQrXi5sXiEiIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_ff3e81dc90c7",
      "text": "我絕不會讓他們奪走屬於我的 ",
      "encoded_ascii": "^$%^-I^!)^$r^-}^!@^*{^1,^.&^#C^$^^$%^&Z ",
      "encoded_base64": "XiQlXi1JXiEpXiRyXi19XiFAXip7XjEsXi4mXiNDXiReXiQlXiZaIA==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_5edb70748b83",
      "text": "財富！",
      "encoded_ascii": "^0=^3C^*W",
      "encoded_base64": "XjA9XjNDXipX",
      "byte_length": 9
    },
    {
      "unit_id": "DLG_3ababae3c396",
      "text": "你們當然是間諜！光看你們那副賊眉鼠眼的模樣 ",
      "encoded_ascii": "^*F^*{^&N^&\"^,X^)G^>X^*W^!c^*Q^*F^*{^)!^52^0?^3S^*=^&d^&Z^%:^,f ",
      "encoded_base64": "XipGXip7XiZOXiYiXixYXilHXj5YXipXXiFjXipRXipGXip7XikhXjUyXjA/XjNTXio9XiZkXiZaXiU6XixmIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_dd720e43d02a",
      "text": "我就知道了。",
      "encoded_ascii": "^$%^*J^&h^(y^*D^!\"",
      "encoded_base64": "XiQlXipKXiZoXih5XipEXiEi",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_b116d3f2c85c",
      "text": "你怎麼可能做得到？！要是你能證明這裡根本沒有銅礦， ",
      "encoded_ascii": "^*F^,,^.T^\"A^'b^*~^#e^!u^.V^*W^(C^,X^*F^'b^-{^$c^(s^-j^%)^$x^%\\^$s^0x^5m^*A ",
      "encoded_base64": "XipGXiwsXi5UXiJBXidiXip+XiNlXiF1Xi5WXipXXihDXixYXipGXidiXi17XiRjXihzXi1qXiUpXiR4XiVcXiRzXjB4XjVtXipBIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_ac36ba77b3cb",
      "text": "我就離開。 ",
      "encoded_ascii": "^$%^*J^)`^)F^!\" ",
      "encoded_base64": "XiQlXipKXilgXilGXiEiIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_564d5ce841ed",
      "text": "聖堂武士瞇起了眼睛。 ",
      "encoded_ascii": "^'Z^42^%J^+a^>V^.(^*D^&d^&f^!\" ",
      "encoded_base64": "XidaXjQyXiVKXithXj5WXi4oXipEXiZkXiZmXiEiIA==",
      "byte_length": 31
    },
    {
      "unit_id": "DLG_e74ffb610237",
      "text": "我跟你說——把魔杖給我，我就收拾東西離開—— ",
      "encoded_ascii": "^$%^.+^*F^-x^*n^*n^$1^*0^${^'A^$%^*A^$%^*J^$M^7[^,`^-l^)`^)F^*n^*n ",
      "encoded_base64": "XiQlXi4rXipGXi14XipuXipuXiQxXiowXiR7XidBXiQlXipBXiQlXipKXiRNXjdbXixgXi1sXilgXilGXipuXipuIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_1cae4a514a3b",
      "text": "再也不碰這處溫泉一分一毫！你同意嗎？",
      "encoded_ascii": "^!l^!1^!)^-5^(s^(,^%s^%a^!%^!s^!%^/t^*W^*F^\"E^#z^+X^.V",
      "encoded_base64": "XiFsXiExXiEpXi01XihzXigsXiVzXiVhXiElXiFzXiElXi90XipXXipGXiJFXiN6XitYXi5W",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_49af7b0abb59",
      "text": "這只不過是一根爛木棍！衛兵！ ",
      "encoded_ascii": "^(s^\"?^!)^(x^,X^!%^%)^&-^$v^%0^*W^(=^+,^*W ",
      "encoded_base64": "XihzXiI/XiEpXih4XixYXiElXiUpXiYtXiR2XiUwXipXXig9XissXipXIA==",
      "byte_length": 43
    },
    {
      "unit_id": "DLG_4856c13d69c9",
      "text": "這對雙方都是一筆公平的交易。再會。 ",
      "encoded_ascii": "^(s^#:^)_^$]^)$^,X^!%^-A^3:^0Y^&Z^0P^,W^!\"^!l^$r^!\" ",
      "encoded_base64": "XihzXiM6XilfXiRdXikkXixYXiElXi1BXjM6XjBZXiZaXjBQXixXXiEiXiFsXiRyXiEiIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_351a6c901e30",
      "text": "我不信你們！你們想詐騙我！衛兵！ ",
      "encoded_ascii": "^$%^!)^!U^*F^*{^*W^*F^*{^,1^6(^.{^$%^*W^(=^+,^*W ",
      "encoded_base64": "XiQlXiEpXiFVXipGXip7XipXXipGXip7XiwxXjYoXi57XiQlXipXXig9XissXipXIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_5966b2b4727c",
      "text": " 察覺到沙土下方有些微的動靜。",
      "encoded_ascii": " ^#2^(G^!u^%]^\"c^!(^$]^$s^!8^#i^&Z^\"%^)h^!\"",
      "encoded_base64": "IF4jMl4oR14hdV4lXV4iY14hKF4kXV4kc14hOF4jaV4mWl4iJV4paF4hIg==",
      "byte_length": 43
    },
    {
      "unit_id": "DLG_d3aa54ec9961",
      "text": "你要嘗試攀爬",
      "encoded_ascii": "^*F^(C^1o^-u^8|^/y",
      "encoded_base64": "XipGXihDXjFvXi11Xjh8Xi95",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_79536d477056",
      "text": "這座懸崖嗎？",
      "encoded_ascii": "^(s^/_^0a^9l^+X^.V",
      "encoded_base64": "XihzXi9fXjBhXjlsXitYXi5W",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_4399783ff1cd",
      "text": " 輕而易舉地爬上了",
      "encoded_ascii": " ^(g^'W^,W^01^\"e^/y^!'^*D",
      "encoded_base64": "IF4oZ14nV14sV14wMV4iZV4veV4hJ14qRA==",
      "byte_length": 25
    },
    {
      "unit_id": "DLG_bc16c3583f1e",
      "text": "這處懸崖。",
      "encoded_ascii": "^(s^(,^0a^9l^!\"",
      "encoded_base64": "XihzXigsXjBhXjlsXiEi",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_9327d2ab51b9",
      "text": " 手滑抓空， ",
      "encoded_ascii": " ^$+^%u^$2^'(^*A ",
      "encoded_base64": "IF4kK14ldV4kMl4nKF4qQSA=",
      "byte_length": 17
    },
    {
      "unit_id": "DLG_514c2ae99ed9",
      "text": " 狠狠摔跌到了下方的沙地上！",
      "encoded_ascii": " ^4T^4T^/i^:a^!u^*D^!(^$]^&Z^%]^\"e^!'^*W",
      "encoded_base64": "IF40VF40VF4vaV46YV4hdV4qRF4hKF4kXV4mWl4lXV4iZV4hJ14qVw==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_1cf75971f438",
      "text": " 下去 ",
      "encoded_ascii": " ^!(^\"6 ",
      "encoded_base64": "IF4hKF4iNiA=",
      "byte_length": 8
    },
    {
      "unit_id": "DLG_4a7e4a5f6dad",
      "text": "這是一項簡單的差事，用來看看你們是否值得信任且有能力。 ",
      "encoded_ascii": "^(s^,X^!%^)q^3y^2a^&Z^48^*r^*A^&H^!O^*Q^*Q^*F^*{^,X^\"H^!Z^#e^!U^!C^!*^$s^'b^!~^!\" ",
      "encoded_base64": "XihzXixYXiElXilxXjN5XjJhXiZaXjQ4XipyXipBXiZIXiFPXipRXipRXipGXip7XixYXiJIXiFaXiNlXiFVXiFDXiEqXiRzXidiXiF+XiEiIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_a1a0f959f4f6",
      "text": "我有一位委託人加林神父，他需要從 ",
      "encoded_ascii": "^$%^$s^!%^!J^5E^-q^!<^\"\"^/1^&w^5d^*A^!@^)e^(C^#f ",
      "encoded_base64": "XiQlXiRzXiElXiFKXjVFXi1xXiE8XiIiXi8xXiZ3XjVkXipBXiFAXillXihDXiNmIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_b410ea6b77f0",
      "text": "拉尼克樹取得的樹髓。我要你們帶一些送去給他。",
      "encoded_ascii": "^$6^#>^!d^%;^\":^#e^&Z^%;^*)^!\"^$%^(C^*F^*{^#N^!%^!8^./^\"6^'A^!@^!\"",
      "encoded_base64": "XiQ2XiM+XiFkXiU7XiI6XiNlXiZaXiU7XiopXiEiXiQlXihDXipGXip7XiNOXiElXiE4Xi4vXiI2XidBXiFAXiEi",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_24d7e24067ce",
      "text": "我的一位特定委託人需要一朵恐懼之花，那是一種 ",
      "encoded_ascii": "^$%^&Z^!%^!J^&5^#.^5E^-q^!<^)e^(C^!%^9C^#t^$#^!/^'w^*A^)!^,X^!%^'$ ",
      "encoded_base64": "XiQlXiZaXiElXiFKXiY1XiMuXjVFXi1xXiE8XillXihDXiElXjlDXiN0XiQjXiEvXid3XipBXikhXixYXiElXickIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_e463fdc14c4c",
      "text": "極為罕見之物，連我都不知道該去何處採集。然而， ",
      "encoded_ascii": "^1D^%{^5w^-m^!/^&4^*A^.0^$%^)$^!)^&h^(y^(M^\"6^!L^(,^5R^)]^!\"^&\"^'W^*A ",
      "encoded_base64": "XjFEXiV7XjV3Xi1tXiEvXiY0XipBXi4wXiQlXikkXiEpXiZoXih5XihNXiI2XiFMXigsXjVSXildXiEiXiYiXidXXipBIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_1c3e908e5d2d",
      "text": "我所見過的少數文獻全提到了狂暴獸的死亡。 ",
      "encoded_ascii": "^$%^$)^-m^(x^&Z^#<^$V^$W^-(^!h^$A^!u^*D^&8^$m^&<^&Z^%L^!:^!\" ",
      "encoded_base64": "XiQlXiQpXi1tXih4XiZaXiM8XiRWXiRXXi0oXiFoXiRBXiF1XipEXiY4XiRtXiY8XiZaXiVMXiE6XiEiIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_79364e59b0b0",
      "text": "在這次任務中，你們無疑會遭遇這些凶猛的巨獸。",
      "encoded_ascii": "^\"d^(s^%D^!C^+4^!,^*A^*F^*{^%}^0p^$r^(}^.2^(s^!8^3e^*P^&Z^#H^&<^!\"",
      "encoded_base64": "XiJkXihzXiVEXiFDXis0XiEsXipBXipGXip7XiV9XjBwXiRyXih9Xi4yXihzXiE4XjNlXipQXiZaXiNIXiY8XiEi",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_ec64ab94d547",
      "text": "我要你們取回一根巨蠍獸的毒尾針，但必須是 ",
      "encoded_ascii": "^$%^(C^*F^*{^\":^\"\\^!%^%)^#H^06^&<^&Z^%Q^5J^)-^*A^!I^#l^)r^,X ",
      "encoded_base64": "XiQlXihDXipGXip7XiI6XiJcXiElXiUpXiNIXjA2XiY8XiZaXiVRXjVKXiktXipBXiFJXiNsXilyXixYIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_78a9823d8f6c",
      "text": "最近剛吞食過奎利鳥的巨蠍獸毒尾針才行。 ",
      "encoded_ascii": "^$q^(l^+0^:-^0J^(x^5B^!t^4p^&Z^#H^06^&<^%Q^5J^)-^$,^(;^!\" ",
      "encoded_base64": "XiRxXihsXiswXjotXjBKXih4XjVCXiF0XjRwXiZaXiNIXjA2XiY8XiVRXjVKXiktXiQsXig7XiEiIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_b6ab9005fd77",
      "text": "這非常重要。",
      "encoded_ascii": "^(s^)i^#O^))^(C^!\"",
      "encoded_base64": "XihzXilpXiNPXikpXihDXiEi",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_e3722cdc3951",
      "text": "  你會付我多少酬勞？",
      "encoded_ascii": "  ^*F^$r^*u^$%^\"x^#<^7o^/R^.V",
      "encoded_base64": "ICBeKkZeJHJeKnVeJCVeInheIzxeN29eL1JeLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_a9bdc7ca200f",
      "text": "  這拉尼克樹髓是用來做什麼的？",
      "encoded_ascii": "  ^(s^$6^#>^!d^%;^*)^,X^&H^!O^*~^!=^.T^&Z^.V",
      "encoded_base64": "ICBeKHNeJDZeIz5eIWReJTteKileLFheJkheIU9eKn5eIT1eLlReJlpeLlY=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_dc5501f59d89",
      "text": "  我會把樹髓送去給加林神父。",
      "encoded_ascii": "  ^$%^$r^$1^%;^*)^./^\"6^'A^\"\"^/1^&w^5d^!\"",
      "encoded_base64": "ICBeJCVeJHJeJDFeJTteKileLi9eIjZeJ0FeIiJeLzFeJndeNWReISI=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_819b22348099",
      "text": "  恐懼之花究竟是什麼？",
      "encoded_ascii": "  ^#t^$#^!/^'w^-<^28^,X^!=^.T^.V",
      "encoded_base64": "ICBeI3ReJCNeIS9eJ3deLTxeMjheLFheIT1eLlReLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_0202c7fa2a7b",
      "text": "  我會幫你找到這朵恐懼之花。",
      "encoded_ascii": "  ^$%^$r^+}^*F^$/^!u^(s^9C^#t^$#^!/^'w^!\"",
      "encoded_base64": "ICBeJCVeJHJeK31eKkZeJC9eIXVeKHNeOUNeI3ReJCNeIS9eJ3deISI=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_568786237d02",
      "text": "  跟我說說關於巨蠍獸的事。",
      "encoded_ascii": "  ^.+^$%^-x^-x^.>^$^^#H^06^&<^&Z^*r^!\"",
      "encoded_base64": "ICBeLiteJCVeLXheLXheLj5eJF5eI0heMDZeJjxeJlpeKnJeISI=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_b39157e87a4e",
      "text": "  我會去弄來巨蠍獸的毒尾針。",
      "encoded_ascii": "  ^$%^$r^\"6^/`^!O^#H^06^&<^&Z^%Q^5J^)-^!\"",
      "encoded_base64": "ICBeJCVeJHJeIjZeL2BeIU9eI0heMDZeJjxeJlpeJVFeNUpeKS1eISI=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_50eadd3ee495",
      "text": "  我對任何任務都沒興趣。",
      "encoded_ascii": "  ^$%^#:^!C^!L^!C^+4^)$^%\\^-]^.*^!\"",
      "encoded_base64": "ICBeJCVeIzpeIUNeIUxeIUNeKzReKSReJVxeLV1eLipeISI=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_431973ab643a",
      "text": "對於如此簡單的差事，我的標準報酬是 500 枚陶幣。一旦 ",
      "encoded_ascii": "^#:^$^^#$^%I^3y^2a^&Z^48^*r^*A^$%^&Z^%9^,x^+`^7o^,X 500 ^$~^)R^+|^!\"^!%^1C ",
      "encoded_base64": "XiM6XiReXiMkXiVJXjN5XjJhXiZaXjQ4XipyXipBXiQlXiZaXiU5Xix4XitgXjdvXixYIDUwMCBeJH5eKVJeK3xeISJeISVeMUMg",
      "byte_length": 75
    },
    {
      "unit_id": "DLG_ce22901cbdc9",
      "text": "你們證明了自己的可靠，就會接到更重要的任務以及 ",
      "encoded_ascii": "^*F^*{^-{^$c^*D^'l^#I^&Z^\"A^.C^*A^*J^$r^$?^!u^$o^))^(C^&Z^!C^+4^!B^\"7 ",
      "encoded_base64": "XipGXip7Xi17XiRjXipEXidsXiNJXiZaXiJBXi5DXipBXipKXiRyXiQ/XiF1XiRvXikpXihDXiZaXiFDXis0XiFCXiI3IA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_436d03add97b",
      "text": "更豐厚的報酬，甚至可能得到幾件神秘的寶物。",
      "encoded_ascii": "^$o^4!^\"4^&Z^+`^7o^*A^/|^'n^\"A^'b^#e^!u^#T^.W^&w^1O^&Z^#4^&4^!\"",
      "encoded_base64": "XiRvXjQhXiI0XiZaXitgXjdvXipBXi98XiduXiJBXidiXiNlXiF1XiNUXi5XXiZ3XjFPXiZaXiM0XiY0XiEi",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_e6a69d9115ee",
      "text": "考慮到其中的危險性，我準備為你們的勞務支付額外的 ",
      "encoded_ascii": "^-R^19^!u^!j^!,^&Z^2\\^*m^#r^*A^$%^,x^+\"^%{^*F^*{^&Z^/R^+4^$L^*u^)v^\"w^&Z ",
      "encoded_base64": "Xi1SXjE5XiF1XiFqXiEsXiZaXjJcXiptXiNyXipBXiQlXix4XisiXiV7XipGXip7XiZaXi9SXis0XiRMXip1Xil2XiJ3XiZaIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_44b0a511a5ca",
      "text": "高額報酬。事實上，我很快就會獲得一根魔法魔杖， ",
      "encoded_ascii": "^*+^)v^+`^7o^!\"^*r^#3^!'^*A^$%^*K^*L^*J^$r^&:^#e^!%^%)^*0^%b^*0^${^*A ",
      "encoded_base64": "XiorXil2XitgXjdvXiEiXipyXiMzXiEnXipBXiQlXipLXipMXipKXiRyXiY6XiNlXiElXiUpXiowXiViXiowXiR7XipBIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_7d17e3437877",
      "text": "我想它足以超額酬謝你們這次的付出。",
      "encoded_ascii": "^$%^,1^+o^(^^!B^(\\^)v^7o^-z^*F^*{^(s^%D^&Z^*u^!q^!\"",
      "encoded_base64": "XiQlXiwxXitvXiheXiFCXihcXil2XjdvXi16XipGXip7XihzXiVEXiZaXip1XiFxXiEi",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_da08d2aba46b",
      "text": "因為你們一直是我如此忠誠可靠的特工，我會給你們 ",
      "encoded_ascii": "^\"]^%{^*F^*{^!%^&`^,X^$%^#$^%I^.d^2E^\"A^.C^&Z^&5^+y^*A^$%^$r^'A^*F^*{ ",
      "encoded_base64": "XiJdXiV7XipGXip7XiElXiZgXixYXiQlXiMkXiVJXi5kXjJFXiJBXi5DXiZaXiY1Xit5XipBXiQlXiRyXidBXipGXip7IA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_646412d46c8b",
      "text": "一面魔法盾牌作為這次差事的獎勵，另外還有 1,500 枚陶幣。",
      "encoded_ascii": "^!%^)j^*0^%b^&b^&2^!M^%{^(s^%D^48^*r^&Z^7?^;a^*A^\">^\"w^.7^$s 1,500 ^$~^)R^+|^!\"",
      "encoded_base64": "XiElXilqXiowXiViXiZiXiYyXiFNXiV7XihzXiVEXjQ4XipyXiZaXjc/XjthXipBXiI+XiJ3Xi43XiRzIDEsNTAwIF4kfl4pUl4rfF4hIg==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_73a5f0cbbfd0",
      "text": "太好了。把這袋拉尼克樹髓送去給提奎茲爾的加林神父。",
      "encoded_ascii": "^+f^+i^*D^!\"^$1^(s^(?^$6^#>^!d^%;^*)^./^\"6^'A^$A^5B^/D^&/^&Z^\"\"^/1^&w^5d^!\"",
      "encoded_base64": "XitmXitpXipEXiEiXiQxXihzXig/XiQ2XiM+XiFkXiU7XiopXi4vXiI2XidBXiRBXjVCXi9EXiYvXiZaXiIiXi8xXiZ3XjVkXiEi",
      "byte_length": 75
    },
    {
      "unit_id": "DLG_7478dd639bd2",
      "text": " 那是座位於此處西北方的村落。",
      "encoded_ascii": " ^)!^,X^/_^!J^$^^%I^(,^-l^+6^$]^&Z^$z^-`^!\"",
      "encoded_base64": "IF4pIV4sWF4vX14hSl4kXl4lSV4oLF4tbF4rNl4kXV4mWl4kel4tYF4hIg==",
      "byte_length": 43
    },
    {
      "unit_id": "DLG_3f739b166b65",
      "text": "辦妥之後回來，我會給你們豐厚的酬勞。",
      "encoded_ascii": "^2L^5C^!/^#b^\"\\^!O^*A^$%^$r^'A^*F^*{^4!^\"4^&Z^7o^/R^!\"",
      "encoded_base64": "XjJMXjVDXiEvXiNiXiJcXiFPXipBXiQlXiRyXidBXipGXip7XjQhXiI0XiZaXjdvXi9SXiEi",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_91423f3f03cd",
      "text": "太棒了！我建議你們往正西方尋找恐懼之花。 ",
      "encoded_ascii": "^+f^%1^*D^*W^$%^,'^-|^*F^*{^,)^%H^-l^$]^#9^$/^#t^$#^!/^'w^!\" ",
      "encoded_base64": "XitmXiUxXipEXipXXiQlXiwnXi18XipGXip7XiwpXiVIXi1sXiRdXiM5XiQvXiN0XiQjXiEvXid3XiEiIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_fcff1477d375",
      "text": "眾所皆知，狂暴獸經常出沒於塞德利特上方的山脈。",
      "encoded_ascii": "^&e^$)^5j^&h^*A^&8^$m^&<^'D^#O^!q^%\\^$^^/(^#j^!t^&5^!'^$]^&Z^11^6i^!\"",
      "encoded_base64": "XiZlXiQpXjVqXiZoXipBXiY4XiRtXiY8XidEXiNPXiFxXiVcXiReXi8oXiNqXiF0XiY1XiEnXiRdXiZaXjExXjZpXiEi",
      "byte_length": 69
    },
    {
      "unit_id": "DLG_e31018d92ca8",
      "text": "退一步說，塞德利特有一位博學大師，或許能夠 ",
      "encoded_ascii": "^*V^!%^,i^-x^*A^/(^#j^!t^&5^$s^!%^!J^/$^+n^\"z^#M^*A^$'^-s^'b^+d ",
      "encoded_base64": "XipWXiElXixpXi14XipBXi8oXiNqXiF0XiY1XiRzXiElXiFKXi8kXituXiJ6XiNNXipBXiQnXi1zXidiXitkIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_1fed0ab1b940",
      "text": "對你們有所幫助。",
      "encoded_ascii": "^#:^*F^*{^$s^$)^+}^\"#^!\"",
      "encoded_base64": "XiM6XipGXip7XiRzXiQpXit9XiIjXiEi",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_1faccd594432",
      "text": "我就知道能指望你們！記住，那頭巨蠍獸必須是 ",
      "encoded_ascii": "^$%^*J^&h^(y^'b^$8^,]^*F^*{^*W^(K^*z^*A^)!^)t^#H^06^&<^#l^)r^,X ",
      "encoded_base64": "XiQlXipKXiZoXih5XidiXiQ4XixdXipGXip7XipXXihLXip6XipBXikhXil0XiNIXjA2XiY8XiNsXilyXixYIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_59bd696816c5",
      "text": "吞食過奎利鳥的個體。否則，那毒尾針就一文不值。",
      "encoded_ascii": "^:-^0J^(x^5B^!t^4p^&Z^!V^**^!\"^\"H^!x^*A^)!^%Q^5J^)-^*J^!%^$W^!)^!Z^!\"",
      "encoded_base64": "XjotXjBKXih4XjVCXiF0XjRwXiZaXiFWXioqXiEiXiJIXiF4XipBXikhXiVRXjVKXiktXipKXiElXiRXXiEpXiFaXiEi",
      "byte_length": 69
    },
    {
      "unit_id": "DLG_f9d12f23eb52",
      "text": "幹得好！看來我對你們的信任沒有白費。雖然對於這麼簡單的差事，我只能 ",
      "encoded_ascii": "^,!^#e^+i^*W^*Q^!O^$%^#:^*F^*{^&Z^!U^!C^%\\^$s^&X^.\"^!\"^.A^&\"^#:^$^^(s^.T^3y^2a^&Z^48^*r^*A^$%^\"?^'b ",
      "encoded_base64": "XiwhXiNlXitpXipXXipRXiFPXiQlXiM6XipGXip7XiZaXiFVXiFDXiVcXiRzXiZYXi4iXiEiXi5BXiYiXiM6XiReXihzXi5UXjN5XjJhXiZaXjQ4XipyXipBXiQlXiI/XidiIA==",
      "byte_length": 100
    },
    {
      "unit_id": "DLG_704cac6f675a",
      "text": "給你們 500 枚陶幣，但未來的任務將會 ",
      "encoded_ascii": "^'A^*F^*{ 500 ^$~^)R^+|^*A^!I^,_^!O^&Z^!C^+4^#7^$r ",
      "encoded_base64": "XidBXipGXip7IDUwMCBeJH5eKVJeK3xeKkFeIUleLF9eIU9eJlpeIUNeKzReIzdeJHIg",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_69dbcc747fa9",
      "text": "證明更加有利可圖。",
      "encoded_ascii": "^-{^$c^$o^\"\"^$s^!t^\"A^\"b^!\"",
      "encoded_base64": "Xi17XiRjXiRvXiIiXiRzXiF0XiJBXiJiXiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_eb75aac70c51",
      "text": "你們準備好接受更危險的差事了嗎？",
      "encoded_ascii": "^*F^*{^,x^+\"^+i^$?^\";^$o^2\\^*m^&Z^48^*r^*D^+X^.V",
      "encoded_base64": "XipGXip7Xix4XisiXitpXiQ/XiI7XiRvXjJcXiptXiZaXjQ4XipyXipEXitYXi5W",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_79ea45ffdf26",
      "text": "你們還沒把拉尼克樹髓送去給加林神父嗎？如果 ",
      "encoded_ascii": "^*F^*{^.7^%\\^$1^$6^#>^!d^%;^*)^./^\"6^'A^\"\"^/1^&w^5d^+X^.V^#$^%! ",
      "encoded_base64": "XipGXip7Xi43XiVcXiQxXiQ2XiM+XiFkXiU7XiopXi4vXiI2XidBXiIiXi8xXiZ3XjVkXitYXi5WXiMkXiUhIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_9a33c308f731",
      "text": "拖延太久，我的信譽會受損……你們也同樣脫不了干係。",
      "encoded_ascii": "^.f^,&^+f^!.^*A^$%^&Z^!U^6-^$r^\";^$D^*o^*o^*F^*{^!1^\"E^,f^'c^!)^*D^#R^38^!\"",
      "encoded_base64": "Xi5mXiwmXitmXiEuXipBXiQlXiZaXiFVXjYtXiRyXiI7XiREXipvXipvXipGXip7XiExXiJFXixmXidjXiEpXipEXiNSXjM4XiEi",
      "byte_length": 75
    },
    {
      "unit_id": "DLG_cac44ab59a74",
      "text": "你們找到恐懼之花了嗎？我的委託人正變得相當心急。",
      "encoded_ascii": "^*F^*{^$/^!u^#t^$#^!/^'w^*D^+X^.V^$%^&Z^5E^-q^!<^%H^(U^#e^&a^&N^#k^3p^!\"",
      "encoded_base64": "XipGXip7XiQvXiF1XiN0XiQjXiEvXid3XipEXitYXi5WXiQlXiZaXjVFXi1xXiE8XiVIXihVXiNlXiZhXiZOXiNrXjNwXiEi",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_80949f16907d",
      "text": "令人驚嘆！說老實話，我本來還以為恐懼之花並非真的 ",
      "encoded_ascii": "^*w^!<^.Q^59^*W^-x^'U^#3^-v^*A^$%^$x^!O^.7^!B^%{^#t^$#^!/^'w^!+^)i^-2^&Z ",
      "encoded_base64": "Xip3XiE8Xi5RXjU5XipXXi14XidVXiMzXi12XipBXiQlXiR4XiFPXi43XiFCXiV7XiN0XiQjXiEvXid3XiErXilpXi0yXiZaIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_7cf46ab8c768",
      "text": "存在——但你們竟然找到了一朵！我希望這根魔法魔杖足以作為 ",
      "encoded_ascii": "^#*^\"d^*n^*n^!I^*F^*{^28^&\"^$/^!u^*D^!%^9C^*W^$%^+{^,]^(s^%)^*0^%b^*0^${^(^^!B^!M^%{ ",
      "encoded_base64": "XiMqXiJkXipuXipuXiFJXipGXip7XjI4XiYiXiQvXiF1XipEXiElXjlDXipXXiQlXit7XixdXihzXiUpXiowXiViXiowXiR7XiheXiFCXiFNXiV7IA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_561419f91a33",
      "text": "這項非凡壯舉的充份酬勞。",
      "encoded_ascii": "^(s^)q^)i^+-^+b^01^&Z^5.^*x^7o^/R^!\"",
      "encoded_base64": "XihzXilxXilpXistXitiXjAxXiZaXjUuXip4XjdvXi9SXiEi",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_3f66e2d8b2af",
      "text": "不過更重要的是，我手頭上有一件緊急狀況",
      "encoded_ascii": "^!)^(x^$o^))^(C^&Z^,X^*A^$%^$+^)t^!'^$s^!%^.W^0r^3p^&7^,q",
      "encoded_base64": "XiEpXih4XiRvXikpXihDXiZaXixYXipBXiQlXiQrXil0XiEnXiRzXiElXi5XXjByXjNwXiY3Xixx",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_ff41c10e8a82",
      "text": "我警告你們！別跟我耍花樣。你們的表情太容易出賣你們了。 ",
      "encoded_ascii": "^$%^(S^+B^*F^*{^*W^*H^.+^$%^7E^'w^,f^!\"^*F^*{^&Z^-i^,0^+f^+t^,W^!q^.$^*F^*{^*D^!\" ",
      "encoded_base64": "XiQlXihTXitCXipGXip7XipXXipIXi4rXiQlXjdFXid3XixmXiEiXipGXip7XiZaXi1pXiwwXitmXit0XixXXiFxXi4kXipGXip7XipEXiEiIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_9aecf0a9bf55",
      "text": "我相信你們不會真心指望我為你們根本沒有的東西付錢。",
      "encoded_ascii": "^$%^&a^!U^*F^*{^!)^$r^-2^#k^$8^,]^$%^%{^*F^*{^%)^$x^%\\^$s^&Z^,`^-l^*u^.<^!\"",
      "encoded_base64": "XiQlXiZhXiFVXipGXip7XiEpXiRyXi0yXiNrXiQ4XixdXiQlXiV7XipGXip7XiUpXiR4XiVcXiRzXiZaXixgXi1sXip1Xi48XiEi",
      "byte_length": 75
    },
    {
      "unit_id": "DLG_12368149f286",
      "text": "我很失望。誠然，這是一項艱難的委託，但我本以為你們是 ",
      "encoded_ascii": "^$%^*K^\"|^,]^!\"^2E^&\"^*A^(s^,X^!%^)q^6j^)a^&Z^5E^-q^*A^!I^$%^$x^!B^%{^*F^*{^,X ",
      "encoded_base64": "XiQlXipLXiJ8XixdXiEiXjJFXiYiXipBXihzXixYXiElXilxXjZqXilhXiZaXjVFXi1xXipBXiFJXiQlXiR4XiFCXiV7XipGXip7XixYIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_167466f6a71b",
      "text": "無所畏懼的冒險者。我相信你們最終一定會成功的！",
      "encoded_ascii": "^%}^$)^7@^$#^&Z^/P^*m^'V^!\"^$%^&a^!U^*F^*{^$q^-H^!%^#.^$r^$$^\"!^&Z^*W",
      "encoded_base64": "XiV9XiQpXjdAXiQjXiZaXi9QXiptXidWXiEiXiQlXiZhXiFVXipGXip7XiRxXi1IXiElXiMuXiRyXiQkXiIhXiZaXipX",
      "byte_length": 69
    },
    {
      "unit_id": "DLG_f43263f11635",
      "text": "我真高興見到你們， ",
      "encoded_ascii": "^$%^-2^*+^-]^-m^!u^*F^*{^*A ",
      "encoded_base64": "XiQlXi0yXiorXi1dXi1tXiF1XipGXip7XipBIA==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_505f99906655",
      "text": "你好， ",
      "encoded_ascii": "^*F^+i^*A ",
      "encoded_base64": "XipGXitpXipBIA==",
      "byte_length": 10
    },
    {
      "unit_id": "DLG_9191a1b5a045",
      "text": "。我從一開始就知道我們之間會是一段互利的合作關係。你們已經 ",
      "encoded_ascii": "^!\"^$%^#f^!%^)F^+k^*J^&h^(y^$%^*{^!/^)G^$r^,X^!%^.l^*s^!t^&Z^\"C^!M^.>^38^!\"^*F^*{^#J^'D ",
      "encoded_base64": "XiEiXiQlXiNmXiElXilGXitrXipKXiZoXih5XiQlXip7XiEvXilHXiRyXixYXiElXi5sXipzXiF0XiZaXiJDXiFNXi4+XjM4XiEiXipGXip7XiNKXidEIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_714fb175e14b",
      "text": "成為我最值得信賴的得力助手。",
      "encoded_ascii": "^$$^%{^$%^$q^!Z^#e^!U^0t^&Z^#e^!~^\"#^$+^!\"",
      "encoded_base64": "XiQkXiV7XiQlXiRxXiFaXiNlXiFVXjB0XiZaXiNlXiF+XiIjXiQrXiEi",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_f45b4e9e2f7b",
      "text": "我一直在為你們擔心。那根巨蠍獸的毒尾針對我來說非常 ",
      "encoded_ascii": "^$%^!%^&`^\"d^%{^*F^*{^*N^#k^!\"^)!^%)^#H^06^&<^&Z^%Q^5J^)-^#:^$%^!O^-x^)i^#O ",
      "encoded_base64": "XiQlXiElXiZgXiJkXiV7XipGXip7XipOXiNrXiEiXikhXiUpXiNIXjA2XiY8XiZaXiVRXjVKXiktXiM6XiQlXiFPXi14XilpXiNPIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_f16a44568eec",
      "text": "重要。你們找到了嗎？",
      "encoded_ascii": "^))^(C^!\"^*F^*{^$/^!u^*D^+X^.V",
      "encoded_base64": "XikpXihDXiEiXipGXip7XiQvXiF1XipEXitYXi5W",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_69fa75b61701",
      "text": "你們太棒了！我真不知該如何感謝你們，為了表示謝意， ",
      "encoded_ascii": "^*F^*{^+f^%1^*D^*W^$%^-2^!)^&h^(M^#$^!L^#{^-z^*F^*{^*A^%{^*D^-i^&s^-z^#z^*A ",
      "encoded_base64": "XipGXip7XitmXiUxXipEXipXXiQlXi0yXiEpXiZoXihNXiMkXiFMXiN7Xi16XipGXip7XipBXiV7XipEXi1pXiZzXi16XiN6XipBIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_c60fbd9aa85b",
      "text": "除了盾牌和賞金之外，我還會給你們幾枚魔法果實。",
      "encoded_ascii": "^)Q^*D^&b^&2^\"O^*T^)+^!/^\"w^*A^$%^.7^$r^'A^*F^*{^#T^$~^*0^%b^%!^#3^!\"",
      "encoded_base64": "XilRXipEXiZiXiYyXiJPXipUXikrXiEvXiJ3XipBXiQlXi43XiRyXidBXipGXip7XiNUXiR+XiowXiViXiUhXiMzXiEi",
      "byte_length": 69
    },
    {
      "unit_id": "DLG_aeef23e293d0",
      "text": "我從你們臉上看出你們在撒謊。請別拿我尋開心。",
      "encoded_ascii": "^$%^#f^*F^*{^-\\^!'^*Q^!q^*F^*{^\"d^<>^3*^!\"^*S^*H^,G^$%^#9^)F^#k^!\"",
      "encoded_base64": "XiQlXiNmXipGXip7Xi1cXiEnXipRXiFxXipGXip7XiJkXjw+XjMqXiEiXipTXipIXixHXiQlXiM5XilGXiNrXiEi",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_a29e09fa0f54",
      "text": "非得要我再加碼提高好處嗎？我跟你們說，這是我接過最 ",
      "encoded_ascii": "^)i^#e^(C^$%^!l^\"\"^94^$A^*+^+i^(,^+X^.V^$%^.+^*F^*{^-x^*A^(s^,X^$%^$?^(x^$q ",
      "encoded_base64": "XilpXiNlXihDXiQlXiFsXiIiXjk0XiRBXiorXitpXigsXitYXi5WXiQlXi4rXipGXip7Xi14XipBXihzXixYXiQlXiQ/Xih4XiRxIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_f2846e972fa6",
      "text": "緊急的差事了。趕快把毒尾針弄來給我， ",
      "encoded_ascii": "^0r^3p^&Z^48^*r^*D^!\"^0u^*L^$1^%Q^5J^)-^/`^!O^'A^$%^*A ",
      "encoded_base64": "XjByXjNwXiZaXjQ4XipyXipEXiEiXjB1XipMXiQxXiVRXjVKXiktXi9gXiFPXidBXiQlXipBIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_cdc83afe0c9c",
      "text": "我保證你們會得到一筆額外紅利。",
      "encoded_ascii": "^$%^!T^-{^*F^*{^$r^#e^!u^!%^-A^)v^\"w^3!^!t^!\"",
      "encoded_base64": "XiQlXiFUXi17XipGXip7XiRyXiNlXiF1XiElXi1BXil2XiJ3XjMhXiF0XiEi",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_962b03e7ad6a",
      "text": "。近來生意極其冷清",
      "encoded_ascii": "^!\"^(l^!O^&F^#z^1D^!j^!n^,u",
      "encoded_base64": "XiEiXihsXiFPXiZGXiN6XjFEXiFqXiFuXix1",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_56a86509ec26",
      "text": " ——自從你們把那些德拉吉人打得落荒而逃滾回老巢之後！ ",
      "encoded_ascii": " ^*n^*n^'l^#f^*F^*{^$1^)!^!8^#j^$6^\"D^!<^$-^#e^-`^1W^'W^(p^,z^\"\\^'U^#G^!/^#b^*W ",
      "encoded_base64": "IF4qbl4qbl4nbF4jZl4qRl4qe14kMV4pIV4hOF4jal4kNl4iRF4hPF4kLV4jZV4tYF4xV14nV14ocF4sel4iXF4nVV4jR14hL14jYl4qVyA=",
      "byte_length": 80
    },
    {
      "unit_id": "DLG_f034b509cebb",
      "text": "要等到施法材料的需求回溫，恐怕還得好一段時間。",
      "encoded_ascii": "^(C^'-^!u^$_^%b^$y^/n^&Z^)e^,n^\"\\^%s^*A^#t^0^^.7^#e^+i^!%^.l^$f^)G^!\"",
      "encoded_base64": "XihDXictXiF1XiRfXiViXiR5Xi9uXiZaXillXixuXiJcXiVzXipBXiN0XjBeXi43XiNlXitpXiElXi5sXiRmXilHXiEi",
      "byte_length": 69
    },
    {
      "unit_id": "DLG_fb64adfae938",
      "text": "，所以我手上沒有能給你們的活。通常每當我遇到材料搶購狂潮， ",
      "encoded_ascii": "^*A^$)^!B^$%^$+^!'^%\\^$s^'b^'A^*F^*{^&Z^%i^!\"^(t^#O^%P^&N^$%^.2^!u^$y^/n^1?^63^&8^=[^*A ",
      "encoded_base64": "XipBXiQpXiFCXiQlXiQrXiEnXiVcXiRzXidiXidBXipGXip7XiZaXiVpXiEiXih0XiNPXiVQXiZOXiQlXi4yXiF1XiR5Xi9uXjE/XjYzXiY4Xj1bXipBIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_e735fa368267",
      "text": "緊接著又出現這種平靜期，就代表有大事要發生了。小心 ",
      "encoded_ascii": "^0r^$?^-a^+;^!q^&?^(s^'$^0Y^)h^$u^*A^*J^*v^-i^$s^\"z^*r^(C^&W^&F^*D^!\"^#;^#k ",
      "encoded_base64": "XjByXiQ/Xi1hXis7XiFxXiY/XihzXickXjBZXiloXiR1XipBXipKXip2Xi1pXiRzXiJ6XipyXihDXiZXXiZGXipEXiEiXiM7XiNrIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_bf3aaaf04565",
      "text": "你們的背後！",
      "encoded_ascii": "^*F^*{^&Z^.r^#b^*W",
      "encoded_base64": "XipGXip7XiZaXi5yXiNiXipX",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_a1973705bc13",
      "text": "見到你們真高興，各位旅人。我是諾塔庫，願為你們效勞。",
      "encoded_ascii": "^-m^!u^*F^*{^-2^*+^-]^*A^+>^!J^2m^!<^!\"^$%^,X^7k^\"o^,#^*A^.H^%{^*F^*{^$Q^/R^!\"",
      "encoded_base64": "Xi1tXiF1XipGXip7Xi0yXiorXi1dXipBXis+XiFKXjJtXiE8XiEiXiQlXixYXjdrXiJvXiwjXipBXi5IXiV7XipGXip7XiRRXi9SXiEi",
      "byte_length": 78
    },
    {
      "unit_id": "DLG_bc94ada9f7da",
      "text": "是什麼讓你們涉足這片荒涼的廢土？",
      "encoded_ascii": "^,X^!=^.T^-}^*F^*{^3O^(^^(s^&1^1W^,s^&Z^#W^\"c^.V",
      "encoded_base64": "XixYXiE9Xi5UXi19XipGXip7XjNPXiheXihzXiYxXjFXXixzXiZaXiNXXiJjXi5W",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_ce31c4153bba",
      "text": "  是加林神父派我來拿拉尼克樹髓的。",
      "encoded_ascii": "  ^,X^\"\"^/1^&w^5d^.n^$%^!O^,G^$6^#>^!d^%;^*)^&Z^!\"",
      "encoded_base64": "ICBeLFheIiJeLzFeJndeNWReLm5eJCVeIU9eLEdeJDZeIz5eIWReJTteKileJlpeISI=",
      "byte_length": 50
    },
    {
      "unit_id": "DLG_edee09bad188",
      "text": "  我是從奴役中逃出來的。",
      "encoded_ascii": "  ^$%^,X^#f^##^17^!,^(p^!q^!O^&Z^!\"",
      "encoded_base64": "ICBeJCVeLFheI2ZeIyNeMTdeISxeKHBeIXFeIU9eJlpeISI=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_abb418387759",
      "text": "  我尋求朋友與利益。",
      "encoded_ascii": "  ^$%^#9^,n^,[^\"8^'p^!t^3R^!\"",
      "encoded_base64": "ICBeJCVeIzleLG5eLFteIjheJ3BeIXReM1JeISI=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_65685e9bd44b",
      "text": "  我只是一個普通旅人。",
      "encoded_ascii": "  ^$%^\"?^,X^!%^!V^$g^(t^2m^!<^!\"",
      "encoded_base64": "ICBeJCVeIj9eLFheISVeIVZeJGdeKHReMm1eITxeISI=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_717a677c9ccf",
      "text": "不關你的事。再見。",
      "encoded_ascii": "^!)^.>^*F^&Z^*r^!\"^!l^-m^!\"",
      "encoded_base64": "XiEpXi4+XipGXiZaXipyXiEiXiFsXi1tXiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_ee9ef04e730b",
      "text": "！有位委託人要我收集一種非常特殊的施法材料，但 ",
      "encoded_ascii": "^*W^$s^!J^5E^-q^!<^(C^$%^$M^)]^!%^'$^)i^#O^&5^9!^&Z^$_^%b^$y^/n^*A^!I ",
      "encoded_base64": "XipXXiRzXiFKXjVFXi1xXiE8XihDXiQlXiRNXildXiElXickXilpXiNPXiY1XjkhXiZaXiRfXiViXiR5Xi9uXipBXiFJIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_1e060ddd0437",
      "text": "我找不到任何人願意接下這項差事。",
      "encoded_ascii": "^$%^$/^!)^!u^!C^!L^!<^.H^#z^$?^!(^(s^)q^48^*r^!\"",
      "encoded_base64": "XiQlXiQvXiEpXiF1XiFDXiFMXiE8Xi5IXiN6XiQ/XiEoXihzXilxXjQ4XipyXiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_31d1c836bc61",
      "text": "我沒料到你們會這麼快回來，而且還空手而歸。你們想要什麼？",
      "encoded_ascii": "^$%^%\\^/n^!u^*F^*{^$r^(s^.T^*L^\"\\^!O^*A^'W^!*^.7^'(^$+^'W^%K^!\"^*F^*{^,1^(C^!=^.T^.V",
      "encoded_base64": "XiQlXiVcXi9uXiF1XipGXip7XiRyXihzXi5UXipMXiJcXiFPXipBXidXXiEqXi43XicoXiQrXidXXiVLXiEiXipGXip7XiwxXihDXiE9Xi5UXi5W",
      "byte_length": 84
    },
    {
      "unit_id": "DLG_8167aadd268f",
      "text": "啊，我很感謝你們在這件事上的相助。我實在不願意 ",
      "encoded_ascii": "^+Q^*A^$%^*K^#{^-z^*F^*{^\"d^(s^.W^*r^!'^&Z^&a^\"#^!\"^$%^#3^\"d^!)^.H^#z ",
      "encoded_base64": "XitRXipBXiQlXipLXiN7Xi16XipGXip7XiJkXihzXi5XXipyXiEnXiZaXiZhXiIjXiEiXiQlXiMzXiJkXiEpXi5IXiN6IA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_6782f55a57e1",
      "text": "親自跑這一趟，因為那會佔用我投入更 ",
      "encoded_ascii": "^(F^'l^(_^(s^!%^8)^*A^\"]^%{^)!^$r^0R^&H^$%^$3^!f^$o ",
      "encoded_base64": "XihGXidsXihfXihzXiElXjgpXipBXiJdXiV7XikhXiRyXjBSXiZIXiQlXiQzXiFmXiRvIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_71fa044b0c6f",
      "text": "有利可圖之買賣的時間。如果證明你們有能力，我們就能共享利潤。",
      "encoded_ascii": "^$s^!t^\"A^\"b^!/^.!^.$^&Z^$f^)G^!\"^#$^%!^-{^$c^*F^*{^$s^'b^!~^*A^$%^*{^*J^'b^3d^!;^!t^7_^!\"",
      "encoded_base64": "XiRzXiF0XiJBXiJiXiEvXi4hXi4kXiZaXiRmXilHXiEiXiMkXiUhXi17XiRjXipGXip7XiRzXidiXiF+XipBXiQlXip7XipKXidiXjNkXiE7XiF0XjdfXiEi",
      "byte_length": 90
    },
    {
      "unit_id": "DLG_526cbb5665c5",
      "text": "那麼歡迎來到荒漠的自由天地，在這裡生存取決於 ",
      "encoded_ascii": "^)!^.T^%F^(k^!O^!u^1W^,}^&Z^'l^&I^+e^\"e^*A^\"d^(s^-j^&F^#*^\":^,o^$^ ",
      "encoded_base64": "XikhXi5UXiVGXihrXiFPXiF1XjFXXix9XiZaXidsXiZJXitlXiJlXipBXiJkXihzXi1qXiZGXiMqXiI6XixvXiReIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_8762814a1868",
      "text": "你們的朋友與敵人。我們或許有著共同的利益。",
      "encoded_ascii": "^*F^*{^&Z^,[^\"8^'p^$U^!<^!\"^$%^*{^$'^-s^$s^-a^3d^\"E^&Z^!t^3R^!\"",
      "encoded_base64": "XipGXip7XiZaXixbXiI4XidwXiRVXiE8XiEiXiQlXip7XiQnXi1zXiRzXi1hXjNkXiJFXiZaXiF0XjNSXiEi",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_75b6ee258079",
      "text": "你的渴望與我驚人地相似。我們有許多事值得好好談談。",
      "encoded_ascii": "^*F^&Z^,w^,]^'p^$%^.Q^!<^\"e^&a^!H^!\"^$%^*{^$s^-s^\"x^*r^!Z^#e^+i^+i^0;^0;^!\"",
      "encoded_base64": "XipGXiZaXix3XixdXidwXiQlXi5RXiE8XiJlXiZhXiFIXiEiXiQlXip7XiRzXi1zXiJ4XipyXiFaXiNlXitpXitpXjA7XjA7XiEi",
      "byte_length": 75
    },
    {
      "unit_id": "DLG_bfdd186592eb",
      "text": "單純的人只有死路一條。或許我能為你們的流浪賦予意義。",
      "encoded_ascii": "^2a^3\"^&Z^!<^\"?^$s^%L^(a^!%^%.^!\"^$'^-s^$%^'b^%{^*F^*{^&Z^%j^,r^(Y^!4^#z^2<^!\"",
      "encoded_base64": "XjJhXjMiXiZaXiE8XiI/XiRzXiVMXihhXiElXiUuXiEiXiQnXi1zXiQlXidiXiV7XipGXip7XiZaXiVqXixyXihZXiE0XiN6XjI8XiEi",
      "byte_length": 78
    },
    {
      "unit_id": "DLG_26ed6a1b859b",
      "text": "後會有期。",
      "encoded_ascii": "^#b^$r^$s^$u^!\"",
      "encoded_base64": "XiNiXiRyXiRzXiR1XiEi",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_90d2bc80e8fe",
      "text": "啊，我就猜到會再見到你們。像你們這樣的旅人，最需要的就是 ",
      "encoded_ascii": "^+Q^*A^$%^*J^-'^!u^$r^!l^-m^!u^*F^*{^!\"^!`^*F^*{^(s^,f^&Z^2m^!<^*A^$q^)e^(C^&Z^*J^,X ",
      "encoded_base64": "XitRXipBXiQlXipKXi0nXiF1XiRyXiFsXi1tXiF1XipGXip7XiEiXiFgXipGXip7XihzXixmXiZaXjJtXiE8XipBXiRxXillXihDXiZaXipKXixYIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_db75aceb9dc5",
      "text": "冒險，而我手頭上正好有一樁極為適合你們的差事。",
      "encoded_ascii": "^/P^*m^*A^'W^$%^$+^)t^!'^%H^+i^$s^!%^%7^1D^%{^(|^\"C^*F^*{^&Z^48^*r^!\"",
      "encoded_base64": "Xi9QXiptXipBXidXXiQlXiQrXil0XiEnXiVIXitpXiRzXiElXiU3XjFEXiV7Xih8XiJDXipGXip7XiZaXjQ4XipyXiEi",
      "byte_length": 69
    },
    {
      "unit_id": "DLG_c07fdf015633",
      "text": "那真是太遺憾了。我們本可以一起賺進大筆利潤的。 ",
      "encoded_ascii": "^)!^-2^,X^+f^0v^0_^*D^!\"^$%^*{^$x^\"A^!B^!%^.(^7m^(w^\"z^-A^!t^7_^&Z^!\" ",
      "encoded_base64": "XikhXi0yXixYXitmXjB2XjBfXipEXiEiXiQlXip7XiR4XiJBXiFCXiElXi4oXjdtXih3XiJ6Xi1BXiF0XjdfXiZaXiEiIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_2c3e849d2290",
      "text": "願你們",
      "encoded_ascii": "^.H^*F^*{",
      "encoded_base64": "Xi5IXipGXip7",
      "byte_length": 9
    },
    {
      "unit_id": "DLG_e15ed5ee2184",
      "text": " 的冒險平安順利",
      "encoded_ascii": " ^&Z^/P^*m^0Y^+p^.D^!t",
      "encoded_base64": "IF4mWl4vUF4qbV4wWV4rcF4uRF4hdA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_e6069bbc353d",
      "text": "的旅途帶來豐盛收穫",
      "encoded_ascii": "^&Z^2m^3.^#N^!O^4!^1L^$M^<B",
      "encoded_base64": "XiZaXjJtXjMuXiNOXiFPXjQhXjFMXiRNXjxC",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_ed073a1bd7b7",
      "text": "。再見。",
      "encoded_ascii": "^!\"^!l^-m^!\"",
      "encoded_base64": "XiEiXiFsXi1tXiEi",
      "byte_length": 12
    },
    {
      "unit_id": "DLG_f94a17ecb890",
      "text": "  你有什麼建議？",
      "encoded_ascii": "  ^*F^$s^!=^.T^,'^-|^.V",
      "encoded_base64": "ICBeKkZeJHNeIT1eLlReLCdeLXxeLlY=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_124c992754da",
      "text": "  我懷疑你能提供給我任何東西。",
      "encoded_ascii": "  ^$%^,9^0p^*F^'b^$A^!P^'A^$%^!C^!L^,`^-l^!\"",
      "encoded_base64": "ICBeJCVeLDleMHBeKkZeJ2JeJEFeIVBeJ0FeJCVeIUNeIUxeLGBeLWxeISI=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_ce6d79785043",
      "text": "  我有施法材料想賣給你。",
      "encoded_ascii": "  ^$%^$s^$_^%b^$y^/n^,1^.$^'A^*F^!\"",
      "encoded_base64": "ICBeJCVeJHNeJF9eJWJeJHleL25eLDFeLiReJ0FeKkZeISI=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_4c1f083614a3",
      "text": "  塞德里爾特在哪裡？",
      "encoded_ascii": "  ^/(^#j^)(^&/^&5^\"d^+I^-j^.V",
      "encoded_base64": "ICBeLyheI2peKSheJi9eJjVeImReK0leLWpeLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_673dc0998f4c",
      "text": "  巨蠍獸的毒尾針是用來做什麼的？",
      "encoded_ascii": "  ^#H^06^&<^&Z^%Q^5J^)-^,X^&H^!O^*~^!=^.T^&Z^.V",
      "encoded_base64": "ICBeI0heMDZeJjxeJlpeJVFeNUpeKS1eLFheJkheIU9eKn5eIT1eLlReJlpeLlY=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_426424e95761",
      "text": "  這就是我能為你效勞的全部了嗎？",
      "encoded_ascii": "  ^(s^*J^,X^$%^'b^%{^*F^$Q^/R^&Z^!h^)#^*D^+X^.V",
      "encoded_base64": "ICBeKHNeKkpeLFheJCVeJ2JeJXteKkZeJFFeL1JeJlpeIWheKSNeKkReK1heLlY=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_1267bdf116a0",
      "text": "  你還需要其他任何東西嗎？",
      "encoded_ascii": "  ^*F^.7^)e^(C^!j^!@^!C^!L^,`^-l^+X^.V",
      "encoded_base64": "ICBeKkZeLjdeKWVeKENeIWpeIUBeIUNeIUxeLGBeLWxeK1heLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_e26effccbbc8",
      "text": "  奎利鳥有什麼特別之處？",
      "encoded_ascii": "  ^5B^!t^4p^$s^!=^.T^&5^*H^!/^(,^.V",
      "encoded_base64": "ICBeNUJeIXReNHBeJHNeIT1eLlReJjVeKkheIS9eKCxeLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_6bebba526bc1",
      "text": "  跟我說說你的這門營生吧。",
      "encoded_ascii": "  ^.+^$%^-x^-x^*F^&Z^(s^)D^&'^&F^*I^!\"",
      "encoded_base64": "ICBeLiteJCVeLXheLXheKkZeJlpeKHNeKUReJideJkZeKkleISI=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_48af512d20b7",
      "text": " 現在請恕我失陪，我手頭還有幾項差事需要親自處理。 ",
      "encoded_ascii": " ^&?^\"d^*S^3q^$%^\"|^8.^*A^$%^$+^)t^.7^$s^#T^)q^48^*r^)e^(C^(F^'l^(,^&A^!\" ",
      "encoded_base64": "IF4mP14iZF4qU14zcV4kJV4ifF44Ll4qQV4kJV4kK14pdF4uN14kc14jVF4pcV40OF4qcl4pZV4oQ14oRl4nbF4oLF4mQV4hIiA=",
      "byte_length": 74
    },
    {
      "unit_id": "DLG_964ef686f397",
      "text": "  我在哪裡能找到加林神父？",
      "encoded_ascii": "  ^$%^\"d^+I^-j^'b^$/^!u^\"\"^/1^&w^5d^.V",
      "encoded_base64": "ICBeJCVeImReK0leLWpeJ2JeJC9eIXVeIiJeLzFeJndeNWReLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_9d01d13f6797",
      "text": "  我需要幫助來尋找恐懼之花。",
      "encoded_ascii": "  ^$%^)e^(C^+}^\"#^!O^#9^$/^#t^$#^!/^'w^!\"",
      "encoded_base64": "ICBeJCVeKWVeKENeK31eIiNeIU9eIzleJC9eI3ReJCNeIS9eJ3deISI=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_12baf59418ad",
      "text": "  我要如何找到這種特殊的巨蠍獸？",
      "encoded_ascii": "  ^$%^(C^#$^!L^$/^!u^(s^'$^&5^9!^&Z^#H^06^&<^.V",
      "encoded_base64": "ICBeJCVeKENeIyReIUxeJC9eIXVeKHNeJyReJjVeOSFeJlpeI0heMDZeJjxeLlY=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_649e55b81d17",
      "text": "  這些施法材料是如何使用的？",
      "encoded_ascii": "  ^(s^!8^$_^%b^$y^/n^,X^#$^!L^!N^&H^&Z^.V",
      "encoded_base64": "ICBeKHNeITheJF9eJWJeJHleL25eLFheIyReIUxeIU5eJkheJlpeLlY=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_a14c83acf76b",
      "text": "  聽說過什麼值得一提的傳聞嗎？",
      "encoded_ascii": "  ^-X^-x^(x^!=^.T^!Z^#e^!%^$A^&Z^+$^4^^+X^.V",
      "encoded_base64": "ICBeLVheLXheKHheIT1eLlReIVpeI2VeISVeJEFeJlpeKyReNF5eK1heLlY=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_752a9d575a28",
      "text": "  你的那位特殊委託人是誰？",
      "encoded_ascii": "  ^*F^&Z^)!^!J^&5^9!^5E^-q^!<^,X^-y^.V",
      "encoded_base64": "ICBeKkZeJlpeKSFeIUpeJjVeOSFeNUVeLXFeITxeLFheLXleLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_cbdc57853b60",
      "text": "而我對你們也心存疑慮，但我願意給你們一個機會。請 ",
      "encoded_ascii": "^'W^$%^#:^*F^*{^!1^#k^#*^0p^19^*A^!I^$%^.H^#z^'A^*F^*{^!%^!V^%>^$r^!\"^*S ",
      "encoded_base64": "XidXXiQlXiM6XipGXip7XiExXiNrXiMqXjBwXjE5XipBXiFJXiQlXi5IXiN6XidBXipGXip7XiElXiFWXiU+XiRyXiEiXipTIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_b0f44738b501",
      "text": "聽我說完。我的這門營生能帶來豐厚的利潤。",
      "encoded_ascii": "^-X^$%^-x^#,^!\"^$%^&Z^(s^)D^&'^&F^'b^#N^!O^4!^\"4^&Z^!t^7_^!\"",
      "encoded_base64": "Xi1YXiQlXi14XiMsXiEiXiQlXiZaXihzXilEXiYnXiZGXidiXiNOXiFPXjQhXiI0XiZaXiF0XjdfXiEi",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_772b6765bc8e",
      "text": "我是個商人，經手一些難以取得的特殊貨物。我的顧客 ",
      "encoded_ascii": "^$%^,X^!V^1'^!<^*A^'D^$+^!%^!8^)a^!B^\":^#e^&Z^&5^9!^.w^&4^!\"^$%^&Z^4n^+q ",
      "encoded_base64": "XiQlXixYXiFWXjEnXiE8XipBXidEXiQrXiElXiE4XilhXiFCXiI6XiNlXiZaXiY1XjkhXi53XiY0XiEiXiQlXiZaXjRuXitxIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_bc8d137aefd1",
      "text": "古怪且難以捉摸。簡而言之，這是一門高風險、高 ",
      "encoded_ascii": "^\"=^#s^!*^)a^!B^4>^/j^!\"^3y^'W^1Y^!/^*A^(s^,X^!%^)D^*+^)y^*m^!!^*+ ",
      "encoded_base64": "XiI9XiNzXiEqXilhXiFCXjQ+Xi9qXiEiXjN5XidXXjFZXiEvXipBXihzXixYXiElXilEXiorXil5XiptXiEhXiorIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_695f3882c553",
      "text": "回報的買賣。",
      "encoded_ascii": "^\"\\^+`^&Z^.!^.$^!\"",
      "encoded_base64": "XiJcXitgXiZaXi4hXi4kXiEi",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_c2f1602af0ba",
      "text": "他是提奎茲爾的牧師。那個村莊很容易找， ",
      "encoded_ascii": "^!@^,X^$A^5B^/D^&/^&Z^/5^#M^!\"^)!^!V^$z^6l^*K^+t^,W^$/^*A ",
      "encoded_base64": "XiFAXixYXiRBXjVCXi9EXiYvXiZaXi81XiNNXiEiXikhXiFWXiR6XjZsXipLXit0XixXXiQvXipBIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_ab5db4092bc7",
      "text": "只要往西走，再朝北行即可。加林神父會 ",
      "encoded_ascii": "^\"?^(C^,)^-l^.&^*A^!l^,^^+6^(;^\"1^\"A^!\"^\"\"^/1^&w^5d^$r ",
      "encoded_base64": "XiI/XihDXiwpXi1sXi4mXipBXiFsXixeXis2Xig7XiIxXiJBXiEiXiIiXi8xXiZ3XjVkXiRyIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_6aff4780326f",
      "text": "等著那袋樹髓。",
      "encoded_ascii": "^'-^-a^)!^(?^%;^*)^!\"",
      "encoded_base64": "XictXi1hXikhXig/XiU7XiopXiEi",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_ba2296b63e60",
      "text": "正如我所說，狂暴獸的死亡似乎是獲得 ",
      "encoded_ascii": "^%H^#$^$%^$)^-x^*A^&8^$m^&<^&Z^%L^!:^!H^!0^,X^&:^#e ",
      "encoded_base64": "XiVIXiMkXiQlXiQpXi14XipBXiY4XiRtXiY8XiZaXiVMXiE6XiFIXiEwXixYXiY6XiNlIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_decae490a98a",
      "text": "恐懼之花的關鍵。在其中一份文獻中也提到， ",
      "encoded_ascii": "^#t^$#^!/^'w^&Z^.>^9x^!\"^\"d^!j^!,^!%^*x^$W^-(^!,^!1^$A^!u^*A ",
      "encoded_base64": "XiN0XiQjXiEvXid3XiZaXi4+Xjl4XiEiXiJkXiFqXiEsXiElXip4XiRXXi0oXiEsXiExXiRBXiF1XipBIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_5374320dd7c1",
      "text": "這種花只生長在 ",
      "encoded_ascii": "^(s^'$^'w^\"?^&F^)C^\"d ",
      "encoded_base64": "XihzXickXid3XiI/XiZGXilDXiJkIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_b56cf45ac70d",
      "text": "多山的地區，就像塞德利特上方的那片山嶺。",
      "encoded_ascii": "^\"x^11^&Z^\"e^\"+^*A^*J^!`^/(^#j^!t^&5^!'^$]^&Z^)!^&1^11^>Z^!\"",
      "encoded_base64": "XiJ4XjExXiZaXiJlXiIrXipBXipKXiFgXi8oXiNqXiF0XiY1XiEnXiRdXiZaXikhXiYxXjExXj5aXiEi",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_52b08e1ac6a8",
      "text": "某種特定的生境。或許塞德利特的博學大師會知道更多。",
      "encoded_ascii": "^%$^'$^&5^#.^&Z^&F^\"q^!\"^$'^-s^/(^#j^!t^&5^&Z^/$^+n^\"z^#M^$r^&h^(y^$o^\"x^!\"",
      "encoded_base64": "XiUkXickXiY1XiMuXiZaXiZGXiJxXiEiXiQnXi1zXi8oXiNqXiF0XiY1XiZaXi8kXituXiJ6XiNNXiRyXiZoXih5XiRvXiJ4XiEi",
      "byte_length": 75
    },
    {
      "unit_id": "DLG_0494d10c8097",
      "text": "先找到奎利鳥，再去操心如何取得巨蠍獸的 ",
      "encoded_ascii": "^!b^$/^!u^5B^!t^4p^*A^!l^\"6^$H^#k^#$^!L^\":^#e^#H^06^&<^&Z ",
      "encoded_base64": "XiFiXiQvXiF1XjVCXiF0XjRwXipBXiFsXiI2XiRIXiNrXiMkXiFMXiI6XiNlXiNIXjA2XiY8XiZaIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_1242a1c8b353",
      "text": "毒尾針。奎利鳥棲息在北方淤泥海的沿岸。",
      "encoded_ascii": "^%Q^5J^)-^!\"^5B^!t^4p^,b^#w^\"d^+6^$]^6c^%d^6`^&Z^%`^>Y^!\"",
      "encoded_base64": "XiVRXjVKXiktXiEiXjVCXiF0XjRwXixiXiN3XiJkXis2XiRdXjZjXiVkXjZgXiZaXiVgXj5ZXiEi",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_01b12f6a563e",
      "text": "就在此處正西方。路途相當遙遠，但絕對值得。上次 ",
      "encoded_ascii": "^*J^\"d^%I^(,^%H^-l^$]^!\"^(a^3.^&a^&N^4j^({^*A^!I^-I^#:^!Z^#e^!\"^!'^%D ",
      "encoded_base64": "XipKXiJkXiVJXigsXiVIXi1sXiRdXiEiXihhXjMuXiZhXiZOXjRqXih7XipBXiFJXi1JXiM6XiFaXiNlXiEiXiEnXiVEIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_7a9ba8a632dd",
      "text": "我造訪那個村落時，那裡欣欣向榮，我甚至考慮過在那裡退休安度晚年。",
      "encoded_ascii": "^$%^(v^4d^)!^!V^$z^-`^$f^*A^)!^-j^2'^2'^+?^,e^*A^$%^/|^'n^-R^19^(x^\"d^)!^-j^*V^!G^+p^#V^,Y^+~^!\"",
      "encoded_base64": "XiQlXih2XjRkXikhXiFWXiR6Xi1gXiRmXipBXikhXi1qXjInXjInXis/XixlXipBXiQlXi98XiduXi1SXjE5Xih4XiJkXikhXi1qXipWXiFHXitwXiNWXixZXit+XiEi",
      "byte_length": 96
    },
    {
      "unit_id": "DLG_f9e48f235031",
      "text": "算了吧，說出來可就洩密了。只要知道他是位極具威能的 ",
      "encoded_ascii": "^-C^*D^*I^*A^-x^!q^!O^\"A^*J^6_^#0^*D^!\"^\"?^(C^&h^(y^!@^,X^!J^1D^!k^#&^'b^&Z ",
      "encoded_base64": "Xi1DXipEXipJXipBXi14XiFxXiFPXiJBXipKXjZfXiMwXipEXiEiXiI/XihDXiZoXih5XiFAXixYXiFKXjFEXiFrXiMmXidiXiZaIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_27e63953ef69",
      "text": "巫師就夠了。招惹他是不明智的……讓他失望也是。",
      "encoded_ascii": "^14^#M^*J^+d^*D^!\"^,D^3s^!@^,X^!)^$c^$i^&Z^*o^*o^-}^!@^\"|^,]^!1^,X^!\"",
      "encoded_base64": "XjE0XiNNXipKXitkXipEXiEiXixEXjNzXiFAXixYXiEpXiRjXiRpXiZaXipvXipvXi19XiFAXiJ8XixdXiExXixYXiEi",
      "byte_length": 69
    },
    {
      "unit_id": "DLG_337502b6368f",
      "text": "奎利鳥的羽毛覆蓋著一層油性分泌物，能將 ",
      "encoded_ascii": "^5B^!t^4p^&Z^'S^%R^(D^-d^-a^!%^#B^%^^#r^!s^>[^&4^*A^'b^#7 ",
      "encoded_base64": "XjVCXiF0XjRwXiZaXidTXiVSXihEXi1kXi1hXiElXiNCXiVeXiNyXiFzXj5bXiY0XipBXidiXiM3IA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_356183e18de4",
      "text": "巨蠍獸的毒素轉化為具有心靈感應接收特性的物質。",
      "encoded_ascii": "^#H^06^&<^&Z^%Q^'=^(i^\")^%{^!k^$s^#k^)g^#{^0`^$?^$M^&5^#r^&Z^&4^(Z^!\"",
      "encoded_base64": "XiNIXjA2XiY8XiZaXiVRXic9XihpXiIpXiV7XiFrXiRzXiNrXilnXiN7XjBgXiQ/XiRNXiY1XiNyXiZaXiY0XihaXiEi",
      "byte_length": 69
    },
    {
      "unit_id": "DLG_44504534e270",
      "text": "它在醫術上有諸多用途，且往往是各類 ",
      "encoded_ascii": "^+o^\"d^<J^(<^!'^$s^1]^\"x^&H^3.^*A^!*^,)^,)^,X^+>^)w ",
      "encoded_base64": "XitvXiJkXjxKXig8XiEnXiRzXjFdXiJ4XiZIXjMuXipBXiEqXiwpXiwpXixYXis+Xil3IA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_cb2d7cfb5441",
      "text": "藥膏與軟膏的主要成分。",
      "encoded_ascii": "^()^>`^'p^.x^>`^&Z^!-^(C^$$^!s^!\"",
      "encoded_base64": "XigpXj5gXidwXi54Xj5gXiZaXiEtXihDXiQkXiFzXiEi",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_4f873faadc11",
      "text": "這很難說。我也只是透過我的委託人才得知 ",
      "encoded_ascii": "^(s^*K^)a^-x^!\"^$%^!1^\"?^,X^(q^(x^$%^&Z^5E^-q^!<^$,^#e^&h ",
      "encoded_base64": "XihzXipLXilhXi14XiEiXiQlXiExXiI/XixYXihxXih4XiQlXiZaXjVFXi1xXiE8XiQsXiNlXiZoIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_56b45bb9b461",
      "text": "它的存在。他讓我看的文獻表明，從這朵花提取的精華 ",
      "encoded_ascii": "^+o^&Z^#*^\"d^!\"^!@^-}^$%^*Q^&Z^$W^-(^-i^$c^*A^#f^(s^9C^'w^$A^\":^&Z^'7^3' ",
      "encoded_base64": "XitvXiZaXiMqXiJkXiEiXiFAXi19XiQlXipRXiZaXiRXXi0oXi1pXiRjXipBXiNmXihzXjlDXid3XiRBXiI6XiZaXic3XjMnIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_fe6bf1c2c296",
      "text": "是用來製造魔法武器的。塞德利特的博學 ",
      "encoded_ascii": "^,X^&H^!O^(B^(v^*0^%b^%J^\"V^&Z^!\"^/(^#j^!t^&5^&Z^/$^+n ",
      "encoded_base64": "XixYXiZIXiFPXihCXih2XiowXiViXiVKXiJWXiZaXiEiXi8oXiNqXiF0XiY1XiZaXi8kXituIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_4527c40aa08f",
      "text": "大師或許會知道。",
      "encoded_ascii": "^\"z^#M^$'^-s^$r^&h^(y^!\"",
      "encoded_base64": "XiJ6XiNNXiQnXi1zXiRyXiZoXih5XiEi",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_b9f0a0b8c831",
      "text": "巨蠍獸是種罕見且致命的凶獸，經常潛藏在 ",
      "encoded_ascii": "^#H^06^&<^,X^'$^5w^-m^!*^'o^\"N^&Z^3e^&<^*A^'D^#O^7:^-f^\"d ",
      "encoded_base64": "XiNIXjA2XiY8XixYXickXjV3Xi1tXiEqXidvXiJOXiZaXjNlXiY8XipBXidEXiNPXjc6Xi1mXiJkIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_b3cf52fd222b",
      "text": "沙子底下。如果你的眼睛夠銳利，或許能辨認出沙地上凹陷的 ",
      "encoded_ascii": "^%]^#(^/^^!(^!\"^#$^%!^*F^&Z^&d^&f^+d^;W^!t^*A^$'^-s^'b^6{^(O^!q^%]^\"e^!'^>]^)S^&Z ",
      "encoded_base64": "XiVdXiMoXi9eXiEoXiEiXiMkXiUhXipGXiZaXiZkXiZmXitkXjtXXiF0XipBXiQnXi1zXidiXjZ7XihPXiFxXiVdXiJlXiEnXj5dXilTXiZaIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_af2008919d08",
      "text": "沙錐痕跡，那就是巨蠍獸把自己掩埋之處。",
      "encoded_ascii": "^%]^)3^3v^(`^*A^)!^*J^,X^#H^06^&<^$1^'l^#I^9~^1r^!/^(,^!\"",
      "encoded_base64": "XiVdXikzXjN2XihgXipBXikhXipKXixYXiNIXjA2XiY8XiQxXidsXiNJXjl+XjFyXiEvXigsXiEi",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_0b1216c52c36",
      "text": "靈法師會在特定的儀式中使用其毒尾針的毒液。 ",
      "encoded_ascii": "^)g^%b^#M^$r^\"d^&5^#.^&Z^+'^#X^!,^!N^&H^!j^%Q^5J^)-^&Z^%Q^%l^!\" ",
      "encoded_base64": "XilnXiViXiNNXiRyXiJkXiY1XiMuXiZaXisnXiNYXiEsXiFOXiZIXiFqXiVRXjVKXiktXiZaXiVRXiVsXiEiIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_f917cc20bf8f",
      "text": "我認為在這種事情上不過度深究才是明智之舉。",
      "encoded_ascii": "^$%^(O^%{^\"d^(s^'$^*r^,0^!'^!)^(x^#V^2*^-<^$,^,X^$c^$i^!/^01^!\"",
      "encoded_base64": "XiQlXihPXiV7XiJkXihzXickXipyXiwwXiEnXiEpXih4XiNWXjIqXi08XiQsXixYXiRjXiRpXiEvXjAxXiEi",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_ede4ce5d49db",
      "text": "事實上，我讓你們收集的材料本身並非直接拿來 ",
      "encoded_ascii": "^*r^#3^!'^*A^$%^-}^*F^*{^$M^)]^&Z^$y^/n^$x^(c^!+^)i^&`^$?^,G^!O ",
      "encoded_base64": "XipyXiMzXiEnXipBXiQlXi19XipGXip7XiRNXildXiZaXiR5Xi9uXiR4XihjXiErXilpXiZgXiQ/XixHXiFPIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_1048bebbaf08",
      "text": "使用，而是會被加工成其他材料。你們心中是否有 ",
      "encoded_ascii": "^!N^&H^*A^'W^,X^$r^(@^\"\"^+y^$$^!j^!@^$y^/n^!\"^*F^*{^#k^!,^,X^\"H^$s ",
      "encoded_base64": "XiFOXiZIXipBXidXXixYXiRyXihAXiIiXit5XiQkXiFqXiFAXiR5Xi9uXiEiXipGXip7XiNrXiEsXixYXiJIXiRzIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_95466a07117a",
      "text": "想打聽的特定之物？",
      "encoded_ascii": "^,1^$-^-X^&Z^&5^#.^!/^&4^.V",
      "encoded_base64": "XiwxXiQtXi1YXiZaXiY1XiMuXiEvXiY0Xi5W",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_1eab9ed8db63",
      "text": "  沙嚎獸之眼是用來做什麼的？",
      "encoded_ascii": "  ^%]^\"Y^&<^!/^&d^,X^&H^!O^*~^!=^.T^&Z^.V",
      "encoded_base64": "ICBeJV1eIlleJjxeIS9eJmReLFheJkheIU9eKn5eIT1eLlReJlpeLlY=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_cf39a012868b",
      "text": "  為什麼會有人想要火鰻之舌？",
      "encoded_ascii": "  ^%{^!=^.T^$r^$s^!<^,1^(C^%x^*1^!/^'q^.V",
      "encoded_base64": "ICBeJXteIT1eLlReJHJeJHNeITxeLDFeKENeJXheKjFeIS9eJ3FeLlY=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_a8dd312e24c8",
      "text": "  你拿蝴蝶翅膀做什麼用？",
      "encoded_ascii": "  ^*F^,G^(5^(6^95^96^*~^!=^.T^&H^.V",
      "encoded_base64": "ICBeKkZeLEdeKDVeKDZeOTVeOTZeKn5eIT1eLlReJkheLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_ed1a24b8f22e",
      "text": "  尖叫甲蟲之翼該如何使用？",
      "encoded_ascii": "  ^#=^+<^&J^(8^!/^'T^(M^#$^!L^!N^&H^.V",
      "encoded_base64": "ICBeIz1eKzxeJkpeKDheIS9eJ1ReKE1eIyReIUxeIU5eJkheLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_de03cb25ab3b",
      "text": "  沒事了。",
      "encoded_ascii": "  ^%\\^*r^*D^!\"",
      "encoded_base64": "ICBeJVxeKnJeKkReISI=",
      "byte_length": 14
    },
    {
      "unit_id": "DLG_6d5ce4156805",
      "text": "沙嚎獸擁有麻痺人心的凝視，這賦予了牠們的雙眼極其獨特的 ",
      "encoded_ascii": "^%]^\"Y^&<^,M^$s^*6^&S^!<^#k^&Z^!o^(E^*A^(s^(Y^!4^*D^-#^*{^&Z^)_^&d^1D^!j^/z^&5^&Z ",
      "encoded_base64": "XiVdXiJZXiY8XixNXiRzXio2XiZTXiE8XiNrXiZaXiFvXihFXipBXihzXihZXiE0XipEXi0jXip7XiZaXilfXiZkXjFEXiFqXi96XiY1XiZaIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_6313c4f94d39",
      "text": "特質。經過正確加工處理後，這對眼睛可用於 ",
      "encoded_ascii": "^&5^(Z^!\"^'D^(x^%H^-6^\"\"^+y^(,^&A^#b^*A^(s^#:^&d^&f^\"A^&H^$^ ",
      "encoded_base64": "XiY1XihaXiEiXidEXih4XiVIXi02XiIiXit5XigsXiZBXiNiXipBXihzXiM6XiZkXiZmXiJBXiZIXiReIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_343351683d92",
      "text": "製作某些秘術魔法物品。",
      "encoded_ascii": "^(B^!M^%$^!8^1O^(<^*0^%b^&4^\"R^!\"",
      "encoded_base64": "XihCXiFNXiUkXiE4XjFPXig8XiowXiViXiY0XiJSXiEi",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_54f215b0b52b",
      "text": "火鰻之舌之所以廣受渴求，是因為在儀式中能藉其獲得 ",
      "encoded_ascii": "^%x^*1^!/^'q^!/^$)^!B^9V^\";^,w^,n^*A^,X^\"]^%{^\"d^+'^#X^!,^'b^04^!j^&:^#e ",
      "encoded_base64": "XiV4XioxXiEvXidxXiEvXiQpXiFCXjlWXiI7Xix3XixuXipBXixYXiJdXiV7XiJkXisnXiNYXiEsXidiXjA0XiFqXiY6XiNlIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_045eaedbfa61",
      "text": "對火焰的親和力。",
      "encoded_ascii": "^#:^%x^&!^&Z^(F^\"O^!~^!\"",
      "encoded_base64": "XiM6XiV4XiYhXiZaXihGXiJPXiF+XiEi",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_09d95c2cc018",
      "text": "說老實話，提爾蝴蝶的翅膀跟魔法一點關係也沒有。 ",
      "encoded_ascii": "^-x^'U^#3^-v^*A^$A^&/^(5^(6^&Z^95^96^.+^*0^%b^!%^*;^.>^38^!1^%\\^$s^!\" ",
      "encoded_base64": "Xi14XidVXiMzXi12XipBXiRBXiYvXig1Xig2XiZaXjk1Xjk2Xi4rXiowXiViXiElXio7Xi4+XjM4XiExXiVcXiRzXiEiIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_114a9a6d440c",
      "text": "然而，城邦裡有許多貴族甘願花大把銀子，購買我用牠們研磨出的 ",
      "encoded_ascii": "^&\"^'W^*A^+_^1a^-j^$s^-s^\"x^2F^5V^/:^.H^'w^\"z^$1^)0^#(^*A^63^.!^$%^&H^-#^*{^9G^-7^!q^&Z ",
      "encoded_base64": "XiYiXidXXipBXitfXjFhXi1qXiRzXi1zXiJ4XjJGXjVWXi86Xi5IXid3XiJ6XiQxXikwXiMoXipBXjYzXi4hXiQlXiZIXi0jXip7XjlHXi03XiFxXiZaIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_55dcde946262",
      "text": "色彩斑斕之艷麗細粉。",
      "encoded_ascii": "^'s^#`^;D^;E^!/^>a^0z^'?^'5^!\"",
      "encoded_base64": "XidzXiNgXjtEXjtFXiEvXj5hXjB6Xic/Xic1XiEi",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_3085cb975b6a",
      "text": "甲蟲雙翼的甲殼質在提純後具有絕妙的特性。 ",
      "encoded_ascii": "^&J^(8^)_^'T^&Z^&J^1F^(Z^\"d^$A^3\"^#b^!k^$s^-I^43^&Z^&5^#r^!\" ",
      "encoded_base64": "XiZKXig4XilfXidUXiZaXiZKXjFGXihaXiJkXiRBXjMiXiNiXiFrXiRzXi1JXjQzXiZaXiY1XiNyXiEiIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_49c885e56c70",
      "text": "許多魔法學派都會將其用於製作儀式法器。",
      "encoded_ascii": "^-s^\"x^*0^%b^+n^.n^)$^$r^#7^!j^&H^$^^(B^!M^+'^#X^%b^\"V^!\"",
      "encoded_base64": "Xi1zXiJ4XiowXiViXituXi5uXikkXiRyXiM3XiFqXiZIXiReXihCXiFNXisnXiNYXiViXiJWXiEi",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_945e6b900026",
      "text": "當然可以。不該問的事不多問，往往才是最明智的做法。",
      "encoded_ascii": "^&N^&\"^\"A^!B^!\"^!)^(M^*Z^&Z^*r^!)^\"x^*Z^*A^,)^,)^$,^,X^$q^$c^$i^&Z^*~^%b^!\"",
      "encoded_base64": "XiZOXiYiXiJBXiFCXiEiXiEpXihNXipaXiZaXipyXiEpXiJ4XipaXipBXiwpXiwpXiQsXixYXiRxXiRjXiRpXiZaXip+XiViXiEi",
      "byte_length": 75
    },
    {
      "unit_id": "DLG_d82e74416558",
      "text": "沒什麼好說的。我只是個普通的商人，而且就像所有商人一樣， ",
      "encoded_ascii": "^%\\^!=^.T^+i^-x^&Z^!\"^$%^\"?^,X^!V^$g^(t^&Z^1'^!<^*A^'W^!*^*J^!`^$)^$s^1'^!<^!%^,f^*A ",
      "encoded_base64": "XiVcXiE9Xi5UXitpXi14XiZaXiEiXiQlXiI/XixYXiFWXiRnXih0XiZaXjEnXiE8XipBXidXXiEqXipKXiFgXiQpXiRzXjEnXiE8XiElXixmXipBIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_abc5e38dc95e",
      "text": "我都必須從顧客的自私私慾中討生活。",
      "encoded_ascii": "^$%^)$^#l^)r^#f^4n^+q^&Z^'l^&~^&~^=T^!,^-o^&F^%i^!\"",
      "encoded_base64": "XiQlXikkXiNsXilyXiNmXjRuXitxXiZaXidsXiZ+XiZ+Xj1UXiEsXi1vXiZGXiVpXiEi",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_ed1a5fcc8b6e",
      "text": "  你的買賣究竟是做什麼的？",
      "encoded_ascii": "  ^*F^&Z^.!^.$^-<^28^,X^*~^!=^.T^&Z^.V",
      "encoded_base64": "ICBeKkZeJlpeLiFeLiReLTxeMjheLFheKn5eIT1eLlReJlpeLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_d17cc8727dec",
      "text": "  為什麼我不能直接賣給那些法師？",
      "encoded_ascii": "  ^%{^!=^.T^$%^!)^'b^&`^$?^.$^'A^)!^!8^%b^#M^.V",
      "encoded_base64": "ICBeJXteIT1eLlReJCVeISleJ2JeJmBeJD9eLiReJ0FeKSFeITheJWJeI01eLlY=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_48a7d2207d6e",
      "text": "  你的顧客都是些什麼人？",
      "encoded_ascii": "  ^*F^&Z^4n^+q^)$^,X^!8^!=^.T^!<^.V",
      "encoded_base64": "ICBeKkZeJlpeNG5eK3FeKSReLFheITheIT1eLlReITxeLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_ca816bee7f01",
      "text": "  我在這整件事中扮演什麼角色？",
      "encoded_ascii": "  ^$%^\"d^(s^$T^.W^*r^!,^<'^1G^!=^.T^(H^'s^.V",
      "encoded_base64": "ICBeJCVeImReKHNeJFReLldeKnJeISxePCdeMUdeIT1eLlReKEheJ3NeLlY=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_186ea8004d47",
      "text": "  關於你的營生我已經聽夠了。",
      "encoded_ascii": "  ^.>^$^^*F^&Z^&'^&F^$%^#J^'D^-X^+d^*D^!\"",
      "encoded_base64": "ICBeLj5eJF5eKkZeJlpeJideJkZeJCVeI0peJ0ReLVheK2ReKkReISI=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_79a0f4f6913e",
      "text": "法力高強的法師需要生僻罕見的材料來進行其秘術 ",
      "encoded_ascii": "^%b^!~^*+^#]^&Z^%b^#M^)e^(C^&F^>\\^5w^-m^&Z^$y^/n^!O^(w^(;^!j^1O^(< ",
      "encoded_base64": "XiViXiF+XiorXiNdXiZaXiViXiNNXillXihDXiZGXj5cXjV3Xi1tXiZaXiR5Xi9uXiFPXih3Xig7XiFqXjFPXig8IA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_13cf99d31d21",
      "text": "儀式。我負責取得這些物品並依要求將其提純淨化。我經常 ",
      "encoded_ascii": "^+'^#X^!\"^$%^(W^0>^\":^#e^(s^!8^&4^\"R^!+^!Q^(C^,n^#7^!j^$A^3\"^0k^\")^!\"^$%^'D^#O ",
      "encoded_base64": "XisnXiNYXiEiXiQlXihXXjA+XiI6XiNlXihzXiE4XiY0XiJSXiErXiFRXihDXixuXiM3XiFqXiRBXjMiXjBrXiIpXiEiXiQlXidEXiNPIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_106b6e0e4ab4",
      "text": "依照委託契約行事，或者乾脆將貨物賣給出價最高的買家。",
      "encoded_ascii": "^!Q^/x^5E^-q^8W^-F^(;^*r^*A^$'^'V^*X^2?^#7^.w^&4^.$^'A^!q^+&^$q^*+^&Z^.!^+s^!\"",
      "encoded_base64": "XiFRXi94XjVFXi1xXjhXXi1GXig7XipyXipBXiQnXidWXipYXjI/XiM3Xi53XiY0Xi4kXidBXiFxXismXiRxXiorXiZaXi4hXitzXiEi",
      "byte_length": 78
    },
    {
      "unit_id": "DLG_ee3fc280e533",
      "text": "法師們對未加工的原料毫無興趣。他們要的是我加工後的 ",
      "encoded_ascii": "^%b^#M^*{^#:^,_^\"\"^+y^&Z^\"5^/n^/t^%}^-]^.*^!\"^!@^*{^(C^&Z^,X^$%^\"\"^+y^#b^&Z ",
      "encoded_base64": "XiViXiNNXip7XiM6XixfXiIiXit5XiZaXiI1Xi9uXi90XiV9Xi1dXi4qXiEiXiFAXip7XihDXiZaXixYXiQlXiIiXit5XiNiXiZaIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_7e1cc5667a15",
      "text": "材料。同時我也享有他們的信任。我的貨品從不會變質損壞， ",
      "encoded_ascii": "^$y^/n^!\"^\"E^$f^$%^!1^!;^$s^!@^*{^&Z^!U^!C^!\"^$%^&Z^.w^\"R^#f^!)^$r^(U^(Z^$D^\"v^*A ",
      "encoded_base64": "XiR5Xi9uXiEiXiJFXiRmXiQlXiExXiE7XiRzXiFAXip7XiZaXiFVXiFDXiEiXiQlXiZaXi53XiJSXiNmXiEpXiRyXihVXihaXiREXiJ2XipBIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_c0b6bf937cfa",
      "text": "且永遠都是最高品質。",
      "encoded_ascii": "^!*^%W^({^)$^,X^$q^*+^\"R^(Z^!\"",
      "encoded_base64": "XiEqXiVXXih7XikkXixYXiRxXiorXiJSXihaXiEi",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_5982c99f00e4",
      "text": "我的顧客因季節和地區而異。我從不會在一個地方久留。 ",
      "encoded_ascii": "^$%^&Z^4n^+q^\"]^8X^9b^\"O^\"e^\"+^'W^&M^!\"^$%^#f^!)^$r^\"d^!%^!V^\"e^$]^!.^-+^!\" ",
      "encoded_base64": "XiQlXiZaXjRuXitxXiJdXjhYXjliXiJPXiJlXiIrXidXXiZNXiEiXiQlXiNmXiEpXiRyXiJkXiElXiFWXiJlXiRdXiEuXi0rXiEiIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_1b219a0b94a7",
      "text": "在我的這門營生裡，物以稀為貴乃是求之不得的福音。",
      "encoded_ascii": "^\"d^$%^&Z^(s^)D^&'^&F^-j^*A^&4^!B^3w^%{^2F^/M^,X^,n^!/^!)^#e^&Z^&z^34^!\"",
      "encoded_base64": "XiJkXiQlXiZaXihzXilEXiYnXiZGXi1qXipBXiY0XiFCXjN3XiV7XjJGXi9NXixYXixuXiEvXiEpXiNlXiZaXiZ6XjM0XiEi",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_094f700ad3fa",
      "text": "我需要的材料極其罕見，而且許多都必須克服兇猛危險的野獸才能取得。 ",
      "encoded_ascii": "^$%^)e^(C^&Z^$y^/n^1D^!j^5w^-m^*A^'W^!*^-s^\"x^)$^#l^)r^!d^,\\^*G^*P^2\\^*m^&Z^.:^&<^$,^'b^\":^#e^!\" ",
      "encoded_base64": "XiQlXillXihDXiZaXiR5Xi9uXjFEXiFqXjV3Xi1tXipBXidXXiEqXi1zXiJ4XikkXiNsXilyXiFkXixcXipHXipQXjJcXiptXiZaXi46XiY8XiQsXidiXiI6XiNlXiEiIA==",
      "byte_length": 97
    },
    {
      "unit_id": "DLG_f59abdb078e9",
      "text": "如果全靠我自己去搜尋這些物品，根本無法滿足所有的需求， ",
      "encoded_ascii": "^#$^%!^!h^.C^$%^'l^#I^\"6^/h^#9^(s^!8^&4^\"R^*A^%)^$x^%}^%b^,{^(^^$)^$s^&Z^)e^,n^*A ",
      "encoded_base64": "XiMkXiUhXiFoXi5DXiQlXidsXiNJXiI2Xi9oXiM5XihzXiE4XiY0XiJSXipBXiUpXiR4XiV9XiViXix7XiheXiQpXiRzXiZaXillXixuXipBIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_6f88ebcfb987",
      "text": "因此我僱用像你們這樣的代理人。",
      "encoded_ascii": "^\"]^%I^$%^=?^&H^!`^*F^*{^(s^,f^&Z^*v^&A^!<^!\"",
      "encoded_base64": "XiJdXiVJXiQlXj0/XiZIXiFgXipGXip7XihzXixmXiZaXip2XiZBXiE8XiEi",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_8b8ef6c4e39e",
      "text": "確實如此。當實際行動正等著你們去完成時，多費口舌毫無意義。",
      "encoded_ascii": "^-6^#3^#$^%I^!\"^&N^#3^30^(;^\"%^%H^'-^-a^*F^*{^\"6^#,^$$^$f^*A^\"x^.\"^\"<^'q^/t^%}^#z^2<^!\"",
      "encoded_base64": "Xi02XiMzXiMkXiVJXiEiXiZOXiMzXjMwXig7XiIlXiVIXictXi1hXipGXip7XiI2XiMsXiQkXiRmXipBXiJ4Xi4iXiI8XidxXi90XiV9XiN6XjI8XiEi",
      "byte_length": 87
    },
    {
      "unit_id": "DLG_41bed8d05e94",
      "text": "沒有，周遭一切都很平靜。",
      "encoded_ascii": "^%\\^$s^*A^\"L^(}^!%^+.^)$^*K^0Y^)h^!\"",
      "encoded_base64": "XiVcXiRzXipBXiJMXih9XiElXisuXikkXipLXjBZXiloXiEi",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_36822848591b",
      "text": "不久前，此處以北的一支商隊遭到強盜的重創。 ",
      "encoded_ascii": "^!)^!.^!z^*A^%I^(,^!B^+6^&Z^!%^$L^1'^)U^(}^!u^#]^0!^&Z^))^!{^!\" ",
      "encoded_base64": "XiEpXiEuXiF6XipBXiVJXigsXiFCXis2XiZaXiElXiRMXjEnXilVXih9XiF1XiNdXjAhXiZaXikpXiF7XiEiIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_79ff1dcc7f74",
      "text": "雖然跟我沒半點關係，但確實會讓人有點神經緊繃。",
      "encoded_ascii": "^.A^&\"^.+^$%^%\\^\"-^*;^.>^38^*A^!I^-6^#3^$r^-}^!<^$s^*;^&w^'D^0r^>_^!\"",
      "encoded_base64": "Xi5BXiYiXi4rXiQlXiVcXiItXio7Xi4+XjM4XipBXiFJXi02XiMzXiRyXi19XiE8XiRzXio7XiZ3XidEXjByXj5fXiEi",
      "byte_length": 69
    },
    {
      "unit_id": "DLG_89ad4b0a0c66",
      "text": "有一隊德拉吉守衛剛打這兒經過，一路向北前進。 ",
      "encoded_ascii": "^$s^!%^)U^#j^$6^\"D^#+^(=^+0^$-^(s^++^'D^(x^*A^!%^(a^+?^+6^!z^(w^!\" ",
      "encoded_base64": "XiRzXiElXilVXiNqXiQ2XiJEXiMrXig9XiswXiQtXihzXisrXidEXih4XipBXiElXihhXis/Xis2XiF6Xih3XiEiIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_3ba805861078",
      "text": "看來似乎是一群奴隸脫逃了，讓某些聖堂武士顏面掃地、 ",
      "encoded_ascii": "^*Q^!O^!H^!0^,X^!%^'R^##^)Z^'c^(p^*D^*A^-}^%$^!8^'Z^42^%J^+a^;K^)j^:p^\"e^!! ",
      "encoded_base64": "XipRXiFPXiFIXiEwXixYXiElXidSXiMjXilaXidjXihwXipEXipBXi19XiUkXiE4XidaXjQyXiVKXithXjtLXilqXjpwXiJlXiEhIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_ec66ab731d13",
      "text": "狼狽不堪。",
      "encoded_ascii": "^21^=Y^!)^6O^!\"",
      "encoded_base64": "XjIxXj1ZXiEpXjZPXiEi",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_573089faec2c",
      "text": "我聽說有些逃奴四處亂竄，企圖煽動一場針對德拉吉的叛亂。 ",
      "encoded_ascii": "^$%^-X^-x^$s^!8^(p^##^\"[^(,^!3^7c^*A^4-^\"b^7a^\"%^!%^\"n^)-^#:^#j^$6^\"D^&Z^.Z^!3^!\" ",
      "encoded_base64": "XiQlXi1YXi14XiRzXiE4XihwXiMjXiJbXigsXiEzXjdjXipBXjQtXiJiXjdhXiIlXiElXiJuXiktXiM6XiNqXiQ2XiJEXiZaXi5aXiEzXiEiIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_5b5e9c5c28bd",
      "text": "那當然是毫無希望的，但我忍不住想為他們的努力喝采。 ",
      "encoded_ascii": "^)!^&N^&\"^,X^/t^%}^+{^,]^&Z^*A^!I^$%^1y^!)^*z^,1^%{^!@^*{^&Z^1$^!~^6M^>d^!\" ",
      "encoded_base64": "XikhXiZOXiYiXixYXi90XiV9Xit7XixdXiZaXipBXiFJXiQlXjF5XiEpXip6XiwxXiV7XiFAXip7XiZaXjEkXiF+XjZNXj5kXiEiIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_5dbafcc9ad9e",
      "text": "這種事情總能讓生活變得更有意思些。",
      "encoded_ascii": "^(s^'$^*r^,0^-M^'b^-}^&F^%i^(U^#e^$o^$s^#z^#q^!8^!\"",
      "encoded_base64": "XihzXickXipyXiwwXi1NXidiXi19XiZGXiVpXihVXiNlXiRvXiRzXiN6XiNxXiE4XiEi",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_faaa0c0cf749",
      "text": "到處都在談論德拉吉。軍隊正開進沙漠， ",
      "encoded_ascii": "^!u^(,^)$^\"d^0;^1\\^#j^$6^\"D^!\"^..^)U^%H^)F^(w^%]^,}^*A ",
      "encoded_base64": "XiF1XigsXikkXiJkXjA7XjFcXiNqXiQ2XiJEXiEiXi4uXilVXiVIXilGXih3XiVdXix9XipBIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_024be4df71b9",
      "text": "數量多得難以計數。 ",
      "encoded_ascii": "^$V^)*^\"x^#e^)a^!B^-n^$V^!\" ",
      "encoded_base64": "XiRWXikqXiJ4XiNlXilhXiFCXi1uXiRWXiEiIA==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_eee7b6e75647",
      "text": "據說，一支由逃奴組成的軍隊正在擺出抵抗的姿態， ",
      "encoded_ascii": "^5T^-x^*A^!%^$L^&I^(p^##^2;^$$^&Z^..^)U^%H^\"d^1@^!q^$5^$4^&Z^<Q^#|^*A ",
      "encoded_base64": "XjVUXi14XipBXiElXiRMXiZJXihwXiMjXjI7XiQkXiZaXi4uXilVXiVIXiJkXjFAXiFxXiQ1XiQ0XiZaXjxRXiN8XipBIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_4431da968d72",
      "text": "但他們到底指望能成什麼事，我可就想不透了。",
      "encoded_ascii": "^!I^!@^*{^!u^/^^$8^,]^'b^$$^!=^.T^*r^*A^$%^\"A^*J^,1^!)^(q^*D^!\"",
      "encoded_base64": "XiFJXiFAXip7XiF1Xi9eXiQ4XixdXidiXiQkXiE9Xi5UXipyXipBXiQlXiJBXipKXiwxXiEpXihxXipEXiEi",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_a1cad414ecb6",
      "text": "我真同情任何擋在他們去路上的人。",
      "encoded_ascii": "^$%^-2^\"E^,0^!C^!L^$G^\"d^!@^*{^\"6^(a^!'^&Z^!<^!\"",
      "encoded_base64": "XiQlXi0yXiJFXiwwXiFDXiFMXiRHXiJkXiFAXip7XiI2XihhXiEnXiZaXiE8XiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_d9433515ba8c",
      "text": "太好了！你們這次給我帶來了什麼？",
      "encoded_ascii": "^+f^+i^*D^*W^*F^*{^(s^%D^'A^$%^#N^!O^*D^!=^.T^.V",
      "encoded_base64": "XitmXitpXipEXipXXipGXip7XihzXiVEXidBXiQlXiNOXiFPXipEXiE9Xi5UXi5W",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_48d40d75f3bc",
      "text": "  沙嚎獸之眼。",
      "encoded_ascii": "  ^%]^\"Y^&<^!/^&d^!\"",
      "encoded_base64": "ICBeJV1eIlleJjxeIS9eJmReISI=",
      "byte_length": 20
    },
    {
      "unit_id": "DLG_1a606d33dce6",
      "text": "  火鰻之舌。",
      "encoded_ascii": "  ^%x^*1^!/^'q^!\"",
      "encoded_base64": "ICBeJXheKjFeIS9eJ3FeISI=",
      "byte_length": 17
    },
    {
      "unit_id": "DLG_d6ba66d3a03b",
      "text": "  提爾蝴蝶之翼。",
      "encoded_ascii": "  ^$A^&/^(5^(6^!/^'T^!\"",
      "encoded_base64": "ICBeJEFeJi9eKDVeKDZeIS9eJ1ReISI=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_a2592d153378",
      "text": "  尖叫甲蟲之翼。",
      "encoded_ascii": "  ^#=^+<^&J^(8^!/^'T^!\"",
      "encoded_base64": "ICBeIz1eKzxeJkpeKDheIS9eJ1ReISI=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_e474a535dfb4",
      "text": "  我現在不想賣任何東西。",
      "encoded_ascii": "  ^$%^&?^\"d^!)^,1^.$^!C^!L^,`^-l^!\"",
      "encoded_base64": "ICBeJCVeJj9eImReISleLDFeLiReIUNeIUxeLGBeLWxeISI=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_19f3b730c31f",
      "text": "沙嚎獸之眼",
      "encoded_ascii": "^%]^\"Y^&<^!/^&d",
      "encoded_base64": "XiVdXiJZXiY8XiEvXiZk",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_ba3f8299ca54",
      "text": "火鰻之舌",
      "encoded_ascii": "^%x^*1^!/^'q",
      "encoded_base64": "XiV4XioxXiEvXidx",
      "byte_length": 12
    },
    {
      "unit_id": "DLG_249000c95458",
      "text": "提爾蝴蝶之翼",
      "encoded_ascii": "^$A^&/^(5^(6^!/^'T",
      "encoded_base64": "XiRBXiYvXig1Xig2XiEvXidU",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_d66bb073f8ea",
      "text": "尖叫甲蟲之翼",
      "encoded_ascii": "^#=^+<^&J^(8^!/^'T",
      "encoded_base64": "XiM9Xis8XiZKXig4XiEvXidU",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_3b4b093facf0",
      "text": "我倒希望能有別的結果，但決定權在你們手中。",
      "encoded_ascii": "^$%^!X^+{^,]^'b^$s^*H^&Z^'@^%!^*A^!I^,o^#.^1E^\"d^*F^*{^$+^!,^!\"",
      "encoded_base64": "XiQlXiFYXit7XixdXidiXiRzXipIXiZaXidAXiUhXipBXiFJXixvXiMuXjFFXiJkXipGXip7XiQrXiEsXiEi",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_1b4b084038a8",
      "text": "我願意付給你們 ",
      "encoded_ascii": "^$%^.H^#z^*u^'A^*F^*{ ",
      "encoded_base64": "XiQlXi5IXiN6Xip1XidBXipGXip7IA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_8fd1a3ab64c2",
      "text": " 枚陶幣收購每個 ",
      "encoded_ascii": " ^$~^)R^+|^$M^63^%P^!V ",
      "encoded_base64": "IF4kfl4pUl4rfF4kTV42M14lUF4hViA=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_121c2113c608",
      "text": "。這樣你們能接受嗎？",
      "encoded_ascii": "^!\"^(s^,f^*F^*{^'b^$?^\";^+X^.V",
      "encoded_base64": "XiEiXihzXixmXipGXip7XidiXiQ/XiI7XitYXi5W",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_8f57916dbfef",
      "text": "太好了。",
      "encoded_ascii": "^+f^+i^*D^!\"",
      "encoded_base64": "XitmXitpXipEXiEi",
      "byte_length": 12
    },
    {
      "unit_id": "DLG_8c2a7547ec85",
      "text": "  不行，你得開出比這更好的價錢。",
      "encoded_ascii": "  ^!)^(;^*A^*F^#e^)F^!q^,m^(s^$o^+i^&Z^+&^.<^!\"",
      "encoded_base64": "ICBeISleKDteKkFeKkZeI2VeKUZeIXFeLG1eKHNeJG9eK2leJlpeKyZeLjxeISI=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_34007079e28a",
      "text": "  好，聽起來很公道。",
      "encoded_ascii": "  ^+i^*A^-X^.(^!O^*K^3:^(y^!\"",
      "encoded_base64": "ICBeK2leKkFeLVheLiheIU9eKkteMzpeKHleISI=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_0b5f004899a7",
      "text": "  很好，成交。",
      "encoded_ascii": "  ^*K^+i^*A^$$^0P^!\"",
      "encoded_base64": "ICBeKkteK2leKkFeJCReMFBeISI=",
      "byte_length": 20
    },
    {
      "unit_id": "DLG_7400d867318a",
      "text": "  我還是先自己留著一陣子吧。",
      "encoded_ascii": "  ^$%^.7^,X^!b^'l^#I^-+^-a^!%^)P^#(^*I^!\"",
      "encoded_base64": "ICBeJCVeLjdeLFheIWJeJ2xeI0leLSteLWFeISVeKVBeIyheKkleISI=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_fd6b0b4ff572",
      "text": "能拿到這麼高的價格你們該高興了。不過，我願意 ",
      "encoded_ascii": "^'b^,G^!u^(s^.T^*+^&Z^+&^%*^*F^*{^(M^*+^-]^*D^!\"^!)^(x^*A^$%^.H^#z ",
      "encoded_base64": "XidiXixHXiF1XihzXi5UXiorXiZaXismXiUqXipGXip7XihNXiorXi1dXipEXiEiXiEpXih4XipBXiQlXi5IXiN6IA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_8699e3975e8f",
      "text": "為這些材料多付你們百分之五十——但這完全是 ",
      "encoded_ascii": "^%{^(s^!8^$y^/n^\"x^*u^*F^*{^&Y^!s^!/^!6^*Y^*n^*n^!I^(s^#,^!h^,X ",
      "encoded_base64": "XiV7XihzXiE4XiR5Xi9uXiJ4Xip1XipGXip7XiZZXiFzXiEvXiE2XipZXipuXipuXiFJXihzXiMsXiFoXixYIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_85bd8fee667c",
      "text": "因為我看出你們很有潛力。",
      "encoded_ascii": "^\"]^%{^$%^*Q^!q^*F^*{^*K^$s^7:^!~^!\"",
      "encoded_base64": "XiJdXiV7XiQlXipRXiFxXipGXip7XipLXiRzXjc6XiF+XiEi",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_450f01e38a25",
      "text": "很抱歉，那是不可能的。價格跌落的機率就跟上漲一樣高 ",
      "encoded_ascii": "^*K^,@^,h^*A^)!^,X^!)^\"A^'b^&Z^!\"^+&^%*^:a^-`^&Z^%>^22^*J^.+^!'^7^^!%^,f^*+ ",
      "encoded_base64": "XipLXixAXixoXipBXikhXixYXiEpXiJBXidiXiZaXiEiXismXiUqXjphXi1gXiZaXiU+XjIyXipKXi4rXiEnXjdeXiElXixmXiorIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_00a40b1996e2",
      "text": "。我冒不起在這筆買賣上虧損的風險。",
      "encoded_ascii": "^!\"^$%^/P^!)^.(^\"d^(s^-A^.!^.$^!'^9N^$D^&Z^)y^*m^!\"",
      "encoded_base64": "XiEiXiQlXi9QXiEpXi4oXiJkXihzXi1BXi4hXi4kXiEnXjlOXiREXiZaXil5XiptXiEi",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_cc38861306ae",
      "text": "你們可真是精明的生意人， ",
      "encoded_ascii": "^*F^*{^\"A^-2^,X^'7^$c^&Z^&F^#z^!<^*A ",
      "encoded_base64": "XipGXip7XiJBXi0yXixYXic3XiRjXiZaXiZGXiN6XiE8XipBIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_f2c8c612165c",
      "text": "！但願我不會因為你們而破產，不過既然說定了，那就這樣吧。",
      "encoded_ascii": "^*W^!I^.H^$%^!)^$r^\"]^%{^*F^*{^'W^&n^&G^*A^!)^(x^,U^&\"^-x^#.^*D^*A^)!^*J^(s^,f^*I^!\"",
      "encoded_base64": "XipXXiFJXi5IXiQlXiEpXiRyXiJdXiV7XipGXip7XidXXiZuXiZHXipBXiEpXih4XixVXiYiXi14XiMuXipEXipBXikhXipKXihzXixmXipJXiEi",
      "byte_length": 84
    },
    {
      "unit_id": "DLG_689971f661b3",
      "text": "太好了。我相信我們的合作將會長久且獲利豐厚。",
      "encoded_ascii": "^+f^+i^*D^!\"^$%^&a^!U^$%^*{^&Z^\"C^!M^#7^$r^)C^!.^!*^&:^!t^4!^\"4^!\"",
      "encoded_base64": "XitmXitpXipEXiEiXiQlXiZhXiFVXiQlXip7XiZaXiJDXiFNXiM3XiRyXilDXiEuXiEqXiY6XiF0XjQhXiI0XiEi",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_9dce29bb087a",
      "text": "我開不出更好的條件了。我從你們手裡買的是原料， ",
      "encoded_ascii": "^$%^)F^!)^!q^$o^+i^&Z^%.^.W^*D^!\"^$%^#f^*F^*{^$+^-j^.!^&Z^,X^\"5^/n^*A ",
      "encoded_base64": "XiQlXilGXiEpXiFxXiRvXitpXiZaXiUuXi5XXipEXiEiXiQlXiNmXipGXip7XiQrXi1qXi4hXiZaXixYXiI1Xi9uXipBIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_a4cd085e409e",
      "text": "而提純淨化的過程往往造價昂貴。而且，新鮮度也很關鍵。",
      "encoded_ascii": "^'W^$A^3\"^0k^\")^&Z^(x^'#^,)^,)^(v^+&^;h^2F^!\"^'W^!*^*A^$\\^35^#V^!1^*K^.>^9x^!\"",
      "encoded_base64": "XidXXiRBXjMiXjBrXiIpXiZaXih4XicjXiwpXiwpXih2XismXjtoXjJGXiEiXidXXiEqXipBXiRcXjM1XiNWXiExXipLXi4+Xjl4XiEi",
      "byte_length": 78
    },
    {
      "unit_id": "DLG_df721f939922",
      "text": " 這是給你們的 ",
      "encoded_ascii": " ^(s^,X^'A^*F^*{^&Z ",
      "encoded_base64": "IF4oc14sWF4nQV4qRl4qe14mWiA=",
      "byte_length": 20
    },
    {
      "unit_id": "DLG_5b8714c45813",
      "text": " ，用來收購你們的 ",
      "encoded_ascii": " ^*A^&H^!O^$M^63^*F^*{^&Z ",
      "encoded_base64": "IF4qQV4mSF4hT14kTV42M14qRl4qe14mWiA=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_111f8fe9c1bf",
      "text": "需求並不多——目前的生意相當冷清。不過我始終都需要 ",
      "encoded_ascii": "^)e^,n^!+^!)^\"x^*n^*n^&^^!z^&Z^&F^#z^&a^&N^!n^,u^!\"^!)^(x^$%^+k^-H^)$^)e^(C ",
      "encoded_base64": "XillXixuXiErXiEpXiJ4XipuXipuXiZeXiF6XiZaXiZGXiN6XiZhXiZOXiFuXix1XiEiXiEpXih4XiQlXitrXi1IXikkXillXihDIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_65134d10e7af",
      "text": " 及其 ",
      "encoded_ascii": " ^\"7^!j ",
      "encoded_base64": "IF4iN14haiA=",
      "byte_length": 8
    },
    {
      "unit_id": "DLG_dce97e4e3c54",
      "text": "沒錯， ",
      "encoded_ascii": "^%\\^)5^*A ",
      "encoded_base64": "XiVcXik1XipBIA==",
      "byte_length": 10
    },
    {
      "unit_id": "DLG_f4800367bcb0",
      "text": "我仍在尋找 ",
      "encoded_ascii": "^$%^!?^\"d^#9^$/ ",
      "encoded_base64": "XiQlXiE/XiJkXiM5XiQvIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_bf4b81bd4d15",
      "text": "。我也需要 ",
      "encoded_ascii": "^!\"^$%^!1^)e^(C ",
      "encoded_base64": "XiEiXiQlXiExXillXihDIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_09bd124cd263",
      "text": "我現在需要的是",
      "encoded_ascii": "^$%^&?^\"d^)e^(C^&Z^,X",
      "encoded_base64": "XiQlXiY/XiJkXillXihDXiZaXixY",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_0b8c7de56072",
      "text": "，以及 ",
      "encoded_ascii": "^*A^!B^\"7 ",
      "encoded_base64": "XipBXiFCXiI3IA==",
      "byte_length": 10
    },
    {
      "unit_id": "DLG_ea4db3ea7617",
      "text": "。如果在你們的漫遊中碰巧遇見，我會出高價收購這些 ",
      "encoded_ascii": "^!\"^#$^%!^\"d^*F^*{^&Z^2,^.3^!,^-5^3D^.2^-m^*A^$%^$r^!q^*+^+&^$M^63^(s^!8 ",
      "encoded_base64": "XiEiXiMkXiUhXiJkXipGXip7XiZaXjIsXi4zXiEsXi01XjNEXi4yXi1tXipBXiQlXiRyXiFxXiorXismXiRNXjYzXihzXiE4IA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_b045d461c7c0",
      "text": "施法材料。",
      "encoded_ascii": "^$_^%b^$y^/n^!\"",
      "encoded_base64": "XiRfXiViXiR5Xi9uXiEi",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_eb7a6f7b8879",
      "text": "  關於那些甲蟲你了解多少？",
      "encoded_ascii": "  ^.>^$^^)!^!8^&J^(8^*F^*D^(I^\"x^#<^.V",
      "encoded_base64": "ICBeLj5eJF5eKSFeITheJkpeKDheKkZeKkReKEleInheIzxeLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_6d641f46b776",
      "text": "  那些蝴蝶長什麼樣子？",
      "encoded_ascii": "  ^)!^!8^(5^(6^)C^!=^.T^,f^#(^.V",
      "encoded_base64": "ICBeKSFeITheKDVeKDZeKUNeIT1eLlReLGZeIyheLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_dd00a23d3429",
      "text": "  我要如何弄到沙嚎獸之眼？",
      "encoded_ascii": "  ^$%^(C^#$^!L^/`^!u^%]^\"Y^&<^!/^&d^.V",
      "encoded_base64": "ICBeJCVeKENeIyReIUxeL2BeIXVeJV1eIlleJjxeIS9eJmReLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_92b05f570175",
      "text": "  我在哪裡能找到火鰻之舌？",
      "encoded_ascii": "  ^$%^\"d^+I^-j^'b^$/^!u^%x^*1^!/^'q^.V",
      "encoded_base64": "ICBeJCVeImReK0leLWpeJ2JeJC9eIXVeJXheKjFeIS9eJ3FeLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_912089306aa6",
      "text": "  你會付多少錢收購它們？",
      "encoded_ascii": "  ^*F^$r^*u^\"x^#<^.<^$M^63^+o^*{^.V",
      "encoded_base64": "ICBeKkZeJHJeKnVeInheIzxeLjxeJE1eNjNeK29eKnteLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_5b58763b0f4c",
      "text": "  我會去看看能做些什麼。",
      "encoded_ascii": "  ^$%^$r^\"6^*Q^*Q^'b^*~^!8^!=^.T^!\"",
      "encoded_base64": "ICBeJCVeJHJeIjZeKlFeKlFeJ2JeKn5eITheIT1eLlReISI=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_73b39c80b6bb",
      "text": "哼，牠們可不會乖乖奉上！你會看見沙嚎獸在 ",
      "encoded_ascii": "^+K^*A^-#^*{^\"A^!)^$r^0{^0{^1+^!'^*W^*F^$r^*Q^-m^%]^\"Y^&<^\"d ",
      "encoded_base64": "XitLXipBXi0jXip7XiJBXiEpXiRyXjB7XjB7XjErXiEnXipXXipGXiRyXipRXi1tXiVdXiJZXiY8XiJkIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_7641dff73d47",
      "text": "沙質廢土上潛伏潛行；千萬避開那畜生的凝視，否則它會把你麻痺。",
      "encoded_ascii": "^%]^(Z^#W^\"c^!'^7:^3c^7:^(;^*C^+7^-_^0F^)F^)!^5f^&F^&Z^!o^(E^*A^\"H^!x^+o^$r^$1^*F^*6^&S^!\"",
      "encoded_base64": "XiVdXihaXiNXXiJjXiEnXjc6XjNjXjc6Xig7XipDXis3Xi1fXjBGXilGXikhXjVmXiZGXiZaXiFvXihFXipBXiJIXiF4XitvXiRyXiQxXipGXio2XiZTXiEi",
      "byte_length": 90
    },
    {
      "unit_id": "DLG_673289c9e2bf",
      "text": "火鰻是會鑽沙的生物，所以走路要當心。此處以北是 ",
      "encoded_ascii": "^%x^*1^,X^$r^7L^%]^&Z^&F^&4^*A^$)^!B^.&^(a^(C^&N^#k^!\"^%I^(,^!B^+6^,X ",
      "encoded_base64": "XiV4XioxXixYXiRyXjdMXiVdXiZaXiZGXiY0XipBXiQpXiFCXi4mXihhXihDXiZOXiNrXiEiXiVJXigsXiFCXis2XixYIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_fa102c19616a",
      "text": "你最容易找到牠們的地方。",
      "encoded_ascii": "^*F^$q^+t^,W^$/^!u^-#^*{^&Z^\"e^$]^!\"",
      "encoded_base64": "XipGXiRxXit0XixXXiQvXiF1Xi0jXip7XiZaXiJlXiRdXiEi",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_c78ed14b22a0",
      "text": "牠們是相當引人注目的生物——鮮豔的紅色與橙色，帶有褐色的 ",
      "encoded_ascii": "^-#^*{^,X^&a^&N^#Z^!<^%e^&^^&Z^&F^&4^*n^*n^35^>c^&Z^3!^'s^'p^%=^'s^*A^#N^$s^>b^'s^&Z ",
      "encoded_base64": "Xi0jXip7XixYXiZhXiZOXiNaXiE8XiVlXiZeXiZaXiZGXiY0XipuXipuXjM1Xj5jXiZaXjMhXidzXidwXiU9XidzXipBXiNOXiRzXj5iXidzXiZaIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_48ce4224b4d8",
      "text": "底翅。牠們只能棲息在水源附近，因此綠洲是你 ",
      "encoded_ascii": "^/^^95^!\"^-#^*{^\"?^'b^,b^#w^\"d^%V^%q^.?^(l^*A^\"]^%I^3V^76^,X^*F ",
      "encoded_base64": "Xi9eXjk1XiEiXi0jXip7XiI/XidiXixiXiN3XiJkXiVWXiVxXi4/XihsXipBXiJdXiVJXjNWXjc2XixYXipGIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_68df1d292d26",
      "text": "尋找提爾蝴蝶的最佳去處。",
      "encoded_ascii": "^#9^$/^$A^&/^(5^(6^&Z^$q^7P^\"6^(,^!\"",
      "encoded_base64": "XiM5XiQvXiRBXiYvXig1Xig2XiZaXiRxXjdQXiI2XigsXiEi",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_5d443c386ea1",
      "text": "尖叫甲蟲偏好岩石縫隙與陰暗處，不過你在任何地方 ",
      "encoded_ascii": "^#=^+<^&J^(8^![^+i^#D^&k^>^^8v^'p^6B^$k^(,^*A^!)^(x^*F^\"d^!C^!L^\"e^$] ",
      "encoded_base64": "XiM9Xis8XiZKXig4XiFbXitpXiNEXiZrXj5eXjh2XidwXjZCXiRrXigsXipBXiEpXih4XipGXiJkXiFDXiFMXiJlXiRdIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_01e54a33eea7",
      "text": "都有可能碰上牠們。",
      "encoded_ascii": "^)$^$s^\"A^'b^-5^!'^-#^*{^!\"",
      "encoded_base64": "XikkXiRzXiJBXidiXi01XiEnXi0jXip7XiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_84165f0e3e0c",
      "text": "很高興聽你這麼說。",
      "encoded_ascii": "^*K^*+^-]^-X^*F^(s^.T^-x^!\"",
      "encoded_base64": "XipLXiorXi1dXi1YXipGXihzXi5UXi14XiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_94d57cbe40b0",
      "text": "幾隻沙嚎獸之眼",
      "encoded_ascii": "^#T^)[^%]^\"Y^&<^!/^&d",
      "encoded_base64": "XiNUXilbXiVdXiJZXiY8XiEvXiZk",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_abb83b7c4fd5",
      "text": "火鰻之舌",
      "encoded_ascii": "^%x^*1^!/^'q",
      "encoded_base64": "XiV4XioxXiEvXidx",
      "byte_length": 12
    },
    {
      "unit_id": "DLG_1c16927acfad",
      "text": "提爾蝴蝶的翅膀",
      "encoded_ascii": "^$A^&/^(5^(6^&Z^95^96",
      "encoded_base64": "XiRBXiYvXig1Xig2XiZaXjk1Xjk2",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_3bc3cf991a9a",
      "text": "一隻尖叫甲蟲之翼",
      "encoded_ascii": "^!%^)[^#=^+<^&J^(8^!/^'T",
      "encoded_base64": "XiElXilbXiM9Xis8XiZKXig4XiEvXidU",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_dec77b6f7566",
      "text": "我根據供需狀況來付酬金。一般來說，我需要的貨物價值 ",
      "encoded_ascii": "^$%^%)^5T^!P^)e^&7^,q^!O^*u^7o^)+^!\"^!%^'r^!O^-x^*A^$%^)e^(C^&Z^.w^&4^+&^!Z ",
      "encoded_base64": "XiQlXiUpXjVUXiFQXillXiY3XixxXiFPXip1XjdvXikrXiEiXiElXidyXiFPXi14XipBXiQlXillXihDXiZaXi53XiY0XismXiFaIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_84ddd1f6fb92",
      "text": "幾百枚陶幣。你們會從中分得一定比例。",
      "encoded_ascii": "^#T^&Y^$~^)R^+|^!\"^*F^*{^$r^#f^!,^!s^#e^!%^#.^,m^9h^!\"",
      "encoded_base64": "XiNUXiZZXiR+XilSXit8XiEiXipGXip7XiRyXiNmXiEsXiFzXiNlXiElXiMuXixtXjloXiEi",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_3fa52aafe3fd",
      "text": "至於蝴蝶之翼，我願意出 ",
      "encoded_ascii": "^'n^$^^(5^(6^!/^'T^*A^$%^.H^#z^!q ",
      "encoded_base64": "XiduXiReXig1Xig2XiEvXidUXipBXiQlXi5IXiN6XiFxIA==",
      "byte_length": 34
    },
    {
      "unit_id": "DLG_e05d0a67e318",
      "text": "450",
      "encoded_ascii": "450",
      "encoded_base64": "NDUw",
      "byte_length": 3
    },
    {
      "unit_id": "DLG_f7f4742c0b38",
      "text": "300",
      "encoded_ascii": "300",
      "encoded_base64": "MzAw",
      "byte_length": 3
    },
    {
      "unit_id": "DLG_3e729983cd78",
      "text": " 枚陶幣收購每一枚。",
      "encoded_ascii": " ^$~^)R^+|^$M^63^%P^!%^$~^!\"",
      "encoded_base64": "IF4kfl4pUl4rfF4kTV42M14lUF4hJV4kfl4hIg==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_35b4b6dfb8da",
      "text": "那當然要看你們帶回什麼東西。我可以告訴你們， ",
      "encoded_ascii": "^)!^&N^&\"^(C^*Q^*F^*{^#N^\"\\^!=^.T^,`^-l^!\"^$%^\"A^!B^+B^-t^*F^*{^*A ",
      "encoded_base64": "XikhXiZOXiYiXihDXipRXipGXip7XiNOXiJcXiE9Xi5UXixgXi1sXiEiXiQlXiJBXiFCXitCXi10XipGXip7XipBIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_97b11515b625",
      "text": "目前的行情非常看好。每個人都在爭相搶購 ",
      "encoded_ascii": "^&^^!z^&Z^(;^,0^)i^#O^*Q^+i^!\"^%P^!V^!<^)$^\"d^1I^&a^1?^63 ",
      "encoded_base64": "XiZeXiF6XiZaXig7XiwwXilpXiNPXipRXitpXiEiXiVQXiFWXiE8XikkXiJkXjFJXiZhXjE/XjYzIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_27e2da9a3274",
      "text": "施法材料。你們會拿到公道的價錢。",
      "encoded_ascii": "^$_^%b^$y^/n^!\"^*F^*{^$r^,G^!u^3:^(y^&Z^+&^.<^!\"",
      "encoded_base64": "XiRfXiViXiR5Xi9uXiEiXipGXip7XiRyXixHXiF1XjM6Xih5XiZaXismXi48XiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_d07eec2402d8",
      "text": "尖叫甲蟲之翼算不上最稀有的材料，但你們一直 ",
      "encoded_ascii": "^#=^+<^&J^(8^!/^'T^-C^!)^!'^$q^3w^$s^&Z^$y^/n^*A^!I^*F^*{^!%^&` ",
      "encoded_base64": "XiM9Xis8XiZKXig4XiEvXidUXi1DXiEpXiEnXiRxXjN3XiRzXiZaXiR5Xi9uXipBXiFJXipGXip7XiElXiZgIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_b34d194235e9",
      "text": "是我如此得力的助手，我願意給你們最頂格的價格—— ",
      "encoded_ascii": "^,X^$%^#$^%I^#e^!~^&Z^\"#^$+^*A^$%^.H^#z^'A^*F^*{^$q^)p^%*^&Z^+&^%*^*n^*n ",
      "encoded_base64": "XixYXiQlXiMkXiVJXiNlXiF+XiZaXiIjXiQrXipBXiQlXi5IXiN6XidBXipGXip7XiRxXilwXiUqXiZaXismXiUqXipuXipuIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_4910110f26d2",
      "text": "比方說 ",
      "encoded_ascii": "^,m^$]^-x ",
      "encoded_base64": "XixtXiRdXi14IA==",
      "byte_length": 10
    },
    {
      "unit_id": "DLG_a4783ecff733",
      "text": "150",
      "encoded_ascii": "150",
      "encoded_base64": "MTUw",
      "byte_length": 3
    },
    {
      "unit_id": "DLG_8842cdd91891",
      "text": "100",
      "encoded_ascii": "100",
      "encoded_base64": "MTAw",
      "byte_length": 3
    },
    {
      "unit_id": "DLG_571212011189",
      "text": " 枚陶幣一個。",
      "encoded_ascii": " ^$~^)R^+|^!%^!V^!\"",
      "encoded_base64": "IF4kfl4pUl4rfF4hJV4hVl4hIg==",
      "byte_length": 19
    },
    {
      "unit_id": "DLG_32872ab9cfb5",
      "text": "我自由了！塔拉死了，我終於可以離開這座迷宮了！謝謝你們！",
      "encoded_ascii": "^$%^'l^&I^*D^*W^\"o^$6^%L^*D^*A^$%^-H^$^^\"A^!B^)`^)F^(s^/_^(n^/\\^*D^*W^-z^-z^*F^*{^*W",
      "encoded_base64": "XiQlXidsXiZJXipEXipXXiJvXiQ2XiVMXipEXipBXiQlXi1IXiReXiJBXiFCXilgXilGXihzXi9fXihuXi9cXipEXipXXi16Xi16XipGXip7XipX",
      "byte_length": 84
    },
    {
      "unit_id": "DLG_614911e108e3",
      "text": "求求你們，離我遠點。如果身邊沒有任何人…… ",
      "encoded_ascii": "^,n^,n^*F^*{^*A^)`^$%^({^*;^!\"^#$^%!^(c^.8^%\\^$s^!C^!L^!<^*o^*o ",
      "encoded_base64": "XixuXixuXipGXip7XipBXilgXiQlXih7Xio7XiEiXiMkXiUhXihjXi44XiVcXiRzXiFDXiFMXiE8XipvXipvIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_ffe950124db9",
      "text": "給我虛假的希望，我的痛苦或許還更容易忍受些。",
      "encoded_ascii": "^'A^$%^-g^1i^&Z^+{^,]^*A^$%^&Z^-.^.t^$'^-s^.7^$o^+t^,W^1y^\";^!8^!\"",
      "encoded_base64": "XidBXiQlXi1nXjFpXiZaXit7XixdXipBXiQlXiZaXi0uXi50XiQnXi1zXi43XiRvXit0XixXXjF5XiI7XiE4XiEi",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_57288fec4311",
      "text": "你們說過會帶我離開這裡的！",
      "encoded_ascii": "^*F^*{^-x^(x^$r^#N^$%^)`^)F^(s^-j^&Z^*W",
      "encoded_base64": "XipGXip7Xi14Xih4XiRyXiNOXiQlXilgXilGXihzXi1qXiZaXipX",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_05367b0cf4e7",
      "text": "是的，我很快就能解脫詛咒了。你們回應了我的祈禱。",
      "encoded_ascii": "^,X^&Z^*A^$%^*K^*L^*J^'b^(I^'c^(L^\"P^*D^!\"^*F^*{^\"\\^0`^*D^$%^&Z^&u^&|^!\"",
      "encoded_base64": "XixYXiZaXipBXiQlXipLXipMXipKXidiXihJXidjXihMXiJQXipEXiEiXipGXip7XiJcXjBgXipEXiQlXiZaXiZ1XiZ8XiEi",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_a65623593cb8",
      "text": "  我改變主意了。現在，滾開。",
      "encoded_ascii": "  ^$%^$N^(U^!-^#z^*D^!\"^&?^\"d^*A^,z^)F^!\"",
      "encoded_base64": "ICBeJCVeJE5eKFVeIS1eI3peKkReISJeJj9eImReKkFeLHpeKUZeISI=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_c549fc572504",
      "text": "  很高興我能幫上忙。",
      "encoded_ascii": "  ^*K^*+^-]^$%^'b^+}^!'^,+^!\"",
      "encoded_base64": "ICBeKkteKiteLV1eJCVeJ2JeK31eISdeLCteISI=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_d174ae07faa0",
      "text": "救救我！我被困在這裡太久了！帶我離開這裡，我求求你們！",
      "encoded_ascii": "^,Q^,Q^$%^*W^$%^(@^\"^^\"d^(s^-j^+f^!.^*D^*W^#N^$%^)`^)F^(s^-j^*A^$%^,n^,n^*F^*{^*W",
      "encoded_base64": "XixRXixRXiQlXipXXiQlXihAXiJeXiJkXihzXi1qXitmXiEuXipEXipXXiNOXiQlXilgXilGXihzXi1qXipBXiQlXixuXixuXipGXip7XipX",
      "byte_length": 81
    },
    {
      "unit_id": "DLG_077d06612571",
      "text": "  跟我來，我會保護你。",
      "encoded_ascii": "  ^.+^$%^!O^*A^$%^$r^!T^(T^*F^!\"",
      "encoded_base64": "ICBeLiteJCVeIU9eKkFeJCVeJHJeIVReKFReKkZeISI=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_29944388bd78",
      "text": "  滾開，你這腐爛的蛆蟲餌食！",
      "encoded_ascii": "  ^,z^)F^*A^*F^(s^0/^&-^&Z^2C^(8^.J^0J^*W",
      "encoded_base64": "ICBeLHpeKUZeKkFeKkZeKHNeMC9eJi1eJlpeMkNeKDheLkpeMEpeKlc=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_dce62ccb47b8",
      "text": "噢，謝謝你們！我已經太久沒有見過太陽了。 ",
      "encoded_ascii": "^+]^*A^-z^-z^*F^*{^*W^$%^#J^'D^+f^!.^%\\^$s^-m^(x^+f^.@^*D^!\" ",
      "encoded_base64": "XitdXipBXi16Xi16XipGXip7XipXXiQlXiNKXidEXitmXiEuXiVcXiRzXi1tXih4XitmXi5AXipEXiEiIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_88fea9b4910f",
      "text": "陽光那熾熱的光芒，或許強大到足以燒盡…… ",
      "encoded_ascii": "^.@^!c^)!^20^&$^&Z^!c^'u^*A^$'^-s^#]^\"z^!u^(^^!B^&&^-1^*o^*o ",
      "encoded_base64": "Xi5AXiFjXikhXjIwXiYkXiZaXiFjXid1XipBXiQnXi1zXiNdXiJ6XiF1XiheXiFCXiYmXi0xXipvXipvIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_f71f5ba0e948",
      "text": "附著在我身上的詛咒。終於，我能得以安息了。",
      "encoded_ascii": "^.?^-a^\"d^$%^(c^!'^&Z^(L^\"P^!\"^-H^$^^*A^$%^'b^#e^!B^+p^#w^*D^!\"",
      "encoded_base64": "Xi4/Xi1hXiJkXiQlXihjXiEnXiZaXihMXiJQXiEiXi1IXiReXipBXiQlXidiXiNlXiFCXitwXiN3XipEXiEi",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_44d827e22480",
      "text": "我知道我的模樣醜陋可怖，但過去並非一直如此。全是因為…… ",
      "encoded_ascii": "^$%^&h^(y^$%^&Z^%:^,f^2O^2P^\"A^#p^*A^!I^(x^\"6^!+^)i^!%^&`^#$^%I^!\"^!h^,X^\"]^%{^*o^*o ",
      "encoded_base64": "XiQlXiZoXih5XiQlXiZaXiU6XixmXjJPXjJQXiJBXiNwXipBXiFJXih4XiI2XiErXilpXiElXiZgXiMkXiVJXiEiXiFoXixYXiJdXiV7XipvXipvIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_bee3586b5d91",
      "text": "這道詛咒，不讓我死去，卻任由我的身軀不斷潰爛。求求你們…… ",
      "encoded_ascii": "^(s^(y^(L^\"P^*A^!)^-}^$%^%L^\"6^*A^1&^!C^&I^$%^&Z^(c^(d^!)^,T^2-^&-^!\"^,n^,n^*F^*{^*o^*o ",
      "encoded_base64": "XihzXih5XihMXiJQXipBXiEpXi19XiQlXiVMXiI2XipBXjEmXiFDXiZJXiQlXiZaXihjXihkXiEpXixUXjItXiYtXiEiXixuXixuXipGXip7XipvXipvIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_547207bada8d",
      "text": "難道不能憐憫我，帶我一起離開嗎？",
      "encoded_ascii": "^)a^(y^!)^'b^1}^1~^$%^*A^#N^$%^!%^.(^)`^)F^+X^.V",
      "encoded_base64": "XilhXih5XiEpXidiXjF9XjF+XiQlXipBXiNOXiQlXiElXi4oXilgXilGXitYXi5W",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_2ff4a0e28459",
      "text": "如果我腐爛屍體的惡臭冒犯了你們，我很抱歉。我會盡力…… ",
      "encoded_ascii": "^#$^%!^$%^0/^&-^#?^**^&Z^#y^'m^/P^-%^*D^*F^*{^*A^$%^*K^,@^,h^!\"^$%^$r^-1^!~^*o^*o ",
      "encoded_base64": "XiMkXiUhXiQlXjAvXiYtXiM/XioqXiZaXiN5XidtXi9QXi0lXipEXipGXip7XipBXiQlXipLXixAXixoXiEiXiQlXiRyXi0xXiF+XipvXipvIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_1a57003935e0",
      "text": "跟你們保持距離。",
      "encoded_ascii": "^.+^*F^*{^!T^$7^2I^)`^!\"",
      "encoded_base64": "Xi4rXipGXip7XiFUXiQ3XjJJXilgXiEi",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_8a4e18c7f8a2",
      "text": "你真是一個高貴崇高的靈魂。",
      "encoded_ascii": "^*F^-2^,X^!%^!V^*+^2F^13^*+^&Z^)g^*.^!\"",
      "encoded_base64": "XipGXi0yXixYXiElXiFWXiorXjJGXjEzXiorXiZaXilnXiouXiEi",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_cf0d7d47b537",
      "text": "永遠都是這樣！每個人都只會讓我們受苦！",
      "encoded_ascii": "^%W^({^)$^,X^(s^,f^*W^%P^!V^!<^)$^\"?^$r^-}^$%^*{^\";^.t^*W",
      "encoded_base64": "XiVXXih7XikkXixYXihzXixmXipXXiVQXiFWXiE8XikkXiI/XiRyXi19XiQlXip7XiI7Xi50XipX",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_5d899e59f402",
      "text": "殺了塔拉！把我從詛咒中解救出來！",
      "encoded_ascii": "^%M^*D^\"o^$6^*W^$1^$%^#f^(L^\"P^!,^(I^,Q^!q^!O^*W",
      "encoded_base64": "XiVNXipEXiJvXiQ2XipXXiQxXiQlXiNmXihMXiJQXiEsXihJXixRXiFxXiFPXipX",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_5e5fb936ebfe",
      "text": "謝謝你們終結了這場詛咒！你們今日的英勇之舉贏得了…… ",
      "encoded_ascii": "^-z^-z^*F^*{^-H^'@^*D^(s^\"n^(L^\"P^*W^*F^*{^*E^$a^&Z^'y^\"$^!/^01^.%^#e^*D^*o^*o ",
      "encoded_base64": "Xi16Xi16XipGXip7Xi1IXidAXipEXihzXiJuXihMXiJQXipXXipGXip7XipFXiRhXiZaXid5XiIkXiEvXjAxXi4lXiNlXipEXipvXipvIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_d4cecda47983",
      "text": "內在之眼的感激。願你們往後的每一次冒險都能如此成功！",
      "encoded_ascii": "^!g^\"d^!/^&d^&Z^#{^1H^!\"^.H^*F^*{^,)^#b^&Z^%P^!%^%D^/P^*m^)$^'b^#$^%I^$$^\"!^*W",
      "encoded_base64": "XiFnXiJkXiEvXiZkXiZaXiN7XjFIXiEiXi5IXipGXip7XiwpXiNiXiZaXiVQXiElXiVEXi9QXiptXikkXidiXiMkXiVJXiQkXiIhXipX",
      "byte_length": 78
    },
    {
      "unit_id": "DLG_125da3bd2353",
      "text": " 只要你們能像消滅塔拉那樣摧毀那些符印…… ",
      "encoded_ascii": " ^\"?^(C^*F^*{^'b^!`^%k^%t^\"o^$6^)!^,f^$E^%N^)!^!8^'+^1%^*o^*o ",
      "encoded_base64": "IF4iP14oQ14qRl4qe14nYl4hYF4la14ldF4ib14kNl4pIV4sZl4kRV4lTl4pIV4hOF4nK14xJV4qb14qbyA=",
      "byte_length": 62
    },
    {
      "unit_id": "DLG_7296fca04079",
      "text": "我們就能離開了。",
      "encoded_ascii": "^$%^*{^*J^'b^)`^)F^*D^!\"",
      "encoded_base64": "XiQlXip7XipKXidiXilgXilGXipEXiEi",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_43b1b934f15b",
      "text": "叛徒！你是納吉的爪牙！我這雙眼睛還看得清他那…… ",
      "encoded_ascii": "^.Z^#d^*W^*F^,X^';^\"D^&Z^&.^&3^*W^$%^(s^)_^&d^&f^.7^*Q^#e^,u^!@^)!^*o^*o ",
      "encoded_base64": "Xi5aXiNkXipXXipGXixYXic7XiJEXiZaXiYuXiYzXipXXiQlXihzXilfXiZkXiZmXi43XipRXiNlXix1XiFAXikhXipvXipvIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_d03f7636440a",
      "text": "該死的邪惡護符！我要讓你們嚐嚐你們主人的詛咒究竟幹了什麼好事！",
      "encoded_ascii": "^(M^%L^&Z^)\"^#y^(T^'+^*W^$%^(C^-}^*F^*{^1q^1q^*F^*{^!-^!<^&Z^(L^\"P^-<^28^,!^*D^!=^.T^+i^*r^*W",
      "encoded_base64": "XihNXiVMXiZaXikiXiN5XihUXicrXipXXiQlXihDXi19XipGXip7XjFxXjFxXipGXip7XiEtXiE8XiZaXihMXiJQXi08XjI4XiwhXipEXiE9Xi5UXitpXipyXipX",
      "byte_length": 93
    },
    {
      "unit_id": "DLG_e39fd8e60ae5",
      "text": "救救我們！將我們從納吉的詛咒中解脫出來！他判處了塔拉和我…… ",
      "encoded_ascii": "^,Q^,Q^$%^*{^*W^#7^$%^*{^#f^';^\"D^&Z^(L^\"P^!,^(I^'c^!q^!O^*W^!@^1k^(,^*D^\"o^$6^\"O^$%^*o^*o ",
      "encoded_base64": "XixRXixRXiQlXip7XipXXiM3XiQlXip7XiNmXic7XiJEXiZaXihMXiJQXiEsXihJXidjXiFxXiFPXipXXiFAXjFrXigsXipEXiJvXiQ2XiJPXiQlXipvXipvIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_f94bbf679b37",
      "text": "獲得永生！已經過去太多漫長歲月了……我再也無法忍受…… ",
      "encoded_ascii": "^&:^#e^%W^&F^*W^#J^'D^(x^\"6^+f^\"x^2,^)C^,j^/p^*D^*o^*o^$%^!l^!1^%}^%b^1y^\";^*o^*o ",
      "encoded_base64": "XiY6XiNlXiVXXiZGXipXXiNKXidEXih4XiI2XitmXiJ4XjIsXilDXixqXi9wXipEXipvXipvXiQlXiFsXiExXiV9XiViXjF5XiI7XipvXipvIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_ca23bd6685f7",
      "text": "這無盡無休的折磨了！",
      "encoded_ascii": "^(s^%}^-1^%}^!G^&Z^,?^-7^*D^*W",
      "encoded_base64": "XihzXiV9Xi0xXiV9XiFHXiZaXiw/Xi03XipEXipX",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_7fef61b13fae",
      "text": "  我該如何幫助你？",
      "encoded_ascii": "  ^$%^(M^#$^!L^+}^\"#^*F^.V",
      "encoded_base64": "ICBeJCVeKE1eIyReIUxeK31eIiNeKkZeLlY=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_b2d3f9c1c5d1",
      "text": "  跟我說說塔拉的事。",
      "encoded_ascii": "  ^.+^$%^-x^-x^\"o^$6^&Z^*r^!\"",
      "encoded_base64": "ICBeLiteJCVeLXheLXheIm9eJDZeJlpeKnJeISI=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_23e86b4190b2",
      "text": "  我該如何殺死塔拉？",
      "encoded_ascii": "  ^$%^(M^#$^!L^%M^%L^\"o^$6^.V",
      "encoded_base64": "ICBeJCVeKE1eIyReIUxeJU1eJUxeIm9eJDZeLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_3e9234a12c1e",
      "text": "  那個德魯伊是誰？",
      "encoded_ascii": "  ^)!^!V^#j^/K^!E^,X^-y^.V",
      "encoded_base64": "ICBeKSFeIVZeI2peL0teIUVeLFheLXleLlY=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_0ff3a9a7e62f",
      "text": "  跟我說說這道詛咒的事。",
      "encoded_ascii": "  ^.+^$%^-x^-x^(s^(y^(L^\"P^&Z^*r^!\"",
      "encoded_base64": "ICBeLiteJCVeLXheLXheKHNeKHleKExeIlBeJlpeKnJeISI=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_2d497588c002",
      "text": "  再見。",
      "encoded_ascii": "  ^!l^-m^!\"",
      "encoded_base64": "ICBeIWxeLW1eISI=",
      "byte_length": 11
    },
    {
      "unit_id": "DLG_b538ad6fb635",
      "text": "殺了塔拉！殺了她！殺了她！當她的生命終結時，詛咒就會…… ",
      "encoded_ascii": "^%M^*D^\"o^$6^*W^%M^*D^+h^*W^%M^*D^+h^*W^&N^+h^&Z^&F^\"N^-H^'@^$f^*A^(L^\"P^*J^$r^*o^*o ",
      "encoded_base64": "XiVNXipEXiJvXiQ2XipXXiVNXipEXitoXipXXiVNXipEXitoXipXXiZOXitoXiZaXiZGXiJOXi1IXidAXiRmXipBXihMXiJQXipKXiRyXipvXipvIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_21566bf993b3",
      "text": "被破除，我也終於能死去了！安息……平靜……殺了塔拉！",
      "encoded_ascii": "^(@^&n^)Q^*A^$%^!1^-H^$^^'b^%L^\"6^*D^*W^+p^#w^*o^*o^0Y^)h^*o^*o^%M^*D^\"o^$6^*W",
      "encoded_base64": "XihAXiZuXilRXipBXiQlXiExXi1IXiReXidiXiVMXiI2XipEXipXXitwXiN3XipvXipvXjBZXiloXipvXipvXiVNXipEXiJvXiQ2XipX",
      "byte_length": 78
    },
    {
      "unit_id": "DLG_188a1f7438a1",
      "text": "納吉詛咒了塔拉和她的信徒獲得永世不死之身。殺了她！ ",
      "encoded_ascii": "^';^\"D^(L^\"P^*D^\"o^$6^\"O^+h^&Z^!U^#d^&:^#e^%W^*p^!)^%L^!/^(c^!\"^%M^*D^+h^*W ",
      "encoded_base64": "Xic7XiJEXihMXiJQXipEXiJvXiQ2XiJPXitoXiZaXiFVXiNkXiY6XiNlXiVXXipwXiEpXiVMXiEvXihjXiEiXiVNXipEXitoXipXIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_823f36d3bc42",
      "text": "殺了塔拉，這樣我才能安息！殺了她！我的理智早已崩潰，我的…… ",
      "encoded_ascii": "^%M^*D^\"o^$6^*A^(s^,f^$%^$,^'b^+p^#w^*W^%M^*D^+h^*W^$%^&Z^&A^$i^,V^#J^0W^2-^*A^$%^&Z^*o^*o ",
      "encoded_base64": "XiVNXipEXiJvXiQ2XipBXihzXixmXiQlXiQsXidiXitwXiN3XipXXiVNXipEXitoXipXXiQlXiZaXiZBXiRpXixWXiNKXjBXXjItXipBXiQlXiZaXipvXipvIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_4a33bf6ba53a",
      "text": "身軀也必須隨之消亡。殺了塔拉！",
      "encoded_ascii": "^(c^(d^!1^#l^)r^)X^!/^%k^!:^!\"^%M^*D^\"o^$6^*W",
      "encoded_base64": "XihjXihkXiExXiNsXilyXilYXiEvXiVrXiE6XiEiXiVNXipEXiJvXiQ2XipX",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_8e29d32c1128",
      "text": "塔拉是我們的主人，或者說在內在之眼昌盛時曾是。現在…… ",
      "encoded_ascii": "^\"o^$6^,X^$%^*{^&Z^!-^!<^*A^$'^'V^-x^\"d^!g^\"d^!/^&d^2%^1L^$f^.j^,X^!\"^&?^\"d^*o^*o ",
      "encoded_base64": "XiJvXiQ2XixYXiQlXip7XiZaXiEtXiE8XipBXiQnXidWXi14XiJkXiFnXiJkXiEvXiZkXjIlXjFMXiRmXi5qXixYXiEiXiY/XiJkXipvXipvIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_e53c528660bc",
      "text": "看見我們的模樣只會深深刺痛她對自身衰老的恐懼。她已經…… ",
      "encoded_ascii": "^*Q^-m^$%^*{^&Z^%:^,f^\"?^$r^2*^2*^!w^-.^+h^#:^'l^(c^2D^'U^&Z^#t^$#^!\"^+h^#J^'D^*o^*o ",
      "encoded_base64": "XipRXi1tXiQlXip7XiZaXiU6XixmXiI/XiRyXjIqXjIqXiF3Xi0uXitoXiM6XidsXihjXjJEXidVXiZaXiN0XiQjXiEiXitoXiNKXidEXipvXipvIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_47b98a38f92f",
      "text": "拋棄了我們。",
      "encoded_ascii": "^,A^,a^*D^$%^*{^!\"",
      "encoded_base64": "XixBXixhXipEXiQlXip7XiEi",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_0fc1bc49c27a",
      "text": "德魯伊一定知道！對，去問那個德魯伊！",
      "encoded_ascii": "^#j^/K^!E^!%^#.^&h^(y^*W^#:^*A^\"6^*Z^)!^!V^#j^/K^!E^*W",
      "encoded_base64": "XiNqXi9LXiFFXiElXiMuXiZoXih5XipXXiM6XipBXiI2XipaXikhXiFWXiNqXi9LXiFFXipX",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_a3ac32325e17",
      "text": "呼嘯之風德魯伊是來保護他的雙足飛龍的，但是…… ",
      "encoded_ascii": "^\"M^0U^!/^)y^#j^/K^!E^,X^!O^!T^(T^!@^&Z^)_^(^^)z^*>^&Z^*A^!I^,X^*o^*o ",
      "encoded_base64": "XiJNXjBVXiEvXil5XiNqXi9LXiFFXixYXiFPXiFUXihUXiFAXiZaXilfXiheXil6Xio+XiZaXipBXiFJXixYXipvXipvIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_8c3cb67ea909",
      "text": "他反而失去了牠們！他根本不是我們主人的對手……很少有人是。",
      "encoded_ascii": "^!@^\"9^'W^\"|^\"6^*D^-#^*{^*W^!@^%)^$x^!)^,X^$%^*{^!-^!<^&Z^#:^$+^*o^*o^*K^#<^$s^!<^,X^!\"",
      "encoded_base64": "XiFAXiI5XidXXiJ8XiI2XipEXi0jXip7XipXXiFAXiUpXiR4XiEpXixYXiQlXip7XiEtXiE8XiZaXiM6XiQrXipvXipvXipLXiM8XiRzXiE8XixYXiEi",
      "byte_length": 87
    },
    {
      "unit_id": "DLG_ad9f13cb75ac",
      "text": "是的，我迷失了。永遠迷失在一具腐爛潰敗的軀殼裡！",
      "encoded_ascii": "^,X^&Z^*A^$%^(n^\"|^*D^!\"^%W^({^(n^\"|^\"d^!%^!k^0/^&-^2-^$R^&Z^(d^1F^-j^*W",
      "encoded_base64": "XixYXiZaXipBXiQlXihuXiJ8XipEXiEiXiVXXih7XihuXiJ8XiJkXiElXiFrXjAvXiYtXjItXiRSXiZaXihkXjFGXi1qXipX",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_2e047d6e4cb3",
      "text": "快！塔拉就在東塔裡。去找到她。殺了她！",
      "encoded_ascii": "^*L^*W^\"o^$6^*J^\"d^,`^\"o^-j^!\"^\"6^$/^!u^+h^!\"^%M^*D^+h^*W",
      "encoded_base64": "XipMXipXXiJvXiQ2XipKXiJkXixgXiJvXi1qXiEiXiI2XiQvXiF1XitoXiEiXiVNXipEXitoXipX",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_081056d30d17",
      "text": "摧毀我的身體！把我砍成碎片！",
      "encoded_ascii": "^$E^%N^$%^&Z^(c^**^*W^$1^$%^&l^$$^&o^&1^*W",
      "encoded_base64": "XiRFXiVOXiQlXiZaXihjXioqXipXXiQxXiQlXiZsXiQkXiZvXiYxXipX",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_27c3b62c24cd",
      "text": "這一次我說不定就無法再生了。說不定我就能真正死去了！",
      "encoded_ascii": "^(s^!%^%D^$%^-x^!)^#.^*J^%}^%b^!l^&F^*D^!\"^-x^!)^#.^$%^*J^'b^-2^%H^%L^\"6^*D^*W",
      "encoded_base64": "XihzXiElXiVEXiQlXi14XiEpXiMuXipKXiV9XiViXiFsXiZGXipEXiEiXi14XiEpXiMuXiQlXipKXidiXi0yXiVIXiVMXiI2XipEXipX",
      "byte_length": 78
    },
    {
      "unit_id": "DLG_cd705afc0764",
      "text": "  你瘋了嗎？",
      "encoded_ascii": "  ^*F^-/^*D^+X^.V",
      "encoded_base64": "ICBeKkZeLS9eKkReK1heLlY=",
      "byte_length": 17
    },
    {
      "unit_id": "DLG_4624c8c1e724",
      "text": "  你說的「再生」是什麼意思？",
      "encoded_ascii": "  ^*F^-x^&Z^!#^!l^&F^!$^,X^!=^.T^#z^#q^.V",
      "encoded_base64": "ICBeKkZeLXheJlpeISNeIWxeJkZeISReLFheIT1eLlReI3peI3FeLlY=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_3208cde85df0",
      "text": "  你為什麼要待在這裡？",
      "encoded_ascii": "  ^*F^%{^!=^.T^(C^,*^\"d^(s^-j^.V",
      "encoded_base64": "ICBeKkZeJXteIT1eLlReKENeLCpeImReKHNeLWpeLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_d1273e09994d",
      "text": "  你為什麼一心求死？",
      "encoded_ascii": "  ^*F^%{^!=^.T^!%^#k^,n^%L^.V",
      "encoded_base64": "ICBeKkZeJXteIT1eLlReISVeI2teLG5eJUxeLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_e42c27072d95",
      "text": "  別跟我說話，你這團渾身長滿蛆蟲的爛肉！",
      "encoded_ascii": "  ^*H^.+^$%^-x^-v^*A^*F^(s^0V^2+^(c^)C^,{^2C^(8^&Z^&-^'^^*W",
      "encoded_base64": "ICBeKkheLiteJCVeLXheLXZeKkFeKkZeKHNeMFZeMiteKGNeKUNeLHteMkNeKDheJlpeJi1eJ15eKlc=",
      "byte_length": 59
    },
    {
      "unit_id": "DLG_5158a4974432",
      "text": " 現在是時候去……",
      "encoded_ascii": " ^&?^\"d^,X^$f^*|^\"6^*o^*o",
      "encoded_base64": "IF4mP14iZF4sWF4kZl4qfF4iNl4qb14qbw==",
      "byte_length": 25
    },
    {
      "unit_id": "DLG_22a8957da068",
      "text": "她死了！塔拉終於死了！",
      "encoded_ascii": "^+h^%L^*D^*W^\"o^$6^-H^$^^%L^*D^*W",
      "encoded_base64": "XitoXiVMXipEXipXXiJvXiQ2Xi1IXiReXiVMXipEXipX",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_7d65e22da600",
      "text": "我的苦難終於可以結束了！",
      "encoded_ascii": "^$%^&Z^.t^)a^-H^$^^\"A^!B^'@^$|^*D^*W",
      "encoded_base64": "XiQlXiZaXi50XilhXi1IXiReXiJBXiFCXidAXiR8XipEXipX",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_fb6cf9104c8d",
      "text": "不，不！你們根本不明白！我被困在這座迷宮裡數百年了，死了這麼…… ",
      "encoded_ascii": "^!)^*A^!)^*W^*F^*{^%)^$x^!)^$c^&X^*W^$%^(@^\"^^\"d^(s^/_^(n^/\\^-j^$V^&Y^+~^*D^*A^%L^*D^(s^.T^*o^*o ",
      "encoded_base64": "XiEpXipBXiEpXipXXipGXip7XiUpXiR4XiEpXiRjXiZYXipXXiQlXihAXiJeXiJkXihzXi9fXihuXi9cXi1qXiRWXiZZXit+XipEXipBXiVMXipEXihzXi5UXipvXipvIA==",
      "byte_length": 97
    },
    {
      "unit_id": "DLG_065eee0026d1",
      "text": "多年，卻依然宛如活死人般遊蕩在這個世上。",
      "encoded_ascii": "^\"x^+~^*A^1&^!Q^&\"^1v^#$^%i^%L^!<^'r^.3^1X^\"d^(s^!V^*p^!'^!\"",
      "encoded_base64": "XiJ4Xit+XipBXjEmXiFRXiYiXjF2XiMkXiVpXiVMXiE8XidyXi4zXjFYXiJkXihzXiFWXipwXiEnXiEi",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_b4e8ddd3f598",
      "text": "我們離不開這裡！永遠離不開！",
      "encoded_ascii": "^$%^*{^)`^!)^)F^(s^-j^*W^%W^({^)`^!)^)F^*W",
      "encoded_base64": "XiQlXip7XilgXiEpXilGXihzXi1qXipXXiVXXih7XilgXiEpXilGXipX",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_010022c6d7e3",
      "text": "守護符文會把我們的血肉燒盡，但我們隨後又會再次再生重生。 ",
      "encoded_ascii": "^#+^(T^'+^$W^$r^$1^$%^*{^&Z^(:^'^^&&^-1^*A^!I^$%^*{^)X^#b^+;^$r^!l^%D^!l^&F^))^&F^!\" ",
      "encoded_base64": "XiMrXihUXicrXiRXXiRyXiQxXiQlXip7XiZaXig6XideXiYmXi0xXipBXiFJXiQlXip7XilYXiNiXis7XiRyXiFsXiVEXiFsXiZGXikpXiZGXiEiIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_2e9ea58ba1ca",
      "text": "我們的境遇早已萬劫不復。",
      "encoded_ascii": "^$%^*{^&Z^\"q^.2^,V^#J^-_^1l^!)^#g^!\"",
      "encoded_base64": "XiQlXip7XiZaXiJxXi4yXixWXiNKXi1fXjFsXiEpXiNnXiEi",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_811d84aa4f64",
      "text": "如果我告訴你們，你們願意終結我的痛苦嗎？",
      "encoded_ascii": "^#$^%!^$%^+B^-t^*F^*{^*A^*F^*{^.H^#z^-H^'@^$%^&Z^-.^.t^+X^.V",
      "encoded_base64": "XiMkXiUhXiQlXitCXi10XipGXip7XipBXipGXip7Xi5IXiN6Xi1IXidAXiQlXiZaXi0uXi50XitYXi5W",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_55d642138d36",
      "text": "這是納吉的詛咒——每當我們死去，我們的身軀又會重組再生。我…… ",
      "encoded_ascii": "^(s^,X^';^\"D^&Z^(L^\"P^*n^*n^%P^&N^$%^*{^%L^\"6^*A^$%^*{^&Z^(c^(d^+;^$r^))^2;^!l^&F^!\"^$%^*o^*o ",
      "encoded_base64": "XihzXixYXic7XiJEXiZaXihMXiJQXipuXipuXiVQXiZOXiQlXip7XiVMXiI2XipBXiQlXip7XiZaXihjXihkXis7XiRyXikpXjI7XiFsXiZGXiEiXiQlXipvXipvIA==",
      "byte_length": 94
    },
    {
      "unit_id": "DLG_bead0f8b786a",
      "text": "曾經被燒成了灰燼，可如今我依然毫無意義地站在這裡…… ",
      "encoded_ascii": "^.j^'D^(@^&&^$$^*D^%y^&)^*A^\"A^#$^*E^$%^!Q^&\"^/t^%}^#z^2<^\"e^->^\"d^(s^-j^*o^*o ",
      "encoded_base64": "Xi5qXidEXihAXiYmXiQkXipEXiV5XiYpXipBXiJBXiMkXipFXiQlXiFRXiYiXi90XiV9XiN6XjI8XiJlXi0+XiJkXihzXi1qXipvXipvIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_86b341326192",
      "text": "只不過淪為餵養蛆蟲的爛肉罷了。",
      "encoded_ascii": "^\"?^!)^(x^2)^%{^.L^.I^2C^(8^&Z^&-^'^^1Q^*D^!\"",
      "encoded_base64": "XiI/XiEpXih4XjIpXiV7Xi5MXi5JXjJDXig4XiZaXiYtXideXjFRXipEXiEi",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_cf081b3537f5",
      "text": "但你們必須這麼做！",
      "encoded_ascii": "^!I^*F^*{^#l^)r^(s^.T^*~^*W",
      "encoded_base64": "XiFJXipGXip7XiNsXilyXihzXi5UXip+XipX",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_964e7f06b2f4",
      "text": "死？我早就已經死了！我只希望能長眠——結束這數百年的永世折磨。",
      "encoded_ascii": "^%L^.V^$%^,V^*J^#J^'D^%L^*D^*W^$%^\"?^+{^,]^'b^)C^24^*n^*n^'@^$|^(s^$V^&Y^+~^&Z^%W^*p^,?^-7^!\"",
      "encoded_base64": "XiVMXi5WXiQlXixWXipKXiNKXidEXiVMXipEXipXXiQlXiI/Xit7XixdXidiXilDXjI0XipuXipuXidAXiR8XihzXiRWXiZZXit+XiZaXiVXXipwXiw/Xi03XiEi",
      "byte_length": 93
    },
    {
      "unit_id": "DLG_47dbb2610cf5",
      "text": "別廢話了！拔劍吧，或許你們能將我的靈魂從這具殘破的身軀中解放出來！",
      "encoded_ascii": "^*H^#W^-v^*D^*W^/c^!|^*I^*A^$'^-s^*F^*{^'b^#7^$%^&Z^)g^*.^#f^(s^!k^,l^&n^&Z^(c^(d^!,^(I^$P^!q^!O^*W",
      "encoded_base64": "XipIXiNXXi12XipEXipXXi9jXiF8XipJXipBXiQnXi1zXipGXip7XidiXiM3XiQlXiZaXilnXiouXiNmXihzXiFrXixsXiZuXiZaXihjXihkXiEsXihJXiRQXiFxXiFPXipX",
      "byte_length": 99
    },
    {
      "unit_id": "DLG_f6e7e00371f1",
      "text": "消滅我吧！打碎我的骸骨，徹底終結這道詛咒！",
      "encoded_ascii": "^%k^%t^$%^*I^*W^$-^&o^$%^&Z^*'^*$^*A^18^/^^-H^'@^(s^(y^(L^\"P^*W",
      "encoded_base64": "XiVrXiV0XiQlXipJXipXXiQtXiZvXiQlXiZaXionXiokXipBXjE4Xi9eXi1IXidAXihzXih5XihMXiJQXipX",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_5addc510f5eb",
      "text": "求求你們，讓我安息吧。我只求一份平靜。",
      "encoded_ascii": "^,n^,n^*F^*{^*A^-}^$%^+p^#w^*I^!\"^$%^\"?^,n^!%^*x^0Y^)h^!\"",
      "encoded_base64": "XixuXixuXipGXip7XipBXi19XiQlXitwXiN3XipJXiEiXiQlXiI/XixuXiElXip4XjBZXiloXiEi",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_d137eabe0336",
      "text": "  我也許能夠幫助你。",
      "encoded_ascii": "  ^$%^!1^-s^'b^+d^+}^\"#^*F^!\"",
      "encoded_base64": "ICBeJCVeITFeLXNeJ2JeK2ReK31eIiNeKkZeISI=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_ea0ebca604c1",
      "text": "  你為什麼非得留在這裡？",
      "encoded_ascii": "  ^*F^%{^!=^.T^)i^#e^-+^\"d^(s^-j^.V",
      "encoded_base64": "ICBeKkZeJXteIT1eLlReKWleI2VeLSteImReKHNeLWpeLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_5f75f3aff627",
      "text": "  這個德魯伊是誰？",
      "encoded_ascii": "  ^(s^!V^#j^/K^!E^,X^-y^.V",
      "encoded_base64": "ICBeKHNeIVZeI2peL0teIUVeLFheLXleLlY=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_c76c6890d949",
      "text": "  德魯伊有說明該如何消滅塔拉嗎？",
      "encoded_ascii": "  ^#j^/K^!E^$s^-x^$c^(M^#$^!L^%k^%t^\"o^$6^+X^.V",
      "encoded_base64": "ICBeI2peL0teIUVeJHNeLXheJGNeKE1eIyReIUxeJWteJXReIm9eJDZeK1heLlY=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_0c03036fa15e",
      "text": "  你們為什麼會遭受詛咒？",
      "encoded_ascii": "  ^*F^*{^%{^!=^.T^$r^(}^\";^(L^\"P^.V",
      "encoded_base64": "ICBeKkZeKnteJXteIT1eLlReJHJeKH1eIjteKExeIlBeLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_f58779d03095",
      "text": "  我才不管你，你就留在這裡發爛發臭吧。",
      "encoded_ascii": "  ^$%^$,^!)^-D^*F^*A^*F^*J^-+^\"d^(s^-j^&W^&-^&W^'m^*I^!\"",
      "encoded_base64": "ICBeJCVeJCxeISleLUReKkZeKkFeKkZeKkpeLSteImReKHNeLWpeJldeJi1eJldeJ21eKkleISI=",
      "byte_length": 56
    },
    {
      "unit_id": "DLG_10ecdbf8e149",
      "text": "  如果我打擾了你，我很抱歉。再見。",
      "encoded_ascii": "  ^#$^%!^$%^$-^$K^*D^*F^*A^$%^*K^,@^,h^!\"^!l^-m^!\"",
      "encoded_base64": "ICBeIyReJSFeJCVeJC1eJEteKkReKkZeKkFeJCVeKkteLEBeLGheISJeIWxeLW1eISI=",
      "byte_length": 50
    },
    {
      "unit_id": "DLG_81f973ce9235",
      "text": "  謝謝你的幫助。再見。",
      "encoded_ascii": "  ^-z^-z^*F^&Z^+}^\"#^!\"^!l^-m^!\"",
      "encoded_base64": "ICBeLXpeLXpeKkZeJlpeK31eIiNeISJeIWxeLW1eISI=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_6fb27d182db7",
      "text": " 求求你們，我說得夠多了。留我一人沉淪於我的悲苦中吧。",
      "encoded_ascii": " ^,n^,n^*F^*{^*A^$%^-x^#e^+d^\"x^*D^!\"^-+^$%^!%^!<^%Z^2)^$^^$%^&Z^,.^.t^!,^*I^!\"",
      "encoded_base64": "IF4sbl4sbl4qRl4qe14qQV4kJV4teF4jZV4rZF4ieF4qRF4hIl4tK14kJV4hJV4hPF4lWl4yKV4kXl4kJV4mWl4sLl4udF4hLF4qSV4hIg==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_d7e201c39876",
      "text": "不，沒有任何東西能幫我。我注定要永世被困在這裡。 ",
      "encoded_ascii": "^!)^*A^%\\^$s^!C^!L^,`^-l^'b^+}^$%^!\"^$%^%e^#.^(C^%W^*p^(@^\"^^\"d^(s^-j^!\" ",
      "encoded_base64": "XiEpXipBXiVcXiRzXiFDXiFMXixgXi1sXidiXit9XiQlXiEiXiQlXiVlXiMuXihDXiVXXipwXihAXiJeXiJkXihzXi1qXiEiIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_ca5e283c5c61",
      "text": "不久前也有個德魯伊來到這裡，說著一模一樣的話。現在…… ",
      "encoded_ascii": "^!)^!.^!z^!1^$s^!V^#j^/K^!E^!O^!u^(s^-j^*A^-x^-a^!%^%:^!%^,f^&Z^-v^!\"^&?^\"d^*o^*o ",
      "encoded_base64": "XiEpXiEuXiF6XiExXiRzXiFWXiNqXi9LXiFFXiFPXiF1XihzXi1qXipBXi14Xi1hXiElXiU6XiElXixmXiZaXi12XiEiXiY/XiJkXipvXipvIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_07b8cc950030",
      "text": "他正被關在西塔裡發爛，而我身上的詛咒依舊沒有解除。",
      "encoded_ascii": "^!@^%H^(@^.>^\"d^-l^\"o^-j^&W^&-^*A^'W^$%^(c^!'^&Z^(L^\"P^!Q^02^%\\^$s^(I^)Q^!\"",
      "encoded_base64": "XiFAXiVIXihAXi4+XiJkXi1sXiJvXi1qXiZXXiYtXipBXidXXiQlXihjXiEnXiZaXihMXiJQXiFRXjAyXiVcXiRzXihJXilRXiEi",
      "byte_length": 75
    },
    {
      "unit_id": "DLG_c23333d0e91b",
      "text": "我們遭受了詛咒，而那些守護符文阻止我們踏出迷宮半步。",
      "encoded_ascii": "^$%^*{^(}^\";^*D^(L^\"P^*A^'W^)!^!8^#+^(T^'+^$W^)L^%G^$%^*{^.,^!q^(n^/\\^\"-^,i^!\"",
      "encoded_base64": "XiQlXip7Xih9XiI7XipEXihMXiJQXipBXidXXikhXiE4XiMrXihUXicrXiRXXilMXiVHXiQlXip7Xi4sXiFxXihuXi9cXiItXixpXiEi",
      "byte_length": 78
    },
    {
      "unit_id": "DLG_a0b652a81749",
      "text": "塔拉打敗納吉後被虛榮衝昏了頭腦，以為自己的力量舉世無雙。 ",
      "encoded_ascii": "^\"o^$6^$-^$R^';^\"D^#b^(@^-g^,e^-h^$d^*D^)t^2@^*A^!B^%{^'l^#I^&Z^!~^)*^01^*p^%}^)_^!\" ",
      "encoded_base64": "XiJvXiQ2XiQtXiRSXic7XiJEXiNiXihAXi1nXixlXi1oXiRkXipEXil0XjJAXipBXiFCXiV7XidsXiNJXiZaXiF+XikqXjAxXipwXiV9XilfXiEiIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_f7aa042b08a6",
      "text": "她把納吉和他的信徒封印在下方的洞穴裡，津津有味地欣賞著…… ",
      "encoded_ascii": "^+h^$1^';^\"D^\"O^!@^&Z^!U^#d^#5^1%^\"d^!(^$]^&Z^%h^'&^-j^*A^2(^2(^$s^1n^\"e^2'^*T^-a^*o^*o ",
      "encoded_base64": "XitoXiQxXic7XiJEXiJPXiFAXiZaXiFVXiNkXiM1XjElXiJkXiEoXiRdXiZaXiVoXicmXi1qXipBXjIoXjIoXiRzXjFuXiJlXjInXipUXi1hXipvXipvIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_8a1ca9d533e9",
      "text": "他們慢慢受折磨致死。這正好給了納吉時間施展他的復仇咒術。",
      "encoded_ascii": "^!@^*{^#~^#~^\";^,?^-7^'o^%L^!\"^(s^%H^+i^'A^*D^';^\"D^$f^)G^$_^+x^!@^&Z^#g^1g^\"P^(<^!\"",
      "encoded_base64": "XiFAXip7XiN+XiN+XiI7Xiw/Xi03XidvXiVMXiEiXihzXiVIXitpXidBXipEXic7XiJEXiRmXilHXiRfXit4XiFAXiZaXiNnXjFnXiJQXig8XiEi",
      "byte_length": 84
    },
    {
      "unit_id": "DLG_fbea68cefaa2",
      "text": "一個蠢貨。他聲稱知道消滅塔拉的方法，但那根本不可能。 ",
      "encoded_ascii": "^!%^!V^.u^.w^!\"^!@^-W^0&^&h^(y^%k^%t^\"o^$6^&Z^$]^%b^*A^!I^)!^%)^$x^!)^\"A^'b^!\" ",
      "encoded_base64": "XiElXiFWXi51Xi53XiEiXiFAXi1XXjAmXiZoXih5XiVrXiV0XiJvXiQ2XiZaXiRdXiViXipBXiFJXikhXiUpXiR4XiEpXiJBXidiXiEiIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_09ffdb735111",
      "text": "已經有太多人嘗試過了。",
      "encoded_ascii": "^#J^'D^$s^+f^\"x^!<^1o^-u^(x^*D^!\"",
      "encoded_base64": "XiNKXidEXiRzXitmXiJ4XiE8XjFvXi11Xih4XipEXiEi",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_2dc9c9e5b167",
      "text": "正如我所說，他是個蠢貨，我根本沒多理會他……將塔拉的身形吹散進…… ",
      "encoded_ascii": "^%H^#$^$%^$)^-x^*A^!@^,X^!V^.u^.w^*A^$%^%)^$x^%\\^\"x^&A^$r^!@^*o^*o^#7^\"o^$6^&Z^(c^#_^+A^$S^(w^*o^*o ",
      "encoded_base64": "XiVIXiMkXiQlXiQpXi14XipBXiFAXixYXiFWXi51Xi53XipBXiQlXiUpXiR4XiVcXiJ4XiZBXiRyXiFAXipvXipvXiM3XiJvXiQ2XiZaXihjXiNfXitBXiRTXih3XipvXipvIA==",
      "byte_length": 100
    },
    {
      "unit_id": "DLG_a3f1ef26e499",
      "text": "狂風之中！真是無稽之談！為了解除這道詛咒，我們早就試過一切手段了。 ",
      "encoded_ascii": "^&8^)y^!/^!,^*W^-2^,X^%}^26^!/^0;^*W^%{^*D^(I^)Q^(s^(y^(L^\"P^*A^$%^*{^,V^*J^-u^(x^!%^+.^$+^.l^*D^!\" ",
      "encoded_base64": "XiY4Xil5XiEvXiEsXipXXi0yXixYXiV9XjI2XiEvXjA7XipXXiV7XipEXihJXilRXihzXih5XihMXiJQXipBXiQlXip7XixWXipKXi11Xih4XiElXisuXiQrXi5sXipEXiEiIA==",
      "byte_length": 100
    },
    {
      "unit_id": "DLG_e94b5fefc7ca",
      "text": "這世上根本沒有任何辦法能做到。",
      "encoded_ascii": "^(s^*p^!'^%)^$x^%\\^$s^!C^!L^2L^%b^'b^*~^!u^!\"",
      "encoded_base64": "XihzXipwXiEnXiUpXiR4XiVcXiRzXiFDXiFMXjJMXiViXidiXip+XiF1XiEi",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_ded9cdceb153",
      "text": "我過去這不知道多少個世紀以來，一直都在做這件事！ ",
      "encoded_ascii": "^$%^(x^\"6^(s^!)^&h^(y^\"x^#<^!V^*p^2:^!B^!O^*A^!%^&`^)$^\"d^*~^(s^.W^*r^*W ",
      "encoded_base64": "XiQlXih4XiI2XihzXiEpXiZoXih5XiJ4XiM8XiFWXipwXjI6XiFCXiFPXipBXiElXiZgXikkXiJkXip+XihzXi5XXipyXipXIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_47b36f320af9",
      "text": "現在，滾開！",
      "encoded_ascii": "^&?^\"d^*A^,z^)F^*W",
      "encoded_base64": "XiY/XiJkXipBXix6XilGXipX",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_1cd6a5a42e98",
      "text": "哼。",
      "encoded_ascii": "^+K^!\"",
      "encoded_base64": "XitLXiEi",
      "byte_length": 6
    },
    {
      "unit_id": "DLG_ecc5ee513fcc",
      "text": "謝謝你們解救了我們！我終於能夠尋得長眠與平靜了。",
      "encoded_ascii": "^-z^-z^*F^*{^(I^,Q^*D^$%^*{^*W^$%^-H^$^^'b^+d^#9^#e^)C^24^'p^0Y^)h^*D^!\"",
      "encoded_base64": "Xi16Xi16XipGXip7XihJXixRXipEXiQlXip7XipXXiQlXi1IXiReXidiXitkXiM5XiNlXilDXjI0XidwXjBZXiloXipEXiEi",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_ac81528c2389",
      "text": " 迷宮西北角我的壁龕裡，有一個破瓦罐，裡面裝著…… ",
      "encoded_ascii": " ^(n^/\\^-l^+6^(H^$%^&Z^*\\^2S^-j^*A^$s^!%^!V^&n^&C^'O^*A^-j^)j^(A^-a^*o^*o ",
      "encoded_base64": "IF4obl4vXF4tbF4rNl4oSF4kJV4mWl4qXF4yU14tal4qQV4kc14hJV4hVl4mbl4mQ14nT14qQV4tal4pal4oQV4tYV4qb14qbyA=",
      "byte_length": 74
    },
    {
      "unit_id": "DLG_a06619e45c92",
      "text": "一雙魔法靴子。請收下牠們，連同我誠摯的謝意。",
      "encoded_ascii": "^!%^)_^*0^%b^)k^#(^!\"^*S^$M^!(^-#^*{^*A^.0^\"E^$%^2E^2#^&Z^-z^#z^!\"",
      "encoded_base64": "XiElXilfXiowXiViXilrXiMoXiEiXipTXiRNXiEoXi0jXip7XipBXi4wXiJFXiQlXjJFXjIjXiZaXi16XiN6XiEi",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_f38c4b4a0db7",
      "text": "塔拉死了。我早在很久以前就放棄了等待這一天的希望，以至於我現在…… ",
      "encoded_ascii": "^\"o^$6^%L^*D^!\"^$%^,V^\"d^*K^!.^!B^!z^*J^$P^,a^*D^'-^,*^(s^!%^+e^&Z^+{^,]^*A^!B^'n^$^^$%^&?^\"d^*o^*o ",
      "encoded_base64": "XiJvXiQ2XiVMXipEXiEiXiQlXixWXiJkXipLXiEuXiFCXiF6XipKXiRQXixhXipEXictXiwqXihzXiElXitlXiZaXit7XixdXipBXiFCXiduXiReXiQlXiY/XiJkXipvXipvIA==",
      "byte_length": 100
    },
    {
      "unit_id": "DLG_5ca7abd7a331",
      "text": "不知道該如何是好。那些符印依然將我們囚禁在迷宮裡…… ",
      "encoded_ascii": "^!)^&h^(y^(M^#$^!L^,X^+i^!\"^)!^!8^'+^1%^!Q^&\"^#7^$%^*{^\"Z^&y^\"d^(n^/\\^-j^*o^*o ",
      "encoded_base64": "XiEpXiZoXih5XihNXiMkXiFMXixYXitpXiEiXikhXiE4XicrXjElXiFRXiYiXiM3XiQlXip7XiJaXiZ5XiJkXihuXi9cXi1qXipvXipvIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_4510f6f2f363",
      "text": "除非……你們能像消滅塔拉那樣，將那些符印徹底摧毀？",
      "encoded_ascii": "^)Q^)i^*o^*o^*F^*{^'b^!`^%k^%t^\"o^$6^)!^,f^*A^#7^)!^!8^'+^1%^18^/^^$E^%N^.V",
      "encoded_base64": "XilRXilpXipvXipvXipGXip7XidiXiFgXiVrXiV0XiJvXiQ2XikhXixmXipBXiM3XikhXiE4XicrXjElXjE4Xi9eXiRFXiVOXi5W",
      "byte_length": 75
    },
    {
      "unit_id": "DLG_83b85ddd5c54",
      "text": "  好的，我會竭盡所能。",
      "encoded_ascii": "  ^+i^&Z^*A^$%^$r^29^-1^$)^'b^!\"",
      "encoded_base64": "ICBeK2leJlpeKkFeJCVeJHJeMjleLTFeJCleJ2JeISI=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_f882e2d44ac2",
      "text": "  不，你們還是老老實實待在這裡比較好。",
      "encoded_ascii": "  ^!)^*A^*F^*{^.7^,X^'U^'U^#3^#3^,*^\"d^(s^-j^,m^(f^+i^!\"",
      "encoded_base64": "ICBeISleKkFeKkZeKnteLjdeLFheJ1VeJ1VeIzNeIzNeLCpeImReKHNeLWpeLG1eKGZeK2leISI=",
      "byte_length": 56
    },
    {
      "unit_id": "DLG_786267a1165b",
      "text": "我原本還以為亞薩斯這片荒原早已再無英雄！ ",
      "encoded_ascii": "^$%^\"5^$x^.7^!B^%{^!9^-e^$[^(s^&1^1W^\"5^,V^#J^!l^%}^'y^)\\^*W ",
      "encoded_base64": "XiQlXiI1XiR4Xi43XiFCXiV7XiE5Xi1lXiRbXihzXiYxXjFXXiI1XixWXiNKXiFsXiV9Xid5XilcXipXIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_54a91c118bf5",
      "text": "你們帶給了我希望，這份希望比世間任何寶藏都更加珍貴。",
      "encoded_ascii": "^*F^*{^#N^'A^*D^$%^+{^,]^*A^(s^*x^+{^,]^,m^*p^)G^!C^!L^#4^-f^)$^$o^\"\"^/7^2F^!\"",
      "encoded_base64": "XipGXip7XiNOXidBXipEXiQlXit7XixdXipBXihzXip4Xit7XixdXixtXipwXilHXiFDXiFMXiM0Xi1mXikkXiRvXiIiXi83XjJGXiEi",
      "byte_length": 78
    },
    {
      "unit_id": "DLG_0633c44f2713",
      "text": "要是你們成功了，我會將我僅存的最後珍寶贈予你們。",
      "encoded_ascii": "^(C^,X^*F^*{^$$^\"!^*D^*A^$%^$r^#7^$%^!_^#*^&Z^$q^#b^/7^#4^([^!4^*F^*{^!\"",
      "encoded_base64": "XihDXixYXipGXip7XiQkXiIhXipEXipBXiQlXiRyXiM3XiQlXiFfXiMqXiZaXiRxXiNiXi83XiM0XihbXiE0XipGXip7XiEi",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_9ec785168bf3",
      "text": " 祝你們日後的每一次冒險都能一帆風順！",
      "encoded_ascii": " ^&v^*F^*{^$a^#b^&Z^%P^!%^%D^/P^*m^)$^'b^!%^1x^)y^.D^*W",
      "encoded_base64": "IF4mdl4qRl4qe14kYV4jYl4mWl4lUF4hJV4lRF4vUF4qbV4pJF4nYl4hJV4xeF4peV4uRF4qVw==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_585847c3bd99",
      "text": "你說得對。重獲自由對我而言太過奢望了。我至少還能期盼…… ",
      "encoded_ascii": "^*F^-x^#e^#:^!\"^))^&:^'l^&I^#:^$%^'W^1Y^+f^(x^1t^,]^*D^!\"^$%^'n^#<^.7^'b^$u^23^*o^*o ",
      "encoded_base64": "XipGXi14XiNlXiM6XiEiXikpXiY6XidsXiZJXiM6XiQlXidXXjFZXitmXih4XjF0XixdXipEXiEiXiQlXiduXiM8Xi43XidiXiR1XjIzXipvXipvIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_1ed37666f537",
      "text": "我的苦難終將迎來終結。為此，我深深感謝你們。",
      "encoded_ascii": "^$%^&Z^.t^)a^-H^#7^(k^!O^-H^'@^!\"^%{^%I^*A^$%^2*^2*^#{^-z^*F^*{^!\"",
      "encoded_base64": "XiQlXiZaXi50XilhXi1IXiM3XihrXiFPXi1IXidAXiEiXiV7XiVJXipBXiQlXjIqXjIqXiN7Xi16XipGXip7XiEi",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_95debeaa5962",
      "text": "人類，今晚我要大啖你的血肉！ ",
      "encoded_ascii": "^!<^)w^*A^*E^,Y^$%^(C^\"z^>f^*F^&Z^(:^'^^*W ",
      "encoded_base64": "XiE8Xil3XipBXipFXixZXiQlXihDXiJ6Xj5mXipGXiZaXig6XideXipXIA==",
      "byte_length": 43
    },
    {
      "unit_id": "DLG_a521f411a8dd",
      "text": "我們換個話題吧。",
      "encoded_ascii": "^$%^*{^4@^!V^-v^.G^*I^!\"",
      "encoded_base64": "XiQlXip7XjRAXiFWXi12Xi5HXipJXiEi",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_e43ff2ca6c84",
      "text": "見到你們真高興，無鱗者。我正在尋求我的啟示幻象，因此你們的血肉是 ",
      "encoded_ascii": "^-m^!u^*F^*{^-2^*+^-]^*A^%}^*2^'V^!\"^$%^%H^\"d^#9^,n^$%^&Z^57^&s^#S^4g^*A^\"]^%I^*F^*{^&Z^(:^'^^,X ",
      "encoded_base64": "Xi1tXiF1XipGXip7Xi0yXiorXi1dXipBXiV9XioyXidWXiEiXiQlXiVIXiJkXiM5XixuXiQlXiZaXjU3XiZzXiNTXjRnXipBXiJdXiVJXipGXip7XiZaXig6XideXixYIA==",
      "byte_length": 97
    },
    {
      "unit_id": "DLG_ddca1d71aaa1",
      "text": "安全無虞的。或許你們也是這股塵捲風計劃的一部分。",
      "encoded_ascii": "^+p^!h^%}^>k^&Z^!\"^$'^-s^*F^*{^!1^,X^(s^'_^\"p^0c^)y^-n^4s^&Z^!%^)#^!s^!\"",
      "encoded_base64": "XitwXiFoXiV9Xj5rXiZaXiEiXiQnXi1zXipGXip7XiExXixYXihzXidfXiJwXjBjXil5Xi1uXjRzXiZaXiElXikjXiFzXiEi",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_e8c8f39bd88b",
      "text": "我的啟示幻象尚未成形。在獲得啟蒙開悟之前，我絕不進食。",
      "encoded_ascii": "^$%^&Z^57^&s^#S^4g^+v^,_^$$^#_^!\"^\"d^&:^#e^57^-c^)F^=e^!/^!z^*A^$%^-I^!)^(w^0J^!\"",
      "encoded_base64": "XiQlXiZaXjU3XiZzXiNTXjRnXit2XixfXiQkXiNfXiEiXiJkXiY6XiNlXjU3Xi1jXilGXj1lXiEvXiF6XipBXiQlXi1JXiEpXih3XjBKXiEi",
      "byte_length": 81
    },
    {
      "unit_id": "DLG_048786a0001a",
      "text": "我的部族已經抵達了。在你們離開後不久，我就獲得了我的啟示幻象。 ",
      "encoded_ascii": "^$%^&Z^)#^5V^#J^'D^$5^(z^*D^!\"^\"d^*F^*{^)`^)F^#b^!)^!.^*A^$%^*J^&:^#e^*D^$%^&Z^57^&s^#S^4g^!\" ",
      "encoded_base64": "XiQlXiZaXikjXjVWXiNKXidEXiQ1Xih6XipEXiEiXiJkXipGXip7XilgXilGXiNiXiEpXiEuXipBXiQlXipKXiY6XiNlXipEXiQlXiZaXjU3XiZzXiNTXjRnXiEiIA==",
      "byte_length": 94
    },
    {
      "unit_id": "DLG_ca116614515d",
      "text": "他們正外出狩獵食物。現在歡迎你們留在此處與我作伴。 ",
      "encoded_ascii": "^!@^*{^%H^\"w^!q^8l^&;^0J^&4^!\"^&?^\"d^%F^(k^*F^*{^-+^\"d^%I^(,^'p^$%^!M^1h^!\" ",
      "encoded_base64": "XiFAXip7XiVIXiJ3XiFxXjhsXiY7XjBKXiY0XiEiXiY/XiJkXiVGXihrXipGXip7Xi0rXiJkXiVJXigsXidwXiQlXiFNXjFoXiEiIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_03da72e09ad0",
      "text": "你們是「非獵物」。",
      "encoded_ascii": "^*F^*{^,X^!#^)i^&;^&4^!$^!\"",
      "encoded_base64": "XipGXip7XixYXiEjXilpXiY7XiY0XiEkXiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_0f1466a96407",
      "text": "見到你們真高興，各位旅人。但願你們的狩獵收穫豐碩。",
      "encoded_ascii": "^-m^!u^*F^*{^-2^*+^-]^*A^+>^!J^2m^!<^!\"^!I^.H^*F^*{^&Z^8l^&;^$M^<B^4!^9`^!\"",
      "encoded_base64": "Xi1tXiF1XipGXip7Xi0yXiorXi1dXipBXis+XiFKXjJtXiE8XiEiXiFJXi5IXipGXip7XiZaXjhsXiY7XiRNXjxCXjQhXjlgXiEi",
      "byte_length": 75
    },
    {
      "unit_id": "DLG_26725ea272d1",
      "text": "  你在追尋什麼？",
      "encoded_ascii": "  ^*F^\"d^(o^#9^!=^.T^.V",
      "encoded_base64": "ICBeKkZeImReKG9eIzleIT1eLlReLlY=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_a9f6a6e099aa",
      "text": "  跟我說說這股塵捲風的事。",
      "encoded_ascii": "  ^.+^$%^-x^-x^(s^'_^\"p^0c^)y^&Z^*r^!\"",
      "encoded_base64": "ICBeLiteJCVeLXheLXheKHNeJ19eInBeMGNeKXleJlpeKnJeISI=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_7554af523832",
      "text": "  你為何不攻擊我？",
      "encoded_ascii": "  ^*F^%{^!L^!)^$O^$F^$%^.V",
      "encoded_base64": "ICBeKkZeJXteIUxeISleJE9eJEZeJCVeLlY=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_2c45a23ceda3",
      "text": "  如果你沒有得到幻象，就會餓死嗎？",
      "encoded_ascii": "  ^#$^%!^*F^%\\^$s^#e^!u^#S^4g^*A^*J^$r^2R^%L^+X^.V",
      "encoded_base64": "ICBeIyReJSFeKkZeJVxeJHNeI2VeIXVeI1NeNGdeKkFeKkpeJHJeMlJeJUxeK1heLlY=",
      "byte_length": 50
    },
    {
      "unit_id": "DLG_bcdec00538a5",
      "text": "自從我失去了部族，我便在追尋一個能為我召集新族人的圖騰。如果 ",
      "encoded_ascii": "^'l^#f^$%^\"|^\"6^*D^)#^5V^*A^$%^!R^\"d^(o^#9^!%^!V^'b^%{^$%^\"@^)]^$\\^5V^!<^&Z^\"b^.O^!\"^#$^%! ",
      "encoded_base64": "XidsXiNmXiQlXiJ8XiI2XipEXikjXjVWXipBXiQlXiFSXiJkXihvXiM5XiElXiFWXidiXiV7XiQlXiJAXildXiRcXjVWXiE8XiZaXiJiXi5PXiEiXiMkXiUhIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_06525114bdf7",
      "text": "我有力量在我的幻象考驗中活下來，我就能成為一支 ",
      "encoded_ascii": "^$%^$s^!~^)*^\"d^$%^&Z^#S^4g^-R^.P^!,^%i^!(^!O^*A^$%^*J^'b^$$^%{^!%^$L ",
      "encoded_base64": "XiQlXiRzXiF+XikqXiJkXiQlXiZaXiNTXjRnXi1SXi5QXiEsXiVpXiEoXiFPXipBXiQlXipKXidiXiQkXiV7XiElXiRMIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_9a478019f3e6",
      "text": "強大戰團的酋長。",
      "encoded_ascii": "^#]^\"z^$(^0V^&Z^=5^)C^!\"",
      "encoded_base64": "XiNdXiJ6XiQoXjBWXiZaXj01XilDXiEi",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_60f0d592a4b1",
      "text": "  你是怎麼失去部族的？",
      "encoded_ascii": "  ^*F^,X^,,^.T^\"|^\"6^)#^5V^&Z^.V",
      "encoded_base64": "ICBeKkZeLFheLCxeLlReInxeIjZeKSNeNVZeJlpeLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_ae900d66c8af",
      "text": "  是什麼樣的圖騰？",
      "encoded_ascii": "  ^,X^!=^.T^,f^&Z^\"b^.O^.V",
      "encoded_base64": "ICBeLFheIT1eLlReLGZeJlpeImJeLk9eLlY=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_b7a5043a8d22",
      "text": "  你為什麼會活不下來？",
      "encoded_ascii": "  ^*F^%{^!=^.T^$r^%i^!)^!(^!O^.V",
      "encoded_base64": "ICBeKkZeJXteIT1eLlReJHJeJWleISleISheIU9eLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_e3f37ed30d53",
      "text": "  你的部族會從哪裡來？",
      "encoded_ascii": "  ^*F^&Z^)#^5V^$r^#f^+I^-j^!O^.V",
      "encoded_base64": "ICBeKkZeJlpeKSNeNVZeJHJeI2ZeK0leLWpeIU9eLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_62c9b5d21c89",
      "text": "  驅逐族人未免太殘酷了。",
      "encoded_ascii": "  ^*#^(r^5V^!<^,_^!e^+f^,l^1b^*D^!\"",
      "encoded_base64": "ICBeKiNeKHJeNVZeITxeLF9eIWVeK2ZeLGxeMWJeKkReISI=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_fba759339526",
      "text": "  所以，十二歲當酋長算很年輕嗎？",
      "encoded_ascii": "  ^$)^!B^*A^*Y^!5^,j^&N^=5^)C^-C^*K^+~^(g^+X^.V",
      "encoded_base64": "ICBeJCleIUJeKkFeKlleITVeLGpeJk5ePTVeKUNeLUNeKkteK35eKGdeK1heLlY=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_ee30101c7115",
      "text": "  你們會向圖騰獻祭嗎？",
      "encoded_ascii": "  ^*F^*{^$r^+?^\"b^.O^-(^&x^+X^.V",
      "encoded_base64": "ICBeKkZeKnteJHJeKz9eImJeLk9eLSheJnheK1heLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_6b0893e65bff",
      "text": "  你怎麼知道它渴望靈魂？",
      "encoded_ascii": "  ^*F^,,^.T^&h^(y^+o^,w^,]^)g^*.^.V",
      "encoded_base64": "ICBeKkZeLCxeLlReJmheKHleK29eLHdeLF1eKWdeKi5eLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_40dac5b9c482",
      "text": "塵捲風是力量的象徵。我能感受到自己的啟示幻象就在其 ",
      "encoded_ascii": "^\"p^0c^)y^,X^!~^)*^&Z^4g^5O^!\"^$%^'b^#{^\";^!u^'l^#I^&Z^57^&s^#S^4g^*J^\"d^!j ",
      "encoded_base64": "XiJwXjBjXil5XixYXiF+XikqXiZaXjRnXjVPXiEiXiQlXidiXiN7XiI7XiF1XidsXiNJXiZaXjU3XiZzXiNTXjRnXipKXiJkXiFqIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_4155482dac13",
      "text": "盤旋的狂塵之中。",
      "encoded_ascii": "^1M^$`^&Z^&8^\"p^!/^!,^!\"",
      "encoded_base64": "XjFNXiRgXiZaXiY4XiJwXiEvXiEsXiEi",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_c25ec29d096f",
      "text": "  你為什麼要跟著它？",
      "encoded_ascii": "  ^*F^%{^!=^.T^(C^.+^-a^+o^.V",
      "encoded_base64": "ICBeKkZeJXteIT1eLlReKENeLiteLWFeK29eLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_4ad4ee8a4001",
      "text": "  你認為它具有智慧？",
      "encoded_ascii": "  ^*F^(O^%{^+o^!k^$s^$i^4;^.V",
      "encoded_base64": "ICBeKkZeKE9eJXteK29eIWteJHNeJGleNDteLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_72eb1d1dc782",
      "text": "  你認為它的計劃是什麼？",
      "encoded_ascii": "  ^*F^(O^%{^+o^&Z^-n^4s^,X^!=^.T^.V",
      "encoded_base64": "ICBeKkZeKE9eJXteK29eJlpeLW5eNHNeLFheIT1eLlReLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_28932b8cb7d3",
      "text": "  它會為你提供食物？",
      "encoded_ascii": "  ^+o^$r^%{^*F^$A^!P^0J^&4^.V",
      "encoded_base64": "ICBeK29eJHJeJXteKkZeJEFeIVBeMEpeJjReLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_ad071b7d9508",
      "text": "  我在這個計劃中扮演什麼角色？",
      "encoded_ascii": "  ^$%^\"d^(s^!V^-n^4s^!,^<'^1G^!=^.T^(H^'s^.V",
      "encoded_base64": "ICBeJCVeImReKHNeIVZeLW5eNHNeISxePCdeMUdeIT1eLlReKEheJ3NeLlY=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_4726d24fe209",
      "text": "我的部族規模變得太大，獵場無法供養。作為剛孵化不久的幼體，我 ",
      "encoded_ascii": "^$%^&Z^)#^5V^6'^%:^(U^#e^+f^\"z^*A^&;^\"n^%}^%b^!P^.I^!\"^!M^%{^+0^=&^\")^!)^!.^&Z^9@^**^*A^$% ",
      "encoded_base64": "XiQlXiZaXikjXjVWXjYnXiU6XihVXiNlXitmXiJ6XipBXiY7XiJuXiV9XiViXiFQXi5JXiEiXiFNXiV7XiswXj0mXiIpXiEpXiEuXiZaXjlAXioqXipBXiQlIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_2d406471a603",
      "text": "被拋棄到了荒漠之中。如果我足夠強壯，且神靈見證了這一點， ",
      "encoded_ascii": "^(@^,A^,a^!u^*D^1W^,}^!/^!,^!\"^#$^%!^$%^(^^+d^#]^+b^*A^!*^&w^)g^-m^-{^*D^(s^!%^*;^*A ",
      "encoded_base64": "XihAXixBXixhXiF1XipEXjFXXix9XiEvXiEsXiEiXiMkXiUhXiQlXiheXitkXiNdXitiXipBXiEqXiZ3XilnXi1tXi17XipEXihzXiElXio7XipBIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_3cb0d3169a61",
      "text": "那我便能統領一支新的部族。",
      "encoded_ascii": "^)!^$%^!R^'b^'B^)s^!%^$L^$\\^&Z^)#^5V^!\"",
      "encoded_base64": "XikhXiQlXiFSXidiXidCXilzXiElXiRMXiRcXiZaXikjXjVWXiEi",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_3db77d313bc8",
      "text": "為了未經考驗的幼崽而犧牲整個部族的安全，是極其愚蠢的。 ",
      "encoded_ascii": "^%{^*D^,_^'D^-R^.P^&Z^9@^>I^'W^2w^1J^$T^!V^)#^5V^&Z^+p^!h^*A^,X^1D^!j^/a^.u^&Z^!\" ",
      "encoded_base64": "XiV7XipEXixfXidEXi1SXi5QXiZaXjlAXj5JXidXXjJ3XjFKXiRUXiFWXikjXjVWXiZaXitwXiFoXipBXixYXjFEXiFqXi9hXi51XiZaXiEiIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_6be1d5e7437a",
      "text": "更何況，如今我只經歷過十二個盛夏，便有機會成為一族之長。",
      "encoded_ascii": "^$o^!L^,q^*A^#$^*E^$%^\"?^'D^6^^(x^*Y^!5^!V^1L^/)^*A^!R^$s^%>^$r^$$^%{^!%^5V^!/^)C^!\"",
      "encoded_base64": "XiRvXiFMXixxXipBXiMkXipFXiQlXiI/XidEXjZeXih4XipZXiE1XiFWXjFMXi8pXipBXiFSXiRzXiU+XiRyXiQkXiV7XiElXjVWXiEvXilDXiEi",
      "byte_length": 84
    },
    {
      "unit_id": "DLG_e8273c7acbe9",
      "text": "圖騰只眷顧最強悍的領袖與最優秀的獵手。我先前的 ",
      "encoded_ascii": "^\"b^.O^\"?^7A^4n^$q^#]^,-^&Z^)s^7G^'p^$q^+)^-9^&Z^&;^$+^!\"^$%^!b^!z^&Z ",
      "encoded_base64": "XiJiXi5PXiI/XjdBXjRuXiRxXiNdXiwtXiZaXilzXjdHXidwXiRxXispXi05XiZaXiY7XiQrXiEiXiQlXiFiXiF6XiZaIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_d1ae9e0959ac",
      "text": "酋長已經蛻皮過五次——活過三十個盛夏。他只需一記 ",
      "encoded_ascii": "^=5^)C^#J^'D^>l^&[^(x^!6^%D^*n^*n^%i^(x^!&^*Y^!V^1L^/)^!\"^!@^\"?^)e^!%^(K ",
      "encoded_base64": "Xj01XilDXiNKXidEXj5sXiZbXih4XiE2XiVEXipuXipuXiVpXih4XiEmXipZXiFWXjFMXi8pXiEiXiFAXiI/XillXiElXihLIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_354e7ad1930f",
      "text": "踢擊就能把我開膛破肚。此外，許多老戰士都在等待上位的機會。我本來 ",
      "encoded_ascii": "^2J^$F^*J^'b^$1^$%^)F^=2^&n^=1^!\"^%I^\"w^*A^-s^\"x^'U^$(^+a^)$^\"d^'-^,*^!'^!J^&Z^%>^$r^!\"^$%^$x^!O ",
      "encoded_base64": "XjJKXiRGXipKXidiXiQxXiQlXilGXj0yXiZuXj0xXiEiXiVJXiJ3XipBXi1zXiJ4XidVXiQoXithXikkXiJkXictXiwqXiEnXiFKXiZaXiU+XiRyXiEiXiQlXiR4XiFPIA==",
      "byte_length": 97
    },
    {
      "unit_id": "DLG_7c4f6cb79d13",
      "text": "可能永遠當不上酋長。",
      "encoded_ascii": "^\"A^'b^%W^({^&N^!)^!'^=5^)C^!\"",
      "encoded_base64": "XiJBXidiXiVXXih7XiZOXiEpXiEnXj01XilDXiEi",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_ccbfee5185ef",
      "text": "如果我沒料錯，這股塵捲風就是我的圖騰。它將銘刻在我們部落的 ",
      "encoded_ascii": "^#$^%!^$%^%\\^/n^)5^*A^(s^'_^\"p^0c^)y^*J^,X^$%^&Z^\"b^.O^!\"^+o^#7^.;^.Y^\"d^$%^*{^)#^-`^&Z ",
      "encoded_base64": "XiMkXiUhXiQlXiVcXi9uXik1XipBXihzXidfXiJwXjBjXil5XipKXixYXiQlXiZaXiJiXi5PXiEiXitvXiM3Xi47Xi5ZXiJkXiQlXip7XikjXi1gXiZaIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_7d76715bf245",
      "text": "盾牌之上，並在狩獵中以獻祭享有尊崇。",
      "encoded_ascii": "^&b^&2^!/^!'^*A^!+^\"d^8l^&;^!,^!B^-(^&x^!;^$s^+u^13^!\"",
      "encoded_base64": "XiZiXiYyXiEvXiEnXipBXiErXiJkXjhsXiY7XiEsXiFCXi0oXiZ4XiE7XiRzXit1XjEzXiEi",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_e494cf264845",
      "text": "若塵捲風向我顯現啟示幻象，它就必須獲得相應的尊榮。 ",
      "encoded_ascii": "^'x^\"p^0c^)y^+?^$%^4&^&?^57^&s^#S^4g^*A^+o^*J^#l^)r^&:^#e^&a^0`^&Z^+u^,e^!\" ",
      "encoded_base64": "Xid4XiJwXjBjXil5Xis/XiQlXjQmXiY/XjU3XiZzXiNTXjRnXipBXitvXipKXiNsXilyXiY6XiNlXiZhXjBgXiZaXit1XixlXiEiIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_cdfe695049e6",
      "text": "最強大的獵物會被帶到它面前斬殺。在圖騰吞噬其靈魂時， ",
      "encoded_ascii": "^$q^#]^\"z^&Z^&;^&4^$r^(@^#N^!u^+o^)j^!z^9B^%M^!\"^\"d^\"b^.O^:-^:0^!j^)g^*.^$f^*A ",
      "encoded_base64": "XiRxXiNdXiJ6XiZaXiY7XiY0XiRyXihAXiNOXiF1XitvXilqXiF6XjlCXiVNXiEiXiJkXiJiXi5PXjotXjowXiFqXilnXiouXiRmXipBIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_6499be5f7406",
      "text": "我們會高唱勝利之歌。",
      "encoded_ascii": "^$%^*{^$r^*+^<N^+5^!t^!/^4J^!\"",
      "encoded_base64": "XiQlXip7XiRyXiorXjxOXis1XiF0XiEvXjRKXiEi",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_c94dfd423a44",
      "text": "我們的圖騰是狩獵之靈；是引導我們利爪刺入 ",
      "encoded_ascii": "^$%^*{^&Z^\"b^.O^,X^8l^&;^!/^)g^*C^,X^#Z^10^$%^*{^!t^&.^!w^!f ",
      "encoded_base64": "XiQlXip7XiZaXiJiXi5PXixYXjhsXiY7XiEvXilnXipDXixYXiNaXjEwXiQlXip7XiF0XiYuXiF3XiFmIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_98d2e95e2ce6",
      "text": "獵物心臟的偉大巨獸。若這股塵捲風不是一位獵手，那我便會在 ",
      "encoded_ascii": "^&;^&4^#k^3Y^&Z^*}^\"z^#H^&<^!\"^'x^(s^'_^\"p^0c^)y^!)^,X^!%^!J^&;^$+^*A^)!^$%^!R^$r^\"d ",
      "encoded_base64": "XiY7XiY0XiNrXjNZXiZaXip9XiJ6XiNIXiY8XiEiXid4XihzXidfXiJwXjBjXil5XiEpXixYXiElXiFKXiY7XiQrXipBXikhXiQlXiFSXiRyXiJkIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_d591cc561257",
      "text": "它向我顯現幻象之前活活餓死。",
      "encoded_ascii": "^+o^+?^$%^4&^&?^#S^4g^!/^!z^%i^%i^2R^%L^!\"",
      "encoded_base64": "XitvXis/XiQlXjQmXiY/XiNTXjRnXiEvXiF6XiVpXiVpXjJSXiVMXiEi",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_11773449a0d1",
      "text": "這片土地無比殘酷，對我們亦然。有時候部族圖騰 ",
      "encoded_ascii": "^(s^&1^\"c^\"e^%}^,m^,l^1b^*A^#:^$%^*{^7#^&\"^!\"^$s^$f^*|^)#^5V^\"b^.O ",
      "encoded_base64": "XihzXiYxXiJjXiJlXiV9XixtXixsXjFiXipBXiM6XiQlXip7XjcjXiYiXiEiXiRzXiRmXip8XikjXjVWXiJiXi5PIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_00e56979edd3",
      "text": "會反噬部族導致狩獵失敗。倖存者只能跋涉穿行於荒漠， ",
      "encoded_ascii": "^$r^\"9^:0^)#^5V^10^'o^8l^&;^\"|^$R^!\"^5+^#*^'V^\"?^'b^6y^3O^')^(;^$^^1W^,}^*A ",
      "encoded_base64": "XiRyXiI5XjowXikjXjVWXjEwXidvXjhsXiY7XiJ8XiRSXiEiXjUrXiMqXidWXiI/XidiXjZ5XjNPXicpXig7XiReXjFXXix9XipBIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_066973b05310",
      "text": "直到被新部族接納為止。其他年輕幼崽也會尋求加入新部族， ",
      "encoded_ascii": "^&`^!u^(@^$\\^)#^5V^$?^';^%{^%G^!\"^!j^!@^+~^(g^9@^>I^!1^$r^#9^,n^\"\"^!f^$\\^)#^5V^*A ",
      "encoded_base64": "XiZgXiF1XihAXiRcXikjXjVWXiQ/Xic7XiV7XiVHXiEiXiFqXiFAXit+XihnXjlAXj5JXiExXiRyXiM5XixuXiIiXiFmXiRcXikjXjVWXipBIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_c859b7e046cd",
      "text": "而非獨自尋求啟示幻象。",
      "encoded_ascii": "^'W^)i^/z^'l^#9^,n^57^&s^#S^4g^!\"",
      "encoded_base64": "XidXXilpXi96XidsXiM5XixuXjU3XiZzXiNTXjRnXiEi",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_56ff793f109b",
      "text": "如你所願。 ",
      "encoded_ascii": "^#$^*F^$)^.H^!\" ",
      "encoded_base64": "XiMkXipGXiQpXi5IXiEiIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_9879a7365665",
      "text": "隨你喜歡。 ",
      "encoded_ascii": "^)X^*F^+V^%F^!\" ",
      "encoded_base64": "XilYXipGXitWXiVGXiEiIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_89b3b0e78c0f",
      "text": "悉聽尊便。 ",
      "encoded_ascii": "^2h^-X^+u^!R^!\" ",
      "encoded_base64": "XjJoXi1YXit1XiFSXiEiIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_b99c2b28f216",
      "text": "我藉由緊緊跟隨它來展現我的耐力。當它感到滿意時，便會 ",
      "encoded_ascii": "^$%^04^&I^0r^0r^.+^)X^+o^!O^+x^&?^$%^&Z^-S^!~^!\"^&N^+o^#{^!u^,{^#z^$f^*A^!R^$r ",
      "encoded_base64": "XiQlXjA0XiZJXjByXjByXi4rXilYXitvXiFPXit4XiY/XiQlXiZaXi1TXiF+XiEiXiZOXitvXiN7XiF1Xix7XiN6XiRmXipBXiFSXiRyIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_d68140ce3357",
      "text": "賜予我啟示幻象，並成為我的圖騰。",
      "encoded_ascii": "^.#^!4^$%^57^&s^#S^4g^*A^!+^$$^%{^$%^&Z^\"b^.O^!\"",
      "encoded_base64": "Xi4jXiE0XiQlXjU3XiZzXiNTXjRnXipBXiErXiQkXiV7XiQlXiZaXiJiXi5PXiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_aadd9574ae05",
      "text": "這正是我族之所以為沙漠最偉大獵手的原因。它並非只會對天氣 ",
      "encoded_ascii": "^(s^%H^,X^$%^5V^!/^$)^!B^%{^%]^,}^$q^*}^\"z^&;^$+^&Z^\"5^\"]^!\"^+o^!+^)i^\"?^$r^#:^+e^%U ",
      "encoded_base64": "XihzXiVIXixYXiQlXjVWXiEvXiQpXiFCXiV7XiVdXix9XiRxXip9XiJ6XiY7XiQrXiZaXiI1XiJdXiEiXitvXiErXilpXiI/XiRyXiM6XitlXiVVIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_44b4657ebd69",
      "text": "高談闊論的凡俗生靈。它是一股力量——一種靈體。它藉由 ",
      "encoded_ascii": "^*+^0;^)I^1\\^&Z^+-^8e^&F^)g^!\"^+o^,X^!%^'_^!~^)*^*n^*n^!%^'$^)g^**^!\"^+o^04^&I ",
      "encoded_base64": "XiorXjA7XilJXjFcXiZaXistXjhlXiZGXilnXiEiXitvXixYXiElXidfXiF+XikqXipuXipuXiElXickXilnXioqXiEiXitvXjA0XiZJIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_2bb1c5f63913",
      "text": "幻象發聲。它賜予強者生存所需的獵物。",
      "encoded_ascii": "^#S^4g^&W^-W^!\"^+o^.#^!4^#]^'V^&F^#*^$)^)e^&Z^&;^&4^!\"",
      "encoded_base64": "XiNTXjRnXiZXXi1XXiEiXitvXi4jXiE0XiNdXidWXiZGXiMqXiQpXillXiZaXiY7XiY0XiEi",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_1ad1314b732a",
      "text": "這可不像你們城邦的農田。我們不會在土地吐出綠芽時 ",
      "encoded_ascii": "^(s^\"A^!)^!`^*F^*{^+_^1a^&Z^4i^;\\^!\"^$%^*{^!)^$r^\"d^\"c^\"e^\"G^!q^3V^>j^$f ",
      "encoded_base64": "XihzXiJBXiEpXiFgXipGXip7XitfXjFhXiZaXjRpXjtcXiEiXiQlXip7XiEpXiRyXiJkXiJjXiJlXiJHXiFxXjNWXj5qXiRmIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_c6f6aba8cf0e",
      "text": "無所事事地乾坐著。圖騰強化了獵手，賦予他足以捕捉最敏捷獵物的 ",
      "encoded_ascii": "^%}^$)^*r^*r^\"e^*X^8E^-a^!\"^\"b^.O^#]^\")^*D^&;^$+^*A^(Y^!4^!@^(^^!B^4?^4>^$q^//^/.^&;^&4^&Z ",
      "encoded_base64": "XiV9XiQpXipyXipyXiJlXipYXjhFXi1hXiEiXiJiXi5PXiNdXiIpXipEXiY7XiQrXipBXihZXiE0XiFAXiheXiFCXjQ/XjQ+XiRxXi8vXi8uXiY7XiY0XiZaIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_75130a242979",
      "text": "優勢。只要神靈眷顧於你，你的利爪擊出便絕不落空。",
      "encoded_ascii": "^+)^\"&^!\"^\"?^(C^&w^)g^7A^4n^$^^*F^*A^*F^&Z^!t^&.^$F^!q^!R^-I^!)^-`^'(^!\"",
      "encoded_base64": "XispXiImXiEiXiI/XihDXiZ3XilnXjdBXjRuXiReXipGXipBXipGXiZaXiF0XiYuXiRGXiFxXiFSXi1JXiEpXi1gXicoXiEi",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_c4f699c9670f",
      "text": "那將在我的啟示幻象中揭曉。或許它需要毀滅某個敵人。 ",
      "encoded_ascii": "^)!^#7^\"d^$%^&Z^57^&s^#S^4g^!,^$B^7y^!\"^$'^-s^+o^)e^(C^%N^%t^%$^!V^$U^!<^!\" ",
      "encoded_base64": "XikhXiM3XiJkXiQlXiZaXjU3XiZzXiNTXjRnXiEsXiRCXjd5XiEiXiQnXi1zXitvXillXihDXiVOXiV0XiUkXiFWXiRVXiE8XiEiIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_c2c5f2ec6bde",
      "text": "或許我必須在強悍的對手面前展現勇氣。只要證明了自己的價值， ",
      "encoded_ascii": "^$'^-s^$%^#l^)r^\"d^#]^,-^&Z^#:^$+^)j^!z^+x^&?^\"$^%U^!\"^\"?^(C^-{^$c^*D^'l^#I^&Z^+&^!Z^*A ",
      "encoded_base64": "XiQnXi1zXiQlXiNsXilyXiJkXiNdXiwtXiZaXiM6XiQrXilqXiF6Xit4XiY/XiIkXiVVXiEiXiI/XihDXi17XiRjXipEXidsXiNJXiZaXismXiFaXipBIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_a274ce55355d",
      "text": "我自然就會明瞭。",
      "encoded_ascii": "^$%^'l^&\"^*J^$r^$c^<p^!\"",
      "encoded_base64": "XiQlXidsXiYiXipKXiRyXiRjXjxwXiEi",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_b58ff86b36a4",
      "text": "或許你們將會是我成為酋長後的第一批獵物。或許你們是來誘惑 ",
      "encoded_ascii": "^$'^-s^*F^*{^#7^$r^,X^$%^$$^%{^=5^)C^#b^&Z^',^!%^2i^&;^&4^!\"^$'^-s^*F^*{^,X^!O^1Z^#x ",
      "encoded_base64": "XiQnXi1zXipGXip7XiM3XiRyXixYXiQlXiQkXiV7Xj01XilDXiNiXiZaXicsXiElXjJpXiY7XiY0XiEiXiQnXi1zXipGXip7XixYXiFPXjFaXiN4IA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_ada5ba377505",
      "text": "我的考驗。在採取行動之前，我必須等待我的幻象顯現。",
      "encoded_ascii": "^$%^&Z^-R^.P^!\"^\"d^5R^\":^(;^\"%^!/^!z^*A^$%^#l^)r^'-^,*^$%^&Z^#S^4g^4&^&?^!\"",
      "encoded_base64": "XiQlXiZaXi1SXi5QXiEiXiJkXjVSXiI6Xig7XiIlXiEvXiF6XipBXiQlXiNsXilyXictXiwqXiQlXiZaXiNTXjRnXjQmXiY/XiEi",
      "byte_length": 75
    },
    {
      "unit_id": "DLG_3daa32f6b88f",
      "text": "在尋求啟示幻象期間，我不會進行狩獵。你們就像部族弟兄一般安全。",
      "encoded_ascii": "^\"d^#9^,n^57^&s^#S^4g^$u^)G^*A^$%^!)^$r^(w^(;^8l^&;^!\"^*F^*{^*J^!`^)#^5V^16^1!^!%^'r^+p^!h^!\"",
      "encoded_base64": "XiJkXiM5XixuXjU3XiZzXiNTXjRnXiR1XilHXipBXiQlXiEpXiRyXih3Xig7XjhsXiY7XiEiXipGXip7XipKXiFgXikjXjVWXjE2XjEhXiElXidyXitwXiFoXiEi",
      "byte_length": 93
    },
    {
      "unit_id": "DLG_fed917122232",
      "text": "  你說話很坦誠。",
      "encoded_ascii": "  ^*F^-x^-v^*K^7&^2E^!\"",
      "encoded_base64": "ICBeKkZeLXheLXZeKkteNyZeMkVeISI=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_40ec0c7a0ce3",
      "text": "  我能幫你什麼忙嗎？",
      "encoded_ascii": "  ^$%^'b^+}^*F^!=^.T^,+^+X^.V",
      "encoded_base64": "ICBeJCVeJ2JeK31eKkZeIT1eLlReLCteK1heLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_027f195eba76",
      "text": "  或許我們能聯手合作？",
      "encoded_ascii": "  ^$'^-s^$%^*{^'b^-V^$+^\"C^!M^.V",
      "encoded_base64": "ICBeJCdeLXNeJCVeKnteJ2JeLVZeJCteIkNeIU1eLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_3831a511794c",
      "text": "  我能加入你的部族嗎？",
      "encoded_ascii": "  ^$%^'b^\"\"^!f^*F^&Z^)#^5V^+X^.V",
      "encoded_base64": "ICBeJCVeJ2JeIiJeIWZeKkZeJlpeKSNeNVZeK1heLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_8be3fb1da8fc",
      "text": "  德魯伊很軟弱嗎？",
      "encoded_ascii": "  ^#j^/K^!E^*K^.x^#\\^+X^.V",
      "encoded_base64": "ICBeI2peL0teIUVeKkteLnheI1xeK1heLlY=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_5b6ae7f84744",
      "text": "  我是與那座城邦為敵的。",
      "encoded_ascii": "  ^$%^,X^'p^)!^/_^+_^1a^%{^$U^&Z^!\"",
      "encoded_base64": "ICBeJCVeLFheJ3BeKSFeL19eK19eMWFeJXteJFVeJlpeISI=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_454bb7dde282",
      "text": "  面對突襲你們根本逃不掉。",
      "encoded_ascii": "  ^)j^#:^'*^08^*F^*{^%)^$x^(p^!)^/e^!\"",
      "encoded_base64": "ICBeKWpeIzpeJypeMDheKkZeKnteJSleJHheKHBeISleL2VeISI=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_7258ffb7b2f9",
      "text": "我們不是神祕隱晦的民族。任何生靈都能獲得圖騰。只不過 ",
      "encoded_ascii": "^$%^*{^!)^,X^&w^>i^)Y^.i^&Z^%T^5V^!\"^!C^!L^&F^)g^)$^'b^&:^#e^\"b^.O^!\"^\"?^!)^(x ",
      "encoded_base64": "XiQlXip7XiEpXixYXiZ3Xj5pXilZXi5pXiZaXiVUXjVWXiEiXiFDXiFMXiZGXilnXikkXidiXiY6XiNlXiJiXi5PXiEiXiI/XiEpXih4IA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_8cc5c6ad5458",
      "text": "我族擁有更強大的力量，因此能吸引更強大的靈體。 ",
      "encoded_ascii": "^$%^5V^,M^$s^$o^#]^\"z^&Z^!~^)*^*A^\"]^%I^'b^\"J^#Z^$o^#]^\"z^&Z^)g^**^!\" ",
      "encoded_base64": "XiQlXjVWXixNXiRzXiRvXiNdXiJ6XiZaXiF+XikqXipBXiJdXiVJXidiXiJKXiNaXiRvXiNdXiJ6XiZaXilnXioqXiEiIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_4f075a138beb",
      "text": "我見過你們種族的德魯伊。他們侍奉的是消極順應的靈體。",
      "encoded_ascii": "^$%^-m^(x^*F^*{^'$^5V^&Z^#j^/K^!E^!\"^!@^*{^0}^1+^&Z^,X^%k^1D^.D^0`^&Z^)g^**^!\"",
      "encoded_base64": "XiQlXi1tXih4XipGXip7XickXjVWXiZaXiNqXi9LXiFFXiEiXiFAXip7XjB9XjErXiZaXixYXiVrXjFEXi5EXjBgXiZaXilnXioqXiEi",
      "byte_length": 78
    },
    {
      "unit_id": "DLG_f95a8dda5b01",
      "text": "他們是安靜靈體的僕從。他們不進行狩獵，只會攻擊 ",
      "encoded_ascii": "^!@^*{^,X^+p^)h^)g^**^&Z^+%^#f^!\"^!@^*{^!)^(w^(;^8l^&;^*A^\"?^$r^$O^$F ",
      "encoded_base64": "XiFAXip7XixYXitwXiloXilnXioqXiZaXislXiNmXiEiXiFAXip7XiEpXih3Xig7XjhsXiY7XipBXiI/XiRyXiRPXiRGIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_5747918eef07",
      "text": "荒蕪術士與其同類。若不能參與一場酣暢淋漓的追獵，我定會 ",
      "encoded_ascii": "^1W^4b^(<^+a^'p^!j^\"E^)w^!\"^'x^!)^'b^6K^'p^!%^\"n^>n^7x^>g^>h^&Z^(o^&;^*A^$%^#.^$r ",
      "encoded_base64": "XjFXXjRiXig8XithXidwXiFqXiJFXil3XiEiXid4XiEpXidiXjZLXidwXiElXiJuXj5uXjd4Xj5nXj5oXiZaXihvXiY7XipBXiQlXiMuXiRyIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_0038f2c03369",
      "text": "枯萎衰竭而亡。",
      "encoded_ascii": "^5Z^<D^2D^29^'W^!:^!\"",
      "encoded_base64": "XjVaXjxEXjJEXjI5XidXXiE6XiEi",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_cd0e523079e3",
      "text": "我懷疑你們幫不上什麼忙。這一切全憑塵捲風來決定。 ",
      "encoded_ascii": "^$%^,9^0p^*F^*{^+}^!)^!'^!=^.T^,+^!\"^(s^!%^+.^!h^,5^\"p^0c^)y^!O^,o^#.^!\" ",
      "encoded_base64": "XiQlXiw5XjBwXipGXip7Xit9XiEpXiEnXiE9Xi5UXiwrXiEiXihzXiElXisuXiFoXiw1XiJwXjBjXil5XiFPXixvXiMuXiEiIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_20e4bef68ada",
      "text": "酋長必須靠自己證明實力，正如他必須獨自統領部族一樣。",
      "encoded_ascii": "^=5^)C^#l^)r^.C^'l^#I^-{^$c^#3^!~^*A^%H^#$^!@^#l^)r^/z^'l^'B^)s^)#^5V^!%^,f^!\"",
      "encoded_base64": "Xj01XilDXiNsXilyXi5DXidsXiNJXi17XiRjXiMzXiF+XipBXiVIXiMkXiFAXiNsXilyXi96XidsXidCXilzXikjXjVWXiElXixmXiEi",
      "byte_length": 78
    },
    {
      "unit_id": "DLG_628feaf2e86d",
      "text": "你們尋求蘇蘭部族的力量是明智的。然而，我不會 ",
      "encoded_ascii": "^*F^*{^#9^,n^4c^/G^)#^5V^&Z^!~^)*^,X^$c^$i^&Z^!\"^&\"^'W^*A^$%^!)^$r ",
      "encoded_base64": "XipGXip7XiM5XixuXjRjXi9HXikjXjVWXiZaXiF+XikqXixYXiRjXiRpXiZaXiEiXiYiXidXXipBXiQlXiEpXiRyIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_58e2673f8c8c",
      "text": "參與城邦之間的戰爭。我們生而為獵，絕不會排成佇列去屠戮 ",
      "encoded_ascii": "^6K^'p^+_^1a^!/^)G^&Z^$(^1I^!\"^$%^*{^&F^'W^%{^&;^*A^-I^!)^$r^$<^$$^>e^8f^\"6^#A^,: ",
      "encoded_base64": "XjZLXidwXitfXjFhXiEvXilHXiZaXiQoXjFJXiEiXiQlXip7XiZGXidXXiV7XiY7XipBXi1JXiEpXiRyXiQ8XiQkXj5lXjhmXiI2XiNBXiw6IA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_bf78a1e86519",
      "text": "弱小之輩。",
      "encoded_ascii": "^#\\^#;^!/^8t^!\"",
      "encoded_base64": "XiNcXiM7XiEvXjh0XiEi",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_7fe00af5392b",
      "text": "我們不打仗。若城邦派少數兵力來襲，我們便展開狩獵並將其 ",
      "encoded_ascii": "^$%^*{^!)^$-^0|^!\"^'x^+_^1a^.n^#<^$V^+,^!~^!O^08^*A^$%^*{^!R^+x^)F^8l^&;^!+^#7^!j ",
      "encoded_base64": "XiQlXip7XiEpXiQtXjB8XiEiXid4XitfXjFhXi5uXiM8XiRWXissXiF+XiFPXjA4XipBXiQlXip7XiFSXit4XilGXjhsXiY7XiErXiM3XiFqIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_aa1ab4343484",
      "text": "殲滅。若他們大軍壓境，我們便進一步撤入沙漠深處。他們 ",
      "encoded_ascii": "^=D^%t^!\"^'x^!@^*{^\"z^..^4v^\"q^*A^$%^*{^!R^(w^!%^,i^:7^!f^%]^,}^2*^(,^!\"^!@^*{ ",
      "encoded_base64": "Xj1EXiV0XiEiXid4XiFAXip7XiJ6Xi4uXjR2XiJxXipBXiQlXip7XiFSXih3XiElXixpXjo3XiFmXiVdXix9XjIqXigsXiEiXiFAXip7IA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_c02bab00303d",
      "text": "要麼被迫放棄，要麼分散兵力。一旦他們分散，我們便再度出擊狩獵。",
      "encoded_ascii": "^(C^.T^(@^1`^$P^,a^*A^(C^.T^!s^$S^+,^!~^!\"^!%^1C^!@^*{^!s^$S^*A^$%^*{^!R^!l^#V^!q^$F^8l^&;^!\"",
      "encoded_base64": "XihDXi5UXihAXjFgXiRQXixhXipBXihDXi5UXiFzXiRTXissXiF+XiEiXiElXjFDXiFAXip7XiFzXiRTXipBXiQlXip7XiFSXiFsXiNWXiFxXiRGXjhsXiY7XiEi",
      "byte_length": 93
    },
    {
      "unit_id": "DLG_5059f135ad81",
      "text": "只有當圖騰未能預警時，我們才有可能遭遇突襲。既然我們會 ",
      "encoded_ascii": "^\"?^$s^&N^\"b^.O^,_^'b^.E^(S^$f^*A^$%^*{^$,^$s^\"A^'b^(}^.2^'*^08^!\"^,U^&\"^$%^*{^$r ",
      "encoded_base64": "XiI/XiRzXiZOXiJiXi5PXixfXidiXi5FXihTXiRmXipBXiQlXip7XiQsXiRzXiJBXidiXih9Xi4yXicqXjA4XiEiXixVXiYiXiQlXip7XiRyIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_216eecf7a2f8",
      "text": "定期奉獻祭品，它便不會動怒反噬我們。與你們聯手 ",
      "encoded_ascii": "^#.^$u^1+^-(^&x^\"R^*A^+o^!R^!)^$r^\"%^#o^\"9^:0^$%^*{^!\"^'p^*F^*{^-V^$+ ",
      "encoded_base64": "XiMuXiR1XjErXi0oXiZ4XiJSXipBXitvXiFSXiEpXiRyXiIlXiNvXiI5XjowXiQlXip7XiEiXidwXipGXip7Xi1WXiQrIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_d187be35b8d6",
      "text": "對我的部族毫無益處。",
      "encoded_ascii": "^#:^$%^&Z^)#^5V^/t^%}^3R^(,^!\"",
      "encoded_base64": "XiM6XiQlXiZaXikjXjVWXi90XiV9XjNSXigsXiEi",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_54d09a6e14b5",
      "text": "等我建立起自己的部族後我們再來談吧。我懷疑你們並不適合。 ",
      "encoded_ascii": "^'-^$%^,'^0'^.(^'l^#I^&Z^)#^5V^#b^$%^*{^!l^!O^0;^*I^!\"^$%^,9^0p^*F^*{^!+^!)^(|^\"C^!\" ",
      "encoded_base64": "XictXiQlXiwnXjAnXi4oXidsXiNJXiZaXikjXjVWXiNiXiQlXip7XiFsXiFPXjA7XipJXiEiXiQlXiw5XjBwXipGXip7XiErXiEpXih8XiJDXiEiIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_a2f06c10c18d",
      "text": "你們像沙嚎獸一樣結成小群行動。你們不是那種能夠 ",
      "encoded_ascii": "^*F^*{^!`^%]^\"Y^&<^!%^,f^'@^$$^#;^'R^(;^\"%^!\"^*F^*{^!)^,X^)!^'$^'b^+d ",
      "encoded_base64": "XipGXip7XiFgXiVdXiJZXiY8XiElXixmXidAXiQkXiM7XidSXig7XiIlXiEiXipGXip7XiEpXixYXikhXickXidiXitkIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_266d9f01c82f",
      "text": "接受部族生活戒律的類型。你們終究會獨自遠走高飛。",
      "encoded_ascii": "^$?^\";^)#^5V^&F^%i^$&^7W^&Z^)w^\"j^!\"^*F^*{^-H^-<^$r^/z^'l^({^.&^*+^)z^!\"",
      "encoded_base64": "XiQ/XiI7XikjXjVWXiZGXiVpXiQmXjdXXiZaXil3XiJqXiEiXipGXip7Xi1IXi08XiRyXi96XidsXih7Xi4mXiorXil6XiEi",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_9b2522544643",
      "text": "在獲得啟示幻象之前，我絕不進食。若塵捲風不認為 ",
      "encoded_ascii": "^\"d^&:^#e^57^&s^#S^4g^!/^!z^*A^$%^-I^!)^(w^0J^!\"^'x^\"p^0c^)y^!)^(O^%{ ",
      "encoded_base64": "XiJkXiY6XiNlXjU3XiZzXiNTXjRnXiEvXiF6XipBXiQlXi1JXiEpXih3XjBKXiEiXid4XiJwXjBjXil5XiEpXihPXiV7IA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_12d69cca59c6",
      "text": "我配得上它，我的枯骨就會在這片廢土上化作風沙。",
      "encoded_ascii": "^$%^)&^#e^!'^+o^*A^$%^&Z^5Z^*$^*J^$r^\"d^(s^&1^#W^\"c^!'^\")^!M^)y^%]^!\"",
      "encoded_base64": "XiQlXikmXiNlXiEnXitvXipBXiQlXiZaXjVaXiokXipKXiRyXiJkXihzXiYxXiNXXiJjXiEnXiIpXiFNXil5XiVdXiEi",
      "byte_length": 69
    },
    {
      "unit_id": "DLG_04399af75c0f",
      "text": "歡迎回來看著我的部族壯大。願你們永遠都能尋得獵物。",
      "encoded_ascii": "^%F^(k^\"\\^!O^*Q^-a^$%^&Z^)#^5V^+b^\"z^!\"^.H^*F^*{^%W^({^)$^'b^#9^#e^&;^&4^!\"",
      "encoded_base64": "XiVGXihrXiJcXiFPXipRXi1hXiQlXiZaXikjXjVWXitiXiJ6XiEiXi5IXipGXip7XiVXXih7XikkXidiXiM5XiNlXiY7XiY0XiEi",
      "byte_length": 75
    },
    {
      "unit_id": "DLG_a5e0369fd880",
      "text": "  跟我說說你的啟示幻象。",
      "encoded_ascii": "  ^.+^$%^-x^-x^*F^&Z^57^&s^#S^4g^!\"",
      "encoded_base64": "ICBeLiteJCVeLXheLXheKkZeJlpeNTdeJnNeI1NeNGdeISI=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_b50dd6c6f3d9",
      "text": "  為什麼我是「非獵物」？",
      "encoded_ascii": "  ^%{^!=^.T^$%^,X^!#^)i^&;^&4^!$^.V",
      "encoded_base64": "ICBeJXteIT1eLlReJCVeLFheISNeKWleJjteJjReISReLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_c7fe3f5dca19",
      "text": "  這股塵捲風有什麼作用？",
      "encoded_ascii": "  ^(s^'_^\"p^0c^)y^$s^!=^.T^!M^&H^.V",
      "encoded_base64": "ICBeKHNeJ19eInBeMGNeKXleJHNeIT1eLlReIU1eJkheLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_41b227d45387",
      "text": "  你有什麼有趣的消息嗎？",
      "encoded_ascii": "  ^*F^$s^!=^.T^$s^.*^&Z^%k^#w^+X^.V",
      "encoded_base64": "ICBeKkZeJHNeIT1eLlReJHNeLipeJlpeJWteI3deK1heLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_3b8bda9ff59a",
      "text": "  所以你願意幫我嗎？",
      "encoded_ascii": "  ^$)^!B^*F^.H^#z^+}^$%^+X^.V",
      "encoded_base64": "ICBeJCleIUJeKkZeLkheI3peK31eJCVeK1heLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_f97aa0297c88",
      "text": "  你有見過一個名叫勞莎的蘇蘭蜥蜴人嗎？",
      "encoded_ascii": "  ^*F^$s^-m^(x^!%^!V^\"F^+<^/R^/E^&Z^4c^/G^(2^(3^!<^+X^.V",
      "encoded_base64": "ICBeKkZeJHNeLW1eKHheISVeIVZeIkZeKzxeL1JeL0VeJlpeNGNeL0deKDJeKDNeITxeK1heLlY=",
      "byte_length": 56
    },
    {
      "unit_id": "DLG_afe4611d541f",
      "text": "  你讓勞莎加入了你的部族。",
      "encoded_ascii": "  ^*F^-}^/R^/E^\"\"^!f^*D^*F^&Z^)#^5V^!\"",
      "encoded_base64": "ICBeKkZeLX1eL1JeL0VeIiJeIWZeKkReKkZeJlpeKSNeNVZeISI=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_60f7a1ee9761",
      "text": "  勞莎還在你的部族裡嗎？",
      "encoded_ascii": "  ^/R^/E^.7^\"d^*F^&Z^)#^5V^-j^+X^.V",
      "encoded_base64": "ICBeL1JeL0VeLjdeImReKkZeJlpeKSNeNVZeLWpeK1heLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_1f93e8d29f63",
      "text": "  勞莎說你們結為配偶了。",
      "encoded_ascii": "  ^/R^/E^-x^*F^*{^'@^%{^)&^9,^*D^!\"",
      "encoded_base64": "ICBeL1JeL0VeLXheKkZeKnteJ0BeJXteKSZeOSxeKkReISI=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_b73d6ef004fa",
      "text": "  你當上父親了嗎？",
      "encoded_ascii": "  ^*F^&N^!'^5d^(F^*D^+X^.V",
      "encoded_base64": "ICBeKkZeJk5eISdeNWReKEZeKkReK1heLlY=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_d76230861a84",
      "text": "  你們的蛋情況還好嗎？",
      "encoded_ascii": "  ^*F^*{^&Z^6\"^,0^,q^.7^+i^+X^.V",
      "encoded_base64": "ICBeKkZeKnteJlpeNiJeLDBeLHFeLjdeK2leK1heLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_80461c24b952",
      "text": "我看見我的部族在此繁衍生息。我看見你們這群人穿行於眾多血肉生靈之中。 ",
      "encoded_ascii": "^$%^*Q^-m^$%^&Z^)#^5V^\"d^%I^-N^>m^&F^#w^!\"^$%^*Q^-m^*F^*{^(s^'R^!<^')^(;^$^^&e^\"x^(:^'^^&F^)g^!/^!,^!\" ",
      "encoded_base64": "XiQlXipRXi1tXiQlXiZaXikjXjVWXiJkXiVJXi1OXj5tXiZGXiN3XiEiXiQlXipRXi1tXipGXip7XihzXidSXiE8XicpXig7XiReXiZlXiJ4Xig6XideXiZGXilnXiEvXiEsXiEiIA==",
      "byte_length": 103
    },
    {
      "unit_id": "DLG_57690b51800c",
      "text": "你們浴血穿過戰爭的殺戮。城邦軍隊的佇列逐漸消亡， ",
      "encoded_ascii": "^*F^*{^4N^(:^')^(x^$(^1I^&Z^%M^,:^!\"^+_^1a^..^)U^&Z^>e^8f^(r^2v^%k^!:^*A ",
      "encoded_base64": "XipGXip7XjROXig6XicpXih4XiQoXjFJXiZaXiVNXiw6XiEiXitfXjFhXi4uXilVXiZaXj5lXjhmXihyXjJ2XiVrXiE6XipBIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_63db8edcc022",
      "text": "不再滋擾我的部族。",
      "encoded_ascii": "^!)^!l^7|^$K^$%^&Z^)#^5V^!\"",
      "encoded_base64": "XiEpXiFsXjd8XiRLXiQlXiZaXikjXjVWXiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_8d6988ab6c2a",
      "text": "我頂多只能把你們視為「非獵物」。我不會把我的族人送進 ",
      "encoded_ascii": "^$%^)p^\"x^\"?^'b^$1^*F^*{^(E^%{^!#^)i^&;^&4^!$^!\"^$%^!)^$r^$1^$%^&Z^5V^!<^./^(w ",
      "encoded_base64": "XiQlXilwXiJ4XiI/XidiXiQxXipGXip7XihFXiV7XiEjXilpXiY7XiY0XiEkXiEiXiQlXiEpXiRyXiQxXiQlXiZaXjVWXiE8Xi4vXih3IA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_610aa3ce5dc3",
      "text": "戰爭那種有組織的殺戮之中。",
      "encoded_ascii": "^$(^1I^)!^'$^$s^2;^3z^&Z^%M^,:^!/^!,^!\"",
      "encoded_base64": "XiQoXjFJXikhXickXiRzXjI7XjN6XiZaXiVNXiw6XiEvXiEsXiEi",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_2e56fdd8a39b",
      "text": "我的幻象顯示你們將會重創那座城邦。我的族人將蒙受 ",
      "encoded_ascii": "^$%^&Z^#S^4g^4&^&s^*F^*{^#7^$r^))^!{^)!^/_^+_^1a^!\"^$%^&Z^5V^!<^#7^-c^\"; ",
      "encoded_base64": "XiQlXiZaXiNTXjRnXjQmXiZzXipGXip7XiM3XiRyXikpXiF7XikhXi9fXitfXjFhXiEiXiQlXiZaXjVWXiE8XiM3Xi1jXiI7IA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_13b4e1b01006",
      "text": "少去一個威脅的恩惠。為此，我將你們免除於狩獵目標之外。",
      "encoded_ascii": "^#<^\"6^!%^!V^#&^1T^&Z^#v^6Z^!\"^%{^%I^*A^$%^#7^*F^*{^!e^)Q^$^^8l^&;^&^^%9^!/^\"w^!\"",
      "encoded_base64": "XiM8XiI2XiElXiFWXiMmXjFUXiZaXiN2XjZaXiEiXiV7XiVJXipBXiQlXiM3XipGXip7XiFlXilRXiReXjhsXiY7XiZeXiU5XiEvXiJ3XiEi",
      "byte_length": 81
    },
    {
      "unit_id": "DLG_fac76a96a782",
      "text": "它是我們的圖騰。它的烈風掩蓋我們對獵物的氣味，它的狂沙遮蔽 ",
      "encoded_ascii": "^+o^,X^$%^*{^&Z^\"b^.O^!\"^+o^&Z^%|^)y^9~^-d^$%^*{^#:^&;^&4^&Z^%U^1n^*A^+o^&Z^&8^%]^(~^(' ",
      "encoded_base64": "XitvXixYXiQlXip7XiZaXiJiXi5PXiEiXitvXiZaXiV8Xil5Xjl+Xi1kXiQlXip7XiM6XiY7XiY0XiZaXiVVXjFuXipBXitvXiZaXiY4XiVdXih+XignIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_b86c49cb644a",
      "text": "我們敵人的雙眼。作為回報，我們奉上祭品並歌頌它的榮耀。",
      "encoded_ascii": "^$%^*{^$U^!<^&Z^)_^&d^!\"^!M^%{^\"\\^+`^*A^$%^*{^1+^!'^&x^\"R^!+^4J^7\"^+o^&Z^,e^7D^!\"",
      "encoded_base64": "XiQlXip7XiRVXiE8XiZaXilfXiZkXiEiXiFNXiV7XiJcXitgXipBXiQlXip7XjErXiEnXiZ4XiJSXiErXjRKXjciXitvXiZaXixlXjdEXiEi",
      "byte_length": 81
    },
    {
      "unit_id": "DLG_521b47e9db3d",
      "text": "我們極少與部族外的人往來。我提供不了任何有趣的消息。",
      "encoded_ascii": "^$%^*{^1D^#<^'p^)#^5V^\"w^&Z^!<^,)^!O^!\"^$%^$A^!P^!)^*D^!C^!L^$s^.*^&Z^%k^#w^!\"",
      "encoded_base64": "XiQlXip7XjFEXiM8XidwXikjXjVWXiJ3XiZaXiE8XiwpXiFPXiEiXiQlXiRBXiFQXiEpXipEXiFDXiFMXiRzXi4qXiZaXiVrXiN3XiEi",
      "byte_length": 78
    },
    {
      "unit_id": "DLG_899e3afdead2",
      "text": "她是不久前抵達的。比大多數前來投奔者更年長也更具智慧。她的榮譽感 ",
      "encoded_ascii": "^+h^,X^!)^!.^!z^$5^(z^&Z^!\"^,m^\"z^\"x^$V^!z^!O^$3^2b^'V^$o^+~^)C^!1^$o^!k^$i^4;^!\"^+h^&Z^,e^6-^#{ ",
      "encoded_base64": "XitoXixYXiEpXiEuXiF6XiQ1Xih6XiZaXiEiXixtXiJ6XiJ4XiRWXiF6XiFPXiQzXjJiXidWXiRvXit+XilDXiExXiRvXiFrXiRpXjQ7XiEiXitoXiZaXixlXjYtXiN7IA==",
      "byte_length": 97
    },
    {
      "unit_id": "DLG_d13fdf2402c8",
      "text": "無比堅定。",
      "encoded_ascii": "^%}^,m^\"l^#.^!\"",
      "encoded_base64": "XiV9XixtXiJsXiMuXiEi",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_63e078ed805e",
      "text": "她的智慧是部族的珍貴財富。你們的奔波讓我的部族 ",
      "encoded_ascii": "^+h^&Z^$i^4;^,X^)#^5V^&Z^/7^2F^0=^3C^!\"^*F^*{^&Z^2b^%c^-}^$%^&Z^)#^5V ",
      "encoded_base64": "XitoXiZaXiRpXjQ7XixYXikjXjVWXiZaXi83XjJGXjA9XjNDXiEiXipGXip7XiZaXjJiXiVjXi19XiQlXiZaXikjXjVWIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_9bd7bc774e14",
      "text": "深懷感激。你們在我們部族中享有尊貴的地位。",
      "encoded_ascii": "^2*^,9^#{^1H^!\"^*F^*{^\"d^$%^*{^)#^5V^!,^!;^$s^+u^2F^&Z^\"e^!J^!\"",
      "encoded_base64": "XjIqXiw5XiN7XjFIXiEiXipGXip7XiJkXiQlXip7XikjXjVWXiEsXiE7XiRzXit1XjJGXiZaXiJlXiFKXiEi",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_19914d944fdb",
      "text": "是的。事實上，我已與她結為配偶。有她在身旁相伴，我就能建立起 ",
      "encoded_ascii": "^,X^&Z^!\"^*r^#3^!'^*A^$%^#J^'p^+h^'@^%{^)&^9,^!\"^$s^+h^\"d^(c^.h^&a^1h^*A^$%^*J^'b^,'^0'^.( ",
      "encoded_base64": "XixYXiZaXiEiXipyXiMzXiEnXipBXiQlXiNKXidwXitoXidAXiV7XikmXjksXiEiXiRzXitoXiJkXihjXi5oXiZhXjFoXipBXiQlXipKXidiXiwnXjAnXi4oIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_f50c21845a97",
      "text": "阿塔斯最強大的部族。即便人數不多，在榮譽上也稱霸一方。",
      "encoded_ascii": "^)M^\"o^$[^$q^#]^\"z^&Z^)#^5V^!\"^\"1^!R^!<^$V^!)^\"x^*A^\"d^,e^6-^!'^!1^0&^33^!%^$]^!\"",
      "encoded_base64": "XilNXiJvXiRbXiRxXiNdXiJ6XiZaXikjXjVWXiEiXiIxXiFSXiE8XiRWXiEpXiJ4XipBXiJkXixlXjYtXiEnXiExXjAmXjMzXiElXiRdXiEi",
      "byte_length": 81
    },
    {
      "unit_id": "DLG_596361b22da1",
      "text": "是的。她選擇了我，確實是莫大的榮幸。這說明她深信 ",
      "encoded_ascii": "^,X^&Z^!\"^+h^.6^,N^*D^$%^*A^-6^#3^,X^/F^\"z^&Z^,e^15^!\"^(s^-x^$c^+h^2*^!U ",
      "encoded_base64": "XixYXiZaXiEiXitoXi42XixOXipEXiQlXipBXi02XiMzXixYXi9GXiJ6XiZaXixlXjE1XiEiXihzXi14XiRjXitoXjIqXiFVIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_15ca69d0f217",
      "text": "這個部族注定的宿命與未來。",
      "encoded_ascii": "^(s^!V^)#^5V^%e^#.^&Z^7+^\"N^'p^,_^!O^!\"",
      "encoded_base64": "XihzXiFWXikjXjVWXiVlXiMuXiZaXjcrXiJOXidwXixfXiFPXiEi",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_545ee51551b9",
      "text": "是的。那些蛋已安然埋好。我們的圖騰正守護著牠們。這是一個 ",
      "encoded_ascii": "^,X^&Z^!\"^)!^!8^6\"^#J^+p^&\"^1r^+i^!\"^$%^*{^&Z^\"b^.O^%H^#+^(T^-a^-#^*{^!\"^(s^,X^!%^!V ",
      "encoded_base64": "XixYXiZaXiEiXikhXiE4XjYiXiNKXitwXiYiXjFyXitpXiEiXiQlXip7XiZaXiJiXi5PXiVIXiMrXihUXi1hXi0jXip7XiEiXihzXixYXiElXiFWIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_895074b84857",
      "text": "預兆，象徵著在我離世之後，我的部族仍將長久繁盛。",
      "encoded_ascii": "^.E^5/^*A^4g^5O^-a^\"d^$%^)`^*p^!/^#b^*A^$%^&Z^)#^5V^!?^#7^)C^!.^-N^1L^!\"",
      "encoded_base64": "Xi5FXjUvXipBXjRnXjVPXi1hXiJkXiQlXilgXipwXiEvXiNiXipBXiQlXiZaXikjXjVWXiE/XiM3XilDXiEuXi1OXjFMXiEi",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_1d52656b8d73",
      "text": "是的。一年之內，我的十幾隻幼崽就會邁出牠們的第一步。 ",
      "encoded_ascii": "^,X^&Z^!\"^!%^+~^!/^!g^*A^$%^&Z^*Y^#T^)[^9@^>I^*J^$r^2N^!q^-#^*{^&Z^',^!%^,i^!\" ",
      "encoded_base64": "XixYXiZaXiEiXiElXit+XiEvXiFnXipBXiQlXiZaXipZXiNUXilbXjlAXj5JXipKXiRyXjJOXiFxXi0jXip7XiZaXicsXiElXixpXiEiIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_14092ce68baa",
      "text": "很快牠們就會在營地四周奔馳，捕獵小型生物。我們部族的 ",
      "encoded_ascii": "^*K^*L^-#^*{^*J^$r^\"d^&'^\"e^\"[^\"L^2b^>)^*A^4?^&;^#;^\"j^&F^&4^!\"^$%^*{^)#^5V^&Z ",
      "encoded_base64": "XipLXipMXi0jXip7XipKXiRyXiJkXiYnXiJlXiJbXiJMXjJiXj4pXipBXjQ/XiY7XiM7XiJqXiZGXiY0XiEiXiQlXip7XikjXjVWXiZaIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_a3a632f3e0c2",
      "text": "命運將堅不可摧。",
      "encoded_ascii": "^\"N^.4^#7^\"l^!)^\"A^$E^!\"",
      "encoded_base64": "XiJOXi40XiM3XiJsXiEpXiJBXiRFXiEi",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_97e4cb6b8bf0",
      "text": "你們的邪惡行徑玷污了這個神聖之地！你們休想活著 ",
      "encoded_ascii": "^*F^*{^&Z^)\"^#y^(;^#c^1K^0h^*D^(s^!V^&w^'Z^!/^\"e^*W^*F^*{^!G^,1^%i^-a ",
      "encoded_base64": "XipGXip7XiZaXikiXiN5Xig7XiNjXjFLXjBoXipEXihzXiFWXiZ3XidaXiEvXiJlXipXXipGXip7XiFHXiwxXiVpXi1hIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_d506985b9e47",
      "text": "離開這裡！ ",
      "encoded_ascii": "^)`^)F^(s^-j^*W ",
      "encoded_base64": "XilgXilGXihzXi1qXipXIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_767b9b44a1bb",
      "text": "既然你們已經聽完了我的故事，就必須幫我恢復這座 ",
      "encoded_ascii": "^,U^&\"^*F^*{^#J^'D^-X^#,^*D^$%^&Z^5U^*r^*A^*J^#l^)r^+}^$%^#u^#g^(s^/_ ",
      "encoded_base64": "XixVXiYiXipGXip7XiNKXidEXi1YXiMsXipEXiQlXiZaXjVVXipyXipBXipKXiNsXilyXit9XiQlXiN1XiNnXihzXi9fIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_80873723f1dc",
      "text": "神廟。 ",
      "encoded_ascii": "^&w^0[^!\" ",
      "encoded_base64": "XiZ3XjBbXiEiIA==",
      "byte_length": 10
    },
    {
      "unit_id": "DLG_e4bca0402d1f",
      "text": "問候你們，各位旅人。我是泰內利夫。請留步傾聽我的命運 ",
      "encoded_ascii": "^*Z^*|^*F^*{^*A^+>^!J^2m^!<^!\"^$%^,X^%f^!g^!t^\"{^!\"^*S^-+^,i^2U^-X^$%^&Z^\"N^.4 ",
      "encoded_base64": "XipaXip8XipGXip7XipBXis+XiFKXjJtXiE8XiEiXiQlXixYXiVmXiFnXiF0XiJ7XiEiXipTXi0rXixpXjJVXi1YXiQlXiZaXiJOXi40IA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_ccea4daf147c",
      "text": "之故事，並銘記若不引以為戒，我的宿命也會降臨在你們身上。 ",
      "encoded_ascii": "^!/^5U^*r^*A^!+^.;^(K^'x^!)^#Z^!B^%{^$&^*A^$%^&Z^7+^\"N^!1^$r^)N^1U^\"d^*F^*{^(c^!'^!\" ",
      "encoded_base64": "XiEvXjVVXipyXipBXiErXi47XihLXid4XiEpXiNaXiFCXiV7XiQmXipBXiQlXiZaXjcrXiJOXiExXiRyXilOXjFVXiJkXipGXip7XihjXiEnXiEiIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_6dac6c296b4b",
      "text": "  呃……好吧。",
      "encoded_ascii": "  ^3<^*o^*o^+i^*I^!\"",
      "encoded_base64": "ICBeMzxeKm9eKm9eK2leKkleISI=",
      "byte_length": 20
    },
    {
      "unit_id": "DLG_e266910df3c1",
      "text": "  故事是給小孩子聽的。我沒時間。",
      "encoded_ascii": "  ^5U^*r^,X^'A^#;^+m^#(^-X^&Z^!\"^$%^%\\^$f^)G^!\"",
      "encoded_base64": "ICBeNVVeKnJeLFheJ0FeIzteK21eIyheLVheJlpeISJeJCVeJVxeJGZeKUdeISI=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_14b2490101b2",
      "text": "  跟我說說你的故事吧。我洗耳恭聽。 ",
      "encoded_ascii": "  ^.+^$%^-x^-x^*F^&Z^5U^*r^*I^!\"^$%^0j^'Y^1{^-X^!\" ",
      "encoded_base64": "ICBeLiteJCVeLXheLXheKkZeJlpeNVVeKnJeKkleISJeJCVeMGpeJ1leMXteLVheISIg",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_51f8d544a5e9",
      "text": "我沒閒工夫聽死人的忠告。",
      "encoded_ascii": "^$%^%\\^6A^+y^\"{^-X^%L^!<^&Z^.d^+B^!\"",
      "encoded_base64": "XiQlXiVcXjZBXit5XiJ7Xi1YXiVMXiE8XiZaXi5kXitCXiEi",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_bdb9b87febf3",
      "text": "隨你們便吧。你們的命運掌握在自己手中。若你們的道路再次與我交會， ",
      "encoded_ascii": "^)X^*F^*{^!R^*I^!\"^*F^*{^&Z^\"N^.4^$;^1>^\"d^'l^#I^$+^!,^!\"^'x^*F^*{^&Z^(y^(a^!l^%D^'p^$%^0P^$r^*A ",
      "encoded_base64": "XilYXipGXip7XiFSXipJXiEiXipGXip7XiZaXiJOXi40XiQ7XjE+XiJkXidsXiNJXiQrXiEsXiEiXid4XipGXip7XiZaXih5XihhXiFsXiVEXidwXiQlXjBQXiRyXipBIA==",
      "byte_length": 97
    },
    {
      "unit_id": "DLG_53cc78c3c849",
      "text": "或許到時你們會願意花時間傾聽並獲得領悟。 ",
      "encoded_ascii": "^$'^-s^!u^$f^*F^*{^$r^.H^#z^'w^$f^)G^2U^-X^!+^&:^#e^)s^=e^!\" ",
      "encoded_base64": "XiQnXi1zXiF1XiRmXipGXip7XiRyXi5IXiN6Xid3XiRmXilHXjJVXi1YXiErXiY6XiNlXilzXj1lXiEiIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_d22b7a78c20f",
      "text": "在邪惡氣息充斥這些大殿之前，這個地方 ",
      "encoded_ascii": "^\"d^)\"^#y^%U^#w^5.^,S^(s^!8^\"z^.m^!/^!z^*A^(s^!V^\"e^$] ",
      "encoded_base64": "XiJkXikiXiN5XiVVXiN3XjUuXixTXihzXiE4XiJ6Xi5tXiEvXiF6XipBXihzXiFWXiJlXiRdIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_140efe5fc615",
      "text": "曾被瑪格拉人視為至聖之地。他們在此聚集與祈禱。在 ",
      "encoded_ascii": "^.j^(@^-*^%*^$6^!<^(E^%{^'n^'Z^!/^\"e^!\"^!@^*{^\"d^%I^'[^)]^'p^&u^&|^!\"^\"d ",
      "encoded_base64": "Xi5qXihAXi0qXiUqXiQ2XiE8XihFXiV7XiduXidaXiEvXiJlXiEiXiFAXip7XiJkXiVJXidbXildXidwXiZ1XiZ8XiEiXiJkIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_38bc179a9bd0",
      "text": "那些歲月裡，我是這座神廟的守護者。 ",
      "encoded_ascii": "^)!^!8^,j^/p^-j^*A^$%^,X^(s^/_^&w^0[^&Z^#+^(T^'V^!\" ",
      "encoded_base64": "XikhXiE4XixqXi9wXi1qXipBXiQlXixYXihzXi9fXiZ3XjBbXiZaXiMrXihUXidWXiEiIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_df693609902d",
      "text": "  請繼續說",
      "encoded_ascii": "  ^*S^-O^'M^-x",
      "encoded_base64": "ICBeKlNeLU9eJ01eLXg=",
      "byte_length": 14
    },
    {
      "unit_id": "DLG_37ab4cf968f7",
      "text": "  這一點意思也沒有。",
      "encoded_ascii": "  ^(s^!%^*;^#z^#q^!1^%\\^$s^!\"",
      "encoded_base64": "ICBeKHNeISVeKjteI3peI3FeITFeJVxeJHNeISI=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_91e40725cc44",
      "text": "我沒時間聽這個。再見。 ",
      "encoded_ascii": "^$%^%\\^$f^)G^-X^(s^!V^!\"^!l^-m^!\" ",
      "encoded_base64": "XiQlXiVcXiRmXilHXi1YXihzXiFWXiEiXiFsXi1tXiEiIA==",
      "byte_length": 34
    },
    {
      "unit_id": "DLG_aeb39ae2d7c7",
      "text": "如果你們連傾聽的耐心都沒有，那我便無法幫助你們。或許 ",
      "encoded_ascii": "^#$^%!^*F^*{^.0^2U^-X^&Z^-S^#k^)$^%\\^$s^*A^)!^$%^!R^%}^%b^+}^\"#^*F^*{^!\"^$'^-s ",
      "encoded_base64": "XiMkXiUhXipGXip7Xi4wXjJVXi1YXiZaXi1TXiNrXikkXiVcXiRzXipBXikhXiQlXiFSXiV9XiViXit9XiIjXipGXip7XiEiXiQnXi1zIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_3de982500cdf",
      "text": "下一次你們會願意聽我說完。在那之前，你們的命運全由 ",
      "encoded_ascii": "^!(^!%^%D^*F^*{^$r^.H^#z^-X^$%^-x^#,^!\"^\"d^)!^!/^!z^*A^*F^*{^&Z^\"N^.4^!h^&I ",
      "encoded_base64": "XiEoXiElXiVEXipGXip7XiRyXi5IXiN6Xi1YXiQlXi14XiMsXiEiXiJkXikhXiEvXiF6XipBXipGXip7XiZaXiJOXi40XiFoXiZJIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_bd1cd5fec171",
      "text": "自己掌握。 ",
      "encoded_ascii": "^'l^#I^$;^1>^!\" ",
      "encoded_base64": "XidsXiNJXiQ7XjE+XiEiIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_544fe0445a6a",
      "text": "在某個沙暴肆虐的夜晚，一位疲憊的旅人抵達此處，我們接納了 ",
      "encoded_ascii": "^\"d^%$^!V^%]^$m^2>^3)^&Z^+c^,Y^*A^!%^!J^88^84^&Z^2m^!<^$5^(z^%I^(,^*A^$%^*{^$?^';^*D ",
      "encoded_base64": "XiJkXiUkXiFWXiVdXiRtXjI+XjMpXiZaXitjXixZXipBXiElXiFKXjg4Xjg0XiZaXjJtXiE8XiQ1Xih6XiVJXigsXipBXiQlXip7XiQ/Xic7XipEIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_0007e268d486",
      "text": "他。他被帶進神廟療傷照料，重獲健康。當他逐漸恢復 ",
      "encoded_ascii": "^!@^!\"^!@^(@^#N^(w^&w^0[^&U^!^^/x^/n^*A^))^&:^<M^5N^!\"^&N^!@^(r^2v^#u^#g ",
      "encoded_base64": "XiFAXiEiXiFAXihAXiNOXih3XiZ3XjBbXiZVXiFeXi94Xi9uXipBXikpXiY6XjxNXjVOXiEiXiZOXiFAXihyXjJ2XiN1XiNnIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_540dd6e00e4e",
      "text": "力量時，我看見了未來的災禍幻象，卻未能及時警惕。 ",
      "encoded_ascii": "^!~^)*^$f^*A^$%^*Q^-m^*D^,_^!O^&Z^3P^7B^#S^4g^*A^1&^,_^'b^\"7^$f^(S^:n^!\" ",
      "encoded_base64": "XiF+XikqXiRmXipBXiQlXipRXi1tXipEXixfXiFPXiZaXjNQXjdCXiNTXjRnXipBXjEmXixfXidiXiI3XiRmXihTXjpuXiEiIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_917d0bb8cfbf",
      "text": "  這對我真的一點幫助也沒有。",
      "encoded_ascii": "  ^(s^#:^$%^-2^&Z^!%^*;^+}^\"#^!1^%\\^$s^!\"",
      "encoded_base64": "ICBeKHNeIzpeJCVeLTJeJlpeISVeKjteK31eIiNeITFeJVxeJHNeISI=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_f17a6c6aced5",
      "text": "  然後發生了什麼事？ ",
      "encoded_ascii": "  ^&\"^#b^&W^&F^*D^!=^.T^*r^.V ",
      "encoded_base64": "ICBeJiJeI2JeJldeJkZeKkReIT1eLlReKnJeLlYg",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_ece6d44fa9bc",
      "text": "我得走了。回頭見。",
      "encoded_ascii": "^$%^#e^.&^*D^!\"^\"\\^)t^-m^!\"",
      "encoded_base64": "XiQlXiNlXi4mXipEXiEiXiJcXil0Xi1tXiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_e018f8d04c95",
      "text": "有一夜，我聽見神廟裡傳來異響。我前去查探，發現巴爾卡札就在那裡， ",
      "encoded_ascii": "^$s^!%^+c^*A^$%^-X^-m^&w^0[^-j^+$^!O^&M^)o^!\"^$%^!z^\"6^%&^$>^*A^&W^&?^#K^&/^\"0^.k^*J^\"d^)!^-j^*A ",
      "encoded_base64": "XiRzXiElXitjXipBXiQlXi1YXi1tXiZ3XjBbXi1qXiskXiFPXiZNXilvXiEiXiQlXiF6XiI2XiUmXiQ+XipBXiZXXiY/XiNLXiYvXiIwXi5rXipKXiJkXikhXi1qXipBIA==",
      "byte_length": 97
    },
    {
      "unit_id": "DLG_b0f5d96e6691",
      "text": "正在完成某種邪惡的儀式。我召喚了我的同伴，而巴爾卡札則召喚了他的巴布魔 ",
      "encoded_ascii": "^%H^\"d^#,^$$^%$^'$^)\"^#y^&Z^+'^#X^!\"^$%^\"@^\"U^*D^$%^&Z^\"E^1h^*A^'W^#K^&/^\"0^.k^!x^\"@^\"U^*D^!@^&Z^#K^.`^*0 ",
      "encoded_base64": "XiVIXiJkXiMsXiQkXiUkXickXikiXiN5XiZaXisnXiNYXiEiXiQlXiJAXiJVXipEXiQlXiZaXiJFXjFoXipBXidXXiNLXiYvXiIwXi5rXiF4XiJAXiJVXipEXiFAXiZaXiNLXi5gXiowIA==",
      "byte_length": 106
    },
    {
      "unit_id": "DLG_a464a1e3b7a2",
      "text": "與弗洛魔。我們鏖戰至深夜，鮮血染紅了神廟的地面。 ",
      "encoded_ascii": "^'p^#[^%g^*0^!\"^$%^*{^>r^$(^'n^2*^+c^*A^35^(:^%%^3!^*D^&w^0[^&Z^\"e^)j^!\" ",
      "encoded_base64": "XidwXiNbXiVnXiowXiEiXiQlXip7Xj5yXiQoXiduXjIqXitjXipBXjM1Xig6XiUlXjMhXipEXiZ3XjBbXiZaXiJlXilqXiEiIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_1a94dd768219",
      "text": "  讓我猜猜——你們輸了？",
      "encoded_ascii": "  ^-}^$%^-'^-'^*n^*n^*F^*{^>A^*D^.V",
      "encoded_base64": "ICBeLX1eJCVeLSdeLSdeKm5eKm5eKkZeKntePkFeKkReLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_621f6558052f",
      "text": "  結果如何？",
      "encoded_ascii": "  ^'@^%!^#$^!L^.V",
      "encoded_base64": "ICBeJ0BeJSFeIyReIUxeLlY=",
      "byte_length": 17
    },
    {
      "unit_id": "DLG_9cfa89c09819",
      "text": "我沒時間聽明擺著的事。再見。",
      "encoded_ascii": "^$%^%\\^$f^)G^-X^$c^1@^-a^&Z^*r^!\"^!l^-m^!\"",
      "encoded_base64": "XiQlXiVcXiRmXilHXi1YXiRjXjFAXi1hXiZaXipyXiEiXiFsXi1tXiEi",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_e90ef576e7f5",
      "text": "巴爾卡札不斷召喚他的爪牙，我們最終因寡不敵眾而 ",
      "encoded_ascii": "^#K^&/^\"0^.k^!)^,T^\"@^\"U^!@^&Z^&.^&3^*A^$%^*{^$q^-H^\"]^8x^!)^$U^&e^'W ",
      "encoded_base64": "XiNLXiYvXiIwXi5rXiEpXixUXiJAXiJVXiFAXiZaXiYuXiYzXipBXiQlXip7XiRxXi1IXiJdXjh4XiEpXiRVXiZlXidXIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_74d4547f3a58",
      "text": "潰敗。我的同伴皆已長眠，但我仍受職責束縛而留存。我之所以告訴你們這些， ",
      "encoded_ascii": "^2-^$R^!\"^$%^&Z^\"E^1h^5j^#J^)C^24^*A^!I^$%^!?^\";^'\\^0>^$|^3W^'W^-+^#*^!\"^$%^!/^$)^!B^+B^-t^*F^*{^(s^!8^*A ",
      "encoded_base64": "XjItXiRSXiEiXiQlXiZaXiJFXjFoXjVqXiNKXilDXjI0XipBXiFJXiQlXiE/XiI7XidcXjA+XiR8XjNXXidXXi0rXiMqXiEiXiQlXiEvXiQpXiFCXitCXi10XipGXip7XihzXiE4XipBIA==",
      "byte_length": 106
    },
    {
      "unit_id": "DLG_1169cfd4181f",
      "text": "是因為現在你們必須協助光復這座神廟。 ",
      "encoded_ascii": "^,X^\"]^%{^&?^\"d^*F^*{^#l^)r^2[^\"#^!c^#g^(s^/_^&w^0[^!\" ",
      "encoded_base64": "XixYXiJdXiV7XiY/XiJkXipGXip7XiNsXilyXjJbXiIjXiFjXiNnXihzXi9fXiZ3XjBbXiEiIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_8e2b0d5be17c",
      "text": "  你一開始就可以這麼說的。",
      "encoded_ascii": "  ^*F^!%^)F^+k^*J^\"A^!B^(s^.T^-x^&Z^!\"",
      "encoded_base64": "ICBeKkZeISVeKUZeK2teKkpeIkFeIUJeKHNeLlReLXheJlpeISI=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_d5dbbd9f606b",
      "text": "  這當中的寓意是什麼？我被搞糊塗了。 ",
      "encoded_ascii": "  ^(s^&N^!,^&Z^>p^#z^,X^!=^.T^.V^$%^(@^:R^'8^;+^*D^!\" ",
      "encoded_base64": "ICBeKHNeJk5eISxeJlpePnBeI3peLFheIT1eLlReLlZeJCVeKEBeOlJeJzheOyteKkReISIg",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_fd96678ce72f",
      "text": "  就這樣？我可沒感受到什麼啟發。 ",
      "encoded_ascii": "  ^*J^(s^,f^.V^$%^\"A^%\\^#{^\";^!u^!=^.T^57^&W^!\" ",
      "encoded_base64": "ICBeKkpeKHNeLGZeLlZeJCVeIkFeJVxeI3teIjteIXVeIT1eLlReNTdeJldeISIg",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_f494105eaf09",
      "text": "好吧。挺有意思的。再見。 ",
      "encoded_ascii": "^+i^*I^!\"^,I^$s^#z^#q^&Z^!\"^!l^-m^!\" ",
      "encoded_base64": "XitpXipJXiEiXixJXiRzXiN6XiNxXiZaXiEiXiFsXi1tXiEiIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_7db47322aa45",
      "text": "祝你好運，旅人。願你的宿命不會太痛苦。 ",
      "encoded_ascii": "^&v^*F^+i^.4^*A^2m^!<^!\"^.H^*F^&Z^7+^\"N^!)^$r^+f^-.^.t^!\" ",
      "encoded_base64": "XiZ2XipGXitpXi40XipBXjJtXiE8XiEiXi5IXipGXiZaXjcrXiJOXiEpXiRyXitmXi0uXi50XiEiIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_f87b36508a3b",
      "text": "你們缺乏洞察力。若我不相信這會對你們有所幫助，我就不會將這些告訴 ",
      "encoded_ascii": "^*F^*{^7e^;'^%h^#2^!~^!\"^'x^$%^!)^&a^!U^(s^$r^#:^*F^*{^$s^$)^+}^\"#^*A^$%^*J^!)^$r^#7^(s^!8^+B^-t ",
      "encoded_base64": "XipGXip7XjdlXjsnXiVoXiMyXiF+XiEiXid4XiQlXiEpXiZhXiFVXihzXiRyXiM6XipGXip7XiRzXiQpXit9XiIjXipBXiQlXipKXiEpXiRyXiM3XihzXiE4XitCXi10IA==",
      "byte_length": 97
    },
    {
      "unit_id": "DLG_99d17d1f20cc",
      "text": "你們。巴爾卡札依仗他的爪牙，但他無比狂妄。那正是他的 ",
      "encoded_ascii": "^*F^*{^!\"^#K^&/^\"0^.k^!Q^0|^!@^&Z^&.^&3^*A^!I^!@^%}^,m^&8^+j^!\"^)!^%H^,X^!@^&Z ",
      "encoded_base64": "XipGXip7XiEiXiNLXiYvXiIwXi5rXiFRXjB8XiFAXiZaXiYuXiYzXipBXiFJXiFAXiV9XixtXiY4XitqXiEiXikhXiVIXixYXiFAXiZaIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_558b3b9ab42f",
      "text": "破綻與敗亡之源。你們明白了嗎？ ",
      "encoded_ascii": "^&n^'H^'p^$R^!:^!/^%q^!\"^*F^*{^$c^&X^*D^+X^.V ",
      "encoded_base64": "XiZuXidIXidwXiRSXiE6XiEvXiVxXiEiXipGXip7XiRjXiZYXipEXitYXi5WIA==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_81619fd67b3b",
      "text": "要知道巴爾卡札威能強大——我懷疑連你們都無法擊敗他。須知 ",
      "encoded_ascii": "^(C^&h^(y^#K^&/^\"0^.k^#&^'b^#]^\"z^*n^*n^$%^,9^0p^.0^*F^*{^)$^%}^%b^$F^$R^!@^!\"^)r^&h ",
      "encoded_base64": "XihDXiZoXih5XiNLXiYvXiIwXi5rXiMmXidiXiNdXiJ6XipuXipuXiQlXiw5XjBwXi4wXipGXip7XikkXiV9XiViXiRGXiRSXiFAXiEiXilyXiZoIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_14f567045377",
      "text": "他的弱點就在於其傲慢與對力量的渴求。若你們試圖直接正面強攻巴爾卡札， ",
      "encoded_ascii": "^!@^&Z^#\\^*;^*J^\"d^$^^!j^1j^#~^'p^#:^!~^)*^&Z^,w^,n^!\"^'x^*F^*{^-u^\"b^&`^$?^%H^)j^#]^$O^#K^&/^\"0^.k^*A ",
      "encoded_base64": "XiFAXiZaXiNcXio7XipKXiJkXiReXiFqXjFqXiN+XidwXiM6XiF+XikqXiZaXix3XixuXiEiXid4XipGXip7Xi11XiJiXiZgXiQ/XiVIXilqXiNdXiRPXiNLXiYvXiIwXi5rXipBIA==",
      "byte_length": 103
    },
    {
      "unit_id": "DLG_c3dd89553e17",
      "text": "必敗無疑。你們明白了嗎？ ",
      "encoded_ascii": "^#l^$R^%}^0p^!\"^*F^*{^$c^&X^*D^+X^.V ",
      "encoded_base64": "XiNsXiRSXiV9XjBwXiEiXipGXip7XiRjXiZYXipEXitYXi5WIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_07b5d02bf287",
      "text": "誠然如此，但你們必須明白為何要這麼做。毫無緣由地殺戮 ",
      "encoded_ascii": "^2E^&\"^#$^%I^*A^!I^*F^*{^#l^)r^$c^&X^%{^!L^(C^(s^.T^*~^!\"^/t^%}^9J^&I^\"e^%M^,: ",
      "encoded_base64": "XjJFXiYiXiMkXiVJXipBXiFJXipGXip7XiNsXilyXiRjXiZYXiV7XiFMXihDXihzXi5UXip+XiEiXi90XiV9XjlKXiZJXiJlXiVNXiw6IA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_15b897be37e4",
      "text": "等同於謀殺——懷抱理解去誅滅才是真正的制勝匡正。你們 ",
      "encoded_ascii": "^'-^\"E^$^^3~^%M^*n^*n^,9^,@^&A^(I^\"6^<0^%t^$,^,X^-2^%H^&Z^!v^+5^>o^%H^!\"^*F^*{ ",
      "encoded_base64": "XictXiJFXiReXjN+XiVNXipuXipuXiw5XixAXiZBXihJXiI2XjwwXiV0XiQsXixYXi0yXiVIXiZaXiF2Xis1Xj5vXiVIXiEiXipGXip7IA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_0a6a99cb4293",
      "text": "明白了嗎？這是為了正義的公道審判。 ",
      "encoded_ascii": "^$c^&X^*D^+X^.V^(s^,X^%{^*D^%H^2<^&Z^3:^(y^7V^1k^!\" ",
      "encoded_base64": "XiRjXiZYXipEXitYXi5WXihzXixYXiV7XipEXiVIXjI8XiZaXjM6Xih5XjdWXjFrXiEiIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_fa905a1ef8b9",
      "text": "你們必須醫治那些瑪格拉奴隸——除非此地再次出現 ",
      "encoded_ascii": "^*F^*{^#l^)r^<J^%_^)!^!8^-*^%*^$6^##^)Z^*n^*n^)Q^)i^%I^\"e^!l^%D^!q^&? ",
      "encoded_base64": "XipGXip7XiNsXilyXjxKXiVfXikhXiE4Xi0qXiUqXiQ2XiMjXilaXipuXipuXilRXilpXiVJXiJlXiFsXiVEXiFxXiY/IA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_f60ac0edd837",
      "text": "仁慈與慷慨之善舉，否則我無法使這座神廟重獲新生。 ",
      "encoded_ascii": "^37^3H^'p^70^7/^!/^1(^01^*A^\"H^!x^$%^%}^%b^!N^(s^/_^&w^0[^))^&:^$\\^&F^!\" ",
      "encoded_base64": "XjM3XjNIXidwXjcwXjcvXiEvXjEoXjAxXipBXiJIXiF4XiQlXiV9XiViXiFOXihzXi9fXiZ3XjBbXikpXiY6XiRcXiZGXiEiIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_e4af994222c5",
      "text": "  瑪格拉人跟這件事有什麼關係？ ",
      "encoded_ascii": "  ^-*^%*^$6^!<^.+^(s^.W^*r^$s^!=^.T^.>^38^.V ",
      "encoded_base64": "ICBeLSpeJSpeJDZeITxeLiteKHNeLldeKnJeJHNeIT1eLlReLj5eMzheLlYg",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_158cd1675eca",
      "text": "  我該如何醫治他們所有人？ ",
      "encoded_ascii": "  ^$%^(M^#$^!L^<J^%_^!@^*{^$)^$s^!<^.V ",
      "encoded_base64": "ICBeJCVeKE1eIyReIUxePEpeJV9eIUBeKnteJCleJHNeITxeLlYg",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_f51c34dcb457",
      "text": "  行啊。總不可能比剛才那個故事更糟糕……",
      "encoded_ascii": "  ^(;^+Q^!\"^-M^!)^\"A^'b^,m^+0^$,^)!^!V^5U^*r^$o^-E^4\\^*o^*o",
      "encoded_base64": "ICBeKDteK1FeISJeLU1eISleIkFeJ2JeLG1eKzBeJCxeKSFeIVZeNVVeKnJeJG9eLUVeNFxeKm9eKm8=",
      "byte_length": 59
    },
    {
      "unit_id": "DLG_12d4ea678be0",
      "text": "  很好，我願意幫忙。你能給我什麼協助嗎？",
      "encoded_ascii": "  ^*K^+i^*A^$%^.H^#z^+}^,+^!\"^*F^'b^'A^$%^!=^.T^2[^\"#^+X^.V",
      "encoded_base64": "ICBeKkteK2leKkFeJCVeLkheI3peK31eLCteISJeKkZeJ2JeJ0FeJCVeIT1eLlReMlteIiNeK1heLlY=",
      "byte_length": 59
    },
    {
      "unit_id": "DLG_249dddd09db5",
      "text": "  你為何不自己使用那個房間？",
      "encoded_ascii": "  ^*F^%{^!L^!)^'l^#I^!N^&H^)!^!V^,<^)G^.V",
      "encoded_base64": "ICBeKkZeJXteIUxeISleJ2xeI0leIU5eJkheKSFeIVZeLDxeKUdeLlY=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_907a36a2704a",
      "text": "  太好了。你能幫我對付巴爾卡札嗎？",
      "encoded_ascii": "  ^+f^+i^*D^!\"^*F^'b^+}^$%^#:^*u^#K^&/^\"0^.k^+X^.V",
      "encoded_base64": "ICBeK2ZeK2leKkReISJeKkZeJ2JeK31eJCVeIzpeKnVeI0teJi9eIjBeLmteK1heLlY=",
      "byte_length": 50
    },
    {
      "unit_id": "DLG_96bde4bf220d",
      "text": "  我想我現在就去用那個房間……",
      "encoded_ascii": "  ^$%^,1^$%^&?^\"d^*J^\"6^&H^)!^!V^,<^)G^*o^*o",
      "encoded_base64": "ICBeJCVeLDFeJCVeJj9eImReKkpeIjZeJkheKSFeIVZeLDxeKUdeKm9eKm8=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_244580965781",
      "text": "算了。再見。",
      "encoded_ascii": "^-C^*D^!\"^!l^-m^!\"",
      "encoded_base64": "Xi1DXipEXiEiXiFsXi1tXiEi",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_71dd74ce71d0",
      "text": "他們曾是巨龍之腹的原住居民，也是親手建造這座 ",
      "encoded_ascii": "^!@^*{^.j^,X^#H^*>^!/^3%^&Z^\"5^*z^+w^%T^*A^!1^,X^(F^$+^,'^(v^(s^/_ ",
      "encoded_base64": "XiFAXip7Xi5qXixYXiNIXio+XiEvXjMlXiZaXiI1Xip6Xit3XiVUXipBXiExXixYXihGXiQrXiwnXih2XihzXi9fIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_f208b62cdac2",
      "text": "神廟之人。必須先醫治好他們，神廟才能開始復甦——創造者 ",
      "encoded_ascii": "^&w^0[^!/^!<^!\"^#l^)r^!b^<J^%_^+i^!@^*{^*A^&w^0[^$,^'b^)F^+k^#g^6e^*n^*n^!{^(v^'V ",
      "encoded_base64": "XiZ3XjBbXiEvXiE8XiEiXiNsXilyXiFiXjxKXiVfXitpXiFAXip7XipBXiZ3XjBbXiQsXidiXilGXitrXiNnXjZlXipuXipuXiF7Xih2XidWIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_cbab802f52d0",
      "text": "安好，被創造之物才能重獲生機。 ",
      "encoded_ascii": "^+p^+i^*A^(@^!{^(v^!/^&4^$,^'b^))^&:^&F^%>^!\" ",
      "encoded_base64": "XitwXitpXipBXihAXiF7Xih2XiEvXiY0XiQsXidiXikpXiY6XiZGXiU+XiEiIA==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_cf80a1c0a2df",
      "text": "這座神廟裡有一間特殊的密室——痊癒之室。凡踏入其中的人， ",
      "encoded_ascii": "^(s^/_^&w^0[^-j^$s^!%^)G^&5^9!^&Z^#0^+r^*n^*n^--^&V^!/^+r^!\"^+-^.,^!f^!j^!,^&Z^!<^*A ",
      "encoded_base64": "XihzXi9fXiZ3XjBbXi1qXiRzXiElXilHXiY1XjkhXiZaXiMwXityXipuXipuXi0tXiZWXiEvXityXiEiXistXi4sXiFmXiFqXiEsXiZaXiE8XipBIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_db490df4ff56",
      "text": "所有傷勢都會痊癒。自從遭到褻瀆以來，這個房間便不再運作， ",
      "encoded_ascii": "^$)^$s^!^^\"&^)$^$r^--^&V^!\"^'l^#f^(}^!u^-k^,~^!B^!O^*A^(s^!V^,<^)G^!R^!)^!l^.4^!M^*A ",
      "encoded_base64": "XiQpXiRzXiFeXiImXikkXiRyXi0tXiZWXiEiXidsXiNmXih9XiF1Xi1rXix+XiFCXiFPXipBXihzXiFWXiw8XilHXiFSXiEpXiFsXi40XiFNXipBIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_d0399d567287",
      "text": "但只要將瑪格拉人帶到那裡，就能重新啟動它。 ",
      "encoded_ascii": "^!I^\"?^(C^#7^-*^%*^$6^!<^#N^!u^)!^-j^*A^*J^'b^))^$\\^57^\"%^+o^!\" ",
      "encoded_base64": "XiFJXiI/XihDXiM3Xi0qXiUqXiQ2XiE8XiNOXiF1XikhXi1qXipBXipKXidiXikpXiRcXjU3XiIlXitvXiEiIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_863ad4e36e3a",
      "text": "你們不聽從我的忠告，還侮辱我的幫助。你們就像個亂發脾氣的 ",
      "encoded_ascii": "^*F^*{^!)^-X^#f^$%^&Z^.d^+B^*A^.7^9+^3`^$%^&Z^+}^\"#^!\"^*F^*{^*J^!`^!V^!3^&W^;7^%U^&Z ",
      "encoded_base64": "XipGXip7XiEpXi1YXiNmXiQlXiZaXi5kXitCXipBXi43XjkrXjNgXiQlXiZaXit9XiIjXiEiXipGXip7XipKXiFgXiFWXiEzXiZXXjs3XiVVXiZaIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_b473ec84fe67",
      "text": "小孩。現在離開，等你們『長大』了再來。",
      "encoded_ascii": "^#;^+m^!\"^&?^\"d^)`^)F^*A^'-^*F^*{^<_^)C^\"z^<`^*D^!l^!O^!\"",
      "encoded_base64": "XiM7XittXiEiXiY/XiJkXilgXilGXipBXictXipGXip7XjxfXilDXiJ6XjxgXipEXiFsXiFPXiEi",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_9bf6183bde8a",
      "text": "若你們醫治好瑪格拉人，痊癒之室也會對你們起效。然而，你們 ",
      "encoded_ascii": "^'x^*F^*{^<J^%_^+i^-*^%*^$6^!<^*A^--^&V^!/^+r^!1^$r^#:^*F^*{^.(^$Q^!\"^&\"^'W^*A^*F^*{ ",
      "encoded_base64": "Xid4XipGXip7XjxKXiVfXitpXi0qXiUqXiQ2XiE8XipBXi0tXiZWXiEvXityXiExXiRyXiM6XipGXip7Xi4oXiRRXiEiXiYiXidXXipBXipGXip7IA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_5283c5dcb1b4",
      "text": "必須先帶他們來這裡醫治。一旦大功告成，你們隨時都可以回來。 ",
      "encoded_ascii": "^#l^)r^!b^#N^!@^*{^!O^(s^-j^<J^%_^!\"^!%^1C^\"z^\"!^+B^$$^*A^*F^*{^)X^$f^)$^\"A^!B^\"\\^!O^!\" ",
      "encoded_base64": "XiNsXilyXiFiXiNOXiFAXip7XiFPXihzXi1qXjxKXiVfXiEiXiElXjFDXiJ6XiIhXitCXiQkXipBXipGXip7XilYXiRmXikkXiJBXiFCXiJcXiFPXiEiIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_bba31fef50cd",
      "text": "就連死亡也能在那裡得到逆轉。 ",
      "encoded_ascii": "^*J^.0^%L^!:^!1^'b^\"d^)!^-j^#e^!u^8c^(i^!\" ",
      "encoded_base64": "XipKXi4wXiVMXiE6XiExXidiXiJkXikhXi1qXiNlXiF1XjhjXihpXiEiIA==",
      "byte_length": 43
    },
    {
      "unit_id": "DLG_faa666257636",
      "text": "我活得比應當的歲月還要漫長。因巴爾卡札的邪惡，我的生命被異常地 ",
      "encoded_ascii": "^$%^%i^#e^,m^0`^&N^&Z^,j^/p^.7^(C^2,^)C^!\"^\"]^#K^&/^\"0^.k^&Z^)\"^#y^*A^$%^&Z^&F^\"N^(@^&M^#O^\"e ",
      "encoded_base64": "XiQlXiVpXiNlXixtXjBgXiZOXiZaXixqXi9wXi43XihDXjIsXilDXiEiXiJdXiNLXiYvXiIwXi5rXiZaXikiXiN5XipBXiQlXiZaXiZGXiJOXihAXiZNXiNPXiJlIA==",
      "byte_length": 94
    },
    {
      "unit_id": "DLG_c24975ceb6dd",
      "text": "延長，待到那邪惡消散之時，我終於能夠得到 ",
      "encoded_ascii": "^,&^)C^*A^,*^!u^)!^)\"^#y^%k^$S^!/^$f^*A^$%^-H^$^^'b^+d^#e^!u ",
      "encoded_base64": "XiwmXilDXipBXiwqXiF1XikhXikiXiN5XiVrXiRTXiEvXiRmXipBXiQlXi1IXiReXidiXitkXiNlXiF1IA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_59f40fd059cd",
      "text": "安息。我渴望那一刻——我不想再次復活重獲生命。 ",
      "encoded_ascii": "^+p^#w^!\"^$%^,w^,]^)!^!%^.Y^*n^*n^$%^!)^,1^!l^%D^#g^%i^))^&:^&F^\"N^!\" ",
      "encoded_base64": "XitwXiN3XiEiXiQlXix3XixdXikhXiElXi5ZXipuXipuXiQlXiEpXiwxXiFsXiVEXiNnXiVpXikpXiY6XiZGXiJOXiEiIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_bf36fff2abd7",
      "text": "我只能給你們忠告。首先，巴爾卡札無比狂妄，而他的傲慢 ",
      "encoded_ascii": "^$%^\"?^'b^'A^*F^*{^.d^+B^!\"^)~^!b^*A^#K^&/^\"0^.k^%}^,m^&8^+j^*A^'W^!@^&Z^1j^#~ ",
      "encoded_base64": "XiQlXiI/XidiXidBXipGXip7Xi5kXitCXiEiXil+XiFiXipBXiNLXiYvXiIwXi5rXiV9XixtXiY4XitqXipBXidXXiFAXiZaXjFqXiN+IA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_2d432714d6b9",
      "text": "能將他毀滅。其次，巴爾卡札極度依賴他召喚的魔怪。若你們 ",
      "encoded_ascii": "^'b^#7^!@^%N^%t^!\"^!j^%D^*A^#K^&/^\"0^.k^1D^#V^!Q^0t^!@^\"@^\"U^&Z^*0^#s^!\"^'x^*F^*{ ",
      "encoded_base64": "XidiXiM3XiFAXiVOXiV0XiEiXiFqXiVEXipBXiNLXiYvXiIwXi5rXjFEXiNWXiFRXjB0XiFAXiJAXiJVXiZaXiowXiNzXiEiXid4XipGXip7IA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_5ebfd21a52e1",
      "text": "能找到他的召喚媒介器具…… ",
      "encoded_ascii": "^'b^$/^!u^!@^&Z^\"@^\"U^#'^!>^\"V^!k^*o^*o ",
      "encoded_base64": "XidiXiQvXiF1XiFAXiZaXiJAXiJVXiMnXiE+XiJWXiFrXipvXipvIA==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_f60c776aa9ee",
      "text": "在醫治好那些奴隸之後回到這裡。或許到時我會有更多能 ",
      "encoded_ascii": "^\"d^<J^%_^+i^)!^!8^##^)Z^!/^#b^\"\\^!u^(s^-j^!\"^$'^-s^!u^$f^$%^$r^$s^$o^\"x^'b ",
      "encoded_base64": "XiJkXjxKXiVfXitpXikhXiE4XiMjXilaXiEvXiNiXiJcXiF1XihzXi1qXiEiXiQnXi1zXiF1XiRmXiQlXiRyXiRzXiRvXiJ4XidiIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_431b02e6cc65",
      "text": "提供給你們。願命運賜予你們榮耀。 ",
      "encoded_ascii": "^$A^!P^'A^*F^*{^!\"^.H^\"N^.4^.#^!4^*F^*{^,e^7D^!\" ",
      "encoded_base64": "XiRBXiFQXidBXipGXip7XiEiXi5IXiJOXi40Xi4jXiE0XipGXip7XixlXjdEXiEiIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_0cf56b767bf3",
      "text": "不行，你們必須先醫治那些奴隸。在那之後，只要你們踏入密室，它就會 ",
      "encoded_ascii": "^!)^(;^*A^*F^*{^#l^)r^!b^<J^%_^)!^!8^##^)Z^!\"^\"d^)!^!/^#b^*A^\"?^(C^*F^*{^.,^!f^#0^+r^*A^+o^*J^$r ",
      "encoded_base64": "XiEpXig7XipBXipGXip7XiNsXilyXiFiXjxKXiVfXikhXiE4XiMjXilaXiEiXiJkXikhXiEvXiNiXipBXiI/XihDXipGXip7Xi4sXiFmXiMwXityXipBXitvXipKXiRyIA==",
      "byte_length": 97
    },
    {
      "unit_id": "DLG_e12b0b241b32",
      "text": "為你們療傷。必須先醫治原初的創造者，神廟才會允許 ",
      "encoded_ascii": "^%{^*F^*{^&U^!^^!\"^#l^)r^!b^<J^%_^\"5^1\"^&Z^!{^(v^'V^*A^&w^0[^$,^$r^/\"^-s ",
      "encoded_base64": "XiV7XipGXip7XiZVXiFeXiEiXiNsXilyXiFiXjxKXiVfXiI1XjEiXiZaXiF7Xih2XidWXipBXiZ3XjBbXiQsXiRyXi8iXi1zIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_aaa0dacac489",
      "text": "你們獲得痊癒。 ",
      "encoded_ascii": "^*F^*{^&:^#e^--^&V^!\" ",
      "encoded_base64": "XipGXip7XiY6XiNlXi0tXiZWXiEiIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_9c152cb2d118",
      "text": "再見。或許我們稍後還會相見。",
      "encoded_ascii": "^!l^-m^!\"^$'^-s^$%^*{^-:^#b^.7^$r^&a^-m^!\"",
      "encoded_base64": "XiFsXi1tXiEiXiQnXi1zXiQlXip7Xi06XiNiXi43XiRyXiZhXi1tXiEi",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_0529d92b6b09",
      "text": "改變心意時隨時回來。在那之前，願命運溫柔待你。",
      "encoded_ascii": "^$N^(U^#k^#z^$f^)X^$f^\"\\^!O^!\"^\"d^)!^!/^!z^*A^.H^\"N^.4^%s^0f^,*^*F^!\"",
      "encoded_base64": "XiROXihVXiNrXiN6XiRmXilYXiRmXiJcXiFPXiEiXiJkXikhXiEvXiF6XipBXi5IXiJOXi40XiVzXjBmXiwqXipGXiEi",
      "byte_length": 69
    },
    {
      "unit_id": "DLG_40a0c0883aa1",
      "text": "我有什麼能為你們效勞的嗎？",
      "encoded_ascii": "^$%^$s^!=^.T^'b^%{^*F^*{^$Q^/R^&Z^+X^.V",
      "encoded_base64": "XiQlXiRzXiE9Xi5UXidiXiV7XipGXip7XiRRXi9SXiZaXitYXi5W",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_4c78d8659b86",
      "text": "  我希望能得到你的幫助……",
      "encoded_ascii": "  ^$%^+{^,]^'b^#e^!u^*F^&Z^+}^\"#^*o^*o",
      "encoded_base64": "ICBeJCVeK3teLF1eJ2JeI2VeIXVeKkZeJlpeK31eIiNeKm9eKm8=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_2ffb501426a9",
      "text": "  我要如何讓那些奴隸跟隨我？",
      "encoded_ascii": "  ^$%^(C^#$^!L^-}^)!^!8^##^)Z^.+^)X^$%^.V",
      "encoded_base64": "ICBeJCVeKENeIyReIUxeLX1eKSFeITheIyNeKVpeLiteKVheJCVeLlY=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_5e0a5866ec68",
      "text": "沒事了，再見。",
      "encoded_ascii": "^%\\^*r^*D^*A^!l^-m^!\"",
      "encoded_base64": "XiVcXipyXipEXipBXiFsXi1tXiEi",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_cdd2f309efbc",
      "text": "很好。記住， ",
      "encoded_ascii": "^*K^+i^!\"^(K^*z^*A ",
      "encoded_base64": "XipLXitpXiEiXihLXip6XipBIA==",
      "byte_length": 19
    },
    {
      "unit_id": "DLG_b6970e463c7a",
      "text": "盲眼者能夠讓奴隸們來到這裡。他是你們必須去交涉的關鍵。只有 ",
      "encoded_ascii": "^&_^&d^'V^'b^+d^-}^##^)Z^*{^!O^!u^(s^-j^!\"^!@^,X^*F^*{^#l^)r^\"6^0P^3O^&Z^.>^9x^!\"^\"?^$s ",
      "encoded_base64": "XiZfXiZkXidWXidiXitkXi19XiMjXilaXip7XiFPXiF1XihzXi1qXiEiXiFAXixYXipGXip7XiNsXilyXiI2XjBQXjNPXiZaXi4+Xjl4XiEiXiI/XiRzIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_408142057928",
      "text": "他才能讓奴隸們看清所謂的「轉化」徹頭徹尾是個騙局。 ",
      "encoded_ascii": "^!@^$,^'b^-}^##^)Z^*{^*Q^,u^$)^0s^&Z^!#^(i^\")^!$^18^)t^18^5J^,X^!V^.{^._^!\" ",
      "encoded_base64": "XiFAXiQsXidiXi19XiMjXilaXip7XipRXix1XiQpXjBzXiZaXiEjXihpXiIpXiEkXjE4Xil0XjE4XjVKXixYXiFWXi57Xi5fXiEiIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_eaa65acf2b26",
      "text": "我看見你們身邊還帶著另一位同伴。 ",
      "encoded_ascii": "^$%^*Q^-m^*F^*{^(c^.8^.7^#N^-a^\">^!%^!J^\"E^1h^!\" ",
      "encoded_base64": "XiQlXipRXi1tXipGXip7XihjXi44Xi43XiNOXi1hXiI+XiElXiFKXiJFXjFoXiEiIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_65476888f953",
      "text": "泰內利夫轉向盲眼的瑪格拉人。 ",
      "encoded_ascii": "^%f^!g^!t^\"{^(i^+?^&_^&d^&Z^-*^%*^$6^!<^!\" ",
      "encoded_base64": "XiVmXiFnXiF0XiJ7XihpXis/XiZfXiZkXiZaXi0qXiUqXiQ2XiE8XiEiIA==",
      "byte_length": 43
    },
    {
      "unit_id": "DLG_8b49fea7d2dd",
      "text": "問候你，盲眼者。你為自己的信仰飽受折磨，而很快地， ",
      "encoded_ascii": "^*Z^*|^*F^*A^&_^&d^'V^!\"^*F^%{^'l^#I^&Z^!U^4,^7r^\";^,?^-7^*A^'W^*K^*L^\"e^*A ",
      "encoded_base64": "XipaXip8XipGXipBXiZfXiZkXidWXiEiXipGXiV7XidsXiNJXiZaXiFVXjQsXjdyXiI7Xiw/Xi03XipBXidXXipLXipMXiJlXipBIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_e3bfe7b38b49",
      "text": "在這幾位英雄的相助之下，你與所有同胞的苦難都將 ",
      "encoded_ascii": "^\"d^(s^#T^!J^'y^)\\^&Z^&a^\"#^!/^!(^*A^*F^'p^$)^$s^\"E^'`^&Z^.t^)a^)$^#7 ",
      "encoded_base64": "XiJkXihzXiNUXiFKXid5XilcXiZaXiZhXiIjXiEvXiEoXipBXipGXidwXiQpXiRzXiJFXidgXiZaXi50XilhXikkXiM3IA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_4270566b9c8c",
      "text": "迎來終結。 ",
      "encoded_ascii": "^(k^!O^-H^'@^!\" ",
      "encoded_base64": "XihrXiFPXi1IXidAXiEiIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_ee7248590b88",
      "text": "我曾在夢中見過你。我雖盲不能視，卻能感受到你的存在，這給了我莫大的 ",
      "encoded_ascii": "^$%^.j^\"d^\"y^!,^-m^(x^*F^!\"^$%^.A^&_^!)^'b^(E^*A^1&^'b^#{^\";^!u^*F^&Z^#*^\"d^*A^(s^'A^*D^$%^/F^\"z^&Z ",
      "encoded_base64": "XiQlXi5qXiJkXiJ5XiEsXi1tXih4XipGXiEiXiQlXi5BXiZfXiEpXidiXihFXipBXjEmXidiXiN7XiI7XiF1XipGXiZaXiMqXiJkXipBXihzXidBXipEXiQlXi9GXiJ6XiZaIA==",
      "byte_length": 100
    },
    {
      "unit_id": "DLG_8b5d8bc636c8",
      "text": "安慰。我感謝你所付出的一切。你為神廟所做出的英勇防衛，將長久地 ",
      "encoded_ascii": "^+p^4<^!\"^$%^#{^-z^*F^$)^*u^!q^&Z^!%^+.^!\"^*F^%{^&w^0[^$)^*~^!q^&Z^'y^\"$^)K^(=^*A^#7^)C^!.^\"e ",
      "encoded_base64": "XitwXjQ8XiEiXiQlXiN7Xi16XipGXiQpXip1XiFxXiZaXiElXisuXiEiXipGXiV7XiZ3XjBbXiQpXip+XiFxXiZaXid5XiIkXilLXig9XipBXiM3XilDXiEuXiJlIA==",
      "byte_length": 94
    },
    {
      "unit_id": "DLG_75546ff12e6f",
      "text": "為人銘記。 ",
      "encoded_ascii": "^%{^!<^.;^(K^!\" ",
      "encoded_base64": "XiV7XiE8Xi47XihLXiEiIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_b557d1afaa20",
      "text": "謝謝你，盲眼者。現在去往神殿之中，讓你的傷勢得以痊癒吧。 ",
      "encoded_ascii": "^-z^-z^*F^*A^&_^&d^'V^!\"^&?^\"d^\"6^,)^&w^.m^!/^!,^*A^-}^*F^&Z^!^^\"&^#e^!B^--^&V^*I^!\" ",
      "encoded_base64": "Xi16Xi16XipGXipBXiZfXiZkXidWXiEiXiY/XiJkXiI2XiwpXiZ3Xi5tXiEvXiEsXipBXi19XipGXiZaXiFeXiImXiNlXiFCXi0tXiZWXipJXiEiIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_2b984ba05b6b",
      "text": "泰內利夫轉回面對你們。 ",
      "encoded_ascii": "^%f^!g^!t^\"{^(i^\"\\^)j^#:^*F^*{^!\" ",
      "encoded_base64": "XiVmXiFnXiF0XiJ7XihpXiJcXilqXiM6XipGXip7XiEiIA==",
      "byte_length": 34
    },
    {
      "unit_id": "DLG_b9bb84e2884b",
      "text": "英雄們，帶盲眼者去痊癒之室。靠近房門，機關便會啟動。 ",
      "encoded_ascii": "^'y^)\\^*{^*A^#N^&_^&d^'V^\"6^--^&V^!/^+r^!\"^.C^(l^,<^)D^*A^%>^.>^!R^$r^57^\"%^!\" ",
      "encoded_base64": "Xid5XilcXip7XipBXiNOXiZfXiZkXidWXiI2Xi0tXiZWXiEvXityXiEiXi5DXihsXiw8XilEXipBXiU+Xi4+XiFSXiRyXjU3XiIlXiEiIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_0c6af59932f6",
      "text": "我看見你們已經醫治好盲眼者了。 ",
      "encoded_ascii": "^$%^*Q^-m^*F^*{^#J^'D^<J^%_^+i^&_^&d^'V^*D^!\" ",
      "encoded_base64": "XiQlXipRXi1tXipGXip7XiNKXidEXjxKXiVfXitpXiZfXiZkXidWXipEXiEiIA==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_6a350be42449",
      "text": "泰內利夫，我對你無私的相助感激不盡。必須讓其他奴隸看清， ",
      "encoded_ascii": "^%f^!g^!t^\"{^*A^$%^#:^*F^%}^&~^&Z^&a^\"#^#{^1H^!)^-1^!\"^#l^)r^-}^!j^!@^##^)Z^*Q^,u^*A ",
      "encoded_base64": "XiVmXiFnXiF0XiJ7XipBXiQlXiM6XipGXiV9XiZ+XiZaXiZhXiIjXiN7XjFIXiEpXi0xXiEiXiNsXilyXi19XiFqXiFAXiMjXilaXipRXix1XipBIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_1f845925d545",
      "text": "巴爾卡札的承諾徹頭徹尾是場空談，重拾對這座神廟的信仰才至關 ",
      "encoded_ascii": "^#K^&/^\"0^.k^&Z^$0^7k^18^)t^18^5J^,X^\"n^'(^0;^*A^))^7[^#:^(s^/_^&w^0[^&Z^!U^4,^$,^'n^.> ",
      "encoded_base64": "XiNLXiYvXiIwXi5rXiZaXiQwXjdrXjE4Xil0XjE4XjVKXixYXiJuXicoXjA7XipBXikpXjdbXiM6XihzXi9fXiZ3XjBbXiZaXiFVXjQsXiQsXiduXi4+IA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_280bbbca16d5",
      "text": "重要。 ",
      "encoded_ascii": "^))^(C^!\" ",
      "encoded_base64": "XikpXihDXiEiIA==",
      "byte_length": 10
    },
    {
      "unit_id": "DLG_f111c43ed9d0",
      "text": "你確實信念堅定，盲眼者。我知道你定能帶領瑪格拉人走出 ",
      "encoded_ascii": "^*F^-6^#3^!U^1z^\"l^#.^*A^&_^&d^'V^!\"^$%^&h^(y^*F^#.^'b^#N^)s^-*^%*^$6^!<^.&^!q ",
      "encoded_base64": "XipGXi02XiMzXiFVXjF6XiJsXiMuXipBXiZfXiZkXidWXiEiXiQlXiZoXih5XipGXiMuXidiXiNOXilzXi0qXiUqXiQ2XiE8Xi4mXiFxIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_cd240c18ceb5",
      "text": "巴爾卡札的謊言迷霧。現在回地牢窩巢去，把其他人帶到這裡來。 ",
      "encoded_ascii": "^#K^&/^\"0^.k^&Z^3*^1Y^(n^)f^!\"^&?^\"d^\"\\^\"e^-$^=0^#G^\"6^*A^$1^!j^!@^!<^#N^!u^(s^-j^!O^!\" ",
      "encoded_base64": "XiNLXiYvXiIwXi5rXiZaXjMqXjFZXihuXilmXiEiXiY/XiJkXiJcXiJlXi0kXj0wXiNHXiI2XipBXiQxXiFqXiFAXiE8XiNOXiF1XihzXi1qXiFPXiEiIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_3020b1979717",
      "text": "盲眼者轉向你們。 ",
      "encoded_ascii": "^&_^&d^'V^(i^+?^*F^*{^!\" ",
      "encoded_base64": "XiZfXiZkXidWXihpXis/XipGXip7XiEiIA==",
      "byte_length": 25
    },
    {
      "unit_id": "DLG_bcbdceb3f4eb",
      "text": "旅人們，請帶我回地牢窩巢去吧。 ",
      "encoded_ascii": "^2m^!<^*{^*A^*S^#N^$%^\"\\^\"e^-$^=0^#G^\"6^*I^!\" ",
      "encoded_base64": "XjJtXiE8Xip7XipBXipTXiNOXiQlXiJcXiJlXi0kXj0wXiNHXiI2XipJXiEiIA==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_0aaf7bc19542",
      "text": "你們恢復了對神廟的信仰，我深表感激。此處的邪惡力量依然 ",
      "encoded_ascii": "^*F^*{^#u^#g^*D^#:^&w^0[^&Z^!U^4,^*A^$%^2*^-i^#{^1H^!\"^%I^(,^&Z^)\"^#y^!~^)*^!Q^&\" ",
      "encoded_base64": "XipGXip7XiN1XiNnXipEXiM6XiZ3XjBbXiZaXiFVXjQsXipBXiQlXjIqXi1pXiN7XjFIXiEiXiVJXigsXiZaXikiXiN5XiF+XikqXiFRXiYiIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_f45f10106bea",
      "text": "強大，但那很快就會改變。為了酬謝你們的高尚之舉，我贈予你們我的戒指。 ",
      "encoded_ascii": "^#]^\"z^*A^!I^)!^*K^*L^*J^$r^$N^(U^!\"^%{^*D^7o^-z^*F^*{^&Z^*+^+v^!/^01^*A^$%^([^!4^*F^*{^$%^&Z^$&^$8^!\" ",
      "encoded_base64": "XiNdXiJ6XipBXiFJXikhXipLXipMXipKXiRyXiROXihVXiEiXiV7XipEXjdvXi16XipGXip7XiZaXiorXit2XiEvXjAxXipBXiQlXihbXiE0XipGXip7XiQlXiZaXiQmXiQ4XiEiIA==",
      "byte_length": 103
    },
    {
      "unit_id": "DLG_8c29e3008617",
      "text": "現在，你們必須肅清這裡的邪惡，而達成此目標的方法只有一個—— ",
      "encoded_ascii": "^&?^\"d^*A^*F^*{^#l^)r^5y^,u^(s^-j^&Z^)\"^#y^*A^'W^(z^$$^%I^&^^%9^&Z^$]^%b^\"?^$s^!%^!V^*n^*n ",
      "encoded_base64": "XiY/XiJkXipBXipGXip7XiNsXilyXjV5Xix1XihzXi1qXiZaXikiXiN5XipBXidXXih6XiQkXiVJXiZeXiU5XiZaXiRdXiViXiI/XiRzXiElXiFWXipuXipuIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_3a4370060592",
      "text": "消滅那個名叫巴爾卡札的惡徒。他正密謀召喚「無名者」——那是足以 ",
      "encoded_ascii": "^%k^%t^)!^!V^\"F^+<^#K^&/^\"0^.k^&Z^#y^#d^!\"^!@^%H^#0^3~^\"@^\"U^!#^%}^\"F^'V^!$^*n^*n^)!^,X^(^^!B ",
      "encoded_base64": "XiVrXiV0XikhXiFWXiJGXis8XiNLXiYvXiIwXi5rXiZaXiN5XiNkXiEiXiFAXiVIXiMwXjN+XiJAXiJVXiEjXiV9XiJGXidWXiEkXipuXipuXikhXixYXiheXiFCIA==",
      "byte_length": 94
    },
    {
      "unit_id": "DLG_53b0bf3880e4",
      "text": "毀滅亞薩斯的至凶存在。 ",
      "encoded_ascii": "^%N^%t^!9^-e^$[^&Z^'n^3e^#*^\"d^!\" ",
      "encoded_base64": "XiVOXiV0XiE5Xi1lXiRbXiZaXiduXjNlXiMqXiJkXiEiIA==",
      "byte_length": 34
    },
    {
      "unit_id": "DLG_fc9190aadc8a",
      "text": "我們所有人的命運全掌握在你們手中。去阻止巴爾卡札，切莫讓他召喚出 ",
      "encoded_ascii": "^$%^*{^$)^$s^!<^&Z^\"N^.4^!h^$;^1>^\"d^*F^*{^$+^!,^!\"^\"6^)L^%G^#K^&/^\"0^.k^*A^+.^/F^-}^!@^\"@^\"U^!q ",
      "encoded_base64": "XiQlXip7XiQpXiRzXiE8XiZaXiJOXi40XiFoXiQ7XjE+XiJkXipGXip7XiQrXiEsXiEiXiI2XilMXiVHXiNLXiYvXiIwXi5rXipBXisuXi9GXi19XiFAXiJAXiJVXiFxIA==",
      "byte_length": 97
    },
    {
      "unit_id": "DLG_cf45b7c59a3e",
      "text": "「無名者」！ ",
      "encoded_ascii": "^!#^%}^\"F^'V^!$^*W ",
      "encoded_base64": "XiEjXiV9XiJGXidWXiEkXipXIA==",
      "byte_length": 19
    },
    {
      "unit_id": "DLG_c23b4ba15e15",
      "text": "你們化解了一場可怕的浩劫。我將我的護甲贈予你們以表謝意。用它來 ",
      "encoded_ascii": "^*F^*{^\")^(I^*D^!%^\"n^\"A^0^^&Z^5^^1l^!\"^$%^#7^$%^&Z^(T^&J^([^!4^*F^*{^!B^-i^-z^#z^!\"^&H^+o^!O ",
      "encoded_base64": "XipGXip7XiIpXihJXipEXiElXiJuXiJBXjBeXiZaXjVeXjFsXiEiXiQlXiM3XiQlXiZaXihUXiZKXihbXiE0XipGXip7XiFCXi1pXi16XiN6XiEiXiZIXitvXiFPIA==",
      "byte_length": 94
    },
    {
      "unit_id": "DLG_5dc16d4094f5",
      "text": "捍衛世間一切良善吧。我終於能夠安息了。永別了，生靈們。 ",
      "encoded_ascii": "^>q^(=^*p^)G^!%^+.^1V^1(^*I^!\"^$%^-H^$^^'b^+d^+p^#w^*D^!\"^%W^*H^*D^*A^&F^)g^*{^!\" ",
      "encoded_base64": "Xj5xXig9XipwXilHXiElXisuXjFWXjEoXipJXiEiXiQlXi1IXiReXidiXitkXitwXiN3XipEXiEiXiVXXipIXipEXipBXiZGXilnXip7XiEiIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_16c8c200c5d8",
      "text": "我也將我的寶藏賜予你們，感謝你們醫治了那些奴隸。",
      "encoded_ascii": "^$%^!1^#7^$%^&Z^#4^-f^.#^!4^*F^*{^*A^#{^-z^*F^*{^<J^%_^*D^)!^!8^##^)Z^!\"",
      "encoded_base64": "XiQlXiExXiM3XiQlXiZaXiM0Xi1mXi4jXiE0XipGXip7XipBXiN7Xi16XipGXip7XjxKXiVfXipEXikhXiE4XiMjXilaXiEi",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_c9b4d3121179",
      "text": "弗洛魔，退下！ ",
      "encoded_ascii": "^#[^%g^*0^*A^*V^!(^*W ",
      "encoded_base64": "XiNbXiVnXiowXipBXipWXiEoXipXIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_cbe9749e5496",
      "text": "巴爾卡札吟誦了幾段秘術咒文。大地隨之隆隆作響！在喧囂狂亂的 ",
      "encoded_ascii": "^#K^&/^\"0^.k^6L^7H^*D^#T^.l^1O^(<^\"P^$W^!\"^\"z^\"e^)X^!/^)T^)T^!M^)o^*W^\"d^;Y^5;^&8^!3^&Z ",
      "encoded_base64": "XiNLXiYvXiIwXi5rXjZMXjdIXipEXiNUXi5sXjFPXig8XiJQXiRXXiEiXiJ6XiJlXilYXiEvXilUXilUXiFNXilvXipXXiJkXjtZXjU7XiY4XiEzXiZaIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_c29aa389716f",
      "text": "最高潮處，巴爾卡札的嗓音攀升至頂點…… ",
      "encoded_ascii": "^$q^*+^=[^(,^*A^#K^&/^\"0^.k^&Z^<O^34^8|^\",^'n^)p^*;^*o^*o ",
      "encoded_base64": "XiRxXiorXj1bXigsXipBXiNLXiYvXiIwXi5rXiZaXjxPXjM0Xjh8XiIsXiduXilwXio7XipvXipvIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_487db313d3d8",
      "text": "卻在他口齒不清唸錯一段咒文時戛然而止！ ",
      "encoded_ascii": "^1&^\"d^!@^\"<^.U^!)^,u^.]^)5^!%^.l^\"P^$W^$f^<T^&\"^'W^%G^*W ",
      "encoded_base64": "XjEmXiJkXiFAXiI8Xi5VXiEpXix1Xi5dXik1XiElXi5sXiJQXiRXXiRmXjxUXiYiXidXXiVHXipXIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_a6bba9b93ed4",
      "text": "不！我不可能唸錯！那段咒文我可是苦練了許多年！ ",
      "encoded_ascii": "^!)^*W^$%^!)^\"A^'b^.]^)5^*W^)!^.l^\"P^$W^$%^\"A^,X^.t^-L^*D^-s^\"x^+~^*W ",
      "encoded_base64": "XiEpXipXXiQlXiEpXiJBXidiXi5dXik1XipXXikhXi5sXiJQXiRXXiQlXiJBXixYXi50Xi1MXipEXi1zXiJ4Xit+XipXIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_a6b3c0a17612",
      "text": "該死！我本以為這次抓到了訣竅！ ",
      "encoded_ascii": "^(M^%L^*W^$%^$x^!B^%{^(s^%D^$2^!u^*D^>w^8L^*W ",
      "encoded_base64": "XihNXiVMXipXXiQlXiR4XiFCXiV7XihzXiVEXiQyXiF1XipEXj53XjhMXipXIA==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_3919259bee5d",
      "text": "又來了！我明明肯定那是正確的！ ",
      "encoded_ascii": "^+;^!O^*D^*W^$%^$c^$c^-Z^#.^)!^,X^%H^-6^&Z^*W ",
      "encoded_base64": "Xis7XiFPXipEXipXXiQlXiRjXiRjXi1aXiMuXikhXixYXiVIXi02XiZaXipXIA==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_97f259865da5",
      "text": "好吧！我知道這次是哪裡出了問題…… ",
      "encoded_ascii": "^+i^*I^*W^$%^&h^(y^(s^%D^,X^+I^-j^!q^*D^*Z^.G^*o^*o ",
      "encoded_base64": "XitpXipJXipXXiQlXiZoXih5XihzXiVEXixYXitJXi1qXiFxXipEXipaXi5HXipvXipvIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_1cc55ca6e078",
      "text": "不！我知道我的做法完全正確！ ",
      "encoded_ascii": "^!)^*W^$%^&h^(y^$%^&Z^*~^%b^#,^!h^%H^-6^*W ",
      "encoded_base64": "XiEpXipXXiQlXiZoXih5XiQlXiZaXip+XiViXiMsXiFoXiVIXi02XipXIA==",
      "byte_length": 43
    },
    {
      "unit_id": "DLG_0a9126434c61",
      "text": "法陣轟然咆哮！ ",
      "encoded_ascii": "^%b^)P^.y^&\"^.[^.\\^*W ",
      "encoded_base64": "XiViXilQXi55XiYiXi5bXi5cXipXIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_3b820b81ce06",
      "text": "一個冰冷刺骨的聲音從法陣中傳了出來： ",
      "encoded_ascii": "^!%^!V^!m^!n^!w^*$^&Z^-W^34^#f^%b^)P^!,^+$^*D^!q^!O^*B ",
      "encoded_base64": "XiElXiFWXiFtXiFuXiF3XiokXiZaXi1XXjM0XiNmXiViXilQXiEsXiskXipEXiFxXiFPXipCIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_7a137f046be3",
      "text": "巴爾卡札！你這個蠢貨！你以為憑你微不足道的 ",
      "encoded_ascii": "^#K^&/^\"0^.k^*W^*F^(s^!V^.u^.w^*W^*F^!B^%{^,5^*F^#i^!)^(^^(y^&Z ",
      "encoded_base64": "XiNLXiYvXiIwXi5rXipXXipGXihzXiFWXi51Xi53XipXXipGXiFCXiV7Xiw1XipGXiNpXiEpXiheXih5XiZaIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_6381f3d8d55a",
      "text": "技藝就能召喚吾？你根本不配死在吾之手中——吾之爪牙會好好 ",
      "encoded_ascii": "^,>^3Z^*J^'b^\"@^\"U^;b^.V^*F^%)^$x^!)^)&^%L^\"d^;b^!/^$+^!,^*n^*n^;b^!/^&.^&3^$r^+i^+i ",
      "encoded_base64": "Xiw+XjNaXipKXidiXiJAXiJVXjtiXi5WXipGXiUpXiR4XiEpXikmXiVMXiJkXjtiXiEvXiQrXiEsXipuXipuXjtiXiEvXiYuXiYzXiRyXitpXitpIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_0cc61cfdf496",
      "text": "料理你和你的盟友！燃燒吧，巴爾卡札！ ",
      "encoded_ascii": "^/n^&A^*F^\"O^*F^&Z^-0^\"8^*W^&%^&&^*I^*A^#K^&/^\"0^.k^*W ",
      "encoded_base64": "Xi9uXiZBXipGXiJPXipGXiZaXi0wXiI4XipXXiYlXiYmXipJXipBXiNLXiYvXiIwXi5rXipXIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_96667afe15a3",
      "text": "巴爾卡札！你休想召喚得了吾！願吾之爪牙將你永遠焚燒殆盡 ",
      "encoded_ascii": "^#K^&/^\"0^.k^*W^*F^!G^,1^\"@^\"U^#e^*D^;b^*W^.H^;b^!/^&.^&3^#7^*F^%W^({^>u^&&^8H^-1 ",
      "encoded_base64": "XiNLXiYvXiIwXi5rXipXXipGXiFHXiwxXiJAXiJVXiNlXipEXjtiXipXXi5IXjtiXiEvXiYuXiYzXiM3XipGXiVXXih7Xj51XiYmXjhIXi0xIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_8bf0886aef30",
      "text": "永無止境！ ",
      "encoded_ascii": "^%W^%}^%G^\"q^*W ",
      "encoded_base64": "XiVXXiV9XiVHXiJxXipXIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_9ca041929f19",
      "text": "蠢蛋！吾告訴過你，吾絕非你能召喚之物！受死吧！ ",
      "encoded_ascii": "^.u^6\"^*W^;b^+B^-t^(x^*F^*A^;b^-I^)i^*F^'b^\"@^\"U^!/^&4^*W^\";^%L^*I^*W ",
      "encoded_base64": "Xi51XjYiXipXXjtiXitCXi10Xih4XipGXipBXjtiXi1JXilpXipGXidiXiJAXiJVXiEvXiY0XipXXiI7XiVMXipJXipXIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_c31410d09aa9",
      "text": "巴爾卡札！你比吾想像的還要無能！焚毀吧，為你的無能付出 ",
      "encoded_ascii": "^#K^&/^\"0^.k^*W^*F^,m^;b^,1^!`^&Z^.7^(C^%}^'b^*W^>u^%N^*I^*A^%{^*F^&Z^%}^'b^*u^!q ",
      "encoded_base64": "XiNLXiYvXiIwXi5rXipXXipGXixtXjtiXiwxXiFgXiZaXi43XihDXiV9XidiXipXXj51XiVOXipJXipBXiV7XipGXiZaXiV9XidiXip1XiFxIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_8c5ce0c66723",
      "text": "代價！ ",
      "encoded_ascii": "^*v^+&^*W ",
      "encoded_base64": "Xip2XismXipXIA==",
      "byte_length": 10
    },
    {
      "unit_id": "DLG_8bee3303c2fd",
      "text": "吾已經對此感到厭倦了，巴爾卡札。去死吧，好讓吾能永遠折磨你的靈魂！ ",
      "encoded_ascii": "^;b^#J^'D^#:^%I^#{^!u^+9^;(^*D^*A^#K^&/^\"0^.k^!\"^\"6^%L^*I^*A^+i^-}^;b^'b^%W^({^,?^-7^*F^&Z^)g^*.^*W ",
      "encoded_base64": "XjtiXiNKXidEXiM6XiVJXiN7XiF1Xis5XjsoXipEXipBXiNLXiYvXiIwXi5rXiEiXiI2XiVMXipJXipBXitpXi19XjtiXidiXiVXXih7Xiw/Xi03XipGXiZaXilnXiouXipXIA==",
      "byte_length": 100
    },
    {
      "unit_id": "DLG_5ef56eaf446c",
      "text": "我真高興能有像你們這樣的盟友！我知道自己錯在哪裡了，現在我就要 ",
      "encoded_ascii": "^$%^-2^*+^-]^'b^$s^!`^*F^*{^(s^,f^&Z^-0^\"8^*W^$%^&h^(y^'l^#I^)5^\"d^+I^-j^*D^*A^&?^\"d^$%^*J^(C ",
      "encoded_base64": "XiQlXi0yXiorXi1dXidiXiRzXiFgXipGXip7XihzXixmXiZaXi0wXiI4XipXXiQlXiZoXih5XidsXiNJXik1XiJkXitJXi1qXipEXipBXiY/XiJkXiQlXipKXihDIA==",
      "byte_length": 94
    },
    {
      "unit_id": "DLG_03b7ed4419ad",
      "text": "召喚無名者，整個亞薩斯都將在我們面前俯首稱臣！ ",
      "encoded_ascii": "^\"@^\"U^%}^\"F^'V^*A^$T^!V^!9^-e^$[^)$^#7^\"d^$%^*{^)j^!z^5*^)~^0&^.s^*W ",
      "encoded_base64": "XiJAXiJVXiV9XiJGXidWXipBXiRUXiFWXiE5Xi1lXiRbXikkXiM3XiJkXiQlXip7XilqXiF6XjUqXil+XjAmXi5zXipXIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_f2aa832049b5",
      "text": "唔。我想是我第三行的重音放得太重了……讓我再試一次。 ",
      "encoded_ascii": "^+N^!\"^$%^,1^,X^$%^',^!&^(;^&Z^))^34^$P^#e^+f^))^*D^*o^*o^-}^$%^!l^-u^!%^%D^!\" ",
      "encoded_base64": "XitOXiEiXiQlXiwxXixYXiQlXicsXiEmXig7XiZaXikpXjM0XiRQXiNlXitmXikpXipEXipvXipvXi19XiQlXiFsXi11XiElXiVEXiEiIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_1911f7687548",
      "text": "噢！現在我想起來了！是第四行！這次我一定能成！ ",
      "encoded_ascii": "^+]^*W^&?^\"d^$%^,1^.(^!O^*D^*W^,X^',^\"[^(;^*W^(s^%D^$%^!%^#.^'b^$$^*W ",
      "encoded_base64": "XitdXipXXiY/XiJkXiQlXiwxXi4oXiFPXipEXipXXixYXicsXiJbXig7XipXXihzXiVEXiQlXiElXiMuXidiXiQkXipXIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_74c59fdcdddc",
      "text": "不對嗎？唔……那一定是第五行！我知道一定是！這次絕不會錯！ ",
      "encoded_ascii": "^!)^#:^+X^.V^+N^*o^*o^)!^!%^#.^,X^',^!6^(;^*W^$%^&h^(y^!%^#.^,X^*W^(s^%D^-I^!)^$r^)5^*W ",
      "encoded_base64": "XiEpXiM6XitYXi5WXitOXipvXipvXikhXiElXiMuXixYXicsXiE2Xig7XipXXiQlXiZoXih5XiElXiMuXixYXipXXihzXiVEXi1JXiEpXiRyXik1XipXIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_3fa3ad46f718",
      "text": "或許是第一行……沒錯！當然！就是這樣！現在我一定能 ",
      "encoded_ascii": "^$'^-s^,X^',^!%^(;^*o^*o^%\\^)5^*W^&N^&\"^*W^*J^,X^(s^,f^*W^&?^\"d^$%^!%^#.^'b ",
      "encoded_base64": "XiQnXi1zXixYXicsXiElXig7XipvXipvXiVcXik1XipXXiZOXiYiXipXXipKXixYXihzXixmXipXXiY/XiJkXiQlXiElXiMuXidiIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_018ac07f2be1",
      "text": "唸對了！ ",
      "encoded_ascii": "^.]^#:^*D^*W ",
      "encoded_base64": "Xi5dXiM6XipEXipXIA==",
      "byte_length": 13
    },
    {
      "unit_id": "DLG_6e400e1d7aa4",
      "text": "  行吧。召喚無名者吧！ ",
      "encoded_ascii": "  ^(;^*I^!\"^\"@^\"U^%}^\"F^'V^*I^*W ",
      "encoded_base64": "ICBeKDteKkleISJeIkBeIlVeJX1eIkZeJ1ZeKkleKlcg",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_6fd1bee98a03",
      "text": "  你確定自己還記得該怎麼做嗎？",
      "encoded_ascii": "  ^*F^-6^#.^'l^#I^.7^(K^#e^(M^,,^.T^*~^+X^.V",
      "encoded_base64": "ICBeKkZeLTZeIy5eJ2xeI0leLjdeKEteI2VeKE1eLCxeLlReKn5eK1heLlY=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_af575b10d908",
      "text": "  你確定自己真的辦得到嗎？",
      "encoded_ascii": "  ^*F^-6^#.^'l^#I^-2^&Z^2L^#e^!u^+X^.V",
      "encoded_base64": "ICBeKkZeLTZeIy5eJ2xeI0leLTJeJlpeMkxeI2VeIXVeK1heLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_e7560e0637be",
      "text": "  你就不能唸對一次嗎？！ ",
      "encoded_ascii": "  ^*F^*J^!)^'b^.]^#:^!%^%D^+X^.V^*W ",
      "encoded_base64": "ICBeKkZeKkpeISleJ2JeLl1eIzpeISVeJUReK1heLlZeKlcg",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_5e0c7ddee361",
      "text": "  我真的開始懷疑你到底行不行了。",
      "encoded_ascii": "  ^$%^-2^&Z^)F^+k^,9^0p^*F^!u^/^^(;^!)^(;^*D^!\"",
      "encoded_base64": "ICBeJCVeLTJeJlpeKUZeK2teLDleMHBeKkZeIXVeL15eKDteISleKDteKkReISI=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_4a3730d4133f",
      "text": "  這套把戲已經令人厭煩了，巴爾卡札。",
      "encoded_ascii": "  ^(s^#!^$1^,;^#J^'D^*w^!<^+9^-!^*D^*A^#K^&/^\"0^.k^!\"",
      "encoded_base64": "ICBeKHNeIyFeJDFeLDteI0peJ0ReKndeITxeKzleLSFeKkReKkFeI0teJi9eIjBeLmteISI=",
      "byte_length": 53
    },
    {
      "unit_id": "DLG_3c4402ab3871",
      "text": "  放棄吧！",
      "encoded_ascii": "  ^$P^,a^*I^*W",
      "encoded_base64": "ICBeJFBeLGFeKkleKlc=",
      "byte_length": 14
    },
    {
      "unit_id": "DLG_2a630a771a4f",
      "text": "  你真可憐！受死吧！ ",
      "encoded_ascii": "  ^*F^-2^\"A^1}^*W^\";^%L^*I^*W ",
      "encoded_base64": "ICBeKkZeLTJeIkFeMX1eKldeIjteJUxeKkleKlcg",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_b89f6a85b511",
      "text": "算了！我要走了！ ",
      "encoded_ascii": "^-C^*D^*W^$%^(C^.&^*D^*W ",
      "encoded_base64": "Xi1DXipEXipXXiQlXihDXi4mXipEXipXIA==",
      "byte_length": 25
    },
    {
      "unit_id": "DLG_52dd6209e325",
      "text": "蠢貨！我發誓要讓你們死得痛苦萬分！",
      "encoded_ascii": "^.u^.w^*W^$%^&W^-w^(C^-}^*F^*{^%L^#e^-.^.t^-_^!s^*W",
      "encoded_base64": "Xi51Xi53XipXXiQlXiZXXi13XihDXi19XipGXip7XiVMXiNlXi0uXi50Xi1fXiFzXipX",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_482790e487a0",
      "text": "巴爾卡札迅速唸出一段咒文！",
      "encoded_ascii": "^#K^&/^\"0^.k^(j^(u^.]^!q^!%^.l^\"P^$W^*W",
      "encoded_base64": "XiNLXiYvXiIwXi5rXihqXih1Xi5dXiFxXiElXi5sXiJQXiRXXipX",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_a97c3387f07e",
      "text": "不！你們休想離開！你們要麼親眼看著我召喚無名者，要麼就 ",
      "encoded_ascii": "^!)^*W^*F^*{^!G^,1^)`^)F^*W^*F^*{^(C^.T^(F^&d^*Q^-a^$%^\"@^\"U^%}^\"F^'V^*A^(C^.T^*J ",
      "encoded_base64": "XiEpXipXXipGXip7XiFHXiwxXilgXilGXipXXipGXip7XihDXi5UXihGXiZkXipRXi1hXiQlXiJAXiJVXiV9XiJGXidWXipBXihDXi5UXipKIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_1fcc48c15f04",
      "text": "給我去死！ ",
      "encoded_ascii": "^'A^$%^\"6^%L^*W ",
      "encoded_base64": "XidBXiQlXiI2XiVMXipXIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_09adad827dee",
      "text": "  好吧。召喚他吧。 ",
      "encoded_ascii": "  ^+i^*I^!\"^\"@^\"U^!@^*I^!\" ",
      "encoded_base64": "ICBeK2leKkleISJeIkBeIlVeIUBeKkleISIg",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_2b796405d182",
      "text": "  就憑你？！我懷疑你連個僕從都召喚不出來！ ",
      "encoded_ascii": "  ^*J^,5^*F^.V^*W^$%^,9^0p^*F^.0^!V^+%^#f^)$^\"@^\"U^!)^!q^!O^*W ",
      "encoded_base64": "ICBeKkpeLDVeKkZeLlZeKldeJCVeLDleMHBeKkZeLjBeIVZeKyVeI2ZeKSReIkBeIlVeISleIXFeIU9eKlcg",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_66730530e8b7",
      "text": "很好！我現在就要召喚無名者！ ",
      "encoded_ascii": "^*K^+i^*W^$%^&?^\"d^*J^(C^\"@^\"U^%}^\"F^'V^*W ",
      "encoded_base64": "XipLXitpXipXXiQlXiY/XiJkXipKXihDXiJAXiJVXiV9XiJGXidWXipXIA==",
      "byte_length": 43
    },
    {
      "unit_id": "DLG_a4b7d9a3aad4",
      "text": "當然！剛才只是一點小小的失算，才妨礙了我召喚 ",
      "encoded_ascii": "^&N^&\"^*W^+0^$,^\"?^,X^!%^*;^#;^#;^&Z^\"|^-C^*A^$,^5D^:M^*D^$%^\"@^\"U ",
      "encoded_base64": "XiZOXiYiXipXXiswXiQsXiI/XixYXiElXio7XiM7XiM7XiZaXiJ8Xi1DXipBXiQsXjVEXjpNXipEXiQlXiJAXiJVIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_fe6c04c4c056",
      "text": "他！現在，我絕對能成功！ ",
      "encoded_ascii": "^!@^*W^&?^\"d^*A^$%^-I^#:^'b^$$^\"!^*W ",
      "encoded_base64": "XiFAXipXXiY/XiJkXipBXiQlXi1JXiM6XidiXiQkXiIhXipXIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_bb17455f6ce8",
      "text": "我已經明白自己的失誤了，現在沒有任何事物能阻止我！看好了！ ",
      "encoded_ascii": "^$%^#J^'D^$c^&X^'l^#I^&Z^\"|^(P^*D^*A^&?^\"d^%\\^$s^!C^!L^*r^&4^'b^)L^%G^$%^*W^*Q^+i^*D^*W ",
      "encoded_base64": "XiQlXiNKXidEXiRjXiZYXidsXiNJXiZaXiJ8XihQXipEXipBXiY/XiJkXiVcXiRzXiFDXiFMXipyXiY0XidiXilMXiVHXiQlXipXXipRXitpXipEXipXIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_0c030008911a",
      "text": "我已經告訴過你們了——我知道自己錯在哪！ ",
      "encoded_ascii": "^$%^#J^'D^+B^-t^(x^*F^*{^*D^*n^*n^$%^&h^(y^'l^#I^)5^\"d^+I^*W ",
      "encoded_base64": "XiQlXiNKXidEXitCXi10Xih4XipGXip7XipEXipuXipuXiQlXiZoXih5XidsXiNJXik1XiJkXitJXipXIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_97e4235ba1ad",
      "text": "我有什麼能為您效勞的嗎？",
      "encoded_ascii": "^$%^$s^!=^.T^'b^%{^4:^$Q^/R^&Z^+X^.V",
      "encoded_base64": "XiQlXiRzXiE9Xi5UXidiXiV7XjQ6XiRRXi9SXiZaXitYXi5W",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_3d73df7758fe",
      "text": "  既然重獲自由了，你們接下來打算做什麼？",
      "encoded_ascii": "  ^,U^&\"^))^&:^'l^&I^*D^*A^*F^*{^$?^!(^!O^$-^-C^*~^!=^.T^.V",
      "encoded_base64": "ICBeLFVeJiJeKSleJjpeJ2xeJkleKkReKkFeKkZeKnteJD9eISheIU9eJC1eLUNeKn5eIT1eLlReLlY=",
      "byte_length": 59
    },
    {
      "unit_id": "DLG_4377e14f2152",
      "text": "  你們為何還在勞作？",
      "encoded_ascii": "  ^*F^*{^%{^!L^.7^\"d^/R^!M^.V",
      "encoded_base64": "ICBeKkZeKnteJXteIUxeLjdeImReL1JeIU1eLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_99bfa1e41269",
      "text": "我們會照舊生活。我們就住在這裡。不會有太多改變。",
      "encoded_ascii": "^$%^*{^$r^/x^02^&F^%i^!\"^$%^*{^*J^*z^\"d^(s^-j^!\"^!)^$r^$s^+f^\"x^$N^(U^!\"",
      "encoded_base64": "XiQlXip7XiRyXi94XjAyXiZGXiVpXiEiXiQlXip7XipKXip6XiJkXihzXi1qXiEiXiEpXiRyXiRzXitmXiJ4XiROXihVXiEi",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_ee0b31de9943",
      "text": "這是我們的家園，我們必須守護維持它。現在我們以自己的勞作自豪。 ",
      "encoded_ascii": "^(s^,X^$%^*{^&Z^+s^41^*A^$%^*{^#l^)r^#+^(T^'F^$7^+o^!\"^&?^\"d^$%^*{^!B^'l^#I^&Z^/R^!M^'l^>y^!\" ",
      "encoded_base64": "XihzXixYXiQlXip7XiZaXitzXjQxXipBXiQlXip7XiNsXilyXiMrXihUXidGXiQ3XitvXiEiXiY/XiJkXiQlXip7XiFCXidsXiNJXiZaXi9SXiFNXidsXj55XiEiIA==",
      "byte_length": 94
    },
    {
      "unit_id": "DLG_8c4d82862eb9",
      "text": "這座神廟將再次成為和平與美麗的聖地。 ",
      "encoded_ascii": "^(s^/_^&w^0[^#7^!l^%D^$$^%{^\"O^0Y^'p^-P^0z^&Z^'Z^\"e^!\" ",
      "encoded_base64": "XihzXi9fXiZ3XjBbXiM3XiFsXiVEXiQkXiV7XiJPXjBZXidwXi1QXjB6XiZaXidaXiJlXiEiIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_7e6eadfc1faa",
      "text": "再見。感謝你們所成就的偉大善行。只要你們需要避難之所， ",
      "encoded_ascii": "^!l^-m^!\"^#{^-z^*F^*{^$)^$$^*J^&Z^*}^\"z^1(^(;^!\"^\"?^(C^*F^*{^)e^(C^0F^)a^!/^$)^*A ",
      "encoded_base64": "XiFsXi1tXiEiXiN7Xi16XipGXip7XiQpXiQkXipKXiZaXip9XiJ6XjEoXig7XiEiXiI/XihDXipGXip7XillXihDXjBGXilhXiEvXiQpXipBIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_d4ed5a8236a3",
      "text": "隨時歡迎來到這裡。",
      "encoded_ascii": "^)X^$f^%F^(k^!O^!u^(s^-j^!\"",
      "encoded_base64": "XilYXiRmXiVGXihrXiFPXiF1XihzXi1qXiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_30321e047878",
      "text": "我想去痊癒之室——請帶我去那裡。 ",
      "encoded_ascii": "^$%^,1^\"6^--^&V^!/^+r^*n^*n^*S^#N^$%^\"6^)!^-j^!\" ",
      "encoded_base64": "XiQlXiwxXiI2Xi0tXiZWXiEvXityXipuXipuXipTXiNOXiQlXiI2XikhXi1qXiEiIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_30506b0ee479",
      "text": "仍然要繼續進行嗎？",
      "encoded_ascii": "^!?^&\"^(C^-O^'M^(w^(;^+X^.V",
      "encoded_base64": "XiE/XiYiXihDXi1PXidNXih3Xig7XitYXi5W",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_5e0e15343c17",
      "text": "很好。我會在這裡等你們。 ",
      "encoded_ascii": "^*K^+i^!\"^$%^$r^\"d^(s^-j^'-^*F^*{^!\" ",
      "encoded_base64": "XipLXitpXiEiXiQlXiRyXiJkXihzXi1qXictXipGXip7XiEiIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_b178172ee7b8",
      "text": "誰也不准進去！",
      "encoded_ascii": "^-y^!1^!)^/Q^(w^\"6^*W",
      "encoded_base64": "Xi15XiExXiEpXi9RXih3XiI2XipX",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_38c94eb201b7",
      "text": "這本書年代非常久遠，翻動書頁必須極其小心 ",
      "encoded_ascii": "^(s^$x^$p^+~^*v^)i^#O^!.^({^*A^-Q^\"%^$p^5&^#l^)r^1D^!j^#;^#k ",
      "encoded_base64": "XihzXiR4XiRwXit+Xip2XilpXiNPXiEuXih7XipBXi1RXiIlXiRwXjUmXiNsXilyXjFEXiFqXiM7XiNrIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_377f9267c009",
      "text": "謹慎，以免它們化為齏粉。 ",
      "encoded_ascii": "^8@^83^*A^!B^!e^+o^*{^\")^%{^9g^'5^!\" ",
      "encoded_base64": "XjhAXjgzXipBXiFCXiFlXitvXip7XiIpXiV7XjlnXic1XiEiIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_d69b0dca8e8c",
      "text": "你想閱讀哪一個章節？",
      "encoded_ascii": "^*F^,1^:&^7I^+I^!%^!V^3x^9b^.V",
      "encoded_base64": "XipGXiwxXjomXjdJXitJXiElXiFWXjN4XjliXi5W",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_68665df12306",
      "text": "  法術篇",
      "encoded_ascii": "  ^%b^(<^;m",
      "encoded_base64": "ICBeJWJeKDxeO20=",
      "byte_length": 11
    },
    {
      "unit_id": "DLG_ba2010593dfb",
      "text": "  個人日記",
      "encoded_ascii": "  ^!V^!<^$a^(K",
      "encoded_base64": "ICBeIVZeITxeJGFeKEs=",
      "byte_length": 14
    },
    {
      "unit_id": "DLG_a8a0a533f94b",
      "text": "  最後一頁",
      "encoded_ascii": "  ^$q^#b^!%^5&",
      "encoded_base64": "ICBeJHFeI2JeISVeNSY=",
      "byte_length": 14
    },
    {
      "unit_id": "DLG_e39990e876d1",
      "text": "暫時不要閱讀這本書。 ",
      "encoded_ascii": "^$l^$f^!)^(C^:&^7I^(s^$x^$p^!\" ",
      "encoded_base64": "XiRsXiRmXiEpXihDXjomXjdJXihzXiR4XiRwXiEiIA==",
      "byte_length": 31
    },
    {
      "unit_id": "DLG_118c3e44b762",
      "text": "你的手指笨拙地翻動書頁，徹底毀壞了 ",
      "encoded_ascii": "^*F^&Z^$+^$8^5#^4z^\"e^-Q^\"%^$p^5&^*A^18^/^^%N^\"v^*D ",
      "encoded_base64": "XipGXiZaXiQrXiQ4XjUjXjR6XiJlXi1RXiIlXiRwXjUmXipBXjE4Xi9eXiVOXiJ2XipEIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_62d1b02b65be",
      "text": "這個章節。 ",
      "encoded_ascii": "^(s^!V^3x^9b^!\" ",
      "encoded_base64": "XihzXiFWXjN4XjliXiEiIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_2763074e6aab",
      "text": "當你笨拙地摸索合適的章節時，書本掉落到地上， ",
      "encoded_ascii": "^&N^*F^5#^4z^\"e^/j^'>^\"C^(|^&Z^3x^9b^$f^*A^$p^$x^/e^-`^!u^\"e^!'^*A ",
      "encoded_base64": "XiZOXipGXjUjXjR6XiJlXi9qXic+XiJDXih8XiZaXjN4XjliXiRmXipBXiRwXiR4Xi9lXi1gXiF1XiJlXiEnXipBIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_2dd71ee78f03",
      "text": "在你眼前化為了一攤塵土。 ",
      "encoded_ascii": "^\"d^*F^&d^!z^\")^%{^*D^!%^<U^\"p^\"c^!\" ",
      "encoded_base64": "XiJkXipGXiZkXiF6XiIpXiV7XipEXiElXjxVXiJwXiJjXiEiIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_6167f40b84bb",
      "text": "你靈巧地找到了合適的章節。 ",
      "encoded_ascii": "^*F^)g^3D^\"e^$/^!u^*D^\"C^(|^&Z^3x^9b^!\" ",
      "encoded_base64": "XipGXilnXjNEXiJlXiQvXiF1XipEXiJDXih8XiZaXjN4XjliXiEiIA==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_a8b1276b2e7c",
      "text": "……我深愛崔絲特蘭勝過世間萬物。沒有她 ",
      "encoded_ascii": "^*o^*o^$%^2*^,2^#E^'C^&5^/G^+5^(x^*p^)G^-_^&4^!\"^%\\^$s^+h ",
      "encoded_base64": "XipvXipvXiQlXjIqXiwyXiNFXidDXiY1Xi9HXis1Xih4XipwXilHXi1fXiY0XiEiXiVcXiRzXitoIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_35d9d63faa37",
      "text": "我無法獨活。她雖是我的學生，卻也是與我平起平坐的知己。 ",
      "encoded_ascii": "^$%^%}^%b^/z^%i^!\"^+h^.A^,X^$%^&Z^+n^&F^*A^1&^!1^,X^'p^$%^0Y^.(^0Y^8E^&Z^&h^#I^!\" ",
      "encoded_base64": "XiQlXiV9XiViXi96XiVpXiEiXitoXi5BXixYXiQlXiZaXituXiZGXipBXjEmXiExXixYXidwXiQlXjBZXi4oXjBZXjhFXiZaXiZoXiNJXiEiIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_89d361e5a4ba",
      "text": "我擔心她的父親可能已經察覺到 ",
      "encoded_ascii": "^$%^*N^#k^+h^&Z^5d^(F^\"A^'b^#J^'D^#2^(G^!u ",
      "encoded_base64": "XiQlXipOXiNrXitoXiZaXjVkXihGXiJBXidiXiNKXidEXiMyXihHXiF1IA==",
      "byte_length": 43
    },
    {
      "unit_id": "DLG_75ac540eebc7",
      "text": "她對我有情意。 ",
      "encoded_ascii": "^+h^#:^$%^$s^,0^#z^!\" ",
      "encoded_base64": "XitoXiM6XiQlXiRzXiwwXiN6XiEiIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_2696fb7f0fd3",
      "text": "天降噩耗！崔絲特蘭竟被許配給東方領地的一位 ",
      "encoded_ascii": "^+e^)N^/X^'X^*W^#E^'C^&5^/G^28^(@^-s^)&^'A^,`^$]^)s^\"e^&Z^!%^!J ",
      "encoded_base64": "XitlXilOXi9YXidYXipXXiNFXidDXiY1Xi9HXjI4XihAXi1zXikmXidBXixgXiRdXilzXiJlXiZaXiElXiFKIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_4ba27e12fdc4",
      "text": "王子。她痛哭了數小時，不敢直視 ",
      "encoded_ascii": "^-)^#(^!\"^+h^-.^/U^*D^$V^#;^$f^*A^!)^/m^&`^(E ",
      "encoded_base64": "Xi0pXiMoXiEiXitoXi0uXi9VXipEXiRWXiM7XiRmXipBXiEpXi9tXiZgXihFIA==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_e69b572480a3",
      "text": "我的雙眼。我還是透過信使才得知此事的。 ",
      "encoded_ascii": "^$%^&Z^)_^&d^!\"^$%^.7^,X^(q^(x^!U^!N^$,^#e^&h^%I^*r^&Z^!\" ",
      "encoded_base64": "XiQlXiZaXilfXiZkXiEiXiQlXi43XixYXihxXih4XiFVXiFOXiQsXiNlXiZoXiVJXipyXiZaXiEiIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_32d1d64a69ae",
      "text": "我擔心崔絲特蘭的父親或許知曉了我們的計劃。 ",
      "encoded_ascii": "^$%^*N^#k^#E^'C^&5^/G^&Z^5d^(F^$'^-s^&h^7y^*D^$%^*{^&Z^-n^4s^!\" ",
      "encoded_base64": "XiQlXipOXiNrXiNFXidDXiY1Xi9HXiZaXjVkXihGXiQnXi1zXiZoXjd5XipEXiQlXip7XiZaXi1uXjRzXiEiIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_5c39b995d985",
      "text": "我一直懷疑高牆之內潛藏著奸細，牆外也有人 ",
      "encoded_ascii": "^$%^!%^&`^,9^0p^*+^&0^!/^!g^7:^-f^-a^:2^'?^*A^&0^\"w^!1^$s^!< ",
      "encoded_base64": "XiQlXiElXiZgXiw5XjBwXiorXiYwXiEvXiFnXjc6Xi1mXi1hXjoyXic/XipBXiYwXiJ3XiExXiRzXiE8IA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_c0485930463e",
      "text": "企圖為了私利而中傷毀謗我們的教團。 ",
      "encoded_ascii": "^4-^\"b^%{^*D^&~^!t^'W^!,^!^^%N^>x^$%^*{^&Z^,R^0V^!\" ",
      "encoded_base64": "XjQtXiJiXiV7XipEXiZ+XiF0XidXXiEsXiFeXiVOXj54XiQlXip7XiZaXixSXjBWXiEiIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_8e8b7e88ca6f",
      "text": "我從王都的一位友人那裡收到了一封密函， ",
      "encoded_ascii": "^$%^#f^-)^)$^&Z^!%^!J^\"8^!<^)!^-j^$M^!u^*D^!%^#5^#0^=Q^*A ",
      "encoded_base64": "XiQlXiNmXi0pXikkXiZaXiElXiFKXiI4XiE8XikhXi1qXiRNXiF1XipEXiElXiM1XiMwXj1RXipBIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_e69d7ad36641",
      "text": "要我密切監視一位維齊爾大臣。 ",
      "encoded_ascii": "^(C^$%^#0^+.^2|^(E^!%^!J^'F^36^&/^\"z^.s^!\" ",
      "encoded_base64": "XihDXiQlXiMwXisuXjJ8XihFXiElXiFKXidGXjM2XiYvXiJ6Xi5zXiEiIA==",
      "byte_length": 43
    },
    {
      "unit_id": "DLG_7f9280eea1a0",
      "text": "只有一道法術殘留得足夠完整可供研習。你將它 ",
      "encoded_ascii": "^\"?^$s^!%^(y^%b^(<^,l^-+^#e^(^^+d^#,^$T^\"A^!P^9G^3{^!\"^*F^#7^+o ",
      "encoded_base64": "XiI/XiRzXiElXih5XiViXig8XixsXi0rXiNlXiheXitkXiMsXiRUXiJBXiFQXjlHXjN7XiEiXipGXiM3XitvIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_658dcf29472c",
      "text": "從書中撕了下來。 ",
      "encoded_ascii": "^#f^$p^!,^/k^*D^!(^!O^!\" ",
      "encoded_base64": "XiNmXiRwXiEsXi9rXipEXiEoXiFPXiEiIA==",
      "byte_length": 25
    },
    {
      "unit_id": "DLG_0eb2002d3f79",
      "text": " 獲得了一張卷軸！ ",
      "encoded_ascii": " ^&:^#e^*D^!%^,(^\"3^(e^*W ",
      "encoded_base64": "IF4mOl4jZV4qRF4hJV4sKF4iM14oZV4qVyA=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_33f705886c4e",
      "text": "大難臨頭！來自南方王國的祭司阿波斯 ",
      "encoded_ascii": "^\"z^)a^1U^)t^*W^!O^'l^\"/^$]^-)^+^^&Z^&x^+=^)M^%c^$[ ",
      "encoded_base64": "XiJ6XilhXjFVXil0XipXXiFPXidsXiIvXiRdXi0pXiteXiZaXiZ4Xis9XilNXiVjXiRbIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_50141370f602",
      "text": "引發了一場驚天動地的大地震， ",
      "encoded_ascii": "^#Z^&W^*D^!%^\"n^.Q^+e^\"%^\"e^&Z^\"z^\"e^32^*A ",
      "encoded_base64": "XiNaXiZXXipEXiElXiJuXi5RXitlXiIlXiJlXiZaXiJ6XiJlXjMyXipBIA==",
      "byte_length": 43
    },
    {
      "unit_id": "DLG_bd2c875bedee",
      "text": "幾乎吞噬了整座神廟。我擔憂死靈法術 ",
      "encoded_ascii": "^#T^!0^:-^:0^*D^$T^/_^&w^0[^!\"^$%^*N^91^%L^)g^%b^(< ",
      "encoded_base64": "XiNUXiEwXjotXjowXipEXiRUXi9fXiZ3XjBbXiEiXiQlXipOXjkxXiVMXilnXiViXig8IA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_b881bd33b15d",
      "text": "正在醞釀。籌備已久的這些惡毒詛咒將會 ",
      "encoded_ascii": "^%H^\"d^>z^7p^!\"^:W^+\"^#J^!.^&Z^(s^!8^#y^%Q^(L^\"P^#7^$r ",
      "encoded_base64": "XiVIXiJkXj56XjdwXiEiXjpXXisiXiNKXiEuXiZaXihzXiE4XiN5XiVRXihMXiJQXiM3XiRyIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_fb89f8cdbb22",
      "text": "無從偏折抵禦。 ",
      "encoded_ascii": "^%}^#f^![^,?^$5^&{^!\" ",
      "encoded_base64": "XiV9XiNmXiFbXiw/XiQ1XiZ7XiEiIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_5834cf2b5819",
      "text": "幽影開始支離破碎。 ",
      "encoded_ascii": "^2f^#a^)F^+k^$L^)`^&n^&o^!\" ",
      "encoded_base64": "XjJmXiNhXilGXitrXiRMXilgXiZuXiZvXiEiIA==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_5820488c1685",
      "text": "一縷縷黑影被吸入發光的護身符中。在你的眼前， ",
      "encoded_ascii": "^!%^6h^6h^*:^#a^(@^\"J^!f^&W^!c^&Z^(T^(c^'+^!,^!\"^\"d^*F^&Z^&d^!z^*A ",
      "encoded_base64": "XiElXjZoXjZoXio6XiNhXihAXiJKXiFmXiZXXiFjXiZaXihUXihjXicrXiEsXiEiXiJkXipGXiZaXiZkXiF6XipBIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_75b6f32b88ff",
      "text": "那團陰影徹底消失在護身符之內。 ",
      "encoded_ascii": "^)!^0V^6B^#a^18^/^^%k^\"|^\"d^(T^(c^'+^!/^!g^!\" ",
      "encoded_base64": "XikhXjBWXjZCXiNhXjE4Xi9eXiVrXiJ8XiJkXihUXihjXicrXiEvXiFnXiEiIA==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_5c8d1afdc09d",
      "text": "護身符開始綻放光芒。陰影的面孔在被痛苦地吸入 ",
      "encoded_ascii": "^(T^(c^'+^)F^+k^'H^$P^!c^'u^!\"^6B^#a^&Z^)j^5G^\"d^(@^-.^.t^\"e^\"J^!f ",
      "encoded_base64": "XihUXihjXicrXilGXitrXidIXiRQXiFjXid1XiEiXjZCXiNhXiZaXilqXjVHXiJkXihAXi0uXi50XiJlXiJKXiFmIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_d700c5a39a0c",
      "text": "護身符核心時扭曲變形。片刻之後， ",
      "encoded_ascii": "^(T^(c^'+^:\"^#k^$f^1;^$n^(U^#_^!\"^&1^.Y^!/^#b^*A ",
      "encoded_base64": "XihUXihjXicrXjoiXiNrXiRmXjE7XiRuXihVXiNfXiEiXiYxXi5ZXiEvXiNiXipBIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_764253233a49",
      "text": "幽影已然無影無蹤。 ",
      "encoded_ascii": "^2f^#a^#J^&\"^%}^#a^%}^(b^!\" ",
      "encoded_base64": "XjJmXiNhXiNKXiYiXiV9XiNhXiV9XihiXiEiIA==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_75e3614d4025",
      "text": "水晶融解滲入了祭壇之中。 ",
      "encoded_ascii": "^%V^$h^(7^(I^>t^!f^*D^&x^*]^!/^!,^!\" ",
      "encoded_base64": "XiVWXiRoXig3XihJXj50XiFmXipEXiZ4XipdXiEvXiEsXiEiIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_8e169255b226",
      "text": "水晶並未啟動。 ",
      "encoded_ascii": "^%V^$h^!+^,_^57^\"%^!\" ",
      "encoded_base64": "XiVWXiRoXiErXixfXjU3XiIlXiEiIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_54aa5c39091b",
      "text": "這塊水晶也與祭壇融為一體。神廟隨之震動，牆壁自行動手 ",
      "encoded_ascii": "^(s^/Z^%V^$h^!1^'p^&x^*]^(7^%{^!%^**^!\"^&w^0[^)X^!/^32^\"%^*A^&0^*\\^'l^(;^\"%^$+ ",
      "encoded_base64": "XihzXi9aXiVWXiRoXiExXidwXiZ4XipdXig3XiV7XiElXioqXiEiXiZ3XjBbXilYXiEvXjMyXiIlXipBXiYwXipcXidsXig7XiIlXiQrIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_b67ccd58f902",
      "text": "修復，將周圍壓迫的土石推了回去。 ",
      "encoded_ascii": "^.~^#g^*A^#7^\"L^\"`^4v^1`^&Z^\"c^&k^,J^*D^\"\\^\"6^!\" ",
      "encoded_base64": "Xi5+XiNnXipBXiM3XiJMXiJgXjR2XjFgXiZaXiJjXiZrXixKXipEXiJcXiI2XiEiIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_48f201dc7c18",
      "text": "你們解救了泰南與崔絲特蘭！",
      "encoded_ascii": "^*F^*{^(I^,Q^*D^%f^\"/^'p^#E^'C^&5^/G^*W",
      "encoded_base64": "XipGXip7XihJXixRXipEXiVmXiIvXidwXiNFXidDXiY1Xi9HXipX",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_624d43ac4675",
      "text": "我已經解決掉阿波斯了。 ",
      "encoded_ascii": "^$%^#J^'D^(I^,o^/e^)M^%c^$[^*D^!\" ",
      "encoded_base64": "XiQlXiNKXidEXihJXixvXi9lXilNXiVjXiRbXipEXiEiIA==",
      "byte_length": 34
    },
    {
      "unit_id": "DLG_3652013bf6e3",
      "text": "請隨意在此探索神廟。 ",
      "encoded_ascii": "^*S^)X^#z^\"d^%I^$>^'>^&w^0[^!\" ",
      "encoded_base64": "XipTXilYXiN6XiJkXiVJXiQ+Xic+XiZ3XjBbXiEiIA==",
      "byte_length": 31
    },
    {
      "unit_id": "DLG_3800fd22da4c",
      "text": "拿走任何你們想要的東西吧。我們再也用不著它們了。 ",
      "encoded_ascii": "^,G^.&^!C^!L^*F^*{^,1^(C^&Z^,`^-l^*I^!\"^$%^*{^!l^!1^&H^!)^-a^+o^*{^*D^!\" ",
      "encoded_base64": "XixHXi4mXiFDXiFMXipGXip7XiwxXihDXiZaXixgXi1sXipJXiEiXiQlXip7XiFsXiExXiZIXiEpXi1hXitvXip7XipEXiEiIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_fdf4a2433601",
      "text": "轉念一想，我其實不想知道你們是怎麼進來的。 ",
      "encoded_ascii": "^(i^1z^!%^,1^*A^$%^!j^#3^!)^,1^&h^(y^*F^*{^,X^,,^.T^(w^!O^&Z^!\" ",
      "encoded_base64": "XihpXjF6XiElXiwxXipBXiQlXiFqXiMzXiEpXiwxXiZoXih5XipGXip7XixYXiwsXi5UXih3XiFPXiZaXiEiIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_de64d1e9ed1c",
      "text": "站住！不准再往前一步！ ",
      "encoded_ascii": "^->^*z^*W^!)^/Q^!l^,)^!z^!%^,i^*W ",
      "encoded_base64": "Xi0+Xip6XipXXiEpXi9RXiFsXiwpXiF6XiElXixpXipXIA==",
      "byte_length": 34
    },
    {
      "unit_id": "DLG_e51eec7f6b6c",
      "text": "憑亞薩斯的失落眾神起誓——你們究竟是怎麼進到那裡的？ ",
      "encoded_ascii": "^,5^!9^-e^$[^&Z^\"|^-`^&e^&w^.(^-w^*n^*n^*F^*{^-<^28^,X^,,^.T^(w^!u^)!^-j^&Z^.V ",
      "encoded_base64": "Xiw1XiE5Xi1lXiRbXiZaXiJ8Xi1gXiZlXiZ3Xi4oXi13XipuXipuXipGXip7Xi08XjI4XixYXiwsXi5UXih3XiF1XikhXi1qXiZaXi5WIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_584e05c5da7f",
      "text": "無論你們是誰——立刻離開這座神廟！ ",
      "encoded_ascii": "^%}^1\\^*F^*{^,X^-y^*n^*n^0'^.Y^)`^)F^(s^/_^&w^0[^*W ",
      "encoded_base64": "XiV9XjFcXipGXip7XixYXi15XipuXipuXjAnXi5ZXilgXilGXihzXi9fXiZ3XjBbXipXIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_f4b17dd5d9cb",
      "text": "熔岩氣泡輕易裂開，露出一顆寶石。 ",
      "encoded_ascii": "^&#^#D^%U^2s^(g^,W^8r^)F^*A^.B^!q^!%^)u^#4^&k^!\" ",
      "encoded_base64": "XiYjXiNEXiVVXjJzXihnXixXXjhyXilGXipBXi5CXiFxXiElXil1XiM0XiZrXiEiIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_5f333caaec8e",
      "text": "這裡沒有任何能被輕易拆卸下來的岩石塊。 ",
      "encoded_ascii": "^(s^-j^%\\^$s^!C^!L^'b^(@^(g^,W^=o^<7^!(^!O^&Z^#D^&k^/Z^!\" ",
      "encoded_base64": "XihzXi1qXiVcXiRzXiFDXiFMXidiXihAXihnXixXXj1vXjw3XiEoXiFPXiZaXiNEXiZrXi9aXiEiIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_4e6b8b6b7f1e",
      "text": "這片廢墟散落著一些可以被輕易搬開的小岩石。 ",
      "encoded_ascii": "^(s^&1^#W^\"t^$S^-`^-a^!%^!8^\"A^!B^(@^(g^,W^<=^)F^&Z^#;^#D^&k^!\" ",
      "encoded_base64": "XihzXiYxXiNXXiJ0XiRTXi1gXi1hXiElXiE4XiJBXiFCXihAXihnXixXXjw9XilGXiZaXiM7XiNEXiZrXiEiIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_d3cc919197bd",
      "text": "要搬開一塊岩石嗎？ ",
      "encoded_ascii": "^(C^<=^)F^!%^/Z^#D^&k^+X^.V ",
      "encoded_base64": "XihDXjw9XilGXiElXi9aXiNEXiZrXitYXi5WIA==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_006d36cc28b0",
      "text": "熔岩穹丘完好無損。 ",
      "encoded_ascii": "^&#^#D^''^5(^#,^+i^%}^$D^!\" ",
      "encoded_base64": "XiYjXiNEXicnXjUoXiMsXitpXiV9XiREXiEiIA==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_79d1a3cbddf6",
      "text": "你找到了一顆寶石。 ",
      "encoded_ascii": "^*F^$/^!u^*D^!%^)u^#4^&k^!\" ",
      "encoded_base64": "XipGXiQvXiF1XipEXiElXil1XiM0XiZrXiEiIA==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_b49b0c25a807",
      "text": "這座熔岩穹丘裡面空空如也。 ",
      "encoded_ascii": "^(s^/_^&#^#D^''^5(^-j^)j^'(^'(^#$^!1^!\" ",
      "encoded_base64": "XihzXi9fXiYjXiNEXicnXjUoXi1qXilqXicoXicoXiMkXiExXiEiIA==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_15f5e1c17b98",
      "text": "穹丘已開啟， ",
      "encoded_ascii": "^''^5(^#J^)F^57^*A ",
      "encoded_base64": "XicnXjUoXiNKXilGXjU3XipBIA==",
      "byte_length": 19
    },
    {
      "unit_id": "DLG_5bfac11fc737",
      "text": "裡面有一顆寶石。 ",
      "encoded_ascii": "^-j^)j^$s^!%^)u^#4^&k^!\" ",
      "encoded_base64": "Xi1qXilqXiRzXiElXil1XiM0XiZrXiEiIA==",
      "byte_length": 25
    },
    {
      "unit_id": "DLG_4423fd8b187b",
      "text": "但裡面什麼也沒有。 ",
      "encoded_ascii": "^!I^-j^)j^!=^.T^!1^%\\^$s^!\" ",
      "encoded_base64": "XiFJXi1qXilqXiE9Xi5UXiExXiVcXiRzXiEiIA==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_9088794a7839",
      "text": "一座熔岩穹丘，看起來 ",
      "encoded_ascii": "^!%^/_^&#^#D^''^5(^*A^*Q^.(^!O ",
      "encoded_base64": "XiElXi9fXiYjXiNEXicnXjUoXipBXipRXi4oXiFPIA==",
      "byte_length": 31
    },
    {
      "unit_id": "DLG_17c5eb83a9ed",
      "text": "相當小巧。 ",
      "encoded_ascii": "^&a^&N^#;^3D^!\" ",
      "encoded_base64": "XiZhXiZOXiM7XjNEXiEiIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_928a8550432d",
      "text": "十分巨大且帶有裂紋瑕疵。 ",
      "encoded_ascii": "^*Y^!s^#H^\"z^!*^#N^$s^8r^':^;|^>v^!\" ",
      "encoded_base64": "XipZXiFzXiNIXiJ6XiEqXiNOXiRzXjhyXic6Xjt8Xj52XiEiIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_7dadcfe3c5e7",
      "text": "完好無瑕，而且相當巨大。 ",
      "encoded_ascii": "^#,^+i^%}^;|^*A^'W^!*^&a^&N^#H^\"z^!\" ",
      "encoded_base64": "XiMsXitpXiV9Xjt8XipBXidXXiEqXiZhXiZOXiNIXiJ6XiEiIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_0f0d9be77719",
      "text": "這座穹丘極其堅硬。需要挖掘工具才能將其敲開。 ",
      "encoded_ascii": "^(s^/_^''^5(^1D^!j^\"l^25^!\"^)e^(C^2!^=@^+y^!k^$,^'b^#7^!j^1A^)F^!\" ",
      "encoded_base64": "XihzXi9fXicnXjUoXjFEXiFqXiJsXjI1XiEiXillXihDXjIhXj1AXit5XiFrXiQsXidiXiM3XiFqXjFBXilGXiEiIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_18dd9fe36ecd",
      "text": "你注意到繫在蛋上的一根細筋繩，延伸向 ",
      "encoded_ascii": "^*F^%e^#z^!u^:;^\"d^6\"^!'^&Z^!%^%)^'?^<C^'L^*A^,&^/N^+? ",
      "encoded_base64": "XipGXiVlXiN6XiF1Xjo7XiJkXjYiXiEnXiZaXiElXiUpXic/XjxDXidMXipBXiwmXi9OXis/IA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_559b8bd55a68",
      "text": "西北方與東南方。 ",
      "encoded_ascii": "^-l^+6^$]^'p^,`^\"/^$]^!\" ",
      "encoded_base64": "Xi1sXis2XiRdXidwXixgXiIvXiRdXiEiIA==",
      "byte_length": 25
    },
    {
      "unit_id": "DLG_04cba1f30a01",
      "text": "  拉動細繩",
      "encoded_ascii": "  ^$6^\"%^'?^'L",
      "encoded_base64": "ICBeJDZeIiVeJz9eJ0w=",
      "byte_length": 14
    },
    {
      "unit_id": "DLG_30b0f8c02d97",
      "text": "  解除陷阱",
      "encoded_ascii": "  ^(I^)Q^)S^)J",
      "encoded_base64": "ICBeKEleKVFeKVNeKUo=",
      "byte_length": 14
    },
    {
      "unit_id": "DLG_f7cc8847c696",
      "text": "離開",
      "encoded_ascii": "^)`^)F",
      "encoded_base64": "XilgXilG",
      "byte_length": 6
    },
    {
      "unit_id": "DLG_777907d3a339",
      "text": "你成功解除了陷阱。 ",
      "encoded_ascii": "^*F^$$^\"!^(I^)Q^*D^)S^)J^!\" ",
      "encoded_base64": "XipGXiQkXiIhXihJXilRXipEXilTXilKXiEiIA==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_2f16e33c249e",
      "text": "在解除陷阱的過程中，細筋繩猛然斷裂。 ",
      "encoded_ascii": "^\"d^(I^)Q^)S^)J^&Z^(x^'#^!,^*A^'?^<C^'L^*P^&\"^,T^8r^!\" ",
      "encoded_base64": "XiJkXihJXilRXilTXilKXiZaXih4XicjXiEsXipBXic/XjxDXidMXipQXiYiXixUXjhyXiEiIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_2065d6e33eda",
      "text": "當你觸碰到蛋時，繫在上面的一根細筋繩 ",
      "encoded_ascii": "^&N^*F^(J^-5^!u^6\"^$f^*A^:;^\"d^!'^)j^&Z^!%^%)^'?^<C^'L ",
      "encoded_base64": "XiZOXipGXihKXi01XiF1XjYiXiRmXipBXjo7XiJkXiEnXilqXiZaXiElXiUpXic/XjxDXidMIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_7d0cec0924df",
      "text": "崩脫了開來。 ",
      "encoded_ascii": "^0W^'c^*D^)F^!O^!\" ",
      "encoded_base64": "XjBXXidjXipEXilGXiFPXiEiIA==",
      "byte_length": 19
    },
    {
      "unit_id": "DLG_9af7c25685b8",
      "text": "螳螂戰士們從藏身之處猛衝了出來！ ",
      "encoded_ascii": "^8O^8N^$(^+a^*{^#f^-f^(c^!/^(,^*P^-h^*D^!q^!O^*W ",
      "encoded_base64": "XjhPXjhOXiQoXithXip7XiNmXi1mXihjXiEvXigsXipQXi1oXipEXiFxXiFPXipXIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_6d244661c78b",
      "text": "堵塞住間歇泉的岩石承受著相當大的 ",
      "encoded_ascii": "^;u^/(^*z^)G^%E^%a^&Z^#D^&k^$0^\";^-a^&a^&N^\"z^&Z ",
      "encoded_base64": "Xjt1Xi8oXip6XilHXiVFXiVhXiZaXiNEXiZrXiQwXiI7Xi1hXiZhXiZOXiJ6XiZaIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_131756578b9e",
      "text": "水壓。你想拔出這塊岩石嗎？ ",
      "encoded_ascii": "^%V^4v^!\"^*F^,1^/c^!q^(s^/Z^#D^&k^+X^.V ",
      "encoded_base64": "XiVWXjR2XiEiXipGXiwxXi9jXiFxXihzXi9aXiNEXiZrXitYXi5WIA==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_c17ad1945228",
      "text": " 被滾燙噴湧的沸水燙傷了。 ",
      "encoded_ascii": " ^(@^,z^8k^\"W^0m^&Z^5\\^%V^8k^!^^*D^!\" ",
      "encoded_base64": "IF4oQF4sel44a14iV14wbV4mWl41XF4lVl44a14hXl4qRF4hIiA=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_9570ece1f5be",
      "text": "這塊岩石能輕易塞進間歇泉孔中。要把它楔進去嗎？ ",
      "encoded_ascii": "^(s^/Z^#D^&k^'b^(g^,W^/(^(w^)G^%E^%a^5G^!,^!\"^(C^$1^+o^>s^(w^\"6^+X^.V ",
      "encoded_base64": "XihzXi9aXiNEXiZrXidiXihnXixXXi8oXih3XilHXiVFXiVhXjVHXiEsXiEiXihDXiQxXitvXj5zXih3XiI2XitYXi5WIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_6dcef5b57fff",
      "text": "岩石緊緊卡在了間歇泉的泉口狹頸處。 ",
      "encoded_ascii": "^#D^&k^0r^0r^\"0^\"d^*D^)G^%E^%a^&Z^%a^\"<^9#^>{^(,^!\" ",
      "encoded_base64": "XiNEXiZrXjByXjByXiIwXiJkXipEXilHXiVFXiVhXiZaXiVhXiI8XjkjXj57XigsXiEiIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_d7351f6c4b45",
      "text": "當間歇泉驟然爆發時，滾燙的沸水灼傷了所有人。 ",
      "encoded_ascii": "^&N^)G^%E^%a^7M^&\"^&*^&W^$f^*A^,z^8k^&Z^5\\^%V^9^^!^^*D^$)^$s^!<^!\" ",
      "encoded_base64": "XiZOXilHXiVFXiVhXjdNXiYiXiYqXiZXXiRmXipBXix6XjhrXiZaXjVcXiVWXjleXiFeXipEXiQpXiRzXiE8XiEiIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_7f42948c978e",
      "text": " 看見一個巨大的金屬物體從間歇泉中飛射而出，落向了南方。 ",
      "encoded_ascii": " ^*Q^-m^!%^!V^#H^\"z^&Z^)+^#C^&4^**^#f^)G^%E^%a^!,^)z^#6^'W^!q^*A^-`^+?^*D^\"/^$]^!\" ",
      "encoded_base64": "IF4qUV4tbV4hJV4hVl4jSF4iel4mWl4pK14jQ14mNF4qKl4jZl4pR14lRV4lYV4hLF4pel4jNl4nV14hcV4qQV4tYF4rP14qRF4iL14kXV4hIiA=",
      "byte_length": 83
    },
    {
      "unit_id": "DLG_9ceff18ad583",
      "text": "你打斷了我的冥思。你究竟想達成什麼？",
      "encoded_ascii": "^*F^$-^,T^*D^$%^&Z^2X^#q^!\"^*F^-<^28^,1^(z^$$^!=^.T^.V",
      "encoded_base64": "XipGXiQtXixUXipEXiQlXiZaXjJYXiNxXiEiXipGXi08XjI4XiwxXih6XiQkXiE9Xi5UXi5W",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_99e3e6359faa",
      "text": "  你在做什麼？",
      "encoded_ascii": "  ^*F^\"d^*~^!=^.T^.V",
      "encoded_base64": "ICBeKkZeImReKn5eIT1eLlReLlY=",
      "byte_length": 20
    },
    {
      "unit_id": "DLG_3ee0d4c96195",
      "text": "  我尋求自由。",
      "encoded_ascii": "  ^$%^#9^,n^'l^&I^!\"",
      "encoded_base64": "ICBeJCVeIzleLG5eJ2xeJkleISI=",
      "byte_length": 20
    },
    {
      "unit_id": "DLG_d705f68b740e",
      "text": "  這條道途究竟是什麼？",
      "encoded_ascii": "  ^(s^%.^(y^3.^-<^28^,X^!=^.T^.V",
      "encoded_base64": "ICBeKHNeJS5eKHleMy5eLTxeMjheLFheIT1eLlReLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_d31fae4c1ef7",
      "text": "  你連自己的名字都忘了？",
      "encoded_ascii": "  ^*F^.0^'l^#I^&Z^\"F^#)^)$^0]^*D^.V",
      "encoded_base64": "ICBeKkZeLjBeJ2xeI0leJlpeIkZeIyleKSReMF1eKkReLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_438fcebd9979",
      "text": "  什麼是自由？",
      "encoded_ascii": "  ^!=^.T^,X^'l^&I^.V",
      "encoded_base64": "ICBeIT1eLlReLFheJ2xeJkleLlY=",
      "byte_length": 20
    },
    {
      "unit_id": "DLG_8de6b9a9ede4",
      "text": "  開悟？",
      "encoded_ascii": "  ^)F^=e^.V",
      "encoded_base64": "ICBeKUZePWVeLlY=",
      "byte_length": 11
    },
    {
      "unit_id": "DLG_44c2ee6f8d4e",
      "text": "  我也能獲得開悟嗎？",
      "encoded_ascii": "  ^$%^!1^'b^&:^#e^)F^=e^+X^.V",
      "encoded_base64": "ICBeJCVeITFeJ2JeJjpeI2VeKUZePWVeK1heLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_7671b6319532",
      "text": "  我非得忘記自己的名字不可嗎？",
      "encoded_ascii": "  ^$%^)i^#e^0]^(K^'l^#I^&Z^\"F^#)^!)^\"A^+X^.V",
      "encoded_base64": "ICBeJCVeKWleI2VeMF1eKEteJ2xeI0leJlpeIkZeIyleISleIkFeK1heLlY=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_60cd39fdb03b",
      "text": "繼續沿著道途前進吧，年輕人。你們將會有所領悟。 ",
      "encoded_ascii": "^-O^'M^%`^-a^(y^3.^!z^(w^*I^*A^+~^(g^!<^!\"^*F^*{^#7^$r^$s^$)^)s^=e^!\" ",
      "encoded_base64": "Xi1PXidNXiVgXi1hXih5XjMuXiF6Xih3XipJXipBXit+XihnXiE8XiEiXipGXip7XiM3XiRyXiRzXiQpXilzXj1lXiEiIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_4eb23cd64e85",
      "text": "你們已經贏得與我交談的資格。你們所求為何？ ",
      "encoded_ascii": "^*F^*{^#J^'D^.%^#e^'p^$%^0P^0;^&Z^(X^%*^!\"^*F^*{^$)^,n^%{^!L^.V ",
      "encoded_base64": "XipGXip7XiNKXidEXi4lXiNlXidwXiQlXjBQXjA7XiZaXihYXiUqXiEiXipGXip7XiQpXixuXiV7XiFMXi5WIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_56b84c8f7816",
      "text": "  我不想繼續走這條道途了。 ",
      "encoded_ascii": "  ^$%^!)^,1^-O^'M^.&^(s^%.^(y^3.^*D^!\" ",
      "encoded_base64": "ICBeJCVeISleLDFeLU9eJ01eLiZeKHNeJS5eKHleMy5eKkReISIg",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_0c20fe0b3b2c",
      "text": "  我會繼續前進。 ",
      "encoded_ascii": "  ^$%^$r^-O^'M^!z^(w^!\" ",
      "encoded_base64": "ICBeJCVeJHJeLU9eJ01eIXpeKHdeISIg",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_979d07ba8741",
      "text": "  我想掌握一項心靈異能。 ",
      "encoded_ascii": "  ^$%^,1^$;^1>^!%^)q^#k^)g^&M^'b^!\" ",
      "encoded_base64": "ICBeJCVeLDFeJDteMT5eISVeKXFeI2teKWdeJk1eJ2JeISIg",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_136743a3a95a",
      "text": "  我希望能獲得更多開悟。 ",
      "encoded_ascii": "  ^$%^+{^,]^'b^&:^#e^$o^\"x^)F^=e^!\" ",
      "encoded_base64": "ICBeJCVeK3teLF1eJ2JeJjpeI2VeJG9eInheKUZePWVeISIg",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_72db0769920a",
      "text": "我想我可能還留著一只心靈手環。讓我找找看。",
      "encoded_ascii": "^$%^,1^$%^\"A^'b^.7^-+^-a^!%^\"?^#k^)g^$+^&B^!\"^-}^$%^$/^$/^*Q^!\"",
      "encoded_base64": "XiQlXiwxXiQlXiJBXidiXi43Xi0rXi1hXiElXiI/XiNrXilnXiQrXiZCXiEiXi19XiQlXiQvXiQvXipRXiEi",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_4ad61c428a13",
      "text": "祝你們在求道之路上順遂。",
      "encoded_ascii": "^&v^*F^*{^\"d^,n^(y^!/^(a^!'^.D^;p^!\"",
      "encoded_base64": "XiZ2XipGXip7XiJkXixuXih5XiEvXihhXiEnXi5EXjtwXiEi",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_c26f9b04465e",
      "text": "恐怕我這裡沒有別的東西能給你們了。祝你們在旅途之中 ",
      "encoded_ascii": "^#t^0^^$%^(s^-j^%\\^$s^*H^&Z^,`^-l^'b^'A^*F^*{^*D^!\"^&v^*F^*{^\"d^2m^3.^!/^!, ",
      "encoded_base64": "XiN0XjBeXiQlXihzXi1qXiVcXiRzXipIXiZaXixgXi1sXidiXidBXipGXip7XipEXiEiXiZ2XipGXip7XiJkXjJtXjMuXiEvXiEsIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_f60d3a6bbf73",
      "text": "一路順風！ ",
      "encoded_ascii": "^!%^(a^.D^)y^*W ",
      "encoded_base64": "XiElXihhXi5EXil5XipXIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_999186860c63",
      "text": "你們已經從這條道途中學盡了所有能學之物。現在啟程，去做你們最擅長 ",
      "encoded_ascii": "^*F^*{^#J^'D^#f^(s^%.^(y^3.^!,^+n^-1^*D^$)^$s^'b^+n^!/^&4^!\"^&?^\"d^57^'#^*A^\"6^*~^*F^*{^$q^2$^)C ",
      "encoded_base64": "XipGXip7XiNKXidEXiNmXihzXiUuXih5XjMuXiEsXituXi0xXipEXiQpXiRzXidiXituXiEvXiY0XiEiXiY/XiJkXjU3XicjXipBXiI2Xip+XipGXip7XiRxXjIkXilDIA==",
      "byte_length": 97
    },
    {
      "unit_id": "DLG_4aae6c92614e",
      "text": "之事吧。如果你是法師，便施展法術；如果你是牧師，便施法治療；如果你 ",
      "encoded_ascii": "^!/^*r^*I^!\"^#$^%!^*F^,X^%b^#M^*A^!R^$_^+x^%b^(<^*C^#$^%!^*F^,X^/5^#M^*A^!R^$_^%b^%_^&U^*C^#$^%!^*F ",
      "encoded_base64": "XiEvXipyXipJXiEiXiMkXiUhXipGXixYXiViXiNNXipBXiFSXiRfXit4XiViXig8XipDXiMkXiUhXipGXixYXi81XiNNXipBXiFSXiRfXiViXiVfXiZVXipDXiMkXiUhXipGIA==",
      "byte_length": 100
    },
    {
      "unit_id": "DLG_5e4a0b993d1f",
      "text": "是名戰士…… ",
      "encoded_ascii": "^,X^\"F^$(^+a^*o^*o ",
      "encoded_base64": "XixYXiJGXiQoXithXipvXipvIA==",
      "byte_length": 19
    },
    {
      "unit_id": "DLG_38e2480a64aa",
      "text": "那就別走！你們大可自由隨心行事。 ",
      "encoded_ascii": "^)!^*J^*H^.&^*W^*F^*{^\"z^\"A^'l^&I^)X^#k^(;^*r^!\" ",
      "encoded_base64": "XikhXipKXipIXi4mXipXXipGXip7XiJ6XiJBXidsXiZJXilYXiNrXig7XipyXiEiIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_cc521aa28ac2",
      "text": "很好。用不了多久了。 ",
      "encoded_ascii": "^*K^+i^!\"^&H^!)^*D^\"x^!.^*D^!\" ",
      "encoded_base64": "XipLXitpXiEiXiZIXiEpXipEXiJ4XiEuXipEXiEiIA==",
      "byte_length": 31
    },
    {
      "unit_id": "DLG_33b76241fb65",
      "text": "別拿無用的瑣事塞滿我的腦袋。我必須將心念全神貫注於這條 ",
      "encoded_ascii": "^*H^,G^%}^&H^&Z^9_^*r^/(^,{^$%^&Z^2@^(?^!\"^$%^#l^)r^#7^#k^1z^!h^&w^;J^%e^$^^(s^%. ",
      "encoded_base64": "XipIXixHXiV9XiZIXiZaXjlfXipyXi8oXix7XiQlXiZaXjJAXig/XiEiXiQlXiNsXilyXiM3XiNrXjF6XiFoXiZ3XjtKXiVlXiReXihzXiUuIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_515e8f04f160",
      "text": "道途之上。",
      "encoded_ascii": "^(y^3.^!/^!'^!\"",
      "encoded_base64": "Xih5XjMuXiEvXiEnXiEi",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_e6077ec9454e",
      "text": "我正在——或者說，方才正在——循著道途前行。你們打擾了無比崇高的奧秘。",
      "encoded_ascii": "^$%^%H^\"d^*n^*n^$'^'V^-x^*A^$]^$,^%H^\"d^*n^*n^#h^-a^(y^3.^!z^(;^!\"^*F^*{^$-^$K^*D^%}^,m^13^*+^&Z^6Q^1O^!\"",
      "encoded_base64": "XiQlXiVIXiJkXipuXipuXiQnXidWXi14XipBXiRdXiQsXiVIXiJkXipuXipuXiNoXi1hXih5XjMuXiF6Xig7XiEiXipGXip7XiQtXiRLXipEXiV9XixtXjEzXiorXiZaXjZRXjFPXiEi",
      "byte_length": 105
    },
    {
      "unit_id": "DLG_dafc717aea65",
      "text": "一個正在失去專注心神的人。很久以前，我也曾有過姓名與身分地位，但 ",
      "encoded_ascii": "^!%^!V^%H^\"d^\"|^\"6^#8^%e^#k^&w^&Z^!<^!\"^*K^!.^!B^!z^*A^$%^!1^.j^$s^(x^6S^\"F^'p^(c^!s^\"e^!J^*A^!I ",
      "encoded_base64": "XiElXiFWXiVIXiJkXiJ8XiI2XiM4XiVlXiNrXiZ3XiZaXiE8XiEiXipLXiEuXiFCXiF6XipBXiQlXiExXi5qXiRzXih4XjZTXiJGXidwXihjXiFzXiJlXiFKXipBXiFJIA==",
      "byte_length": 97
    },
    {
      "unit_id": "DLG_396f464cacf7",
      "text": "我早已將它們逐出腦海。我希望語言將是下一個消逝之物，如此一來 ",
      "encoded_ascii": "^$%^,V^#J^#7^+o^*{^(r^!q^2@^6`^!\"^$%^+{^,]^0:^1Y^#7^,X^!(^!%^!V^%k^0E^!/^&4^*A^#$^%I^!%^!O ",
      "encoded_base64": "XiQlXixWXiNKXiM3XitvXip7XihyXiFxXjJAXjZgXiEiXiQlXit7XixdXjA6XjFZXiM3XixYXiEoXiElXiFWXiVrXjBFXiEvXiY0XipBXiMkXiVJXiElXiFPIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_cd5c1be2c12a",
      "text": "過路的旅人便無法再打擾我。",
      "encoded_ascii": "^(x^(a^&Z^2m^!<^!R^%}^%b^!l^$-^$K^$%^!\"",
      "encoded_base64": "Xih4XihhXiZaXjJtXiE8XiFSXiV9XiViXiFsXiQtXiRLXiQlXiEi",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_eab08d54d5ed",
      "text": "因為道途就在此地。",
      "encoded_ascii": "^\"]^%{^(y^3.^*J^\"d^%I^\"e^!\"",
      "encoded_base64": "XiJdXiV7Xih5XjMuXipKXiJkXiVJXiJlXiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_b4693a2d4e9d",
      "text": "你們根本不懂何為自由。你們以為自由會被肉身的 ",
      "encoded_ascii": "^*F^*{^%)^$x^!)^,6^!L^%{^'l^&I^!\"^*F^*{^!B^%{^'l^&I^$r^(@^'^^(c^&Z ",
      "encoded_base64": "XipGXip7XiUpXiR4XiEpXiw2XiFMXiV7XidsXiZJXiEiXipGXip7XiFCXiV7XidsXiZJXiRyXihAXideXihjXiZaIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_36762c706a82",
      "text": "藩籬所禁錮，以為憑藉機智與武力便能獲取自由。你們 ",
      "encoded_ascii": "^?#^?\"^$)^&y^?%^*A^!B^%{^,5^04^%>^$i^'p^%J^!~^!R^'b^&:^\":^'l^&I^!\"^*F^*{ ",
      "encoded_base64": "Xj8jXj8iXiQpXiZ5Xj8lXipBXiFCXiV7Xiw1XjA0XiU+XiRpXidwXiVKXiF+XiFSXidiXiY6XiI6XidsXiZJXiEiXipGXip7IA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_e7ac70c321bd",
      "text": "大錯特錯了。",
      "encoded_ascii": "^\"z^)5^&5^)5^*D^!\"",
      "encoded_base64": "XiJ6Xik1XiY1Xik1XipEXiEi",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_540717c45e67",
      "text": "遠古先民在神秘能量交匯之處的大地上刻下了蘊含力量的符文。 ",
      "encoded_ascii": "^({^\"=^!b^%T^\"d^&w^1O^'b^)*^0P^>|^!/^(,^&Z^\"z^\"e^!'^.Y^!(^*D^6!^\"I^!~^)*^&Z^'+^$W^!\" ",
      "encoded_base64": "Xih7XiI9XiFiXiVUXiJkXiZ3XjFPXidiXikqXjBQXj58XiEvXigsXiZaXiJ6XiJlXiEnXi5ZXiEoXipEXjYhXiJJXiF+XikqXiZaXicrXiRXXiEiIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_40089248e62f",
      "text": "沿著眼前這條道途冥想前行，便能通往 ",
      "encoded_ascii": "^%`^-a^&d^!z^(s^%.^(y^3.^2X^,1^!z^(;^*A^!R^'b^(t^,) ",
      "encoded_base64": "XiVgXi1hXiZkXiF6XihzXiUuXih5XjMuXjJYXiwxXiF6Xig7XipBXiFSXidiXih0XiwpIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_4797334a6c6e",
      "text": "開悟之境。",
      "encoded_ascii": "^)F^=e^!/^\"q^!\"",
      "encoded_base64": "XilGXj1lXiEvXiJxXiEi",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_18db1ef71fb5",
      "text": "啊！你們害我想起了自己曾是馬里斯，德拉吉 ",
      "encoded_ascii": "^+Q^*W^*F^*{^#/^$%^,1^.(^*D^'l^#I^.j^,X^*\"^)(^$[^*A^#j^$6^\"D ",
      "encoded_base64": "XitRXipXXipGXip7XiMvXiQlXiwxXi4oXipEXidsXiNJXi5qXixYXioiXikoXiRbXipBXiNqXiQ2XiJEIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_8fd353bfd9a0",
      "text": "心靈異能學院的導師。我拒絕回想起更多事。你們正在阻礙 ",
      "encoded_ascii": "^#k^)g^&M^'b^+n^3/^&Z^10^#M^!\"^$%^5Q^-I^\"\\^,1^.(^$o^\"x^*r^!\"^*F^*{^%H^\"d^)L^:M ",
      "encoded_base64": "XiNrXilnXiZNXidiXituXjMvXiZaXjEwXiNNXiEiXiQlXjVRXi1JXiJcXiwxXi4oXiRvXiJ4XipyXiEiXipGXip7XiVIXiJkXilMXjpNIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_00aae59e0194",
      "text": "我的開悟進程。",
      "encoded_ascii": "^$%^&Z^)F^=e^(w^'#^!\"",
      "encoded_base64": "XiQlXiZaXilGXj1lXih3XicjXiEi",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_5c55db74bb9e",
      "text": "真正的自由存於心靈。你們被宿敵、肉體威脅與 ",
      "encoded_ascii": "^-2^%H^&Z^'l^&I^#*^$^^#k^)g^!\"^*F^*{^(@^7+^$U^!!^'^^**^#&^1T^'p ",
      "encoded_base64": "Xi0yXiVIXiZaXidsXiZJXiMqXiReXiNrXilnXiEiXipGXip7XihAXjcrXiRVXiEhXideXioqXiMmXjFUXidwIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_ea1fde15615a",
      "text": "凡俗情感所束縛。唯有澄澈的心靈才是真正的自由。這 ",
      "encoded_ascii": "^+-^8e^,0^#{^$)^$|^3W^!\"^+O^$s^>~^?!^&Z^#k^)g^$,^,X^-2^%H^&Z^'l^&I^!\"^(s ",
      "encoded_base64": "XistXjhlXiwwXiN7XiQpXiR8XjNXXiEiXitPXiRzXj5+Xj8hXiZaXiNrXilnXiQsXixYXi0yXiVIXiZaXidsXiZJXiEiXihzIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_b7617f8d35f5",
      "text": "便是開悟的終極之境。",
      "encoded_ascii": "^!R^,X^)F^=e^&Z^-H^1D^!/^\"q^!\"",
      "encoded_base64": "XiFSXixYXilGXj1lXiZaXi1IXjFEXiEvXiJxXiEi",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_fa43bfe611ff",
      "text": "開悟是循序漸進的，那是在獲取真正的超然體驗。 ",
      "encoded_ascii": "^)F^=e^,X^#h^;-^2v^(w^&Z^*A^)!^,X^\"d^&:^\":^-2^%H^&Z^(\\^&\"^**^.P^!\" ",
      "encoded_base64": "XilGXj1lXixYXiNoXjstXjJ2Xih3XiZaXipBXikhXixYXiJkXiY6XiI6Xi0yXiVIXiZaXihcXiYiXioqXi5QXiEiIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_76bda563181e",
      "text": "這條道途正是通往開悟最平實的途徑之一。",
      "encoded_ascii": "^(s^%.^(y^3.^%H^,X^(t^,)^)F^=e^$q^0Y^#3^&Z^3.^#c^!/^!%^!\"",
      "encoded_base64": "XihzXiUuXih5XjMuXiVIXixYXih0XiwpXilGXj1lXiRxXjBZXiMzXiZaXjMuXiNjXiEvXiElXiEi",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_fc47653417dc",
      "text": "即便像你們這般心緒雜亂，也是有可能辦到的。若要踏入第一階段， ",
      "encoded_ascii": "^\"1^!R^!`^*F^*{^(s^'r^#k^3#^0G^!3^*A^!1^,X^$s^\"A^'b^2L^!u^&Z^!\"^'x^(C^.,^!f^',^!%^=b^.l^*A ",
      "encoded_base64": "XiIxXiFSXiFgXipGXip7XihzXidyXiNrXjMjXjBHXiEzXipBXiExXixYXiRzXiJBXidiXjJMXiF1XiZaXiEiXid4XihDXi4sXiFmXicsXiElXj1iXi5sXipBIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_adfc023362f4",
      "text": "只需跟隨我沿著道途走上三圈即可。在那之後，就需要 ",
      "encoded_ascii": "^\"?^)e^.+^)X^$%^%`^-a^(y^3.^.&^!'^!&^\"_^\"1^\"A^!\"^\"d^)!^!/^#b^*A^*J^)e^(C ",
      "encoded_base64": "XiI/XillXi4rXilYXiQlXiVgXi1hXih5XjMuXi4mXiEnXiEmXiJfXiIxXiJBXiEiXiJkXikhXiEvXiNiXipBXipKXillXihDIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_c6fba3c20e57",
      "text": "相當的耐心與專注力了。",
      "encoded_ascii": "^&a^&N^&Z^-S^#k^'p^#8^%e^!~^*D^!\"",
      "encoded_base64": "XiZhXiZOXiZaXi1TXiNrXidwXiM4XiVlXiF+XipEXiEi",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_de00869f64e5",
      "text": "名字會將你束縛在凡俗的物質世界之中。若能屏除這些記憶， ",
      "encoded_ascii": "^\"F^#)^$r^#7^*F^$|^3W^\"d^+-^8e^&Z^&4^(Z^*p^.p^!/^!,^!\"^'x^'b^#@^)Q^(s^!8^(K^$\"^*A ",
      "encoded_base64": "XiJGXiMpXiRyXiM3XipGXiR8XjNXXiJkXistXjhlXiZaXiY0XihaXipwXi5wXiEvXiEsXiEiXid4XidiXiNAXilRXihzXiE4XihLXiQiXipBIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_f696e137f020",
      "text": "對你大有裨益。想跟著我就跟吧，我並不在乎。 ",
      "encoded_ascii": "^#:^*F^\"z^$s^?$^3R^!\"^,1^.+^-a^$%^*J^.+^*I^*A^$%^!+^!)^\"d^!0^!\" ",
      "encoded_base64": "XiM6XipGXiJ6XiRzXj8kXjNSXiEiXiwxXi4rXi1hXiQlXipKXi4rXipJXipBXiQlXiErXiEpXiJkXiEwXiEiIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_bf3be0fc7cb1",
      "text": "你們的存在已經從我的心神中淡去了。",
      "encoded_ascii": "^*F^*{^&Z^#*^\"d^#J^'D^#f^$%^&Z^#k^&w^!,^5_^\"6^*D^!\"",
      "encoded_base64": "XipGXip7XiZaXiMqXiJkXiNKXidEXiNmXiQlXiZaXiNrXiZ3XiEsXjVfXiI2XipEXiEi",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_f96050df0646",
      "text": " 感到思緒澄澈清明。 ",
      "encoded_ascii": " ^#{^!u^#q^3#^>~^?!^,u^$c^!\" ",
      "encoded_base64": "IF4je14hdV4jcV4zI14+fl4/IV4sdV4kY14hIiA=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_e47d0aa64947",
      "text": "的身軀放鬆下來，緊繃感隨之消散。 ",
      "encoded_ascii": "^&Z^(c^(d^$P^.R^!(^!O^*A^0r^>_^#{^)X^!/^%k^$S^!\" ",
      "encoded_base64": "XiZaXihjXihkXiRQXi5SXiEoXiFPXipBXjByXj5fXiN7XilYXiEvXiVrXiRTXiEiIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_002468e5fc08",
      "text": "所有困擾著 ",
      "encoded_ascii": "^$)^$s^\"^^$K^-a ",
      "encoded_base64": "XiQpXiRzXiJeXiRLXi1hIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_cfdcbaaf21f9",
      "text": "的世俗煩憂全都煙消雲散。 ",
      "encoded_ascii": "^&Z^*p^8e^-!^91^!h^)$^4S^%k^)b^$S^!\" ",
      "encoded_base64": "XiZaXipwXjhlXi0hXjkxXiFoXikkXjRTXiVrXiliXiRTXiEiIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_36864e568cba",
      "text": "色彩與形體在一個不可思議的世界中幻化出各自的靈性， ",
      "encoded_ascii": "^'s^#`^'p^#_^**^\"d^!%^!V^!)^\"A^#q^-|^&Z^*p^.p^!,^#S^\")^!q^+>^'l^&Z^)g^#r^*A ",
      "encoded_base64": "XidzXiNgXidwXiNfXioqXiJkXiElXiFWXiEpXiJBXiNxXi18XiZaXipwXi5wXiEsXiNTXiIpXiFxXis+XidsXiZaXilnXiNyXipBIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_48b980aa6707",
      "text": "展現出宏大深邃的意境。 ",
      "encoded_ascii": "^+x^&?^!q^45^\"z^2*^6;^&Z^#z^\"q^!\" ",
      "encoded_base64": "Xit4XiY/XiFxXjQ1XiJ6XjIqXjY7XiZaXiN6XiJxXiEiIA==",
      "byte_length": 34
    },
    {
      "unit_id": "DLG_15c82ab046cc",
      "text": "一個超然卓絕的至理開始凝聚於 ",
      "encoded_ascii": "^!%^!V^(\\^&\"^/#^-I^&Z^'n^&A^)F^+k^!o^'[^$^ ",
      "encoded_base64": "XiElXiFWXihcXiYiXi8jXi1JXiZaXiduXiZBXilGXitrXiFvXidbXiReIA==",
      "byte_length": 43
    },
    {
      "unit_id": "DLG_1b9d60665269",
      "text": "的心海之中。 ",
      "encoded_ascii": "^&Z^#k^6`^!/^!,^!\" ",
      "encoded_base64": "XiZaXiNrXjZgXiEvXiEsXiEiIA==",
      "byte_length": 19
    },
    {
      "unit_id": "DLG_1ea464fdcec4",
      "text": "這份真理具現於 ",
      "encoded_ascii": "^(s^*x^-2^&A^!k^&?^$^ ",
      "encoded_base64": "XihzXip4Xi0yXiZBXiFrXiY/XiReIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_395132b05ca6",
      "text": "的意識之中，令其 ",
      "encoded_ascii": "^&Z^#z^(R^!/^!,^*A^*w^!j ",
      "encoded_base64": "XiZaXiN6XihSXiEvXiEsXipBXip3XiFqIA==",
      "byte_length": 25
    },
    {
      "unit_id": "DLG_2fe31b8b02b5",
      "text": "獲得了心靈的開悟。 ",
      "encoded_ascii": "^&:^#e^*D^#k^)g^&Z^)F^=e^!\" ",
      "encoded_base64": "XiY6XiNlXipEXiNrXilnXiZaXilGXj1lXiEiIA==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_dd2d0ad09a21",
      "text": "去吧。拿到巨靈並殺了克拉格！",
      "encoded_ascii": "^\"6^*I^!\"^,G^!u^#H^)g^!+^%M^*D^!d^$6^%*^*W",
      "encoded_base64": "XiI2XipJXiEiXixHXiF1XiNIXilnXiErXiVNXipEXiFkXiQ2XiUqXipX",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_a229cc2c328e",
      "text": "你們為何在此？",
      "encoded_ascii": "^*F^*{^%{^!L^\"d^%I^.V",
      "encoded_base64": "XipGXip7XiV7XiFMXiJkXiVJXi5W",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_6d17e4ea5f14",
      "text": "  我正在尋找克拉格。",
      "encoded_ascii": "  ^$%^%H^\"d^#9^$/^!d^$6^%*^!\"",
      "encoded_base64": "ICBeJCVeJUheImReIzleJC9eIWReJDZeJSpeISI=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_18eeae5cfbb5",
      "text": "  我奉命前來取走鎮尼瓶。",
      "encoded_ascii": "  ^$%^1+^\"N^!z^!O^\":^.&^);^#>^&D^!\"",
      "encoded_base64": "ICBeJCVeMSteIk5eIXpeIU9eIjpeLiZeKTteIz5eJkReISI=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_a757e0550f04",
      "text": "  我正在尋找巨靈。",
      "encoded_ascii": "  ^$%^%H^\"d^#9^$/^#H^)g^!\"",
      "encoded_base64": "ICBeJCVeJUheImReIzleJC9eI0heKWdeISI=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_40f938784e67",
      "text": "  我沒必要回答你！",
      "encoded_ascii": "  ^$%^%\\^#l^(C^\"\\^-B^*F^*W",
      "encoded_base64": "ICBeJCVeJVxeI2xeKENeIlxeLUJeKkZeKlc=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_8d2f8a62611c",
      "text": "別惹我心煩。我的耐性有限。",
      "encoded_ascii": "^*H^3s^$%^#k^-!^!\"^$%^&Z^-S^#r^$s^)O^!\"",
      "encoded_base64": "XipIXjNzXiQlXiNrXi0hXiEiXiQlXiZaXi1TXiNyXiRzXilPXiEi",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_89cda1c454e2",
      "text": "若是還想活命，就老老實實回答我！ ",
      "encoded_ascii": "^'x^,X^.7^,1^%i^\"N^*A^*J^'U^'U^#3^#3^\"\\^-B^$%^*W ",
      "encoded_base64": "Xid4XixYXi43XiwxXiVpXiJOXipBXipKXidVXidVXiMzXiMzXiJcXi1CXiQlXipXIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_c85a79cf8a33",
      "text": "不回答我的問題，你們休想離開！",
      "encoded_ascii": "^!)^\"\\^-B^$%^&Z^*Z^.G^*A^*F^*{^!G^,1^)`^)F^*W",
      "encoded_base64": "XiEpXiJcXi1CXiQlXiZaXipaXi5HXipBXipGXip7XiFHXiwxXilgXilGXipX",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_8ae7d7c721c4",
      "text": "你們找克拉格做什麼？",
      "encoded_ascii": "^*F^*{^$/^!d^$6^%*^*~^!=^.T^.V",
      "encoded_base64": "XipGXip7XiQvXiFkXiQ2XiUqXip+XiE9Xi5UXi5W",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_092a20eb476a",
      "text": "  我想與他談談。",
      "encoded_ascii": "  ^$%^,1^'p^!@^0;^0;^!\"",
      "encoded_base64": "ICBeJCVeLDFeJ3BeIUBeMDteMDteISI=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_fc337481cede",
      "text": "  我需要從他那裡打聽消息。",
      "encoded_ascii": "  ^$%^)e^(C^#f^!@^)!^-j^$-^-X^%k^#w^!\"",
      "encoded_base64": "ICBeJCVeKWVeKENeI2ZeIUBeKSFeLWpeJC1eLVheJWteI3deISI=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_58e35d152be8",
      "text": "  我想尋求與他結盟。",
      "encoded_ascii": "  ^$%^,1^#9^,n^'p^!@^'@^-0^!\"",
      "encoded_base64": "ICBeJCVeLDFeIzleLG5eJ3BeIUBeJ0BeLTBeISI=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_88cc4f720dee",
      "text": "  我是來消滅他的。",
      "encoded_ascii": "  ^$%^,X^!O^%k^%t^!@^&Z^!\"",
      "encoded_base64": "ICBeJCVeLFheIU9eJWteJXReIUBeJlpeISI=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_2a9c6ae6a62e",
      "text": "你們沒有理由去找他談話。他幫不了你們。立刻滾開，否則 ",
      "encoded_ascii": "^*F^*{^%\\^$s^&A^&I^\"6^$/^!@^0;^-v^!\"^!@^+}^!)^*D^*F^*{^!\"^0'^.Y^,z^)F^*A^\"H^!x ",
      "encoded_base64": "XipGXip7XiVcXiRzXiZBXiZJXiI2XiQvXiFAXjA7Xi12XiEiXiFAXit9XiEpXipEXipGXip7XiEiXjAnXi5ZXix6XilGXipBXiJIXiF4IA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_e82bf8edf036",
      "text": "你們就會去陵墓裡陪伴那些死者！",
      "encoded_ascii": "^*F^*{^*J^$r^\"6^7!^6P^-j^8.^1h^)!^!8^%L^'V^*W",
      "encoded_base64": "XipGXip7XipKXiRyXiI2XjchXjZQXi1qXjguXjFoXikhXiE4XiVMXidWXipX",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_6059f8020411",
      "text": "你們竟然想跟那個卑鄙小人結盟？顯然，你們居心 ",
      "encoded_ascii": "^*F^*{^28^&\"^,1^.+^)!^!V^\".^8,^#;^!<^'@^-0^.V^4&^&\"^*A^*F^*{^+w^#k ",
      "encoded_base64": "XipGXip7XjI4XiYiXiwxXi4rXikhXiFWXiIuXjgsXiM7XiE8XidAXi0wXi5WXjQmXiYiXipBXipGXip7Xit3XiNrIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_769d01aab646",
      "text": "叵測！",
      "encoded_ascii": "^>}^%p^*W",
      "encoded_base64": "Xj59XiVwXipX",
      "byte_length": 9
    },
    {
      "unit_id": "DLG_c812c6aacfb8",
      "text": "那麼你們可以過去了。",
      "encoded_ascii": "^)!^.T^*F^*{^\"A^!B^(x^\"6^*D^!\"",
      "encoded_base64": "XikhXi5UXipGXip7XiJBXiFCXih4XiI2XipEXiEi",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_d65be16cfabf",
      "text": "誰派你們來的？",
      "encoded_ascii": "^-y^.n^*F^*{^!O^&Z^.V",
      "encoded_base64": "Xi15Xi5uXipGXip7XiFPXiZaXi5W",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_2ff519cc568c",
      "text": "  是德懷爾國王派我來的。",
      "encoded_ascii": "  ^,X^#j^,9^&/^+^^-)^.n^$%^!O^&Z^!\"",
      "encoded_base64": "ICBeLFheI2peLDleJi9eK15eLSleLm5eJCVeIU9eJlpeISI=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_c9643d83690a",
      "text": "  是大門口的蘇隆蟲人派我來的。",
      "encoded_ascii": "  ^,X^\"z^)D^\"<^&Z^4c^)T^(8^!<^.n^$%^!O^&Z^!\"",
      "encoded_base64": "ICBeLFheInpeKUReIjxeJlpeNGNeKVReKDheITxeLm5eJCVeIU9eJlpeISI=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_26595dc78a47",
      "text": "  我是為了破除克拉格對宮殿施加的詛咒。",
      "encoded_ascii": "  ^$%^,X^%{^*D^&n^)Q^!d^$6^%*^#:^/\\^.m^$_^\"\"^&Z^(L^\"P^!\"",
      "encoded_base64": "ICBeJCVeLFheJXteKkReJm5eKVFeIWReJDZeJSpeIzpeL1xeLm1eJF9eIiJeJlpeKExeIlBeISI=",
      "byte_length": 56
    },
    {
      "unit_id": "DLG_5a819794d48e",
      "text": "  我是來把它交給你的。",
      "encoded_ascii": "  ^$%^,X^!O^$1^+o^0P^'A^*F^&Z^!\"",
      "encoded_base64": "ICBeJCVeLFheIU9eJDFeK29eMFBeJ0FeKkZeJlpeISI=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_5a92bc683e9d",
      "text": "他為何派你們來取巨靈？",
      "encoded_ascii": "^!@^%{^!L^.n^*F^*{^!O^\":^#H^)g^.V",
      "encoded_base64": "XiFAXiV7XiFMXi5uXipGXip7XiFPXiI6XiNIXilnXi5W",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_7ff3aa8ca8b2",
      "text": "很好。他希望我們能解除這詛咒。你們必須拿到那個瓶子。 ",
      "encoded_ascii": "^*K^+i^!\"^!@^+{^,]^$%^*{^'b^(I^)Q^(s^(L^\"P^!\"^*F^*{^#l^)r^,G^!u^)!^!V^&D^#(^!\" ",
      "encoded_base64": "XipLXitpXiEiXiFAXit7XixdXiQlXip7XidiXihJXilRXihzXihMXiJQXiEiXipGXip7XiNsXilyXixHXiF1XikhXiFWXiZEXiMoXiEiIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_6d35708f99e8",
      "text": "你們想扭轉克拉格造下的惡行？那你們必須借助巨靈的力量才能辦到， ",
      "encoded_ascii": "^*F^*{^,1^1;^(i^!d^$6^%*^(v^!(^&Z^#y^(;^.V^)!^*F^*{^#l^)r^!Y^\"#^#H^)g^&Z^!~^)*^$,^'b^2L^!u^*A ",
      "encoded_base64": "XipGXip7XiwxXjE7XihpXiFkXiQ2XiUqXih2XiEoXiZaXiN5Xig7Xi5WXikhXipGXip7XiNsXilyXiFZXiIjXiNIXilnXiZaXiF+XikqXiQsXidiXjJMXiF1XipBIA==",
      "byte_length": 94
    },
    {
      "unit_id": "DLG_4386d7848973",
      "text": "這你們心知肚明。",
      "encoded_ascii": "^(s^*F^*{^#k^&h^=1^$c^!\"",
      "encoded_base64": "XihzXipGXip7XiNrXiZoXj0xXiRjXiEi",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_b3d447e887fc",
      "text": "你們要巨靈做什麼？",
      "encoded_ascii": "^*F^*{^(C^#H^)g^*~^!=^.T^.V",
      "encoded_base64": "XipGXip7XihDXiNIXilnXip+XiE9Xi5UXi5W",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_d0d6ff34391e",
      "text": "  把它交給大門口的蘇隆蟲人。",
      "encoded_ascii": "  ^$1^+o^0P^'A^\"z^)D^\"<^&Z^4c^)T^(8^!<^!\"",
      "encoded_base64": "ICBeJDFeK29eMFBeJ0FeInpeKUReIjxeJlpeNGNeKVReKDheITxeISI=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_8eb6a32cf9e8",
      "text": "  我需要藉其力量擊敗一支強大的軍隊。",
      "encoded_ascii": "  ^$%^)e^(C^04^!j^!~^)*^$F^$R^!%^$L^#]^\"z^&Z^..^)U^!\"",
      "encoded_base64": "ICBeJCVeKWVeKENeMDReIWpeIX5eKSpeJEZeJFJeISVeJExeI11eInpeJlpeLi5eKVVeISI=",
      "byte_length": 53
    },
    {
      "unit_id": "DLG_939e6b7f15d9",
      "text": "  為了拯救並解救宮殿中的子民。",
      "encoded_ascii": "  ^%{^*D^,F^,Q^!+^(I^,Q^/\\^.m^!,^&Z^#(^%T^!\"",
      "encoded_base64": "ICBeJXteKkReLEZeLFFeISteKEleLFFeL1xeLm1eISxeJlpeIyheJVReISI=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_58fc0694d164",
      "text": "你們該知道，不動武的話克拉格絕不會交出巨靈。",
      "encoded_ascii": "^*F^*{^(M^&h^(y^*A^!)^\"%^%J^&Z^-v^!d^$6^%*^-I^!)^$r^0P^!q^#H^)g^!\"",
      "encoded_base64": "XipGXip7XihNXiZoXih5XipBXiEpXiIlXiVKXiZaXi12XiFkXiQ2XiUqXi1JXiEpXiRyXjBQXiFxXiNIXilnXiEi",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_1a011e55030c",
      "text": "你們願意殺了克拉格以奪取鎮尼瓶嗎？",
      "encoded_ascii": "^*F^*{^.H^#z^%M^*D^!d^$6^%*^!B^1,^\":^);^#>^&D^+X^.V",
      "encoded_base64": "XipGXip7Xi5IXiN6XiVNXipEXiFkXiQ2XiUqXiFCXjEsXiI6Xik7XiM+XiZEXitYXi5W",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_e7cbda2c538d",
      "text": "你們可以前進了。",
      "encoded_ascii": "^*F^*{^\"A^!B^!z^(w^*D^!\"",
      "encoded_base64": "XipGXip7XiJBXiFCXiF6Xih3XipEXiEi",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_f779ce8582b7",
      "text": "你們必須殺了克拉格才能拿到巨靈。別無他法。",
      "encoded_ascii": "^*F^*{^#l^)r^%M^*D^!d^$6^%*^$,^'b^,G^!u^#H^)g^!\"^*H^%}^!@^%b^!\"",
      "encoded_base64": "XipGXip7XiNsXilyXiVNXipEXiFkXiQ2XiUqXiQsXidiXixHXiF1XiNIXilnXiEiXipIXiV9XiFAXiViXiEi",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_f31d0a60c853",
      "text": "你們會為了拿到巨靈而殺了他嗎？",
      "encoded_ascii": "^*F^*{^$r^%{^*D^,G^!u^#H^)g^'W^%M^*D^!@^+X^.V",
      "encoded_base64": "XipGXip7XiRyXiV7XipEXixHXiF1XiNIXilnXidXXiVNXipEXiFAXitYXi5W",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_80abfb725371",
      "text": "我聽膩了你們的廢話！",
      "encoded_ascii": "^$%^-X^:=^*D^*F^*{^&Z^#W^-v^*W",
      "encoded_base64": "XiQlXi1YXjo9XipEXipGXip7XiZaXiNXXi12XipX",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_0da11bfaa5f0",
      "text": "這裡沒有任何對你們有用的東西。滾開，否則你們就去陵墓裡 ",
      "encoded_ascii": "^(s^-j^%\\^$s^!C^!L^#:^*F^*{^$s^&H^&Z^,`^-l^!\"^,z^)F^*A^\"H^!x^*F^*{^*J^\"6^7!^6P^-j ",
      "encoded_base64": "XihzXi1qXiVcXiRzXiFDXiFMXiM6XipGXip7XiRzXiZIXiZaXixgXi1sXiEiXix6XilGXipBXiJIXiF4XipGXip7XipKXiI2XjchXjZQXi1qIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_6041ce3b306a",
      "text": "陪伴那些死者吧！",
      "encoded_ascii": "^8.^1h^)!^!8^%L^'V^*I^*W",
      "encoded_base64": "XjguXjFoXikhXiE4XiVMXidWXipJXipX",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_5c511f7b8576",
      "text": "你們為何煩——啊，朋友們！你們和克拉格交涉得如何？",
      "encoded_ascii": "^*F^*{^%{^!L^-!^*n^*n^+Q^*A^,[^\"8^*{^*W^*F^*{^\"O^!d^$6^%*^0P^3O^#e^#$^!L^.V",
      "encoded_base64": "XipGXip7XiV7XiFMXi0hXipuXipuXitRXipBXixbXiI4Xip7XipXXipGXip7XiJPXiFkXiQ2XiUqXjBQXjNPXiNlXiMkXiFMXi5W",
      "byte_length": 75
    },
    {
      "unit_id": "DLG_88eb10bae5f8",
      "text": "  我還沒見到克拉格。 ",
      "encoded_ascii": "  ^$%^.7^%\\^-m^!u^!d^$6^%*^!\" ",
      "encoded_base64": "ICBeJCVeLjdeJVxeLW1eIXVeIWReJDZeJSpeISIg",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_e585d1b67720",
      "text": "  不太順利。他想要找回自己的身軀。",
      "encoded_ascii": "  ^!)^+f^.D^!t^!\"^!@^,1^(C^$/^\"\\^'l^#I^&Z^(c^(d^!\"",
      "encoded_base64": "ICBeISleK2ZeLkReIXReISJeIUBeLDFeKENeJC9eIlxeJ2xeI0leJlpeKGNeKGReISI=",
      "byte_length": 50
    },
    {
      "unit_id": "DLG_1939674c3e54",
      "text": "  克拉格說他的身軀在你們手上。 ",
      "encoded_ascii": "  ^!d^$6^%*^-x^!@^&Z^(c^(d^\"d^*F^*{^$+^!'^!\" ",
      "encoded_base64": "ICBeIWReJDZeJSpeLXheIUBeJlpeKGNeKGReImReKkZeKnteJCteISdeISIg",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_811978383e39",
      "text": "  我殺了克拉格，拿到了巨靈！",
      "encoded_ascii": "  ^$%^%M^*D^!d^$6^%*^*A^,G^!u^*D^#H^)g^*W",
      "encoded_base64": "ICBeJCVeJU1eKkReIWReJDZeJSpeKkFeLEdeIXVeKkReI0heKWdeKlc=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_e8ff6c3faa6f",
      "text": "  我殺了克拉格，但沒拿到巨靈。",
      "encoded_ascii": "  ^$%^%M^*D^!d^$6^%*^*A^!I^%\\^,G^!u^#H^)g^!\"",
      "encoded_base64": "ICBeJCVeJU1eKkReIWReJDZeJSpeKkFeIUleJVxeLEdeIXVeI0heKWdeISI=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_26295d7c460f",
      "text": "  我沒有殺克拉格，但我拿到了巨靈。",
      "encoded_ascii": "  ^$%^%\\^$s^%M^!d^$6^%*^*A^!I^$%^,G^!u^*D^#H^)g^!\"",
      "encoded_base64": "ICBeJCVeJVxeJHNeJU1eIWReJDZeJSpeKkFeIUleJCVeLEdeIXVeKkReI0heKWdeISI=",
      "byte_length": 50
    },
    {
      "unit_id": "DLG_120ed08e60b6",
      "text": "  我既沒殺克拉格，也沒拿到巨靈。",
      "encoded_ascii": "  ^$%^,U^%\\^%M^!d^$6^%*^*A^!1^%\\^,G^!u^#H^)g^!\"",
      "encoded_base64": "ICBeJCVeLFVeJVxeJU1eIWReJDZeJSpeKkFeITFeJVxeLEdeIXVeI0heKWdeISI=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_b41e18f5a42d",
      "text": "  這就交給你。",
      "encoded_ascii": "  ^(s^*J^0P^'A^*F^!\"",
      "encoded_base64": "ICBeKHNeKkpeMFBeJ0FeKkZeISI=",
      "byte_length": 20
    },
    {
      "unit_id": "DLG_f0f634f2582d",
      "text": "  我能從中得到什麼好處？",
      "encoded_ascii": "  ^$%^'b^#f^!,^#e^!u^!=^.T^+i^(,^.V",
      "encoded_base64": "ICBeJCVeJ2JeI2ZeISxeI2VeIXVeIT1eLlReK2leKCxeLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_bbc6eb9fcfd8",
      "text": "  你打算破除克拉格的詛咒了嗎？",
      "encoded_ascii": "  ^*F^$-^-C^&n^)Q^!d^$6^%*^&Z^(L^\"P^*D^+X^.V",
      "encoded_base64": "ICBeKkZeJC1eLUNeJm5eKVFeIWReJDZeJSpeJlpeKExeIlBeKkReK1heLlY=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_3fdd0bd75d25",
      "text": "  我改變主意了。",
      "encoded_ascii": "  ^$%^$N^(U^!-^#z^*D^!\"",
      "encoded_base64": "ICBeJCVeJE5eKFVeIS1eI3peKkReISI=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_8bede04052ae",
      "text": "  我想重新談判。",
      "encoded_ascii": "  ^$%^,1^))^$\\^0;^1k^!\"",
      "encoded_base64": "ICBeJCVeLDFeKSleJFxeMDteMWteISI=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_3e353a39a997",
      "text": "我必須離開了。 ",
      "encoded_ascii": "^$%^#l^)r^)`^)F^*D^!\" ",
      "encoded_base64": "XiQlXiNsXilyXilgXilGXipEXiEiIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_b5ea36baaba9",
      "text": "還沒？那麼趕快行動！這座城市必須得救！克拉格就在北邊的殿堂裡。 ",
      "encoded_ascii": "^.7^%\\^.V^)!^.T^0u^*L^(;^\"%^*W^(s^/_^+_^+z^#l^)r^#e^,Q^*W^!d^$6^%*^*J^\"d^+6^.8^&Z^.m^42^-j^!\" ",
      "encoded_base64": "Xi43XiVcXi5WXikhXi5UXjB1XipMXig7XiIlXipXXihzXi9fXitfXit6XiNsXilyXiNlXixRXipXXiFkXiQ2XiUqXipKXiJkXis2Xi44XiZaXi5tXjQyXi1qXiEiIA==",
      "byte_length": 94
    },
    {
      "unit_id": "DLG_3d1cd9834a61",
      "text": "去找到他，並從他手中奪下巨靈！ ",
      "encoded_ascii": "^\"6^$/^!u^!@^*A^!+^#f^!@^$+^!,^1,^!(^#H^)g^*W ",
      "encoded_base64": "XiI2XiQvXiF1XiFAXipBXiErXiNmXiFAXiQrXiEsXjEsXiEoXiNIXilnXipXIA==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_524f4be8e68e",
      "text": "很好，但你們必須拿到鎮尼瓶，我們才能化解這場詛咒。動作 ",
      "encoded_ascii": "^*K^+i^*A^!I^*F^*{^#l^)r^,G^!u^);^#>^&D^*A^$%^*{^$,^'b^\")^(I^(s^\"n^(L^\"P^!\"^\"%^!M ",
      "encoded_base64": "XipLXitpXipBXiFJXipGXip7XiNsXilyXixHXiF1Xik7XiM+XiZEXipBXiQlXip7XiQsXidiXiIpXihJXihzXiJuXihMXiJQXiEiXiIlXiFNIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_511c87f61a1e",
      "text": "快點！ ",
      "encoded_ascii": "^*L^*;^*W ",
      "encoded_base64": "XipMXio7XipXIA==",
      "byte_length": 10
    },
    {
      "unit_id": "DLG_d40284434257",
      "text": "巨靈就在你們手裡！休想否認！現在立刻把它交給我！ ",
      "encoded_ascii": "^#H^)g^*J^\"d^*F^*{^$+^-j^*W^!G^,1^\"H^(O^*W^&?^\"d^0'^.Y^$1^+o^0P^'A^$%^*W ",
      "encoded_base64": "XiNIXilnXipKXiJkXipGXip7XiQrXi1qXipXXiFHXiwxXiJIXihPXipXXiY/XiJkXjAnXi5ZXiQxXitvXjBQXidBXiQlXipXIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_1975dd613648",
      "text": "荒謬透頂。如果真是那樣，我們何不用它來換取鎮尼瓶？ ",
      "encoded_ascii": "^1W^3+^(q^)p^!\"^#$^%!^-2^,X^)!^,f^*A^$%^*{^!L^!)^&H^+o^!O^4@^\":^);^#>^&D^.V ",
      "encoded_base64": "XjFXXjMrXihxXilwXiEiXiMkXiUhXi0yXixYXikhXixmXipBXiQlXip7XiFMXiEpXiZIXitvXiFPXjRAXiI6Xik7XiM+XiZEXi5WIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_801d3b0fe008",
      "text": "你們弄錯了。他一定是把它藏在城堡的西側部分。 ",
      "encoded_ascii": "^*F^*{^/`^)5^*D^!\"^!@^!%^#.^,X^$1^+o^-f^\"d^+_^\"m^&Z^-l^!\\^)#^!s^!\" ",
      "encoded_base64": "XipGXip7Xi9gXik1XipEXiEiXiFAXiElXiMuXixYXiQxXitvXi1mXiJkXitfXiJtXiZaXi1sXiFcXikjXiFzXiEiIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_46f74467af59",
      "text": "那片區域布滿了陷阱與怪物——它肯定就在那裡。 ",
      "encoded_ascii": "^)!^&1^\"+^\"k^.`^,{^*D^)S^)J^'p^#s^&4^*n^*n^+o^-Z^#.^*J^\"d^)!^-j^!\" ",
      "encoded_base64": "XikhXiYxXiIrXiJrXi5gXix7XipEXilTXilKXidwXiNzXiY0XipuXipuXitvXi1aXiMuXipKXiJkXikhXi1qXiEiIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_cf367862ea82",
      "text": "什麼？你們竟然跟他談條件？你們去那裡是為了殺了他的！ ",
      "encoded_ascii": "^!=^.T^.V^*F^*{^28^&\"^.+^!@^0;^%.^.W^.V^*F^*{^\"6^)!^-j^,X^%{^*D^%M^*D^!@^&Z^*W ",
      "encoded_base64": "XiE9Xi5UXi5WXipGXip7XjI4XiYiXi4rXiFAXjA7XiUuXi5XXi5WXipGXip7XiI2XikhXi1qXixYXiV7XipEXiVNXipEXiFAXiZaXipXIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_cc688eea83ed",
      "text": "無妨。必須找到他的身軀，這樣你們才能替我們奪回巨靈。 ",
      "encoded_ascii": "^%}^5D^!\"^#l^)r^$/^!u^!@^&Z^(c^(d^*A^(s^,f^*F^*{^$,^'b^2o^$%^*{^1,^\"\\^#H^)g^!\" ",
      "encoded_base64": "XiV9XjVEXiEiXiNsXilyXiQvXiF1XiFAXiZaXihjXihkXipBXihzXixmXipGXip7XiQsXidiXjJvXiQlXip7XjEsXiJcXiNIXilnXiEiIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_070c66245a1b",
      "text": "你們辦事相當俐落，順利完成了差事。現在，做個了結吧， ",
      "encoded_ascii": "^*F^*{^2L^*r^&a^&N^<b^-`^*A^.D^!t^#,^$$^*D^48^*r^!\"^&?^\"d^*A^*~^!V^*D^'@^*I^*A ",
      "encoded_base64": "XipGXip7XjJMXipyXiZhXiZOXjxiXi1gXipBXi5EXiF0XiMsXiQkXipEXjQ4XipyXiEiXiY/XiJkXipBXip+XiFWXipEXidAXipJXipBIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_007893c1d157",
      "text": "把巨靈交給我。",
      "encoded_ascii": "^$1^#H^)g^0P^'A^$%^!\"",
      "encoded_base64": "XiQxXiNIXilnXjBQXidBXiQlXiEi",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_74889935d57e",
      "text": "去把巨靈拿來！我已經受夠了你們的無禮態度。",
      "encoded_ascii": "^\"6^$1^#H^)g^,G^!O^*W^$%^#J^'D^\";^+d^*D^*F^*{^&Z^%}^-8^#|^#V^!\"",
      "encoded_base64": "XiI2XiQxXiNIXilnXixHXiFPXipXXiQlXiNKXidEXiI7XitkXipEXipGXip7XiZaXiV9Xi04XiN8XiNWXiEi",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_3fbe9f9e5c0c",
      "text": "不過你們竟然能從他的魔爪下將巨靈弄到手。你們 ",
      "encoded_ascii": "^!)^(x^*F^*{^28^&\"^'b^#f^!@^&Z^*0^&.^!(^#7^#H^)g^/`^!u^$+^!\"^*F^*{ ",
      "encoded_base64": "XiEpXih4XipGXip7XjI4XiYiXidiXiNmXiFAXiZaXiowXiYuXiEoXiM3XiNIXilnXi9gXiF1XiQrXiEiXipGXip7IA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_8dac2ef4e7dc",
      "text": "還真是詭計多端。現在，把巨靈交出來。",
      "encoded_ascii": "^.7^-2^,X^;H^-n^\"x^5o^!\"^&?^\"d^*A^$1^#H^)g^0P^!q^!O^!\"",
      "encoded_base64": "Xi43Xi0yXixYXjtIXi1uXiJ4XjVvXiEiXiY/XiJkXipBXiQxXiNIXilnXjBQXiFxXiFPXiEi",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_c67712bd9402",
      "text": "你們在這裡做什麼？立刻離開，若是拿不到結果就 ",
      "encoded_ascii": "^*F^*{^\"d^(s^-j^*~^!=^.T^.V^0'^.Y^)`^)F^*A^'x^,X^,G^!)^!u^'@^%!^*J ",
      "encoded_base64": "XipGXip7XiJkXihzXi1qXip+XiE9Xi5UXi5WXjAnXi5ZXilgXilGXipBXid4XixYXixHXiEpXiF1XidAXiUhXipKIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_fe92fe97eae5",
      "text": "別再回來！",
      "encoded_ascii": "^*H^!l^\"\\^!O^*W",
      "encoded_base64": "XipIXiFsXiJcXiFPXipX",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_edb4b9627689",
      "text": "噢，偉大的巨靈！我命令你開啟通往元素位面的裂隙，釋放 ",
      "encoded_ascii": "^+]^*A^*}^\"z^&Z^#H^)g^*W^$%^\"N^*w^*F^)F^57^(t^,)^!a^'=^!J^)j^&Z^8r^8v^*A^0w^$P ",
      "encoded_base64": "XitdXipBXip9XiJ6XiZaXiNIXilnXipXXiQlXiJOXip3XipGXilGXjU3Xih0XiwpXiFhXic9XiFKXilqXiZaXjhyXjh2XipBXjB3XiRQIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_c7e580d7b437",
      "text": "我的同胞！ ",
      "encoded_ascii": "^$%^&Z^\"E^'`^*W ",
      "encoded_base64": "XiQlXiZaXiJFXidgXipXIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_78a406bc6905",
      "text": "騙子！你們竟敢戲弄蘇隆蟲人！",
      "encoded_ascii": "^.{^#(^*W^*F^*{^28^/m^,;^/`^4c^)T^(8^!<^*W",
      "encoded_base64": "Xi57XiMoXipXXipGXip7XjI4Xi9tXiw7Xi9gXjRjXilUXig4XiE8XipX",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_da9aec4b9e6e",
      "text": "我們可不是來談條件的。動作快！把巨靈交給我！",
      "encoded_ascii": "^$%^*{^\"A^!)^,X^!O^0;^%.^.W^&Z^!\"^\"%^!M^*L^*W^$1^#H^)g^0P^'A^$%^*W",
      "encoded_base64": "XiQlXip7XiJBXiEpXixYXiFPXjA7XiUuXi5XXiZaXiEiXiIlXiFNXipMXipXXiQxXiNIXilnXjBQXidBXiQlXipX",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_0783e1a0bec7",
      "text": "噢，我們當然會。只要把巨靈交出來就行了。",
      "encoded_ascii": "^+]^*A^$%^*{^&N^&\"^$r^!\"^\"?^(C^$1^#H^)g^0P^!q^!O^*J^(;^*D^!\"",
      "encoded_base64": "XitdXipBXiQlXip7XiZOXiYiXiRyXiEiXiI/XihDXiQxXiNIXilnXjBQXiFxXiFPXipKXig7XipEXiEi",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_d3f151ef13a6",
      "text": "少在那裡耍花樣了！從沒有人敢背棄與蘇隆蟲人的交易！ ",
      "encoded_ascii": "^#<^\"d^)!^-j^7E^'w^,f^*D^*W^#f^%\\^$s^!<^/m^.r^,a^'p^4c^)T^(8^!<^&Z^0P^,W^*W ",
      "encoded_base64": "XiM8XiJkXikhXi1qXjdFXid3XixmXipEXipXXiNmXiVcXiRzXiE8Xi9tXi5yXixhXidwXjRjXilUXig4XiE8XiZaXjBQXixXXipXIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_12711bdd04b6",
      "text": "我絕不會把巨靈交給你們！絕不能讓那些蘇隆蟲人 ",
      "encoded_ascii": "^$%^-I^!)^$r^$1^#H^)g^0P^'A^*F^*{^*W^-I^!)^'b^-}^)!^!8^4c^)T^(8^!< ",
      "encoded_base64": "XiQlXi1JXiEpXiRyXiQxXiNIXilnXjBQXidBXipGXip7XipXXi1JXiEpXidiXi19XikhXiE4XjRjXilUXig4XiE8IA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_79b2afc85f87",
      "text": "染指並利用它！ ",
      "encoded_ascii": "^%%^$8^!+^!t^&H^+o^*W ",
      "encoded_base64": "XiUlXiQ4XiErXiF0XiZIXitvXipXIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_f2f5a17838cd",
      "text": "凡膽敢擅闖這座神聖陵墓者當心了，因為我是此地的守護者， ",
      "encoded_ascii": "^+-^-[^/m^2$^.z^(s^/_^&w^'Z^7!^6P^'V^&N^#k^*D^*A^\"]^%{^$%^,X^%I^\"e^&Z^#+^(T^'V^*A ",
      "encoded_base64": "XistXi1bXi9tXjIkXi56XihzXi9fXiZ3XidaXjchXjZQXidWXiZOXiNrXipEXipBXiJdXiV7XiQlXixYXiVJXiJlXiZaXiMrXihUXidWXipBIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_87115e661601",
      "text": "而我的正義裁決絕不留情。 ",
      "encoded_ascii": "^'W^$%^&Z^%H^2<^6%^,o^-I^!)^-+^,0^!\" ",
      "encoded_base64": "XidXXiQlXiZaXiVIXjI8XjYlXixvXi1JXiEpXi0rXiwwXiEiIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_490b3f4db4e1",
      "text": "你們因何來到此地？",
      "encoded_ascii": "^*F^*{^\"]^!L^!O^!u^%I^\"e^.V",
      "encoded_base64": "XipGXip7XiJdXiFMXiFPXiF1XiVJXiJlXi5W",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_599157d39e0c",
      "text": "我問的不是你們的名字，而是你們的來意。告訴我你們來此究竟所為何求。 ",
      "encoded_ascii": "^$%^*Z^&Z^!)^,X^*F^*{^&Z^\"F^#)^*A^'W^,X^*F^*{^&Z^!O^#z^!\"^+B^-t^$%^*F^*{^!O^%I^-<^28^$)^%{^!L^,n^!\" ",
      "encoded_base64": "XiQlXipaXiZaXiEpXixYXipGXip7XiZaXiJGXiMpXipBXidXXixYXipGXip7XiZaXiFPXiN6XiEiXitCXi10XiQlXipGXip7XiFPXiVJXi08XjI4XiQpXiV7XiFMXixuXiEiIA==",
      "byte_length": 100
    },
    {
      "unit_id": "DLG_19225b315766",
      "text": "現在是我在發問——不是你們。告訴我你們為何來到這裡。 ",
      "encoded_ascii": "^&?^\"d^,X^$%^\"d^&W^*Z^*n^*n^!)^,X^*F^*{^!\"^+B^-t^$%^*F^*{^%{^!L^!O^!u^(s^-j^!\" ",
      "encoded_base64": "XiY/XiJkXixYXiQlXiJkXiZXXipaXipuXipuXiEpXixYXipGXip7XiEiXitCXi10XiQlXipGXip7XiV7XiFMXiFPXiF1XihzXi1qXiEiIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_a60d69cdc77c",
      "text": "你們想尋找巨靈？ ",
      "encoded_ascii": "^*F^*{^,1^#9^$/^#H^)g^.V ",
      "encoded_base64": "XipGXip7XiwxXiM5XiQvXiNIXilnXi5WIA==",
      "byte_length": 25
    },
    {
      "unit_id": "DLG_7ac4251dee53",
      "text": "你們為何要尋找擁有如此力量之物——那絕非可以肆意玩弄的兒戲。 ",
      "encoded_ascii": "^*F^*{^%{^!L^(C^#9^$/^,M^$s^#$^%I^!~^)*^!/^&4^*n^*n^)!^-I^)i^\"A^!B^2>^#z^4U^/`^&Z^++^,;^!\" ",
      "encoded_base64": "XipGXip7XiV7XiFMXihDXiM5XiQvXixNXiRzXiMkXiVJXiF+XikqXiEvXiY0XipuXipuXikhXi1JXilpXiJBXiFCXjI+XiN6XjRVXi9gXiZaXisrXiw7XiEiIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_0bf8e7f9974d",
      "text": "  我渴望得到它的力量！ ",
      "encoded_ascii": "  ^$%^,w^,]^#e^!u^+o^&Z^!~^)*^*W ",
      "encoded_base64": "ICBeJCVeLHdeLF1eI2VeIXVeK29eJlpeIX5eKSpeKlcg",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_1e458102af12",
      "text": "  是蘇隆蟲人派我來拿的。 ",
      "encoded_ascii": "  ^,X^4c^)T^(8^!<^.n^$%^!O^,G^&Z^!\" ",
      "encoded_base64": "ICBeLFheNGNeKVReKDheITxeLm5eJCVeIU9eLEdeJlpeISIg",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_a9524ae0e044",
      "text": "  我想解除這座城市的詛咒。 ",
      "encoded_ascii": "  ^$%^,1^(I^)Q^(s^/_^+_^+z^&Z^(L^\"P^!\" ",
      "encoded_base64": "ICBeJCVeLDFeKEleKVFeKHNeL19eK19eK3peJlpeKExeIlBeISIg",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_7535f6b3686e",
      "text": "  我想用它來擊敗一支邪惡的軍隊。 ",
      "encoded_ascii": "  ^$%^,1^&H^+o^!O^$F^$R^!%^$L^)\"^#y^&Z^..^)U^!\" ",
      "encoded_base64": "ICBeJCVeLDFeJkheK29eIU9eJEZeJFJeISVeJExeKSJeI3leJlpeLi5eKVVeISIg",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_f1a5b1f58c73",
      "text": "  牠們說牠們能讓這座城市復原。",
      "encoded_ascii": "  ^-#^*{^-x^-#^*{^'b^-}^(s^/_^+_^+z^#g^\"5^!\"",
      "encoded_base64": "ICBeLSNeKnteLXheLSNeKnteJ2JeLX1eKHNeL19eK19eK3peI2deIjVeISI=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_2b84393171b8",
      "text": "  牠們能化解克拉格的詛咒！ ",
      "encoded_ascii": "  ^-#^*{^'b^\")^(I^!d^$6^%*^&Z^(L^\"P^*W ",
      "encoded_base64": "ICBeLSNeKnteJ2JeIileKEleIWReJDZeJSpeJlpeKExeIlBeKlcg",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_87114dcf9cf8",
      "text": "  牠們能化解你的詛咒。 ",
      "encoded_ascii": "  ^-#^*{^'b^\")^(I^*F^&Z^(L^\"P^!\" ",
      "encoded_base64": "ICBeLSNeKnteJ2JeIileKEleKkZeJlpeKExeIlBeISIg",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_0cab7a8bb55f",
      "text": "  不，是德懷爾國王這麼告訴我的。",
      "encoded_ascii": "  ^!)^*A^,X^#j^,9^&/^+^^-)^(s^.T^+B^-t^$%^&Z^!\"",
      "encoded_base64": "ICBeISleKkFeLFheI2peLDleJi9eK15eLSleKHNeLlReK0JeLXReJCVeJlpeISI=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_c989483b4fe2",
      "text": "  沒錯，正是如此。",
      "encoded_ascii": "  ^%\\^)5^*A^%H^,X^#$^%I^!\"",
      "encoded_base64": "ICBeJVxeKTVeKkFeJUheLFheIyReJUleISI=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_a7a39a5ffbd7",
      "text": "  你怎麼會對這場詛咒瞭解得這麼清楚？ ",
      "encoded_ascii": "  ^*F^,,^.T^$r^#:^(s^\"n^(L^\"P^<p^(I^#e^(s^.T^,u^,c^.V ",
      "encoded_base64": "ICBeKkZeLCxeLlReJHJeIzpeKHNeIm5eKExeIlBePHBeKEleI2VeKHNeLlReLHVeLGNeLlYg",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_7d716ce174ae",
      "text": "  你究竟是誰？ ",
      "encoded_ascii": "  ^*F^-<^28^,X^-y^.V ",
      "encoded_base64": "ICBeKkZeLTxeMjheLFheLXleLlYg",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_e734f7347254",
      "text": "  當年究竟發生了什麼事，克拉格？ ",
      "encoded_ascii": "  ^&N^+~^-<^28^&W^&F^*D^!=^.T^*r^*A^!d^$6^%*^.V ",
      "encoded_base64": "ICBeJk5eK35eLTxeMjheJldeJkZeKkReIT1eLlReKnJeKkFeIWReJDZeJSpeLlYg",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_3c28606c6ea7",
      "text": "  我為什麼非得告訴你不可？ ",
      "encoded_ascii": "  ^$%^%{^!=^.T^)i^#e^+B^-t^*F^!)^\"A^.V ",
      "encoded_base64": "ICBeJCVeJXteIT1eLlReKWleI2VeK0JeLXReKkZeISleIkFeLlYg",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_20dc474b7fb4",
      "text": "  你何必在乎？反正你已經死了！ ",
      "encoded_ascii": "  ^*F^!L^#l^\"d^!0^.V^\"9^%H^*F^#J^'D^%L^*D^*W ",
      "encoded_base64": "ICBeKkZeIUxeI2xeImReITBeLlZeIjleJUheKkZeI0peJ0ReJUxeKkReKlcg",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_16de4fe1fbe9",
      "text": "  快把巨靈交給我！ ",
      "encoded_ascii": "  ^*L^$1^#H^)g^0P^'A^$%^*W ",
      "encoded_base64": "ICBeKkxeJDFeI0heKWdeMFBeJ0FeJCVeKlcg",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_14b7a590c3a0",
      "text": "  我才不管！把巨靈交給我！",
      "encoded_ascii": "  ^$%^$,^!)^-D^*W^$1^#H^)g^0P^'A^$%^*W",
      "encoded_base64": "ICBeJCVeJCxeISleLUReKldeJDFeI0heKWdeMFBeJ0FeJCVeKlc=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_fd20f93dd0ec",
      "text": "  夠了！把巨靈交出來！ ",
      "encoded_ascii": "  ^+d^*D^*W^$1^#H^)g^0P^!q^!O^*W ",
      "encoded_base64": "ICBeK2ReKkReKldeJDFeI0heKWdeMFBeIXFeIU9eKlcg",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_737790c4630b",
      "text": "這太浪費時間了。告辭。 ",
      "encoded_ascii": "^(s^+f^,r^.\"^$f^)G^*D^!\"^+B^2M^!\" ",
      "encoded_base64": "XihzXitmXixyXi4iXiRmXilHXipEXiEiXitCXjJNXiEiIA==",
      "byte_length": 34
    },
    {
      "unit_id": "DLG_5296cb62c51f",
      "text": "我沒義務回答你。告辭。 ",
      "encoded_ascii": "^$%^%\\^2<^+4^\"\\^-B^*F^!\"^+B^2M^!\" ",
      "encoded_base64": "XiQlXiVcXjI8Xis0XiJcXi1CXipGXiEiXitCXjJNXiEiIA==",
      "byte_length": 34
    },
    {
      "unit_id": "DLG_03834e47c36f",
      "text": "我聽煩了。告辭。 ",
      "encoded_ascii": "^$%^-X^-!^*D^!\"^+B^2M^!\" ",
      "encoded_base64": "XiQlXi1YXi0hXipEXiEiXitCXjJNXiEiIA==",
      "byte_length": 25
    },
    {
      "unit_id": "DLG_419003f1b1e4",
      "text": "因為我是巨靈的守望者，我絕不會將它交給任何會拿它 ",
      "encoded_ascii": "^\"]^%{^$%^,X^#H^)g^&Z^#+^,]^'V^*A^$%^-I^!)^$r^#7^+o^0P^'A^!C^!L^$r^,G^+o ",
      "encoded_base64": "XiJdXiV7XiQlXixYXiNIXilnXiZaXiMrXixdXidWXipBXiQlXi1JXiEpXiRyXiM3XitvXjBQXidBXiFDXiFMXiRyXixHXitvIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_8ad68c5e57ff",
      "text": "去為非作歹的人。 ",
      "encoded_ascii": "^\"6^%{^)i^!M^?*^&Z^!<^!\" ",
      "encoded_base64": "XiI2XiV7XilpXiFNXj8qXiZaXiE8XiEiIA==",
      "byte_length": 25
    },
    {
      "unit_id": "DLG_971faf0223d6",
      "text": "你渴望力量？你的意圖實在難以令人信服。任何貪戀權力者 ",
      "encoded_ascii": "^*F^,w^,]^!~^)*^.V^*F^&Z^#z^\"b^#3^\"d^)a^!B^*w^!<^!U^,\\^!\"^!C^!L^1^^?)^1E^!~^'V ",
      "encoded_base64": "XipGXix3XixdXiF+XikqXi5WXipGXiZaXiN6XiJiXiMzXiJkXilhXiFCXip3XiE8XiFVXixcXiEiXiFDXiFMXjFeXj8pXjFFXiF+XidWIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_7bf79d6d7055",
      "text": "都不會有好下場。我不想再聽你的貪婪之言——立刻離開 ",
      "encoded_ascii": "^)$^!)^$r^$s^+i^!(^\"n^!\"^$%^!)^,1^!l^-X^*F^&Z^1^^1-^!/^1Y^*n^*n^0'^.Y^)`^)F ",
      "encoded_base64": "XikkXiEpXiRyXiRzXitpXiEoXiJuXiEiXiQlXiEpXiwxXiFsXi1YXipGXiZaXjFeXjEtXiEvXjFZXipuXipuXjAnXi5ZXilgXilGIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_63d8f4b41281",
      "text": "此地。 ",
      "encoded_ascii": "^%I^\"e^!\" ",
      "encoded_base64": "XiVJXiJlXiEiIA==",
      "byte_length": 10
    },
    {
      "unit_id": "DLG_472244abadf5",
      "text": "因為我是巨靈的保管者，它的力量絕不能再次遭到濫用。 ",
      "encoded_ascii": "^\"]^%{^$%^,X^#H^)g^&Z^!T^-D^'V^*A^+o^&Z^!~^)*^-I^!)^'b^!l^%D^(}^!u^5a^&H^!\" ",
      "encoded_base64": "XiJdXiV7XiQlXixYXiNIXilnXiZaXiFUXi1EXidWXipBXitvXiZaXiF+XikqXi1JXiEpXidiXiFsXiVEXih9XiF1XjVhXiZIXiEiIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_da2348cfb3b4",
      "text": "我是生是死與此毫無干係。現在，說說你究竟為何要得到它？ ",
      "encoded_ascii": "^$%^,X^&F^,X^%L^'p^%I^/t^%}^#R^38^!\"^&?^\"d^*A^-x^-x^*F^-<^28^%{^!L^(C^#e^!u^+o^.V ",
      "encoded_base64": "XiQlXixYXiZGXixYXiVMXidwXiVJXi90XiV9XiNSXjM4XiEiXiY/XiJkXipBXi14Xi14XipGXi08XjI4XiV7XiFMXihDXiNlXiF1XitvXi5WIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_e089c07f2f59",
      "text": "而你們竟然相信了牠們……我很難想像任何有智慧的生靈，竟然會看不出 ",
      "encoded_ascii": "^'W^*F^*{^28^&\"^&a^!U^*D^-#^*{^*o^*o^$%^*K^)a^,1^!`^!C^!L^$s^$i^4;^&Z^&F^)g^*A^28^&\"^$r^*Q^!)^!q ",
      "encoded_base64": "XidXXipGXip7XjI4XiYiXiZhXiFVXipEXi0jXip7XipvXipvXiQlXipLXilhXiwxXiFgXiFDXiFMXiRzXiRpXjQ7XiZaXiZGXilnXipBXjI4XiYiXiRyXipRXiEpXiFxIA==",
      "byte_length": 97
    },
    {
      "unit_id": "DLG_8dc0cd8c771d",
      "text": "蘇隆蟲人渾身上下除了謊言與邪惡外別無他物。 ",
      "encoded_ascii": "^4c^)T^(8^!<^2+^(c^!'^!(^)Q^*D^3*^1Y^'p^)\"^#y^\"w^*H^%}^!@^&4^!\" ",
      "encoded_base64": "XjRjXilUXig4XiE8XjIrXihjXiEnXiEoXilRXipEXjMqXjFZXidwXikiXiN5XiJ3XipIXiV9XiFAXiY0XiEiIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_8e7a8ab2e240",
      "text": "蘇隆蟲人居然真的那麼說？",
      "encoded_ascii": "^4c^)T^(8^!<^+w^&\"^-2^&Z^)!^.T^-x^.V",
      "encoded_base64": "XjRjXilUXig4XiE8Xit3XiYiXi0yXiZaXikhXi5UXi14Xi5W",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_3160b341c625",
      "text": "德懷爾國王根本不知道蘇隆蟲人的險惡用心。他一心只顧慮著 ",
      "encoded_ascii": "^#j^,9^&/^+^^-)^%)^$x^!)^&h^(y^4c^)T^(8^!<^&Z^*m^#y^&H^#k^!\"^!@^!%^#k^\"?^4n^19^-a ",
      "encoded_base64": "XiNqXiw5XiYvXiteXi0pXiUpXiR4XiEpXiZoXih5XjRjXilUXig4XiE8XiZaXiptXiN5XiZIXiNrXiEiXiFAXiElXiNrXiI/XjRuXjE5Xi1hIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_bc522c37c0d0",
      "text": "這座城市的衰亡，以至於把蘇隆蟲人當成了救星恩賜。 ",
      "encoded_ascii": "^(s^/_^+_^+z^&Z^2D^!:^*A^!B^'n^$^^$1^4c^)T^(8^!<^&N^$$^*D^,Q^$e^#v^.#^!\" ",
      "encoded_base64": "XihzXi9fXitfXit6XiZaXjJEXiE6XipBXiFCXiduXiReXiQxXjRjXilUXig4XiE8XiZOXiQkXipEXixRXiRlXiN2Xi4jXiEiIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_77670e4102ae",
      "text": "讓我告訴你們一些關於蘇隆蟲人的真相吧： ",
      "encoded_ascii": "^-}^$%^+B^-t^*F^*{^!%^!8^.>^$^^4c^)T^(8^!<^&Z^-2^&a^*I^*B ",
      "encoded_base64": "Xi19XiQlXitCXi10XipGXip7XiElXiE4Xi4+XiReXjRjXilUXig4XiE8XiZaXi0yXiZhXipJXipCIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_d9a388e31ec4",
      "text": "一場「詛咒」？沒錯，這確實算是一種詛咒——但我向你們保證，那純屬無心之過。 ",
      "encoded_ascii": "^!%^\"n^!#^(L^\"P^!$^.V^%\\^)5^*A^(s^-6^#3^-C^,X^!%^'$^(L^\"P^*n^*n^!I^$%^+?^*F^*{^!T^-{^*A^)!^3\"^#C^%}^#k^!/^(x^!\" ",
      "encoded_base64": "XiElXiJuXiEjXihMXiJQXiEkXi5WXiVcXik1XipBXihzXi02XiMzXi1DXixYXiElXickXihMXiJQXipuXipuXiFJXiQlXis/XipGXip7XiFUXi17XipBXikhXjMiXiNDXiV9XiNrXiEvXih4XiEiIA==",
      "byte_length": 112
    },
    {
      "unit_id": "DLG_35e07a943333",
      "text": "如此咄咄逼人——你們微薄的耐心根本掩蓋不住內心的貪念。我什麼都不會給你們。 ",
      "encoded_ascii": "^#$^%I^?'^?'^.1^!<^*n^*n^*F^*{^#i^6o^&Z^-S^#k^%)^$x^9~^-d^!)^*z^!g^#k^&Z^1^^1z^!\"^$%^!=^.T^)$^!)^$r^'A^*F^*{^!\" ",
      "encoded_base64": "XiMkXiVJXj8nXj8nXi4xXiE8XipuXipuXipGXip7XiNpXjZvXiZaXi1TXiNrXiUpXiR4Xjl+Xi1kXiEpXip6XiFnXiNrXiZaXjFeXjF6XiEiXiQlXiE9Xi5UXikkXiEpXiRyXidBXipGXip7XiEiIA==",
      "byte_length": 112
    },
    {
      "unit_id": "DLG_dfda81bbf4af",
      "text": "立刻離開此地。 ",
      "encoded_ascii": "^0'^.Y^)`^)F^%I^\"e^!\" ",
      "encoded_base64": "XjAnXi5ZXilgXilGXiVJXiJlXiEiIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_7c0fa24152f5",
      "text": "我會把所知的一切全盤托出。屆時你們大可自行評斷。問吧， ",
      "encoded_ascii": "^$%^$r^$1^$)^&h^&Z^!%^+.^!h^1M^/-^!q^!\"^2e^$f^*F^*{^\"z^\"A^'l^(;^6)^,T^!\"^*Z^*I^*A ",
      "encoded_base64": "XiQlXiRyXiQxXiQpXiZoXiZaXiElXisuXiFoXjFNXi8tXiFxXiEiXjJlXiRmXipGXip7XiJ6XiJBXidsXig7XjYpXixUXiEiXipaXipJXipBIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_0a2a2d106475",
      "text": "想問什麼儘管問。 ",
      "encoded_ascii": "^,1^*Z^!=^.T^+(^-D^*Z^!\" ",
      "encoded_base64": "XiwxXipaXiE9Xi5UXisoXi1EXipaXiEiIA==",
      "byte_length": 25
    },
    {
      "unit_id": "DLG_3e4d8d50bc06",
      "text": "我之所以知之甚詳，是因為當初許下那個願望的人就是我。 ",
      "encoded_ascii": "^$%^!/^$)^!B^&h^!/^/|^6v^*A^,X^\"]^%{^&N^1\"^-s^!(^)!^!V^.H^,]^&Z^!<^*J^,X^$%^!\" ",
      "encoded_base64": "XiQlXiEvXiQpXiFCXiZoXiEvXi98XjZ2XipBXixYXiJdXiV7XiZOXjEiXi1zXiEoXikhXiFWXi5IXixdXiZaXiE8XipKXixYXiQlXiEiIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_28e4cf6fff7d",
      "text": "擊敗邪惡軍隊確實是動用巨靈的正當義舉，它本該屬於你們。 ",
      "encoded_ascii": "^$F^$R^)\"^#y^..^)U^-6^#3^,X^\"%^&H^#H^)g^&Z^%H^&N^2<^01^*A^+o^$x^(M^#C^$^^*F^*{^!\" ",
      "encoded_base64": "XiRGXiRSXikiXiN5Xi4uXilVXi02XiMzXixYXiIlXiZIXiNIXilnXiZaXiVIXiZOXjI8XjAxXipBXitvXiR4XihNXiNDXiReXipGXip7XiEiIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_03a170475ec5",
      "text": "然而，在把它交給你們之前，你們必須先完成一件善行。蘇隆蟲人藏匿了 ",
      "encoded_ascii": "^&\"^'W^*A^\"d^$1^+o^0P^'A^*F^*{^!/^!z^*A^*F^*{^#l^)r^!b^#,^$$^!%^.W^1(^(;^!\"^4c^)T^(8^!<^-f^7%^*D ",
      "encoded_base64": "XiYiXidXXipBXiJkXiQxXitvXjBQXidBXipGXip7XiEvXiF6XipBXipGXip7XiNsXilyXiFiXiMsXiQkXiElXi5XXjEoXig7XiEiXjRjXilUXig4XiE8Xi1mXjclXipEIA==",
      "byte_length": 97
    },
    {
      "unit_id": "DLG_3f2440a95410",
      "text": "我的肉身。去找到它並將它安葬在陵墓之中。作為回報，我會把 ",
      "encoded_ascii": "^$%^&Z^'^^(c^!\"^\"6^$/^!u^+o^!+^#7^+o^+p^-b^\"d^7!^6P^!/^!,^!\"^!M^%{^\"\\^+`^*A^$%^$r^$1 ",
      "encoded_base64": "XiQlXiZaXideXihjXiEiXiI2XiQvXiF1XitvXiErXiM3XitvXitwXi1iXiJkXjchXjZQXiEvXiEsXiEiXiFNXiV7XiJcXitgXipBXiQlXiRyXiQxIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_3269308a3c0f",
      "text": "巨靈交給你們。",
      "encoded_ascii": "^#H^)g^0P^'A^*F^*{^!\"",
      "encoded_base64": "XiNIXilnXjBQXidBXipGXip7XiEi",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_2f0dc9ba9fe8",
      "text": "蘇隆蟲人擁有極高的智性，但洛德卻忘了提起蘇隆蟲人的 ",
      "encoded_ascii": "^4c^)T^(8^!<^,M^$s^1D^*+^&Z^$i^#r^*A^!I^%g^#j^1&^0]^*D^$A^.(^4c^)T^(8^!<^&Z ",
      "encoded_base64": "XjRjXilUXig4XiE8XixNXiRzXjFEXiorXiZaXiRpXiNyXipBXiFJXiVnXiNqXjEmXjBdXipEXiRBXi4oXjRjXilUXig4XiE8XiZaIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_351b66fc36a6",
      "text": "狡詐陰險。我無意間偷聽到了兩隻蘇隆蟲人的對話，正是那段話 ",
      "encoded_ascii": "^::^6(^6B^*m^!\"^$%^%}^#z^)G^/O^-X^!u^*D^!i^)[^4c^)T^(8^!<^&Z^#:^-v^*A^%H^,X^)!^.l^-v ",
      "encoded_base64": "Xjo6XjYoXjZCXiptXiEiXiQlXiV9XiN6XilHXi9PXi1YXiF1XipEXiFpXilbXjRjXilUXig4XiE8XiZaXiM6Xi12XipBXiVIXixYXikhXi5sXi12IA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_86639c779413",
      "text": "讓我看清了牠們真正的圖謀。 ",
      "encoded_ascii": "^-}^$%^*Q^,u^*D^-#^*{^-2^%H^&Z^\"b^3~^!\" ",
      "encoded_base64": "Xi19XiQlXipRXix1XipEXi0jXip7Xi0yXiVIXiZaXiJiXjN+XiEiIA==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_857c2d90e82e",
      "text": "  說不定真正狡詐的人是你。",
      "encoded_ascii": "  ^-x^!)^#.^-2^%H^::^6(^&Z^!<^,X^*F^!\"",
      "encoded_base64": "ICBeLXheISleIy5eLTJeJUheOjpeNiheJlpeITxeLFheKkZeISI=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_73d9b5bab353",
      "text": "  你偷聽到了什麼？",
      "encoded_ascii": "  ^*F^/O^-X^!u^*D^!=^.T^.V",
      "encoded_base64": "ICBeKkZeL09eLVheIXVeKkReIT1eLlReLlY=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_e0c193e5a938",
      "text": "先聽聽我怎麼說，然後你們再作定奪。 ",
      "encoded_ascii": "^!b^-X^-X^$%^,,^.T^-x^*A^&\"^#b^*F^*{^!l^!M^#.^1,^!\" ",
      "encoded_base64": "XiFiXi1YXi1YXiQlXiwsXi5UXi14XipBXiYiXiNiXipGXip7XiFsXiFNXiMuXjEsXiEiIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_3d2e4f73da2d",
      "text": "在會面之前，我偷聽到牠們兩個在竊竊私語。顯然，牠們一直 ",
      "encoded_ascii": "^\"d^$r^)j^!/^!z^*A^$%^/O^-X^!u^-#^*{^!i^!V^\"d^5n^5n^&~^0:^!\"^4&^&\"^*A^-#^*{^!%^&` ",
      "encoded_base64": "XiJkXiRyXilqXiEvXiF6XipBXiQlXi9PXi1YXiF1Xi0jXip7XiFpXiFWXiJkXjVuXjVuXiZ+XjA6XiEiXjQmXiYiXipBXi0jXip7XiElXiZgIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_ac19ba56de34",
      "text": "千方百計想重返這個位面……而只要有了巨靈，牠們就能 ",
      "encoded_ascii": "^+7^$]^&Y^-n^,1^))^7J^(s^!V^!J^)j^*o^*o^'W^\"?^(C^$s^*D^#H^)g^*A^-#^*{^*J^'b ",
      "encoded_base64": "Xis3XiRdXiZZXi1uXiwxXikpXjdKXihzXiFWXiFKXilqXipvXipvXidXXiI/XihDXiRzXipEXiNIXilnXipBXi0jXip7XipKXidiIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_ae92d0c628b3",
      "text": "如願以償！ ",
      "encoded_ascii": "^#$^.H^!B^5-^*W ",
      "encoded_base64": "XiMkXi5IXiFCXjUtXipXIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_a50201cb0ff8",
      "text": "如果牠們闖入一個對牠們一無所知的亞薩斯世界……我連想都不敢 ",
      "encoded_ascii": "^#$^%!^-#^*{^.z^!f^!%^!V^#:^-#^*{^!%^%}^$)^&h^&Z^!9^-e^$[^*p^.p^*o^*o^$%^.0^,1^)$^!)^/m ",
      "encoded_base64": "XiMkXiUhXi0jXip7Xi56XiFmXiElXiFWXiM6Xi0jXip7XiElXiV9XiQpXiZoXiZaXiE5Xi1lXiRbXipwXi5wXipvXipvXiQlXi4wXiwxXikkXiEpXi9tIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_a9c6db3d1165",
      "text": "去想那種後果。 ",
      "encoded_ascii": "^\"6^,1^)!^'$^#b^%!^!\" ",
      "encoded_base64": "XiI2XiwxXikhXickXiNiXiUhXiEiIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_c79ec321c1af",
      "text": "解救宮殿？你們打算怎麼辦到？",
      "encoded_ascii": "^(I^,Q^/\\^.m^.V^*F^*{^$-^-C^,,^.T^2L^!u^.V",
      "encoded_base64": "XihJXixRXi9cXi5tXi5WXipGXip7XiQtXi1DXiwsXi5UXjJMXiF1Xi5W",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_5281272fc294",
      "text": "  有了巨靈，蘇隆蟲人就能辦到。",
      "encoded_ascii": "  ^$s^*D^#H^)g^*A^4c^)T^(8^!<^*J^'b^2L^!u^!\"",
      "encoded_base64": "ICBeJHNeKkReI0heKWdeKkFeNGNeKVReKDheITxeKkpeJ2JeMkxeIXVeISI=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_72d5b25206cc",
      "text": "  我會自己動用它。",
      "encoded_ascii": "  ^$%^$r^'l^#I^\"%^&H^+o^!\"",
      "encoded_base64": "ICBeJCVeJHJeJ2xeI0leIiVeJkheK29eISI=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_04ecb654fd95",
      "text": "  我為什麼要告訴你？",
      "encoded_ascii": "  ^$%^%{^!=^.T^(C^+B^-t^*F^.V",
      "encoded_base64": "ICBeJCVeJXteIT1eLlReKENeK0JeLXReKkZeLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_8154e107f7d2",
      "text": "你們竟敢把巨靈交給蘇隆蟲人？我寧願永墮無間地獄，也 ",
      "encoded_ascii": "^*F^*{^28^/m^$1^#H^)g^0P^'A^4c^)T^(8^!<^.V^$%^3k^.H^%W^=m^%}^)G^\"e^3Q^*A^!1 ",
      "encoded_base64": "XipGXip7XjI4Xi9tXiQxXiNIXilnXjBQXidBXjRjXilUXig4XiE8Xi5WXiQlXjNrXi5IXiVXXj1tXiV9XilHXiJlXjNRXipBXiExIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_b2260421f781",
      "text": "絕不會讓巨靈落入你們手中！",
      "encoded_ascii": "^-I^!)^$r^-}^#H^)g^-`^!f^*F^*{^$+^!,^*W",
      "encoded_base64": "Xi1JXiEpXiRyXi19XiNIXilnXi1gXiFmXipGXip7XiQrXiEsXipX",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_e1a81431369e",
      "text": "只要你們沒打算把它交給蘇隆蟲人，你們的意圖 ",
      "encoded_ascii": "^\"?^(C^*F^*{^%\\^$-^-C^$1^+o^0P^'A^4c^)T^(8^!<^*A^*F^*{^&Z^#z^\"b ",
      "encoded_base64": "XiI/XihDXipGXip7XiVcXiQtXi1DXiQxXitvXjBQXidBXjRjXilUXig4XiE8XipBXipGXip7XiZaXiN6XiJiIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_3a4f0f860574",
      "text": "應當是善良的。如果你們能找到我的遺體並安置於 ",
      "encoded_ascii": "^0`^&N^,X^1(^1V^&Z^!\"^#$^%!^*F^*{^'b^$/^!u^$%^&Z^0v^**^!+^+p^'Q^$^ ",
      "encoded_base64": "XjBgXiZOXixYXjEoXjFWXiZaXiEiXiMkXiUhXipGXip7XidiXiQvXiF1XiQlXiZaXjB2XioqXiErXitwXidRXiReIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_6ddf6676c7f6",
      "text": "陵墓中的石棺內，我就會把巨靈 ",
      "encoded_ascii": "^7!^6P^!,^&Z^&k^%2^!g^*A^$%^*J^$r^$1^#H^)g ",
      "encoded_base64": "XjchXjZQXiEsXiZaXiZrXiUyXiFnXipBXiQlXipKXiRyXiQxXiNIXilnIA==",
      "byte_length": 43
    },
    {
      "unit_id": "DLG_1ffcf9aa08cb",
      "text": "交給你們。",
      "encoded_ascii": "^0P^'A^*F^*{^!\"",
      "encoded_base64": "XjBQXidBXipGXip7XiEi",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_065c74871af3",
      "text": "很好。顯然你們索求巨靈絕非出於善意。請便吧，恕不奉陪。 ",
      "encoded_ascii": "^*K^+i^!\"^4&^&\"^*F^*{^'>^,n^#H^)g^-I^)i^!q^$^^1(^#z^!\"^*S^!R^*I^*A^3q^!)^1+^8.^!\" ",
      "encoded_base64": "XipLXitpXiEiXjQmXiYiXipGXip7Xic+XixuXiNIXilnXi1JXilpXiFxXiReXjEoXiN6XiEiXipTXiFSXipJXipBXjNxXiEpXjErXjguXiEiIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_845db2f3cdab",
      "text": "我是克拉格。你們找我所為何事？ ",
      "encoded_ascii": "^$%^,X^!d^$6^%*^!\"^*F^*{^$/^$%^$)^%{^!L^*r^.V ",
      "encoded_base64": "XiQlXixYXiFkXiQ2XiUqXiEiXipGXip7XiQvXiQlXiQpXiV7XiFMXipyXi5WIA==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_0857db7c5541",
      "text": "  我想向你打聽當年發生的事。 ",
      "encoded_ascii": "  ^$%^,1^+?^*F^$-^-X^&N^+~^&W^&F^&Z^*r^!\" ",
      "encoded_base64": "ICBeJCVeLDFeKz9eKkZeJC1eLVheJk5eK35eJldeJkZeJlpeKnJeISIg",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_e248318a6c32",
      "text": "  我是為了巨靈而來的。 ",
      "encoded_ascii": "  ^$%^,X^%{^*D^#H^)g^'W^!O^&Z^!\" ",
      "encoded_base64": "ICBeJCVeLFheJXteKkReI0heKWdeJ1deIU9eJlpeISIg",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_deae64f3a057",
      "text": "  我是來消滅你的。",
      "encoded_ascii": "  ^$%^,X^!O^%k^%t^*F^&Z^!\"",
      "encoded_base64": "ICBeJCVeLFheIU9eJWteJXReKkZeJlpeISI=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_44788b4a0474",
      "text": "好吧。我會把所知的一切告訴你們。你們想問什麼？ ",
      "encoded_ascii": "^+i^*I^!\"^$%^$r^$1^$)^&h^&Z^!%^+.^+B^-t^*F^*{^!\"^*F^*{^,1^*Z^!=^.T^.V ",
      "encoded_base64": "XitpXipJXiEiXiQlXiRyXiQxXiQpXiZoXiZaXiElXisuXitCXi10XipGXip7XiEiXipGXip7XiwxXipaXiE9Xi5UXi5WIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_4f3df9c4ee3d",
      "text": "  你為何許願將這座城市深埋地下？",
      "encoded_ascii": "  ^*F^%{^!L^-s^.H^#7^(s^/_^+_^+z^2*^1r^\"e^!(^.V",
      "encoded_base64": "ICBeKkZeJXteIUxeLXNeLkheIzdeKHNeL19eK19eK3peMipeMXJeImVeISheLlY=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_8898d1baf99d",
      "text": "  國王為何要召喚蘇隆蟲人？",
      "encoded_ascii": "  ^+^^-)^%{^!L^(C^\"@^\"U^4c^)T^(8^!<^.V",
      "encoded_base64": "ICBeK15eLSleJXteIUxeKENeIkBeIlVeNGNeKVReKDheITxeLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_b34faa87f8c3",
      "text": "  牠們被召喚出來時發生了什麼事？",
      "encoded_ascii": "  ^-#^*{^(@^\"@^\"U^!q^!O^$f^&W^&F^*D^!=^.T^*r^.V",
      "encoded_base64": "ICBeLSNeKnteKEBeIkBeIlVeIXFeIU9eJGZeJldeJkZeKkReIT1eLlReKnJeLlY=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_f3ea9e4989c6",
      "text": "  牠們為何想要得到巨靈？",
      "encoded_ascii": "  ^-#^*{^%{^!L^,1^(C^#e^!u^#H^)g^.V",
      "encoded_base64": "ICBeLSNeKnteJXteIUxeLDFeKENeI2VeIXVeI0heKWdeLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_55e8ee71d6e6",
      "text": "  你為何要反對國王？",
      "encoded_ascii": "  ^*F^%{^!L^(C^\"9^#:^+^^-)^.V",
      "encoded_base64": "ICBeKkZeJXteIUxeKENeIjleIzpeK15eLSleLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_9696c7b49850",
      "text": "  你為何會被判處死刑？",
      "encoded_ascii": "  ^*F^%{^!L^$r^(@^1k^(,^%L^9|^.V",
      "encoded_base64": "ICBeKkZeJXteIUxeJHJeKEBeMWteKCxeJUxeOXxeLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_8e1599fc4a4c",
      "text": "  你是如何逃過斬首之刑的？",
      "encoded_ascii": "  ^*F^,X^#$^!L^(p^(x^9B^)~^!/^9|^&Z^.V",
      "encoded_base64": "ICBeKkZeLFheIyReIUxeKHBeKHheOUJeKX5eIS9eOXxeJlpeLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_5399bf24cecc",
      "text": "  你為何殺了國王？",
      "encoded_ascii": "  ^*F^%{^!L^%M^*D^+^^-)^.V",
      "encoded_base64": "ICBeKkZeJXteIUxeJU1eKkReK15eLSleLlY=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_88676efa05b6",
      "text": "  你為何想要得到巨靈？",
      "encoded_ascii": "  ^*F^%{^!L^,1^(C^#e^!u^#H^)g^.V",
      "encoded_base64": "ICBeKkZeJXteIUxeLDFeKENeI2VeIXVeI0heKWdeLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_a65f2409e063",
      "text": "我長久以來一直在深思巨靈所做的一切。我當時明確的命令是「封印城中的 ",
      "encoded_ascii": "^$%^)C^!.^!B^!O^!%^&`^\"d^2*^#q^#H^)g^$)^*~^&Z^!%^+.^!\"^$%^&N^$f^$c^-6^&Z^\"N^*w^,X^!#^#5^1%^+_^!,^&Z ",
      "encoded_base64": "XiQlXilDXiEuXiFCXiFPXiElXiZgXiJkXjIqXiNxXiNIXilnXiQpXip+XiZaXiElXisuXiEiXiQlXiZOXiRmXiRjXi02XiZaXiJOXip3XixYXiEjXiM1XjElXitfXiEsXiZaIA==",
      "byte_length": 100
    },
    {
      "unit_id": "DLG_b85137a3b160",
      "text": "所有邪惡」。從結果來看，這意味著城裡的每一個人 ",
      "encoded_ascii": "^$)^$s^)\"^#y^!$^!\"^#f^'@^%!^!O^*Q^*A^(s^#z^1n^-a^+_^-j^&Z^%P^!%^!V^!< ",
      "encoded_base64": "XiQpXiRzXikiXiN5XiEkXiEiXiNmXidAXiUhXiFPXipRXipBXihzXiN6XjFuXi1hXitfXi1qXiZaXiVQXiElXiFWXiE8IA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_9b08d9095d69",
      "text": "無一不帶有絲毫邪念。因此，為了封印所有的邪惡，這座城市 ",
      "encoded_ascii": "^%}^!%^!)^#N^$s^'C^/t^)\"^1z^!\"^\"]^%I^*A^%{^*D^#5^1%^$)^$s^&Z^)\"^#y^*A^(s^/_^+_^+z ",
      "encoded_base64": "XiV9XiElXiEpXiNOXiRzXidDXi90XikiXjF6XiEiXiJdXiVJXipBXiV7XipEXiM1XjElXiQpXiRzXiZaXikiXiN5XipBXihzXi9fXitfXit6IA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_1a94cdd70b0f",
      "text": "才被徹底掩埋。 ",
      "encoded_ascii": "^$,^(@^18^/^^9~^1r^!\" ",
      "encoded_base64": "XiQsXihAXjE4Xi9eXjl+XjFyXiEiIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_e201677fb1fe",
      "text": "這座城市日益衰落落後於其他邦國，於是德懷爾向宮廷法師洛德求助， ",
      "encoded_ascii": "^(s^/_^+_^+z^$a^3R^2D^-`^-`^#b^$^^!j^!@^1a^+^^*A^$^^,X^#j^,9^&/^+?^/\\^:D^%b^#M^%g^#j^,n^\"#^*A ",
      "encoded_base64": "XihzXi9fXitfXit6XiRhXjNSXjJEXi1gXi1gXiNiXiReXiFqXiFAXjFhXiteXipBXiReXixYXiNqXiw5XiYvXis/Xi9cXjpEXiViXiNNXiVnXiNqXixuXiIjXipBIA==",
      "byte_length": 94
    },
    {
      "unit_id": "DLG_9f31c7bd4fd7",
      "text": "希望找到解方。洛德知曉蘇隆蟲人的存在，那是被困在星界位面中、極度聰慧卻邪惡 ",
      "encoded_ascii": "^+{^,]^$/^!u^(I^$]^!\"^%g^#j^&h^7y^4c^)T^(8^!<^&Z^#*^\"d^*A^)!^,X^(@^\"^^\"d^$e^.p^!J^)j^!,^!!^1D^#V^2=^4;^1&^)\"^#y ",
      "encoded_base64": "Xit7XixdXiQvXiF1XihJXiRdXiEiXiVnXiNqXiZoXjd5XjRjXilUXig4XiE8XiZaXiMqXiJkXipBXikhXixYXihAXiJeXiJkXiRlXi5wXiFKXilqXiEsXiEhXjFEXiNWXjI9XjQ7XjEmXikiXiN5IA==",
      "byte_length": 112
    },
    {
      "unit_id": "DLG_6e6bd629b90c",
      "text": "無比的生靈。召喚牠們是為了獲取其淵博的知識。 ",
      "encoded_ascii": "^%}^,m^&Z^&F^)g^!\"^\"@^\"U^-#^*{^,X^%{^*D^&:^\":^!j^<m^/$^&Z^&h^(R^!\" ",
      "encoded_base64": "XiV9XixtXiZaXiZGXilnXiEiXiJAXiJVXi0jXip7XixYXiV7XipEXiY6XiI6XiFqXjxtXi8kXiZaXiZoXihSXiEiIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_458c5b177814",
      "text": "狂妄自大的洛德放鬆了戒備，結果被蘇隆蟲人所殺。牠們 ",
      "encoded_ascii": "^&8^+j^'l^\"z^&Z^%g^#j^$P^.R^*D^$&^+\"^*A^'@^%!^(@^4c^)T^(8^!<^$)^%M^!\"^-#^*{ ",
      "encoded_base64": "XiY4XitqXidsXiJ6XiZaXiVnXiNqXiRQXi5SXipEXiQmXisiXipBXidAXiUhXihAXjRjXilUXig4XiE8XiQpXiVNXiEiXi0jXip7IA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_2b3b3c9d145b",
      "text": "虛偽地表達了歉意，但洛德一死，就再也無人能將牠們遣返。當牠們得知 ",
      "encoded_ascii": "^-g^6J^\"e^-i^(z^*D^,h^#z^*A^!I^%g^#j^!%^%L^*A^*J^!l^!1^%}^!<^'b^#7^-#^*{^4k^7J^!\"^&N^-#^*{^#e^&h ",
      "encoded_base64": "Xi1nXjZKXiJlXi1pXih6XipEXixoXiN6XipBXiFJXiVnXiNqXiElXiVMXipBXipKXiFsXiExXiV9XiE8XidiXiM3Xi0jXip7XjRrXjdKXiEiXiZOXi0jXip7XiNlXiZoIA==",
      "byte_length": 97
    },
    {
      "unit_id": "DLG_e8ddc83e0eb3",
      "text": "巨靈的存在後，便告訴德懷爾那是交換其知識的報酬代價。 ",
      "encoded_ascii": "^#H^)g^&Z^#*^\"d^#b^*A^!R^+B^-t^#j^,9^&/^)!^,X^0P^4@^!j^&h^(R^&Z^+`^7o^*v^+&^!\" ",
      "encoded_base64": "XiNIXilnXiZaXiMqXiJkXiNiXipBXiFSXitCXi10XiNqXiw5XiYvXikhXixYXjBQXjRAXiFqXiZoXihSXiZaXitgXjdvXip2XismXiEiIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_209e1e893c36",
      "text": "巨靈對蘇隆蟲人而言既是威脅也是恩賜。洛德死後， ",
      "encoded_ascii": "^#H^)g^#:^4c^)T^(8^!<^'W^1Y^,U^,X^#&^1T^!1^,X^#v^.#^!\"^%g^#j^%L^#b^*A ",
      "encoded_base64": "XiNIXilnXiM6XjRjXilUXig4XiE8XidXXjFZXixVXixYXiMmXjFUXiExXixYXiN2Xi4jXiEiXiVnXiNqXiVMXiNiXipBIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_ab39cc6131db",
      "text": "巨靈是唯一能將牠們遣返星界之物。然而， ",
      "encoded_ascii": "^#H^)g^,X^+O^!%^'b^#7^-#^*{^4k^7J^$e^.p^!/^&4^!\"^&\"^'W^*A ",
      "encoded_base64": "XiNIXilnXixYXitPXiElXidiXiM3Xi0jXip7XjRrXjdKXiRlXi5wXiEvXiY0XiEiXiYiXidXXipBIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_c3ff1993d8e1",
      "text": "巨靈同時也能將其餘所有蘇隆蟲人從星界徹底釋放出來。 ",
      "encoded_ascii": "^#H^)g^\"E^$f^!1^'b^#7^!j^1e^$)^$s^4c^)T^(8^!<^#f^$e^.p^18^/^^0w^$P^!q^!O^!\" ",
      "encoded_base64": "XiNIXilnXiJFXiRmXiExXidiXiM3XiFqXjFlXiQpXiRzXjRjXilUXig4XiE8XiNmXiRlXi5wXjE4Xi9eXjB3XiRQXiFxXiFPXiEiIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_93fb0f618881",
      "text": "當德懷爾提議將巨靈交給蘇隆蟲人時，我就明白將會引發 ",
      "encoded_ascii": "^&N^#j^,9^&/^$A^-|^#7^#H^)g^0P^'A^4c^)T^(8^!<^$f^*A^$%^*J^$c^&X^#7^$r^#Z^&W ",
      "encoded_base64": "XiZOXiNqXiw5XiYvXiRBXi18XiM3XiNIXilnXjBQXidBXjRjXilUXig4XiE8XiRmXipBXiQlXipKXiRjXiZYXiM3XiRyXiNaXiZXIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_6373945440c0",
      "text": "何等浩劫。我在御前會議上與他激烈爭辯。他充耳不聞，我便出手痛擊了他。 ",
      "encoded_ascii": "^!L^'-^5^^1l^!\"^$%^\"d^3n^!z^$r^-|^!'^'p^!@^1H^%|^1I^?-^!\"^!@^5.^'Y^!)^4^^*A^$%^!R^!q^$+^-.^$F^*D^!@^!\" ",
      "encoded_base64": "XiFMXictXjVeXjFsXiEiXiQlXiJkXjNuXiF6XiRyXi18XiEnXidwXiFAXjFIXiV8XjFJXj8tXiEiXiFAXjUuXidZXiEpXjReXipBXiQlXiFSXiFxXiQrXi0uXiRGXipEXiFAXiEiIA==",
      "byte_length": 103
    },
    {
      "unit_id": "DLG_51fd71b284ad",
      "text": "隨後我被判處斬首死刑。 ",
      "encoded_ascii": "^)X^#b^$%^(@^1k^(,^9B^)~^%L^9|^!\" ",
      "encoded_base64": "XilYXiNiXiQlXihAXjFrXigsXjlCXil+XiVMXjl8XiEiIA==",
      "byte_length": 34
    },
    {
      "unit_id": "DLG_4dce1241f5a9",
      "text": "劊子手靠得太近了——在他揮刀劈下的瞬間，我奮力踹了他一腳。那一擊 ",
      "encoded_ascii": "^?&^#(^$+^.C^#e^+f^(l^*D^*n^*n^\"d^!@^2\"^7Q^4t^!(^&Z^1N^)G^*A^$%^+g^!~^?,^*D^!@^!%^00^!\"^)!^!%^$F ",
      "encoded_base64": "Xj8mXiMoXiQrXi5DXiNlXitmXihsXipEXipuXipuXiJkXiFAXjIiXjdRXjR0XiEoXiZaXjFOXilHXipBXiQlXitnXiF+Xj8sXipEXiFAXiElXjAwXiEiXikhXiElXiRGIA==",
      "byte_length": 97
    },
    {
      "unit_id": "DLG_2ec1dfaafb04",
      "text": "因而偏斜，砍斷了我身上的繩索而非我的脖子。衛兵隨即一擁而上 ",
      "encoded_ascii": "^\"]^'W^![^$Y^*A^&l^,T^*D^$%^(c^!'^&Z^'L^'>^'W^)i^$%^&Z^8%^#(^!\"^(=^+,^)X^\"1^!%^,M^'W^!' ",
      "encoded_base64": "XiJdXidXXiFbXiRZXipBXiZsXixUXipEXiQlXihjXiEnXiZaXidMXic+XidXXilpXiQlXiZaXjglXiMoXiEiXig9XissXilYXiIxXiElXixNXidXXiEnIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_63927585ce2f",
      "text": "圍攻我，但我奪下劊子手的巨斧擊退了他們。",
      "encoded_ascii": "^\"`^$O^$%^*A^!I^$%^1,^!(^?&^#(^$+^&Z^#H^$Z^$F^*V^*D^!@^*{^!\"",
      "encoded_base64": "XiJgXiRPXiQlXipBXiFJXiQlXjEsXiEoXj8mXiMoXiQrXiZaXiNIXiRaXiRGXipWXipEXiFAXip7XiEi",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_9518cbff1e1f",
      "text": "我研究過蘇隆蟲人，深知牠們的陰謀圖謀。要是他真把 ",
      "encoded_ascii": "^$%^9G^-<^(x^4c^)T^(8^!<^*A^2*^&h^-#^*{^&Z^6B^3~^\"b^3~^!\"^(C^,X^!@^-2^$1 ",
      "encoded_base64": "XiQlXjlHXi08Xih4XjRjXilUXig4XiE8XipBXjIqXiZoXi0jXip7XiZaXjZCXjN+XiJiXjN+XiEiXihDXixYXiFAXi0yXiQxIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_479a530760dc",
      "text": "巨靈交給牠們，亞薩斯早就不復存在了。儘管我萬分不願 ",
      "encoded_ascii": "^#H^)g^0P^'A^-#^*{^*A^!9^-e^$[^,V^*J^!)^#g^#*^\"d^*D^!\"^+(^-D^$%^-_^!s^!)^.H ",
      "encoded_base64": "XiNIXilnXjBQXidBXi0jXip7XipBXiE5Xi1lXiRbXixWXipKXiEpXiNnXiMqXiJkXipEXiEiXisoXi1EXiQlXi1fXiFzXiEpXi5IIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_267add817754",
      "text": "弒君，但他根本沒給我任何退路。 ",
      "encoded_ascii": "^?(^+@^*A^!I^!@^%)^$x^%\\^'A^$%^!C^!L^*V^(a^!\" ",
      "encoded_base64": "Xj8oXitAXipBXiFJXiFAXiUpXiR4XiVcXidBXiQlXiFDXiFMXipWXihhXiEiIA==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_d343d6aaa449",
      "text": "我奪取巨靈唯一的目的，就是為了阻止蘇隆蟲人得到它。 ",
      "encoded_ascii": "^$%^1,^\":^#H^)g^+O^!%^&Z^&^^&Z^*A^*J^,X^%{^*D^)L^%G^4c^)T^(8^!<^#e^!u^+o^!\" ",
      "encoded_base64": "XiQlXjEsXiI6XiNIXilnXitPXiElXiZaXiZeXiZaXipBXipKXixYXiV7XipEXilMXiVHXjRjXilUXig4XiE8XiNlXiF1XitvXiEiIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_ae50ff0c8417",
      "text": "我在許願封印蘇隆蟲人時描述得不夠具體詳盡，因此巨靈 ",
      "encoded_ascii": "^$%^\"d^-s^.H^#5^1%^4c^)T^(8^!<^$f^/g^68^#e^!)^+d^!k^**^6v^-1^*A^\"]^%I^#H^)g ",
      "encoded_base64": "XiQlXiJkXi1zXi5IXiM1XjElXjRjXilUXig4XiE8XiRmXi9nXjY4XiNlXiEpXitkXiFrXioqXjZ2Xi0xXipBXiJdXiVJXiNIXilnIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_9449486d5eaf",
      "text": "選擇了這種做法。巨靈確實「封印了所有的邪惡」。 ",
      "encoded_ascii": "^.6^,N^*D^(s^'$^*~^%b^!\"^#H^)g^-6^#3^!#^#5^1%^*D^$)^$s^&Z^)\"^#y^!$^!\" ",
      "encoded_base64": "Xi42XixOXipEXihzXickXip+XiViXiEiXiNIXilnXi02XiMzXiEjXiM1XjElXipEXiQpXiRzXiZaXikiXiN5XiEkXiEiIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_08cf60385a2e",
      "text": "牠們一直在伺機等待我放鬆戒備。牠們八成是希望能唆使你們 ",
      "encoded_ascii": "^-#^*{^!%^&`^\"d^0Q^%>^'-^,*^$%^$P^.R^$&^+\"^!\"^-#^*{^50^$$^,X^+{^,]^'b^=H^!N^*F^*{ ",
      "encoded_base64": "Xi0jXip7XiElXiZgXiJkXjBRXiU+XictXiwqXiQlXiRQXi5SXiQmXisiXiEiXi0jXip7XjUwXiQkXixYXit7XixdXidiXj1IXiFOXipGXip7IA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_2ffff5aad100",
      "text": "從我手中把鎮尼瓶騙走。",
      "encoded_ascii": "^#f^$%^$+^!,^$1^);^#>^&D^.{^.&^!\"",
      "encoded_base64": "XiNmXiQlXiQrXiEsXiQxXik7XiM+XiZEXi57Xi4mXiEi",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_6706361debed",
      "text": "你們是來消滅我的？究竟是藉著什麼藉口？",
      "encoded_ascii": "^*F^*{^,X^!O^%k^%t^$%^&Z^.V^-<^28^,X^04^-a^!=^.T^04^\"<^.V",
      "encoded_base64": "XipGXip7XixYXiFPXiVrXiV0XiQlXiZaXi5WXi08XjI4XixYXjA0Xi1hXiE9Xi5UXjA0XiI8Xi5W",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_f6bf5ff418f1",
      "text": "  我需要巨靈。",
      "encoded_ascii": "  ^$%^)e^(C^#H^)g^!\"",
      "encoded_base64": "ICBeJCVeKWVeKENeI0heKWdeISI=",
      "byte_length": 20
    },
    {
      "unit_id": "DLG_a5e34b3d97f0",
      "text": "  蘇隆蟲人告訴我，是你把這座城市深埋地下的。",
      "encoded_ascii": "  ^4c^)T^(8^!<^+B^-t^$%^*A^,X^*F^$1^(s^/_^+_^+z^2*^1r^\"e^!(^&Z^!\"",
      "encoded_base64": "ICBeNGNeKVReKDheITxeK0JeLXReJCVeKkFeLFheKkZeJDFeKHNeL19eK19eK3peMipeMXJeImVeISheJlpeISI=",
      "byte_length": 65
    },
    {
      "unit_id": "DLG_1984fd0f5509",
      "text": "  你殺了國王！",
      "encoded_ascii": "  ^*F^%M^*D^+^^-)^*W",
      "encoded_base64": "ICBeKkZeJU1eKkReK15eLSleKlc=",
      "byte_length": 20
    },
    {
      "unit_id": "DLG_96a83a044f11",
      "text": "算了。 ",
      "encoded_ascii": "^-C^*D^!\" ",
      "encoded_base64": "Xi1DXipEXiEiIA==",
      "byte_length": 10
    },
    {
      "unit_id": "DLG_31c475d5ce34",
      "text": "許多人都「需要」巨靈。如果真想得到它，你們最好能提出 ",
      "encoded_ascii": "^-s^\"x^!<^)$^!#^)e^(C^!$^#H^)g^!\"^#$^%!^-2^,1^#e^!u^+o^*A^*F^*{^$q^+i^'b^$A^!q ",
      "encoded_base64": "Xi1zXiJ4XiE8XikkXiEjXillXihDXiEkXiNIXilnXiEiXiMkXiUhXi0yXiwxXiNlXiF1XitvXipBXipGXip7XiRxXitpXidiXiRBXiFxIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_b93afd90e507",
      "text": "更具說服力的理由。 ",
      "encoded_ascii": "^$o^!k^-x^,\\^!~^&Z^&A^&I^!\" ",
      "encoded_base64": "XiRvXiFrXi14XixcXiF+XiZaXiZBXiZJXiEiIA==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_3bf21782de9b",
      "text": "這確實是事實。德懷爾國王與我為了巨靈大打出手。他聽不進 ",
      "encoded_ascii": "^(s^-6^#3^,X^*r^#3^!\"^#j^,9^&/^+^^-)^'p^$%^%{^*D^#H^)g^\"z^$-^!q^$+^!\"^!@^-X^!)^(w ",
      "encoded_base64": "XihzXi02XiMzXixYXipyXiMzXiEiXiNqXiw5XiYvXiteXi0pXidwXiQlXiV7XipEXiNIXilnXiJ6XiQtXiFxXiQrXiEiXiFAXi1YXiEpXih3IA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_52c3cd36d385",
      "text": "任何勸告，也不肯把巨靈交給我，我別無選擇。我絕不能讓 ",
      "encoded_ascii": "^!C^!L^;?^+B^*A^!1^!)^-Z^$1^#H^)g^0P^'A^$%^*A^$%^*H^%}^.6^,N^!\"^$%^-I^!)^'b^-} ",
      "encoded_base64": "XiFDXiFMXjs/XitCXipBXiExXiEpXi1aXiQxXiNIXilnXjBQXidBXiQlXipBXiQlXipIXiV9Xi42XixOXiEiXiQlXi1JXiEpXidiXi19IA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_edd298df774a",
      "text": "巨靈落入蘇隆蟲人的手中。 ",
      "encoded_ascii": "^#H^)g^-`^!f^4c^)T^(8^!<^&Z^$+^!,^!\" ",
      "encoded_base64": "XiNIXilnXi1gXiFmXjRjXilUXig4XiE8XiZaXiQrXiEsXiEiIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_b3adebbd1e61",
      "text": "隨你們的便。",
      "encoded_ascii": "^)X^*F^*{^&Z^!R^!\"",
      "encoded_base64": "XilYXipGXip7XiZaXiFSXiEi",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_b7930f5261e6",
      "text": "我們沒什麼好談的了。你們的圖謀顯然居心叵測。 ",
      "encoded_ascii": "^$%^*{^%\\^!=^.T^+i^0;^&Z^*D^!\"^*F^*{^&Z^\"b^3~^4&^&\"^+w^#k^>}^%p^!\" ",
      "encoded_base64": "XiQlXip7XiVcXiE9Xi5UXitpXjA7XiZaXipEXiEiXipGXip7XiZaXiJiXjN+XjQmXiYiXit3XiNrXj59XiVwXiEiIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_dca4bfbc9831",
      "text": "  抱歉，是我弄錯了。",
      "encoded_ascii": "  ^,@^,h^*A^,X^$%^/`^)5^*D^!\"",
      "encoded_base64": "ICBeLEBeLGheKkFeLFheJCVeL2BeKTVeKkReISI=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_7548a48804ed",
      "text": "  請原諒我。",
      "encoded_ascii": "  ^*S^\"5^0<^$%^!\"",
      "encoded_base64": "ICBeKlNeIjVeMDxeJCVeISI=",
      "byte_length": 17
    },
    {
      "unit_id": "DLG_c17a270a3aa3",
      "text": "  我只是在試探你，並無惡意。",
      "encoded_ascii": "  ^$%^\"?^,X^\"d^-u^$>^*F^*A^!+^%}^#y^#z^!\"",
      "encoded_base64": "ICBeJCVeIj9eLFheImReLXVeJD5eKkZeKkFeISteJX1eI3leI3peISI=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_3b1ce0015681",
      "text": "  我想向你打聽些情報。",
      "encoded_ascii": "  ^$%^,1^+?^*F^$-^-X^!8^,0^+`^!\"",
      "encoded_base64": "ICBeJCVeLDFeKz9eKkZeJC1eLVheITheLDBeK2BeISI=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_9467e7652b14",
      "text": "我明白了。但我為何要相信你們？",
      "encoded_ascii": "^$%^$c^&X^*D^!\"^!I^$%^%{^!L^(C^&a^!U^*F^*{^.V",
      "encoded_base64": "XiQlXiRjXiZYXipEXiEiXiFJXiQlXiV7XiFMXihDXiZhXiFVXipGXip7Xi5W",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_51c2b3322a16",
      "text": "  我能看穿蘇隆蟲人的奸計。",
      "encoded_ascii": "  ^$%^'b^*Q^')^4c^)T^(8^!<^&Z^:2^-n^!\"",
      "encoded_base64": "ICBeJCVeJ2JeKlFeJyleNGNeKVReKDheITxeJlpeOjJeLW5eISI=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_3ac3127b21cb",
      "text": "  蘇隆蟲人誆騙了我。我現在已經明白了。 ",
      "encoded_ascii": "  ^4c^)T^(8^!<^?+^.{^*D^$%^!\"^$%^&?^\"d^#J^'D^$c^&X^*D^!\" ",
      "encoded_base64": "ICBeNGNeKVReKDheITxePyteLnteKkReJCVeISJeJCVeJj9eImReI0peJ0ReJGNeJlheKkReISIg",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_ece5243e3874",
      "text": "  因為我說的句句屬實！",
      "encoded_ascii": "  ^\"]^%{^$%^-x^&Z^2]^2]^#C^#3^*W",
      "encoded_base64": "ICBeIl1eJXteJCVeLXheJlpeMl1eMl1eI0NeIzNeKlc=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_8166bdd68c97",
      "text": "  好啊！不信拉倒！",
      "encoded_ascii": "  ^+i^+Q^*W^!)^!U^$6^!X^*W",
      "encoded_base64": "ICBeK2leK1FeKldeISleIVVeJDZeIVheKlc=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_1a682061ce1c",
      "text": "你們怎麼會去相信那些令人作嘔的異怪？ ",
      "encoded_ascii": "^*F^*{^,,^.T^$r^\"6^&a^!U^)!^!8^*w^!<^!M^0T^&Z^&M^#s^.V ",
      "encoded_base64": "XipGXip7XiwsXi5UXiRyXiI2XiZhXiFVXikhXiE4Xip3XiE8XiFNXjBUXiZaXiZNXiNzXi5WIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_7b11bd30bfcb",
      "text": "我很難信任你們，但我可以把話說明。去找到我的遺體並予以安葬， ",
      "encoded_ascii": "^$%^*K^)a^!U^!C^*F^*{^*A^!I^$%^\"A^!B^$1^-v^-x^$c^!\"^\"6^$/^!u^$%^&Z^0v^**^!+^!4^!B^+p^-b^*A ",
      "encoded_base64": "XiQlXipLXilhXiFVXiFDXipGXip7XipBXiFJXiQlXiJBXiFCXiQxXi12Xi14XiRjXiEiXiI2XiQvXiF1XiQlXiZaXjB2XioqXiErXiE0XiFCXitwXi1iXipBIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_e6236a02b060",
      "text": "以此向我證明你們崇高的善意。如果你們替我辦到這件事，我 ",
      "encoded_ascii": "^!B^%I^+?^$%^-{^$c^*F^*{^13^*+^&Z^1(^#z^!\"^#$^%!^*F^*{^2o^$%^2L^!u^(s^.W^*r^*A^$% ",
      "encoded_base64": "XiFCXiVJXis/XiQlXi17XiRjXipGXip7XjEzXiorXiZaXjEoXiN6XiEiXiMkXiUhXipGXip7XjJvXiQlXjJMXiF1XihzXi5XXipyXipBXiQlIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_53913db7420f",
      "text": "便會將鎮尼瓶交給你們。 ",
      "encoded_ascii": "^!R^$r^#7^);^#>^&D^0P^'A^*F^*{^!\" ",
      "encoded_base64": "XiFSXiRyXiM3Xik7XiM+XiZEXjBQXidBXipGXip7XiEiIA==",
      "byte_length": 34
    },
    {
      "unit_id": "DLG_2a566c2e457a",
      "text": "我現在不信……以後也不會信。 ",
      "encoded_ascii": "^$%^&?^\"d^!)^!U^*o^*o^!B^#b^!1^!)^$r^!U^!\" ",
      "encoded_base64": "XiQlXiY/XiJkXiEpXiFVXipvXipvXiFCXiNiXiExXiEpXiRyXiFVXiEiIA==",
      "byte_length": 43
    },
    {
      "unit_id": "DLG_e6d13295a127",
      "text": "這點說詞根本不足以令人信服。 ",
      "encoded_ascii": "^(s^*;^-x^.v^%)^$x^!)^(^^!B^*w^!<^!U^,\\^!\" ",
      "encoded_base64": "XihzXio7Xi14Xi52XiUpXiR4XiEpXiheXiFCXip3XiE8XiFVXixcXiEiIA==",
      "byte_length": 43
    },
    {
      "unit_id": "DLG_4ca338db799c",
      "text": "離開此地。 ",
      "encoded_ascii": "^)`^)F^%I^\"e^!\" ",
      "encoded_base64": "XilgXilGXiVJXiJlXiEiIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_e805b28dd574",
      "text": "原諒你們？你們得先幫我一個忙。去從蘇隆蟲人手中奪回我的遺體， ",
      "encoded_ascii": "^\"5^0<^*F^*{^.V^*F^*{^#e^!b^+}^$%^!%^!V^,+^!\"^\"6^#f^4c^)T^(8^!<^$+^!,^1,^\"\\^$%^&Z^0v^**^*A ",
      "encoded_base64": "XiI1XjA8XipGXip7Xi5WXipGXip7XiNlXiFiXit9XiQlXiElXiFWXiwrXiEiXiI2XiNmXjRjXilUXig4XiE8XiQrXiEsXjEsXiJcXiQlXiZaXjB2XioqXipBIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_359ad15e0fc0",
      "text": "以此證明你們值得信賴，我就會把巨靈交給你們。",
      "encoded_ascii": "^!B^%I^-{^$c^*F^*{^!Z^#e^!U^0t^*A^$%^*J^$r^$1^#H^)g^0P^'A^*F^*{^!\"",
      "encoded_base64": "XiFCXiVJXi17XiRjXipGXip7XiFaXiNlXiFVXjB0XipBXiQlXipKXiRyXiQxXiNIXilnXjBQXidBXipGXip7XiEi",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_dc554e9fc690",
      "text": "愚蠢至極。 ",
      "encoded_ascii": "^/a^.u^'n^1D^!\" ",
      "encoded_base64": "Xi9hXi51XiduXjFEXiEiIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_9676ed73b0ad",
      "text": "如果那是你們想要的，我這部書卷自當為你們敞開。 ",
      "encoded_ascii": "^#$^%!^)!^,X^*F^*{^,1^(C^&Z^*A^$%^(s^)#^$p^\"3^'l^&N^%{^*F^*{^*d^)F^!\" ",
      "encoded_base64": "XiMkXiUhXikhXixYXipGXip7XiwxXihDXiZaXipBXiQlXihzXikjXiRwXiIzXidsXiZOXiV7XipGXip7XipkXilGXiEiIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_264e303a3ebf",
      "text": "我的身軀！你們這些異鄉人把它帶回這裡，真是幫了我天大的忙。只要你們肯 ",
      "encoded_ascii": "^$%^&Z^(c^(d^*W^*F^*{^(s^!8^&M^6<^!<^$1^+o^#N^\"\\^(s^-j^*A^-2^,X^+}^*D^$%^+e^\"z^&Z^,+^!\"^\"?^(C^*F^*{^-Z ",
      "encoded_base64": "XiQlXiZaXihjXihkXipXXipGXip7XihzXiE4XiZNXjY8XiE8XiQxXitvXiNOXiJcXihzXi1qXipBXi0yXixYXit9XipEXiQlXitlXiJ6XiZaXiwrXiEiXiI/XihDXipGXip7Xi1aIA==",
      "byte_length": 103
    },
    {
      "unit_id": "DLG_a9b47c9299ef",
      "text": "將它安置於陵墓之中，我終於能入土為安、獲得平靜了。",
      "encoded_ascii": "^#7^+o^+p^'Q^$^^7!^6P^!/^!,^*A^$%^-H^$^^'b^!f^\"c^%{^+p^!!^&:^#e^0Y^)h^*D^!\"",
      "encoded_base64": "XiM3XitvXitwXidRXiReXjchXjZQXiEvXiEsXipBXiQlXi1IXiReXidiXiFmXiJjXiV7XitwXiEhXiY6XiNlXjBZXiloXipEXiEi",
      "byte_length": 75
    },
    {
      "unit_id": "DLG_5cd84ec45de7",
      "text": "  你為何想要找回遺體？",
      "encoded_ascii": "  ^*F^%{^!L^,1^(C^$/^\"\\^0v^**^.V",
      "encoded_base64": "ICBeKkZeJXteIUxeLDFeKENeJC9eIlxeMHZeKipeLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_16f3a9e76d02",
      "text": "  你為何自封為守護者？",
      "encoded_ascii": "  ^*F^%{^!L^'l^#5^%{^#+^(T^'V^.V",
      "encoded_base64": "ICBeKkZeJXteIUxeJ2xeIzVeJXteIyteKFReJ1ZeLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_de0e6073248f",
      "text": "  我想弄清楚方才聽到的傳聞。",
      "encoded_ascii": "  ^$%^,1^/`^,u^,c^$]^$,^-X^!u^&Z^+$^4^^!\"",
      "encoded_base64": "ICBeJCVeLDFeL2BeLHVeLGNeJF1eJCxeLVheIXVeJlpeKyReNF5eISI=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_10c3232c717c",
      "text": "  陵墓在什麼地方？",
      "encoded_ascii": "  ^7!^6P^\"d^!=^.T^\"e^$]^.V",
      "encoded_base64": "ICBeNyFeNlBeImReIT1eLlReImVeJF1eLlY=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_c08118501e77",
      "text": "我是克拉格，自封為巨靈的守望者。",
      "encoded_ascii": "^$%^,X^!d^$6^%*^*A^'l^#5^%{^#H^)g^&Z^#+^,]^'V^!\"",
      "encoded_base64": "XiQlXixYXiFkXiQ2XiUqXipBXidsXiM1XiV7XiNIXilnXiZaXiMrXixdXidWXiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_c088d8d64337",
      "text": "只要我的遺體安放在石棺之中，我的靈魂便能終於迎來應得的歸宿。",
      "encoded_ascii": "^\"?^(C^$%^&Z^0v^**^+p^$P^\"d^&k^%2^!/^!,^*A^$%^&Z^)g^*.^!R^'b^-H^$^^(k^!O^0`^#e^&Z^%K^7+^!\"",
      "encoded_base64": "XiI/XihDXiQlXiZaXjB2XioqXitwXiRQXiJkXiZrXiUyXiEvXiEsXipBXiQlXiZaXilnXiouXiFSXidiXi1IXiReXihrXiFPXjBgXiNlXiZaXiVLXjcrXiEi",
      "byte_length": 90
    },
    {
      "unit_id": "DLG_5d4066bce51b",
      "text": "唯有我才知道，要是當初我沒奪走那個神瓶，這座宮殿 ",
      "encoded_ascii": "^+O^$s^$%^$,^&h^(y^*A^(C^,X^&N^1\"^$%^%\\^1,^.&^)!^!V^&w^&D^*A^(s^/_^/\\^.m ",
      "encoded_base64": "XitPXiRzXiQlXiQsXiZoXih5XipBXihDXixYXiZOXjEiXiQlXiVcXjEsXi4mXikhXiFWXiZ3XiZEXipBXihzXi9fXi9cXi5tIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_e7b875855568",
      "text": "將會落得何等悲慘的下場。",
      "encoded_ascii": "^#7^$r^-`^#e^!L^'-^,.^,4^&Z^!(^\"n^!\"",
      "encoded_base64": "XiM3XiRyXi1gXiNlXiFMXictXiwuXiw0XiZaXiEoXiJuXiEi",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_63a7f8709431",
      "text": "跟我來。",
      "encoded_ascii": "^.+^$%^!O^!\"",
      "encoded_base64": "Xi4rXiQlXiFPXiEi",
      "byte_length": 12
    },
    {
      "unit_id": "DLG_692b560d2222",
      "text": "請千萬別在將我的遺體放入石棺之前就離開。隨後我便會 ",
      "encoded_ascii": "^*S^+7^-_^*H^\"d^#7^$%^&Z^0v^**^$P^!f^&k^%2^!/^!z^*J^)`^)F^!\"^)X^#b^$%^!R^$r ",
      "encoded_base64": "XipTXis3Xi1fXipIXiJkXiM3XiQlXiZaXjB2XioqXiRQXiFmXiZrXiUyXiEvXiF6XipKXilgXilGXiEiXilYXiNiXiQlXiFSXiRyIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_8480860dff02",
      "text": "把巨靈交給你們。",
      "encoded_ascii": "^$1^#H^)g^0P^'A^*F^*{^!\"",
      "encoded_base64": "XiQxXiNIXilnXjBQXidBXipGXip7XiEi",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_e61faa330438",
      "text": "你們帶回了我的遺體！我定會信守承諾。將我的遺體放入陵墓中敞開的 ",
      "encoded_ascii": "^*F^*{^#N^\"\\^*D^$%^&Z^0v^**^*W^$%^#.^$r^!U^#+^$0^7k^!\"^#7^$%^&Z^0v^**^$P^!f^7!^6P^!,^*d^)F^&Z ",
      "encoded_base64": "XipGXip7XiNOXiJcXipEXiQlXiZaXjB2XioqXipXXiQlXiMuXiRyXiFVXiMrXiQwXjdrXiEiXiM3XiQlXiZaXjB2XioqXiRQXiFmXjchXjZQXiEsXipkXilGXiZaIA==",
      "byte_length": 94
    },
    {
      "unit_id": "DLG_c7d8c9489a61",
      "text": "石棺內。隨後我便會將巨靈移交給你們。 ",
      "encoded_ascii": "^&k^%2^!g^!\"^)X^#b^$%^!R^$r^#7^#H^)g^'\"^0P^'A^*F^*{^!\" ",
      "encoded_base64": "XiZrXiUyXiFnXiEiXilYXiNiXiQlXiFSXiRyXiM3XiNIXilnXiciXjBQXidBXipGXip7XiEiIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_ec1ca4b2f534",
      "text": "我感應到你們並未帶著我的遺體。我的靈魂渴望安息——請務必找到 ",
      "encoded_ascii": "^$%^#{^0`^!u^*F^*{^!+^,_^#N^-a^$%^&Z^0v^**^!\"^$%^&Z^)g^*.^,w^,]^+p^#w^*n^*n^*S^+4^#l^$/^!u ",
      "encoded_base64": "XiQlXiN7XjBgXiF1XipGXip7XiErXixfXiNOXi1hXiQlXiZaXjB2XioqXiEiXiQlXiZaXilnXiouXix3XixdXitwXiN3XipuXipuXipTXis0XiNsXiQvXiF1IA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_091a3eb34f20",
      "text": "它。那些蘇隆蟲人極有可能正在看守著它。 ",
      "encoded_ascii": "^+o^!\"^)!^!8^4c^)T^(8^!<^1D^$s^\"A^'b^%H^\"d^*Q^#+^-a^+o^!\" ",
      "encoded_base64": "XitvXiEiXikhXiE4XjRjXilUXig4XiE8XjFEXiRzXiJBXidiXiVIXiJkXipRXiMrXi1hXitvXiEiIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_8424013b0db2",
      "text": "圖努正採集著鹽巴，對你們視若無睹。",
      "encoded_ascii": "^\"b^1$^%H^5R^)]^-a^*4^#K^*A^#:^*F^*{^(E^'x^%}^>6^!\"",
      "encoded_base64": "XiJiXjEkXiVIXjVSXildXi1hXio0XiNLXipBXiM6XipGXip7XihFXid4XiV9Xj42XiEi",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_6987ca1f211f",
      "text": "圖努正在採集鹽巴。",
      "encoded_ascii": "^\"b^1$^%H^\"d^5R^)]^*4^#K^!\"",
      "encoded_base64": "XiJiXjEkXiVIXiJkXjVSXildXio0XiNLXiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_e63b3dae8694",
      "text": "一名男子在鹽原上徘徊漫步。他不時彎下身子，將 ",
      "encoded_ascii": "^!%^\"F^&K^#(^\"d^*4^\"5^!'^9X^9W^2,^,i^!\"^!@^!)^$f^?0^!(^(c^#(^*A^#7 ",
      "encoded_base64": "XiElXiJGXiZLXiMoXiJkXio0XiI1XiEnXjlYXjlXXjIsXixpXiEiXiFAXiEpXiRmXj8wXiEoXihjXiMoXipBXiM3IA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_4aa0cf7ae5b9",
      "text": "一把把的鹽巴裝進草編籃子裡。",
      "encoded_ascii": "^!%^$1^$1^&Z^*4^#K^(A^(w^*f^5u^?4^#(^-j^!\"",
      "encoded_base64": "XiElXiQxXiQxXiZaXio0XiNLXihBXih3XipmXjV1Xj80XiMoXi1qXiEi",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_fc45d9e942f8",
      "text": "當你走過時，北面的牆壁微微泛起閃爍的光芒。",
      "encoded_ascii": "^&N^*F^.&^(x^$f^*A^+6^)j^&Z^&0^*\\^#i^#i^0i^.(^)E^&+^&Z^!c^'u^!\"",
      "encoded_base64": "XiZOXipGXi4mXih4XiRmXipBXis2XilqXiZaXiYwXipcXiNpXiNpXjBpXi4oXilFXiYrXiZaXiFjXid1XiEi",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_d82a69e4c91e",
      "text": "的手因感應到魔法的湧動而隱隱刺痛…… ",
      "encoded_ascii": "^&Z^$+^\"]^#{^0`^!u^*0^%b^&Z^0m^\"%^'W^)Y^)Y^!w^-.^*o^*o ",
      "encoded_base64": "XiZaXiQrXiJdXiN7XjBgXiF1XiowXiViXiZaXjBtXiIlXidXXilZXilZXiF3Xi0uXipvXipvIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_9bfb0f644fa4",
      "text": "當他碰觸牆壁時。",
      "encoded_ascii": "^&N^!@^-5^(J^&0^*\\^$f^!\"",
      "encoded_base64": "XiZOXiFAXi01XihKXiYwXipcXiRmXiEi",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_6ebaa9fc074c",
      "text": "大廳內灌滿了呼嘯的疾風，洗滌淨化了最後一絲邪惡的污穢。",
      "encoded_ascii": "^\"z^0\\^!g^0o^,{^*D^\"M^0U^&Z^&Q^)y^*A^0j^0n^0k^\")^*D^$q^#b^!%^'C^)\"^#y^&Z^0h^0q^!\"",
      "encoded_base64": "XiJ6XjBcXiFnXjBvXix7XipEXiJNXjBVXiZaXiZRXil5XipBXjBqXjBuXjBrXiIpXipEXiRxXiNiXiElXidDXikiXiN5XiZaXjBoXjBxXiEi",
      "byte_length": 81
    },
    {
      "unit_id": "DLG_bf36c30f2033",
      "text": "一陣狂暴巨風咆哮著席捲整個房間，淹沒了塔拉的尖叫聲…… ",
      "encoded_ascii": "^!%^)P^&8^$m^#H^)y^.[^.\\^-a^0X^0c^$T^!V^,<^)G^*A^0l^%\\^*D^\"o^$6^&Z^#=^+<^-W^*o^*o ",
      "encoded_base64": "XiElXilQXiY4XiRtXiNIXil5Xi5bXi5cXi1hXjBYXjBjXiRUXiFWXiw8XilHXipBXjBsXiVcXipEXiJvXiQ2XiZaXiM9Xis8Xi1XXipvXipvIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_cb35a9c33c11",
      "text": "眼睜睜看著她的身軀無可挽回地消散崩解。",
      "encoded_ascii": "^&d^.q^.q^*Q^-a^+h^&Z^(c^(d^%}^\"A^0b^\"\\^\"e^%k^$S^0W^(I^!\"",
      "encoded_base64": "XiZkXi5xXi5xXipRXi1hXitoXiZaXihjXihkXiV9XiJBXjBiXiJcXiJlXiVrXiRTXjBXXihJXiEi",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_72b51e91cfc7",
      "text": "周圍的空氣…… ",
      "encoded_ascii": "^\"L^\"`^&Z^'(^%U^*o^*o ",
      "encoded_base64": "XiJMXiJgXiZaXicoXiVVXipvXipvIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_886b79be2ecf",
      "text": " 當一陣輕柔微風從瓶中湧出時，微微騷動。",
      "encoded_ascii": " ^&N^!%^)P^(g^0f^#i^)y^#f^&D^!,^0m^!q^$f^*A^#i^#i^0y^\"%^!\"",
      "encoded_base64": "IF4mTl4hJV4pUF4oZ14wZl4jaV4peV4jZl4mRF4hLF4wbV4hcV4kZl4qQV4jaV4jaV4weV4iJV4hIg==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_fcf62ef57a4c",
      "text": " 夠不著銅鑼。",
      "encoded_ascii": " ^+d^!)^-a^0x^)B^!\"",
      "encoded_base64": "IF4rZF4hKV4tYV4weF4pQl4hIg==",
      "byte_length": 19
    },
    {
      "unit_id": "DLG_4924821d136a",
      "text": "小偷！我就知道我不該信任你！",
      "encoded_ascii": "^#;^/O^*W^$%^*J^&h^(y^$%^!)^(M^!U^!C^*F^*W",
      "encoded_base64": "XiM7Xi9PXipXXiQlXipKXiZoXih5XiQlXiEpXihNXiFVXiFDXipGXipX",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_ac87d7f725e8",
      "text": "我警告過你別想佔我便宜！",
      "encoded_ascii": "^$%^(S^+B^(x^*F^*H^,1^0R^$%^!R^/[^*W",
      "encoded_base64": "XiQlXihTXitCXih4XipGXipIXiwxXjBSXiQlXiFSXi9bXipX",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_db33da2fa6a7",
      "text": "崔絲特蘭",
      "encoded_ascii": "^#E^'C^&5^/G",
      "encoded_base64": "XiNFXidDXiY1Xi9H",
      "byte_length": 12
    },
    {
      "unit_id": "DLG_f41e936fa0d9",
      "text": "幽靈女子",
      "encoded_ascii": "^2f^)g^#\"^#(",
      "encoded_base64": "XjJmXilnXiMiXiMo",
      "byte_length": 12
    },
    {
      "unit_id": "DLG_a10c0ab22f1a",
      "text": " 坐在那裡自顧自地哼著曲調。",
      "encoded_ascii": " ^8E^\"d^)!^-j^'l^4n^'l^\"e^+K^-a^$n^(Q^!\"",
      "encoded_base64": "IF44RV4iZF4pIV4tal4nbF40bl4nbF4iZV4rS14tYV4kbl4oUV4hIg==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_551a2a481618",
      "text": "  你在哼些什麼？",
      "encoded_ascii": "  ^*F^\"d^+K^!8^!=^.T^.V",
      "encoded_base64": "ICBeKkZeImReK0teITheIT1eLlReLlY=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_db8d7d52605c",
      "text": "  你是崔絲特蘭嗎？",
      "encoded_ascii": "  ^*F^,X^#E^'C^&5^/G^+X^.V",
      "encoded_base64": "ICBeKkZeLFheI0VeJ0NeJjVeL0deK1heLlY=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_4d86364f29fb",
      "text": "  該啟程去哪裡？",
      "encoded_ascii": "  ^(M^57^'#^\"6^+I^-j^.V",
      "encoded_base64": "ICBeKE1eNTdeJyNeIjZeK0leLWpeLlY=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_ede53e375019",
      "text": "  你將與誰結為連理？",
      "encoded_ascii": "  ^*F^#7^'p^-y^'@^%{^.0^&A^.V",
      "encoded_base64": "ICBeKkZeIzdeJ3BeLXleJ0BeJXteLjBeJkFeLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_2e271378b6fd",
      "text": "  你一直在等待什麼？",
      "encoded_ascii": "  ^*F^!%^&`^\"d^'-^,*^!=^.T^.V",
      "encoded_base64": "ICBeKkZeISVeJmBeImReJy1eLCpeIT1eLlReLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_e5c4b3ef9733",
      "text": "  替你準備什麼？",
      "encoded_ascii": "  ^2o^*F^,x^+\"^!=^.T^.V",
      "encoded_base64": "ICBeMm9eKkZeLHheKyJeIT1eLlReLlY=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_7bcda46b297d",
      "text": "  你的家在何處？",
      "encoded_ascii": "  ^*F^&Z^+s^\"d^!L^(,^.V",
      "encoded_base64": "ICBeKkZeJlpeK3NeImReIUxeKCxeLlY=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_7ab348339c44",
      "text": "  你想去哪裡？",
      "encoded_ascii": "  ^*F^,1^\"6^+I^-j^.V",
      "encoded_base64": "ICBeKkZeLDFeIjZeK0leLWpeLlY=",
      "byte_length": 20
    },
    {
      "unit_id": "DLG_d6ed6bd2254e",
      "text": "那是往昔歲月裡的一首婚禮之歌……抑或是首輓歌……我 ",
      "encoded_ascii": "^)!^,X^,)^<)^,j^/p^-j^&Z^!%^)~^3A^-8^!/^4J^*o^*o^?1^$'^,X^)~^?9^4J^*o^*o^$% ",
      "encoded_base64": "XikhXixYXiwpXjwpXixqXi9wXi1qXiZaXiElXil+XjNBXi04XiEvXjRKXipvXipvXj8xXiQnXixYXil+Xj85XjRKXipvXipvXiQlIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_3ead3258aab1",
      "text": "已經記不清了。",
      "encoded_ascii": "^#J^'D^(K^!)^,u^*D^!\"",
      "encoded_base64": "XiNKXidEXihLXiEpXix1XipEXiEi",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_093a159c01dd",
      "text": "當然。帶我回家吧。",
      "encoded_ascii": "^&N^&\"^!\"^#N^$%^\"\\^+s^*I^!\"",
      "encoded_base64": "XiZOXiYiXiEiXiNOXiQlXiJcXitzXipJXiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_a04f275c5d5d",
      "text": "我想 ",
      "encoded_ascii": "^$%^,1 ",
      "encoded_base64": "XiQlXiwxIA==",
      "byte_length": 7
    },
    {
      "unit_id": "DLG_1e17295c7170",
      "text": "我將與某人締結連理……或者……我是要回家……",
      "encoded_ascii": "^$%^#7^'p^%$^!<^?6^'@^.0^&A^*o^*o^$'^'V^*o^*o^$%^,X^(C^\"\\^+s^*o^*o",
      "encoded_base64": "XiQlXiM3XidwXiUkXiE8Xj82XidAXi4wXiZBXipvXipvXiQnXidWXipvXipvXiQlXixYXihDXiJcXitzXipvXipv",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_79eddb65326e",
      "text": "結為連理？我許配給了……一位國王？那我必定是一位公主了。",
      "encoded_ascii": "^'@^%{^.0^&A^.V^$%^-s^)&^'A^*D^*o^*o^!%^!J^+^^-)^.V^)!^$%^#l^#.^,X^!%^!J^3:^!-^*D^!\"",
      "encoded_base64": "XidAXiV7Xi4wXiZBXi5WXiQlXi1zXikmXidBXipEXipvXipvXiElXiFKXiteXi0pXi5WXikhXiQlXiNsXiMuXixYXiElXiFKXjM6XiEtXipEXiEi",
      "byte_length": 84
    },
    {
      "unit_id": "DLG_42aefa9f87e7",
      "text": "我的護衛隊應該很快就會到了。是他們派你們來替我梳妝準備的嗎？",
      "encoded_ascii": "^$%^&Z^(T^(=^)U^0`^(M^*K^*L^*J^$r^!u^*D^!\"^,X^!@^*{^.n^*F^*{^!O^2o^$%^>C^?/^,x^+\"^&Z^+X^.V",
      "encoded_base64": "XiQlXiZaXihUXig9XilVXjBgXihNXipLXipMXipKXiRyXiF1XipEXiEiXixYXiFAXip7Xi5uXipGXip7XiFPXjJvXiQlXj5DXj8vXix4XisiXiZaXitYXi5W",
      "byte_length": 90
    },
    {
      "unit_id": "DLG_784af58cfff6",
      "text": "家就是你們要帶我去的地方。我們現在可以啟程了嗎？",
      "encoded_ascii": "^+s^*J^,X^*F^*{^(C^#N^$%^\"6^&Z^\"e^$]^!\"^$%^*{^&?^\"d^\"A^!B^57^'#^*D^+X^.V",
      "encoded_base64": "XitzXipKXixYXipGXip7XihDXiNOXiQlXiI2XiZaXiJlXiRdXiEiXiQlXip7XiY/XiJkXiJBXiFCXjU3XicjXipEXitYXi5W",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_d34e73ac94b9",
      "text": "家。",
      "encoded_ascii": "^+s^!\"",
      "encoded_base64": "XitzXiEi",
      "byte_length": 6
    },
    {
      "unit_id": "DLG_5fdef9eec6d4",
      "text": " 現在該啟程了嗎？",
      "encoded_ascii": " ^&?^\"d^(M^57^'#^*D^+X^.V",
      "encoded_base64": "IF4mP14iZF4oTV41N14nI14qRF4rWF4uVg==",
      "byte_length": 25
    },
    {
      "unit_id": "DLG_9e20bee3ce3b",
      "text": " 我在這裡等了好久好久。我的裙袍都布滿皺褶了。 ",
      "encoded_ascii": " ^$%^\"d^(s^-j^'-^*D^+i^!.^+i^!.^!\"^$%^&Z^?7^6r^)$^.`^,{^?3^?8^*D^!\" ",
      "encoded_base64": "IF4kJV4iZF4oc14tal4nLV4qRF4raV4hLl4raV4hLl4hIl4kJV4mWl4/N142cl4pJF4uYF4se14/M14/OF4qRF4hIiA=",
      "byte_length": 68
    },
    {
      "unit_id": "DLG_93416f6d6564",
      "text": "我們現在可以啟程了嗎？",
      "encoded_ascii": "^$%^*{^&?^\"d^\"A^!B^57^'#^*D^+X^.V",
      "encoded_base64": "XiQlXip7XiY/XiJkXiJBXiFCXjU3XicjXipEXitYXi5W",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_27277de0cb25",
      "text": " 我們現在可以啟程了嗎？",
      "encoded_ascii": " ^$%^*{^&?^\"d^\"A^!B^57^'#^*D^+X^.V",
      "encoded_base64": "IF4kJV4qe14mP14iZF4iQV4hQl41N14nI14qRF4rWF4uVg==",
      "byte_length": 34
    },
    {
      "unit_id": "DLG_029936fc5da2",
      "text": " 請帶我回家吧。",
      "encoded_ascii": " ^*S^#N^$%^\"\\^+s^*I^!\"",
      "encoded_base64": "IF4qU14jTl4kJV4iXF4rc14qSV4hIg==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_2e22bcb6a798",
      "text": "  那座新王國在何處？",
      "encoded_ascii": "  ^)!^/_^$\\^-)^+^^\"d^!L^(,^.V",
      "encoded_base64": "ICBeKSFeL19eJFxeLSleK15eImReIUxeKCxeLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_e9e72e5871b6",
      "text": "  沒錯。我是來接你的。",
      "encoded_ascii": "  ^%\\^)5^!\"^$%^,X^!O^$?^*F^&Z^!\"",
      "encoded_base64": "ICBeJVxeKTVeISJeJCVeLFheIU9eJD9eKkZeJlpeISI=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_b67e3081124e",
      "text": "  我得告訴護衛隊我找到你了。",
      "encoded_ascii": "  ^$%^#e^+B^-t^(T^(=^)U^$%^$/^!u^*F^*D^!\"",
      "encoded_base64": "ICBeJCVeI2VeK0JeLXReKFReKD1eKVVeJCVeJC9eIXVeKkZeKkReISI=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_51a337e2d1ff",
      "text": "  讓我帶走一件信物，以證明我找到了你。",
      "encoded_ascii": "  ^-}^$%^#N^.&^!%^.W^!U^&4^*A^!B^-{^$c^$%^$/^!u^*D^*F^!\"",
      "encoded_base64": "ICBeLX1eJCVeI05eLiZeISVeLldeIVVeJjReKkFeIUJeLXteJGNeJCVeJC9eIXVeKkReKkZeISI=",
      "byte_length": 56
    },
    {
      "unit_id": "DLG_2b75318d08d3",
      "text": "  我會帶上水晶，並將護衛隊引來。",
      "encoded_ascii": "  ^$%^$r^#N^!'^%V^$h^*A^!+^#7^(T^(=^)U^#Z^!O^!\"",
      "encoded_base64": "ICBeJCVeJHJeI05eISdeJVZeJGheKkFeISteIzdeKFReKD1eKVVeI1peIU9eISI=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_388cab0c10e4",
      "text": "  跟我來，我們這就啟程。",
      "encoded_ascii": "  ^.+^$%^!O^*A^$%^*{^(s^*J^57^'#^!\"",
      "encoded_base64": "ICBeLiteJCVeIU9eKkFeJCVeKnteKHNeKkpeNTdeJyNeISI=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_e2dfbc881039",
      "text": "  你為何不願跟我走？",
      "encoded_ascii": "  ^*F^%{^!L^!)^.H^.+^$%^.&^.V",
      "encoded_base64": "ICBeKkZeJXteIUxeISleLkheLiteJCVeLiZeLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_4ff50d149471",
      "text": "  我要如何才能帶你離開？",
      "encoded_ascii": "  ^$%^(C^#$^!L^$,^'b^#N^*F^)`^)F^.V",
      "encoded_base64": "ICBeJCVeKENeIyReIUxeJCxeJ2JeI05eKkZeKWBeKUZeLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_d79cc950f470",
      "text": "踏上前往我新王國的旅途。回到我的家。",
      "encoded_ascii": "^.,^!'^!z^,)^$%^$\\^-)^+^^&Z^2m^3.^!\"^\"\\^!u^$%^&Z^+s^!\"",
      "encoded_base64": "Xi4sXiEnXiF6XiwpXiQlXiRcXi0pXiteXiZaXjJtXjMuXiEiXiJcXiF1XiQlXiZaXitzXiEi",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_15311fbe2c76",
      "text": "你不知道嗎？那是我該去的地方。",
      "encoded_ascii": "^*F^!)^&h^(y^+X^.V^)!^,X^$%^(M^\"6^&Z^\"e^$]^!\"",
      "encoded_base64": "XipGXiEpXiZoXih5XitYXi5WXikhXixYXiQlXihNXiI2XiZaXiJlXiRdXiEi",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_8c127f1ea562",
      "text": "我已經等待了太久太久。我們這就出發好嗎？",
      "encoded_ascii": "^$%^#J^'D^'-^,*^*D^+f^!.^+f^!.^!\"^$%^*{^(s^*J^!q^&W^+i^+X^.V",
      "encoded_base64": "XiQlXiNKXidEXictXiwqXipEXitmXiEuXitmXiEuXiEiXiQlXip7XihzXipKXiFxXiZXXitpXitYXi5W",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_d60458f88fd2",
      "text": "好呀！請轉告護衛隊，等他們抵達時我一定準備妥當。",
      "encoded_ascii": "^+i^3h^*W^*S^(i^+B^(T^(=^)U^*A^'-^!@^*{^$5^(z^$f^$%^!%^#.^,x^+\"^5C^&N^!\"",
      "encoded_base64": "XitpXjNoXipXXipTXihpXitCXihUXig9XilVXipBXictXiFAXip7XiQ1Xih6XiRmXiQlXiElXiMuXix4XisiXjVDXiZOXiEi",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_441ca3b369a7",
      "text": "好呀！護衛隊。你們會帶我回家，前往我的王國。你們該知道，我是一位 ",
      "encoded_ascii": "^+i^3h^*W^(T^(=^)U^!\"^*F^*{^$r^#N^$%^\"\\^+s^*A^!z^,)^$%^&Z^-)^+^^!\"^*F^*{^(M^&h^(y^*A^$%^,X^!%^!J ",
      "encoded_base64": "XitpXjNoXipXXihUXig9XilVXiEiXipGXip7XiRyXiNOXiQlXiJcXitzXipBXiF6XiwpXiQlXiZaXi0pXiteXiEiXipGXip7XihNXiZoXih5XipBXiQlXixYXiElXiFKIA==",
      "byte_length": 97
    },
    {
      "unit_id": "DLG_e42c7dd9f108",
      "text": "公主。",
      "encoded_ascii": "^3:^!-^!\"",
      "encoded_base64": "XjM6XiEtXiEi",
      "byte_length": 9
    },
    {
      "unit_id": "DLG_333a233f2260",
      "text": "拿著這枚水晶吧。這是某人贈予我的……現在是出發的時刻了嗎？",
      "encoded_ascii": "^,G^-a^(s^$~^%V^$h^*I^!\"^(s^,X^%$^!<^([^!4^$%^&Z^*o^*o^&?^\"d^,X^!q^&W^&Z^$f^.Y^*D^+X^.V",
      "encoded_base64": "XixHXi1hXihzXiR+XiVWXiRoXipJXiEiXihzXixYXiUkXiE8XihbXiE0XiQlXiZaXipvXipvXiY/XiJkXixYXiFxXiZXXiZaXiRmXi5ZXipEXitYXi5W",
      "byte_length": 87
    },
    {
      "unit_id": "DLG_452e68696f0c",
      "text": "噢，不。我辦不到。你必須親自帶我走。",
      "encoded_ascii": "^+]^*A^!)^!\"^$%^2L^!)^!u^!\"^*F^#l^)r^(F^'l^#N^$%^.&^!\"",
      "encoded_base64": "XitdXipBXiEpXiEiXiQlXjJMXiEpXiF1XiEiXipGXiNsXilyXihGXidsXiNOXiQlXi4mXiEi",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_1a8867cec16f",
      "text": "我無法跟著你走。你必須帶我離開。帶我回家。",
      "encoded_ascii": "^$%^%}^%b^.+^-a^*F^.&^!\"^*F^#l^)r^#N^$%^)`^)F^!\"^#N^$%^\"\\^+s^!\"",
      "encoded_base64": "XiQlXiV9XiViXi4rXi1hXipGXi4mXiEiXipGXiNsXilyXiNOXiQlXilgXilGXiEiXiNOXiQlXiJcXitzXiEi",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_35d0841542ca",
      "text": "帶我回家。",
      "encoded_ascii": "^#N^$%^\"\\^+s^!\"",
      "encoded_base64": "XiNOXiQlXiJcXitzXiEi",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_7e95a655bb76",
      "text": "站住！",
      "encoded_ascii": "^->^*z^*W",
      "encoded_base64": "Xi0+Xip6XipX",
      "byte_length": 9
    },
    {
      "unit_id": "DLG_cc38ad3e1410",
      "text": "妄動者死！",
      "encoded_ascii": "^+j^\"%^'V^%L^*W",
      "encoded_base64": "XitqXiIlXidWXiVMXipX",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_82e7ad81e8f3",
      "text": "  廢話少說！納命來吧！",
      "encoded_ascii": "  ^#W^-v^#<^-x^*W^';^\"N^!O^*I^*W",
      "encoded_base64": "ICBeI1deLXZeIzxeLXheKldeJzteIk5eIU9eKkleKlc=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_f9d63b69714d",
      "text": " 你意下如何？",
      "encoded_ascii": " ^*F^#z^!(^#$^!L^.V",
      "encoded_base64": "IF4qRl4jel4hKF4jJF4hTF4uVg==",
      "byte_length": 19
    },
    {
      "unit_id": "DLG_dfc40169833c",
      "text": "  你們休想活捉我！",
      "encoded_ascii": "  ^*F^*{^!G^,1^%i^4>^$%^*W",
      "encoded_base64": "ICBeKkZeKnteIUdeLDFeJWleND5eJCVeKlc=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_72a345f7dd52",
      "text": "  你就是我在商隊看見的那個敗類！",
      "encoded_ascii": "  ^*F^*J^,X^$%^\"d^1'^)U^*Q^-m^&Z^)!^!V^$R^)w^*W",
      "encoded_base64": "ICBeKkZeKkpeLFheJCVeImReMSdeKVVeKlFeLW1eJlpeKSFeIVZeJFJeKXdeKlc=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_8c59a8072b5e",
      "text": "  或許我們可以做個交易。",
      "encoded_ascii": "  ^$'^-s^$%^*{^\"A^!B^*~^!V^0P^,W^!\"",
      "encoded_base64": "ICBeJCdeLXNeJCVeKnteIkFeIUJeKn5eIVZeMFBeLFdeISI=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_5b4112bee35f",
      "text": " 等我把你的鮮血灑入黃沙之中時。",
      "encoded_ascii": " ^'-^$%^$1^*F^&Z^35^(:^?2^!f^*7^%]^!/^!,^$f^!\"",
      "encoded_base64": "IF4nLV4kJV4kMV4qRl4mWl4zNV4oOl4/Ml4hZl4qN14lXV4hL14hLF4kZl4hIg==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_e9d3dcf6bf9f",
      "text": "  我投降！只要別殺我就行！",
      "encoded_ascii": "  ^$%^$3^)N^*W^\"?^(C^*H^%M^$%^*J^(;^*W",
      "encoded_base64": "ICBeJCVeJDNeKU5eKldeIj9eKENeKkheJU1eJCVeKkpeKDteKlc=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_a753f356d583",
      "text": " 指著你們，與身旁的一名同夥得意洋洋地狂笑著。",
      "encoded_ascii": " ^$8^-a^*F^*{^*A^'p^(c^.h^&Z^!%^\"F^\"E^5?^#e^#z^75^75^\"e^&8^-@^-a^!\"",
      "encoded_base64": "IF4kOF4tYV4qRl4qe14qQV4ncF4oY14uaF4mWl4hJV4iRl4iRV41P14jZV4jel43NV43NV4iZV4mOF4tQF4tYV4hIg==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_e4162b378331",
      "text": "瞧見沒？我們根本不必付錢給托布里安。他們就像狗找主人一樣自己送上門來了。",
      "encoded_ascii": "^-4^-m^%\\^.V^$%^*{^%)^$x^!)^#l^*u^.<^'A^/-^.`^)(^+p^!\"^!@^*{^*J^!`^-&^$/^!-^!<^!%^,f^'l^#I^./^!'^)D^!O^*D^!\"",
      "encoded_base64": "Xi00Xi1tXiVcXi5WXiQlXip7XiUpXiR4XiEpXiNsXip1Xi48XidBXi8tXi5gXikoXitwXiEiXiFAXip7XipKXiFgXi0mXiQvXiEtXiE8XiElXixmXidsXiNJXi4vXiEnXilEXiFPXipEXiEi",
      "byte_length": 108
    },
    {
      "unit_id": "DLG_edea0c0fc294",
      "text": "我要的就是你們！",
      "encoded_ascii": "^$%^(C^&Z^*J^,X^*F^*{^*W",
      "encoded_base64": "XiQlXihDXiZaXipKXixYXipGXip7XipX",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_feed41503e48",
      "text": "不論你們情不情願、是死是活，我都要把你們押交給奧布爾指揮官。",
      "encoded_ascii": "^!)^1\\^*F^*{^,0^!)^,0^.H^!!^,X^%L^,X^%i^*A^$%^)$^(C^$1^*F^*{^7Z^0P^'A^6Q^.`^&/^$8^2\"^#-^!\"",
      "encoded_base64": "XiEpXjFcXipGXip7XiwwXiEpXiwwXi5IXiEhXixYXiVMXixYXiVpXipBXiQlXikkXihDXiQxXipGXip7XjdaXjBQXidBXjZRXi5gXiYvXiQ4XjIiXiMtXiEi",
      "byte_length": 90
    },
    {
      "unit_id": "DLG_acfb3f821b4f",
      "text": "  你認錯人了。",
      "encoded_ascii": "  ^*F^(O^)5^!<^*D^!\"",
      "encoded_base64": "ICBeKkZeKE9eKTVeITxeKkReISI=",
      "byte_length": 20
    },
    {
      "unit_id": "DLG_568a70b1fca1",
      "text": "  奧布爾指揮官是誰？",
      "encoded_ascii": "  ^6Q^.`^&/^$8^2\"^#-^,X^-y^.V",
      "encoded_base64": "ICBeNlFeLmBeJi9eJDheMiJeIy1eLFheLXleLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_7452cb8ff7ce",
      "text": "  這對你有什麼好處？",
      "encoded_ascii": "  ^(s^#:^*F^$s^!=^.T^+i^(,^.V",
      "encoded_base64": "ICBeKHNeIzpeKkZeJHNeIT1eLlReK2leKCxeLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_8a83ce7907c7",
      "text": "  你們的指揮官絕不會希望我們死掉。",
      "encoded_ascii": "  ^*F^*{^&Z^$8^2\"^#-^-I^!)^$r^+{^,]^$%^*{^%L^/e^!\"",
      "encoded_base64": "ICBeKkZeKnteJlpeJDheMiJeIy1eLUleISleJHJeK3teLF1eJCVeKnteJUxeL2VeISI=",
      "byte_length": 50
    },
    {
      "unit_id": "DLG_3037f159f4a7",
      "text": "絕不可能。你就是 ",
      "encoded_ascii": "^-I^!)^\"A^'b^!\"^*F^*J^,X ",
      "encoded_base64": "Xi1JXiEpXiJBXidiXiEiXipGXipKXixYIA==",
      "byte_length": 25
    },
    {
      "unit_id": "DLG_2fb072bfc070",
      "text": "。在親眼見證過那場血戰之後，任誰都很難忘記你這張臉——就在 ",
      "encoded_ascii": "^!\"^\"d^(F^&d^-m^-{^(x^)!^\"n^(:^$(^!/^#b^*A^!C^-y^)$^*K^)a^0]^(K^*F^(s^,(^-\\^*n^*n^*J^\"d ",
      "encoded_base64": "XiEiXiJkXihGXiZkXi1tXi17Xih4XikhXiJuXig6XiQoXiEvXiNiXipBXiFDXi15XikkXipLXilhXjBdXihLXipGXihzXiwoXi1cXipuXipuXipKXiJkIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_d7f5c932aa5b",
      "text": "德拉吉的角鬥場之中。",
      "encoded_ascii": "^#j^$6^\"D^&Z^(H^*,^\"n^!/^!,^!\"",
      "encoded_base64": "XiNqXiQ2XiJEXiZaXihIXiosXiJuXiEvXiEsXiEi",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_b0a6d8c6481d",
      "text": "。我收到的關於你的通緝描述可是鉅細靡遺。",
      "encoded_ascii": "^!\"^$%^$M^!u^&Z^.>^$^^*F^&Z^(t^?5^/g^68^\"A^,X^9w^'?^;^^0v^!\"",
      "encoded_base64": "XiEiXiQlXiRNXiF1XiZaXi4+XiReXipGXiZaXih0Xj81Xi9nXjY4XiJBXixYXjl3Xic/XjteXjB2XiEi",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_c801baaf2e1a",
      "text": "他是聖堂武士派來的。奴隸永遠都是奴隸，而你們也 ",
      "encoded_ascii": "^!@^,X^'Z^42^%J^+a^.n^!O^&Z^!\"^##^)Z^%W^({^)$^,X^##^)Z^*A^'W^*F^*{^!1 ",
      "encoded_base64": "XiFAXixYXidaXjQyXiVKXithXi5uXiFPXiZaXiEiXiMjXilaXiVXXih7XikkXixYXiMjXilaXipBXidXXipGXip7XiExIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_2e2fd82102ab",
      "text": "絕不例外！你們以為逃出德拉吉就重獲了自由，但 ",
      "encoded_ascii": "^-I^!)^9h^\"w^*W^*F^*{^!B^%{^(p^!q^#j^$6^\"D^*J^))^&:^*D^'l^&I^*A^!I ",
      "encoded_base64": "Xi1JXiEpXjloXiJ3XipXXipGXip7XiFCXiV7XihwXiFxXiNqXiQ2XiJEXipKXikpXiY6XipEXidsXiZJXipBXiFJIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_7dae7998bd28",
      "text": "奧布爾會讓你們認清殘酷的現實！",
      "encoded_ascii": "^6Q^.`^&/^$r^-}^*F^*{^(O^,u^,l^1b^&Z^&?^#3^*W",
      "encoded_base64": "XjZRXi5gXiYvXiRyXi19XipGXip7XihPXix1XixsXjFiXiZaXiY/XiMzXipX",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_8379237ced16",
      "text": "當然是為了錢！",
      "encoded_ascii": "^&N^&\"^,X^%{^*D^.<^*W",
      "encoded_base64": "XiZOXiYiXixYXiV7XipEXi48XipX",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_f7f032b3e908",
      "text": "你們項上人頭的懸賞金額實在令人難以抗拒。這筆賞金既然擺在那裡， ",
      "encoded_ascii": "^*F^*{^)q^!'^!<^)t^&Z^0a^*T^)+^)v^#3^\"d^*w^!<^)a^!B^$4^5Q^!\"^(s^-A^*T^)+^,U^&\"^1@^\"d^)!^-j^*A ",
      "encoded_base64": "XipGXip7XilxXiEnXiE8Xil0XiZaXjBhXipUXikrXil2XiMzXiJkXip3XiE8XilhXiFCXiQ0XjVRXiEiXihzXi1BXipUXikrXixVXiYiXjFAXiJkXikhXi1qXipBIA==",
      "byte_length": 94
    },
    {
      "unit_id": "DLG_8e4d517a9496",
      "text": "不如就由我笑納了。",
      "encoded_ascii": "^!)^#$^*J^&I^$%^-@^';^*D^!\"",
      "encoded_base64": "XiEpXiMkXipKXiZJXiQlXi1AXic7XipEXiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_ac7f459d93af",
      "text": "宰了你們正好能替他省去親自動手的麻煩，還能替我省下 ",
      "encoded_ascii": "^1w^*D^*F^*{^%H^+i^'b^2o^!@^9%^\"6^(F^'l^\"%^$+^&Z^*6^-!^*A^.7^'b^2o^$%^9%^!( ",
      "encoded_base64": "XjF3XipEXipGXip7XiVIXitpXidiXjJvXiFAXjklXiI2XihGXidsXiIlXiQrXiZaXio2Xi0hXipBXi43XidiXjJvXiQlXjklXiEoIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_788f42807d72",
      "text": "餵養你們的口糧！",
      "encoded_ascii": "^.L^.I^*F^*{^&Z^\"<^5s^*W",
      "encoded_base64": "Xi5MXi5JXipGXip7XiZaXiI8XjVzXipX",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_84024d4fc3ee",
      "text": "你從昏迷中幽幽轉醒，發現自己已被城邦 ",
      "encoded_ascii": "^*F^#f^$d^(n^!,^2f^2f^(i^.9^*A^&W^&?^'l^#I^#J^(@^+_^1a ",
      "encoded_base64": "XipGXiNmXiRkXihuXiEsXjJmXjJmXihpXi45XipBXiZXXiY/XidsXiNJXiNKXihAXitfXjFhIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_3a0cd4ac6207",
      "text": "軍隊團團包圍。 ",
      "encoded_ascii": "^..^)U^0V^0V^\"'^\"`^!\" ",
      "encoded_base64": "Xi4uXilVXjBWXjBWXiInXiJgXiEiIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_df07a85b6726",
      "text": " 正與其中一名軍士激烈爭辯。",
      "encoded_ascii": " ^%H^'p^!j^!,^!%^\"F^..^+a^1H^%|^1I^?-^!\"",
      "encoded_base64": "IF4lSF4ncF4hal4hLF4hJV4iRl4uLl4rYV4xSF4lfF4xSV4/LV4hIg==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_04e75fd8497f",
      "text": "  動手攻擊他們。",
      "encoded_ascii": "  ^\"%^$+^$O^$F^!@^*{^!\"",
      "encoded_base64": "ICBeIiVeJCteJE9eJEZeIUBeKnteISI=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_2a9ccab5235c",
      "text": "  聆聽他們的對話。",
      "encoded_ascii": "  ^3$^-X^!@^*{^&Z^#:^-v^!\"",
      "encoded_base64": "ICBeMyReLVheIUBeKnteJlpeIzpeLXZeISI=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_ef7c6f4a5176",
      "text": "  打斷他們的爭吵。",
      "encoded_ascii": "  ^$-^,T^!@^*{^&Z^1I^/T^!\"",
      "encoded_base64": "ICBeJC1eLFReIUBeKnteJlpeMUleL1ReISI=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_b50831556e49",
      "text": "  嘗試逃跑。",
      "encoded_ascii": "  ^1o^-u^(p^(_^!\"",
      "encoded_base64": "ICBeMW9eLXVeKHBeKF9eISI=",
      "byte_length": 17
    },
    {
      "unit_id": "DLG_3b74b93a7b51",
      "text": "  你們打算把我怎麼樣？",
      "encoded_ascii": "  ^*F^*{^$-^-C^$1^$%^,,^.T^,f^.V",
      "encoded_base64": "ICBeKkZeKnteJC1eLUNeJDFeJCVeLCxeLlReLGZeLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_5b7676a03c4c",
      "text": "我們剛好就在討論這個——究竟是在押送你們去見指揮官之前就殺了你們， ",
      "encoded_ascii": "^$%^*{^+0^+i^*J^\"d^-o^1\\^(s^!V^*n^*n^-<^28^,X^\"d^7Z^./^*F^*{^\"6^-m^$8^2\"^#-^!/^!z^*J^%M^*D^*F^*{^*A ",
      "encoded_base64": "XiQlXip7XiswXitpXipKXiJkXi1vXjFcXihzXiFWXipuXipuXi08XjI4XixYXiJkXjdaXi4vXipGXip7XiI2Xi1tXiQ4XjIiXiMtXiEvXiF6XipKXiVNXipEXipGXip7XipBIA==",
      "byte_length": 100
    },
    {
      "unit_id": "DLG_a8270601b13f",
      "text": "還是等押到了之後再宰了你們。",
      "encoded_ascii": "^.7^,X^'-^7Z^!u^*D^!/^#b^!l^1w^*D^*F^*{^!\"",
      "encoded_base64": "Xi43XixYXictXjdaXiF1XipEXiEvXiNiXiFsXjF3XipEXipGXip7XiEi",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_e8d9fe58fd21",
      "text": "哈！這些下賤的耗子居然也想插嘴！",
      "encoded_ascii": "^+F^*W^(s^!8^!(^2G^&Z^'X^#(^+w^&\"^!1^,1^4{^+[^*W",
      "encoded_base64": "XitGXipXXihzXiE4XiEoXjJHXiZaXidYXiMoXit3XiYiXiExXiwxXjR7XitbXipX",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_e2a2261d2976",
      "text": "你應該當場宰了他們！",
      "encoded_ascii": "^*F^0`^(M^&N^\"n^1w^*D^!@^*{^*W",
      "encoded_base64": "XipGXjBgXihNXiZOXiJuXjF3XipEXiFAXip7XipX",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_02449fe6b734",
      "text": "但指揮官說不定想抓活的。",
      "encoded_ascii": "^!I^$8^2\"^#-^-x^!)^#.^,1^$2^%i^&Z^!\"",
      "encoded_base64": "XiFJXiQ4XjIiXiMtXi14XiEpXiMuXiwxXiQyXiVpXiZaXiEi",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_a8ae13cfc374",
      "text": "跟他說他們是在企圖逃跑時被幹掉的。",
      "encoded_ascii": "^.+^!@^-x^!@^*{^,X^\"d^4-^\"b^(p^(_^$f^(@^,!^/e^&Z^!\"",
      "encoded_base64": "Xi4rXiFAXi14XiFAXip7XixYXiJkXjQtXiJiXihwXihfXiRmXihAXiwhXi9lXiZaXiEi",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_3750878496b5",
      "text": "殺了他們能省去不少麻煩",
      "encoded_ascii": "^%M^*D^!@^*{^'b^9%^\"6^!)^#<^*6^-!",
      "encoded_base64": "XiVNXipEXiFAXip7XidiXjklXiI2XiEpXiM8Xio2Xi0h",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_1903d51e26de",
      "text": " 在前往鹽沼綠洲的途中。 ",
      "encoded_ascii": " ^\"d^!z^,)^*4^=|^3V^76^&Z^3.^!,^!\" ",
      "encoded_base64": "IF4iZF4hel4sKV4qNF49fF4zVl43Nl4mWl4zLl4hLF4hIiA=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_df5597ffed23",
      "text": "你可以在現在就跟他們打一場，或者等他們試圖逃跑時再動手。",
      "encoded_ascii": "^*F^\"A^!B^\"d^&?^\"d^*J^.+^!@^*{^$-^!%^\"n^*A^$'^'V^'-^!@^*{^-u^\"b^(p^(_^$f^!l^\"%^$+^!\"",
      "encoded_base64": "XipGXiJBXiFCXiJkXiY/XiJkXipKXi4rXiFAXip7XiQtXiElXiJuXipBXiQnXidWXictXiFAXip7Xi11XiJiXihwXihfXiRmXiFsXiIlXiQrXiEi",
      "byte_length": 84
    },
    {
      "unit_id": "DLG_e5a7857b320c",
      "text": "你的提議確實很誘人——但指揮官實力強大，而且 ",
      "encoded_ascii": "^*F^&Z^$A^-|^-6^#3^*K^1Z^!<^*n^*n^!I^$8^2\"^#-^#3^!~^#]^\"z^*A^'W^!* ",
      "encoded_base64": "XipGXiZaXiRBXi18Xi02XiMzXipLXjFaXiE8XipuXipuXiFJXiQ4XjIiXiMtXiMzXiF+XiNdXiJ6XipBXidXXiEqIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_d5308ed60d19",
      "text": "我可不想承受他的雷霆之怒。",
      "encoded_ascii": "^$%^\"A^!)^,1^$0^\";^!@^&Z^)c^?:^!/^#o^!\"",
      "encoded_base64": "XiQlXiJBXiEpXiwxXiQwXiI7XiFAXiZaXiljXj86XiEvXiNvXiEi",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_4337f6a67f15",
      "text": "你難道以為指揮官除了要他們的命之外還會想要別的？ ",
      "encoded_ascii": "^*F^)a^(y^!B^%{^$8^2\"^#-^)Q^*D^(C^!@^*{^&Z^\"N^!/^\"w^.7^$r^,1^(C^*H^&Z^.V ",
      "encoded_base64": "XipGXilhXih5XiFCXiV7XiQ4XjIiXiMtXilRXipEXihDXiFAXip7XiZaXiJOXiEvXiJ3Xi43XiRyXiwxXihDXipIXiZaXi5WIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_a696b093ad16",
      "text": "他們給聖堂武士帶來的奇恥大辱，除了血債血償之外絕無 ",
      "encoded_ascii": "^!@^*{^'A^'Z^42^%J^+a^#N^!O^&Z^\"}^3G^\"z^3`^*A^)Q^*D^(:^<d^(:^5-^!/^\"w^-I^%} ",
      "encoded_base64": "XiFAXip7XidBXidaXjQyXiVKXithXiNOXiFPXiZaXiJ9XjNHXiJ6XjNgXipBXilRXipEXig6XjxkXig6XjUtXiEvXiJ3Xi1JXiV9IA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_184c4999e607",
      "text": "第二種可能！",
      "encoded_ascii": "^',^!5^'$^\"A^'b^*W",
      "encoded_base64": "XicsXiE1XickXiJBXidiXipX",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_5c675da681ed",
      "text": "你說得對！指揮官一定會好好犒賞我的。",
      "encoded_ascii": "^*F^-x^#e^#:^*W^$8^2\"^#-^!%^#.^$r^+i^+i^>>^*T^$%^&Z^!\"",
      "encoded_base64": "XipGXi14XiNlXiM6XipXXiQ4XjIiXiMtXiElXiMuXiRyXitpXitpXj4+XipUXiQlXiZaXiEi",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_584a667643b8",
      "text": "我現在就殺了他們！",
      "encoded_ascii": "^$%^&?^\"d^*J^%M^*D^!@^*{^*W",
      "encoded_base64": "XiQlXiY/XiJkXipKXiVNXipEXiFAXip7XipX",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_509643317219",
      "text": "首領",
      "encoded_ascii": "^)~^)s",
      "encoded_base64": "Xil+Xilz",
      "byte_length": 6
    },
    {
      "unit_id": "DLG_bce1e4cea5d8",
      "text": "一名精瘦的精靈",
      "encoded_ascii": "^!%^\"F^'7^>S^&Z^'7^)g",
      "encoded_base64": "XiElXiJGXic3Xj5TXiZaXic3Xiln",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_6add9d9904c9",
      "text": "，你們認出他就是托布里安篷車上的那個人，",
      "encoded_ascii": "^*A^*F^*{^(O^!q^!@^*J^,X^/-^.`^)(^+p^'1^5%^!'^&Z^)!^!V^!<^*A",
      "encoded_base64": "XipBXipGXip7XihPXiFxXiFAXipKXixYXi8tXi5gXikoXitwXicxXjUlXiEnXiZaXikhXiFWXiE8XipB",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_03564da1a773",
      "text": "若是你有興趣知道的話，我的名字是 ",
      "encoded_ascii": "^'x^,X^*F^$s^-]^.*^&h^(y^&Z^-v^*A^$%^&Z^\"F^#)^,X ",
      "encoded_base64": "Xid4XixYXipGXiRzXi1dXi4qXiZoXih5XiZaXi12XipBXiQlXiZaXiJGXiMpXixYIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_87601b5c50af",
      "text": "扎胡爾",
      "encoded_ascii": "^,=^3}^&/",
      "encoded_base64": "Xiw9XjN9XiYv",
      "byte_length": 9
    },
    {
      "unit_id": "DLG_f6cc34ccc3e4",
      "text": "塞雷夫",
      "encoded_ascii": "^/(^)c^\"{",
      "encoded_base64": "Xi8oXiljXiJ7",
      "byte_length": 9
    },
    {
      "unit_id": "DLG_c89330fd148b",
      "text": "。給牢牢記住了",
      "encoded_ascii": "^!\"^'A^-$^-$^(K^*z^*D",
      "encoded_base64": "XiEiXidBXi0kXi0kXihLXip6XipE",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_d0b405109f43",
      "text": "你倒是挺機靈的！不過這對你可沒半點好處",
      "encoded_ascii": "^*F^!X^,X^,I^%>^)g^&Z^*W^!)^(x^(s^#:^*F^\"A^%\\^\"-^*;^+i^(,",
      "encoded_base64": "XipGXiFYXixYXixJXiU+XilnXiZaXipXXiEpXih4XihzXiM6XipGXiJBXiVcXiItXio7XitpXigs",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_7c62a78bda55",
      "text": "當你們拔出武器時，衛兵們也紛紛伸手去抓自己的兵刃。 ",
      "encoded_ascii": "^&N^*F^*{^/c^!q^%J^\"V^$f^*A^(=^+,^*{^!1^7d^7d^/N^$+^\"6^$2^'l^#I^&Z^+,^!r^!\" ",
      "encoded_base64": "XiZOXipGXip7Xi9jXiFxXiVKXiJWXiRmXipBXig9XissXip7XiExXjdkXjdkXi9OXiQrXiI2XiQyXidsXiNJXiZaXissXiFyXiEiIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_9af4fc93c7ec",
      "text": "當你們企圖突圍逃跑時，衛兵們慌忙抓起兵刃圍堵。",
      "encoded_ascii": "^&N^*F^*{^4-^\"b^'*^\"`^(p^(_^$f^*A^(=^+,^*{^#}^,+^$2^.(^+,^!r^\"`^;u^!\"",
      "encoded_base64": "XiZOXipGXip7XjQtXiJiXicqXiJgXihwXihfXiRmXipBXig9XissXip7XiN9XiwrXiQyXi4oXissXiFyXiJgXjt1XiEi",
      "byte_length": 69
    },
    {
      "unit_id": "DLG_7d9f69dc9ace",
      "text": "那我們就沒什麼好談的了！",
      "encoded_ascii": "^)!^$%^*{^*J^%\\^!=^.T^+i^0;^&Z^*D^*W",
      "encoded_base64": "XikhXiQlXip7XipKXiVcXiE9Xi5UXitpXjA7XiZaXipEXipX",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_a41dd6e9ca78",
      "text": "你同意嗎？ ",
      "encoded_ascii": "^*F^\"E^#z^+X^.V ",
      "encoded_base64": "XipGXiJFXiN6XitYXi5WIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_d4ea33116744",
      "text": "那我們有什麼好商量的？",
      "encoded_ascii": "^)!^$%^*{^$s^!=^.T^+i^1'^)*^&Z^.V",
      "encoded_base64": "XikhXiQlXip7XiRzXiE9Xi5UXitpXjEnXikqXiZaXi5W",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_56800cdb0637",
      "text": "你們手上的籌碼可少得可憐！你們能拿出什麼東西，是我 ",
      "encoded_ascii": "^*F^*{^$+^!'^&Z^:W^94^\"A^#<^#e^\"A^1}^*W^*F^*{^'b^,G^!q^!=^.T^,`^-l^*A^,X^$% ",
      "encoded_base64": "XipGXip7XiQrXiEnXiZaXjpXXjk0XiJBXiM8XiNlXiJBXjF9XipXXipGXip7XidiXixHXiFxXiE9Xi5UXixgXi1sXipBXixYXiQlIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_28311b2a3309",
      "text": "不能直接動手搶走的？",
      "encoded_ascii": "^!)^'b^&`^$?^\"%^$+^1?^.&^&Z^.V",
      "encoded_base64": "XiEpXidiXiZgXiQ/XiIlXiQrXjE/Xi4mXiZaXi5W",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_022fe6117951",
      "text": "  我的錢袋沉甸甸的。我可以分你一份。",
      "encoded_ascii": "  ^$%^&Z^.<^(?^%Z^4X^4X^&Z^!\"^$%^\"A^!B^!s^*F^!%^*x^!\"",
      "encoded_base64": "ICBeJCVeJlpeLjxeKD9eJVpeNFheNFheJlpeISJeJCVeIkFeIUJeIXNeKkZeISVeKnheISI=",
      "byte_length": 53
    },
    {
      "unit_id": "DLG_6d8033b887fd",
      "text": "  你喜歡在角鬥場下注賭博嗎？",
      "encoded_ascii": "  ^*F^+V^%F^\"d^(H^*,^\"n^!(^%e^=L^/$^+X^.V",
      "encoded_base64": "ICBeKkZeK1ZeJUZeImReKEheKixeIm5eISheJWVePUxeLyReK1heLlY=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_21f082f5d246",
      "text": "  我可以向你保證，讓你死個痛快。",
      "encoded_ascii": "  ^$%^\"A^!B^+?^*F^!T^-{^*A^-}^*F^%L^!V^-.^*L^!\"",
      "encoded_base64": "ICBeJCVeIkFeIUJeKz9eKkZeIVReLXteKkFeLX1eKkZeJUxeIVZeLS5eKkxeISI=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_56656676deab",
      "text": "  你太小看我了！",
      "encoded_ascii": "  ^*F^+f^#;^*Q^$%^*D^*W",
      "encoded_base64": "ICBeKkZeK2ZeIzteKlFeJCVeKkReKlc=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_2c9a04e938cc",
      "text": "  帶我去見你們的指揮官。",
      "encoded_ascii": "  ^#N^$%^\"6^-m^*F^*{^&Z^$8^2\"^#-^!\"",
      "encoded_base64": "ICBeI05eJCVeIjZeLW1eKkZeKnteJlpeJDheMiJeIy1eISI=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_8a40c82d8393",
      "text": "你憑什麼認為等你死了之後，我不會直接搜刮你的錢財？",
      "encoded_ascii": "^*F^,5^!=^.T^(O^%{^'-^*F^%L^*D^!/^#b^*A^$%^!)^$r^&`^$?^/h^;r^*F^&Z^.<^0=^.V",
      "encoded_base64": "XipGXiw1XiE9Xi5UXihPXiV7XictXipGXiVMXipEXiEvXiNiXipBXiQlXiEpXiRyXiZgXiQ/Xi9oXjtyXipGXiZaXi48XjA9Xi5W",
      "byte_length": 75
    },
    {
      "unit_id": "DLG_f2e13407b46a",
      "text": "說實在的，我確實是個嗜賭如命的老手——但我懷疑你連隻兔子都打不過！ ",
      "encoded_ascii": "^-x^#3^\"d^&Z^*A^$%^-6^#3^,X^!V^>3^=L^#$^\"N^&Z^'U^$+^*n^*n^!I^$%^,9^0p^*F^.0^)[^?.^#(^)$^$-^!)^(x^*W ",
      "encoded_base64": "Xi14XiMzXiJkXiZaXipBXiQlXi02XiMzXixYXiFWXj4zXj1MXiMkXiJOXiZaXidVXiQrXipuXipuXiFJXiQlXiw5XjBwXipGXi4wXilbXj8uXiMoXikkXiQtXiEpXih4XipXIA==",
      "byte_length": 100
    },
    {
      "unit_id": "DLG_fa58adfdea63",
      "text": "讓你們跟我養的達戈蘭獸鬥，根本連熱身都算不上。",
      "encoded_ascii": "^-}^*F^*{^.+^$%^.I^&Z^(z^*M^/G^&<^*,^*A^%)^$x^.0^&$^(c^)$^-C^!)^!'^!\"",
      "encoded_base64": "Xi19XipGXip7Xi4rXiQlXi5JXiZaXih6XipNXi9HXiY8XiosXipBXiUpXiR4Xi4wXiYkXihjXikkXi1DXiEpXiEnXiEi",
      "byte_length": 69
    },
    {
      "unit_id": "DLG_7e2e3bc204f6",
      "text": "哈！俘虜投降了！果然只有前奴隸才想得出這種窩囊主意。",
      "encoded_ascii": "^+F^*W^39^3[^$3^)N^*D^*W^%!^&\"^\"?^$s^!z^##^)Z^$,^,1^#e^!q^(s^'$^=0^5=^!-^#z^!\"",
      "encoded_base64": "XitGXipXXjM5XjNbXiQzXilOXipEXipXXiUhXiYiXiI/XiRzXiF6XiMjXilaXiQsXiwxXiNlXiFxXihzXickXj0wXjU9XiEtXiN6XiEi",
      "byte_length": 78
    },
    {
      "unit_id": "DLG_05081447069e",
      "text": "別的暫且不論，你倒是挺能逗人發笑的！或許你可以當我的弄臣？",
      "encoded_ascii": "^*H^&Z^$l^!*^!)^1\\^*A^*F^!X^,X^,I^'b^;;^!<^&W^-@^&Z^*W^$'^-s^*F^\"A^!B^&N^$%^&Z^/`^.s^.V",
      "encoded_base64": "XipIXiZaXiRsXiEqXiEpXjFcXipBXipGXiFYXixYXixJXidiXjs7XiE8XiZXXi1AXiZaXipXXiQnXi1zXipGXiJBXiFCXiZOXiQlXiZaXi9gXi5zXi5W",
      "byte_length": 87
    },
    {
      "unit_id": "DLG_e18016e35da6",
      "text": "那本來就是我們的打算！但是 ",
      "encoded_ascii": "^)!^$x^!O^*J^,X^$%^*{^&Z^$-^-C^*W^!I^,X ",
      "encoded_base64": "XikhXiR4XiFPXipKXixYXiQlXip7XiZaXiQtXi1DXipXXiFJXixYIA==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_7140576b476c",
      "text": "我會帶著你們的屍體去交差！",
      "encoded_ascii": "^$%^$r^#N^-a^*F^*{^&Z^#?^**^\"6^0P^48^*W",
      "encoded_base64": "XiQlXiRyXiNOXi1hXipGXip7XiZaXiM/XioqXiI2XjBQXjQ4XipX",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_b5dbc16f2b74",
      "text": "看在你們這麼溫順聽話的份上，我會 ",
      "encoded_ascii": "^*Q^\"d^*F^*{^(s^.T^%s^.D^-X^-v^&Z^*x^!'^*A^$%^$r ",
      "encoded_base64": "XipRXiJkXipGXip7XihzXi5UXiVzXi5EXi1YXi12XiZaXip4XiEnXipBXiQlXiRyIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_3e89a5da4f5e",
      "text": "你打算出多少枚陶幣？",
      "encoded_ascii": "^*F^$-^-C^!q^\"x^#<^$~^)R^+|^.V",
      "encoded_base64": "XipGXiQtXi1DXiFxXiJ4XiM8XiR+XilSXit8Xi5W",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_e1b204cf5156",
      "text": "  100",
      "encoded_ascii": "  100",
      "encoded_base64": "ICAxMDA=",
      "byte_length": 5
    },
    {
      "unit_id": "DLG_7df9d4b1becb",
      "text": "  500",
      "encoded_ascii": "  500",
      "encoded_base64": "ICA1MDA=",
      "byte_length": 5
    },
    {
      "unit_id": "DLG_ee94910762ad",
      "text": "  1,000",
      "encoded_ascii": "  1,000",
      "encoded_base64": "ICAxLDAwMA==",
      "byte_length": 7
    },
    {
      "unit_id": "DLG_959575e69673",
      "text": "說不定我真是小看了你。無論如何，我就給你個機會證明自己的狂言。",
      "encoded_ascii": "^-x^!)^#.^$%^-2^,X^#;^*Q^*D^*F^!\"^%}^1\\^#$^!L^*A^$%^*J^'A^*F^!V^%>^$r^-{^$c^'l^#I^&Z^&8^1Y^!\"",
      "encoded_base64": "Xi14XiEpXiMuXiQlXi0yXixYXiM7XipRXipEXipGXiEiXiV9XjFcXiMkXiFMXipBXiQlXipKXidBXipGXiFWXiU+XiRyXi17XiRjXidsXiNJXiZaXiY4XjFZXiEi",
      "byte_length": 93
    },
    {
      "unit_id": "DLG_e7dc47a28aba",
      "text": "我混跡賭場多年，一眼就能看出誰在虛張聲勢，而 ",
      "encoded_ascii": "^$%^%n^(`^=L^\"n^\"x^+~^*A^!%^&d^*J^'b^*Q^!q^-y^\"d^-g^,(^-W^\"&^*A^'W ",
      "encoded_base64": "XiQlXiVuXihgXj1MXiJuXiJ4Xit+XipBXiElXiZkXipKXidiXipRXiFxXi15XiJkXi1nXiwoXi1XXiImXipBXidXIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_aaf49aa3da5b",
      "text": "我現在就要拆穿你的西洋鏡！",
      "encoded_ascii": "^$%^&?^\"d^*J^(C^=o^')^*F^&Z^-l^75^)>^*W",
      "encoded_base64": "XiQlXiY/XiJkXipKXihDXj1vXicpXipGXiZaXi1sXjc1Xik+XipX",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_2c6faa9ffadb",
      "text": "衛兵！動手！",
      "encoded_ascii": "^(=^+,^*W^\"%^$+^*W",
      "encoded_base64": "Xig9XissXipXXiIlXiQrXipX",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_50c2fe30b684",
      "text": "把他們押下去！",
      "encoded_ascii": "^$1^!@^*{^7Z^!(^\"6^*W",
      "encoded_base64": "XiQxXiFAXip7XjdaXiEoXiI2XipX",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_571ccc49a55c",
      "text": "你竟敢侮辱我！",
      "encoded_ascii": "^*F^28^/m^9+^3`^$%^*W",
      "encoded_base64": "XipGXjI4Xi9tXjkrXjNgXiQlXipX",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_5672d062de65",
      "text": "為此，我會 ",
      "encoded_ascii": "^%{^%I^*A^$%^$r ",
      "encoded_base64": "XiV7XiVJXipBXiQlXiRyIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_3be162f58b94",
      "text": "給你們一個放手一搏的機會。",
      "encoded_ascii": "^'A^*F^*{^!%^!V^$P^$+^!%^,K^&Z^%>^$r^!\"",
      "encoded_base64": "XidBXipGXip7XiElXiFWXiRQXiQrXiElXixLXiZaXiU+XiRyXiEi",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_b2071a2776f1",
      "text": "饒你們一條狗命，至少在把你們押交給 ",
      "encoded_ascii": "^.M^*F^*{^!%^%.^-&^\"N^*A^'n^#<^\"d^$1^*F^*{^7Z^0P^'A ",
      "encoded_base64": "Xi5NXipGXip7XiElXiUuXi0mXiJOXipBXiduXiM8XiJkXiQxXipGXip7XjdaXjBQXidBIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_c9de3b641f1b",
      "text": "指揮官之前。",
      "encoded_ascii": "^$8^2\"^#-^!/^!z^!\"",
      "encoded_base64": "XiQ4XjIiXiMtXiEvXiF6XiEi",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_0c0c5e89919c",
      "text": " 要是你們能擊敗我的達戈蘭獸，你們就可以活著離開。",
      "encoded_ascii": " ^(C^,X^*F^*{^'b^$F^$R^$%^&Z^(z^*M^/G^&<^*A^*F^*{^*J^\"A^!B^%i^-a^)`^)F^!\"",
      "encoded_base64": "IF4oQ14sWF4qRl4qe14nYl4kRl4kUl4kJV4mWl4oel4qTV4vR14mPF4qQV4qRl4qe14qSl4iQV4hQl4laV4tYV4pYF4pRl4hIg==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_b37bf6ce4561",
      "text": "太棒了！我也能擁有專屬於自己的角鬥場了，就像 ",
      "encoded_ascii": "^+f^%1^*D^*W^$%^!1^'b^,M^$s^#8^#C^$^^'l^#I^&Z^(H^*,^\"n^*D^*A^*J^!` ",
      "encoded_base64": "XitmXiUxXipEXipXXiQlXiExXidiXixNXiRzXiM4XiNDXiReXidsXiNJXiZaXihIXiosXiJuXipEXipBXipKXiFgIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_0220dd77d9f3",
      "text": "給我與手下的部隊一點時間清理出一塊戰鬥場地， ",
      "encoded_ascii": "^'A^$%^'p^$+^!(^&Z^)#^)U^!%^*;^$f^)G^,u^&A^!q^!%^/Z^$(^*,^\"n^\"e^*A ",
      "encoded_base64": "XidBXiQlXidwXiQrXiEoXiZaXikjXilVXiElXio7XiRmXilHXix1XiZBXiFxXiElXi9aXiQoXiosXiJuXiJlXipBIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_5ea657c00fca",
      "text": "隨後便開始決鬥。",
      "encoded_ascii": "^)X^#b^!R^)F^+k^,o^*,^!\"",
      "encoded_base64": "XilYXiNiXiFSXilGXitrXixvXiosXiEi",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_fe6d86ffe292",
      "text": "你們這群居心叵測的黑心之徒！",
      "encoded_ascii": "^*F^*{^(s^'R^+w^#k^>}^%p^&Z^*:^#k^!/^#d^*W",
      "encoded_base64": "XipGXip7XihzXidSXit3XiNrXj59XiVwXiZaXio6XiNrXiEvXiNkXipX",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_2f302eddf8d3",
      "text": "你們一定會為此付出代價！",
      "encoded_ascii": "^*F^*{^!%^#.^$r^%{^%I^*u^!q^*v^+&^*W",
      "encoded_base64": "XipGXip7XiElXiMuXiRyXiV7XiVJXip1XiFxXip2XismXipX",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_273050d02b61",
      "text": "  我很抱歉。那純屬意外。",
      "encoded_ascii": "  ^$%^*K^,@^,h^!\"^)!^3\"^#C^#z^\"w^!\"",
      "encoded_base64": "ICBeJCVeKkteLEBeLGheISJeKSFeMyJeI0NeI3peIndeISI=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_6c958bdfa623",
      "text": "  不！該後悔的是你。納命來吧！",
      "encoded_ascii": "  ^!)^*W^(M^#b^6Y^&Z^,X^*F^!\"^';^\"N^!O^*I^*W",
      "encoded_base64": "ICBeISleKldeKE1eI2JeNlleJlpeLFheKkZeISJeJzteIk5eIU9eKkleKlc=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_0a4e02312e9a",
      "text": "若非因為那則預言，你們早就被逐出 ",
      "encoded_ascii": "^'x^)i^\"]^%{^)!^!x^.E^1Y^*A^*F^*{^,V^*J^(@^(r^!q ",
      "encoded_base64": "Xid4XilpXiJdXiV7XikhXiF4Xi5FXjFZXipBXipGXip7XixWXipKXihAXihyXiFxIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_9540586949f8",
      "text": "這個村子了。",
      "encoded_ascii": "^(s^!V^$z^#(^*D^!\"",
      "encoded_base64": "XihzXiFWXiR6XiMoXipEXiEi",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_bf93af30e9c6",
      "text": "下不為例！",
      "encoded_ascii": "^!(^!)^%{^9h^*W",
      "encoded_base64": "XiEoXiEpXiV7XjloXipX",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_9748a26d7db9",
      "text": "當然。我很樂意為你們效勞。",
      "encoded_ascii": "^&N^&\"^!\"^$%^*K^%8^#z^%{^*F^*{^$Q^/R^!\"",
      "encoded_base64": "XiZOXiYiXiEiXiQlXipLXiU4XiN6XiV7XipGXip7XiRRXi9SXiEi",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_220ae605424e",
      "text": "歡迎， ",
      "encoded_ascii": "^%F^(k^*A ",
      "encoded_base64": "XiVGXihrXipBIA==",
      "byte_length": 10
    },
    {
      "unit_id": "DLG_daf6a6dd49cb",
      "text": "我是加林神父，本村的牧師",
      "encoded_ascii": "^$%^,X^\"\"^/1^&w^5d^*A^$x^$z^&Z^/5^#M",
      "encoded_base64": "XiQlXixYXiIiXi8xXiZ3XjVkXipBXiR4XiR6XiZaXi81XiNN",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_c3f1f8a1dbb5",
      "text": "。我有什麼能為你們效勞的？",
      "encoded_ascii": "^!\"^$%^$s^!=^.T^'b^%{^*F^*{^$Q^/R^&Z^.V",
      "encoded_base64": "XiEiXiQlXiRzXiE9Xi5UXidiXiV7XipGXip7XiRRXi9SXiZaXi5W",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_e252e9de1bfa",
      "text": "  我是來把一袋樹髓交給你的。",
      "encoded_ascii": "  ^$%^,X^!O^$1^!%^(?^%;^*)^0P^'A^*F^&Z^!\"",
      "encoded_base64": "ICBeJCVeLFheIU9eJDFeISVeKD9eJTteKileMFBeJ0FeKkZeJlpeISI=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_e15d35f44692",
      "text": "  好吧，我會把萃取精華帶去給她。",
      "encoded_ascii": "  ^+i^*I^*A^$%^$r^$1^'}^\":^'7^3'^#N^\"6^'A^+h^!\"",
      "encoded_base64": "ICBeK2leKkleKkFeJCVeJHJeJDFeJ31eIjpeJzdeMydeI05eIjZeJ0FeK2heISI=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_ad31e7009cac",
      "text": "  我是來向你拿取萃取精華的。",
      "encoded_ascii": "  ^$%^,X^!O^+?^*F^,G^\":^'}^\":^'7^3'^&Z^!\"",
      "encoded_base64": "ICBeJCVeLFheIU9eKz9eKkZeLEdeIjpeJ31eIjpeJzdeMydeJlpeISI=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_eee04ef2fce2",
      "text": "  我該如何調製萃取精華？",
      "encoded_ascii": "  ^$%^(M^#$^!L^(Q^(B^'}^\":^'7^3'^.V",
      "encoded_base64": "ICBeJCVeKE1eIyReIUxeKFFeKEJeJ31eIjpeJzdeMydeLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_620a88846db3",
      "text": "  你希望我把萃取精華送到哪裡？",
      "encoded_ascii": "  ^*F^+{^,]^$%^$1^'}^\":^'7^3'^./^!u^+I^-j^.V",
      "encoded_base64": "ICBeKkZeK3teLF1eJCVeJDFeJ31eIjpeJzdeMydeLi9eIXVeK0leLWpeLlY=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_3c66839d68a0",
      "text": "  我想向您請教一些指引，神父。",
      "encoded_ascii": "  ^$%^,1^+?^4:^*S^,R^!%^!8^$8^#Z^*A^&w^5d^!\"",
      "encoded_base64": "ICBeJCVeLDFeKz9eNDpeKlNeLFJeISVeITheJDheI1peKkFeJndeNWReISI=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_eb78f2061260",
      "text": "  靠牆擺著的那套器具是什麼？",
      "encoded_ascii": "  ^.C^&0^1@^-a^&Z^)!^#!^\"V^!k^,X^!=^.T^.V",
      "encoded_base64": "ICBeLkNeJjBeMUBeLWFeJlpeKSFeIyFeIlZeIWteLFheIT1eLlReLlY=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_a8ef3efa7246",
      "text": "  跟我說說妳自己的事吧。",
      "encoded_ascii": "  ^.+^$%^-x^-x^7(^'l^#I^&Z^*r^*I^!\"",
      "encoded_base64": "ICBeLiteJCVeLXheLXheNyheJ2xeI0leJlpeKnJeKkleISI=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_069f9eec863d",
      "text": "  您崇奉的是哪一個元素領域？",
      "encoded_ascii": "  ^4:^13^1+^&Z^,X^+I^!%^!V^!a^'=^)s^\"k^.V",
      "encoded_base64": "ICBeNDpeMTNeMSteJlpeLFheK0leISVeIVZeIWFeJz1eKXNeImteLlY=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_72593eb1e082",
      "text": "  是您讓水井的泉水湧流不息的嗎？",
      "encoded_ascii": "  ^,X^4:^-}^%V^!7^&Z^%a^%V^0m^%j^!)^#w^&Z^+X^.V",
      "encoded_base64": "ICBeLFheNDpeLX1eJVZeITdeJlpeJWFeJVZeMG1eJWpeISleI3deJlpeK1heLlY=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_03c0adbbafc7",
      "text": "  您真有那麼忙碌嗎？這個村子看起來並不大。",
      "encoded_ascii": "  ^4:^-2^$s^)!^.T^,+^<y^+X^.V^(s^!V^$z^#(^*Q^.(^!O^!+^!)^\"z^!\"",
      "encoded_base64": "ICBeNDpeLTJeJHNeKSFeLlReLCtePHleK1heLlZeKHNeIVZeJHpeIyheKlFeLiheIU9eISteISleInpeISI=",
      "byte_length": 62
    },
    {
      "unit_id": "DLG_05b98868aa25",
      "text": "  您在提奎茲爾住了多久？",
      "encoded_ascii": "  ^4:^\"d^$A^5B^/D^&/^*z^*D^\"x^!.^.V",
      "encoded_base64": "ICBeNDpeImReJEFeNUJeL0ReJi9eKnpeKkReInheIS5eLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_88acdfac5d48",
      "text": "能與各位相會真是榮幸， ",
      "encoded_ascii": "^'b^'p^+>^!J^&a^$r^-2^,X^,e^15^*A ",
      "encoded_base64": "XidiXidwXis+XiFKXiZhXiRyXi0yXixYXixlXjE1XipBIA==",
      "byte_length": 34
    },
    {
      "unit_id": "DLG_b6e10ad5a613",
      "text": "。預言者曾多次提及你們的事蹟。",
      "encoded_ascii": "^!\"^.E^1Y^'V^.j^\"x^%D^$A^\"7^*F^*{^&Z^*r^0B^!\"",
      "encoded_base64": "XiEiXi5FXjFZXidWXi5qXiJ4XiVEXiRBXiI3XipGXip7XiZaXipyXjBCXiEi",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_38cc0e02b841",
      "text": "噢，太好了。我一直在苦苦等候它。我在蓋德隆村的朋友莉娜拉， ",
      "encoded_ascii": "^+]^*A^+f^+i^*D^!\"^$%^!%^&`^\"d^.t^.t^'-^*|^+o^!\"^$%^\"d^-d^#j^)T^$z^&Z^,[^\"8^'{^/*^$6^*A ",
      "encoded_base64": "XitdXipBXitmXitpXipEXiEiXiQlXiElXiZgXiJkXi50Xi50XictXip8XitvXiEiXiQlXiJkXi1kXiNqXilUXiR6XiZaXixbXiI4Xid7Xi8qXiQ2XipBIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_a6f73e8ebee8",
      "text": "急需我用這種樹髓提煉出的萃取精華。你們願意幫我 ",
      "encoded_ascii": "^3p^)e^$%^&H^(s^'$^%;^*)^$A^9\"^!q^&Z^'}^\":^'7^3'^!\"^*F^*{^.H^#z^+}^$% ",
      "encoded_base64": "XjNwXillXiQlXiZIXihzXickXiU7XiopXiRBXjkiXiFxXiZaXid9XiI6Xic3XjMnXiEiXipGXip7Xi5IXiN6Xit9XiQlIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_2ad70988a139",
      "text": "把它送去給她嗎？",
      "encoded_ascii": "^$1^+o^./^\"6^'A^+h^+X^.V",
      "encoded_base64": "XiQxXitvXi4vXiI2XidBXitoXitYXi5W",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_a891969c23d8",
      "text": "  我很樂意效勞。",
      "encoded_ascii": "  ^$%^*K^%8^#z^$Q^/R^!\"",
      "encoded_base64": "ICBeJCVeKkteJTheI3peJFFeL1JeISI=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_69360fc6991a",
      "text": "  我只是拿錢辦事，把東西交給你就好。",
      "encoded_ascii": "  ^$%^\"?^,X^,G^.<^2L^*r^*A^$1^,`^-l^0P^'A^*F^*J^+i^!\"",
      "encoded_base64": "ICBeJCVeIj9eLFheLEdeLjxeMkxeKnJeKkFeJDFeLGBeLWxeMFBeJ0FeKkZeKkpeK2leISI=",
      "byte_length": 53
    },
    {
      "unit_id": "DLG_78109b8bc490",
      "text": "  不，我要自己留著這袋樹髓。",
      "encoded_ascii": "  ^!)^*A^$%^(C^'l^#I^-+^-a^(s^(?^%;^*)^!\"",
      "encoded_base64": "ICBeISleKkFeJCVeKENeJ2xeI0leLSteLWFeKHNeKD9eJTteKileISI=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_10eee31c0caf",
      "text": "好吧。那我自己來想辦法處理。",
      "encoded_ascii": "^+i^*I^!\"^)!^$%^'l^#I^!O^,1^2L^%b^(,^&A^!\"",
      "encoded_base64": "XitpXipJXiEiXikhXiQlXidsXiNJXiFPXiwxXjJMXiViXigsXiZBXiEi",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_a5c49d122f1d",
      "text": "啊，一定是莉娜拉派你們來的。",
      "encoded_ascii": "^+Q^*A^!%^#.^,X^'{^/*^$6^.n^*F^*{^!O^&Z^!\"",
      "encoded_base64": "XitRXipBXiElXiMuXixYXid7Xi8qXiQ2Xi5uXipGXip7XiFPXiZaXiEi",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_e2617f6d7fc1",
      "text": "它能調製出一種具有極高療癒復原價值的萃取精華。",
      "encoded_ascii": "^+o^'b^(Q^(B^!q^!%^'$^!k^$s^1D^*+^&U^&V^#g^\"5^+&^!Z^&Z^'}^\":^'7^3'^!\"",
      "encoded_base64": "XitvXidiXihRXihCXiFxXiElXickXiFrXiRzXjFEXiorXiZVXiZWXiNnXiI1XismXiFaXiZaXid9XiI6Xic3XjMnXiEi",
      "byte_length": 69
    },
    {
      "unit_id": "DLG_c2e55756db0d",
      "text": "你們想聊些什麼？",
      "encoded_ascii": "^*F^*{^,1^-U^!8^!=^.T^.V",
      "encoded_base64": "XipGXip7XiwxXi1VXiE4XiE9Xi5UXi5W",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_9c6e0e44114d",
      "text": "  關於那位預言者，你瞭解多少？",
      "encoded_ascii": "  ^.>^$^^)!^!J^.E^1Y^'V^*A^*F^<p^(I^\"x^#<^.V",
      "encoded_base64": "ICBeLj5eJF5eKSFeIUpeLkVeMVleJ1ZeKkFeKkZePHBeKEleInheIzxeLlY=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_5726bde497e2",
      "text": "  跟我說說提奎茲爾的領袖吧。",
      "encoded_ascii": "  ^.+^$%^-x^-x^$A^5B^/D^&/^&Z^)s^7G^*I^!\"",
      "encoded_base64": "ICBeLiteJCVeLXheLXheJEFeNUJeL0ReJi9eJlpeKXNeN0deKkleISI=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_8fe7cf334150",
      "text": "  您對那位副官有何看法？",
      "encoded_ascii": "  ^4:^#:^)!^!J^52^#-^$s^!L^*Q^%b^.V",
      "encoded_base64": "ICBeNDpeIzpeKSFeIUpeNTJeIy1eJHNeIUxeKlFeJWJeLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_f6fe8183aa9a",
      "text": "沒什麼好說的。我只是一名卑微的牧師，竭盡所能 ",
      "encoded_ascii": "^%\\^!=^.T^+i^-x^&Z^!\"^$%^\"?^,X^!%^\"F^\".^#i^&Z^/5^#M^*A^29^-1^$)^'b ",
      "encoded_base64": "XiVcXiE9Xi5UXitpXi14XiZaXiEiXiQlXiI/XixYXiElXiJGXiIuXiNpXiZaXi81XiNNXipBXjI5Xi0xXiQpXidiIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_43fa685561d2",
      "text": "守護這個村莊所有人的健康。",
      "encoded_ascii": "^#+^(T^(s^!V^$z^6l^$)^$s^!<^&Z^<M^5N^!\"",
      "encoded_base64": "XiMrXihUXihzXiFWXiR6XjZsXiQpXiRzXiE8XiZaXjxNXjVOXiEi",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_fc3cc7f3e01d",
      "text": "我的職責從無停歇之時。前陣子一場沙塵暴席捲而過， ",
      "encoded_ascii": "^$%^&Z^'\\^0>^#f^%}^+!^%E^!/^$f^!\"^!z^)P^#(^!%^\"n^%]^\"p^$m^0X^0c^'W^(x^*A ",
      "encoded_base64": "XiQlXiZaXidcXjA+XiNmXiV9XishXiVFXiEvXiRmXiEiXiF6XilQXiMoXiElXiJuXiVdXiJwXiRtXjBYXjBjXidXXih4XipBIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_4eae35244be8",
      "text": "造成數十人遭風沙刮傷創痛。還有人遭到了沙丘收割者的突襲——  ",
      "encoded_ascii": "^(v^$$^$V^*Y^!<^(}^)y^%]^;r^!^^!{^-.^!\"^.7^$s^!<^(}^!u^*D^%]^5(^$M^+1^'V^&Z^'*^08^*n^*n  ",
      "encoded_base64": "Xih2XiQkXiRWXipZXiE8Xih9Xil5XiVdXjtyXiFeXiF7Xi0uXiEiXi43XiRzXiE8Xih9XiF1XipEXiVdXjUoXiRNXisxXidWXiZaXicqXjA4XipuXipuICA=",
      "byte_length": 89
    },
    {
      "unit_id": "DLG_4a79bfe5c0e2",
      "text": "病患傷者絡繹不絕。",
      "encoded_ascii": "^&R^;Q^!^^'V^-J^?F^!)^-I^!\"",
      "encoded_base64": "XiZSXjtRXiFeXidWXi1KXj9GXiEpXi1JXiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_d9ec349b6f11",
      "text": "願健康與長壽伴隨你，朋友。",
      "encoded_ascii": "^.H^<M^5N^'p^)C^?=^1h^)X^*F^*A^,[^\"8^!\"",
      "encoded_base64": "Xi5IXjxNXjVOXidwXilDXj89XjFoXilYXipGXipBXixbXiI4XiEi",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_5fbe9a29ee8d",
      "text": "多謝你們。 ",
      "encoded_ascii": "^\"x^-z^*F^*{^!\" ",
      "encoded_base64": "XiJ4Xi16XipGXip7XiEiIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_df35b0197cd2",
      "text": "將樹髓與靠牆擺放的藥劑混合攪拌，即可製成 ",
      "encoded_ascii": "^#7^%;^*)^'p^.C^&0^1@^$P^&Z^()^!}^%n^\"C^*c^*`^*A^\"1^\"A^(B^$$ ",
      "encoded_base64": "XiM3XiU7XiopXidwXi5DXiYwXjFAXiRQXiZaXigpXiF9XiVuXiJDXipjXipgXipBXiIxXiJBXihCXiQkIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_65721f728d0d",
      "text": "萃取精華。調製完成後，你們就可以把精華帶去給莉娜拉。",
      "encoded_ascii": "^'}^\":^'7^3'^!\"^(Q^(B^#,^$$^#b^*A^*F^*{^*J^\"A^!B^$1^'7^3'^#N^\"6^'A^'{^/*^$6^!\"",
      "encoded_base64": "Xid9XiI6Xic3XjMnXiEiXihRXihCXiMsXiQkXiNiXipBXipGXip7XipKXiJBXiFCXiQxXic3XjMnXiNOXiI2XidBXid7Xi8qXiQ2XiEi",
      "byte_length": 78
    },
    {
      "unit_id": "DLG_e7c303126f66",
      "text": " 她是我在蓋德隆村的同僚，那座村莊就在這裡的西北方。",
      "encoded_ascii": " ^+h^,X^$%^\"d^-d^#j^)T^$z^&Z^\"E^?;^*A^)!^/_^$z^6l^*J^\"d^(s^-j^&Z^-l^+6^$]^!\"",
      "encoded_base64": "IF4raF4sWF4kJV4iZF4tZF4jal4pVF4kel4mWl4iRV4/O14qQV4pIV4vX14kel42bF4qSl4iZF4oc14tal4mWl4tbF4rNl4kXV4hIg==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_6e772246b0c5",
      "text": "你們可以在蓋德隆村找到莉娜拉，那座村莊就在這裡的西北方。把 ",
      "encoded_ascii": "^*F^*{^\"A^!B^\"d^-d^#j^)T^$z^$/^!u^'{^/*^$6^*A^)!^/_^$z^6l^*J^\"d^(s^-j^&Z^-l^+6^$]^!\"^$1 ",
      "encoded_base64": "XipGXip7XiJBXiFCXiJkXi1kXiNqXilUXiR6XiQvXiF1Xid7Xi8qXiQ2XipBXikhXi9fXiR6XjZsXipKXiJkXihzXi1qXiZaXi1sXis2XiRdXiEiXiQxIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_b0be8f092d07",
      "text": "萃取精華交給她即可。",
      "encoded_ascii": "^'}^\":^'7^3'^0P^'A^+h^\"1^\"A^!\"",
      "encoded_base64": "Xid9XiI6Xic3XjMnXjBQXidBXitoXiIxXiJBXiEi",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_1e2a223b6967",
      "text": "我只是一介平凡的牧師，無法強求你們，但我懇請你們重新考慮。",
      "encoded_ascii": "^$%^\"?^,X^!%^!>^0Y^+-^&Z^/5^#M^*A^%}^%b^#]^,n^*F^*{^*A^!I^$%^3t^*S^*F^*{^))^$\\^-R^19^!\"",
      "encoded_base64": "XiQlXiI/XixYXiElXiE+XjBZXistXiZaXi81XiNNXipBXiV9XiViXiNdXixuXipGXip7XipBXiFJXiQlXjN0XipTXipGXip7XikpXiRcXi1SXjE5XiEi",
      "byte_length": 87
    },
    {
      "unit_id": "DLG_0cb97d954153",
      "text": " 然而，我手頭上缺少用來調製精華的拉尼克樹髓。 ",
      "encoded_ascii": " ^&\"^'W^*A^$%^$+^)t^!'^7e^#<^&H^!O^(Q^(B^'7^3'^&Z^$6^#>^!d^%;^*)^!\" ",
      "encoded_base64": "IF4mIl4nV14qQV4kJV4kK14pdF4hJ143ZV4jPF4mSF4hT14oUV4oQl4nN14zJ14mWl4kNl4jPl4hZF4lO14qKV4hIiA=",
      "byte_length": 68
    },
    {
      "unit_id": "DLG_edca012f7450",
      "text": "你們願意跑一趟我的供貨商那裡，幫我取回我訂購的那批貨物嗎？",
      "encoded_ascii": "^*F^*{^.H^#z^(_^!%^8)^$%^&Z^!P^.w^1'^)!^-j^*A^+}^$%^\":^\"\\^$%^3^^63^&Z^)!^2i^.w^&4^+X^.V",
      "encoded_base64": "XipGXip7Xi5IXiN6XihfXiElXjgpXiQlXiZaXiFQXi53XjEnXikhXi1qXipBXit9XiQlXiI6XiJcXiQlXjNeXjYzXiZaXikhXjJpXi53XiY0XitYXi5W",
      "byte_length": 87
    },
    {
      "unit_id": "DLG_fef3651663c7",
      "text": "  好的，我很樂意幫您的忙。",
      "encoded_ascii": "  ^+i^&Z^*A^$%^*K^%8^#z^+}^4:^&Z^,+^!\"",
      "encoded_base64": "ICBeK2leJlpeKkFeJCVeKkteJTheI3peK31eNDpeJlpeLCteISI=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_e89dbdde2d07",
      "text": "  不行，我還有更重要的事情要做。",
      "encoded_ascii": "  ^!)^(;^*A^$%^.7^$s^$o^))^(C^&Z^*r^,0^(C^*~^!\"",
      "encoded_base64": "ICBeISleKDteKkFeJCVeLjdeJHNeJG9eKSleKENeJlpeKnJeLDBeKENeKn5eISI=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_405be5cd4713",
      "text": "水元素領域乃是我虔誠信奉的根基。 ",
      "encoded_ascii": "^%V^!a^'=^)s^\"k^/M^,X^$%^=`^2E^!U^1+^&Z^%)^/'^!\" ",
      "encoded_base64": "XiVWXiFhXic9XilzXiJrXi9NXixYXiQlXj1gXjJFXiFVXjErXiZaXiUpXi8nXiEiIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_53be3ac54bcd",
      "text": "它賦予生命的崇高恩賜是一大福祉，使我能夠 ",
      "encoded_ascii": "^+o^(Y^!4^&F^\"N^&Z^13^*+^#v^.#^,X^!%^\"z^&z^?D^*A^!N^$%^'b^+d ",
      "encoded_base64": "XitvXihZXiE0XiZGXiJOXiZaXjEzXiorXiN2Xi4jXixYXiElXiJ6XiZ6Xj9EXipBXiFOXiQlXidiXitkIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_3e458eff0a11",
      "text": "竭盡所能為提奎茲爾效勞。",
      "encoded_ascii": "^29^-1^$)^'b^%{^$A^5B^/D^&/^$Q^/R^!\"",
      "encoded_base64": "XjI5Xi0xXiQpXidiXiV7XiRBXjVCXi9EXiYvXiRRXi9SXiEi",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_3d4240dd0c39",
      "text": "這要多虧了水井主管多米尼。他對 ",
      "encoded_ascii": "^(s^(C^\"x^9N^*D^%V^!7^!-^-D^\"x^'4^#>^!\"^!@^#: ",
      "encoded_base64": "XihzXihDXiJ4XjlOXipEXiVWXiE3XiEtXi1EXiJ4Xic0XiM+XiEiXiFAXiM6IA==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_5ab7051476c6",
      "text": "水元素有著極高的親和力，要是他不是那麼沉迷於 ",
      "encoded_ascii": "^%V^!a^'=^$s^-a^1D^*+^&Z^(F^\"O^!~^*A^(C^,X^!@^!)^,X^)!^.T^%Z^(n^$^ ",
      "encoded_base64": "XiVWXiFhXic9XiRzXi1hXjFEXiorXiZaXihGXiJPXiF+XipBXihDXixYXiFAXiEpXixYXikhXi5UXiVaXihuXiReIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_657eec2d3392",
      "text": "各種機械裝置的話，一定會成為一名強大的牧師。",
      "encoded_ascii": "^+>^'$^%>^?@^(A^'Q^&Z^-v^*A^!%^#.^$r^$$^%{^!%^\"F^#]^\"z^&Z^/5^#M^!\"",
      "encoded_base64": "Xis+XickXiU+Xj9AXihBXidRXiZaXi12XipBXiElXiMuXiRyXiQkXiV7XiElXiJGXiNdXiJ6XiZaXi81XiNNXiEi",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_57b208055cda",
      "text": "早在多年前查爾建立這座村子時我就在此了。事實上，正是由我 ",
      "encoded_ascii": "^,V^\"d^\"x^+~^!z^%&^&/^,'^0'^(s^/_^$z^#(^$f^$%^*J^\"d^%I^*D^!\"^*r^#3^!'^*A^%H^,X^&I^$% ",
      "encoded_base64": "XixWXiJkXiJ4Xit+XiF6XiUmXiYvXiwnXjAnXihzXi9fXiR6XiMoXiRmXiQlXipKXiJkXiVJXipEXiEiXipyXiMzXiEnXipBXiVIXixYXiZJXiQlIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_681f149c76c0",
      "text": "治癒了他在逃離奴役魔爪時所受的重創，儘管他身上 ",
      "encoded_ascii": "^%_^&V^*D^!@^\"d^(p^)`^##^17^*0^&.^$f^$)^\";^&Z^))^!{^*A^+(^-D^!@^(c^!' ",
      "encoded_base64": "XiVfXiZWXipEXiFAXiJkXihwXilgXiMjXjE3XiowXiYuXiRmXiQpXiI7XiZaXikpXiF7XipBXisoXi1EXiFAXihjXiEnIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_8c19941442a1",
      "text": "至今依然留著那些可怖的傷痕。",
      "encoded_ascii": "^'n^*E^!Q^&\"^-+^-a^)!^!8^\"A^#p^&Z^!^^3v^!\"",
      "encoded_base64": "XiduXipFXiFRXiYiXi0rXi1hXikhXiE4XiJBXiNwXiZaXiFeXjN2XiEi",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_6385fad76748",
      "text": "他已成為我摯交的好友，我可以告訴你們，他 ",
      "encoded_ascii": "^!@^#J^$$^%{^$%^2#^0P^&Z^+i^\"8^*A^$%^\"A^!B^+B^-t^*F^*{^*A^!@ ",
      "encoded_base64": "XiFAXiNKXiQkXiV7XiQlXjIjXjBQXiZaXitpXiI4XipBXiQlXiJBXiFCXitCXi10XipGXip7XipBXiFAIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_b261e7c1bf5b",
      "text": "是一位力量無比強大的先知。別被他古怪的舉止舉動所驚擾， ",
      "encoded_ascii": "^,X^!%^!J^!~^)*^%}^,m^#]^\"z^&Z^!b^&h^!\"^*H^(@^!@^\"=^#s^&Z^01^%G^01^\"%^$)^.Q^$K^*A ",
      "encoded_base64": "XixYXiElXiFKXiF+XikqXiV9XixtXiNdXiJ6XiZaXiFiXiZoXiEiXipIXihAXiFAXiI9XiNzXiZaXjAxXiVHXjAxXiIlXiQpXi5RXiRLXipBIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_c3a904ff4493",
      "text": "因為許多至理真相往往就交織在他看似胡言亂語的狂囈之中。",
      "encoded_ascii": "^\"]^%{^-s^\"x^'n^&A^-2^&a^,)^,)^*J^0P^3z^\"d^!@^*Q^!H^3}^1Y^!3^0:^&Z^&8^5<^!/^!,^!\"",
      "encoded_base64": "XiJdXiV7Xi1zXiJ4XiduXiZBXi0yXiZhXiwpXiwpXipKXjBQXjN6XiJkXiFAXipRXiFIXjN9XjFZXiEzXjA6XiZaXiY4XjU8XiEvXiEsXiEi",
      "byte_length": 81
    },
    {
      "unit_id": "DLG_d2c86a3468e1",
      "text": "查爾就像大多數穆爾人一樣，性情質樸單純",
      "encoded_ascii": "^%&^&/^*J^!`^\"z^\"x^$V^8K^&/^!<^!%^,f^*A^#r^,0^(Z^72^2a^3\"",
      "encoded_base64": "XiUmXiYvXipKXiFgXiJ6XiJ4XiRWXjhLXiYvXiE8XiElXixmXipBXiNyXiwwXihaXjcyXjJhXjMi",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_454b0ed139a6",
      "text": " ——我絕無冒犯之意， ",
      "encoded_ascii": " ^*n^*n^$%^-I^%}^/P^-%^!/^#z^*A ",
      "encoded_base64": "IF4qbl4qbl4kJV4tSV4lfV4vUF4tJV4hL14jel4qQSA=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_467fe5a430b6",
      "text": "。他自幼便被當作聖堂武士的貼身侍衛來培養，他所做的一切 ",
      "encoded_ascii": "^!\"^!@^'l^9@^!R^(@^&N^!M^'Z^42^%J^+a^&Z^<G^(c^0}^(=^!O^9?^.I^*A^!@^$)^*~^&Z^!%^+. ",
      "encoded_base64": "XiEiXiFAXidsXjlAXiFSXihAXiZOXiFNXidaXjQyXiVKXithXiZaXjxHXihjXjB9Xig9XiFPXjk/Xi5JXipBXiFAXiQpXip+XiZaXiElXisuIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_65420a67ced2",
      "text": "出發點全都是為了守護他人。",
      "encoded_ascii": "^!q^&W^*;^!h^)$^,X^%{^*D^#+^(T^!@^!<^!\"",
      "encoded_base64": "XiFxXiZXXio7XiFoXikkXixYXiV7XipEXiMrXihUXiFAXiE8XiEi",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_09d47d3c03e7",
      "text": "  查爾是位出色的領袖嗎？",
      "encoded_ascii": "  ^%&^&/^,X^!J^!q^'s^&Z^)s^7G^+X^.V",
      "encoded_base64": "ICBeJSZeJi9eLFheIUpeIXFeJ3NeJlpeKXNeN0deK1heLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_28fc646eb47d",
      "text": "  他的守護精神對他有何助益？",
      "encoded_ascii": "  ^!@^&Z^#+^(T^'7^&w^#:^!@^$s^!L^\"#^3R^.V",
      "encoded_base64": "ICBeIUBeJlpeIyteKFReJzdeJndeIzpeIUBeJHNeIUxeIiNeM1JeLlY=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_a07145c9781e",
      "text": "  那個孩子後來怎麼樣了？",
      "encoded_ascii": "  ^)!^!V^+m^#(^#b^!O^,,^.T^,f^*D^.V",
      "encoded_base64": "ICBeKSFeIVZeK21eIyheI2JeIU9eLCxeLlReLGZeKkReLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_b14200e97d7d",
      "text": "  卡圖拉就是你所說的那個孩子嗎？",
      "encoded_ascii": "  ^\"0^\"b^$6^*J^,X^*F^$)^-x^&Z^)!^!V^+m^#(^+X^.V",
      "encoded_base64": "ICBeIjBeImJeJDZeKkpeLFheKkZeJCleLXheJlpeKSFeIVZeK21eIyheK1heLlY=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_18b6e78a4d17",
      "text": "  那給他招致了什麼麻煩？",
      "encoded_ascii": "  ^)!^'A^!@^,D^'o^*D^!=^.T^*6^-!^.V",
      "encoded_base64": "ICBeKSFeJ0FeIUBeLEReJ29eKkReIT1eLlReKjZeLSFeLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_4af1a4e2ccb8",
      "text": "  跟我說說當年役使查爾的那位聖堂武士吧。",
      "encoded_ascii": "  ^.+^$%^-x^-x^&N^+~^17^!N^%&^&/^&Z^)!^!J^'Z^42^%J^+a^*I^!\"",
      "encoded_base64": "ICBeLiteJCVeLXheLXheJk5eK35eMTdeIU5eJSZeJi9eJlpeKSFeIUpeJ1peNDJeJUpeK2FeKkleISI=",
      "byte_length": 59
    },
    {
      "unit_id": "DLG_d17e9dd17a53",
      "text": "我向來不問政事，因此與奎林甚少往來。 ",
      "encoded_ascii": "^$%^+?^!O^!)^*Z^,P^*r^*A^\"]^%I^'p^5B^/1^/|^#<^,)^!O^!\" ",
      "encoded_base64": "XiQlXis/XiFPXiEpXipaXixQXipyXipBXiJdXiVJXidwXjVCXi8xXi98XiM8XiwpXiFPXiEiIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_7d23416763bc",
      "text": "提奎茲爾能有今日的繁榮全仰賴他的才幹。不過他也是個極具野心的 ",
      "encoded_ascii": "^$A^5B^/D^&/^'b^$s^*E^$a^&Z^-N^,e^!h^4,^0t^!@^&Z^$,^,!^!\"^!)^(x^!@^!1^,X^!V^1D^!k^.:^#k^&Z ",
      "encoded_base64": "XiRBXjVCXi9EXiYvXidiXiRzXipFXiRhXiZaXi1OXixlXiFoXjQsXjB0XiFAXiZaXiQsXiwhXiEiXiEpXih4XiFAXiExXixYXiFWXjFEXiFrXi46XiNrXiZaIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_c211fb163791",
      "text": "人物，切莫輕易開罪他。",
      "encoded_ascii": "^!<^&4^*A^+.^/F^(g^,W^)F^5x^!@^!\"",
      "encoded_base64": "XiE8XiY0XipBXisuXi9GXihnXixXXilGXjV4XiFAXiEi",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_49cb30a3494f",
      "text": "你們真是太仁慈了！我的供貨商諾塔庫通常都在 ",
      "encoded_ascii": "^*F^*{^-2^,X^+f^37^3H^*D^*W^$%^&Z^!P^.w^1'^7k^\"o^,#^(t^#O^)$^\"d ",
      "encoded_base64": "XipGXip7Xi0yXixYXitmXjM3XjNIXipEXipXXiQlXiZaXiFQXi53XjEnXjdrXiJvXiwjXih0XiNPXikkXiJkIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_c37d09d7dcec",
      "text": "提奎茲爾東南方那片黃沙泛紅的赤土荒原活動。他會 ",
      "encoded_ascii": "^$A^5B^/D^&/^,`^\"/^$]^)!^&1^*7^%]^0i^3!^&Z^2H^\"c^1W^\"5^%i^\"%^!\"^!@^$r ",
      "encoded_base64": "XiRBXjVCXi9EXiYvXixgXiIvXiRdXikhXiYxXio3XiVdXjBpXjMhXiZaXjJIXiJjXjFXXiI1XiVpXiIlXiEiXiFAXiRyIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_e5317d747237",
      "text": "把我們所需的拉尼克樹髓交給你們。",
      "encoded_ascii": "^$1^$%^*{^$)^)e^&Z^$6^#>^!d^%;^*)^0P^'A^*F^*{^!\"",
      "encoded_base64": "XiQxXiQlXip7XiQpXillXiZaXiQ2XiM+XiFkXiU7XiopXjBQXidBXipGXip7XiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_20926e872cea",
      "text": "我明白。眼下正是多事之秋，荒原上處處危機四伏。",
      "encoded_ascii": "^$%^$c^&X^!\"^&d^!(^%H^,X^\"x^*r^!/^=^^*A^1W^\"5^!'^(,^(,^2\\^%>^\"[^3c^!\"",
      "encoded_base64": "XiQlXiRjXiZYXiEiXiZkXiEoXiVIXixYXiJ4XipyXiEvXj1eXipBXjFXXiI1XiEnXigsXigsXjJcXiU+XiJbXjNjXiEi",
      "byte_length": 69
    },
    {
      "unit_id": "DLG_de5b1e37330a",
      "text": "很多次查爾純粹憑藉著鋼鐵般的毅力與過人的勇氣，在寡不敵眾的劣勢下 ",
      "encoded_ascii": "^*K^\"x^%D^%&^&/^3\"^5r^,5^04^-a^)2^)?^'r^&Z^%O^!~^'p^(x^!<^&Z^\"$^%U^*A^\"d^8x^!)^$U^&e^&Z^+2^\"&^!( ",
      "encoded_base64": "XipLXiJ4XiVEXiUmXiYvXjMiXjVyXiw1XjA0Xi1hXikyXik/XidyXiZaXiVPXiF+XidwXih4XiE8XiZaXiIkXiVVXipBXiJkXjh4XiEpXiRVXiZlXiZaXisyXiImXiEoIA==",
      "byte_length": 97
    },
    {
      "unit_id": "DLG_5ac4de4e7f32",
      "text": "力挽狂瀾，保衛提奎茲爾免遭劫難。因此，提奎茲爾會成為反抗德拉吉的 ",
      "encoded_ascii": "^!~^0b^&8^?B^*A^!T^(=^$A^5B^/D^&/^!e^(}^1l^)a^!\"^\"]^%I^*A^$A^5B^/D^&/^$r^$$^%{^\"9^$4^#j^$6^\"D^&Z ",
      "encoded_base64": "XiF+XjBiXiY4Xj9CXipBXiFUXig9XiRBXjVCXi9EXiYvXiFlXih9XjFsXilhXiEiXiJdXiVJXipBXiRBXjVCXi9EXiYvXiRyXiQkXiV7XiI5XiQ0XiNqXiQ2XiJEXiZaIA==",
      "byte_length": 97
    },
    {
      "unit_id": "DLG_ed1e3177722f",
      "text": "反抗要塞樞紐， ",
      "encoded_ascii": "^\"9^$4^(C^/(^8_^?E^*A ",
      "encoded_base64": "XiI5XiQ0XihDXi8oXjhfXj9FXipBIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_9b2c613d7d39",
      "text": "可謂毫不令人意外。",
      "encoded_ascii": "^\"A^0s^/t^!)^*w^!<^#z^\"w^!\"",
      "encoded_base64": "XiJBXjBzXi90XiEpXip3XiE8XiN6XiJ3XiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_188e26fc753e",
      "text": "那是他最強大的優點，然而過於單純執著的性格有時也會讓他目光短淺。 ",
      "encoded_ascii": "^)!^,X^!@^$q^#]^\"z^&Z^+)^*;^*A^&\"^'W^(x^$^^2a^3\"^3?^-a^&Z^#r^%*^$s^$f^!1^$r^-}^!@^&^^!c^&i^:K^!\" ",
      "encoded_base64": "XikhXixYXiFAXiRxXiNdXiJ6XiZaXispXio7XipBXiYiXidXXih4XiReXjJhXjMiXjM/Xi1hXiZaXiNyXiUqXiRzXiRmXiExXiRyXi19XiFAXiZeXiFjXiZpXjpLXiEiIA==",
      "byte_length": 97
    },
    {
      "unit_id": "DLG_590a4c1f4965",
      "text": "這曾不止一次給他招致過麻煩。",
      "encoded_ascii": "^(s^.j^!)^%G^!%^%D^'A^!@^,D^'o^(x^*6^-!^!\"",
      "encoded_base64": "XihzXi5qXiEpXiVHXiElXiVEXidBXiFAXixEXidvXih4Xio2Xi0hXiEi",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_41d74dd6b25d",
      "text": "我已經記不得她的名字了，畢竟查爾極不願提及她。 ",
      "encoded_ascii": "^$%^#J^'D^(K^!)^#e^+h^&Z^\"F^#)^*D^*A^;k^28^%&^&/^1D^!)^.H^$A^\"7^+h^!\" ",
      "encoded_base64": "XiQlXiNKXidEXihLXiEpXiNlXitoXiZaXiJGXiMpXipEXipBXjtrXjI4XiUmXiYvXjFEXiEpXi5IXiRBXiI3XitoXiEiIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_835b2194ed3f",
      "text": "顯然，她曾是尼貝奈城邦暗影之王的親信近臣， ",
      "encoded_ascii": "^4&^&\"^*A^+h^.j^,X^#>^/I^\"~^+_^1a^$k^#a^!/^-)^&Z^(F^!U^(l^.s^*A ",
      "encoded_base64": "XjQmXiYiXipBXitoXi5qXixYXiM+Xi9JXiJ+XitfXjFhXiRrXiNhXiEvXi0pXiZaXihGXiFVXihsXi5zXipBIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_f152a4e39647",
      "text": "深深沉湎於各種邪惡的血祭儀式。",
      "encoded_ascii": "^2*^2*^%Z^?A^$^^+>^'$^)\"^#y^&Z^(:^&x^+'^#X^!\"",
      "encoded_base64": "XjIqXjIqXiVaXj9BXiReXis+XickXikiXiN5XiZaXig6XiZ4XisnXiNYXiEi",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_47840f867f98",
      "text": "在尼貝奈時，查爾的主人交給他一名幼女要他守護；然而 ",
      "encoded_ascii": "^\"d^#>^/I^\"~^$f^*A^%&^&/^&Z^!-^!<^0P^'A^!@^!%^\"F^9@^#\"^(C^!@^#+^(T^*C^&\"^'W ",
      "encoded_base64": "XiJkXiM+Xi9JXiJ+XiRmXipBXiUmXiYvXiZaXiEtXiE8XjBQXidBXiFAXiElXiJGXjlAXiMiXihDXiFAXiMrXihUXipDXiYiXidXIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_37f3e313f7da",
      "text": "當那個女人為了血祭儀式而索要那個孩子時，查爾違抗了她。 ",
      "encoded_ascii": "^&N^)!^!V^#\"^!<^%{^*D^(:^&x^+'^#X^'W^'>^(C^)!^!V^+m^#(^$f^*A^%&^&/^9P^$4^*D^+h^!\" ",
      "encoded_base64": "XiZOXikhXiFWXiMiXiE8XiV7XipEXig6XiZ4XisnXiNYXidXXic+XihDXikhXiFWXittXiMoXiRmXipBXiUmXiYvXjlQXiQ0XipEXitoXiEiIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_233661164c90",
      "text": "對他而言，親手將自己立誓保護的對象送入險境，是他無論如何都無法承受的。 ",
      "encoded_ascii": "^#:^!@^'W^1Y^*A^(F^$+^#7^'l^#I^0'^-w^!T^(T^&Z^#:^4g^./^!f^*m^\"q^*A^,X^!@^%}^1\\^#$^!L^)$^%}^%b^$0^\";^&Z^!\" ",
      "encoded_base64": "XiM6XiFAXidXXjFZXipBXihGXiQrXiM3XidsXiNJXjAnXi13XiFUXihUXiZaXiM6XjRnXi4vXiFmXiptXiJxXipBXixYXiFAXiV9XjFcXiMkXiFMXikkXiV9XiViXiQwXiI7XiZaXiEiIA==",
      "byte_length": 106
    },
    {
      "unit_id": "DLG_43a00a28caf3",
      "text": "究竟是如何辦到的我也不得而知，總之他承受住了聖堂武士的雷霆之怒並大難不死， ",
      "encoded_ascii": "^-<^28^,X^#$^!L^2L^!u^&Z^$%^!1^!)^#e^'W^&h^*A^-M^!/^!@^$0^\";^*z^*D^'Z^42^%J^+a^&Z^)c^?:^!/^#o^!+^\"z^)a^!)^%L^*A ",
      "encoded_base64": "Xi08XjI4XixYXiMkXiFMXjJMXiF1XiZaXiQlXiExXiEpXiNlXidXXiZoXipBXi1NXiEvXiFAXiQwXiI7Xip6XipEXidaXjQyXiVKXithXiZaXiljXj86XiEvXiNvXiErXiJ6XilhXiEpXiVMXipBIA==",
      "byte_length": 112
    },
    {
      "unit_id": "DLG_a941df1f6add",
      "text": "帶著那個孩子逃到了安全之地。",
      "encoded_ascii": "^#N^-a^)!^!V^+m^#(^(p^!u^*D^+p^!h^!/^\"e^!\"",
      "encoded_base64": "XiNOXi1hXikhXiFWXittXiMoXihwXiF1XipEXitwXiFoXiEvXiJlXiEi",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_bd95ac7c80a8",
      "text": "她至今仍與我們生活在一起。她的名字叫卡圖拉，而且",
      "encoded_ascii": "^+h^'n^*E^!?^'p^$%^*{^&F^%i^\"d^!%^.(^!\"^+h^&Z^\"F^#)^+<^\"0^\"b^$6^*A^'W^!*",
      "encoded_base64": "XitoXiduXipFXiE/XidwXiQlXip7XiZGXiVpXiJkXiElXi4oXiEiXitoXiZaXiJGXiMpXis8XiIwXiJiXiQ2XipBXidXXiEq",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_c1aac07610b2",
      "text": "沒錯。 ",
      "encoded_ascii": "^%\\^)5^!\" ",
      "encoded_base64": "XiVcXik1XiEiIA==",
      "byte_length": 10
    },
    {
      "unit_id": "DLG_20c68698a047",
      "text": " 查爾收養了她作為義女。我想他從未向她透露過 ",
      "encoded_ascii": " ^%&^&/^$M^.I^*D^+h^!M^%{^2<^#\"^!\"^$%^,1^!@^#f^,_^+?^+h^(q^.B^(x ",
      "encoded_base64": "IF4lJl4mL14kTV4uSV4qRF4raF4hTV4le14yPF4jIl4hIl4kJV4sMV4hQF4jZl4sX14rP14raF4ocV4uQl4oeCA=",
      "byte_length": 65
    },
    {
      "unit_id": "DLG_6487b5e0428c",
      "text": "關於她親生父母的身世全貌。",
      "encoded_ascii": "^.>^$^^+h^(F^&F^5d^/s^&Z^(c^*p^!h^-~^!\"",
      "encoded_base64": "Xi4+XiReXitoXihGXiZGXjVkXi9zXiZaXihjXipwXiFoXi1+XiEi",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_15b5d03d334c",
      "text": "預言者",
      "encoded_ascii": "^.E^1Y^'V",
      "encoded_base64": "Xi5FXjFZXidW",
      "byte_length": 9
    },
    {
      "unit_id": "DLG_cba83e4da515",
      "text": "有什麼能為各位效勞的？",
      "encoded_ascii": "^$s^!=^.T^'b^%{^+>^!J^$Q^/R^&Z^.V",
      "encoded_base64": "XiRzXiE9Xi5UXidiXiV7Xis+XiFKXiRRXi9SXiZaXi5W",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_d0d47bd52a93",
      "text": "  我為你們籌措到了一批武器裝備。",
      "encoded_ascii": "  ^$%^%{^*F^*{^:W^;[^!u^*D^!%^2i^%J^\"V^(A^+\"^!\"",
      "encoded_base64": "ICBeJCVeJXteKkZeKnteOldeO1teIXVeKkReISVeMmleJUpeIlZeKEFeKyJeISI=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_88e98823e556",
      "text": "  關於戰事有什麼最新消息嗎？",
      "encoded_ascii": "  ^.>^$^^$(^*r^$s^!=^.T^$q^$\\^%k^#w^+X^.V",
      "encoded_base64": "ICBeLj5eJF5eJCheKnJeJHNeIT1eLlReJHFeJFxeJWteI3deK1heLlY=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_04ebf3d6e81e",
      "text": "  跟我說說提奎茲爾村的事。",
      "encoded_ascii": "  ^.+^$%^-x^-x^$A^5B^/D^&/^$z^&Z^*r^!\"",
      "encoded_base64": "ICBeLiteJCVeLXheLXheJEFeNUJeL0ReJi9eJHpeJlpeKnJeISI=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_6fcba0483c16",
      "text": "  我接下來該做什麼？",
      "encoded_ascii": "  ^$%^$?^!(^!O^(M^*~^!=^.T^.V",
      "encoded_base64": "ICBeJCVeJD9eISheIU9eKE1eKn5eIT1eLlReLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_9f7ee2c8f2d1",
      "text": "  其他的村落都在哪裡？",
      "encoded_ascii": "  ^!j^!@^&Z^$z^-`^)$^\"d^+I^-j^.V",
      "encoded_base64": "ICBeIWpeIUBeJlpeJHpeLWBeKSReImReK0leLWpeLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_2165a3590ad4",
      "text": "噢，這真是天大的好消息。我們原本還擔心許多人只能拿著 ",
      "encoded_ascii": "^+]^*A^(s^-2^,X^+e^\"z^&Z^+i^%k^#w^!\"^$%^*{^\"5^$x^.7^*N^#k^-s^\"x^!<^\"?^'b^,G^-a ",
      "encoded_base64": "XitdXipBXihzXi0yXixYXitlXiJ6XiZaXitpXiVrXiN3XiEiXiQlXip7XiI1XiR4Xi43XipOXiNrXi1zXiJ4XiE8XiI/XidiXixHXi1hIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_8502597f41d6",
      "text": "草叉和鐵鏟上戰場。太感謝你們了！",
      "encoded_ascii": "^*f^?<^\"O^)?^)=^!'^$(^\"n^!\"^+f^#{^-z^*F^*{^*D^*W",
      "encoded_base64": "XipmXj88XiJPXik/Xik9XiEnXiQoXiJuXiEiXitmXiN7Xi16XipGXip7XipEXipX",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_8d4a7a4615e2",
      "text": "傳到我們這裡的消息極其有限，而",
      "encoded_ascii": "^+$^!u^$%^*{^(s^-j^&Z^%k^#w^1D^!j^$s^)O^*A^'W",
      "encoded_base64": "XiskXiF1XiQlXip7XihzXi1qXiZaXiVrXiN3XjFEXiFqXiRzXilPXipBXidX",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_605bc34db429",
      "text": " 也無法洞悉世間的一切。",
      "encoded_ascii": " ^!1^%}^%b^%h^2h^*p^)G^&Z^!%^+.^!\"",
      "encoded_base64": "IF4hMV4lfV4lYl4laF4yaF4qcF4pR14mWl4hJV4rLl4hIg==",
      "byte_length": 34
    },
    {
      "unit_id": "DLG_92b35821b503",
      "text": "  德拉吉的大軍還有多久會開拔？",
      "encoded_ascii": "  ^#j^$6^\"D^&Z^\"z^..^.7^$s^\"x^!.^$r^)F^/c^.V",
      "encoded_base64": "ICBeI2peJDZeIkReJlpeInpeLi5eLjdeJHNeInheIS5eJHJeKUZeL2NeLlY=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_f02049754e82",
      "text": "  關於同盟結盟有什麼進展嗎？",
      "encoded_ascii": "  ^.>^$^^\"E^-0^'@^-0^$s^!=^.T^(w^+x^+X^.V",
      "encoded_base64": "ICBeLj5eJF5eIkVeLTBeJ0BeLTBeJHNeIT1eLlReKHdeK3heK1heLlY=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_79cd54479b2c",
      "text": "  我們的勝算有多大？",
      "encoded_ascii": "  ^$%^*{^&Z^+5^-C^$s^\"x^\"z^.V",
      "encoded_base64": "ICBeJCVeKnteJlpeKzVeLUNeJHNeInheInpeLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_f6fc8905f1d2",
      "text": "我很樂意效勞。",
      "encoded_ascii": "^$%^*K^%8^#z^$Q^/R^!\"",
      "encoded_base64": "XiQlXipLXiU4XiN6XiRRXi9SXiEi",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_56fcfdfe0936",
      "text": "  跟我說說你們的領袖查爾吧。",
      "encoded_ascii": "  ^.+^$%^-x^-x^*F^*{^&Z^)s^7G^%&^&/^*I^!\"",
      "encoded_base64": "ICBeLiteJCVeLXheLXheKkZeKnteJlpeKXNeN0deJSZeJi9eKkleISI=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_bf12545e8c8b",
      "text": "  那位副官……跟我聊聊他吧。",
      "encoded_ascii": "  ^)!^!J^52^#-^*o^*o^.+^$%^-U^-U^!@^*I^!\"",
      "encoded_base64": "ICBeKSFeIUpeNTJeIy1eKm9eKm9eLiteJCVeLVVeLVVeIUBeKkleISI=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_abf313c378d3",
      "text": "  奎林會是個優秀的領袖嗎？",
      "encoded_ascii": "  ^5B^/1^$r^,X^!V^+)^-9^&Z^)s^7G^+X^.V",
      "encoded_base64": "ICBeNUJeLzFeJHJeLFheIVZeKyleLTleJlpeKXNeN0deK1heLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_605735a3d7e5",
      "text": " 我們的心會與你們同在。",
      "encoded_ascii": " ^$%^*{^&Z^#k^$r^'p^*F^*{^\"E^\"d^!\"",
      "encoded_base64": "IF4kJV4qe14mWl4ja14kcl4ncF4qRl4qe14iRV4iZF4hIg==",
      "byte_length": 34
    },
    {
      "unit_id": "DLG_5a182cde5f25",
      "text": "我們完全碰了一鼻子灰！如果你們無法替我們召集盟友，我們就死定了！",
      "encoded_ascii": "^$%^*{^#,^!h^-5^*D^!%^4q^#(^%y^*W^#$^%!^*F^*{^%}^%b^2o^$%^*{^\"@^)]^-0^\"8^*A^$%^*{^*J^%L^#.^*D^*W",
      "encoded_base64": "XiQlXip7XiMsXiFoXi01XipEXiElXjRxXiMoXiV5XipXXiMkXiUhXipGXip7XiV9XiViXjJvXiQlXip7XiJAXildXi0wXiI4XipBXiQlXip7XipKXiVMXiMuXipEXipX",
      "byte_length": 96
    },
    {
      "unit_id": "DLG_d427202d2794",
      "text": "沒有任何好消息！我們聽說位於 ",
      "encoded_ascii": "^%\\^$s^!C^!L^+i^%k^#w^*W^$%^*{^-X^-x^!J^$^ ",
      "encoded_base64": "XiVcXiRzXiFDXiFMXitpXiVrXiN3XipXXiQlXip7Xi1YXi14XiFKXiReIA==",
      "byte_length": 43
    },
    {
      "unit_id": "DLG_f787c3f1b752",
      "text": "北",
      "encoded_ascii": "^+6",
      "encoded_base64": "Xis2",
      "byte_length": 3
    },
    {
      "unit_id": "DLG_05bd82ae8801",
      "text": "南",
      "encoded_ascii": "^\"/",
      "encoded_base64": "XiIv",
      "byte_length": 3
    },
    {
      "unit_id": "DLG_92a3707aae9c",
      "text": "西方的一座村落遭到了小股掠奪者的襲擊。我們的麻煩只會越來越多！",
      "encoded_ascii": "^-l^$]^&Z^!%^/_^$z^-`^(}^!u^*D^#;^'_^1<^1,^'V^&Z^08^$F^!\"^$%^*{^&Z^*6^-!^\"?^$r^(]^!O^(]^\"x^*W",
      "encoded_base64": "Xi1sXiRdXiZaXiElXi9fXiR6Xi1gXih9XiF1XipEXiM7XidfXjE8XjEsXidWXiZaXjA4XiRGXiEiXiQlXip7XiZaXio2Xi0hXiI/XiRyXihdXiFPXihdXiJ4XipX",
      "byte_length": 93
    },
    {
      "unit_id": "DLG_45bab359688c",
      "text": "太好了！多虧了你們，我們如今在 ",
      "encoded_ascii": "^+f^+i^*D^*W^\"x^9N^*D^*F^*{^*A^$%^*{^#$^*E^\"d ",
      "encoded_base64": "XitmXitpXipEXipXXiJ4XjlOXipEXipGXip7XipBXiQlXip7XiMkXipFXiJkIA==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_ad78c7c3819e",
      "text": "蓋德隆",
      "encoded_ascii": "^-d^#j^)T",
      "encoded_base64": "Xi1kXiNqXilU",
      "byte_length": 9
    },
    {
      "unit_id": "DLG_aff8c7eca85f",
      "text": "塞德利特",
      "encoded_ascii": "^/(^#j^!t^&5",
      "encoded_base64": "Xi8oXiNqXiF0XiY1",
      "byte_length": 12
    },
    {
      "unit_id": "DLG_b8f1045a59e1",
      "text": "。有了他們作為表率，我相信其他村落很快也會起而跟隨。",
      "encoded_ascii": "^!\"^$s^*D^!@^*{^!M^%{^-i^22^*A^$%^&a^!U^!j^!@^$z^-`^*K^*L^!1^$r^.(^'W^.+^)X^!\"",
      "encoded_base64": "XiEiXiRzXipEXiFAXip7XiFNXiV7Xi1pXjIyXipBXiQlXiZhXiFVXiFqXiFAXiR6Xi1gXipLXipMXiExXiRyXi4oXidXXi4rXilYXiEi",
      "byte_length": 78
    },
    {
      "unit_id": "DLG_8e1f8bd623dd",
      "text": " 說我們勝算渺茫",
      "encoded_ascii": " ^-x^$%^*{^+5^-C^<n^9L",
      "encoded_base64": "IF4teF4kJV4qe14rNV4tQ148bl45TA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_f4974455ee08",
      "text": "；但有你們為我們奔走聯絡盟友，我相信情勢必定會大有好轉！",
      "encoded_ascii": "^*C^!I^$s^*F^*{^%{^$%^*{^2b^.&^-V^-J^-0^\"8^*A^$%^&a^!U^,0^\"&^#l^#.^$r^\"z^$s^+i^(i^*W",
      "encoded_base64": "XipDXiFJXiRzXipGXip7XiV7XiQlXip7XjJiXi4mXi1WXi1KXi0wXiI4XipBXiQlXiZhXiFVXiwwXiImXiNsXiMuXiRyXiJ6XiRzXitpXihpXipX",
      "byte_length": 84
    },
    {
      "unit_id": "DLG_622f426be36a",
      "text": " 而且情況愈發惡劣！他又看到了一段幻象，在幻象中我們的戰士甚至還沒趕到戰場 ",
      "encoded_ascii": " ^'W^!*^,0^,q^?>^&W^#y^+2^*W^!@^+;^*Q^!u^*D^!%^.l^#S^4g^*A^\"d^#S^4g^!,^$%^*{^&Z^$(^+a^/|^'n^.7^%\\^0u^!u^$(^\"n ",
      "encoded_base64": "IF4nV14hKl4sMF4scV4/Pl4mV14jeV4rMl4qV14hQF4rO14qUV4hdV4qRF4hJV4ubF4jU140Z14qQV4iZF4jU140Z14hLF4kJV4qe14mWl4kKF4rYV4vfF4nbl4uN14lXF4wdV4hdV4kKF4ibiA=",
      "byte_length": 110
    },
    {
      "unit_id": "DLG_62fd65c83eaa",
      "text": "就已經全軍覆沒了！",
      "encoded_ascii": "^*J^#J^'D^!h^..^(D^%\\^*D^*W",
      "encoded_base64": "XipKXiNKXidEXiFoXi4uXihEXiVcXipEXipX",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_8f727523e7e2",
      "text": "，但只要你們每朝著實現預言邁出一步，我們的勝算便會隨之增加一分。",
      "encoded_ascii": "^*A^!I^\"?^(C^*F^*{^%P^,^^-a^#3^&?^.E^1Y^2N^!q^!%^,i^*A^$%^*{^&Z^+5^-C^!R^$r^)X^!/^\"s^\"\"^!%^!s^!\"",
      "encoded_base64": "XipBXiFJXiI/XihDXipGXip7XiVQXixeXi1hXiMzXiY/Xi5FXjFZXjJOXiFxXiElXixpXipBXiQlXip7XiZaXis1Xi1DXiFSXiRyXilYXiEvXiJzXiIiXiElXiFzXiEi",
      "byte_length": 96
    },
    {
      "unit_id": "DLG_b5def76bb9a1",
      "text": "多年前，查爾在逃離尼貝奈的奴役後建立了提奎茲爾。他即便在穆爾人之中也以頑強悍勇著稱的威名， ",
      "encoded_ascii": "^\"x^+~^!z^*A^%&^&/^\"d^(p^)`^#>^/I^\"~^&Z^##^17^#b^,'^0'^*D^$A^5B^/D^&/^!\"^!@^\"1^!R^\"d^8K^&/^!<^!/^!,^!1^!B^4%^#]^,-^\"$^-a^0&^&Z^#&^\"F^*A ",
      "encoded_base64": "XiJ4Xit+XiF6XipBXiUmXiYvXiJkXihwXilgXiM+Xi9JXiJ+XiZaXiMjXjE3XiNiXiwnXjAnXipEXiRBXjVCXi9EXiYvXiEiXiFAXiIxXiFSXiJkXjhLXiYvXiE8XiEvXiEsXiExXiFCXjQlXiNdXiwtXiIkXi1hXjAmXiZaXiMmXiJGXipBIA==",
      "byte_length": 136
    },
    {
      "unit_id": "DLG_ef8d2d1c30e5",
      "text": "讓掠奪者不敢輕舉妄動。只可惜，他如今年事已高。",
      "encoded_ascii": "^-}^1<^1,^'V^!)^/m^(g^01^+j^\"%^!\"^\"?^\"A^7X^*A^!@^#$^*E^+~^*r^#J^*+^!\"",
      "encoded_base64": "Xi19XjE8XjEsXidWXiEpXi9tXihnXjAxXitqXiIlXiEiXiI/XiJBXjdYXipBXiFAXiMkXipFXit+XipyXiNKXiorXiEi",
      "byte_length": 69
    },
    {
      "unit_id": "DLG_97ac359a908d",
      "text": "是的，他勇武過人，將村子保護得極好。或許他在謀略上沒有某些人期望的那麼聰慧， ",
      "encoded_ascii": "^,X^&Z^*A^!@^\"$^%J^(x^!<^*A^#7^$z^#(^!T^(T^#e^1D^+i^!\"^$'^-s^!@^\"d^3~^&L^!'^%\\^$s^%$^!8^!<^$u^,]^&Z^)!^.T^2=^4;^*A ",
      "encoded_base64": "XixYXiZaXipBXiFAXiIkXiVKXih4XiE8XipBXiM3XiR6XiMoXiFUXihUXiNlXjFEXitpXiEiXiQnXi1zXiFAXiJkXjN+XiZMXiEnXiVcXiRzXiUkXiE4XiE8XiR1XixdXiZaXikhXi5UXjI9XjQ7XipBIA==",
      "byte_length": 115
    },
    {
      "unit_id": "DLG_c8533336af60",
      "text": "但他足夠睿智，成立了這個長老議會來為他出謀劃策。",
      "encoded_ascii": "^!I^!@^(^^+d^/=^$i^*A^$$^0'^*D^(s^!V^)C^'U^-|^$r^!O^%{^!@^!q^3~^4s^5p^!\"",
      "encoded_base64": "XiFJXiFAXiheXitkXi89XiRpXipBXiQkXjAnXipEXihzXiFWXilDXidVXi18XiRyXiFPXiV7XiFAXiFxXjN+XjRzXjVwXiEi",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_ea6733bc602a",
      "text": "奎林曾是德拉吉官僚手下的奴隸，直到他為自己謀得了一條生路——用他主人的錢 ",
      "encoded_ascii": "^5B^/1^.j^,X^#j^$6^\"D^#-^?;^$+^!(^&Z^##^)Z^*A^&`^!u^!@^%{^'l^#I^3~^#e^*D^!%^%.^&F^(a^*n^*n^&H^!@^!-^!<^&Z^.< ",
      "encoded_base64": "XjVCXi8xXi5qXixYXiNqXiQ2XiJEXiMtXj87XiQrXiEoXiZaXiMjXilaXipBXiZgXiF1XiFAXiV7XidsXiNJXjN+XiNlXipEXiElXiUuXiZGXihhXipuXipuXiZIXiFAXiEtXiE8XiZaXi48IA==",
      "byte_length": 109
    },
    {
      "unit_id": "DLG_9802c6b87f41",
      "text": "贖回了自己的自由之身！奎林精明幹練，為提奎茲爾擺脫貧困立下了汗馬功勞。",
      "encoded_ascii": "^3-^\"\\^*D^'l^#I^&Z^'l^&I^!/^(c^*W^5B^/1^'7^$c^,!^-L^*A^%{^$A^5B^/D^&/^1@^'c^;:^\"^^0'^!(^*D^;j^*\"^\"!^/R^!\"",
      "encoded_base64": "XjMtXiJcXipEXidsXiNJXiZaXidsXiZJXiEvXihjXipXXjVCXi8xXic3XiRjXiwhXi1MXipBXiV7XiRBXjVCXi9EXiYvXjFAXidjXjs6XiJeXjAnXiEoXipEXjtqXioiXiIhXi9SXiEi",
      "byte_length": 105
    },
    {
      "unit_id": "DLG_21732b5140b7",
      "text": "奎林的長處在於頭腦，而非武力。許多人堅信他能把提奎茲爾打造成一座 ",
      "encoded_ascii": "^5B^/1^&Z^)C^(,^\"d^$^^)t^2@^*A^'W^)i^%J^!~^!\"^-s^\"x^!<^\"l^!U^!@^'b^$1^$A^5B^/D^&/^$-^(v^$$^!%^/_ ",
      "encoded_base64": "XjVCXi8xXiZaXilDXigsXiJkXiReXil0XjJAXipBXidXXilpXiVKXiF+XiEiXi1zXiJ4XiE8XiJsXiFVXiFAXidiXiQxXiRBXjVCXi9EXiYvXiQtXih2XiQkXiElXi9fIA==",
      "byte_length": 97
    },
    {
      "unit_id": "DLG_b2b0d732beff",
      "text": "繁華的商隊前哨站，使我們富裕起來。然而，唯有鐵腕才能鎮壓廢土大漠的種種凶險。 ",
      "encoded_ascii": "^-N^3'^&Z^1'^)U^!z^:Q^->^*A^!N^$%^*{^3C^8Q^.(^!O^!\"^&\"^'W^*A^+O^$s^)?^'e^$,^'b^);^4v^#W^\"c^\"z^,}^&Z^'$^'$^3e^*m^!\" ",
      "encoded_base64": "Xi1OXjMnXiZaXjEnXilVXiF6XjpRXi0+XipBXiFOXiQlXip7XjNDXjhRXi4oXiFPXiEiXiYiXidXXipBXitPXiRzXik/XidlXiQsXidiXik7XjR2XiNXXiJjXiJ6Xix9XiZaXickXickXjNlXiptXiEiIA==",
      "byte_length": 115
    },
    {
      "unit_id": "DLG_c1ea61b35e07",
      "text": "要是提奎茲爾能有一個既像查爾般勇猛無敵、又像奎林般精明機智的領袖就好了……",
      "encoded_ascii": "^(C^,X^$A^5B^/D^&/^'b^$s^!%^!V^,U^!`^%&^&/^'r^\"$^*P^%}^$U^!!^+;^!`^5B^/1^'r^'7^$c^%>^$i^&Z^)s^7G^*J^+i^*D^*o^*o",
      "encoded_base64": "XihDXixYXiRBXjVCXi9EXiYvXidiXiRzXiElXiFWXixVXiFgXiUmXiYvXidyXiIkXipQXiV9XiRVXiEhXis7XiFgXjVCXi8xXidyXic3XiRjXiU+XiRpXiZaXilzXjdHXipKXitpXipEXipvXipv",
      "byte_length": 111
    },
    {
      "unit_id": "DLG_c725fdccb460",
      "text": "我們在沙漠中發現了他，當時他受盡預言幻象的折磨，因烈日曝曬而神智不清。在他 ",
      "encoded_ascii": "^$%^*{^\"d^%]^,}^!,^&W^&?^*D^!@^*A^&N^$f^!@^\";^-1^.E^1Y^#S^4g^&Z^,?^-7^*A^\"]^%|^$a^/o^,Z^'W^&w^$i^!)^,u^!\"^\"d^!@ ",
      "encoded_base64": "XiQlXip7XiJkXiVdXix9XiEsXiZXXiY/XipEXiFAXipBXiZOXiRmXiFAXiI7Xi0xXi5FXjFZXiNTXjRnXiZaXiw/Xi03XipBXiJdXiV8XiRhXi9vXixaXidXXiZ3XiRpXiEpXix1XiEiXiJkXiFAIA==",
      "byte_length": 112
    },
    {
      "unit_id": "DLG_57cea35a4f1f",
      "text": "逐漸康復之後，他陷入了一場出神冥想的恍惚狀態，道出了那則驚世預言。",
      "encoded_ascii": "^(r^2v^5N^#g^!/^#b^*A^!@^)S^!f^*D^!%^\"n^!q^&w^2X^,1^&Z^7-^7.^&7^#|^*A^(y^!q^*D^)!^!x^.Q^*p^.E^1Y^!\"",
      "encoded_base64": "XihyXjJ2XjVOXiNnXiEvXiNiXipBXiFAXilTXiFmXipEXiElXiJuXiFxXiZ3XjJYXiwxXiZaXjctXjcuXiY3XiN8XipBXih5XiFxXipEXikhXiF4Xi5RXipwXi5FXjFZXiEi",
      "byte_length": 99
    },
    {
      "unit_id": "DLG_d9b929a083f3",
      "text": "  那位預言者是誰？",
      "encoded_ascii": "  ^)!^!J^.E^1Y^'V^,X^-y^.V",
      "encoded_base64": "ICBeKSFeIUpeLkVeMVleJ1ZeLFheLXleLlY=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_4a69880b9028",
      "text": "  我在哪裡能找到那位預言者？",
      "encoded_ascii": "  ^$%^\"d^+I^-j^'b^$/^!u^)!^!J^.E^1Y^'V^.V",
      "encoded_base64": "ICBeJCVeImReK0leLWpeJ2JeJC9eIXVeKSFeIUpeLkVeMVleJ1ZeLlY=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_0dfd743ec918",
      "text": "我們也不清楚。各個村落——包括提奎茲爾在內——向來各自封閉自守。或許你們可以試著往 ",
      "encoded_ascii": "^$%^*{^!1^!)^,u^,c^!\"^+>^!V^$z^-`^*n^*n^\"'^??^$A^5B^/D^&/^\"d^!g^*n^*n^+?^!O^+>^'l^#5^.=^'l^#+^!\"^$'^-s^*F^*{^\"A^!B^-u^-a^,) ",
      "encoded_base64": "XiQlXip7XiExXiEpXix1XixjXiEiXis+XiFWXiR6Xi1gXipuXipuXiInXj8/XiRBXjVCXi9EXiYvXiJkXiFnXipuXipuXis/XiFPXis+XidsXiM1Xi49XidsXiMrXiEiXiQnXi1zXipGXip7XiJBXiFCXi11Xi1hXiwpIA==",
      "byte_length": 124
    },
    {
      "unit_id": "DLG_f00d7b174565",
      "text": "北方探索。",
      "encoded_ascii": "^+6^$]^$>^'>^!\"",
      "encoded_base64": "Xis2XiRdXiQ+Xic+XiEi",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_a550b959a59d",
      "text": "南方探索。",
      "encoded_ascii": "^\"/^$]^$>^'>^!\"",
      "encoded_base64": "XiIvXiRdXiQ+Xic+XiEi",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_54356b00d1a6",
      "text": "找支商隊打聽消息，他們或許會知道。",
      "encoded_ascii": "^$/^$L^1'^)U^$-^-X^%k^#w^*A^!@^*{^$'^-s^$r^&h^(y^!\"",
      "encoded_base64": "XiQvXiRMXjEnXilVXiQtXi1YXiVrXiN3XipBXiFAXip7XiQnXi1zXiRyXiZoXih5XiEi",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_e116ac5b9555",
      "text": " 也無法斷定，但 ",
      "encoded_ascii": " ^!1^%}^%b^,T^#.^*A^!I ",
      "encoded_base64": "IF4hMV4lfV4lYl4sVF4jLl4qQV4hSSA=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_39377c454762",
      "text": "那一天絕不會太遠了。",
      "encoded_ascii": "^)!^!%^+e^-I^!)^$r^+f^({^*D^!\"",
      "encoded_base64": "XikhXiElXitlXi1JXiEpXiRyXitmXih7XipEXiEi",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_4d18e05b2c01",
      "text": "敵軍隨時都有可能發動突襲。那些家園被毀的難民已經陸續逃難至我們這裡避難了！",
      "encoded_ascii": "^$U^..^)X^$f^)$^$s^\"A^'b^&W^\"%^'*^08^!\"^)!^!8^+s^41^(@^%N^&Z^)a^%T^#J^'D^99^'M^(p^)a^'n^$%^*{^(s^-j^0F^)a^*D^*W",
      "encoded_base64": "XiRVXi4uXilYXiRmXikkXiRzXiJBXidiXiZXXiIlXicqXjA4XiEiXikhXiE4XitzXjQxXihAXiVOXiZaXilhXiVUXiNKXidEXjk5XidNXihwXilhXiduXiQlXip7XihzXi1qXjBGXilhXipEXipX",
      "byte_length": 111
    },
    {
      "unit_id": "DLG_12b1b5cd62be",
      "text": "很快，就在不久之後。幾天前的夜晚有顆流星自天際墜落——那是兵燹戰禍的凶兆！",
      "encoded_ascii": "^*K^*L^*A^*J^\"d^!)^!.^!/^#b^!\"^#T^+e^!z^&Z^+c^,Y^$s^)u^%j^$e^'l^+e^30^\"r^-`^*n^*n^)!^,X^+,^?C^$(^7B^&Z^3e^5/^*W",
      "encoded_base64": "XipLXipMXipBXipKXiJkXiEpXiEuXiEvXiNiXiEiXiNUXitlXiF6XiZaXitjXixZXiRzXil1XiVqXiRlXidsXitlXjMwXiJyXi1gXipuXipuXikhXixYXissXj9DXiQoXjdCXiZaXjNlXjUvXipX",
      "byte_length": 111
    },
    {
      "unit_id": "DLG_f0c3c99fe9cc",
      "text": "沒人能確切知曉，就連",
      "encoded_ascii": "^%\\^!<^'b^-6^+.^&h^7y^*A^*J^.0",
      "encoded_base64": "XiVcXiE8XidiXi02XisuXiZoXjd5XipBXipKXi4w",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_653e7477d0e0",
      "text": "也一樣。烈日或者那些幻象，燒毀了他大部分的記憶。",
      "encoded_ascii": "^!1^!%^,f^!\"^%|^$a^$'^'V^)!^!8^#S^4g^*A^&&^%N^*D^!@^\"z^)#^!s^&Z^(K^$\"^!\"",
      "encoded_base64": "XiExXiElXixmXiEiXiV8XiRhXiQnXidWXikhXiE4XiNTXjRnXipBXiYmXiVOXipEXiFAXiJ6XikjXiFzXiZaXihLXiQiXiEi",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_b709add8ced7",
      "text": "的住處就在大門的正東北方。",
      "encoded_ascii": "^&Z^*z^(,^*J^\"d^\"z^)D^&Z^%H^,`^+6^$]^!\"",
      "encoded_base64": "XiZaXip6XigsXipKXiJkXiJ6XilEXiZaXiVIXixgXis2XiRdXiEi",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_d38b15d3e7df",
      "text": "你們必須找到另一座村莊，說服他們的領袖與我們結為盟友。",
      "encoded_ascii": "^*F^*{^#l^)r^$/^!u^\">^!%^/_^$z^6l^*A^-x^,\\^!@^*{^&Z^)s^7G^'p^$%^*{^'@^%{^-0^\"8^!\"",
      "encoded_base64": "XipGXip7XiNsXilyXiQvXiF1XiI+XiElXi9fXiR6XjZsXipBXi14XixcXiFAXip7XiZaXilzXjdHXidwXiQlXip7XidAXiV7Xi0wXiI4XiEi",
      "byte_length": 81
    },
    {
      "unit_id": "DLG_d2203f8c4dbf",
      "text": "向你們致敬，強大的冒險者們！",
      "encoded_ascii": "^+?^*F^*{^'o^*O^*A^#]^\"z^&Z^/P^*m^'V^*{^*W",
      "encoded_base64": "Xis/XipGXip7XidvXipPXipBXiNdXiJ6XiZaXi9QXiptXidWXip7XipX",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_6cb8757662bb",
      "text": "懇請賜告你們的大名，好讓我能將這段傳奇講給孩子們聽，告訴他們關於那群 ",
      "encoded_ascii": "^3t^*S^.#^+B^*F^*{^&Z^\"z^\"F^*A^+i^-}^$%^'b^#7^(s^.l^+$^\"}^6+^'A^+m^#(^*{^-X^*A^+B^-t^!@^*{^.>^$^^)!^'R ",
      "encoded_base64": "XjN0XipTXi4jXitCXipGXip7XiZaXiJ6XiJGXipBXitpXi19XiQlXidiXiM3XihzXi5sXiskXiJ9XjYrXidBXittXiMoXip7Xi1YXipBXitCXi10XiFAXip7Xi4+XiReXikhXidSIA==",
      "byte_length": 103
    },
    {
      "unit_id": "DLG_c0b69abcabf8",
      "text": "擊敗德拉吉大軍、為我們所有人贏得自由的偉大英雄們。",
      "encoded_ascii": "^$F^$R^#j^$6^\"D^\"z^..^!!^%{^$%^*{^$)^$s^!<^.%^#e^'l^&I^&Z^*}^\"z^'y^)\\^*{^!\"",
      "encoded_base64": "XiRGXiRSXiNqXiQ2XiJEXiJ6Xi4uXiEhXiV7XiQlXip7XiQpXiRzXiE8Xi4lXiNlXidsXiZJXiZaXip9XiJ6Xid5XilcXip7XiEi",
      "byte_length": 75
    },
    {
      "unit_id": "DLG_bf86ecc93f60",
      "text": "  德拉吉大軍真的敗退逃走了嗎？",
      "encoded_ascii": "  ^#j^$6^\"D^\"z^..^-2^&Z^$R^*V^(p^.&^*D^+X^.V",
      "encoded_base64": "ICBeI2peJDZeIkReInpeLi5eLTJeJlpeJFJeKlZeKHBeLiZeKkReK1heLlY=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_b2502d46c5b8",
      "text": "這是我有生以來獲得過的最大榮耀！要不是你們擊退了 ",
      "encoded_ascii": "^(s^,X^$%^$s^&F^!B^!O^&:^#e^(x^&Z^$q^\"z^,e^7D^*W^(C^!)^,X^*F^*{^$F^*V^*D ",
      "encoded_base64": "XihzXixYXiQlXiRzXiZGXiFCXiFPXiY6XiNlXih4XiZaXiRxXiJ6XixlXjdEXipXXihDXiEpXixYXipGXip7XiRGXipWXipEIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_be8159f771e1",
      "text": "德拉吉大軍，所有的奴隸村莊早就化為烏有了。 ",
      "encoded_ascii": "^#j^$6^\"D^\"z^..^*A^$)^$s^&Z^##^)Z^$z^6l^,V^*J^\")^%{^/4^$s^*D^!\" ",
      "encoded_base64": "XiNqXiQ2XiJEXiJ6Xi4uXipBXiQpXiRzXiZaXiMjXilaXiR6XjZsXixWXipKXiIpXiV7Xi80XiRzXipEXiEiIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_d2a909c5c441",
      "text": "你們挽救了一場可怕的慘劇！只可惜提奎茲爾如今已淪為一片廢墟。",
      "encoded_ascii": "^*F^*{^0b^,Q^*D^!%^\"n^\"A^0^^&Z^,4^1#^*W^\"?^\"A^7X^$A^5B^/D^&/^#$^*E^#J^2)^%{^!%^&1^#W^\"t^!\"",
      "encoded_base64": "XipGXip7XjBiXixRXipEXiElXiJuXiJBXjBeXiZaXiw0XjEjXipXXiI/XiJBXjdYXiRBXjVCXi9EXiYvXiMkXipFXiNKXjIpXiV7XiElXiYxXiNXXiJ0XiEi",
      "byte_length": 90
    },
    {
      "unit_id": "DLG_298d9c92f21c",
      "text": "沒錯。當你們斬殺了德拉吉軍隊的指揮官後，敵軍士兵便 ",
      "encoded_ascii": "^%\\^)5^!\"^&N^*F^*{^9B^%M^*D^#j^$6^\"D^..^)U^&Z^$8^2\"^#-^#b^*A^$U^..^+a^+,^!R ",
      "encoded_base64": "XiVcXik1XiEiXiZOXipGXip7XjlCXiVNXipEXiNqXiQ2XiJEXi4uXilVXiZaXiQ4XjIiXiMtXiNiXipBXiRVXi4uXithXissXiFSIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_ad4cf931bc9f",
      "text": "喪失了所有鬥志，狼狽撤回德拉吉。我相信在往後很長一段時間裡， ",
      "encoded_ascii": "^1)^\"|^*D^$)^$s^*,^#m^*A^21^=Y^:7^\"\\^#j^$6^\"D^!\"^$%^&a^!U^\"d^,)^#b^*K^)C^!%^.l^$f^)G^-j^*A ",
      "encoded_base64": "XjEpXiJ8XipEXiQpXiRzXiosXiNtXipBXjIxXj1ZXjo3XiJcXiNqXiQ2XiJEXiEiXiQlXiZhXiFVXiJkXiwpXiNiXipLXilDXiElXi5sXiRmXilHXi1qXipBIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_a73c9b5bd13e",
      "text": "都不會再見到他們的蹤影了。",
      "encoded_ascii": "^)$^!)^$r^!l^-m^!u^!@^*{^&Z^(b^#a^*D^!\"",
      "encoded_base64": "XikkXiEpXiRyXiFsXi1tXiF1XiFAXip7XiZaXihiXiNhXipEXiEi",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_b797db410fcd",
      "text": "我的名字是圖克圖。我曾是一群前角鬥士隊伍裡的隨行牧師。 ",
      "encoded_ascii": "^$%^&Z^\"F^#)^,X^\"b^!d^\"b^!\"^$%^.j^,X^!%^'R^!z^(H^*,^+a^)U^!F^-j^&Z^)X^(;^/5^#M^!\" ",
      "encoded_base64": "XiQlXiZaXiJGXiMpXixYXiJiXiFkXiJiXiEiXiQlXi5qXixYXiElXidSXiF6XihIXiosXithXilVXiFGXi1qXiZaXilYXig7Xi81XiNNXiEiIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_429deb010bb5",
      "text": "他們在提奎茲爾城外被洶湧而來的敵軍潮水般包圍並全數戰死。 ",
      "encoded_ascii": "^!@^*{^\"d^$A^5B^/D^&/^+_^\"w^(@^?K^0m^'W^!O^&Z^$U^..^=[^%V^'r^\"'^\"`^!+^!h^$V^$(^%L^!\" ",
      "encoded_base64": "XiFAXip7XiJkXiRBXjVCXi9EXiYvXitfXiJ3XihAXj9LXjBtXidXXiFPXiZaXiRVXi4uXj1bXiVWXidyXiInXiJgXiErXiFoXiRWXiQoXiVMXiEiIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_26e879a97e53",
      "text": "大漠中的許多居民都遭遇了相同的厄運， ",
      "encoded_ascii": "^\"z^,}^!,^&Z^-s^\"x^+w^%T^)$^(}^.2^*D^&a^\"E^&Z^80^.4^*A ",
      "encoded_base64": "XiJ6Xix9XiEsXiZaXi1zXiJ4Xit3XiVUXikkXih9Xi4yXipEXiZhXiJFXiZaXjgwXi40XipBIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_4f2003ad244a",
      "text": "儘管他們每個人都作戰英勇。",
      "encoded_ascii": "^+(^-D^!@^*{^%P^!V^!<^)$^!M^$(^'y^\"$^!\"",
      "encoded_base64": "XisoXi1EXiFAXip7XiVQXiFWXiE8XikkXiFNXiQoXid5XiIkXiEi",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_d43c0911dbe0",
      "text": "我只是在尋找一處棲身之所。儘管德拉吉大軍已潰不成軍， ",
      "encoded_ascii": "^$%^\"?^,X^\"d^#9^$/^!%^(,^,b^(c^!/^$)^!\"^+(^-D^#j^$6^\"D^\"z^..^#J^2-^!)^$$^..^*A ",
      "encoded_base64": "XiQlXiI/XixYXiJkXiM5XiQvXiElXigsXixiXihjXiEvXiQpXiEiXisoXi1EXiNqXiQ2XiJEXiJ6Xi4uXiNKXjItXiEpXiQkXi4uXipBIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_a43d2af7b723",
      "text": "但他們在整片大地上造成了無比慘烈的浩劫。所有人都 ",
      "encoded_ascii": "^!I^!@^*{^\"d^$T^&1^\"z^\"e^!'^(v^$$^*D^%}^,m^,4^%|^&Z^5^^1l^!\"^$)^$s^!<^)$ ",
      "encoded_base64": "XiFJXiFAXip7XiJkXiRUXiYxXiJ6XiJlXiEnXih2XiQkXipEXiV9XixtXiw0XiV8XiZaXjVeXjFsXiEiXiQpXiRzXiE8XikkIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_71777e0a044f",
      "text": "需要休養生息，就像現在的我一樣。",
      "encoded_ascii": "^)e^(C^!G^.I^&F^#w^*A^*J^!`^&?^\"d^&Z^$%^!%^,f^!\"",
      "encoded_base64": "XillXihDXiFHXi5JXiZGXiN3XipBXipKXiFgXiY/XiJkXiZaXiQlXiElXixmXiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_f9e3739098e6",
      "text": "我正考慮在這裡定居下來。任由這些 ",
      "encoded_ascii": "^$%^%H^-R^19^\"d^(s^-j^#.^+w^!(^!O^!\"^!C^&I^(s^!8 ",
      "encoded_base64": "XiQlXiVIXi1SXjE5XiJkXihzXi1qXiMuXit3XiEoXiFPXiEiXiFDXiZJXihzXiE4IA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_a8bfa6f92eb0",
      "text": "完好的房屋荒廢實在太可惜了。",
      "encoded_ascii": "^#,^+i^&Z^,<^8y^1W^#W^#3^\"d^+f^\"A^7X^*D^!\"",
      "encoded_base64": "XiMsXitpXiZaXiw8Xjh5XjFXXiNXXiMzXiJkXitmXiJBXjdYXipEXiEi",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_13db14726159",
      "text": "救命啊！德拉吉大軍發動進攻了！",
      "encoded_ascii": "^,Q^\"N^+Q^*W^#j^$6^\"D^\"z^..^&W^\"%^(w^$O^*D^*W",
      "encoded_base64": "XixRXiJOXitRXipXXiNqXiQ2XiJEXiJ6Xi4uXiZXXiIlXih3XiRPXipEXipX",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_bb41aa178611",
      "text": "我們被攻陷了！行行好發發慈悲，救救我們吧！",
      "encoded_ascii": "^$%^*{^(@^$O^)S^*D^*W^(;^(;^+i^&W^&W^3H^,.^*A^,Q^,Q^$%^*{^*I^*W",
      "encoded_base64": "XiQlXip7XihAXiRPXilTXipEXipXXig7Xig7XitpXiZXXiZXXjNIXiwuXipBXixRXixRXiQlXip7XipJXipX",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_5a0eda4780c9",
      "text": "德拉吉大軍開始如潮水般翻越城牆，將 ",
      "encoded_ascii": "^#j^$6^\"D^\"z^..^)F^+k^#$^=[^%V^'r^-Q^(]^+_^&0^*A^#7 ",
      "encoded_base64": "XiNqXiQ2XiJEXiJ6Xi4uXilGXitrXiMkXj1bXiVWXidyXi1RXihdXitfXiYwXipBXiM3IA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_cc8b2270890b",
      "text": "昔日平靜祥和的村莊變成了屠戮的死亡修羅場。",
      "encoded_ascii": "^<)^$a^0Y^)h^9H^\"O^&Z^$z^6l^(U^$$^*D^#A^,:^&Z^%L^!:^.~^/?^\"n^!\"",
      "encoded_base64": "XjwpXiRhXjBZXiloXjlIXiJPXiZaXiR6XjZsXihVXiQkXipEXiNBXiw6XiZaXiVMXiE6Xi5+Xi8/XiJuXiEi",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_03af7c17339c",
      "text": "水井已被黃沙淤塞堵死。",
      "encoded_ascii": "^%V^!7^#J^(@^*7^%]^6c^/(^;u^%L^!\"",
      "encoded_base64": "XiVWXiE3XiNKXihAXio3XiVdXjZjXi8oXjt1XiVMXiEi",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_0a427268dfb4",
      "text": " 痛飲甘涼的泉水，解除了 ",
      "encoded_ascii": " ^-.^){^/:^,s^&Z^%a^%V^*A^(I^)Q^*D ",
      "encoded_base64": "IF4tLl4pe14vOl4sc14mWl4lYV4lVl4qQV4oSV4pUV4qRCA=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_6c714da7f2b5",
      "text": " 喉間焦渴。",
      "encoded_ascii": " ^/V^)G^%~^,w^!\"",
      "encoded_base64": "IF4vVl4pR14lfl4sd14hIg==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_adb709c05105",
      "text": "你想沿著水井爬下去嗎？",
      "encoded_ascii": "^*F^,1^%`^-a^%V^!7^/y^!(^\"6^+X^.V",
      "encoded_base64": "XipGXiwxXiVgXi1hXiVWXiE3Xi95XiEoXiI2XitYXi5W",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_cefb24702cf0",
      "text": "你想離開提奎茲爾嗎？",
      "encoded_ascii": "^*F^,1^)`^)F^$A^5B^/D^&/^+X^.V",
      "encoded_base64": "XipGXiwxXilgXilGXiRBXjVCXi9EXiYvXitYXi5W",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_3c4dbb82bca2",
      "text": "城牆之外，你看到滾滾遮天的沙塵巨浪騰空而起， ",
      "encoded_ascii": "^+_^&0^!/^\"w^*A^*F^*Q^!u^,z^,z^(~^+e^&Z^%]^\"p^#H^,r^.O^'(^'W^.(^*A ",
      "encoded_base64": "XitfXiYwXiEvXiJ3XipBXipGXipRXiF1Xix6Xix6Xih+XitlXiZaXiVdXiJwXiNIXixyXi5PXicoXidXXi4oXipBIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_6f131fba8fec",
      "text": "並聽到了大軍行進時大地深處傳來的沉悶轟鳴。",
      "encoded_ascii": "^!+^-X^!u^*D^\"z^..^(;^(w^$f^\"z^\"e^2*^(,^+$^!O^&Z^%Z^<i^.y^.|^!\"",
      "encoded_base64": "XiErXi1YXiF1XipEXiJ6Xi4uXig7Xih3XiRmXiJ6XiJlXjIqXigsXiskXiFPXiZaXiVaXjxpXi55Xi58XiEi",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_ef9fcdd53914",
      "text": "成批的城邦軍隊封鎖了大門。在遠處， ",
      "encoded_ascii": "^$$^2i^&Z^+_^1a^..^)U^#5^)8^*D^\"z^)D^!\"^\"d^({^(,^*A ",
      "encoded_base64": "XiQkXjJpXiZaXitfXjFhXi4uXilVXiM1Xik4XipEXiJ6XilEXiEiXiJkXih7XigsXipBIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_c99f845f491e",
      "text": " 望見德拉吉主力大軍的上空升起遮天蔽日的 ",
      "encoded_ascii": " ^,]^-m^#j^$6^\"D^!-^!~^\"z^..^&Z^!'^'(^\",^.(^(~^+e^('^$a^&Z ",
      "encoded_base64": "IF4sXV4tbV4jal4kNl4iRF4hLV4hfl4iel4uLl4mWl4hJ14nKF4iLF4uKF4ofl4rZV4oJ14kYV4mWiA=",
      "byte_length": 59
    },
    {
      "unit_id": "DLG_a04c74ea9bea",
      "text": "漫天煙塵。",
      "encoded_ascii": "^2,^+e^4S^\"p^!\"",
      "encoded_base64": "XjIsXitlXjRTXiJwXiEi",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_da948cd87082",
      "text": "當炙熱的炭火散發出滾滾熱浪時， ",
      "encoded_ascii": "^&N^7=^&$^&Z^?O^%x^$S^&W^!q^,z^,z^&$^,r^$f^*A ",
      "encoded_base64": "XiZOXjc9XiYkXiZaXj9PXiV4XiRTXiZXXiFxXix6Xix6XiYkXixyXiRmXipBIA==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_24bc1a6de2f3",
      "text": " 正用力對著風箱鼓風。",
      "encoded_ascii": " ^%H^&H^!~^#:^-a^)y^'/^*<^)y^!\"",
      "encoded_base64": "IF4lSF4mSF4hfl4jOl4tYV4peV4nL14qPF4peV4hIg==",
      "byte_length": 31
    },
    {
      "unit_id": "DLG_1f9d44aec6f1",
      "text": " 將金屬棍在熾熱的炭火中反覆翻攪，直到它變得通紅軟化。",
      "encoded_ascii": " ^#7^)+^#C^%0^\"d^20^&$^&Z^?O^%x^!,^\"9^(D^-Q^*c^*A^&`^!u^+o^(U^#e^(t^3!^.x^\")^!\"",
      "encoded_base64": "IF4jN14pK14jQ14lMF4iZF4yMF4mJF4mWl4/T14leF4hLF4iOV4oRF4tUV4qY14qQV4mYF4hdV4rb14oVV4jZV4odF4zIV4ueF4iKV4hIg==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_aaf4939dafce",
      "text": "鍛造爐火候不夠，無法妥善加熱金屬棍。",
      "encoded_ascii": "^1c^(v^&,^%x^*|^!)^+d^*A^%}^%b^5C^1(^\"\"^&$^)+^#C^%0^!\"",
      "encoded_base64": "XjFjXih2XiYsXiV4Xip8XiEpXitkXipBXiV9XiViXjVDXjEoXiIiXiYkXikrXiNDXiUwXiEi",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_f68d2c80851d",
      "text": " 奮力捶打金屬，將其鍛打塑造成一把武器。",
      "encoded_ascii": " ^+g^!~^/d^$-^)+^#C^*A^#7^!j^1c^$-^1s^(v^$$^!%^$1^%J^\"V^!\"",
      "encoded_base64": "IF4rZ14hfl4vZF4kLV4pK14jQ14qQV4jN14hal4xY14kLV4xc14odl4kJF4hJV4kMV4lSl4iVl4hIg==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_49bddbdfa204",
      "text": " 敲打著鐵砧，但只能在金屬上砸出些微的凹痕。",
      "encoded_ascii": " ^1A^$-^-a^)?^&m^*A^!I^\"?^'b^\"d^)+^#C^!'^0#^!q^!8^#i^&Z^>]^3v^!\"",
      "encoded_base64": "IF4xQV4kLV4tYV4pP14mbV4qQV4hSV4iP14nYl4iZF4pK14jQ14hJ14wI14hcV4hOF4jaV4mWl4+XV4zdl4hIg==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_0954bbf3c327",
      "text": " 搖晃著占卜獸骨，任由它們隨意散落在地。",
      "encoded_ascii": " ^3J^=:^-a^54^53^&<^*$^*A^!C^&I^+o^*{^)X^#z^$S^-`^\"d^\"e^!\"",
      "encoded_base64": "IF4zSl49Ol4tYV41NF41M14mPF4qJF4qQV4hQ14mSV4rb14qe14pWF4jel4kU14tYF4iZF4iZV4hIg==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_f63c22673ab7",
      "text": " 預言者湊上前來仔細端詳骨相卦象。",
      "encoded_ascii": " ^.E^1Y^'V^77^!'^!z^!O^6I^'?^5o^6v^*$^&a^?G^4g^!\"",
      "encoded_base64": "IF4uRV4xWV4nVl43N14hJ14hel4hT142SV4nP141b142dl4qJF4mYV4/R140Z14hIg==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_5478717b18bf",
      "text": "正如你所見，命運女神此番向你的氣數露出了微笑——儘管厄運 ",
      "encoded_ascii": "^%H^#$^*F^$)^-m^*A^\"N^.4^#\"^&w^%I^2{^+?^*F^&Z^%U^$V^.B^!q^*D^#i^-@^*n^*n^+(^-D^80^.4 ",
      "encoded_base64": "XiVIXiMkXipGXiQpXi1tXipBXiJOXi40XiMiXiZ3XiVJXjJ7Xis/XipGXiZaXiVVXiRWXi5CXiFxXipEXiNpXi1AXipuXipuXisoXi1EXjgwXi40IA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_c1f5300da237",
      "text": "無疑也同樣在前方等候著你！",
      "encoded_ascii": "^%}^0p^!1^\"E^,f^\"d^!z^$]^'-^*|^-a^*F^*W",
      "encoded_base64": "XiV9XjBwXiExXiJFXixmXiJkXiF6XiRdXictXip8Xi1hXipGXipX",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_2a71d28a21c2",
      "text": "喂！那是箭術靶子。要射箭就射，不射就別碰。 ",
      "encoded_ascii": "^;c^*W^)!^,X^'.^(<^)l^#(^!\"^(C^#6^'.^*J^#6^*A^!)^#6^*J^*H^-5^!\" ",
      "encoded_base64": "XjtjXipXXikhXixYXicuXig8XilsXiMoXiEiXihDXiM2XicuXipKXiM2XipBXiEpXiM2XipKXipIXi01XiEiIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_722cd6adf672",
      "text": "我可不能讓你們平白毀壞這麼貴重的東西。",
      "encoded_ascii": "^$%^\"A^!)^'b^-}^*F^*{^0Y^&X^%N^\"v^(s^.T^2F^))^&Z^,`^-l^!\"",
      "encoded_base64": "XiQlXiJBXiEpXidiXi19XipGXip7XjBZXiZYXiVOXiJ2XihzXi5UXjJGXikpXiZaXixgXi1sXiEi",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_6854f4f562e7",
      "text": " 在這個距離下幾乎絕不可能射偏。 ",
      "encoded_ascii": " ^\"d^(s^!V^2I^)`^!(^#T^!0^-I^!)^\"A^'b^#6^![^!\" ",
      "encoded_base64": "IF4iZF4oc14hVl4ySV4pYF4hKF4jVF4hMF4tSV4hKV4iQV4nYl4jNl4hW14hIiA=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_1f7bc48ff720",
      "text": " 穩穩釘入了紅心。",
      "encoded_ascii": " ^-;^-;^),^!f^*D^3!^#k^!\"",
      "encoded_base64": "IF4tO14tO14pLF4hZl4qRF4zIV4ja14hIg==",
      "byte_length": 25
    },
    {
      "unit_id": "DLG_4187f5f03afa",
      "text": " 咚地一聲射中",
      "encoded_ascii": " ^?H^\"e^!%^-W^#6^!,",
      "encoded_base64": "IF4/SF4iZV4hJV4tV14jNl4hLA==",
      "byte_length": 19
    },
    {
      "unit_id": "DLG_c3dab26f1a18",
      "text": " 擊中",
      "encoded_ascii": " ^$F^!,",
      "encoded_base64": "IF4kRl4hLA==",
      "byte_length": 7
    },
    {
      "unit_id": "DLG_a9ce79988add",
      "text": " 釘入",
      "encoded_ascii": " ^),^!f",
      "encoded_base64": "IF4pLF4hZg==",
      "byte_length": 7
    },
    {
      "unit_id": "DLG_cbb263558cfa",
      "text": " 外圈",
      "encoded_ascii": " ^\"w^\"_",
      "encoded_base64": "IF4id14iXw==",
      "byte_length": 7
    },
    {
      "unit_id": "DLG_5d5e12dab32e",
      "text": " 內圈",
      "encoded_ascii": " ^!g^\"_",
      "encoded_base64": "IF4hZ14iXw==",
      "byte_length": 7
    },
    {
      "unit_id": "DLG_efbbc49ba614",
      "text": " 的靶環。",
      "encoded_ascii": " ^&Z^)l^&B^!\"",
      "encoded_base64": "IF4mWl4pbF4mQl4hIg==",
      "byte_length": 13
    },
    {
      "unit_id": "DLG_506e40b45db7",
      "text": " 箭矢不偏不倚正中靶心！",
      "encoded_ascii": " ^'.^&g^!)^![^!)^0~^%H^!,^)l^#k^*W",
      "encoded_base64": "IF4nLl4mZ14hKV4hW14hKV4wfl4lSF4hLF4pbF4ja14qVw==",
      "byte_length": 34
    },
    {
      "unit_id": "DLG_7aa85f82e10d",
      "text": "正中靶心！",
      "encoded_ascii": "^%H^!,^)l^#k^*W",
      "encoded_base64": "XiVIXiEsXilsXiNrXipX",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_3dddebf42e2e",
      "text": "我已經好多年沒見過如此神準的箭術了！拿去吧， ",
      "encoded_ascii": "^$%^#J^'D^+i^\"x^+~^%\\^-m^(x^#$^%I^&w^,x^&Z^'.^(<^*D^*W^,G^\"6^*I^*A ",
      "encoded_base64": "XiQlXiNKXidEXitpXiJ4Xit+XiVcXi1tXih4XiMkXiVJXiZ3Xix4XiZaXicuXig8XipEXipXXixHXiI2XipJXipBIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_5c0e7f0e2a21",
      "text": "為了讚賞你無與倫比的 ",
      "encoded_ascii": "^%{^*D^8'^*T^*F^%}^'p^/!^,m^&Z ",
      "encoded_base64": "XiV7XipEXjgnXipUXipGXiV9XidwXi8hXixtXiZaIA==",
      "byte_length": 31
    },
    {
      "unit_id": "DLG_fb8d0a3971e1",
      "text": "精湛箭術，這些箭矢就贈予你了。",
      "encoded_ascii": "^'7^<o^'.^(<^*A^(s^!8^'.^&g^*J^([^!4^*F^*D^!\"",
      "encoded_base64": "Xic3XjxvXicuXig8XipBXihzXiE4XicuXiZnXipKXihbXiE0XipGXipEXiEi",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_73f94716ebbd",
      "text": " 紅心！",
      "encoded_ascii": " ^3!^#k^*W",
      "encoded_base64": "IF4zIV4ja14qVw==",
      "byte_length": 10
    },
    {
      "unit_id": "DLG_b7c928577f15",
      "text": "射出的箭矢 ",
      "encoded_ascii": "^#6^!q^&Z^'.^&g ",
      "encoded_base64": "XiM2XiFxXiZaXicuXiZnIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_a9bf2fe2b297",
      "text": "偏高了。",
      "encoded_ascii": "^![^*+^*D^!\"",
      "encoded_base64": "XiFbXiorXipEXiEi",
      "byte_length": 12
    },
    {
      "unit_id": "DLG_3b771e09083c",
      "text": "嚴重偏離了靶心。",
      "encoded_ascii": "^1*^))^![^)`^*D^)l^#k^!\"",
      "encoded_base64": "XjEqXikpXiFbXilgXipEXilsXiNrXiEi",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_7f05f26dadb8",
      "text": "直接栽進了沙地裡。",
      "encoded_ascii": "^&`^$?^?J^(w^*D^%]^\"e^-j^!\"",
      "encoded_base64": "XiZgXiQ/Xj9KXih3XipEXiVdXiJlXi1qXiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_a4c7104bc63d",
      "text": "她",
      "encoded_ascii": "^+h",
      "encoded_base64": "Xito",
      "byte_length": 3
    },
    {
      "unit_id": "DLG_4e72cc35a4c7",
      "text": "我有什麼能為你們效勞的？",
      "encoded_ascii": "^$%^$s^!=^.T^'b^%{^*F^*{^$Q^/R^&Z^.V",
      "encoded_base64": "XiQlXiRzXiE9Xi5UXidiXiV7XipGXip7XiRRXi9SXiZaXi5W",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_57770a0633b6",
      "text": "至今還沒聽說關於你們那個同盟的半點消息， ",
      "encoded_ascii": "^'n^*E^.7^%\\^-X^-x^.>^$^^*F^*{^)!^!V^\"E^-0^&Z^\"-^*;^%k^#w^*A ",
      "encoded_base64": "XiduXipFXi43XiVcXi1YXi14Xi4+XiReXipGXip7XikhXiFWXiJFXi0wXiZaXiItXio7XiVrXiN3XipBIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_c8ee63baf5e6",
      "text": "但德拉吉那邊倒是確實集結起了一支龐大的軍隊。",
      "encoded_ascii": "^!I^#j^$6^\"D^)!^.8^!X^,X^-6^#3^)]^'@^.(^*D^!%^$L^6H^\"z^&Z^..^)U^!\"",
      "encoded_base64": "XiFJXiNqXiQ2XiJEXikhXi44XiFYXixYXi02XiMzXildXidAXi4oXipEXiElXiRMXjZIXiJ6XiZaXi4uXilVXiEi",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_3736ede0bdcf",
      "text": "你們立下的功績簡直令人難以置信！我想亞薩斯從未見過像你們這樣的英雄。看來那則預言 ",
      "encoded_ascii": "^*F^*{^0'^!(^&Z^\"!^?P^3y^&`^*w^!<^)a^!B^'Q^!U^*W^$%^,1^!9^-e^$[^#f^,_^-m^(x^!`^*F^*{^(s^,f^&Z^'y^)\\^!\"^*Q^!O^)!^!x^.E^1Y ",
      "encoded_base64": "XipGXip7XjAnXiEoXiZaXiIhXj9QXjN5XiZgXip3XiE8XilhXiFCXidRXiFVXipXXiQlXiwxXiE5Xi1lXiRbXiNmXixfXi1tXih4XiFgXipGXip7XihzXixmXiZaXid5XilcXiEiXipRXiFPXikhXiF4Xi5FXjFZIA==",
      "byte_length": 121
    },
    {
      "unit_id": "DLG_a9d0a79dada8",
      "text": "說得一點沒錯，對吧？能由你們統領指揮，我深感榮幸！",
      "encoded_ascii": "^-x^#e^!%^*;^%\\^)5^*A^#:^*I^.V^'b^&I^*F^*{^'B^)s^$8^2\"^*A^$%^2*^#{^,e^15^*W",
      "encoded_base64": "Xi14XiNlXiElXio7XiVcXik1XipBXiM6XipJXi5WXidiXiZJXipGXip7XidCXilzXiQ4XjIiXipBXiQlXjIqXiN7XixlXjE1XipX",
      "byte_length": 75
    },
    {
      "unit_id": "DLG_972525d18e3e",
      "text": "祝你們好運。",
      "encoded_ascii": "^&v^*F^*{^+i^.4^!\"",
      "encoded_base64": "XiZ2XipGXip7XitpXi40XiEi",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_0f2d22da566b",
      "text": "你們這麼快就回來了？",
      "encoded_ascii": "^*F^*{^(s^.T^*L^*J^\"\\^!O^*D^.V",
      "encoded_base64": "XipGXip7XihzXi5UXipMXipKXiJcXiFPXipEXi5W",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_8764c4bb0d02",
      "text": "我還以為你們正忙著拯救亞薩斯、實現那則預言呢。",
      "encoded_ascii": "^$%^.7^!B^%{^*F^*{^%H^,+^-a^,F^,Q^!9^-e^$[^!!^#3^&?^)!^!x^.E^1Y^+C^!\"",
      "encoded_base64": "XiQlXi43XiFCXiV7XipGXip7XiVIXiwrXi1hXixGXixRXiE5Xi1lXiRbXiEhXiMzXiY/XikhXiF4Xi5FXjFZXitDXiEi",
      "byte_length": 69
    },
    {
      "unit_id": "DLG_f49c9c3245ad",
      "text": "如果你們打算吃白食，我們這裡可不歡迎閒人。",
      "encoded_ascii": "^#$^%!^*F^*{^$-^-C^2^^&X^0J^*A^$%^*{^(s^-j^\"A^!)^%F^(k^6A^!<^!\"",
      "encoded_base64": "XiMkXiUhXipGXip7XiQtXi1DXjJeXiZYXjBKXipBXiQlXip7XihzXi1qXiJBXiEpXiVGXihrXjZBXiE8XiEi",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_afc455c7c431",
      "text": "提奎茲爾大難臨頭了！我們根本沒有強大的盟友，而德拉吉大軍 ",
      "encoded_ascii": "^$A^5B^/D^&/^\"z^)a^1U^)t^*D^*W^$%^*{^%)^$x^%\\^$s^#]^\"z^&Z^-0^\"8^*A^'W^#j^$6^\"D^\"z^.. ",
      "encoded_base64": "XiRBXjVCXi9EXiYvXiJ6XilhXjFVXil0XipEXipXXiQlXip7XiUpXiR4XiVcXiRzXiNdXiJ6XiZaXi0wXiI4XipBXidXXiNqXiQ2XiJEXiJ6Xi4uIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_a06bb9d3e0a1",
      "text": "已經開拔出征。我們剩下的壽命只能按鐘點來計算了！",
      "encoded_ascii": "^#J^'D^)F^/c^!q^.c^!\"^$%^*{^8U^!(^&Z^?=^\"N^\"?^'b^$9^9y^*;^!O^-n^-C^*D^*W",
      "encoded_base64": "XiNKXidEXilGXi9jXiFxXi5jXiEiXiQlXip7XjhVXiEoXiZaXj89XiJOXiI/XidiXiQ5Xjl5Xio7XiFPXi1uXi1DXipEXipX",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_1955a0a48f2d",
      "text": "。但要是",
      "encoded_ascii": "^!\"^!I^(C^,X",
      "encoded_base64": "XiEiXiFJXihDXixY",
      "byte_length": 12
    },
    {
      "unit_id": "DLG_64a90fd11c4a",
      "text": "長老議會想要見見你們。 ",
      "encoded_ascii": "^)C^'U^-|^$r^,1^(C^-m^-m^*F^*{^!\" ",
      "encoded_base64": "XilDXidVXi18XiRyXiwxXihDXi1tXi1tXipGXip7XiEiIA==",
      "byte_length": 34
    },
    {
      "unit_id": "DLG_6f6041bdb5e5",
      "text": " 加入你們的同盟——雖然這根本無濟於事。德拉吉的軍隊實在太龐大了。",
      "encoded_ascii": " ^\"\"^!f^*F^*{^&Z^\"E^-0^*n^*n^.A^&\"^(s^%)^$x^%}^?N^$^^*r^!\"^#j^$6^\"D^&Z^..^)U^#3^\"d^+f^6H^\"z^*D^!\"",
      "encoded_base64": "IF4iIl4hZl4qRl4qe14mWl4iRV4tMF4qbl4qbl4uQV4mIl4oc14lKV4keF4lfV4/Tl4kXl4qcl4hIl4jal4kNl4iRF4mWl4uLl4pVV4jM14iZF4rZl42SF4iel4qRF4hIg==",
      "byte_length": 97
    },
    {
      "unit_id": "DLG_7736e1232a51",
      "text": "探子剛從 ",
      "encoded_ascii": "^$>^#(^+0^#f ",
      "encoded_base64": "XiQ+XiMoXiswXiNmIA==",
      "byte_length": 13
    },
    {
      "unit_id": "DLG_07aef90b0919",
      "text": " 抵達，並告訴我們他們加入了你們的同盟。真不知這能管什麼用。",
      "encoded_ascii": " ^$5^(z^*A^!+^+B^-t^$%^*{^!@^*{^\"\"^!f^*D^*F^*{^&Z^\"E^-0^!\"^-2^!)^&h^(s^'b^-D^!=^.T^&H^!\"",
      "encoded_base64": "IF4kNV4oel4qQV4hK14rQl4tdF4kJV4qe14hQF4qe14iIl4hZl4qRF4qRl4qe14mWl4iRV4tMF4hIl4tMl4hKV4maF4oc14nYl4tRF4hPV4uVF4mSF4hIg==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_07b3351b2317",
      "text": "缺少了 ",
      "encoded_ascii": "^7e^#<^*D ",
      "encoded_base64": "XjdlXiM8XipEIA==",
      "byte_length": 10
    },
    {
      "unit_id": "DLG_47dabdb4bb91",
      "text": "的戰士助陣，我們面對德拉吉大軍根本毫無勝算。",
      "encoded_ascii": "^&Z^$(^+a^\"#^)P^*A^$%^*{^)j^#:^#j^$6^\"D^\"z^..^%)^$x^/t^%}^+5^-C^!\"",
      "encoded_base64": "XiZaXiQoXithXiIjXilQXipBXiQlXip7XilqXiM6XiNqXiQ2XiJEXiJ6Xi4uXiUpXiR4Xi90XiV9Xis1Xi1DXiEi",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_6a7b429fd0e9",
      "text": "我真不敢相信你們居然真的說服了 ",
      "encoded_ascii": "^$%^-2^!)^/m^&a^!U^*F^*{^+w^&\"^-2^&Z^-x^,\\^*D ",
      "encoded_base64": "XiQlXi0yXiEpXi9tXiZhXiFVXipGXip7Xit3XiYiXi0yXiZaXi14XixcXipEIA==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_b2a428916b54",
      "text": "你們來提奎茲爾有何貴幹？",
      "encoded_ascii": "^*F^*{^!O^$A^5B^/D^&/^$s^!L^2F^,!^.V",
      "encoded_base64": "XipGXip7XiFPXiRBXjVCXi9EXiYvXiRzXiFMXjJGXiwhXi5W",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_b6bce0b4553c",
      "text": "  我有要事找加林神父。",
      "encoded_ascii": "  ^$%^$s^(C^*r^$/^\"\"^/1^&w^5d^!\"",
      "encoded_base64": "ICBeJCVeJHNeKENeKnJeJC9eIiJeLzFeJndeNWReISI=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_afe77d235287",
      "text": "  我想見你們的領袖。",
      "encoded_ascii": "  ^$%^,1^-m^*F^*{^&Z^)s^7G^!\"",
      "encoded_base64": "ICBeJCVeLDFeLW1eKkZeKnteJlpeKXNeN0deISI=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_12ece3c5fec7",
      "text": "  我只是想弄點水喝。",
      "encoded_ascii": "  ^$%^\"?^,X^,1^/`^*;^%V^6M^!\"",
      "encoded_base64": "ICBeJCVeIj9eLFheLDFeL2BeKjteJVZeNk1eISI=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_923dcb5b8c7c",
      "text": "是嗎？這對我而言有什麼特別意義嗎？",
      "encoded_ascii": "^,X^+X^.V^(s^#:^$%^'W^1Y^$s^!=^.T^&5^*H^#z^2<^+X^.V",
      "encoded_base64": "XixYXitYXi5WXihzXiM6XiQlXidXXjFZXiRzXiE9Xi5UXiY1XipIXiN6XjI8XitYXi5W",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_a9850e1f2800",
      "text": "你找他有什麼事要談？",
      "encoded_ascii": "^*F^$/^!@^$s^!=^.T^*r^(C^0;^.V",
      "encoded_base64": "XipGXiQvXiFAXiRzXiE9Xi5UXipyXihDXjA7Xi5W",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_9722060d3178",
      "text": "  那是私事。",
      "encoded_ascii": "  ^)!^,X^&~^*r^!\"",
      "encoded_base64": "ICBeKSFeLFheJn5eKnJeISI=",
      "byte_length": 17
    },
    {
      "unit_id": "DLG_bc23cdbbc95a",
      "text": "  我有筆買賣想跟他商談。",
      "encoded_ascii": "  ^$%^$s^-A^.!^.$^,1^.+^!@^1'^0;^!\"",
      "encoded_base64": "ICBeJCVeJHNeLUFeLiFeLiReLDFeLiteIUBeMSdeMDteISI=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_0f376b4bc730",
      "text": "你們該知道，水可不是白給的。取水費是五十枚陶幣。你們付得起嗎？",
      "encoded_ascii": "^*F^*{^(M^&h^(y^*A^%V^\"A^!)^,X^&X^'A^&Z^!\"^\":^%V^.\"^,X^!6^*Y^$~^)R^+|^!\"^*F^*{^*u^#e^.(^+X^.V",
      "encoded_base64": "XipGXip7XihNXiZoXih5XipBXiVWXiJBXiEpXixYXiZYXidBXiZaXiEiXiI6XiVWXi4iXixYXiE2XipZXiR+XilSXit8XiEiXipGXip7Xip1XiNlXi4oXitYXi5W",
      "byte_length": 93
    },
    {
      "unit_id": "DLG_877375d86ee3",
      "text": "水井就在鎮子正中央。",
      "encoded_ascii": "^%V^!7^*J^\"d^);^#(^%H^!,^5@^!\"",
      "encoded_base64": "XiVWXiE3XipKXiJkXik7XiMoXiVIXiEsXjVAXiEi",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_933cb3d174be",
      "text": "等你們湊夠了錢再來吧。",
      "encoded_ascii": "^'-^*F^*{^77^+d^*D^.<^!l^!O^*I^!\"",
      "encoded_base64": "XictXipGXip7Xjc3XitkXipEXi48XiFsXiFPXipJXiEi",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_ddb929a690f2",
      "text": "提奎茲爾雖然是座愛好和平的村莊，但要是你們不收斂一下態度，我們當場就宰了你們！",
      "encoded_ascii": "^$A^5B^/D^&/^.A^&\"^,X^/_^,2^+i^\"O^0Y^&Z^$z^6l^*A^!I^(C^,X^*F^*{^!)^$M^?I^!%^!(^#|^#V^*A^$%^*{^&N^\"n^*J^1w^*D^*F^*{^*W",
      "encoded_base64": "XiRBXjVCXi9EXiYvXi5BXiYiXixYXi9fXiwyXitpXiJPXjBZXiZaXiR6XjZsXipBXiFJXihDXixYXipGXip7XiEpXiRNXj9JXiElXiEoXiN8XiNWXipBXiQlXip7XiZOXiJuXipKXjF3XipEXipGXip7XipX",
      "byte_length": 117
    },
    {
      "unit_id": "DLG_bc3b085680d3",
      "text": "我就暫且相信你的話，但只要敢耍任何花樣，你們就只有死路一條。 ",
      "encoded_ascii": "^$%^*J^$l^!*^&a^!U^*F^&Z^-v^*A^!I^\"?^(C^/m^7E^!C^!L^'w^,f^*A^*F^*{^*J^\"?^$s^%L^(a^!%^%.^!\" ",
      "encoded_base64": "XiQlXipKXiRsXiEqXiZhXiFVXipGXiZaXi12XipBXiFJXiI/XihDXi9tXjdFXiFDXiFMXid3XixmXipBXipGXip7XipKXiI/XiRzXiVMXihhXiElXiUuXiEiIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_5ff7a9b09a70",
      "text": "記得也去向我們的長老首領報到。",
      "encoded_ascii": "^(K^#e^!1^\"6^+?^$%^*{^&Z^)C^'U^)~^)s^+`^!u^!\"",
      "encoded_base64": "XihLXiNlXiExXiI2Xis/XiQlXip7XiZaXilDXidVXil+XilzXitgXiF1XiEi",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_fa6beaa15b28",
      "text": "  你必須放我進去。官兵正在追捕我。",
      "encoded_ascii": "  ^*F^#l^)r^$P^$%^(w^\"6^!\"^#-^+,^%H^\"d^(o^4?^$%^!\"",
      "encoded_base64": "ICBeKkZeI2xeKXJeJFBeJCVeKHdeIjZeISJeIy1eKyxeJUheImReKG9eND9eJCVeISI=",
      "byte_length": 50
    },
    {
      "unit_id": "DLG_cd7a7f17f2d5",
      "text": "  我不想惹麻煩，只想找個地方歇腳。",
      "encoded_ascii": "  ^$%^!)^,1^3s^*6^-!^*A^\"?^,1^$/^!V^\"e^$]^%E^00^!\"",
      "encoded_base64": "ICBeJCVeISleLDFeM3NeKjZeLSFeKkFeIj9eLDFeJC9eIVZeImVeJF1eJUVeMDBeISI=",
      "byte_length": 50
    },
    {
      "unit_id": "DLG_fae8749a1932",
      "text": "  滾開，嘴巴比坎克蟲還臭的傢伙！",
      "encoded_ascii": "  ^,z^)F^*A^+[^#K^,m^/%^!d^(8^.7^'m^&Z^+#^*y^*W",
      "encoded_base64": "ICBeLHpeKUZeKkFeK1teI0teLG1eLyVeIWReKDheLjdeJ21eJlpeKyNeKnleKlc=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_57c71e99dbee",
      "text": "既然你這麼說的話。",
      "encoded_ascii": "^,U^&\"^*F^(s^.T^-x^&Z^-v^!\"",
      "encoded_base64": "XixVXiYiXipGXihzXi5UXi14XiZaXi12XiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_57d634be8eda",
      "text": "我們通常只管自己的事，但如果你們是來辦公事的，",
      "encoded_ascii": "^$%^*{^(t^#O^\"?^-D^'l^#I^&Z^*r^*A^!I^#$^%!^*F^*{^,X^!O^2L^3:^*r^&Z^*A",
      "encoded_base64": "XiQlXip7Xih0XiNPXiI/Xi1EXidsXiNJXiZaXipyXipBXiFJXiMkXiUhXipGXip7XixYXiFPXjJMXjM6XipyXiZaXipB",
      "byte_length": 69
    },
    {
      "unit_id": "DLG_a3db165d45f2",
      "text": "長老議會就在大廳召開會議。那是鎮子北邊的大建築物—— ",
      "encoded_ascii": "^)C^'U^-|^$r^*J^\"d^\"z^0\\^\"@^)F^$r^-|^!\"^)!^,X^);^#(^+6^.8^&Z^\"z^,'^8;^&4^*n^*n ",
      "encoded_base64": "XilDXidVXi18XiRyXipKXiJkXiJ6XjBcXiJAXilGXiRyXi18XiEiXikhXixYXik7XiMoXis2Xi44XiZaXiJ6XiwnXjg7XiY0XipuXipuIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_d3cf2e7a65a9",
      "text": "很好找，絕不會錯過。我們的領袖查爾就在那裡。",
      "encoded_ascii": "^*K^+i^$/^*A^-I^!)^$r^)5^(x^!\"^$%^*{^&Z^)s^7G^%&^&/^*J^\"d^)!^-j^!\"",
      "encoded_base64": "XipLXitpXiQvXipBXi1JXiEpXiRyXik1Xih4XiEiXiQlXip7XiZaXilzXjdHXiUmXiYvXipKXiJkXikhXi1qXiEi",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_c97c120bcc48",
      "text": "你會為這句話丟掉小命！",
      "encoded_ascii": "^*F^$r^%{^(s^2]^-v^*q^/e^#;^\"N^*W",
      "encoded_base64": "XipGXiRyXiV7XihzXjJdXi12XipxXi9lXiM7XiJOXipX",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_025de627803d",
      "text": "  你的態度真惡劣！",
      "encoded_ascii": "  ^*F^&Z^#|^#V^-2^#y^+2^*W",
      "encoded_base64": "ICBeKkZeJlpeI3xeI1ZeLTJeI3leKzJeKlc=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_6a919d0352bc",
      "text": "  戰事備戰進展如何？",
      "encoded_ascii": "  ^$(^*r^+\"^$(^(w^+x^#$^!L^.V",
      "encoded_base64": "ICBeJCheKnJeKyJeJCheKHdeK3heIyReIUxeLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_500717c7daba",
      "text": "  跟我說說你們這座村莊吧。",
      "encoded_ascii": "  ^.+^$%^-x^-x^*F^*{^(s^/_^$z^6l^*I^!\"",
      "encoded_base64": "ICBeLiteJCVeLXheLXheKkZeKnteKHNeL19eJHpeNmxeKkleISI=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_5693da1a1bcb",
      "text": "  關於村裡的領袖，你知道些什麼？",
      "encoded_ascii": "  ^.>^$^^$z^-j^&Z^)s^7G^*A^*F^&h^(y^!8^!=^.T^.V",
      "encoded_base64": "ICBeLj5eJF5eJHpeLWpeJlpeKXNeN0deKkFeKkZeJmheKHleITheIT1eLlReLlY=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_90a36d68aa4d",
      "text": "我們比起大多數逃奴村落都要富足，但要是你 ",
      "encoded_ascii": "^$%^*{^,m^.(^\"z^\"x^$V^(p^##^$z^-`^)$^(C^3C^(^^*A^!I^(C^,X^*F ",
      "encoded_base64": "XiQlXip7XixtXi4oXiJ6XiJ4XiRWXihwXiMjXiR6Xi1gXikkXihDXjNDXiheXipBXiFJXihDXixYXipGIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_4ee89ba469dc",
      "text": "相信那位預言者的話，我們恐怕也逍遙不了多久了。",
      "encoded_ascii": "^&a^!U^)!^!J^.E^1Y^'V^&Z^-v^*A^$%^*{^#t^0^^!1^?Q^4j^!)^*D^\"x^!.^*D^!\"",
      "encoded_base64": "XiZhXiFVXikhXiFKXi5FXjFZXidWXiZaXi12XipBXiQlXip7XiN0XjBeXiExXj9RXjRqXiEpXipEXiJ4XiEuXipEXiEi",
      "byte_length": 69
    },
    {
      "unit_id": "DLG_380589ebbd6b",
      "text": "  那位預言者究竟是誰？",
      "encoded_ascii": "  ^)!^!J^.E^1Y^'V^-<^28^,X^-y^.V",
      "encoded_base64": "ICBeKSFeIUpeLkVeMVleJ1ZeLTxeMjheLFheLXleLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_17936d63c3e8",
      "text": "  先知說了些什麼？",
      "encoded_ascii": "  ^!b^&h^-x^*D^!8^!=^.T^.V",
      "encoded_base64": "ICBeIWJeJmheLXheKkReITheIT1eLlReLlY=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_b4f2c285b6f2",
      "text": "  為什麼村子會這麼富足？",
      "encoded_ascii": "  ^%{^!=^.T^$z^#(^$r^(s^.T^3C^(^^.V",
      "encoded_base64": "ICBeJXteIT1eLlReJHpeIyheJHJeKHNeLlReM0NeKF5eLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_7552c741d700",
      "text": "  多米尼是誰？",
      "encoded_ascii": "  ^\"x^'4^#>^,X^-y^.V",
      "encoded_base64": "ICBeInheJzReIz5eLFheLXleLlY=",
      "byte_length": 20
    },
    {
      "unit_id": "DLG_2038620512e2",
      "text": "我們的領袖查爾待我們相當不錯。反應雖然有些 ",
      "encoded_ascii": "^$%^*{^&Z^)s^7G^%&^&/^,*^$%^*{^&a^&N^!)^)5^!\"^\"9^0`^.A^&\"^$s^!8 ",
      "encoded_base64": "XiQlXip7XiZaXilzXjdHXiUmXiYvXiwqXiQlXip7XiZhXiZOXiEpXik1XiEiXiI5XjBgXi5BXiYiXiRzXiE4IA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_9c746f07d732",
      "text": "遲鈍遲緩，但他勇武強悍，這點絕不會錯。",
      "encoded_ascii": "^.5^?R^.5^'J^*A^!I^!@^\"$^%J^#]^,-^*A^(s^*;^-I^!)^$r^)5^!\"",
      "encoded_base64": "Xi41Xj9SXi41XidKXipBXiFJXiFAXiIkXiVKXiNdXiwtXipBXihzXio7Xi1JXiEpXiRyXik1XiEi",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_33a0992d9310",
      "text": "  查爾為何會成為領袖？",
      "encoded_ascii": "  ^%&^&/^%{^!L^$r^$$^%{^)s^7G^.V",
      "encoded_base64": "ICBeJSZeJi9eJXteIUxeJHJeJCReJXteKXNeN0deLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_f4d5f5422f8a",
      "text": "  你說遲鈍是什麼意思？",
      "encoded_ascii": "  ^*F^-x^.5^?R^,X^!=^.T^#z^#q^.V",
      "encoded_base64": "ICBeKkZeLXheLjVeP1JeLFheIT1eLlReI3peI3FeLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_22de4c3be0ed",
      "text": "  那位副官又是怎麼回事？",
      "encoded_ascii": "  ^)!^!J^52^#-^+;^,X^,,^.T^\"\\^*r^.V",
      "encoded_base64": "ICBeKSFeIUpeNTJeIy1eKzteLFheLCxeLlReIlxeKnJeLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_eb4317ea8cd7",
      "text": "  你認得他的女兒嗎？",
      "encoded_ascii": "  ^*F^(O^#e^!@^&Z^#\"^++^+X^.V",
      "encoded_base64": "ICBeKkZeKE9eI2VeIUBeJlpeIyJeKyteK1heLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_f87119ca1016",
      "text": "情況糟得不能再糟了。等著我們的除了苦難還是苦難。",
      "encoded_ascii": "^,0^,q^-E^#e^!)^'b^!l^-E^*D^!\"^'-^-a^$%^*{^&Z^)Q^*D^.t^)a^.7^,X^.t^)a^!\"",
      "encoded_base64": "XiwwXixxXi1FXiNlXiEpXidiXiFsXi1FXipEXiEiXictXi1hXiQlXip7XiZaXilRXipEXi50XilhXi43XixYXi50XilhXiEi",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_f31d28fe5771",
      "text": "  德拉吉大軍有何動靜？",
      "encoded_ascii": "  ^#j^$6^\"D^\"z^..^$s^!L^\"%^)h^.V",
      "encoded_base64": "ICBeI2peJDZeIkReInpeLi5eJHNeIUxeIiVeKWheLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_a89bcc3857f6",
      "text": "  村民們的士氣如何？",
      "encoded_ascii": "  ^$z^%T^*{^&Z^+a^%U^#$^!L^.V",
      "encoded_base64": "ICBeJHpeJVReKnteJlpeK2FeJVVeIyReIUxeLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_4d9c2ee66554",
      "text": "我不過是實話實說罷了。",
      "encoded_ascii": "^$%^!)^(x^,X^#3^-v^#3^-x^1Q^*D^!\"",
      "encoded_base64": "XiQlXiEpXih4XixYXiMzXi12XiMzXi14XjFRXipEXiEi",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_26409917337a",
      "text": "這是個混亂凶險的世道。前頭沒什麼好事等著我們。",
      "encoded_ascii": "^(s^,X^!V^%n^!3^3e^*m^&Z^*p^(y^!\"^!z^)t^%\\^!=^.T^+i^*r^'-^-a^$%^*{^!\"",
      "encoded_base64": "XihzXixYXiFWXiVuXiEzXjNlXiptXiZaXipwXih5XiEiXiF6Xil0XiVcXiE9Xi5UXitpXipyXictXi1hXiQlXip7XiEi",
      "byte_length": 69
    },
    {
      "unit_id": "DLG_459b5caa6746",
      "text": "是嗎？哼，亞薩斯本來就不是什麼人間樂園。",
      "encoded_ascii": "^,X^+X^.V^+K^*A^!9^-e^$[^$x^!O^*J^!)^,X^!=^.T^!<^)G^%8^41^!\"",
      "encoded_base64": "XixYXitYXi5WXitLXipBXiE5Xi1lXiRbXiR4XiFPXipKXiEpXixYXiE9Xi5UXiE8XilHXiU4XjQxXiEi",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_da5d788e155e",
      "text": "不清楚。但準備把我們全宰光準沒錯！",
      "encoded_ascii": "^!)^,u^,c^!\"^!I^,x^+\"^$1^$%^*{^!h^1w^!c^,x^%\\^)5^*W",
      "encoded_base64": "XiEpXix1XixjXiEiXiFJXix4XisiXiQxXiQlXip7XiFoXjF3XiFjXix4XiVcXik1XipX",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_5b475e306d56",
      "text": "我猜那支大軍看到我們拼命組建奴隸義軍的樣子，一定笑掉了大牙。 ",
      "encoded_ascii": "^$%^-'^)!^$L^\"z^..^*Q^!u^$%^*{^;Z^\"N^2;^,'^##^)Z^2<^..^&Z^,f^#(^*A^!%^#.^-@^/e^*D^\"z^&3^!\" ",
      "encoded_base64": "XiQlXi0nXikhXiRMXiJ6Xi4uXipRXiF1XiQlXip7XjtaXiJOXjI7XiwnXiMjXilaXjI8Xi4uXiZaXixmXiMoXipBXiElXiMuXi1AXi9lXipEXiJ6XiYzXiEiIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_9b35e1b8a33a",
      "text": "德拉吉大軍踏平這些村落，就跟踩碎蟻丘一樣輕而易舉。",
      "encoded_ascii": "^#j^$6^\"D^\"z^..^.,^0Y^(s^!8^$z^-`^*A^*J^.+^0A^&o^=a^5(^!%^,f^(g^'W^,W^01^!\"",
      "encoded_base64": "XiNqXiQ2XiJEXiJ6Xi4uXi4sXjBZXihzXiE4XiR6Xi1gXipBXipKXi4rXjBBXiZvXj1hXjUoXiElXixmXihnXidXXixXXjAxXiEi",
      "byte_length": 75
    },
    {
      "unit_id": "DLG_83745207de98",
      "text": "德拉吉大軍就像獵食中的巨龍一樣，吐息已經噴到了我們的後頸！用不了 ",
      "encoded_ascii": "^#j^$6^\"D^\"z^..^*J^!`^&;^0J^!,^&Z^#H^*>^!%^,f^*A^\"G^#w^#J^'D^\"W^!u^*D^$%^*{^&Z^#b^>{^*W^&H^!)^*D ",
      "encoded_base64": "XiNqXiQ2XiJEXiJ6Xi4uXipKXiFgXiY7XjBKXiEsXiZaXiNIXio+XiElXixmXipBXiJHXiN3XiNKXidEXiJXXiF1XipEXiQlXip7XiZaXiNiXj57XipXXiZIXiEpXipEIA==",
      "byte_length": 97
    },
    {
      "unit_id": "DLG_2fa79ee03924",
      "text": "多久，我們的骸骨就會在烈日下曝曬風化了。",
      "encoded_ascii": "^\"x^!.^*A^$%^*{^&Z^*'^*$^*J^$r^\"d^%|^$a^!(^/o^,Z^)y^\")^*D^!\"",
      "encoded_base64": "XiJ4XiEuXipBXiQlXip7XiZaXionXiokXipKXiRyXiJkXiV8XiRhXiEoXi9vXixaXil5XiIpXipEXiEi",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_8f8afd6cff79",
      "text": "他們表現得就像是在過年中慶典一樣，以為你們的同盟能讓大家 ",
      "encoded_ascii": "^!@^*{^-i^&?^#e^*J^!`^,X^\"d^(x^+~^!,^5P^2W^!%^,f^*A^!B^%{^*F^*{^&Z^\"E^-0^'b^-}^\"z^+s ",
      "encoded_base64": "XiFAXip7Xi1pXiY/XiNlXipKXiFgXixYXiJkXih4Xit+XiEsXjVQXjJXXiElXixmXipBXiFCXiV7XipGXip7XiZaXiJFXi0wXidiXi19XiJ6XitzIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_5caafc622005",
      "text": "過上好日子。腦袋裝沙！這群人全都是蠢貨。",
      "encoded_ascii": "^(x^!'^+i^$a^#(^!\"^2@^(?^(A^%]^*W^(s^'R^!<^!h^)$^,X^.u^.w^!\"",
      "encoded_base64": "Xih4XiEnXitpXiRhXiMoXiEiXjJAXig/XihBXiVdXipXXihzXidSXiE8XiFoXikkXixYXi51Xi53XiEi",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_d8b6e360b481",
      "text": "那些蠢蛋沉醉在幻想出來的力量中沾沾自喜，就好像 ",
      "encoded_ascii": "^)!^!8^.u^6\"^%Z^:O^\"d^#S^,1^!q^!O^&Z^!~^)*^!,^74^74^'l^+V^*A^*J^+i^!` ",
      "encoded_base64": "XikhXiE4Xi51XjYiXiVaXjpPXiJkXiNTXiwxXiFxXiFPXiZaXiF+XikqXiEsXjc0Xjc0XidsXitWXipBXipKXitpXiFgIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_6e089c847cfb",
      "text": "奴隸村莊真能跟一座強大的城邦相抗衡似的！",
      "encoded_ascii": "^##^)Z^$z^6l^-2^'b^.+^!%^/_^#]^\"z^&Z^+_^1a^&a^$4^8P^!H^&Z^*W",
      "encoded_base64": "XiMjXilaXiR6XjZsXi0yXidiXi4rXiElXi9fXiNdXiJ6XiZaXitfXjFhXiZhXiQ0XjhQXiFIXiZaXipX",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_4f1c22b710df",
      "text": "那些傻子終於意識到自己面對的是什麼了——那是一整座城邦寸草不生的 ",
      "encoded_ascii": "^)!^!8^7$^#(^-H^$^^#z^(R^!u^'l^#I^)j^#:^&Z^,X^!=^.T^*D^*n^*n^)!^,X^!%^$T^/_^+_^1a^=(^*f^!)^&F^&Z ",
      "encoded_base64": "XikhXiE4XjckXiMoXi1IXiReXiN6XihSXiF1XidsXiNJXilqXiM6XiZaXixYXiE9Xi5UXipEXipuXipuXikhXixYXiElXiRUXi9fXitfXjFhXj0oXipmXiEpXiZGXiZaIA==",
      "byte_length": 97
    },
    {
      "unit_id": "DLG_ddbfe3e2a154",
      "text": "恐怖鐵蹄！現在他們可沒那麼熱衷於你們這場戰爭了！",
      "encoded_ascii": "^#t^#p^)?^8s^*W^&?^\"d^!@^*{^\"A^%\\^)!^.T^&$^7i^$^^*F^*{^(s^\"n^$(^1I^*D^*W",
      "encoded_base64": "XiN0XiNwXik/XjhzXipXXiY/XiJkXiFAXip7XiJBXiVcXikhXi5UXiYkXjdpXiReXipGXip7XihzXiJuXiQoXjFJXipEXipX",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_68cd76ee026b",
      "text": "他是個發瘋的半身人。查爾發現他時，他正在沙漠裡跌跌撞撞漫無目的地 ",
      "encoded_ascii": "^!@^,X^!V^&W^-/^&Z^\"-^(c^!<^!\"^%&^&/^&W^&?^!@^$f^*A^!@^%H^\"d^%]^,}^-j^:a^:a^/l^/l^2,^%}^&^^&Z^\"e ",
      "encoded_base64": "XiFAXixYXiFWXiZXXi0vXiZaXiItXihjXiE8XiEiXiUmXiYvXiZXXiY/XiFAXiRmXipBXiFAXiVIXiJkXiVdXix9Xi1qXjphXjphXi9sXi9sXjIsXiV9XiZeXiZaXiJlIA==",
      "byte_length": 97
    },
    {
      "unit_id": "DLG_598155c398c9",
      "text": "遊蕩，從那以後這個瘋子就成天胡言亂語。 ",
      "encoded_ascii": "^.3^1X^*A^#f^)!^!B^#b^(s^!V^-/^#(^*J^$$^+e^3}^1Y^!3^0:^!\" ",
      "encoded_base64": "Xi4zXjFYXipBXiNmXikhXiFCXiNiXihzXiFWXi0vXiMoXipKXiQkXitlXjN9XjFZXiEzXjA6XiEiIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_a40cde23f7ca",
      "text": "去跟查爾談談這件事吧。我可不聽那個預言者的瘋言瘋語。沒一句是真的。 ",
      "encoded_ascii": "^\"6^.+^%&^&/^0;^0;^(s^.W^*r^*I^!\"^$%^\"A^!)^-X^)!^!V^.E^1Y^'V^&Z^-/^1Y^-/^0:^!\"^%\\^!%^2]^,X^-2^&Z^!\" ",
      "encoded_base64": "XiI2Xi4rXiUmXiYvXjA7XjA7XihzXi5XXipyXipJXiEiXiQlXiJBXiEpXi1YXikhXiFWXi5FXjFZXidWXiZaXi0vXjFZXi0vXjA6XiEiXiVcXiElXjJdXixYXi0yXiZaXiEiIA==",
      "byte_length": 100
    },
    {
      "unit_id": "DLG_ef58e3bf4535",
      "text": "德拉吉根本不會浪費力氣來對付大漠深處的奴隸村莊。",
      "encoded_ascii": "^#j^$6^\"D^%)^$x^!)^$r^,r^.\"^!~^%U^!O^#:^*u^\"z^,}^2*^(,^&Z^##^)Z^$z^6l^!\"",
      "encoded_base64": "XiNqXiQ2XiJEXiUpXiR4XiEpXiRyXixyXi4iXiF+XiVVXiFPXiM6Xip1XiJ6Xix9XjIqXigsXiZaXiMjXilaXiR6XjZsXiEi",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_a683d5b7b420",
      "text": "因為這裡每個人都有足夠的水喝。你們肯定聽說過我們的那口水井吧。 ",
      "encoded_ascii": "^\"]^%{^(s^-j^%P^!V^!<^)$^$s^(^^+d^&Z^%V^6M^!\"^*F^*{^-Z^#.^-X^-x^(x^$%^*{^&Z^)!^\"<^%V^!7^*I^!\" ",
      "encoded_base64": "XiJdXiV7XihzXi1qXiVQXiFWXiE8XikkXiRzXiheXitkXiZaXiVWXjZNXiEiXipGXip7Xi1aXiMuXi1YXi14Xih4XiQlXip7XiZaXikhXiI8XiVWXiE3XipJXiEiIA==",
      "byte_length": 94
    },
    {
      "unit_id": "DLG_0f9d0945a6c5",
      "text": "那是提奎茲爾建村時多米尼開鑿的。它從未乾涸過。",
      "encoded_ascii": "^)!^,X^$A^5B^/D^&/^,'^$z^$f^\"x^'4^#>^)F^6@^&Z^!\"^+o^#f^,_^*X^?L^(x^!\"",
      "encoded_base64": "XikhXixYXiRBXjVCXi9EXiYvXiwnXiR6XiRmXiJ4Xic0XiM+XilGXjZAXiZaXiEiXitvXiNmXixfXipYXj9MXih4XiEi",
      "byte_length": 69
    },
    {
      "unit_id": "DLG_577d73934ecf",
      "text": "多米尼是水井主管。他負責監管水源分配並維護井口機關。他有著自己獨特的 ",
      "encoded_ascii": "^\"x^'4^#>^,X^%V^!7^!-^-D^!\"^!@^(W^0>^2|^-D^%V^%q^!s^)&^!+^'F^(T^!7^\"<^%>^.>^!\"^!@^$s^-a^'l^#I^/z^&5^&Z ",
      "encoded_base64": "XiJ4Xic0XiM+XixYXiVWXiE3XiEtXi1EXiEiXiFAXihXXjA+XjJ8Xi1EXiVWXiVxXiFzXikmXiErXidGXihUXiE3XiI8XiU+Xi4+XiEiXiFAXiRzXi1hXidsXiNJXi96XiY1XiZaIA==",
      "byte_length": 103
    },
    {
      "unit_id": "DLG_82f8a5f5b538",
      "text": "天賦，而且對這口井無比自豪。他整天都在那裡修修補補。",
      "encoded_ascii": "^+e^(Y^*A^'W^!*^#:^(s^\"<^!7^%}^,m^'l^>y^!\"^!@^$T^+e^)$^\"d^)!^-j^.~^.~^6&^6&^!\"",
      "encoded_base64": "XitlXihZXipBXidXXiEqXiM6XihzXiI8XiE3XiV9XixtXidsXj55XiEiXiFAXiRUXitlXikkXiJkXikhXi1qXi5+Xi5+XjYmXjYmXiEi",
      "byte_length": 78
    },
    {
      "unit_id": "DLG_f9f62c8de4b4",
      "text": "查爾建立了這座村莊。他逃離了尼貝奈的奴役，橫越泥沼之海才輾轉來到 ",
      "encoded_ascii": "^%&^&/^,'^0'^*D^(s^/_^$z^6l^!\"^!@^(p^)`^*D^#>^/I^\"~^&Z^##^17^*A^/2^(]^%d^=|^!/^6`^$,^<I^(i^!O^!u ",
      "encoded_base64": "XiUmXiYvXiwnXjAnXipEXihzXi9fXiR6XjZsXiEiXiFAXihwXilgXipEXiM+Xi9JXiJ+XiZaXiMjXjE3XipBXi8yXihdXiVkXj18XiEvXjZgXiQsXjxJXihpXiFPXiF1IA==",
      "byte_length": 97
    },
    {
      "unit_id": "DLG_81e8610469e6",
      "text": "這裡——要是沒兩把刷子可辦不到！他是這裡最強悍的戰士，這就足夠了。",
      "encoded_ascii": "^(s^-j^*n^*n^(C^,X^%\\^!i^$1^>H^#(^\"A^2L^!)^!u^*W^!@^,X^(s^-j^$q^#]^,-^&Z^$(^+a^*A^(s^*J^(^^+d^*D^!\"",
      "encoded_base64": "XihzXi1qXipuXipuXihDXixYXiVcXiFpXiQxXj5IXiMoXiJBXjJMXiEpXiF1XipXXiFAXixYXihzXi1qXiRxXiNdXiwtXiZaXiQoXithXipBXihzXipKXiheXitkXipEXiEi",
      "byte_length": 99
    },
    {
      "unit_id": "DLG_53234e7ba57c",
      "text": "簡單來說，他永遠當不成智者賢哲。這或許會困擾某些人，但我無所謂。強壯有力的臂膀 ",
      "encoded_ascii": "^3y^2a^!O^-x^*A^!@^%W^({^&N^!)^$$^$i^'V^>U^+J^!\"^(s^$'^-s^$r^\"^^$K^%$^!8^!<^*A^!I^$%^%}^$)^0s^!\"^#]^+b^$s^!~^&Z^'k^96 ",
      "encoded_base64": "XjN5XjJhXiFPXi14XipBXiFAXiVXXih7XiZOXiEpXiQkXiRpXidWXj5VXitKXiEiXihzXiQnXi1zXiRyXiJeXiRLXiUkXiE4XiE8XipBXiFJXiQlXiV9XiQpXjBzXiEiXiNdXitiXiRzXiF+XiZaXidrXjk2IA==",
      "byte_length": 118
    },
    {
      "unit_id": "DLG_4f396061e4ca",
      "text": "才是領袖該有的本事——到目前為止這對提奎茲爾已經足夠了。",
      "encoded_ascii": "^$,^,X^)s^7G^(M^$s^&Z^$x^*r^*n^*n^!u^&^^!z^%{^%G^(s^#:^$A^5B^/D^&/^#J^'D^(^^+d^*D^!\"",
      "encoded_base64": "XiQsXixYXilzXjdHXihNXiRzXiZaXiR4XipyXipuXipuXiF1XiZeXiF6XiV7XiVHXihzXiM6XiRBXjVCXi9EXiYvXiNKXidEXiheXitkXipEXiEi",
      "byte_length": 84
    },
    {
      "unit_id": "DLG_32d1617bec78",
      "text": "卡圖拉？你們知道的，查爾是個穆爾人，她並非查爾的親生女兒。但她就像隻飛鳥，成天無憂無慮 ",
      "encoded_ascii": "^\"0^\"b^$6^.V^*F^*{^&h^(y^&Z^*A^%&^&/^,X^!V^8K^&/^!<^*A^+h^!+^)i^%&^&/^&Z^(F^&F^#\"^++^!\"^!I^+h^*J^!`^)[^)z^4p^*A^$$^+e^%}^91^%}^19 ",
      "encoded_base64": "XiIwXiJiXiQ2Xi5WXipGXip7XiZoXih5XiZaXipBXiUmXiYvXixYXiFWXjhLXiYvXiE8XipBXitoXiErXilpXiUmXiYvXiZaXihGXiZGXiMiXisrXiEiXiFJXitoXipKXiFgXilbXil6XjRwXipBXiQkXitlXiV9XjkxXiV9XjE5IA==",
      "byte_length": 130
    },
    {
      "unit_id": "DLG_bc8c496b5934",
      "text": "到處亂飛。不過查爾對她可真是百般溺愛。",
      "encoded_ascii": "^!u^(,^!3^)z^!\"^!)^(x^%&^&/^#:^+h^\"A^-2^,X^&Y^'r^?M^,2^!\"",
      "encoded_base64": "XiF1XigsXiEzXil6XiEiXiEpXih4XiUmXiYvXiM6XitoXiJBXi0yXixYXiZZXidyXj9NXiwyXiEi",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_eeeec8cd3609",
      "text": "奎林是幾年前來到提奎茲爾的。大家似乎都挺喜歡 ",
      "encoded_ascii": "^5B^/1^,X^#T^+~^!z^!O^!u^$A^5B^/D^&/^&Z^!\"^\"z^+s^!H^!0^)$^,I^+V^%F ",
      "encoded_base64": "XjVCXi8xXixYXiNUXit+XiF6XiFPXiF1XiRBXjVCXi9EXiYvXiZaXiEiXiJ6XitzXiFIXiEwXikkXixJXitWXiVGIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_924d814dd086",
      "text": "他。大家常說村子需要注入新鮮血液。",
      "encoded_ascii": "^!@^!\"^\"z^+s^#O^-x^$z^#(^)e^(C^%e^!f^$\\^35^(:^%l^!\"",
      "encoded_base64": "XiFAXiEiXiJ6XitzXiNPXi14XiR6XiMoXillXihDXiVlXiFmXiRcXjM1Xig6XiVsXiEi",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_4a7267ae8c9a",
      "text": "  村子需要一位新領袖嗎？",
      "encoded_ascii": "  ^$z^#(^)e^(C^!%^!J^$\\^)s^7G^+X^.V",
      "encoded_base64": "ICBeJHpeIyheKWVeKENeISVeIUpeJFxeKXNeN0deK1heLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_2ad4251ac12a",
      "text": "  奎林來自何處？",
      "encoded_ascii": "  ^5B^/1^!O^'l^!L^(,^.V",
      "encoded_base64": "ICBeNUJeLzFeIU9eJ2xeIUxeKCxeLlY=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_990b1b31286b",
      "text": "  關於奎林，我有什麼該瞭解的？",
      "encoded_ascii": "  ^.>^$^^5B^/1^*A^$%^$s^!=^.T^(M^<p^(I^&Z^.V",
      "encoded_base64": "ICBeLj5eJF5eNUJeLzFeKkFeJCVeJHNeIT1eLlReKE1ePHBeKEleJlpeLlY=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_40d909264795",
      "text": "  奎林有什麼打算？",
      "encoded_ascii": "  ^5B^/1^$s^!=^.T^$-^-C^.V",
      "encoded_base64": "ICBeNUJeLzFeJHNeIT1eLlReJC1eLUNeLlY=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_5f050a720620",
      "text": "查爾總有一天得退位，不然就是被人掀翻下台。沒人能長生不老。",
      "encoded_ascii": "^%&^&/^-M^$s^!%^+e^#e^*V^!J^*A^!)^&\"^*J^,X^(@^!<^8h^-Q^!(^\"B^!\"^%\\^!<^'b^)C^&F^!)^'U^!\"",
      "encoded_base64": "XiUmXiYvXi1NXiRzXiElXitlXiNlXipWXiFKXipBXiEpXiYiXipKXixYXihAXiE8XjhoXi1RXiEoXiJCXiEiXiVcXiE8XidiXilDXiZGXiEpXidVXiEi",
      "byte_length": 87
    },
    {
      "unit_id": "DLG_7f3ec2c6ef54",
      "text": " 不過這又有什麼所謂呢。這場仗會把我們全害死。",
      "encoded_ascii": " ^!)^(x^(s^+;^$s^!=^.T^$)^0s^+C^!\"^(s^\"n^0|^$r^$1^$%^*{^!h^#/^%L^!\"",
      "encoded_base64": "IF4hKV4oeF4oc14rO14kc14hPV4uVF4kKV4wc14rQ14hIl4oc14ibl4wfF4kcl4kMV4kJV4qe14haF4jL14lTF4hIg==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_331bf9f90763",
      "text": "這可不是該對一個前奴隸問的問題。再說，要瞭解一個人， ",
      "encoded_ascii": "^(s^\"A^!)^,X^(M^#:^!%^!V^!z^##^)Z^*Z^&Z^*Z^.G^!\"^!l^-x^*A^(C^<p^(I^!%^!V^!<^*A ",
      "encoded_base64": "XihzXiJBXiEpXixYXihNXiM6XiElXiFWXiF6XiMjXilaXipaXiZaXipaXi5HXiEiXiFsXi14XipBXihDXjxwXihJXiElXiFWXiE8XipBIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_dd0110668419",
      "text": "還有比出身更重要的事情。",
      "encoded_ascii": "^.7^$s^,m^!q^(c^$o^))^(C^&Z^*r^,0^!\"",
      "encoded_base64": "Xi43XiRzXixtXiFxXihjXiRvXikpXihDXiZaXipyXiwwXiEi",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_0464d855ce05",
      "text": "這輪不到我來說。一個人的器量得靠你自己去掂量——但野心會磨利任何兵刃的鋒芒， ",
      "encoded_ascii": "^(s^(h^!)^!u^$%^!O^-x^!\"^!%^!V^!<^&Z^\"V^)*^#e^.C^*F^'l^#I^\"6^;f^)*^*n^*n^!I^.:^#k^$r^-7^!t^!C^!L^+,^!r^&Z^6?^'u^*A ",
      "encoded_base64": "XihzXihoXiEpXiF1XiQlXiFPXi14XiEiXiElXiFWXiE8XiZaXiJWXikqXiNlXi5DXipGXidsXiNJXiI2XjtmXikqXipuXipuXiFJXi46XiNrXiRyXi03XiF0XiFDXiFMXissXiFyXiZaXjY/Xid1XipBIA==",
      "byte_length": 115
    },
    {
      "unit_id": "DLG_b85763c535e7",
      "text": "而奎林絕不是個愚蠢之徒。",
      "encoded_ascii": "^'W^5B^/1^-I^!)^,X^!V^/a^.u^!/^#d^!\"",
      "encoded_base64": "XidXXjVCXi8xXi1JXiEpXixYXiFWXi9hXi51XiEvXiNkXiEi",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_1249a9e63773",
      "text": "不知道，我也不在乎。奎林一心想當領袖，這點無庸置疑；但他 ",
      "encoded_ascii": "^!)^&h^(y^*A^$%^!1^!)^\"d^!0^!\"^5B^/1^!%^#k^,1^&N^)s^7G^*A^(s^*;^%}^4x^'Q^0p^*C^!I^!@ ",
      "encoded_base64": "XiEpXiZoXih5XipBXiQlXiExXiEpXiJkXiEwXiEiXjVCXi8xXiElXiNrXiwxXiZOXilzXjdHXipBXihzXio7XiV9XjR4XidRXjBwXipDXiFJXiFAIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_7d7cd7585937",
      "text": "打架絕不是查爾的對手，多半也沒膽量去撕破臉嘗試。",
      "encoded_ascii": "^$-^%\"^-I^!)^,X^%&^&/^&Z^#:^$+^*A^\"x^\"-^!1^%\\^-[^)*^\"6^/k^&n^-\\^1o^-u^!\"",
      "encoded_base64": "XiQtXiUiXi1JXiEpXixYXiUmXiYvXiZaXiM6XiQrXipBXiJ4XiItXiExXiVcXi1bXikqXiI2Xi9rXiZuXi1cXjFvXi11XiEi",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_26fe988e6bbb",
      "text": "我廢話說得夠多了。 ",
      "encoded_ascii": "^$%^#W^-v^-x^#e^+d^\"x^*D^!\" ",
      "encoded_base64": "XiQlXiNXXi12Xi14XiNlXitkXiJ4XipEXiEiIA==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_908ba564e872",
      "text": "行啊，如果你想談的話。但我可不能整天站在這裡瞎扯閒聊。",
      "encoded_ascii": "^(;^+Q^*A^#$^%!^*F^,1^0;^&Z^-v^!\"^!I^$%^\"A^!)^'b^$T^+e^->^\"d^(s^-j^2}^.e^6A^-U^!\"",
      "encoded_base64": "Xig7XitRXipBXiMkXiUhXipGXiwxXjA7XiZaXi12XiEiXiFJXiQlXiJBXiEpXidiXiRUXitlXi0+XiJkXihzXi1qXjJ9Xi5lXjZBXi1VXiEi",
      "byte_length": 81
    },
    {
      "unit_id": "DLG_28181f6de8a4",
      "text": "你又召喚我了？真是虛榮！我是不滅之軀，絕容不得你們肆意戲弄！",
      "encoded_ascii": "^*F^+;^\"@^\"U^$%^*D^.V^-2^,X^-g^,e^*W^$%^,X^!)^%t^!/^(d^*A^-I^+t^!)^#e^*F^*{^2>^#z^,;^/`^*W",
      "encoded_base64": "XipGXis7XiJAXiJVXiQlXipEXi5WXi0yXixYXi1nXixlXipXXiQlXixYXiEpXiV0XiEvXihkXipBXi1JXit0XiEpXiNlXipGXip7XjI+XiN6Xiw7Xi9gXipX",
      "byte_length": 90
    },
    {
      "unit_id": "DLG_ac30de02d048",
      "text": "然而你們卻如此脆弱，你們的生命精氣將成為…… ",
      "encoded_ascii": "^&\"^'W^*F^*{^1&^#$^%I^2?^#\\^*A^*F^*{^&Z^&F^\"N^'7^%U^#7^$$^%{^*o^*o ",
      "encoded_base64": "XiYiXidXXipGXip7XjEmXiMkXiVJXjI/XiNcXipBXipGXip7XiZaXiZGXiJOXic3XiVVXiM3XiQkXiV7XipvXipvIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_fd14a3fd8bb6",
      "text": "打擾我的代價！",
      "encoded_ascii": "^$-^$K^$%^&Z^*v^+&^*W",
      "encoded_base64": "XiQtXiRLXiQlXiZaXip2XismXipX",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_1d61819aa0a6",
      "text": "誰敢擅闖我的領地？",
      "encoded_ascii": "^-y^/m^2$^.z^$%^&Z^)s^\"e^.V",
      "encoded_base64": "Xi15Xi9tXjIkXi56XiQlXiZaXilzXiJlXi5W",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_c1842544f635",
      "text": "蠢貨！你們為什麼偏要一再打擾我？",
      "encoded_ascii": "^.u^.w^*W^*F^*{^%{^!=^.T^![^(C^!%^!l^$-^$K^$%^.V",
      "encoded_base64": "Xi51Xi53XipXXipGXip7XiV7XiE9Xi5UXiFbXihDXiElXiFsXiQtXiRLXiQlXi5W",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_03ab38a436c8",
      "text": "現在，你們要為帶給我的痛苦付出慘痛代價！",
      "encoded_ascii": "^&?^\"d^*A^*F^*{^(C^%{^#N^'A^$%^&Z^-.^.t^*u^!q^,4^-.^*v^+&^*W",
      "encoded_base64": "XiY/XiJkXipBXipGXip7XihDXiV7XiNOXidBXiQlXiZaXi0uXi50Xip1XiFxXiw0Xi0uXip2XismXipX",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_9ca49a6fd9f5",
      "text": "現在，好好品嘗我的熊熊怒火吧！",
      "encoded_ascii": "^&?^\"d^*A^+i^+i^\"R^1o^$%^&Z^2/^2/^#o^%x^*I^*W",
      "encoded_base64": "XiY/XiJkXipBXitpXitpXiJSXjFvXiQlXiZaXjIvXjIvXiNvXiV4XipJXipX",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_88f1f1a5799d",
      "text": "  什麼是內在之眼？",
      "encoded_ascii": "  ^!=^.T^,X^!g^\"d^!/^&d^.V",
      "encoded_base64": "ICBeIT1eLlReLFheIWdeImReIS9eJmReLlY=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_b0f9607c3bad",
      "text": "  你為什麼會待在這座塔裡？",
      "encoded_ascii": "  ^*F^%{^!=^.T^$r^,*^\"d^(s^/_^\"o^-j^.V",
      "encoded_base64": "ICBeKkZeJXteIT1eLlReJHJeLCpeImReKHNeL19eIm9eLWpeLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_6e5539fbde0e",
      "text": "  你要「積蓄力量」到何時？",
      "encoded_ascii": "  ^*F^(C^!#^27^2B^!~^)*^!$^!u^!L^$f^.V",
      "encoded_base64": "ICBeKkZeKENeISNeMjdeMkJeIX5eKSpeISReIXVeIUxeJGZeLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_197092ba102b",
      "text": "  我就是你的死期！",
      "encoded_ascii": "  ^$%^*J^,X^*F^&Z^%L^$u^*W",
      "encoded_base64": "ICBeJCVeKkpeLFheKkZeJlpeJUxeJHVeKlc=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_ce8c6ff1a155",
      "text": "  你不過是個噁心至極的醜陋老太婆！",
      "encoded_ascii": "  ^*F^!)^(x^,X^!V^1p^#k^'n^1D^&Z^2O^2P^'U^+f^1u^*W",
      "encoded_base64": "ICBeKkZeISleKHheLFheIVZeMXBeI2teJ25eMUReJlpeMk9eMlBeJ1VeK2ZeMXVeKlc=",
      "byte_length": 50
    },
    {
      "unit_id": "DLG_b4d16ebe18d8",
      "text": "不好意思。我這就告辭了。",
      "encoded_ascii": "^!)^+i^#z^#q^!\"^$%^(s^*J^+B^2M^*D^!\"",
      "encoded_base64": "XiEpXitpXiN6XiNxXiEiXiQlXihzXipKXitCXjJNXipEXiEi",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_113a31729636",
      "text": "又是你們！你們很快就會懂得打擾我的下場！",
      "encoded_ascii": "^+;^,X^*F^*{^*W^*F^*{^*K^*L^*J^$r^,6^#e^$-^$K^$%^&Z^!(^\"n^*W",
      "encoded_base64": "Xis7XixYXipGXip7XipXXipGXip7XipLXipMXipKXiRyXiw2XiNlXiQtXiRLXiQlXiZaXiEoXiJuXipX",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_d7785bb52ad1",
      "text": "什麼！籠子為什麼是空的？人都在哪裡？他…… ",
      "encoded_ascii": "^!=^.T^*W^'3^#(^%{^!=^.T^,X^'(^&Z^.V^!<^)$^\"d^+I^-j^.V^!@^*o^*o ",
      "encoded_base64": "XiE9Xi5UXipXXiczXiMoXiV7XiE9Xi5UXixYXicoXiZaXi5WXiE8XikkXiJkXitJXi1qXi5WXiFAXipvXipvIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_565e8bfe8e49",
      "text": "居然想活活餓死我！",
      "encoded_ascii": "^+w^&\"^,1^%i^%i^2R^%L^$%^*W",
      "encoded_base64": "Xit3XiYiXiwxXiVpXiVpXjJSXiVMXiQlXipX",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_f12c891491fb",
      "text": "  你統治的不過是一群腐爛的瘋子！",
      "encoded_ascii": "  ^*F^'B^%_^&Z^!)^(x^,X^!%^'R^0/^&-^&Z^-/^#(^*W",
      "encoded_base64": "ICBeKkZeJ0JeJV9eJlpeISleKHheLFheISVeJ1JeMC9eJi1eJlpeLS9eIyheKlc=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_6256b2f52583",
      "text": "  你是怎麼保持肉身不腐的？",
      "encoded_ascii": "  ^*F^,X^,,^.T^!T^$7^'^^(c^!)^0/^&Z^.V",
      "encoded_base64": "ICBeKkZeLFheLCxeLlReIVReJDdeJ15eKGNeISleMC9eJlpeLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_f64344a75cb3",
      "text": "  是誰想餓死你？",
      "encoded_ascii": "  ^,X^-y^,1^2R^%L^*F^.V",
      "encoded_base64": "ICBeLFheLXleLDFeMlJeJUxeKkZeLlY=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_586fd6202b5b",
      "text": "  我可以為你帶些食物來。",
      "encoded_ascii": "  ^$%^\"A^!B^%{^*F^#N^!8^0J^&4^!O^!\"",
      "encoded_base64": "ICBeJCVeIkFeIUJeJXteKkZeI05eITheMEpeJjReIU9eISI=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_f2fa8f8ae2a4",
      "text": "  我會給你應得的死亡！",
      "encoded_ascii": "  ^$%^$r^'A^*F^0`^#e^&Z^%L^!:^*W",
      "encoded_base64": "ICBeJCVeJHJeJ0FeKkZeMGBeI2VeJlpeJUxeITpeKlc=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_bfe21817f25f",
      "text": "我不想再跟你說話了。",
      "encoded_ascii": "^$%^!)^,1^!l^.+^*F^-x^-v^*D^!\"",
      "encoded_base64": "XiQlXiEpXiwxXiFsXi4rXipGXi14Xi12XipEXiEi",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_9750d8731dd5",
      "text": "納吉！你戴著他的護符，以為那能保護你免受我的力量傷害嗎！ ",
      "encoded_ascii": "^';^\"D^*W^*F^1:^-a^!@^&Z^(T^'+^*A^!B^%{^)!^'b^!T^(T^*F^!e^\";^$%^&Z^!~^)*^!^^#/^+X^*W ",
      "encoded_base64": "Xic7XiJEXipXXipGXjE6Xi1hXiFAXiZaXihUXicrXipBXiFCXiV7XikhXidiXiFUXihUXipGXiFlXiI7XiQlXiZaXiF+XikqXiFeXiMvXitYXipXIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_485e34327545",
      "text": "是我殺了納吉！是我僅憑一個念頭，就把他的信徒…… ",
      "encoded_ascii": "^,X^$%^%M^*D^';^\"D^*W^,X^$%^!_^,5^!%^!V^1z^)t^*A^*J^$1^!@^&Z^!U^#d^*o^*o ",
      "encoded_base64": "XixYXiQlXiVNXipEXic7XiJEXipXXixYXiQlXiFfXiw1XiElXiFWXjF6Xil0XipBXipKXiQxXiFAXiZaXiFVXiNkXipvXipvIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_8872861230cb",
      "text": "如同塵芥般揮散！現在，我也要殺了你們！",
      "encoded_ascii": "^#$^\"E^\"p^2A^'r^2\"^$S^*W^&?^\"d^*A^$%^!1^(C^%M^*D^*F^*{^*W",
      "encoded_base64": "XiMkXiJFXiJwXjJBXidyXjIiXiRTXipXXiY/XiJkXipBXiQlXiExXihDXiVNXipEXipGXip7XipX",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_4fc4b03a467a",
      "text": "我是塔拉，內在之眼的統治者！",
      "encoded_ascii": "^$%^,X^\"o^$6^*A^!g^\"d^!/^&d^&Z^'B^%_^'V^*W",
      "encoded_base64": "XiQlXixYXiJvXiQ2XipBXiFnXiJkXiEvXiZkXiZaXidCXiVfXidWXipX",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_ac855e0ff0c9",
      "text": "我正在積蓄力量，隨後我將率領內在之眼邁向高牆之外的輝煌。 ",
      "encoded_ascii": "^$%^%H^\"d^27^2B^!~^)*^*A^)X^#b^$%^#7^22^)s^!g^\"d^!/^&d^2N^+?^*+^&0^!/^\"w^&Z^2K^2.^!\" ",
      "encoded_base64": "XiQlXiVIXiJkXjI3XjJCXiF+XikqXipBXilYXiNiXiQlXiM3XjIyXilzXiFnXiJkXiEvXiZkXjJOXis/XiorXiYwXiEvXiJ3XiZaXjJLXjIuXiEiIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_fa9540c4008a",
      "text": "別自作聰明地以為我的力量不足以…… ",
      "encoded_ascii": "^*H^'l^!M^2=^$c^\"e^!B^%{^$%^&Z^!~^)*^!)^(^^!B^*o^*o ",
      "encoded_base64": "XipIXidsXiFNXjI9XiRjXiJlXiFCXiV7XiQlXiZaXiF+XikqXiEpXiheXiFCXipvXipvIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_50db1a140c54",
      "text": "打破那些守護結界。",
      "encoded_ascii": "^$-^&n^)!^!8^#+^(T^'@^.p^!\"",
      "encoded_base64": "XiQtXiZuXikhXiE4XiMrXihUXidAXi5wXiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_823de242c277",
      "text": "我絕不容忍這種放肆傲慢！你的嘲弄為你招來了死亡！",
      "encoded_ascii": "^$%^-I^!)^+t^1y^(s^'$^$P^2>^1j^#~^*W^*F^&Z^+Z^/`^%{^*F^,D^!O^*D^%L^!:^*W",
      "encoded_base64": "XiQlXi1JXiEpXit0XjF5XihzXickXiRQXjI+XjFqXiN+XipXXipGXiZaXitaXi9gXiV7XipGXixEXiFPXipEXiVMXiE6XipX",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_7484d8820fcc",
      "text": "老？！",
      "encoded_ascii": "^'U^.V^*W",
      "encoded_base64": "XidVXi5WXipX",
      "byte_length": 9
    },
    {
      "unit_id": "DLG_81f34a833a1b",
      "text": "那我便奪走你的青春，重塑我的美貌！",
      "encoded_ascii": "^)!^$%^!R^1,^.&^*F^&Z^2Q^2&^*A^))^1s^$%^&Z^-P^-~^*W",
      "encoded_base64": "XikhXiQlXiFSXjEsXi4mXipGXiZaXjJRXjImXipBXikpXjFzXiQlXiZaXi1QXi1+XipX",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_fcd593bb1141",
      "text": "我根本不需要迷宮裡那些蠢貨！你們看得出來，我的身軀並未像他們那樣…… ",
      "encoded_ascii": "^$%^%)^$x^!)^)e^(C^(n^/\\^-j^)!^!8^.u^.w^*W^*F^*{^*Q^#e^!q^!O^*A^$%^&Z^(c^(d^!+^,_^!`^!@^*{^)!^,f^*o^*o ",
      "encoded_base64": "XiQlXiUpXiR4XiEpXillXihDXihuXi9cXi1qXikhXiE4Xi51Xi53XipXXipGXip7XipRXiNlXiFxXiFPXipBXiQlXiZaXihjXihkXiErXixfXiFgXiFAXip7XikhXixmXipvXipvIA==",
      "byte_length": 103
    },
    {
      "unit_id": "DLG_cf0004599a9e",
      "text": "腐爛潰敗。我依然保有我的美貌，以及我無上的力量！",
      "encoded_ascii": "^0/^&-^2-^$R^!\"^$%^!Q^&\"^!T^$s^$%^&Z^-P^-~^*A^!B^\"7^$%^%}^!'^&Z^!~^)*^*W",
      "encoded_base64": "XjAvXiYtXjItXiRSXiEiXiQlXiFRXiYiXiFUXiRzXiQlXiZaXi1QXi1+XipBXiFCXiI3XiQlXiV9XiEnXiZaXiF+XikqXipX",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_be296ab9900a",
      "text": "靠近一點，我會親自向你們展示。",
      "encoded_ascii": "^.C^(l^!%^*;^*A^$%^$r^(F^'l^+?^*F^*{^+x^&s^!\"",
      "encoded_base64": "Xi5DXihsXiElXio7XipBXiQlXiRyXihGXidsXis/XipGXip7Xit4XiZzXiEi",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_91890f9bf4f2",
      "text": "食物？對，那正是我需要的，既然你如此…… ",
      "encoded_ascii": "^0J^&4^.V^#:^*A^)!^%H^,X^$%^)e^(C^&Z^*A^,U^&\"^*F^#$^%I^*o^*o ",
      "encoded_base64": "XjBKXiY0Xi5WXiM6XipBXikhXiVIXixYXiQlXillXihDXiZaXipBXixVXiYiXipGXiMkXiVJXipvXipvIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_f7f064efd5c6",
      "text": "好心地自告奮勇……",
      "encoded_ascii": "^+i^#k^\"e^'l^+B^+g^\"$^*o^*o",
      "encoded_base64": "XitpXiNrXiJlXidsXitCXitnXiIkXipvXipv",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_bd8add4c5e9f",
      "text": "當然是統治強盜的那個黃鼠狼！要是他不更恭敬地伺候我，我會讓他明白誰才是…… ",
      "encoded_ascii": "^&N^&\"^,X^'B^%_^#]^0!^&Z^)!^!V^*7^*=^21^*W^(C^,X^!@^!)^$o^1{^*O^\"e^0Q^*|^$%^*A^$%^$r^-}^!@^$c^&X^-y^$,^,X^*o^*o ",
      "encoded_base64": "XiZOXiYiXixYXidCXiVfXiNdXjAhXiZaXikhXiFWXio3Xio9XjIxXipXXihDXixYXiFAXiEpXiRvXjF7XipPXiJlXjBRXip8XiQlXipBXiQlXiRyXi19XiFAXiRjXiZYXi15XiQsXixYXipvXipvIA==",
      "byte_length": 112
    },
    {
      "unit_id": "DLG_95d2be0a4067",
      "text": "這座城堡真正的至高主宰！",
      "encoded_ascii": "^(s^/_^+_^\"m^-2^%H^&Z^'n^*+^!-^1w^*W",
      "encoded_base64": "XihzXi9fXitfXiJtXi0yXiVIXiZaXiduXiorXiEtXjF3XipX",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_0aa144a68b14",
      "text": "內在之眼是有史以來最偉大的巫師學派。 ",
      "encoded_ascii": "^!g^\"d^!/^&d^,X^$s^1m^!B^!O^$q^*}^\"z^&Z^14^#M^+n^.n^!\" ",
      "encoded_base64": "XiFnXiJkXiEvXiZkXixYXiRzXjFtXiFCXiFPXiRxXip9XiJ6XiZaXjE0XiNNXituXi5uXiEiIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_b57cd34268eb",
      "text": "由我統治！我將永遠統治它！",
      "encoded_ascii": "^&I^$%^'B^%_^*W^$%^#7^%W^({^'B^%_^+o^*W",
      "encoded_base64": "XiZJXiQlXidCXiVfXipXXiQlXiM3XiVXXih7XidCXiVfXitvXipX",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_eccc61920f4d",
      "text": "消滅我？你們這些蠢貨！無知！狂妄！我是塔拉，內在之眼的…… ",
      "encoded_ascii": "^%k^%t^$%^.V^*F^*{^(s^!8^.u^.w^*W^%}^&h^*W^&8^+j^*W^$%^,X^\"o^$6^*A^!g^\"d^!/^&d^&Z^*o^*o ",
      "encoded_base64": "XiVrXiV0XiQlXi5WXipGXip7XihzXiE4Xi51Xi53XipXXiV9XiZoXipXXiY4XitqXipXXiQlXixYXiJvXiQ2XipBXiFnXiJkXiEvXiZkXiZaXipvXipvIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_297f9619ac7f",
      "text": "統治者！我不可能被消滅！",
      "encoded_ascii": "^'B^%_^'V^*W^$%^!)^\"A^'b^(@^%k^%t^*W",
      "encoded_base64": "XidCXiVfXidWXipXXiQlXiEpXiJBXidiXihAXiVrXiV0XipX",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_5cab99fb1858",
      "text": "沒錯，跟你的同伴道別吧。是時候重獲我的青春美貌了！",
      "encoded_ascii": "^%\\^)5^*A^.+^*F^&Z^\"E^1h^(y^*H^*I^!\"^,X^$f^*|^))^&:^$%^&Z^2Q^2&^-P^-~^*D^*W",
      "encoded_base64": "XiVcXik1XipBXi4rXipGXiZaXiJFXjFoXih5XipIXipJXiEiXixYXiRmXip8XikpXiY6XiQlXiZaXjJRXjImXi1QXi1+XipEXipX",
      "byte_length": 75
    },
    {
      "unit_id": "DLG_83e2c439fdf1",
      "text": "很高興遇見你們——而當我奪走你們微不足道的…… ",
      "encoded_ascii": "^*K^*+^-]^.2^-m^*F^*{^*n^*n^'W^&N^$%^1,^.&^*F^*{^#i^!)^(^^(y^&Z^*o^*o ",
      "encoded_base64": "XipLXiorXi1dXi4yXi1tXipGXip7XipuXipuXidXXiZOXiQlXjEsXi4mXipGXip7XiNpXiEpXiheXih5XiZaXipvXipvIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_38144272e31f",
      "text": "賤命時，我會感到更加愉快！",
      "encoded_ascii": "^2G^\"N^$f^*A^$%^$r^#{^!u^$o^\"\"^1|^*L^*W",
      "encoded_base64": "XjJHXiJOXiRmXipBXiQlXiRyXiN7XiF1XiRvXiIiXjF8XipMXipX",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_fb0462807d3a",
      "text": "就由你來重塑我的美貌吧！",
      "encoded_ascii": "^*J^&I^*F^!O^))^1s^$%^&Z^-P^-~^*I^*W",
      "encoded_base64": "XipKXiZJXipGXiFPXikpXjFzXiQlXiZaXi1QXi1+XipJXipX",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_e33da8043585",
      "text": "大戰迫在眉睫，實在有太多事要忙了，而我甚至連 ",
      "encoded_ascii": "^\"z^$(^1`^\"d^3S^8o^*A^#3^\"d^$s^+f^\"x^*r^(C^,+^*D^*A^'W^$%^/|^'n^.0 ",
      "encoded_base64": "XiJ6XiQoXjFgXiJkXjNTXjhvXipBXiMzXiJkXiRzXitmXiJ4XipyXihDXiwrXipEXipBXidXXiQlXi98XiduXi4wIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_681d33eca7a7",
      "text": "新護甲都還沒拿到！好吧，再見了。我知道你們一定會凱旋而歸的！",
      "encoded_ascii": "^$\\^(T^&J^)$^.7^%\\^,G^!u^*W^+i^*I^*A^!l^-m^*D^!\"^$%^&h^(y^*F^*{^!%^#.^$r^!p^$`^'W^%K^&Z^*W",
      "encoded_base64": "XiRcXihUXiZKXikkXi43XiVcXixHXiF1XipXXitpXipJXipBXiFsXi1tXipEXiEiXiQlXiZoXih5XipGXip7XiElXiMuXiRyXiFwXiRgXidXXiVLXiZaXipX",
      "byte_length": 90
    },
    {
      "unit_id": "DLG_256b4e8f8992",
      "text": "！真高興能再次見到你——我父親已經跟我說過你們為提奎茲爾所做的一切了。",
      "encoded_ascii": "^*W^-2^*+^-]^'b^!l^%D^-m^!u^*F^*n^*n^$%^5d^(F^#J^'D^.+^$%^-x^(x^*F^*{^%{^$A^5B^/D^&/^$)^*~^&Z^!%^+.^*D^!\"",
      "encoded_base64": "XipXXi0yXiorXi1dXidiXiFsXiVEXi1tXiF1XipGXipuXipuXiQlXjVkXihGXiNKXidEXi4rXiQlXi14Xih4XipGXip7XiV7XiRBXjVCXi9EXiYvXiQpXip+XiZaXiElXisuXipEXiEi",
      "byte_length": 105
    },
    {
      "unit_id": "DLG_e98d5acae6f4",
      "text": "  抱歉，我不太記得你了。",
      "encoded_ascii": "  ^,@^,h^*A^$%^!)^+f^(K^#e^*F^*D^!\"",
      "encoded_base64": "ICBeLEBeLGheKkFeJCVeISleK2ZeKEteI2VeKkZeKkReISI=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_626ecb11a20f",
      "text": "  我也很高興能再次見到你！",
      "encoded_ascii": "  ^$%^!1^*K^*+^-]^'b^!l^%D^-m^!u^*F^*W",
      "encoded_base64": "ICBeJCVeITFeKkteKiteLV1eJ2JeIWxeJUReLW1eIXVeKkZeKlc=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_55e3201819aa",
      "text": "我還有更重要的事情要辦。",
      "encoded_ascii": "^$%^.7^$s^$o^))^(C^&Z^*r^,0^(C^2L^!\"",
      "encoded_base64": "XiQlXi43XiRzXiRvXikpXihDXiZaXipyXiwwXihDXjJMXiEi",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_6c33598c322d",
      "text": "拉麗莎曾說我會遇見真正的英雄，但我萬萬沒想到那竟然一直就是你們！",
      "encoded_ascii": "^$6^0z^/E^.j^-x^$%^$r^.2^-m^-2^%H^&Z^'y^)\\^*A^!I^$%^-_^-_^%\\^,1^!u^)!^28^&\"^!%^&`^*J^,X^*F^*{^*W",
      "encoded_base64": "XiQ2XjB6Xi9FXi5qXi14XiQlXiRyXi4yXi1tXi0yXiVIXiZaXid5XilcXipBXiFJXiQlXi1fXi1fXiVcXiwxXiF1XikhXjI4XiYiXiElXiZgXipKXixYXipGXip7XipX",
      "byte_length": 96
    },
    {
      "unit_id": "DLG_7f04336cdcc8",
      "text": " 而且你是位如此強壯又英俊的男子， ",
      "encoded_ascii": " ^'W^!*^*F^,X^!J^#$^%I^#]^+b^+;^'y^?S^&Z^&K^#(^*A ",
      "encoded_base64": "IF4nV14hKl4qRl4sWF4hSl4jJF4lSV4jXV4rYl4rO14neV4/U14mWl4mS14jKF4qQSA=",
      "byte_length": 50
    },
    {
      "unit_id": "DLG_8f615c232cfc",
      "text": "，照理說我早該看出來的。",
      "encoded_ascii": "^*A^/x^&A^-x^$%^,V^(M^*Q^!q^!O^&Z^!\"",
      "encoded_base64": "XipBXi94XiZBXi14XiQlXixWXihNXipRXiFxXiFPXiZaXiEi",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_afc688d9a618",
      "text": "  我聽過許多關於你的傳聞，卡圖拉。",
      "encoded_ascii": "  ^$%^-X^(x^-s^\"x^.>^$^^*F^&Z^+$^4^^*A^\"0^\"b^$6^!\"",
      "encoded_base64": "ICBeJCVeLVheKHheLXNeInheLj5eJF5eKkZeJlpeKyReNF5eKkFeIjBeImJeJDZeISI=",
      "byte_length": 50
    },
    {
      "unit_id": "DLG_51aa6ee1720d",
      "text": "  你自己看起來也相當楚楚動人，卡圖拉。",
      "encoded_ascii": "  ^*F^'l^#I^*Q^.(^!O^!1^&a^&N^,c^,c^\"%^!<^*A^\"0^\"b^$6^!\"",
      "encoded_base64": "ICBeKkZeJ2xeI0leKlFeLiheIU9eITFeJmFeJk5eLGNeLGNeIiVeITxeKkFeIjBeImJeJDZeISI=",
      "byte_length": 56
    },
    {
      "unit_id": "DLG_f0f78ae5d34b",
      "text": "  我保證你絕不會失望的。",
      "encoded_ascii": "  ^$%^!T^-{^*F^-I^!)^$r^\"|^,]^&Z^!\"",
      "encoded_base64": "ICBeJCVeIVReLXteKkZeLUleISleJHJeInxeLF1eJlpeISI=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_5f69495bf1a1",
      "text": "  我對你的奉承諂媚毫無興趣。",
      "encoded_ascii": "  ^$%^#:^*F^&Z^1+^$0^1[^1.^/t^%}^-]^.*^!\"",
      "encoded_base64": "ICBeJCVeIzpeKkZeJlpeMSteJDBeMVteMS5eL3ReJX1eLV1eLipeISI=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_79f39bb2f57e",
      "text": "  你在我屋裡做什麼？",
      "encoded_ascii": "  ^*F^\"d^$%^8y^-j^*~^!=^.T^.V",
      "encoded_base64": "ICBeKkZeImReJCVeOHleLWpeKn5eIT1eLlReLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_91b07c4f7b1f",
      "text": "  我聽過許多關於你的事，卡蒂。",
      "encoded_ascii": "  ^$%^-X^(x^-s^\"x^.>^$^^*F^&Z^*r^*A^\"0^(%^!\"",
      "encoded_base64": "ICBeJCVeLVheKHheLXNeInheLj5eJF5eKkZeJlpeKnJeKkFeIjBeKCVeISI=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_a2008f78aa92",
      "text": "  你在商隊那裡有聽到什麼傳言嗎？",
      "encoded_ascii": "  ^*F^\"d^1'^)U^)!^-j^$s^-X^!u^!=^.T^+$^1Y^+X^.V",
      "encoded_base64": "ICBeKkZeImReMSdeKVVeKSFeLWpeJHNeLVheIXVeIT1eLlReKyReMVleK1heLlY=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_ad3a53f1f8b8",
      "text": "  蓋德隆在哪裡？",
      "encoded_ascii": "  ^-d^#j^)T^\"d^+I^-j^.V",
      "encoded_base64": "ICBeLWReI2peKVReImReK0leLWpeLlY=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_dc3473c21fff",
      "text": "  我現在得走了。告辭。",
      "encoded_ascii": "  ^$%^&?^\"d^#e^.&^*D^!\"^+B^2M^!\"",
      "encoded_base64": "ICBeJCVeJj9eImReI2VeLiZeKkReISJeK0JeMk1eISI=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_5dcdabcae08c",
      "text": "我是卡圖拉啊！你記得嗎，就是在商隊那裡的？",
      "encoded_ascii": "^$%^,X^\"0^\"b^$6^+Q^*W^*F^(K^#e^+X^*A^*J^,X^\"d^1'^)U^)!^-j^&Z^.V",
      "encoded_base64": "XiQlXixYXiIwXiJiXiQ2XitRXipXXipGXihLXiNlXitYXipBXipKXixYXiJkXjEnXilVXikhXi1qXiZaXi5W",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_58d6f0aecbf7",
      "text": "你這麼說真是貼心。 ",
      "encoded_ascii": "^*F^(s^.T^-x^-2^,X^<G^#k^!\" ",
      "encoded_base64": "XipGXihzXi5UXi14Xi0yXixYXjxHXiNrXiEiIA==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_e2a35b80abf9",
      "text": "但你當然記得囉！",
      "encoded_ascii": "^!I^*F^&N^&\"^(K^#e^3j^*W",
      "encoded_base64": "XiFJXipGXiZOXiYiXihLXiNlXjNqXipX",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_d0bf6cb7d5d4",
      "text": "好吧，要是你非走不可的話。我真希望改天能再聚聚，但無論如何， ",
      "encoded_ascii": "^+i^*I^*A^(C^,X^*F^)i^.&^!)^\"A^&Z^-v^!\"^$%^-2^+{^,]^$N^+e^'b^!l^'[^'[^*A^!I^%}^1\\^#$^!L^*A ",
      "encoded_base64": "XitpXipJXipBXihDXixYXipGXilpXi4mXiEpXiJBXiZaXi12XiEiXiQlXi0yXit7XixdXiROXitlXidiXiFsXidbXidbXipBXiFJXiV9XjFcXiMkXiFMXipBIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_dbba4c5aa9db",
      "text": "我都會深深思念你的。",
      "encoded_ascii": "^$%^)$^$r^2*^2*^#q^1z^*F^&Z^!\"",
      "encoded_base64": "XiQlXikkXiRyXjIqXjIqXiNxXjF6XipGXiZaXiEi",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_d931d22849a4",
      "text": "當然囉。 ",
      "encoded_ascii": "^&N^&\"^3j^!\" ",
      "encoded_base64": "XiZOXiYiXjNqXiEiIA==",
      "byte_length": 13
    },
    {
      "unit_id": "DLG_d83a80b703c2",
      "text": "拉麗莎說我總有一天會名揚天下——還是說那是加林神父說的？ ",
      "encoded_ascii": "^$6^0z^/E^-x^$%^-M^$s^!%^+e^$r^\"F^2k^+e^!(^*n^*n^.7^,X^-x^)!^,X^\"\"^/1^&w^5d^-x^&Z^.V ",
      "encoded_base64": "XiQ2XjB6Xi9FXi14XiQlXi1NXiRzXiElXitlXiRyXiJGXjJrXitlXiEoXipuXipuXi43XixYXi14XikhXixYXiIiXi8xXiZ3XjVkXi14XiZaXi5WIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_abad9970d7f4",
      "text": "他又在到處說長道短了，他真愛嚼舌根。",
      "encoded_ascii": "^!@^+;^\"d^!u^(,^-x^)C^(y^&i^*D^*A^!@^-2^,2^5:^'q^%)^!\"",
      "encoded_base64": "XiFAXis7XiJkXiF1XigsXi14XilDXih5XiZpXipEXipBXiFAXi0yXiwyXjU6XidxXiUpXiEi",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_9a4226fd3023",
      "text": "  拉麗莎是誰？",
      "encoded_ascii": "  ^$6^0z^/E^,X^-y^.V",
      "encoded_base64": "ICBeJDZeMHpeL0VeLFheLXleLlY=",
      "byte_length": 20
    },
    {
      "unit_id": "DLG_e8faa984bb07",
      "text": "  關於你的親生父母，你瞭解多少？",
      "encoded_ascii": "  ^.>^$^^*F^&Z^(F^&F^5d^/s^*A^*F^<p^(I^\"x^#<^.V",
      "encoded_base64": "ICBeLj5eJF5eKkZeJlpeKEZeJkZeNWReL3NeKkFeKkZePHBeKEleInheIzxeLlY=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_a588b73977e2",
      "text": "  拉麗莎？這名字聽起來很耳熟。",
      "encoded_ascii": "  ^$6^0z^/E^.V^(s^\"F^#)^-X^.(^!O^*K^'Y^-\"^!\"",
      "encoded_base64": "ICBeJDZeMHpeL0VeLlZeKHNeIkZeIyleLVheLiheIU9eKkteJ1leLSJeISI=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_2d9ddeccedf6",
      "text": "但是",
      "encoded_ascii": "^!I^,X",
      "encoded_base64": "XiFJXixY",
      "byte_length": 6
    },
    {
      "unit_id": "DLG_65b526eb301a",
      "text": "沒錯，我確實聽到了！在你們離開後有位訪客前來",
      "encoded_ascii": "^%\\^)5^*A^$%^-6^#3^-X^!u^*D^*W^\"d^*F^*{^)`^)F^#b^$s^!J^4d^+q^!z^!O",
      "encoded_base64": "XiVcXik1XipBXiQlXi02XiMzXi1YXiF1XipEXipXXiJkXipGXip7XilgXilGXiNiXiRzXiFKXjRkXitxXiF6XiFP",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_7f8f6aa2ed2c",
      "text": " ——他長得幾乎和你一樣英俊呢， ",
      "encoded_ascii": " ^*n^*n^!@^)C^#e^#T^!0^\"O^*F^!%^,f^'y^?S^+C^*A ",
      "encoded_base64": "IF4qbl4qbl4hQF4pQ14jZV4jVF4hMF4iT14qRl4hJV4sZl4neV4/U14rQ14qQSA=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_a56a95212a21",
      "text": " ——他說 ",
      "encoded_ascii": " ^*n^*n^!@^-x ",
      "encoded_base64": "IF4qbl4qbl4hQF4teCA=",
      "byte_length": 14
    },
    {
      "unit_id": "DLG_c3013be4a91b",
      "text": "那群在遙遠西南方村莊肆虐為禍的雙足飛龍，是從一位能駕馭牠們的德魯伊手中偷來的， ",
      "encoded_ascii": "^)!^'R^\"d^4j^({^-l^\"/^$]^$z^6l^2>^3)^%{^7B^&Z^)_^(^^)z^*>^*A^,X^#f^!%^!J^'b^6E^4'^-#^*{^&Z^#j^/K^!E^$+^!,^/O^!O^&Z^*A ",
      "encoded_base64": "XikhXidSXiJkXjRqXih7Xi1sXiIvXiRdXiR6XjZsXjI+XjMpXiV7XjdCXiZaXilfXiheXil6Xio+XipBXixYXiNmXiElXiFKXidiXjZFXjQnXi0jXip7XiZaXiNqXi9LXiFFXiQrXiEsXi9PXiFPXiZaXipBIA==",
      "byte_length": 118
    },
    {
      "unit_id": "DLG_0ee682e59acd",
      "text": "正是從能控制牠們的德魯伊那裡偷走的。",
      "encoded_ascii": "^%H^,X^#f^'b^$@^!v^-#^*{^&Z^#j^/K^!E^)!^-j^/O^.&^&Z^!\"",
      "encoded_base64": "XiVIXixYXiNmXidiXiRAXiF2Xi0jXip7XiZaXiNqXi9LXiFFXikhXi1qXi9PXi4mXiZaXiEi",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_14a7842e4d88",
      "text": "蓋德隆正處於一名強大荒蕪術士的魔咒控制之下。",
      "encoded_ascii": "^-d^#j^)T^%H^(,^$^^!%^\"F^#]^\"z^1W^4b^(<^+a^&Z^*0^\"P^$@^!v^!/^!(^!\"",
      "encoded_base64": "Xi1kXiNqXilUXiVIXigsXiReXiElXiJGXiNdXiJ6XjFXXjRiXig8XithXiZaXiowXiJQXiRAXiF2XiEvXiEoXiEi",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_bd1e0f8445cf",
      "text": "他在就在南方的廢墟裡聽見了一尊亡靈的聲音。 ",
      "encoded_ascii": "^!@^\"d^*J^\"d^\"/^$]^&Z^#W^\"t^-j^-X^-m^*D^!%^+u^!:^)g^&Z^-W^34^!\" ",
      "encoded_base64": "XiFAXiJkXipKXiJkXiIvXiRdXiZaXiNXXiJ0Xi1qXi1YXi1tXipEXiElXit1XiE6XilnXiZaXi1XXjM0XiEiIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_3eb3c33ce215",
      "text": "那聲音訴說著一位英雄慘遭背叛的往事。",
      "encoded_ascii": "^)!^-W^34^-t^-x^-a^!%^!J^'y^)\\^,4^(}^.r^.Z^&Z^,)^*r^!\"",
      "encoded_base64": "XikhXi1XXjM0Xi10Xi14Xi1hXiElXiFKXid5XilcXiw0Xih9Xi5yXi5aXiZaXiwpXipyXiEi",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_e46866df9b87",
      "text": "蓋德隆位於提奎茲爾的西北方。",
      "encoded_ascii": "^-d^#j^)T^!J^$^^$A^5B^/D^&/^&Z^-l^+6^$]^!\"",
      "encoded_base64": "Xi1kXiNqXilUXiFKXiReXiRBXjVCXi9EXiYvXiZaXi1sXis2XiRdXiEi",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_9bcbe6bd66b7",
      "text": "至少，我希望你別把我當成陌生人。",
      "encoded_ascii": "^'n^#<^*A^$%^+{^,]^*F^*H^$1^$%^&N^$$^9z^&F^!<^!\"",
      "encoded_base64": "XiduXiM8XipBXiQlXit7XixdXipGXipIXiQxXiQlXiZOXiQkXjl6XiZGXiE8XiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_7efb494422d5",
      "text": "我非常期待，但眼下我們手頭還有更緊迫的事情要解決， ",
      "encoded_ascii": "^$%^)i^#O^$u^,*^*A^!I^&d^!(^$%^*{^$+^)t^.7^$s^$o^0r^1`^&Z^*r^,0^(C^(I^,o^*A ",
      "encoded_base64": "XiQlXilpXiNPXiR1XiwqXipBXiFJXiZkXiEoXiQlXip7XiQrXil0Xi43XiRzXiRvXjByXjFgXiZaXipyXiwwXihDXihJXixvXipBIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_f3c21b00b205",
      "text": "畢竟戰火正向我們逼近。在此期間，你可以收下這枚戒指， ",
      "encoded_ascii": "^;k^28^$(^%x^%H^+?^$%^*{^.1^(l^!\"^\"d^%I^$u^)G^*A^*F^\"A^!B^$M^!(^(s^$~^$&^$8^*A ",
      "encoded_base64": "XjtrXjI4XiQoXiV4XiVIXis/XiQlXip7Xi4xXihsXiEiXiJkXiVJXiR1XilHXipBXipGXiJBXiFCXiRNXiEoXihzXiR+XiQmXiQ4XipBIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_63db5ba633f0",
      "text": "作為留念我的信物。",
      "encoded_ascii": "^!M^%{^-+^1z^$%^&Z^!U^&4^!\"",
      "encoded_base64": "XiFNXiV7Xi0rXjF6XiQlXiZaXiFVXiY0XiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_157436602bc1",
      "text": "好吧。那你對什麼感興趣呢？",
      "encoded_ascii": "^+i^*I^!\"^)!^*F^#:^!=^.T^#{^-]^.*^+C^.V",
      "encoded_base64": "XitpXipJXiEiXikhXipGXiM6XiE9Xi5UXiN7Xi1dXi4qXitDXi5W",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_c29d86d2b50f",
      "text": "我只是想感謝你們對提奎茲爾施以援手。在你們到來之前，我父親非常 ",
      "encoded_ascii": "^$%^\"?^,X^,1^#{^-z^*F^*{^#:^$A^5B^/D^&/^$_^!B^$C^$+^!\"^\"d^*F^*{^!u^!O^!/^!z^*A^$%^5d^(F^)i^#O ",
      "encoded_base64": "XiQlXiI/XixYXiwxXiN7Xi16XipGXip7XiM6XiRBXjVCXi9EXiYvXiRfXiFCXiRDXiQrXiEiXiJkXipGXip7XiF1XiFPXiEvXiF6XipBXiQlXjVkXihGXilpXiNPIA==",
      "byte_length": 94
    },
    {
      "unit_id": "DLG_276f787e7ad6",
      "text": "憂心忡忡。領導村莊是如此沉重的重擔，而這場大難臨頭的預言更是 ",
      "encoded_ascii": "^91^#k^?W^?W^!\"^)s^10^$z^6l^,X^#$^%I^%Z^))^&Z^))^*N^*A^'W^(s^\"n^\"z^)a^1U^)t^&Z^.E^1Y^$o^,X ",
      "encoded_base64": "XjkxXiNrXj9XXj9XXiEiXilzXjEwXiR6XjZsXixYXiMkXiVJXiVaXikpXiZaXikpXipOXipBXidXXihzXiJuXiJ6XilhXjFVXil0XiZaXi5FXjFZXiRvXixYIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_22d33533c952",
      "text": "讓他承受著雙重的煎熬。",
      "encoded_ascii": "^-}^!@^$0^\";^-a^)_^))^&Z^?Y^<W^!\"",
      "encoded_base64": "Xi19XiFAXiQwXiI7Xi1hXilfXikpXiZaXj9ZXjxXXiEi",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_34665feb599f",
      "text": "噢，叫我卡蒂就行了。你又不是外人。 ",
      "encoded_ascii": "^+]^*A^+<^$%^\"0^(%^*J^(;^*D^!\"^*F^+;^!)^,X^\"w^!<^!\" ",
      "encoded_base64": "XitdXipBXis8XiQlXiIwXiglXipKXig7XipEXiEiXipGXis7XiEpXixYXiJ3XiE8XiEiIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_4e0d5dc634ba",
      "text": "她是商隊裡的通靈女先知。 ",
      "encoded_ascii": "^+h^,X^1'^)U^-j^&Z^(t^)g^#\"^!b^&h^!\" ",
      "encoded_base64": "XitoXixYXjEnXilVXi1qXiZaXih0XilnXiMiXiFiXiZoXiEiIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_04c79dfb9455",
      "text": "如果你想預知自己的未來，應該去拜訪她。我所有重大的決定都仰仗她的 ",
      "encoded_ascii": "^#$^%!^*F^,1^.E^&h^'l^#I^&Z^,_^!O^*A^0`^(M^\"6^,E^4d^+h^!\"^$%^$)^$s^))^\"z^&Z^,o^#.^)$^4,^0|^+h^&Z ",
      "encoded_base64": "XiMkXiUhXipGXiwxXi5FXiZoXidsXiNJXiZaXixfXiFPXipBXjBgXihNXiI2XixFXjRkXitoXiEiXiQlXiQpXiRzXikpXiJ6XiZaXixvXiMuXikkXjQsXjB8XitoXiZaIA==",
      "byte_length": 97
    },
    {
      "unit_id": "DLG_be22d260ea3d",
      "text": "指引。",
      "encoded_ascii": "^$8^#Z^!\"",
      "encoded_base64": "XiQ4XiNaXiEi",
      "byte_length": 9
    },
    {
      "unit_id": "DLG_4f7ca652a247",
      "text": "既然你已經告訴了我關於生身父母的真相，我想我再也不需要去問 ",
      "encoded_ascii": "^,U^&\"^*F^#J^'D^+B^-t^*D^$%^.>^$^^&F^(c^5d^/s^&Z^-2^&a^*A^$%^,1^$%^!l^!1^!)^)e^(C^\"6^*Z ",
      "encoded_base64": "XixVXiYiXipGXiNKXidEXitCXi10XipEXiQlXi4+XiReXiZGXihjXjVkXi9zXiZaXi0yXiZhXipBXiQlXiwxXiQlXiFsXiExXiEpXillXihDXiI2XipaIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_bf6770ec346c",
      "text": "她了——她從來就不是我過去一廂情願相信的那種強大法力先知。",
      "encoded_ascii": "^+h^*D^*n^*n^+h^#f^!O^*J^!)^,X^$%^(x^\"6^!%^?V^,0^.H^&a^!U^&Z^)!^'$^#]^\"z^%b^!~^!b^&h^!\"",
      "encoded_base64": "XitoXipEXipuXipuXitoXiNmXiFPXipKXiEpXixYXiQlXih4XiI2XiElXj9WXiwwXi5IXiZhXiFVXiZaXikhXickXiNdXiJ6XiViXiF+XiFiXiZoXiEi",
      "byte_length": 87
    },
    {
      "unit_id": "DLG_dd9f3ba66077",
      "text": "我父親什麼都不肯告訴我，儘管我問過他無數次。我覺得 ",
      "encoded_ascii": "^$%^5d^(F^!=^.T^)$^!)^-Z^+B^-t^$%^*A^+(^-D^$%^*Z^(x^!@^%}^$V^%D^!\"^$%^(G^#e ",
      "encoded_base64": "XiQlXjVkXihGXiE9Xi5UXikkXiEpXi1aXitCXi10XiQlXipBXisoXi1EXiQlXipaXih4XiFAXiV9XiRWXiVEXiEiXiQlXihHXiNlIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_a0ee19d6df70",
      "text": "他隱瞞了某些事情。你是不是知道一些連我都不知道的關於我父母的事？",
      "encoded_ascii": "^!@^)Y^?Z^*D^%$^!8^*r^,0^!\"^*F^,X^!)^,X^&h^(y^!%^!8^.0^$%^)$^!)^&h^(y^&Z^.>^$^^$%^5d^/s^&Z^*r^.V",
      "encoded_base64": "XiFAXilZXj9aXipEXiUkXiE4XipyXiwwXiEiXipGXixYXiEpXixYXiZoXih5XiElXiE4Xi4wXiQlXikkXiEpXiZoXih5XiZaXi4+XiReXiQlXjVkXi9zXiZaXipyXi5W",
      "byte_length": 96
    },
    {
      "unit_id": "DLG_3c9fba1e88a8",
      "text": "  我不能告訴你。查爾絕不會贊同的。",
      "encoded_ascii": "  ^$%^!)^'b^+B^-t^*F^!\"^%&^&/^-I^!)^$r^>K^\"E^&Z^!\"",
      "encoded_base64": "ICBeJCVeISleJ2JeK0JeLXReKkZeISJeJSZeJi9eLUleISleJHJePkteIkVeJlpeISI=",
      "byte_length": 50
    },
    {
      "unit_id": "DLG_3b2bf81be60b",
      "text": "  不清楚，但影王牽涉其中。",
      "encoded_ascii": "  ^!)^,u^,c^*A^!I^#a^-)^5e^3O^!j^!,^!\"",
      "encoded_base64": "ICBeISleLHVeLGNeKkFeIUleI2FeLSleNWVeM09eIWpeISxeISI=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_7622adab6d4d",
      "text": "  他們與尼波尼的一位聖堂武士有關聯。",
      "encoded_ascii": "  ^!@^*{^'p^#>^%c^#>^&Z^!%^!J^'Z^42^%J^+a^$s^.>^-V^!\"",
      "encoded_base64": "ICBeIUBeKnteJ3BeIz5eJWNeIz5eJlpeISVeIUpeJ1peNDJeJUpeK2FeJHNeLj5eLVZeISI=",
      "byte_length": 53
    },
    {
      "unit_id": "DLG_a60752dc9ac3",
      "text": "  我根本不知道你的父母是誰。",
      "encoded_ascii": "  ^$%^%)^$x^!)^&h^(y^*F^&Z^5d^/s^,X^-y^!\"",
      "encoded_base64": "ICBeJCVeJSleJHheISleJmheKHleKkZeJlpeNWReL3NeLFheLXleISI=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_ae043eeaf4c8",
      "text": "沒錯，",
      "encoded_ascii": "^%\\^)5^*A",
      "encoded_base64": "XiVcXik1XipB",
      "byte_length": 9
    },
    {
      "unit_id": "DLG_78ee66a77e4a",
      "text": "哎，你真不解風情！ ",
      "encoded_ascii": "^3i^*A^*F^-2^!)^(I^)y^,0^*W ",
      "encoded_base64": "XjNpXipBXipGXi0yXiEpXihJXil5XiwwXipXIA==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_04d2a4834b03",
      "text": "尼波尼的影王！",
      "encoded_ascii": "^#>^%c^#>^&Z^#a^-)^*W",
      "encoded_base64": "XiM+XiVjXiM+XiZaXiNhXi0pXipX",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_4a32275c835a",
      "text": "  我可沒說你和他有血緣關係。",
      "encoded_ascii": "  ^$%^\"A^%\\^-x^*F^\"O^!@^$s^(:^9J^.>^38^!\"",
      "encoded_base64": "ICBeJCVeIkFeJVxeLXheKkZeIk9eIUBeJHNeKDpeOUpeLj5eMzheISI=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_0555a3587a27",
      "text": "你是說查庫索拉？那個我父親曾做過其奴隸的聖堂武士？",
      "encoded_ascii": "^*F^,X^-x^%&^,#^'>^$6^.V^)!^!V^$%^5d^(F^.j^*~^(x^!j^##^)Z^&Z^'Z^42^%J^+a^.V",
      "encoded_base64": "XipGXixYXi14XiUmXiwjXic+XiQ2Xi5WXikhXiFWXiQlXjVkXihGXi5qXip+Xih4XiFqXiMjXilaXiZaXidaXjQyXiVKXithXi5W",
      "byte_length": 75
    },
    {
      "unit_id": "DLG_53cda789707a",
      "text": "  我可沒說你和她有血緣關係。",
      "encoded_ascii": "  ^$%^\"A^%\\^-x^*F^\"O^+h^$s^(:^9J^.>^38^!\"",
      "encoded_base64": "ICBeJCVeIkFeJVxeLXheKkZeIk9eK2heJHNeKDpeOUpeLj5eMzheISI=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_e9ce72acb6a0",
      "text": "噢。 ",
      "encoded_ascii": "^+]^!\" ",
      "encoded_base64": "XitdXiEiIA==",
      "byte_length": 7
    },
    {
      "unit_id": "DLG_5bb185aef88b",
      "text": " 關於我的事說得夠多了",
      "encoded_ascii": " ^.>^$^^$%^&Z^*r^-x^#e^+d^\"x^*D",
      "encoded_base64": "IF4uPl4kXl4kJV4mWl4qcl4teF4jZV4rZF4ieF4qRA==",
      "byte_length": 31
    },
    {
      "unit_id": "DLG_57ee6977642f",
      "text": "。我想多瞭解一些關於你的事，還有你那非凡的天賦資質",
      "encoded_ascii": "^!\"^$%^,1^\"x^<p^(I^!%^!8^.>^$^^*F^&Z^*r^*A^.7^$s^*F^)!^)i^+-^&Z^+e^(Y^(X^(Z",
      "encoded_base64": "XiEiXiQlXiwxXiJ4XjxwXihJXiElXiE4Xi4+XiReXipGXiZaXipyXipBXi43XiRzXipGXikhXilpXistXiZaXitlXihZXihYXiha",
      "byte_length": 75
    },
    {
      "unit_id": "DLG_5266f3e81127",
      "text": "下次見到拉麗莎時我會問問她。她一定能告訴我。",
      "encoded_ascii": "^!(^%D^-m^!u^$6^0z^/E^$f^$%^$r^*Z^*Z^+h^!\"^+h^!%^#.^'b^+B^-t^$%^!\"",
      "encoded_base64": "XiEoXiVEXi1tXiF1XiQ2XjB6Xi9FXiRmXiQlXiRyXipaXipaXitoXiEiXitoXiElXiMuXidiXitCXi10XiQlXiEi",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_e0e234d47198",
      "text": " 我就知道我的血液裡流淌著魔法！拉麗莎總說我擁有天賦—— ",
      "encoded_ascii": " ^$%^*J^&h^(y^$%^&Z^(:^%l^-j^%j^9]^-a^*0^%b^*W^$6^0z^/E^-M^-x^$%^,M^$s^+e^(Y^*n^*n ",
      "encoded_base64": "IF4kJV4qSl4maF4oeV4kJV4mWl4oOl4lbF4tal4lal45XV4tYV4qMF4lYl4qV14kNl4wel4vRV4tTV4teF4kJV4sTV4kc14rZV4oWV4qbl4qbiA=",
      "byte_length": 83
    },
    {
      "unit_id": "DLG_f2eae9c3a32f",
      "text": "這種恩賜——噢，我真迫不及待想學習該如何運用它！",
      "encoded_ascii": "^(s^'$^#v^.#^*n^*n^+]^*A^$%^-2^1`^!)^\"7^,*^,1^+n^3{^(M^#$^!L^.4^&H^+o^*W",
      "encoded_base64": "XihzXickXiN2Xi4jXipuXipuXitdXipBXiQlXi0yXjFgXiEpXiI3XiwqXiwxXituXjN7XihNXiMkXiFMXi40XiZIXitvXipX",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_d202dd571933",
      "text": "  別讓查爾知道是我告訴你的。",
      "encoded_ascii": "  ^*H^-}^%&^&/^&h^(y^,X^$%^+B^-t^*F^&Z^!\"",
      "encoded_base64": "ICBeKkheLX1eJSZeJi9eJmheKHleLFheJCVeK0JeLXReKkZeJlpeISI=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_13fff30e886e",
      "text": "  魔法可不是拿來兒戲的玩具，卡蒂。",
      "encoded_ascii": "  ^*0^%b^\"A^!)^,X^,G^!O^++^,;^&Z^4U^!k^*A^\"0^(%^!\"",
      "encoded_base64": "ICBeKjBeJWJeIkFeISleLFheLEdeIU9eKyteLDteJlpeNFVeIWteKkFeIjBeKCVeISI=",
      "byte_length": 50
    },
    {
      "unit_id": "DLG_307d32d9dd3b",
      "text": "當然不會囉， ",
      "encoded_ascii": "^&N^&\"^!)^$r^3j^*A ",
      "encoded_base64": "XiZOXiYiXiEpXiRyXjNqXipBIA==",
      "byte_length": 19
    },
    {
      "unit_id": "DLG_da33a185a6bb",
      "text": "。你和我之間可以共享許多秘密呢",
      "encoded_ascii": "^!\"^*F^\"O^$%^!/^)G^\"A^!B^3d^!;^-s^\"x^1O^#0^+C",
      "encoded_base64": "XiEiXipGXiJPXiQlXiEvXilHXiJBXiFCXjNkXiE7Xi1zXiJ4XjFPXiMwXitD",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_65a70267d9f2",
      "text": "你的意思是說它很危險嗎？魔法確實也給凱爾招惹過不少麻煩，不是嗎？ ",
      "encoded_ascii": "^*F^&Z^#z^#q^,X^-x^+o^*K^2\\^*m^+X^.V^*0^%b^-6^#3^!1^'A^!p^&/^,D^3s^(x^!)^#<^*6^-!^*A^!)^,X^+X^.V ",
      "encoded_base64": "XipGXiZaXiN6XiNxXixYXi14XitvXipLXjJcXiptXitYXi5WXiowXiViXi02XiMzXiExXidBXiFwXiYvXixEXjNzXih4XiEpXiM8Xio2Xi0hXipBXiEpXixYXitYXi5WIA==",
      "byte_length": 97
    },
    {
      "unit_id": "DLG_d7c2c3f3c951",
      "text": "那我該怎麼辦呢？",
      "encoded_ascii": "^)!^$%^(M^,,^.T^2L^+C^.V",
      "encoded_base64": "XikhXiQlXihNXiwsXi5UXjJMXitDXi5W",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_dfe5bc3fa7e0",
      "text": "  忘了魔法吧。你根本不適合它。",
      "encoded_ascii": "  ^0]^*D^*0^%b^*I^!\"^*F^%)^$x^!)^(|^\"C^+o^!\"",
      "encoded_base64": "ICBeMF1eKkReKjBeJWJeKkleISJeKkZeJSleJHheISleKHxeIkNeK29eISI=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_d9fc2cd2c36b",
      "text": "  如果你想要建議，去問你父親吧。",
      "encoded_ascii": "  ^#$^%!^*F^,1^(C^,'^-|^*A^\"6^*Z^*F^5d^(F^*I^!\"",
      "encoded_base64": "ICBeIyReJSFeKkZeLDFeKENeLCdeLXxeKkFeIjZeKlpeKkZeNWReKEZeKkleISI=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_7a14bf6283e9",
      "text": "  學會自律。魔法需要心智的成熟。",
      "encoded_ascii": "  ^+n^$r^'l^7W^!\"^*0^%b^)e^(C^#k^$i^&Z^$$^-\"^!\"",
      "encoded_base64": "ICBeK25eJHJeJ2xeN1deISJeKjBeJWJeKWVeKENeI2teJGleJlpeJCReLSJeISI=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_7905152e8e1c",
      "text": "你是什麼意思？只有這才能解釋我對魔法的親和感啊",
      "encoded_ascii": "^*F^,X^!=^.T^#z^#q^.V^\"?^$s^(s^$,^'b^(I^0w^$%^#:^*0^%b^&Z^(F^\"O^#{^+Q",
      "encoded_base64": "XipGXixYXiE9Xi5UXiN6XiNxXi5WXiI/XiRzXihzXiQsXidiXihJXjB3XiQlXiM6XiowXiViXiZaXihGXiJPXiN7XitR",
      "byte_length": 69
    },
    {
      "unit_id": "DLG_1e5cad498602",
      "text": "這麼重大的事情我怎麼可能忘得掉",
      "encoded_ascii": "^(s^.T^))^\"z^&Z^*r^,0^$%^,,^.T^\"A^'b^0]^#e^/e",
      "encoded_base64": "XihzXi5UXikpXiJ6XiZaXipyXiwwXiQlXiwsXi5UXiJBXidiXjBdXiNlXi9l",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_19933bcf0beb",
      "text": "你說得對，當然。我剛才真是太任性胡鬧了，不是嗎？",
      "encoded_ascii": "^*F^-x^#e^#:^*A^&N^&\"^!\"^$%^+0^$,^-2^,X^+f^!C^#r^3}^6G^*D^*A^!)^,X^+X^.V",
      "encoded_base64": "XipGXi14XiNlXiM6XipBXiZOXiYiXiEiXiQlXiswXiQsXi0yXixYXitmXiFDXiNyXjN9XjZHXipEXipBXiEpXixYXitYXi5W",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_0fcad3a482be",
      "text": "從今往後，我誓願用我的生命去救助那些受壓迫的人。 ",
      "encoded_ascii": "^#f^*E^,)^#b^*A^$%^-w^.H^&H^$%^&Z^&F^\"N^\"6^,Q^\"#^)!^!8^\";^4v^1`^&Z^!<^!\" ",
      "encoded_base64": "XiNmXipFXiwpXiNiXipBXiQlXi13Xi5IXiZIXiQlXiZaXiZGXiJOXiI2XixRXiIjXikhXiE4XiI7XjR2XjFgXiZaXiE8XiEiIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_ebf5557d83ac",
      "text": "有你作為榜樣，我知道我一定會成功的。",
      "encoded_ascii": "^$s^*F^!M^%{^2q^,f^*A^$%^&h^(y^$%^!%^#.^$r^$$^\"!^&Z^!\"",
      "encoded_base64": "XiRzXipGXiFNXiV7XjJxXixmXipBXiQlXiZoXih5XiQlXiElXiMuXiRyXiQkXiIhXiZaXiEi",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_5ab706635944",
      "text": " ——這實在太令人興奮了！拉麗莎一定會欣喜若狂。說不定她 ",
      "encoded_ascii": " ^*n^*n^(s^#3^\"d^+f^*w^!<^-]^+g^*D^*W^$6^0z^/E^!%^#.^$r^2'^+V^'x^&8^!\"^-x^!)^#.^+h ",
      "encoded_base64": "IF4qbl4qbl4oc14jM14iZF4rZl4qd14hPF4tXV4rZ14qRF4qV14kNl4wel4vRV4hJV4jLl4kcl4yJ14rVl4neF4mOF4hIl4teF4hKV4jLl4raCA=",
      "byte_length": 83
    },
    {
      "unit_id": "DLG_51dff7ba308e",
      "text": "和我能一起創立一個通靈學會呢。",
      "encoded_ascii": "^\"O^$%^'b^!%^.(^!{^0'^!%^!V^(t^)g^+n^$r^+C^!\"",
      "encoded_base64": "XiJPXiQlXidiXiElXi4oXiF7XjAnXiElXiFWXih0XilnXituXiRyXitDXiEi",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_7711a100feee",
      "text": "進到我屋裡來吧，這裡說話舒服些。 ",
      "encoded_ascii": "^(w^!u^$%^8y^-j^!O^*I^*A^(s^-j^-x^-v^</^,\\^!8^!\" ",
      "encoded_base64": "Xih3XiF1XiQlXjh5Xi1qXiFPXipJXipBXihzXi1qXi14Xi12XjwvXixcXiE4XiEiIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_b4da0b255aea",
      "text": "我這輩子被烈日炙烤得已經夠多了。",
      "encoded_ascii": "^$%^(s^8t^#(^(@^%|^$a^7=^/w^#e^#J^'D^+d^\"x^*D^!\"",
      "encoded_base64": "XiQlXihzXjh0XiMoXihAXiV8XiRhXjc9Xi93XiNlXiNKXidEXitkXiJ4XipEXiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_3402bd6c4ffc",
      "text": "  我沒意見。",
      "encoded_ascii": "  ^$%^%\\^#z^-m^!\"",
      "encoded_base64": "ICBeJCVeJVxeI3peLW1eISI=",
      "byte_length": 17
    },
    {
      "unit_id": "DLG_b53c9e578fdd",
      "text": "你想談些什麼呢， ",
      "encoded_ascii": "^*F^,1^0;^!8^!=^.T^+C^*A ",
      "encoded_base64": "XipGXiwxXjA7XiE4XiE9Xi5UXitDXipBIA==",
      "byte_length": 25
    },
    {
      "unit_id": "DLG_4773c6d3cc49",
      "text": "  你認為我們能打贏這場戰爭嗎？",
      "encoded_ascii": "  ^*F^(O^%{^$%^*{^'b^$-^.%^(s^\"n^$(^1I^+X^.V",
      "encoded_base64": "ICBeKkZeKE9eJXteJCVeKnteJ2JeJC1eLiVeKHNeIm5eJCheMUleK1heLlY=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_2cb7670f2c5f",
      "text": "  我想聊聊你們的村莊。",
      "encoded_ascii": "  ^$%^,1^-U^-U^*F^*{^&Z^$z^6l^!\"",
      "encoded_base64": "ICBeJCVeLDFeLVVeLVVeKkZeKnteJlpeJHpeNmxeISI=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_75b51e96b9c1",
      "text": "眼前等待著我們的是一場硬仗，這點毋庸置疑—— ",
      "encoded_ascii": "^&d^!z^'-^,*^-a^$%^*{^&Z^,X^!%^\"n^25^0|^*A^(s^*;^4~^4x^'Q^0p^*n^*n ",
      "encoded_base64": "XiZkXiF6XictXiwqXi1hXiQlXip7XiZaXixYXiElXiJuXjI1XjB8XipBXihzXio7XjR+XjR4XidRXjBwXipuXipuIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_6462ced9d796",
      "text": "但只要你能爭取到一些盟友，我們就能抵抗住德拉吉，守住 ",
      "encoded_ascii": "^!I^\"?^(C^*F^'b^1I^\":^!u^!%^!8^-0^\"8^*A^$%^*{^*J^'b^$5^$4^*z^#j^$6^\"D^*A^#+^*z ",
      "encoded_base64": "XiFJXiI/XihDXipGXidiXjFJXiI6XiF1XiElXiE4Xi0wXiI4XipBXiQlXip7XipKXidiXiQ1XiQ0Xip6XiNqXiQ2XiJEXipBXiMrXip6IA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_aa92f460f5ab",
      "text": "我們自己的陣地。",
      "encoded_ascii": "^$%^*{^'l^#I^&Z^)P^\"e^!\"",
      "encoded_base64": "XiQlXip7XidsXiNJXiZaXilQXiJlXiEi",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_00a63eb28da2",
      "text": "我們會讓他們吃盡苦頭！",
      "encoded_ascii": "^$%^*{^$r^-}^!@^*{^2^^-1^.t^)t^*W",
      "encoded_base64": "XiQlXip7XiRyXi19XiFAXip7XjJeXi0xXi50Xil0XipX",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_c6189a201b52",
      "text": "但德拉吉大軍日益壯大，我們的力量卻在縮減！也許我們 ",
      "encoded_ascii": "^!I^#j^$6^\"D^\"z^..^$a^3R^+b^\"z^*A^$%^*{^&Z^!~^)*^1&^\"d^3X^%o^*W^!1^-s^$%^*{ ",
      "encoded_base64": "XiFJXiNqXiQ2XiJEXiJ6Xi4uXiRhXjNSXitiXiJ6XipBXiQlXip7XiZaXiF+XikqXjEmXiJkXjNYXiVvXipXXiExXi1zXiQlXip7IA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_b9c6622064c0",
      "text": "應該在更糟糕的情況發生之前主動出擊。",
      "encoded_ascii": "^0`^(M^\"d^$o^-E^4\\^&Z^,0^,q^&W^&F^!/^!z^!-^\"%^!q^$F^!\"",
      "encoded_base64": "XjBgXihNXiJkXiRvXi1FXjRcXiZaXiwwXixxXiZXXiZGXiEvXiF6XiEtXiIlXiFxXiRGXiEi",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_fdb027ecaf62",
      "text": "我們的勝算越來越大了。我敢打賭，德拉吉看到我們與 ",
      "encoded_ascii": "^$%^*{^&Z^+5^-C^(]^!O^(]^\"z^*D^!\"^$%^/m^$-^=L^*A^#j^$6^\"D^*Q^!u^$%^*{^'p ",
      "encoded_base64": "XiQlXip7XiZaXis1Xi1DXihdXiFPXihdXiJ6XipEXiEiXiQlXi9tXiQtXj1MXipBXiNqXiQ2XiJEXipRXiF1XiQlXip7XidwIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_dbc1dc1463cb",
      "text": "結成同盟時，一定會大吃一驚。 ",
      "encoded_ascii": "^'@^$$^\"E^-0^$f^*A^!%^#.^$r^\"z^2^^!%^.Q^!\" ",
      "encoded_base64": "XidAXiQkXiJFXi0wXiRmXipBXiElXiMuXiRyXiJ6XjJeXiElXi5RXiEiIA==",
      "byte_length": 43
    },
    {
      "unit_id": "DLG_435c5f2749d2",
      "text": "。這絕對會是一場痛快淋漓的硬仗，我跟你保證！",
      "encoded_ascii": "^!\"^(s^-I^#:^$r^,X^!%^\"n^-.^*L^>g^>h^&Z^25^0|^*A^$%^.+^*F^!T^-{^*W",
      "encoded_base64": "XiEiXihzXi1JXiM6XiRyXixYXiElXiJuXi0uXipMXj5nXj5oXiZaXjI1XjB8XipBXiQlXi4rXipGXiFUXi17XipX",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_d12d7893b7fc",
      "text": "  德拉吉大軍有何動向？",
      "encoded_ascii": "  ^#j^$6^\"D^\"z^..^$s^!L^\"%^+?^.V",
      "encoded_base64": "ICBeI2peJDZeIkReInpeLi5eJHNeIUxeIiVeKz9eLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_f6a4521ae8e6",
      "text": "  我們對抗德拉吉的戰略是什麼？",
      "encoded_ascii": "  ^$%^*{^#:^$4^#j^$6^\"D^&Z^$(^&L^,X^!=^.T^.V",
      "encoded_base64": "ICBeJCVeKnteIzpeJDReI2peJDZeIkReJlpeJCheJkxeLFheIT1eLlReLlY=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_9c41eed1a57b",
      "text": "我想這裡和其他村莊差不多吧。這裡的每個人都曾嘗過 ",
      "encoded_ascii": "^$%^,1^(s^-j^\"O^!j^!@^$z^6l^48^!)^\"x^*I^!\"^(s^-j^&Z^%P^!V^!<^)$^.j^1o^(x ",
      "encoded_base64": "XiQlXiwxXihzXi1qXiJPXiFqXiFAXiR6XjZsXjQ4XiEpXiJ4XipJXiEiXihzXi1qXiZaXiVQXiFWXiE8XikkXi5qXjFvXih4IA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_11802f39180a",
      "text": "奴隸主皮鞭的滋味，也都是冒著生命危險才逃出生天的。",
      "encoded_ascii": "^##^)Z^!-^&[^)m^&Z^7|^1n^*A^!1^)$^,X^/P^-a^&F^\"N^2\\^*m^$,^(p^!q^&F^+e^&Z^!\"",
      "encoded_base64": "XiMjXilaXiEtXiZbXiltXiZaXjd8XjFuXipBXiExXikkXixYXi9QXi1hXiZGXiJOXjJcXiptXiQsXihwXiFxXiZGXitlXiZaXiEi",
      "byte_length": 75
    },
    {
      "unit_id": "DLG_ec4eb1ebc27d",
      "text": "  奎林會是下一任領袖嗎？",
      "encoded_ascii": "  ^5B^/1^$r^,X^!(^!%^!C^)s^7G^+X^.V",
      "encoded_base64": "ICBeNUJeLzFeJHJeLFheISheISVeIUNeKXNeN0deK1heLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_51c4d11223e2",
      "text": "  你認為誰該來領導提奎茲爾？",
      "encoded_ascii": "  ^*F^(O^%{^-y^(M^!O^)s^10^$A^5B^/D^&/^.V",
      "encoded_base64": "ICBeKkZeKE9eJXteLXleKE1eIU9eKXNeMTBeJEFeNUJeL0ReJi9eLlY=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_b465e5929e9e",
      "text": "  你對那位預言者怎麼看？",
      "encoded_ascii": "  ^*F^#:^)!^!J^.E^1Y^'V^,,^.T^*Q^.V",
      "encoded_base64": "ICBeKkZeIzpeKSFeIUpeLkVeMVleJ1ZeLCxeLlReKlFeLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_f6e8ca75b06f",
      "text": "  你能聽懂那位預言者所說的話嗎？",
      "encoded_ascii": "  ^*F^'b^-X^,6^)!^!J^.E^1Y^'V^$)^-x^&Z^-v^+X^.V",
      "encoded_base64": "ICBeKkZeJ2JeLVheLDZeKSFeIUpeLkVeMVleJ1ZeJCleLXheJlpeLXZeK1heLlY=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_74fc45124658",
      "text": "  村民們目前情況如何？",
      "encoded_ascii": "  ^$z^%T^*{^&^^!z^,0^,q^#$^!L^.V",
      "encoded_base64": "ICBeJHpeJVReKnteJl5eIXpeLDBeLHFeIyReIUxeLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_b90fef0dee47",
      "text": "抱歉失陪了，我必須著手為村莊備戰。 ",
      "encoded_ascii": "^,@^,h^\"|^8.^*D^*A^$%^#l^)r^-a^$+^%{^$z^6l^+\"^$(^!\" ",
      "encoded_base64": "XixAXixoXiJ8XjguXipEXipBXiQlXiNsXilyXi1hXiQrXiV7XiR6XjZsXisiXiQoXiEiIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_77620c773318",
      "text": "我可還沒死呢！等我死了之後，村民們自然可以決定由誰來 ",
      "encoded_ascii": "^$%^\"A^.7^%\\^%L^+C^*W^'-^$%^%L^*D^!/^#b^*A^$z^%T^*{^'l^&\"^\"A^!B^,o^#.^&I^-y^!O ",
      "encoded_base64": "XiQlXiJBXi43XiVcXiVMXitDXipXXictXiQlXiVMXipEXiEvXiNiXipBXiR6XiVUXip7XidsXiYiXiJBXiFCXixvXiMuXiZJXi15XiFPIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_ed3a7d5b022a",
      "text": "領導他們……不過我想我的年紀也確實夠老了，老到大家不得不考慮這件事， ",
      "encoded_ascii": "^)s^10^!@^*{^*o^*o^!)^(x^$%^,1^$%^&Z^+~^2:^!1^-6^#3^+d^'U^*D^*A^'U^!u^\"z^+s^!)^#e^!)^-R^19^(s^.W^*r^*A ",
      "encoded_base64": "XilzXjEwXiFAXip7XipvXipvXiEpXih4XiQlXiwxXiQlXiZaXit+XjI6XiExXi02XiMzXitkXidVXipEXipBXidVXiF1XiJ6XitzXiEpXiNlXiEpXi1SXjE5XihzXi5XXipyXipBIA==",
      "byte_length": 103
    },
    {
      "unit_id": "DLG_4b1a4128704f",
      "text": "尤其是在大戰威脅當前的時候。",
      "encoded_ascii": "^6V^!j^,X^\"d^\"z^$(^#&^1T^&N^!z^&Z^$f^*|^!\"",
      "encoded_base64": "XjZWXiFqXixYXiJkXiJ6XiQoXiMmXjFUXiZOXiF6XiZaXiRmXip8XiEi",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_9c7853021f97",
      "text": "副手確實挺聰明，但我覺得他太在乎自己了。 ",
      "encoded_ascii": "^52^$+^-6^#3^,I^2=^$c^*A^!I^$%^(G^#e^!@^+f^\"d^!0^'l^#I^*D^!\" ",
      "encoded_base64": "XjUyXiQrXi02XiMzXixJXjI9XiRjXipBXiFJXiQlXihHXiNlXiFAXitmXiJkXiEwXidsXiNJXipEXiEiIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_5bab34d01602",
      "text": "一位領袖必須隨時準備好為了村莊的利益而做出 ",
      "encoded_ascii": "^!%^!J^)s^7G^#l^)r^)X^$f^,x^+\"^+i^%{^*D^$z^6l^&Z^!t^3R^'W^*~^!q ",
      "encoded_base64": "XiElXiFKXilzXjdHXiNsXilyXilYXiRmXix4XisiXitpXiV7XipEXiR6XjZsXiZaXiF0XjNSXidXXip+XiFxIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_d717ff5f09e0",
      "text": "犧牲。",
      "encoded_ascii": "^2w^1J^!\"",
      "encoded_base64": "XjJ3XjFKXiEi",
      "byte_length": 9
    },
    {
      "unit_id": "DLG_53c2e9af0cae",
      "text": "不知道。換作是我，我會選擇像你這樣的人， ",
      "encoded_ascii": "^!)^&h^(y^!\"^4@^!M^,X^$%^*A^$%^$r^.6^,N^!`^*F^(s^,f^&Z^!<^*A ",
      "encoded_base64": "XiEpXiZoXih5XiEiXjRAXiFNXixYXiQlXipBXiQlXiRyXi42XixOXiFgXipGXihzXixmXiZaXiE8XipBIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_6d732ec10254",
      "text": "。村民們需要的是一位能讓他們依靠、保護他們的領袖。",
      "encoded_ascii": "^!\"^$z^%T^*{^)e^(C^&Z^,X^!%^!J^'b^-}^!@^*{^!Q^.C^!!^!T^(T^!@^*{^&Z^)s^7G^!\"",
      "encoded_base64": "XiEiXiR6XiVUXip7XillXihDXiZaXixYXiElXiFKXidiXi19XiFAXip7XiFRXi5DXiEhXiFUXihUXiFAXip7XiZaXilzXjdHXiEi",
      "byte_length": 75
    },
    {
      "unit_id": "DLG_630c709cee5c",
      "text": "我不懂魔法，也不假裝懂。我只知道 ",
      "encoded_ascii": "^$%^!)^,6^*0^%b^*A^!1^!)^1i^(A^,6^!\"^$%^\"?^&h^(y ",
      "encoded_base64": "XiQlXiEpXiw2XiowXiViXipBXiExXiEpXjFpXihBXiw2XiEiXiQlXiI/XiZoXih5IA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_76c6a676b07e",
      "text": "他所預言的事情全都應驗了。",
      "encoded_ascii": "^!@^$)^.E^1Y^&Z^*r^,0^!h^)$^0`^.P^*D^!\"",
      "encoded_base64": "XiFAXiQpXi5FXjFZXiZaXipyXiwwXiFoXikkXjBgXi5QXipEXiEi",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_c3bda5b3aaf4",
      "text": "我的議會花了許多時間研討預言者的話語， ",
      "encoded_ascii": "^$%^&Z^-|^$r^'w^*D^-s^\"x^$f^)G^9G^-o^.E^1Y^'V^&Z^-v^0:^*A ",
      "encoded_base64": "XiQlXiZaXi18XiRyXid3XipEXi1zXiJ4XiRmXilHXjlHXi1vXi5FXjFZXidWXiZaXi12XjA6XipBIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_3883ea676602",
      "text": "但重點不在於他說了什麼，而在於他看見了什麼。我們的凡俗之眼與他的先知之眼 ",
      "encoded_ascii": "^!I^))^*;^!)^\"d^$^^!@^-x^*D^!=^.T^*A^'W^\"d^$^^!@^*Q^-m^*D^!=^.T^!\"^$%^*{^&Z^+-^8e^!/^&d^'p^!@^&Z^!b^&h^!/^&d ",
      "encoded_base64": "XiFJXikpXio7XiEpXiJkXiReXiFAXi14XipEXiE9Xi5UXipBXidXXiJkXiReXiFAXipRXi1tXipEXiE9Xi5UXiEiXiQlXip7XiZaXistXjhlXiEvXiZkXidwXiFAXiZaXiFiXiZoXiEvXiZkIA==",
      "byte_length": 109
    },
    {
      "unit_id": "DLG_9e29fa58df88",
      "text": "截然不同。",
      "encoded_ascii": "^:y^&\"^!)^\"E^!\"",
      "encoded_base64": "Xjp5XiYiXiEpXiJFXiEi",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_1c4174540ee4",
      "text": "預言者的話讓他們憂心忡忡，但只要你能帶回一些盟友， ",
      "encoded_ascii": "^.E^1Y^'V^&Z^-v^-}^!@^*{^91^#k^?W^?W^*A^!I^\"?^(C^*F^'b^#N^\"\\^!%^!8^-0^\"8^*A ",
      "encoded_base64": "Xi5FXjFZXidWXiZaXi12Xi19XiFAXip7XjkxXiNrXj9XXj9XXipBXiFJXiI/XihDXipGXidiXiNOXiJcXiElXiE4Xi0wXiI4XipBIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_9c397fc6c85e",
      "text": "大家的心態就會好轉。若非彼此都是堅韌善良之輩，他們當初早就像普通奴隸一樣死絕了。 ",
      "encoded_ascii": "^\"z^+s^&Z^#k^#|^*J^$r^+i^(i^!\"^'x^)i^:E^%I^)$^,X^\"l^)n^1(^1V^!/^8t^*A^!@^*{^&N^1\"^,V^*J^!`^$g^(t^##^)Z^!%^,f^%L^-I^*D^!\" ",
      "encoded_base64": "XiJ6XitzXiZaXiNrXiN8XipKXiRyXitpXihpXiEiXid4XilpXjpFXiVJXikkXixYXiJsXiluXjEoXjFWXiEvXjh0XipBXiFAXip7XiZOXjEiXixWXipKXiFgXiRnXih0XiMjXilaXiElXixmXiVMXi1JXipEXiEiIA==",
      "byte_length": 121
    },
    {
      "unit_id": "DLG_64795c74641a",
      "text": "根本不可能活著走到今天。",
      "encoded_ascii": "^%)^$x^!)^\"A^'b^%i^-a^.&^!u^*E^+e^!\"",
      "encoded_base64": "XiUpXiR4XiEpXiJBXidiXiVpXi1hXi4mXiF1XipFXitlXiEi",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_c69a619b5b80",
      "text": "沒有人比這些村民更有赤誠之心，但他們過去的經歷並不能給他們太多勇氣。 ",
      "encoded_ascii": "^%\\^$s^!<^,m^(s^!8^$z^%T^$o^$s^2H^2E^!/^#k^*A^!I^!@^*{^(x^\"6^&Z^'D^6^^!+^!)^'b^'A^!@^*{^+f^\"x^\"$^%U^!\" ",
      "encoded_base64": "XiVcXiRzXiE8XixtXihzXiE4XiR6XiVUXiRvXiRzXjJIXjJFXiEvXiNrXipBXiFJXiFAXip7Xih4XiI2XiZaXidEXjZeXiErXiEpXidiXidBXiFAXip7XitmXiJ4XiIkXiVVXiEiIA==",
      "byte_length": 103
    },
    {
      "unit_id": "DLG_59d1e7078754",
      "text": "如果我們能爭取到盟友， ",
      "encoded_ascii": "^#$^%!^$%^*{^'b^1I^\":^!u^-0^\"8^*A ",
      "encoded_base64": "XiMkXiUhXiQlXip7XidiXjFJXiI6XiF1Xi0wXiI4XipBIA==",
      "byte_length": 34
    },
    {
      "unit_id": "DLG_0928fb9ac778",
      "text": "至少能給他們帶來希望。",
      "encoded_ascii": "^'n^#<^'b^'A^!@^*{^#N^!O^+{^,]^!\"",
      "encoded_base64": "XiduXiM8XidiXidBXiFAXip7XiNOXiFPXit7XixdXiEi",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_661be47f6323",
      "text": "村民們迫不及待想讓德拉吉見識見識他們的骨氣。正是來自 ",
      "encoded_ascii": "^$z^%T^*{^1`^!)^\"7^,*^,1^-}^#j^$6^\"D^-m^(R^-m^(R^!@^*{^&Z^*$^%U^!\"^%H^,X^!O^'l ",
      "encoded_base64": "XiR6XiVUXip7XjFgXiEpXiI3XiwqXiwxXi19XiNqXiQ2XiJEXi1tXihSXi1tXihSXiFAXip7XiZaXiokXiVVXiEiXiVIXixYXiFPXidsIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_699481e20523",
      "text": "的戰士們抵達， ",
      "encoded_ascii": "^&Z^$(^+a^*{^$5^(z^*A ",
      "encoded_base64": "XiZaXiQoXithXip7XiQ1Xih6XipBIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_ddf7947e5069",
      "text": " 鼓舞了他們的勇氣。",
      "encoded_ascii": " ^*<^9s^*D^!@^*{^&Z^\"$^%U^!\"",
      "encoded_base64": "IF4qPF45c14qRF4hQF4qe14mWl4iJF4lVV4hIg==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_95f5c7dbdf63",
      "text": "目前尚未發現敵軍調動的蹤跡，但這種平靜 ",
      "encoded_ascii": "^&^^!z^+v^,_^&W^&?^$U^..^(Q^\"%^&Z^(b^(`^*A^!I^(s^'$^0Y^)h ",
      "encoded_base64": "XiZeXiF6Xit2XixfXiZXXiY/XiRVXi4uXihRXiIlXiZaXihiXihgXipBXiFJXihzXickXjBZXiloIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_bc8574e1444e",
      "text": "很快就會改變了。",
      "encoded_ascii": "^*K^*L^*J^$r^$N^(U^*D^!\"",
      "encoded_base64": "XipLXipMXipKXiRyXiROXihVXipEXiEi",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_112884f6357d",
      "text": "德拉吉在做什麼並不重要。他們的大軍遲早會前來進攻， ",
      "encoded_ascii": "^#j^$6^\"D^\"d^*~^!=^.T^!+^!)^))^(C^!\"^!@^*{^&Z^\"z^..^.5^,V^$r^!z^!O^(w^$O^*A ",
      "encoded_base64": "XiNqXiQ2XiJEXiJkXip+XiE9Xi5UXiErXiEpXikpXihDXiEiXiFAXip7XiZaXiJ6Xi4uXi41XixWXiRyXiF6XiFPXih3XiRPXipBIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_12ac61af144d",
      "text": "而我們必須擁有堅定不移、屹立不倒的力量！ ",
      "encoded_ascii": "^'W^$%^*{^#l^)r^,M^$s^\"l^#.^!)^'\"^!!^?U^0'^!)^!X^&Z^!~^)*^*W ",
      "encoded_base64": "XidXXiQlXip7XiNsXilyXixNXiRzXiJsXiMuXiEpXiciXiEhXj9VXjAnXiEpXiFYXiZaXiF+XikqXipXIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_2425f138a6c1",
      "text": "其他事情都不值一提。",
      "encoded_ascii": "^!j^!@^*r^,0^)$^!)^!Z^!%^$A^!\"",
      "encoded_base64": "XiFqXiFAXipyXiwwXikkXiEpXiFaXiElXiRBXiEi",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_34069c829880",
      "text": "我們要戰鬥到底，直到擊潰敵軍，或是戰死沙場。 ",
      "encoded_ascii": "^$%^*{^(C^$(^*,^!u^/^^*A^&`^!u^$F^2-^$U^..^*A^$'^,X^$(^%L^%]^\"n^!\" ",
      "encoded_base64": "XiQlXip7XihDXiQoXiosXiF1Xi9eXipBXiZgXiF1XiRGXjItXiRVXi4uXipBXiQnXixYXiQoXiVMXiVdXiJuXiEiIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_fb355466b0e3",
      "text": "視死如歸的決心就是足夠強大的戰略。這會讓我們比任何繁複的計劃 ",
      "encoded_ascii": "^(E^%L^#$^%K^&Z^,o^#k^*J^,X^(^^+d^#]^\"z^&Z^$(^&L^!\"^(s^$r^-}^$%^*{^,m^!C^!L^-N^6s^&Z^-n^4s ",
      "encoded_base64": "XihFXiVMXiMkXiVLXiZaXixvXiNrXipKXixYXiheXitkXiNdXiJ6XiZaXiQoXiZMXiEiXihzXiRyXi19XiQlXip7XixtXiFDXiFMXi1OXjZzXiZaXi1uXjRzIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_cd0baaa20793",
      "text": "都更加堅不可摧。",
      "encoded_ascii": "^)$^$o^\"\"^\"l^!)^\"A^$E^!\"",
      "encoded_base64": "XikkXiRvXiIiXiJsXiEpXiJBXiRFXiEi",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_eb8bc7cc331a",
      "text": "你的個人魅力 ",
      "encoded_ascii": "^*F^&Z^!V^!<^*/^!~ ",
      "encoded_base64": "XipGXiZaXiFWXiE8XiovXiF+IA==",
      "byte_length": 19
    },
    {
      "unit_id": "DLG_d529d2883065",
      "text": "  你臉上的傷疤可不這麼說。",
      "encoded_ascii": "  ^*F^-\\^!'^&Z^!^^5g^\"A^!)^(s^.T^-x^!\"",
      "encoded_base64": "ICBeKkZeLVxeISdeJlpeIV5eNWdeIkFeISleKHNeLlReLXheISI=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_36263507d3e6",
      "text": "  別人可不是這麼說的。",
      "encoded_ascii": "  ^*H^!<^\"A^!)^,X^(s^.T^-x^&Z^!\"",
      "encoded_base64": "ICBeKkheITxeIkFeISleLFheKHNeLlReLXheJlpeISI=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_8da40fdc4220",
      "text": "  那就算了吧。",
      "encoded_ascii": "  ^)!^*J^-C^*D^*I^!\"",
      "encoded_base64": "ICBeKSFeKkpeLUNeKkReKkleISI=",
      "byte_length": 20
    },
    {
      "unit_id": "DLG_7809ff7ba349",
      "text": "  你臉上的傷疤是怎麼來的？",
      "encoded_ascii": "  ^*F^-\\^!'^&Z^!^^5g^,X^,,^.T^!O^&Z^.V",
      "encoded_base64": "ICBeKkZeLVxeISdeJlpeIV5eNWdeLFheLCxeLlReIU9eJlpeLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_4c903acd9ce0",
      "text": "  跟我說說你的女兒卡圖拉吧。",
      "encoded_ascii": "  ^.+^$%^-x^-x^*F^&Z^#\"^++^\"0^\"b^$6^*I^!\"",
      "encoded_base64": "ICBeLiteJCVeLXheLXheKkZeJlpeIyJeKyteIjBeImJeJDZeKkleISI=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_28d510943d22",
      "text": "  這些給巨人用的兵器是做什麼的？",
      "encoded_ascii": "  ^(s^!8^'A^#H^!<^&H^&Z^+,^\"V^,X^*~^!=^.T^&Z^.V",
      "encoded_base64": "ICBeKHNeITheJ0FeI0heITxeJkheJlpeKyxeIlZeLFheKn5eIT1eLlReJlpeLlY=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_ad48b779dc29",
      "text": "  你在尼波尼的生活是怎樣的？",
      "encoded_ascii": "  ^*F^\"d^#>^%c^#>^&Z^&F^%i^,X^,,^,f^&Z^.V",
      "encoded_base64": "ICBeKkZeImReIz5eJWNeIz5eJlpeJkZeJWleLFheLCxeLGZeJlpeLlY=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_fa558d81c1ec",
      "text": "  你曾服侍過的那位聖堂武士主人是誰？",
      "encoded_ascii": "  ^*F^.j^,\\^0}^(x^&Z^)!^!J^'Z^42^%J^+a^!-^!<^,X^-y^.V",
      "encoded_base64": "ICBeKkZeLmpeLFxeMH1eKHheJlpeKSFeIUpeJ1peNDJeJUpeK2FeIS1eITxeLFheLXleLlY=",
      "byte_length": 53
    },
    {
      "unit_id": "DLG_934d44f0516e",
      "text": "沒什麼好說的。穆爾人的日子向來平淡無奇得很。",
      "encoded_ascii": "^%\\^!=^.T^+i^-x^&Z^!\"^8K^&/^!<^&Z^$a^#(^+?^!O^0Y^5_^%}^\"}^#e^*K^!\"",
      "encoded_base64": "XiVcXiE9Xi5UXitpXi14XiZaXiEiXjhLXiYvXiE8XiZaXiRhXiMoXis/XiFPXjBZXjVfXiV9XiJ9XiNlXipLXiEi",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_e822b35e0997",
      "text": "我想我臉上確實有幾道疤——但我可不是為了逞英雄才掛彩的， ",
      "encoded_ascii": "^$%^,1^$%^-\\^!'^-6^#3^$s^#T^(y^5g^*n^*n^!I^$%^\"A^!)^,X^%{^*D^?\\^'y^)\\^$,^$=^#`^&Z^*A ",
      "encoded_base64": "XiQlXiwxXiQlXi1cXiEnXi02XiMzXiRzXiNUXih5XjVnXipuXipuXiFJXiQlXiJBXiEpXixYXiV7XipEXj9cXid5XilcXiQsXiQ9XiNgXiZaXipBIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_a00b345c120c",
      "text": "根本不是什麼英勇壯舉。",
      "encoded_ascii": "^%)^$x^!)^,X^!=^.T^'y^\"$^+b^01^!\"",
      "encoded_base64": "XiUpXiR4XiEpXixYXiE9Xi5UXid5XiIkXitiXjAxXiEi",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_aefd6618dbc0",
      "text": "在亞薩斯，每個人身上都有傷疤。沒什麼特別的。",
      "encoded_ascii": "^\"d^!9^-e^$[^*A^%P^!V^!<^(c^!'^)$^$s^!^^5g^!\"^%\\^!=^.T^&5^*H^&Z^!\"",
      "encoded_base64": "XiJkXiE5Xi1lXiRbXipBXiVQXiFWXiE8XihjXiEnXikkXiRzXiFeXjVnXiEiXiVcXiE9Xi5UXiY1XipIXiZaXiEi",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_a9e44554f1f7",
      "text": "我想再爭辯也是徒勞——但我絕不是什麼英雄， ",
      "encoded_ascii": "^$%^,1^!l^1I^?-^!1^,X^#d^/R^*n^*n^!I^$%^-I^!)^,X^!=^.T^'y^)\\^*A ",
      "encoded_base64": "XiQlXiwxXiFsXjFJXj8tXiExXixYXiNkXi9SXipuXipuXiFJXiQlXi1JXiEpXixYXiE9Xi5UXid5XilcXipBIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_7a2a153dac61",
      "text": "根本不像你們那樣。",
      "encoded_ascii": "^%)^$x^!)^!`^*F^*{^)!^,f^!\"",
      "encoded_base64": "XiUpXiR4XiEpXiFgXipGXip7XikhXixmXiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_d1d1860dc379",
      "text": "人們廢話太多了。",
      "encoded_ascii": "^!<^*{^#W^-v^+f^\"x^*D^!\"",
      "encoded_base64": "XiE8Xip7XiNXXi12XitmXiJ4XipEXiEi",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_e87c271a3e49",
      "text": "我曾在淤泥海的一座島上與幾名巨人同住過一陣子。我想他們後來漸漸尊重我了， ",
      "encoded_ascii": "^$%^.j^\"d^6c^%d^6`^&Z^!%^/_^=)^!'^'p^#T^\"F^#H^!<^\"E^*z^(x^!%^)P^#(^!\"^$%^,1^!@^*{^#b^!O^2v^2v^+u^))^$%^*D^*A ",
      "encoded_base64": "XiQlXi5qXiJkXjZjXiVkXjZgXiZaXiElXi9fXj0pXiEnXidwXiNUXiJGXiNIXiE8XiJFXip6Xih4XiElXilQXiMoXiEiXiQlXiwxXiFAXip7XiNiXiFPXjJ2XjJ2Xit1XikpXiQlXipEXipBIA==",
      "byte_length": 109
    },
    {
      "unit_id": "DLG_6cbf1e7d200d",
      "text": "於是在我動身離開時將這些禮物贈予了我。",
      "encoded_ascii": "^$^^,X^\"d^$%^\"%^(c^)`^)F^$f^#7^(s^!8^-8^&4^([^!4^*D^$%^!\"",
      "encoded_base64": "XiReXixYXiJkXiQlXiIlXihjXilgXilGXiRmXiM3XihzXiE4Xi04XiY0XihbXiE0XipEXiQlXiEi",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_ebfcde318911",
      "text": "那是橫渡淤泥海的時候。有位聖堂武士一心想置我於死地， ",
      "encoded_ascii": "^)!^,X^/2^?X^6c^%d^6`^&Z^$f^*|^!\"^$s^!J^'Z^42^%J^+a^!%^#k^,1^'Q^$%^$^^%L^\"e^*A ",
      "encoded_base64": "XikhXixYXi8yXj9YXjZjXiVkXjZgXiZaXiRmXip8XiEiXiRzXiFKXidaXjQyXiVKXithXiElXiNrXiwxXidRXiQlXiReXiVMXiJlXipBIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_1a6b27247052",
      "text": "我唯一能逃脫的辦法就是遁入沙塵暴中隱匿蹤跡。我是在說服一名巨人背著我 ",
      "encoded_ascii": "^$%^+O^!%^'b^(p^'c^&Z^2L^%b^*J^,X^?]^!f^%]^\"p^$m^!,^)Y^7%^(b^(`^!\"^$%^,X^\"d^-x^,\\^!%^\"F^#H^!<^.r^-a^$% ",
      "encoded_base64": "XiQlXitPXiElXidiXihwXidjXiZaXjJMXiViXipKXixYXj9dXiFmXiVdXiJwXiRtXiEsXilZXjclXihiXihgXiEiXiQlXixYXiJkXi14XixcXiElXiJGXiNIXiE8Xi5yXi1hXiQlIA==",
      "byte_length": 103
    },
    {
      "unit_id": "DLG_1f56a46fb3a1",
      "text": "穿過淤泥深處時弄到這滿臉傷疤的。 ",
      "encoded_ascii": "^')^(x^6c^%d^2*^(,^$f^/`^!u^(s^,{^-\\^!^^5g^&Z^!\" ",
      "encoded_base64": "XicpXih4XjZjXiVkXjIqXigsXiRmXi9gXiF1XihzXix7Xi1cXiFeXjVnXiZaXiEiIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_f1d078c9b684",
      "text": "硬是把他踩著淤泥背我過去說服妥當。",
      "encoded_ascii": "^25^,X^$1^!@^0A^-a^6c^%d^.r^$%^(x^\"6^-x^,\\^5C^&N^!\"",
      "encoded_base64": "XjI1XixYXiQxXiFAXjBBXi1hXjZjXiVkXi5yXiQlXih4XiI2Xi14XixcXjVDXiZOXiEi",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_9766c54769ef",
      "text": "  你是怎麼說服那名巨人的？",
      "encoded_ascii": "  ^*F^,X^,,^.T^-x^,\\^)!^\"F^#H^!<^&Z^.V",
      "encoded_base64": "ICBeKkZeLFheLCxeLlReLXheLFxeKSFeIkZeI0heITxeJlpeLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_e493414b394e",
      "text": "  為什麼會有聖堂武士追捕你？",
      "encoded_ascii": "  ^%{^!=^.T^$r^$s^'Z^42^%J^+a^(o^4?^*F^.V",
      "encoded_base64": "ICBeJXteIT1eLlReJHJeJHNeJ1peNDJeJUpeK2FeKG9eND9eKkZeLlY=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_ad23f46a0b82",
      "text": "  那位聖堂武士只是想要回你帶走的那個孩子。",
      "encoded_ascii": "  ^)!^!J^'Z^42^%J^+a^\"?^,X^,1^(C^\"\\^*F^#N^.&^&Z^)!^!V^+m^#(^!\"",
      "encoded_base64": "ICBeKSFeIUpeJ1peNDJeJUpeK2FeIj9eLFheLDFeKENeIlxeKkZeI05eLiZeJlpeKSFeIVZeK21eIyheISI=",
      "byte_length": 62
    },
    {
      "unit_id": "DLG_9b979e7b5dc6",
      "text": "  為什麼影王會想要那個孩子？",
      "encoded_ascii": "  ^%{^!=^.T^#a^-)^$r^,1^(C^)!^!V^+m^#(^.V",
      "encoded_base64": "ICBeJXteIT1eLlReI2FeLSleJHJeLDFeKENeKSFeIVZeK21eIyheLlY=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_191fad52c0a9",
      "text": "  那就是你弄到這些巨人兵器的原因嗎？",
      "encoded_ascii": "  ^)!^*J^,X^*F^/`^!u^(s^!8^#H^!<^+,^\"V^&Z^\"5^\"]^+X^.V",
      "encoded_base64": "ICBeKSFeKkpeLFheKkZeL2BeIXVeKHNeITheI0heITxeKyxeIlZeJlpeIjVeIl1eK1heLlY=",
      "byte_length": 53
    },
    {
      "unit_id": "DLG_4269b2407035",
      "text": "我不是個心慈手軟之輩，但卡蒂牽動著我的心——自從她來到我身邊起便是如此。 ",
      "encoded_ascii": "^$%^!)^,X^!V^#k^3H^$+^.x^!/^8t^*A^!I^\"0^(%^5e^\"%^-a^$%^&Z^#k^*n^*n^'l^#f^+h^!O^!u^$%^(c^.8^.(^!R^,X^#$^%I^!\" ",
      "encoded_base64": "XiQlXiEpXixYXiFWXiNrXjNIXiQrXi54XiEvXjh0XipBXiFJXiIwXiglXjVlXiIlXi1hXiQlXiZaXiNrXipuXipuXidsXiNmXitoXiFPXiF1XiQlXihjXi44Xi4oXiFSXixYXiMkXiVJXiEiIA==",
      "byte_length": 109
    },
    {
      "unit_id": "DLG_41b3343cf842",
      "text": "或許是因為我們穆爾人注定無法擁有親生骨肉吧。 ",
      "encoded_ascii": "^$'^-s^,X^\"]^%{^$%^*{^8K^&/^!<^%e^#.^%}^%b^,M^$s^(F^&F^*$^'^^*I^!\" ",
      "encoded_base64": "XiQnXi1zXixYXiJdXiV7XiQlXip7XjhLXiYvXiE8XiVlXiMuXiV9XiViXixNXiRzXihGXiZGXiokXideXipJXiEiIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_a146909b79dd",
      "text": "永遠不可能有自己的孩子。",
      "encoded_ascii": "^%W^({^!)^\"A^'b^$s^'l^#I^&Z^+m^#(^!\"",
      "encoded_base64": "XiVXXih7XiEpXiJBXidiXiRzXidsXiNJXiZaXittXiMoXiEi",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_515626912453",
      "text": "  你為了她忍受了太多太多。",
      "encoded_ascii": "  ^*F^%{^*D^+h^1y^\";^*D^+f^\"x^+f^\"x^!\"",
      "encoded_base64": "ICBeKkZeJXteKkReK2heMXleIjteKkReK2ZeInheK2ZeInheISI=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_8612937ab0f8",
      "text": "  她的生身父母究竟是誰？",
      "encoded_ascii": "  ^+h^&Z^&F^(c^5d^/s^-<^28^,X^-y^.V",
      "encoded_base64": "ICBeK2heJlpeJkZeKGNeNWReL3NeLTxeMjheLFheLXleLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_7dc8568e3754",
      "text": "  卡圖拉知道多少？",
      "encoded_ascii": "  ^\"0^\"b^$6^&h^(y^\"x^#<^.V",
      "encoded_base64": "ICBeIjBeImJeJDZeJmheKHleInheIzxeLlY=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_fedbf3e60cb2",
      "text": "  那位聖堂武士出巡竟然不帶保鏢？",
      "encoded_ascii": "  ^)!^!J^'Z^42^%J^+a^!q^8g^28^&\"^!)^#N^!T^?^^.V",
      "encoded_base64": "ICBeKSFeIUpeJ1peNDJeJUpeK2FeIXFeOGdeMjheJiJeISleI05eIVReP15eLlY=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_1e93e31ca318",
      "text": "我曾在尼波尼身為奴隸。這應該足以讓你們明白我在那裡的生活是怎樣的了。 ",
      "encoded_ascii": "^$%^.j^\"d^#>^%c^#>^(c^%{^##^)Z^!\"^(s^0`^(M^(^^!B^-}^*F^*{^$c^&X^$%^\"d^)!^-j^&Z^&F^%i^,X^,,^,f^&Z^*D^!\" ",
      "encoded_base64": "XiQlXi5qXiJkXiM+XiVjXiM+XihjXiV7XiMjXilaXiEiXihzXjBgXihNXiheXiFCXi19XipGXip7XiRjXiZYXiQlXiJkXikhXi1qXiZaXiZGXiVpXixYXiwsXixmXiZaXipEXiEiIA==",
      "byte_length": 103
    },
    {
      "unit_id": "DLG_0d4c1cf696f2",
      "text": "那種日子根本不值一提。",
      "encoded_ascii": "^)!^'$^$a^#(^%)^$x^!)^!Z^!%^$A^!\"",
      "encoded_base64": "XikhXickXiRhXiMoXiUpXiR4XiEpXiFaXiElXiRBXiEi",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_27831a4d45a0",
      "text": "她的名字叫查庫索拉，如果這真有什麼要緊的話。她是尼波尼影王面前的紅人。 ",
      "encoded_ascii": "^+h^&Z^\"F^#)^+<^%&^,#^'>^$6^*A^#$^%!^(s^-2^$s^!=^.T^(C^0r^&Z^-v^!\"^+h^,X^#>^%c^#>^#a^-)^)j^!z^&Z^3!^!<^!\" ",
      "encoded_base64": "XitoXiZaXiJGXiMpXis8XiUmXiwjXic+XiQ2XipBXiMkXiUhXihzXi0yXiRzXiE9Xi5UXihDXjByXiZaXi12XiEiXitoXixYXiM+XiVjXiM+XiNhXi0pXilqXiF6XiZaXjMhXiE8XiEiIA==",
      "byte_length": 106
    },
    {
      "unit_id": "DLG_e5f760098de1",
      "text": "查庫索拉曾自詡正是由她維繫著影王的不朽生命。 ",
      "encoded_ascii": "^%&^,#^'>^$6^.j^'l^?[^%H^,X^&I^+h^'F^:;^-a^#a^-)^&Z^!)^3K^&F^\"N^!\" ",
      "encoded_base64": "XiUmXiwjXic+XiQ2Xi5qXidsXj9bXiVIXixYXiZJXitoXidGXjo7Xi1hXiNhXi0pXiZaXiEpXjNLXiZGXiJOXiEiIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_f5d33633b8d4",
      "text": "才得以永生不滅。",
      "encoded_ascii": "^$,^#e^!B^%W^&F^!)^%t^!\"",
      "encoded_base64": "XiQsXiNlXiFCXiVXXiZGXiEpXiV0XiEi",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_39740a208567",
      "text": "具備足夠的說服力",
      "encoded_ascii": "^!k^+\"^(^^+d^&Z^-x^,\\^!~",
      "encoded_base64": "XiFrXisiXiheXitkXiZaXi14XixcXiF+",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_4c00985b9870",
      "text": "未能奏效",
      "encoded_ascii": "^,_^'b^8F^$Q",
      "encoded_base64": "XixfXidiXjhGXiRR",
      "byte_length": 12
    },
    {
      "unit_id": "DLG_a068ea31e4c2",
      "text": "我向他發起互毆較量，並設法將他徹底打暈過去——但在那之前，他那如岩石般的鐵拳已經給了我一張全新的面孔。 ",
      "encoded_ascii": "^$%^+?^!@^&W^.(^*s^5[^(f^)*^*A^!+^4e^%b^#7^!@^18^/^^$-^$j^(x^\"6^*n^*n^!I^\"d^)!^!/^!z^*A^!@^)!^#$^#D^&k^'r^&Z^)?^<k^#J^'D^'A^*D^$%^!%^,(^!h^$\\^&Z^)j^5G^!\" ",
      "encoded_base64": "XiQlXis/XiFAXiZXXi4oXipzXjVbXihmXikqXipBXiErXjRlXiViXiM3XiFAXjE4Xi9eXiQtXiRqXih4XiI2XipuXipuXiFJXiJkXikhXiEvXiF6XipBXiFAXikhXiMkXiNEXiZrXidyXiZaXik/XjxrXiNKXidEXidBXipEXiQlXiElXiwoXiFoXiRcXiZaXilqXjVHXiEiIA==",
      "byte_length": 154
    },
    {
      "unit_id": "DLG_98a43920e75f",
      "text": "徹底把我打得面目全非。",
      "encoded_ascii": "^18^/^^$1^$%^$-^#e^)j^&^^!h^)i^!\"",
      "encoded_base64": "XjE4Xi9eXiQxXiQlXiQtXiNlXilqXiZeXiFoXilpXiEi",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_132a82cb21b8",
      "text": "我是她的奴隸，她可絕不會樂意看到自己的奴隸擅自走丟。",
      "encoded_ascii": "^$%^,X^+h^&Z^##^)Z^*A^+h^\"A^-I^!)^$r^%8^#z^*Q^!u^'l^#I^&Z^##^)Z^2$^'l^.&^*q^!\"",
      "encoded_base64": "XiQlXixYXitoXiZaXiMjXilaXipBXitoXiJBXi1JXiEpXiRyXiU4XiN6XipRXiF1XidsXiNJXiZaXiMjXilaXjIkXidsXi4mXipxXiEi",
      "byte_length": 78
    },
    {
      "unit_id": "DLG_055071796167",
      "text": "沒錯，這正是實情——但我絕不能讓那個妖婦把卡圖拉獻給尼波尼的影王！ ",
      "encoded_ascii": "^%\\^)5^*A^(s^%H^,X^#3^,0^*n^*n^!I^$%^-I^!)^'b^-}^)!^!V^<9^=W^$1^\"0^\"b^$6^-(^'A^#>^%c^#>^&Z^#a^-)^*W ",
      "encoded_base64": "XiVcXik1XipBXihzXiVIXixYXiMzXiwwXipuXipuXiFJXiQlXi1JXiEpXidiXi19XikhXiFWXjw5Xj1XXiQxXiIwXiJiXiQ2Xi0oXidBXiM+XiVjXiM+XiZaXiNhXi0pXipXIA==",
      "byte_length": 100
    },
    {
      "unit_id": "DLG_1fc177a8be3b",
      "text": "他會用最邪惡可怖的手段吸乾那孩子的生命能量！ ",
      "encoded_ascii": "^!@^$r^&H^$q^)\"^#y^\"A^#p^&Z^$+^.l^\"J^*X^)!^+m^#(^&Z^&F^\"N^'b^)*^*W ",
      "encoded_base64": "XiFAXiRyXiZIXiRxXikiXiN5XiJBXiNwXiZaXiQrXi5sXiJKXipYXikhXittXiMoXiZaXiZGXiJOXidiXikqXipXIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_62a071da0fe8",
      "text": "將她的生機徹底榨乾抽盡！",
      "encoded_ascii": "^#7^+h^&Z^&F^%>^18^/^^8G^*X^*_^-1^*W",
      "encoded_base64": "XiM3XitoXiZaXiZGXiU+XjE4Xi9eXjhHXipYXipfXi0xXipX",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_089ecfc47e5a",
      "text": "我不懂那些深奧的事。那個聖堂武士曾說過什麼抽取那孩子未聚焦的潛能之類的鬼話， ",
      "encoded_ascii": "^$%^!)^,6^)!^!8^2*^6Q^&Z^*r^!\"^)!^!V^'Z^42^%J^+a^.j^-x^(x^!=^.T^*_^\":^)!^+m^#(^,_^'[^%~^&Z^7:^'b^!/^)w^&Z^*-^-v^*A ",
      "encoded_base64": "XiQlXiEpXiw2XikhXiE4XjIqXjZRXiZaXipyXiEiXikhXiFWXidaXjQyXiVKXithXi5qXi14Xih4XiE9Xi5UXipfXiI6XikhXittXiMoXixfXidbXiV+XiZaXjc6XidiXiEvXil3XiZaXiotXi12XipBIA==",
      "byte_length": 115
    },
    {
      "unit_id": "DLG_74f5d2e715f1",
      "text": "但那只不過是用漂亮話來掩飾他們打算殺害她的企圖罷了。 ",
      "encoded_ascii": "^!I^)!^\"?^!)^(x^,X^&H^,|^*t^-v^!O^9~^)|^!@^*{^$-^-C^%M^#/^+h^&Z^4-^\"b^1Q^*D^!\" ",
      "encoded_base64": "XiFJXikhXiI/XiEpXih4XixYXiZIXix8Xip0Xi12XiFPXjl+Xil8XiFAXip7XiQtXi1DXiVNXiMvXitoXiZaXjQtXiJiXjFRXipEXiEiIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_abd6427edfe6",
      "text": "只不過是謀財害命的委婉說法而已。",
      "encoded_ascii": "^\"?^!)^(x^,X^3~^0=^#/^\"N^&Z^5E^?T^-x^%b^'W^#J^!\"",
      "encoded_base64": "XiI/XiEpXih4XixYXjN+XjA9XiMvXiJOXiZaXjVFXj9UXi14XiViXidXXiNKXiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_df8fb780f81a",
      "text": "而且若是再來一次，我依然會義無反顧！在我的心目中，卡蒂比整個尼波尼所有的清水加起來還要珍貴。 ",
      "encoded_ascii": "^'W^!*^'x^,X^!l^!O^!%^%D^*A^$%^!Q^&\"^$r^2<^%}^\"9^4n^*W^\"d^$%^&Z^#k^&^^!,^*A^\"0^(%^,m^$T^!V^#>^%c^#>^$)^$s^&Z^,u^%V^\"\"^.(^!O^.7^(C^/7^2F^!\" ",
      "encoded_base64": "XidXXiEqXid4XixYXiFsXiFPXiElXiVEXipBXiQlXiFRXiYiXiRyXjI8XiV9XiI5XjRuXipXXiJkXiQlXiZaXiNrXiZeXiEsXipBXiIwXiglXixtXiRUXiFWXiM+XiVjXiM+XiQpXiRzXiZaXix1XiVWXiIiXi4oXiFPXi43XihDXi83XjJGXiEiIA==",
      "byte_length": 139
    },
    {
      "unit_id": "DLG_73c9b9baaddc",
      "text": "比整座城邦的甘泉都要珍貴。",
      "encoded_ascii": "^,m^$T^/_^+_^1a^&Z^/:^%a^)$^(C^/7^2F^!\"",
      "encoded_base64": "XixtXiRUXi9fXitfXjFhXiZaXi86XiVhXikkXihDXi83XjJGXiEi",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_9bcd681569a2",
      "text": "沒人知道。那位聖堂武士在失蹤將近一年之後，將卡蒂交由我保護照料。根本無從知曉她是從何處而來的。 ",
      "encoded_ascii": "^%\\^!<^&h^(y^!\"^)!^!J^'Z^42^%J^+a^\"d^\"|^(b^#7^(l^!%^+~^!/^#b^*A^#7^\"0^(%^0P^&I^$%^!T^(T^/x^/n^!\"^%)^$x^%}^#f^&h^7y^+h^,X^#f^!L^(,^'W^!O^&Z^!\" ",
      "encoded_base64": "XiVcXiE8XiZoXih5XiEiXikhXiFKXidaXjQyXiVKXithXiJkXiJ8XihiXiM3XihsXiElXit+XiEvXiNiXipBXiM3XiIwXiglXjBQXiZJXiQlXiFUXihUXi94Xi9uXiEiXiUpXiR4XiV9XiNmXiZoXjd5XitoXixYXiNmXiFMXigsXidXXiFPXiZaXiEiIA==",
      "byte_length": 142
    },
    {
      "unit_id": "DLG_44fca9f811cb",
      "text": "根本無人知曉她是從哪裡被帶來的。 ",
      "encoded_ascii": "^%)^$x^%}^!<^&h^7y^+h^,X^#f^+I^-j^(@^#N^!O^&Z^!\" ",
      "encoded_base64": "XiUpXiR4XiV9XiE8XiZoXjd5XitoXixYXiNmXitJXi1qXihAXiNOXiFPXiZaXiEiIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_870a8672ff3a",
      "text": "無人知曉她的身世。",
      "encoded_ascii": "^%}^!<^&h^7y^+h^&Z^(c^*p^!\"",
      "encoded_base64": "XiV9XiE8XiZoXjd5XitoXiZaXihjXipwXiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_831b63347fc6",
      "text": "對她而言，失蹤一陣子並非罕事。影王對她另有特殊用途，那種差使可絕不容許我在旁礙手礙腳。 ",
      "encoded_ascii": "^#:^+h^'W^1Y^*A^\"|^(b^!%^)P^#(^!+^)i^5w^*r^!\"^#a^-)^#:^+h^\">^$s^&5^9!^&H^3.^*A^)!^'$^48^!N^\"A^-I^!)^+t^-s^$%^\"d^.h^:M^$+^:M^00^!\" ",
      "encoded_base64": "XiM6XitoXidXXjFZXipBXiJ8XihiXiElXilQXiMoXiErXilpXjV3XipyXiEiXiNhXi0pXiM6XitoXiI+XiRzXiY1XjkhXiZIXjMuXipBXikhXickXjQ4XiFOXiJBXi1JXiEpXit0Xi1zXiQlXiJkXi5oXjpNXiQrXjpNXjAwXiEiIA==",
      "byte_length": 130
    },
    {
      "unit_id": "DLG_261bb2b0d8c1",
      "text": "絕不允許我在一旁窺視。 ",
      "encoded_ascii": "^-I^!)^/\"^-s^$%^\"d^!%^.h^6f^(E^!\" ",
      "encoded_base64": "Xi1JXiEpXi8iXi1zXiQlXiJkXiElXi5oXjZmXihFXiEiIA==",
      "byte_length": 34
    },
    {
      "unit_id": "DLG_dd365dc35223",
      "text": "我根本不得靠近半步。",
      "encoded_ascii": "^$%^%)^$x^!)^#e^.C^(l^\"-^,i^!\"",
      "encoded_base64": "XiQlXiUpXiR4XiEpXiNlXi5DXihsXiItXixpXiEi",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_626925c9fc5a",
      "text": "我什麼都沒告訴卡蒂。她的腦袋瓜裡早就塞滿了各種幻想，以及關於魔法的荒唐胡話。 ",
      "encoded_ascii": "^$%^!=^.T^)$^%\\^+B^-t^\"0^(%^!\"^+h^&Z^2@^(?^<X^-j^,V^*J^/(^,{^*D^+>^'$^#S^,1^*A^!B^\"7^.>^$^^*0^%b^&Z^1W^55^3}^-v^!\" ",
      "encoded_base64": "XiQlXiE9Xi5UXikkXiVcXitCXi10XiIwXiglXiEiXitoXiZaXjJAXig/XjxYXi1qXixWXipKXi8oXix7XipEXis+XickXiNTXiwxXipBXiFCXiI3Xi4+XiReXiowXiViXiZaXjFXXjU1XjN9Xi12XiEiIA==",
      "byte_length": 115
    },
    {
      "unit_id": "DLG_64489176b523",
      "text": "整天都在胡思亂想。",
      "encoded_ascii": "^$T^+e^)$^\"d^3}^#q^!3^,1^!\"",
      "encoded_base64": "XiRUXitlXikkXiJkXjN9XiNxXiEzXiwxXiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_7dbb85576ad6",
      "text": " 打破了查爾不願談及自身的顧忌。",
      "encoded_ascii": " ^$-^&n^*D^%&^&/^!)^.H^0;^\"7^'l^(c^&Z^4n^;P^!\"",
      "encoded_base64": "IF4kLV4mbl4qRF4lJl4mL14hKV4uSF4wO14iN14nbF4oY14mWl40bl47UF4hIg==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_bec88b90e31d",
      "text": "我現在很忙。也許晚點我才抽得出時間搭理你們。",
      "encoded_ascii": "^$%^&?^\"d^*K^,+^!\"^!1^-s^,Y^*;^$%^$,^*_^#e^!q^$f^)G^8\\^&A^*F^*{^!\"",
      "encoded_base64": "XiQlXiY/XiJkXipLXiwrXiEiXiExXi1zXixZXio7XiQlXiQsXipfXiNlXiFxXiRmXilHXjhcXiZBXipGXip7XiEi",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_635c9a93b50c",
      "text": "。我有什麼能為你們效勞的？",
      "encoded_ascii": "^!\"^$%^$s^!=^.T^'b^%{^*F^*{^$Q^/R^&Z^.V",
      "encoded_base64": "XiEiXiQlXiRzXiE9Xi5UXidiXiV7XipGXip7XiRRXi9SXiZaXi5W",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_ab59ce13eb55",
      "text": "我必須為自己先前懷疑你們的能耐而向你們致歉。 ",
      "encoded_ascii": "^$%^#l^)r^%{^'l^#I^!b^!z^,9^0p^*F^*{^&Z^'b^-S^'W^+?^*F^*{^'o^,h^!\" ",
      "encoded_base64": "XiQlXiNsXilyXiV7XidsXiNJXiFiXiF6Xiw5XjBwXipGXip7XiZaXidiXi1TXidXXis/XipGXip7XidvXixoXiEiIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_bb9acf6002b9",
      "text": "你們做到了我曾認為不可能做到的事，並證明了 ",
      "encoded_ascii": "^*F^*{^*~^!u^*D^$%^.j^(O^%{^!)^\"A^'b^*~^!u^&Z^*r^*A^!+^-{^$c^*D ",
      "encoded_base64": "XipGXip7Xip+XiF1XipEXiQlXi5qXihPXiV7XiEpXiJBXidiXip+XiF1XiZaXipyXipBXiErXi17XiRjXipEIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_e752bcd9ea2d",
      "text": "自己是當之無愧、值得萬分讚頌的偉大英雄。我確信你們一定會 ",
      "encoded_ascii": "^'l^#I^,X^&N^!/^%}^,3^!!^!Z^#e^-_^!s^8'^7\"^&Z^*}^\"z^'y^)\\^!\"^$%^-6^!U^*F^*{^!%^#.^$r ",
      "encoded_base64": "XidsXiNJXixYXiZOXiEvXiV9XiwzXiEhXiFaXiNlXi1fXiFzXjgnXjciXiZaXip9XiJ6Xid5XilcXiEiXiQlXi02XiFVXipGXip7XiElXiMuXiRyIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_99fe1243a885",
      "text": "成為無與倫比的領袖。",
      "encoded_ascii": "^$$^%{^%}^'p^/!^,m^&Z^)s^7G^!\"",
      "encoded_base64": "XiQkXiV7XiV9XidwXi8hXixtXiZaXilzXjdHXiEi",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_109422cc2ea0",
      "text": "踏上更多非凡卓絕的冒險征程。",
      "encoded_ascii": "^.,^!'^$o^\"x^)i^+-^/#^-I^&Z^/P^*m^.c^'#^!\"",
      "encoded_base64": "Xi4sXiEnXiRvXiJ4XilpXistXi8jXi1JXiZaXi9QXiptXi5jXicjXiEi",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_37af3c9acf0b",
      "text": "有什麼事嗎， ",
      "encoded_ascii": "^$s^!=^.T^*r^+X^*A ",
      "encoded_base64": "XiRzXiE9Xi5UXipyXitYXipBIA==",
      "byte_length": 19
    },
    {
      "unit_id": "DLG_672f2b00d264",
      "text": "？我只能抽出幾分鐘時間，之後就得回去幹活了。",
      "encoded_ascii": "^.V^$%^\"?^'b^*_^!q^#T^!s^9y^$f^)G^*A^!/^#b^*J^#e^\"\\^\"6^,!^%i^*D^!\"",
      "encoded_base64": "Xi5WXiQlXiI/XidiXipfXiFxXiNUXiFzXjl5XiRmXilHXipBXiEvXiNiXipKXiNlXiJcXiI2XiwhXiVpXipEXiEi",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_a3934c00edc0",
      "text": "  究竟是什麼工作這麼要緊？",
      "encoded_ascii": "  ^-<^28^,X^!=^.T^+y^!M^(s^.T^(C^0r^.V",
      "encoded_base64": "ICBeLTxeMjheLFheIT1eLlReK3leIU1eKHNeLlReKENeMHJeLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_2efb5b8b6240",
      "text": "  我想向你打聽關於這場戰爭的事。",
      "encoded_ascii": "  ^$%^,1^+?^*F^$-^-X^.>^$^^(s^\"n^$(^1I^&Z^*r^!\"",
      "encoded_base64": "ICBeJCVeLDFeKz9eKkZeJC1eLVheLj5eJF5eKHNeIm5eJCheMUleJlpeKnJeISI=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_0aa5976267e8",
      "text": "  跟我談談你自己的事吧，奎林。",
      "encoded_ascii": "  ^.+^$%^0;^0;^*F^'l^#I^&Z^*r^*I^*A^5B^/1^!\"",
      "encoded_base64": "ICBeLiteJCVeMDteMDteKkZeJ2xeI0leJlpeKnJeKkleKkFeNUJeLzFeISI=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_8080733870e2",
      "text": "  提奎茲爾在這場戰鬥中戰況如何？",
      "encoded_ascii": "  ^$A^5B^/D^&/^\"d^(s^\"n^$(^*,^!,^$(^,q^#$^!L^.V",
      "encoded_base64": "ICBeJEFeNUJeL0ReJi9eImReKHNeIm5eJCheKixeISxeJCheLHFeIyReIUxeLlY=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_574014f78486",
      "text": "  我們的盟友情況如何了？",
      "encoded_ascii": "  ^$%^*{^&Z^-0^\"8^,0^,q^#$^!L^*D^.V",
      "encoded_base64": "ICBeJCVeKnteJlpeLTBeIjheLDBeLHFeIyReIUxeKkReLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_5334fa2e0bed",
      "text": "  你現在有什麼打算？",
      "encoded_ascii": "  ^*F^&?^\"d^$s^!=^.T^$-^-C^.V",
      "encoded_base64": "ICBeKkZeJj9eImReJHNeIT1eLlReJC1eLUNeLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_ac59e9ec6c51",
      "text": "  難道你不該先向我請示嗎？",
      "encoded_ascii": "  ^)a^(y^*F^!)^(M^!b^+?^$%^*S^&s^+X^.V",
      "encoded_base64": "ICBeKWFeKHleKkZeISleKE1eIWJeKz9eJCVeKlNeJnNeK1heLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_dd500f9aa047",
      "text": "我們失去了許多優秀的戰士，但多虧了你們，我們的城牆 ",
      "encoded_ascii": "^$%^*{^\"|^\"6^*D^-s^\"x^+)^-9^&Z^$(^+a^*A^!I^\"x^9N^*D^*F^*{^*A^$%^*{^&Z^+_^&0 ",
      "encoded_base64": "XiQlXip7XiJ8XiI2XipEXi1zXiJ4XispXi05XiZaXiQoXithXipBXiFJXiJ4XjlOXipEXipGXip7XipBXiQlXip7XiZaXitfXiYwIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_b6c03c436df7",
      "text": "從未被敵軍攻破。 ",
      "encoded_ascii": "^#f^,_^(@^$U^..^$O^&n^!\" ",
      "encoded_base64": "XiNmXixfXihAXiRVXi4uXiRPXiZuXiEiIA==",
      "byte_length": 25
    },
    {
      "unit_id": "DLG_6f7659db7f23",
      "text": "那支暗影大軍也幫了大忙。 ",
      "encoded_ascii": "^)!^$L^$k^#a^\"z^..^!1^+}^*D^\"z^,+^!\" ",
      "encoded_base64": "XikhXiRMXiRrXiNhXiJ6Xi4uXiExXit9XipEXiJ6XiwrXiEiIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_146043b88bed",
      "text": "我們用不了多久就能休養生息、恢復元氣。",
      "encoded_ascii": "^$%^*{^&H^!)^*D^\"x^!.^*J^'b^!G^.I^&F^#w^!!^#u^#g^!a^%U^!\"",
      "encoded_base64": "XiQlXip7XiZIXiEpXipEXiJ4XiEuXipKXidiXiFHXi5JXiZGXiN3XiEhXiN1XiNnXiFhXiVVXiEi",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_81ef0c82bb12",
      "text": "他們英勇奮戰，數度重整陣形以阻擊 ",
      "encoded_ascii": "^!@^*{^'y^\"$^+g^$(^*A^$V^#V^))^$T^)P^#_^!B^)L^$F ",
      "encoded_base64": "XiFAXip7Xid5XiIkXitnXiQoXipBXiRWXiNWXikpXiRUXilQXiNfXiFCXilMXiRGIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_f79d01bea8f5",
      "text": "德拉吉大軍的攻勢。在你們殺向德拉吉指揮官之前，他們的方陣就已被沖散了， ",
      "encoded_ascii": "^#j^$6^\"D^\"z^..^&Z^$O^\"&^!\"^\"d^*F^*{^%M^+?^#j^$6^\"D^$8^2\"^#-^!/^!z^*A^!@^*{^&Z^$]^)P^*J^#J^(@^,p^$S^*D^*A ",
      "encoded_base64": "XiNqXiQ2XiJEXiJ6Xi4uXiZaXiRPXiImXiEiXiJkXipGXip7XiVNXis/XiNqXiQ2XiJEXiQ4XjIiXiMtXiEvXiF6XipBXiFAXip7XiZaXiRdXilQXipKXiNKXihAXixwXiRTXipEXipBIA==",
      "byte_length": 106
    },
    {
      "unit_id": "DLG_1f107206d233",
      "text": "但我知道許多人倖存了下來。",
      "encoded_ascii": "^!I^$%^&h^(y^-s^\"x^!<^5+^#*^*D^!(^!O^!\"",
      "encoded_base64": "XiFJXiQlXiZoXih5Xi1zXiJ4XiE8XjUrXiMqXipEXiEoXiFPXiEi",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_d7dc50e5a25d",
      "text": "隨著各個奴隸村莊擺脫了德拉吉的殘暴壓迫， ",
      "encoded_ascii": "^)X^-a^+>^!V^##^)Z^$z^6l^1@^'c^*D^#j^$6^\"D^&Z^,l^$m^4v^1`^*A ",
      "encoded_base64": "XilYXi1hXis+XiFWXiMjXilaXiR6XjZsXjFAXidjXipEXiNqXiQ2XiJEXiZaXixsXiRtXjR2XjFgXipBIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_59dba957499a",
      "text": "貿易的商機比以往任何時候都要廣闊。提奎茲爾 ",
      "encoded_ascii": "^6/^,W^&Z^1'^%>^,m^!B^,)^!C^!L^$f^*|^)$^(C^9V^)I^!\"^$A^5B^/D^&/ ",
      "encoded_base64": "XjYvXixXXiZaXjEnXiU+XixtXiFCXiwpXiFDXiFMXiRmXip8XikkXihDXjlWXilJXiEiXiRBXjVCXi9EXiYvIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_d0216cd119ba",
      "text": "將會成為這片商貿樞紐的核心支柱。",
      "encoded_ascii": "^#7^$r^$$^%{^(s^&1^1'^6/^8_^?E^&Z^:\"^#k^$L^?d^!\"",
      "encoded_base64": "XiM3XiRyXiQkXiV7XihzXiYxXjEnXjYvXjhfXj9FXiZaXjoiXiNrXiRMXj9kXiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_2b52cf4db01b",
      "text": "那是自然。我原本打算一敲定各項細節就立刻向您稟報的。 ",
      "encoded_ascii": "^)!^,X^'l^&\"^!\"^$%^\"5^$x^$-^-C^!%^1A^#.^+>^)q^'?^9b^*J^0'^.Y^+?^4:^?h^+`^&Z^!\" ",
      "encoded_base64": "XikhXixYXidsXiYiXiEiXiQlXiI1XiR4XiQtXi1DXiElXjFBXiMuXis+XilxXic/XjliXipKXjAnXi5ZXis/XjQ6Xj9oXitgXiZaXiEiIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_0ce7d229688b",
      "text": "沒有您的首肯，我絕不會擅作主張。",
      "encoded_ascii": "^%\\^$s^4:^&Z^)~^-Z^*A^$%^-I^!)^$r^2$^!M^!-^,(^!\"",
      "encoded_base64": "XiVcXiRzXjQ6XiZaXil+Xi1aXipBXiQlXi1JXiEpXiRyXjIkXiFNXiEtXiwoXiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_4f768f4e015f",
      "text": "我的私事與你無關。",
      "encoded_ascii": "^$%^&Z^&~^*r^'p^*F^%}^.>^!\"",
      "encoded_base64": "XiQlXiZaXiZ+XipyXidwXipGXiV9Xi4+XiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_f8bdc876010d",
      "text": "  我只是好奇問問罷了。",
      "encoded_ascii": "  ^$%^\"?^,X^+i^\"}^*Z^*Z^1Q^*D^!\"",
      "encoded_base64": "ICBeJCVeIj9eLFheK2leIn1eKlpeKlpeMVFeKkReISI=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_a46ca9815003",
      "text": "  我會讓它變成跟我切身相關的事！",
      "encoded_ascii": "  ^$%^$r^-}^+o^(U^$$^.+^$%^+.^(c^&a^.>^&Z^*r^*W",
      "encoded_base64": "ICBeJCVeJHJeLX1eK29eKFVeJCReLiteJCVeKy5eKGNeJmFeLj5eJlpeKnJeKlc=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_e1f45c7df193",
      "text": "  你為何總是如此好鬥且充滿敵意？",
      "encoded_ascii": "  ^*F^%{^!L^-M^,X^#$^%I^+i^*,^!*^5.^,{^$U^#z^.V",
      "encoded_base64": "ICBeKkZeJXteIUxeLU1eLFheIyReJUleK2leKixeISpeNS5eLHteJFVeI3peLlY=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_f40b561cea61",
      "text": "  你心裡有鬼，有事情瞞著大家，對吧？",
      "encoded_ascii": "  ^*F^#k^-j^$s^*-^*A^$s^*r^,0^?Z^-a^\"z^+s^*A^#:^*I^.V",
      "encoded_base64": "ICBeKkZeI2teLWpeJHNeKi1eKkFeJHNeKnJeLDBeP1peLWFeInpeK3NeKkFeIzpeKkleLlY=",
      "byte_length": 53
    },
    {
      "unit_id": "DLG_24f90d1f56e7",
      "text": "提奎茲爾若想繁榮昌盛，就必須開闢出一片集市以 ",
      "encoded_ascii": "^$A^5B^/D^&/^'x^,1^-N^,e^2%^1L^*A^*J^#l^)r^)F^?m^!q^!%^&1^)]^+z^!B ",
      "encoded_base64": "XiRBXjVCXi9EXiYvXid4XiwxXi1OXixlXjIlXjFMXipBXipKXiNsXilyXilGXj9tXiFxXiElXiYxXildXit6XiFCIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_921bcebefa6a",
      "text": "招攬各路商隊。我們必須開墾農田、打造貨物，好讓 ",
      "encoded_ascii": "^,D^?c^+>^(a^1'^)U^!\"^$%^*{^#l^)r^)F^?`^4i^;\\^!!^$-^(v^.w^&4^*A^+i^-} ",
      "encoded_base64": "XixEXj9jXis+XihhXjEnXilVXiEiXiQlXip7XiNsXilyXilGXj9gXjRpXjtcXiEhXiQtXih2Xi53XiY0XipBXitpXi19IA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_44e570f5c2d6",
      "text": "我們擁有可供貿易的盈餘。這種富足可不會憑空發生。",
      "encoded_ascii": "^$%^*{^,M^$s^\"A^!P^6/^,W^&Z^=-^1e^!\"^(s^'$^3C^(^^\"A^!)^$r^,5^'(^&W^&F^!\"",
      "encoded_base64": "XiQlXip7XixNXiRzXiJBXiFQXjYvXixXXiZaXj0tXjFlXiEiXihzXickXjNDXiheXiJBXiEpXiRyXiw1XicoXiZXXiZGXiEi",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_8bc3427af8ac",
      "text": "  你口氣大得就像提奎茲爾的領袖一樣。",
      "encoded_ascii": "  ^*F^\"<^%U^\"z^#e^*J^!`^$A^5B^/D^&/^&Z^)s^7G^!%^,f^!\"",
      "encoded_base64": "ICBeKkZeIjxeJVVeInpeI2VeKkpeIWBeJEFeNUJeL0ReJi9eJlpeKXNeN0deISVeLGZeISI=",
      "byte_length": 53
    },
    {
      "unit_id": "DLG_ff79b46c404b",
      "text": "  你打算做哪種買賣？",
      "encoded_ascii": "  ^*F^$-^-C^*~^+I^'$^.!^.$^.V",
      "encoded_base64": "ICBeKkZeJC1eLUNeKn5eK0leJyReLiFeLiReLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_6157f3ffcd05",
      "text": "  商隊為什麼會願意跟你做買賣？",
      "encoded_ascii": "  ^1'^)U^%{^!=^.T^$r^.H^#z^.+^*F^*~^.!^.$^.V",
      "encoded_base64": "ICBeMSdeKVVeJXteIT1eLlReJHJeLkheI3peLiteKkZeKn5eLiFeLiReLlY=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_58c1bde7eb16",
      "text": "  難道提奎茲爾現在還不夠富足嗎？",
      "encoded_ascii": "  ^)a^(y^$A^5B^/D^&/^&?^\"d^.7^!)^+d^3C^(^^+X^.V",
      "encoded_base64": "ICBeKWFeKHleJEFeNUJeL0ReJi9eJj9eImReLjdeISleK2ReM0NeKF5eK1heLlY=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_49791b9861b0",
      "text": "什麼戰爭？我唯一聽說過的大戰，就只存在於那個 ",
      "encoded_ascii": "^!=^.T^$(^1I^.V^$%^+O^!%^-X^-x^(x^&Z^\"z^$(^*A^*J^\"?^#*^\"d^$^^)!^!V ",
      "encoded_base64": "XiE9Xi5UXiQoXjFJXi5WXiQlXitPXiElXi1YXi14Xih4XiZaXiJ6XiQoXipBXipKXiI/XiMqXiJkXiReXikhXiFWIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_0110dbd304e2",
      "text": "預言者的腦袋瓜裡！",
      "encoded_ascii": "^.E^1Y^'V^&Z^2@^(?^<X^-j^*W",
      "encoded_base64": "Xi5FXjFZXidWXiZaXjJAXig/XjxYXi1qXipX",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_4481b1808400",
      "text": "這場戰爭只會是一場單方面的屠殺！我們本該像我當初建議的那樣 ",
      "encoded_ascii": "^(s^\"n^$(^1I^\"?^$r^,X^!%^\"n^2a^$]^)j^&Z^#A^%M^*W^$%^*{^$x^(M^!`^$%^&N^1\"^,'^-|^&Z^)!^,f ",
      "encoded_base64": "XihzXiJuXiQoXjFJXiI/XiRyXixYXiElXiJuXjJhXiRdXilqXiZaXiNBXiVNXipXXiQlXip7XiR4XihNXiFgXiQlXiZOXjEiXiwnXi18XiZaXikhXixmIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_2e5835a63396",
      "text": "老老實實躲藏起來。現在倒好，為時已晚了。德拉吉大軍已鐵了心 ",
      "encoded_ascii": "^'U^'U^#3^#3^0C^-f^.(^!O^!\"^&?^\"d^!X^+i^*A^%{^$f^#J^,Y^*D^!\"^#j^$6^\"D^\"z^..^#J^)?^*D^#k ",
      "encoded_base64": "XidVXidVXiMzXiMzXjBDXi1mXi4oXiFPXiEiXiY/XiJkXiFYXitpXipBXiV7XiRmXiNKXixZXipEXiEiXiNqXiQ2XiJEXiJ6Xi4uXiNKXik/XipEXiNrIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_d34aa6b3e492",
      "text": "要徹底剷除大漠中任何一絲反抗的苗頭。",
      "encoded_ascii": "^(C^18^/^^2Y^)Q^\"z^,}^!,^!C^!L^!%^'C^\"9^$4^&Z^?k^)t^!\"",
      "encoded_base64": "XihDXjE4Xi9eXjJZXilRXiJ6Xix9XiEsXiFDXiFMXiElXidDXiI5XiQ0XiZaXj9rXil0XiEi",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_5d8b040cc14d",
      "text": "  那你建議我們該怎麼辦？",
      "encoded_ascii": "  ^)!^*F^,'^-|^$%^*{^(M^,,^.T^2L^.V",
      "encoded_base64": "ICBeKSFeKkZeLCdeLXxeJCVeKnteKE1eLCxeLlReMkxeLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_6aac181063a2",
      "text": "  我一定會找到擊潰德拉吉的辦法！",
      "encoded_ascii": "  ^$%^!%^#.^$r^$/^!u^$F^2-^#j^$6^\"D^&Z^2L^%b^*W",
      "encoded_base64": "ICBeJCVeISVeIy5eJHJeJC9eIXVeJEZeMi1eI2peJDZeIkReJlpeMkxeJWJeKlc=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_976ced39014d",
      "text": "  我爭取結盟的那些同盟會提供援手。",
      "encoded_ascii": "  ^$%^1I^\":^'@^-0^&Z^)!^!8^\"E^-0^$r^$A^!P^$C^$+^!\"",
      "encoded_base64": "ICBeJCVeMUleIjpeJ0BeLTBeJlpeKSFeITheIkVeLTBeJHJeJEFeIVBeJENeJCteISI=",
      "byte_length": 50
    },
    {
      "unit_id": "DLG_1dbd8b5a3002",
      "text": "  關於德拉吉的大軍，你瞭解多少？",
      "encoded_ascii": "  ^.>^$^^#j^$6^\"D^&Z^\"z^..^*A^*F^<p^(I^\"x^#<^.V",
      "encoded_base64": "ICBeLj5eJF5eI2peJDZeIkReJlpeInpeLi5eKkFeKkZePHBeKEleInheIzxeLlY=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_7a088b3ee747",
      "text": "我只知道他瘋了，這就足夠了。你只要去聽聽他那些瘋言瘋語就明白了。 ",
      "encoded_ascii": "^$%^\"?^&h^(y^!@^-/^*D^*A^(s^*J^(^^+d^*D^!\"^*F^\"?^(C^\"6^-X^-X^!@^)!^!8^-/^1Y^-/^0:^*J^$c^&X^*D^!\" ",
      "encoded_base64": "XiQlXiI/XiZoXih5XiFAXi0vXipEXipBXihzXipKXiheXitkXipEXiEiXipGXiI/XihDXiI2Xi1YXi1YXiFAXikhXiE4Xi0vXjFZXi0vXjA6XipKXiRjXiZYXipEXiEiIA==",
      "byte_length": 97
    },
    {
      "unit_id": "DLG_c0dd505fc791",
      "text": "他整天把村民們煽動得人心惶惶，而村民本該把心思放在自己的活計上才是。 ",
      "encoded_ascii": "^!@^$T^+e^$1^$z^%T^*{^7a^\"%^#e^!<^#k^?b^?b^*A^'W^$z^%T^$x^(M^$1^#k^#q^$P^\"d^'l^#I^&Z^%i^-n^!'^$,^,X^!\" ",
      "encoded_base64": "XiFAXiRUXitlXiQxXiR6XiVUXip7XjdhXiIlXiNlXiE8XiNrXj9iXj9iXipBXidXXiR6XiVUXiR4XihNXiQxXiNrXiNxXiRQXiJkXidsXiNJXiZaXiVpXi1uXiEnXiQsXixYXiEiIA==",
      "byte_length": 103
    },
    {
      "unit_id": "DLG_c4e8170cf34f",
      "text": "才更有好處。",
      "encoded_ascii": "^$,^$o^$s^+i^(,^!\"",
      "encoded_base64": "XiQsXiRvXiRzXitpXigsXiEi",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_f58406b6ba9e",
      "text": "我現在必須回去幹活了。",
      "encoded_ascii": "^$%^&?^\"d^#l^)r^\"\\^\"6^,!^%i^*D^!\"",
      "encoded_base64": "XiQlXiY/XiJkXiNsXilyXiJcXiI2XiwhXiVpXipEXiEi",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_d947e9556168",
      "text": "多管閒事只會讓你丟掉小命。",
      "encoded_ascii": "^\"x^-D^6A^*r^\"?^$r^-}^*F^*q^/e^#;^\"N^!\"",
      "encoded_base64": "XiJ4Xi1EXjZBXipyXiI/XiRyXi19XipGXipxXi9lXiM7XiJOXiEi",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_74691803efc4",
      "text": "你儘管威脅我好了，但只要你敢拔出兵刃，村民們就會在瞬間將你剁成肉泥， ",
      "encoded_ascii": "^*F^+(^-D^#&^1T^$%^+i^*D^*A^!I^\"?^(C^*F^/m^/c^!q^+,^!r^*A^$z^%T^*{^*J^$r^\"d^1N^)G^#7^*F^=G^$$^'^^%d^*A ",
      "encoded_base64": "XipGXisoXi1EXiMmXjFUXiQlXitpXipEXipBXiFJXiI/XihDXipGXi9tXi9jXiFxXissXiFyXipBXiR6XiVUXip7XipKXiRyXiJkXjFOXilHXiM3XipGXj1HXiQkXideXiVkXipBIA==",
      "byte_length": 103
    },
    {
      "unit_id": "DLG_2f58800a4e73",
      "text": "任何預言都保不了你的命。",
      "encoded_ascii": "^!C^!L^.E^1Y^)$^!T^!)^*D^*F^&Z^\"N^!\"",
      "encoded_base64": "XiFDXiFMXi5FXjFZXikkXiFUXiEpXipEXipGXiZaXiJOXiEi",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_610ca03ea131",
      "text": "我不喜歡你們。你們這幫從大漠深處爬過來的傢伙，憑什麼指望所有人 ",
      "encoded_ascii": "^$%^!)^+V^%F^*F^*{^!\"^*F^*{^(s^+}^#f^\"z^,}^2*^(,^/y^(x^!O^&Z^+#^*y^*A^,5^!=^.T^$8^,]^$)^$s^!< ",
      "encoded_base64": "XiQlXiEpXitWXiVGXipGXip7XiEiXipGXip7XihzXit9XiNmXiJ6Xix9XjIqXigsXi95Xih4XiFPXiZaXisjXip5XipBXiw1XiE9Xi5UXiQ4XixdXiQpXiRzXiE8IA==",
      "byte_length": 94
    },
    {
      "unit_id": "DLG_903afbe1badc",
      "text": "都對你們唯命是從",
      "encoded_ascii": "^)$^#:^*F^*{^+O^\"N^,X^#f",
      "encoded_base64": "XikkXiM6XipGXip7XitPXiJOXixYXiNm",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_d4619be7d39b",
      "text": "隨你怎麼想好了。我絕不可能信任你",
      "encoded_ascii": "^)X^*F^,,^.T^,1^+i^*D^!\"^$%^-I^!)^\"A^'b^!U^!C^*F",
      "encoded_base64": "XilYXipGXiwsXi5UXiwxXitpXipEXiEiXiQlXi1JXiEpXiJBXidiXiFVXiFDXipG",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_d9c3fe753149",
      "text": "既然你們已經挑起了這場戰火，眼下除了盡可能拉攏更多盟友之外， ",
      "encoded_ascii": "^,U^&\"^*F^*{^#J^'D^,H^.(^*D^(s^\"n^$(^%x^*A^&d^!(^)Q^*D^-1^\"A^'b^$6^=V^$o^\"x^-0^\"8^!/^\"w^*A ",
      "encoded_base64": "XixVXiYiXipGXip7XiNKXidEXixIXi4oXipEXihzXiJuXiQoXiV4XipBXiZkXiEoXilRXipEXi0xXiJBXidiXiQ2Xj1WXiRvXiJ4Xi0wXiI4XiEvXiJ3XipBIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_dabb48ef4f7d",
      "text": "也別無他法了。 ",
      "encoded_ascii": "^!1^*H^%}^!@^%b^*D^!\" ",
      "encoded_base64": "XiExXipIXiV9XiFAXiViXipEXiEiIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_5d2356c0a11a",
      "text": "此地西南方有一群螳螂人。牠們將會是極其強大的盟友。 ",
      "encoded_ascii": "^%I^\"e^-l^\"/^$]^$s^!%^'R^8O^8N^!<^!\"^-#^*{^#7^$r^,X^1D^!j^#]^\"z^&Z^-0^\"8^!\" ",
      "encoded_base64": "XiVJXiJlXi1sXiIvXiRdXiRzXiElXidSXjhPXjhOXiE8XiEiXi0jXip7XiM3XiRyXixYXjFEXiFqXiNdXiJ6XiZaXi0wXiI4XiEiIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_3d31431e64d7",
      "text": "極具威懾力的強援。",
      "encoded_ascii": "^1D^!k^#&^:Y^!~^&Z^#]^$C^!\"",
      "encoded_base64": "XjFEXiFrXiMmXjpZXiF+XiZaXiNdXiRDXiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_f4520e21dad9",
      "text": "遙遠的東方住著一位強大的法師。如果你們能拉攏他成為盟友， ",
      "encoded_ascii": "^4j^({^&Z^,`^$]^*z^-a^!%^!J^#]^\"z^&Z^%b^#M^!\"^#$^%!^*F^*{^'b^$6^=V^!@^$$^%{^-0^\"8^*A ",
      "encoded_base64": "XjRqXih7XiZaXixgXiRdXip6Xi1hXiElXiFKXiNdXiJ6XiZaXiViXiNNXiEiXiMkXiUhXipGXip7XidiXiQ2Xj1WXiFAXiQkXiV7Xi0wXiI4XipBIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_9da08fbc8c39",
      "text": "定能大大增加我們的勝算。",
      "encoded_ascii": "^#.^'b^\"z^\"z^\"s^\"\"^$%^*{^&Z^+5^-C^!\"",
      "encoded_base64": "XiMuXidiXiJ6XiJ6XiJzXiIiXiQlXip7XiZaXis1Xi1DXiEi",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_5f99ad0fec08",
      "text": "我聽說西南方的熔岩原中住著一位能役使元素生物的隱士。 ",
      "encoded_ascii": "^$%^-X^-x^-l^\"/^$]^&Z^&#^#D^\"5^!,^*z^-a^!%^!J^'b^17^!N^!a^'=^&F^&4^&Z^)Y^+a^!\" ",
      "encoded_base64": "XiQlXi1YXi14Xi1sXiIvXiRdXiZaXiYjXiNEXiI1XiEsXip6Xi1hXiElXiFKXidiXjE3XiFOXiFhXic9XiZGXiY0XiZaXilZXithXiEiIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_66180ab8a41a",
      "text": "你們應該去尋求他的援助。",
      "encoded_ascii": "^*F^*{^0`^(M^\"6^#9^,n^!@^&Z^$C^\"#^!\"",
      "encoded_base64": "XipGXip7XjBgXihNXiI2XiM5XixuXiFAXiZaXiRDXiIjXiEi",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_30c71c800492",
      "text": "德拉吉嗜戰成性。這正是為何你們頑抗到底的算盤注定要失敗的原因。 ",
      "encoded_ascii": "^#j^$6^\"D^>3^$(^$$^#r^!\"^(s^%H^,X^%{^!L^*F^*{^4%^$4^!u^/^^&Z^-C^1M^%e^#.^(C^\"|^$R^&Z^\"5^\"]^!\" ",
      "encoded_base64": "XiNqXiQ2XiJEXj4zXiQoXiQkXiNyXiEiXihzXiVIXixYXiV7XiFMXipGXip7XjQlXiQ0XiF1Xi9eXiZaXi1DXjFNXiVlXiMuXihDXiJ8XiRSXiZaXiI1XiJdXiEiIA==",
      "byte_length": 94
    },
    {
      "unit_id": "DLG_97dc9f76a84f",
      "text": "你們越是反抗，德拉吉就越能在擊潰你們與各個村莊的戰鬥中追求所謂的征服榮耀。 ",
      "encoded_ascii": "^*F^*{^(]^,X^\"9^$4^*A^#j^$6^\"D^*J^(]^'b^\"d^$F^2-^*F^*{^'p^+>^!V^$z^6l^&Z^$(^*,^!,^(o^,n^$)^0s^&Z^.c^,\\^,e^7D^!\" ",
      "encoded_base64": "XipGXip7XihdXixYXiI5XiQ0XipBXiNqXiQ2XiJEXipKXihdXidiXiJkXiRGXjItXipGXip7XidwXis+XiFWXiR6XjZsXiZaXiQoXiosXiEsXihvXixuXiQpXjBzXiZaXi5jXixcXixlXjdEXiEiIA==",
      "byte_length": 112
    },
    {
      "unit_id": "DLG_14c7ab6c994d",
      "text": "只會招來更無情的殺戮。",
      "encoded_ascii": "^\"?^$r^,D^!O^$o^%}^,0^&Z^%M^,:^!\"",
      "encoded_base64": "XiI/XiRyXixEXiFPXiRvXiV9XiwwXiZaXiVNXiw6XiEi",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_0c6ff1c328f7",
      "text": "我心知肚明，奴隸村莊對抗城邦正規軍根本毫無勝算。 ",
      "encoded_ascii": "^$%^#k^&h^=1^$c^*A^##^)Z^$z^6l^#:^$4^+_^1a^%H^6'^..^%)^$x^/t^%}^+5^-C^!\" ",
      "encoded_base64": "XiQlXiNrXiZoXj0xXiRjXipBXiMjXilaXiR6XjZsXiM6XiQ0XitfXjFhXiVIXjYnXi4uXiUpXiR4Xi90XiV9Xis1Xi1DXiEiIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_8c01e4343985",
      "text": "說不定要是你們主動投降，城邦軍隊還能對我們剩下的人網開一面。 ",
      "encoded_ascii": "^-x^!)^#.^(C^,X^*F^*{^!-^\"%^$3^)N^*A^+_^1a^..^)U^.7^'b^#:^$%^*{^8U^!(^&Z^!<^'G^)F^!%^)j^!\" ",
      "encoded_base64": "Xi14XiEpXiMuXihDXixYXipGXip7XiEtXiIlXiQzXilOXipBXitfXjFhXi4uXilVXi43XidiXiM6XiQlXip7XjhVXiEoXiZaXiE8XidHXilGXiElXilqXiEiIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_25539eed26be",
      "text": "饒我們一條生路。",
      "encoded_ascii": "^.M^$%^*{^!%^%.^&F^(a^!\"",
      "encoded_base64": "Xi5NXiQlXip7XiElXiUuXiZGXihhXiEi",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_e2bc55f9674e",
      "text": "那支軍隊是由一名未嘗敗績的半巨人統領的， ",
      "encoded_ascii": "^)!^$L^..^)U^,X^&I^!%^\"F^,_^1o^$R^?P^&Z^\"-^#H^!<^'B^)s^&Z^*A ",
      "encoded_base64": "XikhXiRMXi4uXilVXixYXiZJXiElXiJGXixfXjFvXiRSXj9QXiZaXiItXiNIXiE8XidCXilzXiZaXipBIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_478b6a2f7755",
      "text": "但早在你們所有人親眼見到他之前，你們早就已經是一具具死屍了。 ",
      "encoded_ascii": "^!I^,V^\"d^*F^*{^$)^$s^!<^(F^&d^-m^!u^!@^!/^!z^*A^*F^*{^,V^*J^#J^'D^,X^!%^!k^!k^%L^#?^*D^!\" ",
      "encoded_base64": "XiFJXixWXiJkXipGXip7XiQpXiRzXiE8XihGXiZkXi1tXiF1XiFAXiEvXiF6XipBXipGXip7XixWXipKXiNKXidEXixYXiElXiFrXiFrXiVMXiM/XipEXiEiIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_119d703603c0",
      "text": "連他的面都見不著。",
      "encoded_ascii": "^.0^!@^&Z^)j^)$^-m^!)^-a^!\"",
      "encoded_base64": "Xi4wXiFAXiZaXilqXikkXi1tXiEpXi1hXiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_5cc84fcff134",
      "text": "不，這才是問題所在！你們根本是在拿石頭去砸馬蜂窩。",
      "encoded_ascii": "^!)^*A^(s^$,^,X^*Z^.G^$)^\"d^*W^*F^*{^%)^$x^,X^\"d^,G^&k^)t^\"6^0#^*\"^=i^=0^!\"",
      "encoded_base64": "XiEpXipBXihzXiQsXixYXipaXi5HXiQpXiJkXipXXipGXip7XiUpXiR4XixYXiJkXixHXiZrXil0XiI2XjAjXioiXj1pXj0wXiEi",
      "byte_length": 75
    },
    {
      "unit_id": "DLG_42e8b8f17f8d",
      "text": "絕不可能！你以為為什麼盟友會這麼難找？",
      "encoded_ascii": "^-I^!)^\"A^'b^*W^*F^!B^%{^%{^!=^.T^-0^\"8^$r^(s^.T^)a^$/^.V",
      "encoded_base64": "Xi1JXiEpXiJBXidiXipXXipGXiFCXiV7XiV7XiE9Xi5UXi0wXiI4XiRyXihzXi5UXilhXiQvXi5W",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_2783274b1ffb",
      "text": " 就算大漠裡的所有前奴隸全都聯合起來對抗德拉吉， ",
      "encoded_ascii": " ^*J^-C^\"z^,}^-j^&Z^$)^$s^!z^##^)Z^!h^)$^-V^\"C^.(^!O^#:^$4^#j^$6^\"D^*A ",
      "encoded_base64": "IF4qSl4tQ14iel4sfV4tal4mWl4kKV4kc14hel4jI14pWl4haF4pJF4tVl4iQ14uKF4hT14jOl4kNF4jal4kNl4iRF4qQSA=",
      "byte_length": 71
    },
    {
      "unit_id": "DLG_6232774d3bd1",
      "text": "你們也毫無勝算！德拉吉實在太強大了。",
      "encoded_ascii": "^*F^*{^!1^/t^%}^+5^-C^*W^#j^$6^\"D^#3^\"d^+f^#]^\"z^*D^!\"",
      "encoded_base64": "XipGXip7XiExXi90XiV9Xis1Xi1DXipXXiNqXiQ2XiJEXiMzXiJkXitmXiNdXiJ6XipEXiEi",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_2b68a9a7f00b",
      "text": "我遲早會成為提奎茲爾的領袖。這一點你最好牢記在心。 ",
      "encoded_ascii": "^$%^.5^,V^$r^$$^%{^$A^5B^/D^&/^&Z^)s^7G^!\"^(s^!%^*;^*F^$q^+i^-$^(K^\"d^#k^!\" ",
      "encoded_base64": "XiQlXi41XixWXiRyXiQkXiV7XiRBXjVCXi9EXiYvXiZaXilzXjdHXiEiXihzXiElXio7XipGXiRxXitpXi0kXihLXiJkXiNrXiEiIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_4cbb7fe8cd5c",
      "text": "記在心裡對你更有好處。",
      "encoded_ascii": "^(K^\"d^#k^-j^#:^*F^$o^$s^+i^(,^!\"",
      "encoded_base64": "XihLXiJkXiNrXi1qXiM6XipGXiRvXiRzXitpXigsXiEi",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_a3d0a993b4f1",
      "text": "  憑什麼該由你來當領袖？",
      "encoded_ascii": "  ^,5^!=^.T^(M^&I^*F^!O^&N^)s^7G^.V",
      "encoded_base64": "ICBeLDVeIT1eLlReKE1eJkleKkZeIU9eJk5eKXNeN0deLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_05cf9c98d5d5",
      "text": "  你是為村民帶來財富，還是為你自己？",
      "encoded_ascii": "  ^*F^,X^%{^$z^%T^#N^!O^0=^3C^*A^.7^,X^%{^*F^'l^#I^.V",
      "encoded_base64": "ICBeKkZeLFheJXteJHpeJVReI05eIU9eMD1eM0NeKkFeLjdeLFheJXteKkZeJ2xeI0leLlY=",
      "byte_length": 53
    },
    {
      "unit_id": "DLG_dec1eb950f90",
      "text": "  由查爾擔任領袖有什麼不好？",
      "encoded_ascii": "  ^&I^%&^&/^*N^!C^)s^7G^$s^!=^.T^!)^+i^.V",
      "encoded_base64": "ICBeJkleJSZeJi9eKk5eIUNeKXNeN0deJHNeIT1eLlReISleK2leLlY=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_9c540316b72f",
      "text": "  那你現在為何不敢向查爾挑戰？",
      "encoded_ascii": "  ^)!^*F^&?^\"d^%{^!L^!)^/m^+?^%&^&/^,H^$(^.V",
      "encoded_base64": "ICBeKSFeKkZeJj9eImReJXteIUxeISleL21eKz9eJSZeJi9eLEheJCheLlY=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_1646a87a4efa",
      "text": " 只因為一個被太陽曬得發昏的瘋癲預言者稱你們為英雄—— ",
      "encoded_ascii": " ^\"?^\"]^%{^!%^!V^(@^+f^.@^,Z^#e^&W^$d^&Z^-/^4Y^.E^1Y^'V^0&^*F^*{^%{^'y^)\\^*n^*n ",
      "encoded_base64": "IF4iP14iXV4le14hJV4hVl4oQF4rZl4uQF4sWl4jZV4mV14kZF4mWl4tL140WV4uRV4xWV4nVl4wJl4qRl4qe14le14neV4pXF4qbl4qbiA=",
      "byte_length": 80
    },
    {
      "unit_id": "DLG_e82adbde4841",
      "text": "依我看，說你們是僱傭兵還更貼切些。",
      "encoded_ascii": "^!Q^$%^*Q^*A^-x^*F^*{^,X^=?^5,^+,^.7^$o^<G^+.^!8^!\"",
      "encoded_base64": "XiFRXiQlXipRXipBXi14XipGXip7XixYXj0/XjUsXissXi43XiRvXjxHXisuXiE4XiEi",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_38d948109585",
      "text": "我們會從商隊那裡採購黑曜石或木材等原料， ",
      "encoded_ascii": "^$%^*{^$r^#f^1'^)U^)!^-j^5R^63^*:^5X^&k^$'^$v^$y^'-^\"5^/n^*A ",
      "encoded_base64": "XiQlXip7XiRyXiNmXjEnXilVXikhXi1qXjVSXjYzXio6XjVYXiZrXiQnXiR2XiR5XictXiI1Xi9uXipBIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_a6f3039f6fad",
      "text": "用它們製造成工具之類的器物，然後再將成品賣回給各路商隊。 ",
      "encoded_ascii": "^&H^+o^*{^(B^(v^$$^+y^!k^!/^)w^&Z^\"V^&4^*A^&\"^#b^!l^#7^$$^\"R^.$^\"\\^'A^+>^(a^1'^)U^!\" ",
      "encoded_base64": "XiZIXitvXip7XihCXih2XiQkXit5XiFrXiEvXil3XiZaXiJWXiY0XipBXiYiXiNiXiFsXiM3XiQkXiJSXi4kXiJcXidBXis+XihhXjEnXilVXiEiIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_1c3ca8c2b7b5",
      "text": "從中牟取利潤。",
      "encoded_ascii": "^#f^!,^?f^\":^!t^7_^!\"",
      "encoded_base64": "XiNmXiEsXj9mXiI6XiF0XjdfXiEi",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_beb8d2b4c369",
      "text": "我掌控著這片區域唯一可靠的一口水井。哪怕不為別的，各路商隊光是為了喝水也一定會來； ",
      "encoded_ascii": "^$%^$;^$@^-a^(s^&1^\"+^\"k^+O^!%^\"A^.C^&Z^!%^\"<^%V^!7^!\"^+I^0^^!)^%{^*H^&Z^*A^+>^(a^1'^)U^!c^,X^%{^*D^6M^%V^!1^!%^#.^$r^!O^*C ",
      "encoded_base64": "XiQlXiQ7XiRAXi1hXihzXiYxXiIrXiJrXitPXiElXiJBXi5DXiZaXiElXiI8XiVWXiE3XiEiXitJXjBeXiEpXiV7XipIXiZaXipBXis+XihhXjEnXilVXiFjXixYXiV7XipEXjZNXiVWXiExXiElXiMuXiRyXiFPXipDIA==",
      "byte_length": 124
    },
    {
      "unit_id": "DLG_2374041be20b",
      "text": "而如果我用清水來換取原料，我的收益將會暴漲。 ",
      "encoded_ascii": "^'W^#$^%!^$%^&H^,u^%V^!O^4@^\":^\"5^/n^*A^$%^&Z^$M^3R^#7^$r^$m^7^^!\" ",
      "encoded_base64": "XidXXiMkXiUhXiQlXiZIXix1XiVWXiFPXjRAXiI6XiI1Xi9uXipBXiQlXiZaXiRNXjNSXiM3XiRyXiRtXjdeXiEiIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_16e9af861507",
      "text": "利潤必定源源不絕。",
      "encoded_ascii": "^!t^7_^#l^#.^%q^%q^!)^-I^!\"",
      "encoded_base64": "XiF0XjdfXiNsXiMuXiVxXiVxXiEpXi1JXiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_dd00952476fa",
      "text": "那是忠犬跟隨瀕死主人的奴才心態，而這裡太多人都有這種毛病。 ",
      "encoded_ascii": "^)!^,X^.d^&6^.+^)X^?e^%L^!-^!<^&Z^##^$,^#k^#|^*A^'W^(s^-j^+f^\"x^!<^)$^$s^(s^'$^%R^&R^!\" ",
      "encoded_base64": "XikhXixYXi5kXiY2Xi4rXilYXj9lXiVMXiEtXiE8XiZaXiMjXiQsXiNrXiN8XipBXidXXihzXi1qXitmXiJ4XiE8XikkXiRzXihzXickXiVSXiZSXiEiIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_df48547dddfc",
      "text": "永遠別安於現狀，這才是你在這片廢土上出人頭地的唯一途徑。 ",
      "encoded_ascii": "^%W^({^*H^+p^$^^&?^&7^*A^(s^$,^,X^*F^\"d^(s^&1^#W^\"c^!'^!q^!<^)t^\"e^&Z^+O^!%^3.^#c^!\" ",
      "encoded_base64": "XiVXXih7XipIXitwXiReXiY/XiY3XipBXihzXiQsXixYXipGXiJkXihzXiYxXiNXXiJjXiEnXiFxXiE8Xil0XiJlXiZaXitPXiElXjMuXiNjXiEiIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_a12db1c27101",
      "text": "唯一能出人頭地的方法。",
      "encoded_ascii": "^+O^!%^'b^!q^!<^)t^\"e^&Z^$]^%b^!\"",
      "encoded_base64": "XitPXiElXidiXiFxXiE8Xil0XiJlXiZaXiRdXiViXiEi",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_0138e250a642",
      "text": "我會給這座被烈日曬褪色的村落帶來財富。",
      "encoded_ascii": "^$%^$r^'A^(s^/_^(@^%|^$a^,Z^<E^'s^&Z^$z^-`^#N^!O^0=^3C^!\"",
      "encoded_base64": "XiQlXiRyXidBXihzXi9fXihAXiV8XiRhXixaXjxFXidzXiZaXiR6Xi1gXiNOXiFPXjA9XjNDXiEi",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_de7e5402e2da",
      "text": "這本就是一碼事。只要我富裕了，村民們的日子自然會過得更好——而且他們自己也能賺到錢。 ",
      "encoded_ascii": "^(s^$x^*J^,X^!%^94^*r^!\"^\"?^(C^$%^3C^8Q^*D^*A^$z^%T^*{^&Z^$a^#(^'l^&\"^$r^(x^#e^$o^+i^*n^*n^'W^!*^!@^*{^'l^#I^!1^'b^7m^!u^.<^!\" ",
      "encoded_base64": "XihzXiR4XipKXixYXiElXjk0XipyXiEiXiI/XihDXiQlXjNDXjhRXipEXipBXiR6XiVUXip7XiZaXiRhXiMoXidsXiYiXiRyXih4XiNlXiRvXitpXipuXipuXidXXiEqXiFAXip7XidsXiNJXiExXidiXjdtXiF1Xi48XiEiIA==",
      "byte_length": 127
    },
    {
      "unit_id": "DLG_ed075aef882e",
      "text": "大家都能分一杯羹。",
      "encoded_ascii": "^\"z^+s^)$^'b^!s^!%^5Y^?j^!\"",
      "encoded_base64": "XiJ6XitzXikkXidiXiFzXiElXjVZXj9qXiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_866d4cba7589",
      "text": "我為何要那麼做？歲月自然會替我解決掉查爾。我既不是個急躁之人，也絕不會去冒無謂的風險。 ",
      "encoded_ascii": "^$%^%{^!L^(C^)!^.T^*~^.V^,j^/p^'l^&\"^$r^2o^$%^(I^,o^/e^%&^&/^!\"^$%^,U^!)^,X^!V^3p^4\"^!/^!<^*A^!1^-I^!)^$r^\"6^/P^%}^0s^&Z^)y^*m^!\" ",
      "encoded_base64": "XiQlXiV7XiFMXihDXikhXi5UXip+Xi5WXixqXi9wXidsXiYiXiRyXjJvXiQlXihJXixvXi9lXiUmXiYvXiEiXiQlXixVXiEpXixYXiFWXjNwXjQiXiEvXiE8XipBXiExXi1JXiEpXiRyXiI2Xi9QXiV9XjBzXiZaXil5XiptXiEiIA==",
      "byte_length": 130
    },
    {
      "unit_id": "DLG_4b9448879e14",
      "text": "我可不會輕舉妄動。",
      "encoded_ascii": "^$%^\"A^!)^$r^(g^01^+j^\"%^!\"",
      "encoded_base64": "XiQlXiJBXiEpXiRyXihnXjAxXitqXiIlXiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_8afcb105eebe",
      "text": "這座村莊需要新思維。查爾以為只要築起圍牆、桌上有麵包就心滿意足了。 ",
      "encoded_ascii": "^(s^/_^$z^6l^)e^(C^$\\^#q^'F^!\"^%&^&/^!B^%{^\"?^(C^8;^.(^\"`^&0^!!^/q^!'^$s^*5^\"'^*J^#k^,{^#z^(^^*D^!\" ",
      "encoded_base64": "XihzXi9fXiR6XjZsXillXihDXiRcXiNxXidGXiEiXiUmXiYvXiFCXiV7XiI/XihDXjg7Xi4oXiJgXiYwXiEhXi9xXiEnXiRzXio1XiInXipKXiNrXix7XiN6XiheXipEXiEiIA==",
      "byte_length": 100
    },
    {
      "unit_id": "DLG_0c131512d7f3",
      "text": "如果你是個愚蠢的穆爾人，那樣確實足夠了；但人生還有更多更好的東西值得追求。 ",
      "encoded_ascii": "^#$^%!^*F^,X^!V^/a^.u^&Z^8K^&/^!<^*A^)!^,f^-6^#3^(^^+d^*D^*C^!I^!<^&F^.7^$s^$o^\"x^$o^+i^&Z^,`^-l^!Z^#e^(o^,n^!\" ",
      "encoded_base64": "XiMkXiUhXipGXixYXiFWXi9hXi51XiZaXjhLXiYvXiE8XipBXikhXixmXi02XiMzXiheXitkXipEXipDXiFJXiE8XiZGXi43XiRzXiRvXiJ4XiRvXitpXiZaXixgXi1sXiFaXiNlXihvXixuXiEiIA==",
      "byte_length": 112
    },
    {
      "unit_id": "DLG_4979e6820c7b",
      "text": "生命中還有更多美好的追求。",
      "encoded_ascii": "^&F^\"N^!,^.7^$s^$o^\"x^-P^+i^&Z^(o^,n^!\"",
      "encoded_base64": "XiZGXiJOXiEsXi43XiRzXiRvXiJ4Xi1QXitpXiZaXihvXixuXiEi",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_e48670d27826",
      "text": "我現在寧可什麼都不說。",
      "encoded_ascii": "^$%^&?^\"d^3k^\"A^!=^.T^)$^!)^-x^!\"",
      "encoded_base64": "XiQlXiY/XiJkXjNrXiJBXiE9Xi5UXikkXiEpXi14XiEi",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_41ee82289c9e",
      "text": "  我可沒興趣當你們的英雄。",
      "encoded_ascii": "  ^$%^\"A^%\\^-]^.*^&N^*F^*{^&Z^'y^)\\^!\"",
      "encoded_base64": "ICBeJCVeIkFeJVxeLV1eLipeJk5eKkZeKnteJlpeJ3leKVxeISI=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_7a918d765082",
      "text": "  我會幫助你們的！",
      "encoded_ascii": "  ^$%^$r^+}^\"#^*F^*{^&Z^*W",
      "encoded_base64": "ICBeJCVeJHJeK31eIiNeKkZeKnteJlpeKlc=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_007eee6f2b82",
      "text": "你們是回來幫助我們的嗎？",
      "encoded_ascii": "^*F^*{^,X^\"\\^!O^+}^\"#^$%^*{^&Z^+X^.V",
      "encoded_base64": "XipGXip7XixYXiJcXiFPXit9XiIjXiQlXip7XiZaXitYXi5W",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_77460515620f",
      "text": " 說預言中的浩劫已迫在眉睫。",
      "encoded_ascii": " ^-x^.E^1Y^!,^&Z^5^^1l^#J^1`^\"d^3S^8o^!\"",
      "encoded_base64": "IF4teF4uRV4xWV4hLF4mWl41Xl4xbF4jSl4xYF4iZF4zU144b14hIg==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_bb448a708133",
      "text": "你們看，",
      "encoded_ascii": "^*F^*{^*Q^*A",
      "encoded_base64": "XipGXip7XipRXipB",
      "byte_length": 12
    },
    {
      "unit_id": "DLG_88dabd67f962",
      "text": " 說的一點沒錯！正是他們將會應驗預言。提奎茲爾將得以倖存！",
      "encoded_ascii": " ^-x^&Z^!%^*;^%\\^)5^*W^%H^,X^!@^*{^#7^$r^0`^.P^.E^1Y^!\"^$A^5B^/D^&/^#7^#e^!B^5+^#*^*W",
      "encoded_base64": "IF4teF4mWl4hJV4qO14lXF4pNV4qV14lSF4sWF4hQF4qe14jN14kcl4wYF4uUF4uRV4xWV4hIl4kQV41Ql4vRF4mL14jN14jZV4hQl41K14jKl4qVw==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_3d04a8b1bf11",
      "text": "向你們致敬，英雄們！我是提奎茲爾的領袖查爾。我們恭候你們多時了。",
      "encoded_ascii": "^+?^*F^*{^'o^*O^*A^'y^)\\^*{^*W^$%^,X^$A^5B^/D^&/^&Z^)s^7G^%&^&/^!\"^$%^*{^1{^*|^*F^*{^\"x^$f^*D^!\"",
      "encoded_base64": "Xis/XipGXip7XidvXipPXipBXid5XilcXip7XipXXiQlXixYXiRBXjVCXi9EXiYvXiZaXilzXjdHXiUmXiYvXiEiXiQlXip7XjF7Xip8XipGXip7XiJ4XiRmXipEXiEi",
      "byte_length": 96
    },
    {
      "unit_id": "DLG_37bbeb0726af",
      "text": "  你在胡言亂語些什麼？",
      "encoded_ascii": "  ^*F^\"d^3}^1Y^!3^0:^!8^!=^.T^.V",
      "encoded_base64": "ICBeKkZeImReM31eMVleITNeMDpeITheIT1eLlReLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_997eb62e9941",
      "text": "  跟我說說這則預言吧。",
      "encoded_ascii": "  ^.+^$%^-x^-x^(s^!x^.E^1Y^*I^!\"",
      "encoded_base64": "ICBeLiteJCVeLXheLXheKHNeIXheLkVeMVleKkleISI=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_eb26dd62d08b",
      "text": "  我為什麼要幫你？",
      "encoded_ascii": "  ^$%^%{^!=^.T^(C^+}^*F^.V",
      "encoded_base64": "ICBeJCVeJXteIT1eLlReKENeK31eKkZeLlY=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_c2256962acf5",
      "text": "深感榮幸， ",
      "encoded_ascii": "^2*^#{^,e^15^*A ",
      "encoded_base64": "XjIqXiN7XixlXjE1XipBIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_3c53b30a52f2",
      "text": "。現在我們終於有了能與",
      "encoded_ascii": "^!\"^&?^\"d^$%^*{^-H^$^^$s^*D^'b^'p",
      "encoded_base64": "XiEiXiY/XiJkXiQlXip7Xi1IXiReXiRzXipEXidiXidw",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_f0cfa9992a03",
      "text": " 所繪畫像相匹配的尊姓大名了。",
      "encoded_ascii": " ^$)^0,^-,^!`^&a^8w^)&^&Z^+u^6S^\"z^\"F^*D^!\"",
      "encoded_base64": "IF4kKV4wLF4tLF4hYF4mYV44d14pJl4mWl4rdV42U14iel4iRl4qRF4hIg==",
      "byte_length": 43
    },
    {
      "unit_id": "DLG_bb4c533b1037",
      "text": "的預言！提奎茲爾注定要滅亡",
      "encoded_ascii": "^&Z^.E^1Y^*W^$A^5B^/D^&/^%e^#.^(C^%t^!:",
      "encoded_base64": "XiZaXi5FXjFZXipXXiRBXjVCXi9EXiYvXiVlXiMuXihDXiV0XiE6",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_83b888a1a7c5",
      "text": "，但你們…… ",
      "encoded_ascii": "^*A^!I^*F^*{^*o^*o ",
      "encoded_base64": "XipBXiFJXipGXip7XipvXipvIA==",
      "byte_length": 19
    },
    {
      "unit_id": "DLG_a259bf0d58dc",
      "text": "我們崇高的領袖想表達的是，提奎茲爾正籠罩在一則末日預言之下。 ",
      "encoded_ascii": "^$%^*{^13^*+^&Z^)s^7G^,1^-i^(z^&Z^,X^*A^$A^5B^/D^&/^%H^'3^'P^\"d^!%^!x^$w^$a^.E^1Y^!/^!(^!\" ",
      "encoded_base64": "XiQlXip7XjEzXiorXiZaXilzXjdHXiwxXi1pXih6XiZaXixYXipBXiRBXjVCXi9EXiYvXiVIXiczXidQXiJkXiElXiF4XiR3XiRhXi5FXjFZXiEvXiEoXiEiIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_74bc4a6890c9",
      "text": "你們完全符合預言中的描述。",
      "encoded_ascii": "^*F^*{^#,^!h^'+^\"C^.E^1Y^!,^&Z^/g^68^!\"",
      "encoded_base64": "XipGXip7XiMsXiFoXicrXiJDXi5FXjFZXiEsXiZaXi9nXjY4XiEi",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_e21222028deb",
      "text": "你們就是那群將拯救提奎茲爾的英雄，正如那位預言者所說的一樣。",
      "encoded_ascii": "^*F^*{^*J^,X^)!^'R^#7^,F^,Q^$A^5B^/D^&/^&Z^'y^)\\^*A^%H^#$^)!^!J^.E^1Y^'V^$)^-x^&Z^!%^,f^!\"",
      "encoded_base64": "XipGXip7XipKXixYXikhXidSXiM3XixGXixRXiRBXjVCXi9EXiYvXiZaXid5XilcXipBXiVIXiMkXikhXiFKXi5FXjFZXidWXiQpXi14XiZaXiElXixmXiEi",
      "byte_length": 90
    },
    {
      "unit_id": "DLG_68ebc51be45c",
      "text": "不，不！顯而易見，你們就是那群天選的英雄。",
      "encoded_ascii": "^!)^*A^!)^*W^4&^'W^,W^-m^*A^*F^*{^*J^,X^)!^'R^+e^.6^&Z^'y^)\\^!\"",
      "encoded_base64": "XiEpXipBXiEpXipXXjQmXidXXixXXi1tXipBXipGXip7XipKXixYXikhXidSXitlXi42XiZaXid5XilcXiEi",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_c72564b00647",
      "text": "我無法強迫你們接納自己的命運，但預言的力量絕不容否認。",
      "encoded_ascii": "^$%^%}^%b^#]^1`^*F^*{^$?^';^'l^#I^&Z^\"N^.4^*A^!I^.E^1Y^&Z^!~^)*^-I^!)^+t^\"H^(O^!\"",
      "encoded_base64": "XiQlXiV9XiViXiNdXjFgXipGXip7XiQ/Xic7XidsXiNJXiZaXiJOXi40XipBXiFJXi5FXjFZXiZaXiF+XikqXi1JXiEpXit0XiJIXihPXiEi",
      "byte_length": 81
    },
    {
      "unit_id": "DLG_f790630c4c2a",
      "text": "等你們深思熟慮之後再來吧。告辭。",
      "encoded_ascii": "^'-^*F^*{^2*^#q^-\"^19^!/^#b^!l^!O^*I^!\"^+B^2M^!\"",
      "encoded_base64": "XictXipGXip7XjIqXiNxXi0iXjE5XiEvXiNiXiFsXiFPXipJXiEiXitCXjJNXiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_dc7240b3777e",
      "text": " 能更詳盡地向你們講述他的預言。重要的是，一支大軍 ",
      "encoded_ascii": " ^'b^$o^6v^-1^\"e^+?^*F^*{^6+^68^!@^&Z^.E^1Y^!\"^))^(C^&Z^,X^*A^!%^$L^\"z^.. ",
      "encoded_base64": "IF4nYl4kb142dl4tMV4iZV4rP14qRl4qe142K142OF4hQF4mWl4uRV4xWV4hIl4pKV4oQ14mWl4sWF4qQV4hJV4kTF4iel4uLiA=",
      "byte_length": 74
    },
    {
      "unit_id": "DLG_dced6d59054f",
      "text": "很快就會踏平提奎茲爾以及大漠中的所有村莊。他 ",
      "encoded_ascii": "^*K^*L^*J^$r^.,^0Y^$A^5B^/D^&/^!B^\"7^\"z^,}^!,^&Z^$)^$s^$z^6l^!\"^!@ ",
      "encoded_base64": "XipLXipMXipKXiRyXi4sXjBZXiRBXjVCXi9EXiYvXiFCXiI3XiJ6Xix9XiEsXiZaXiQpXiRzXiR6XjZsXiEiXiFAIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_559c62e3c887",
      "text": "說這場浩劫將從淤泥海一路蔓延至惡地之外。",
      "encoded_ascii": "^-x^(s^\"n^5^^1l^#7^#f^6c^%d^6`^!%^(a^?l^,&^'n^#y^\"e^!/^\"w^!\"",
      "encoded_base64": "Xi14XihzXiJuXjVeXjFsXiM3XiNmXjZjXiVkXjZgXiElXihhXj9sXiwmXiduXiN5XiJlXiEvXiJ3XiEi",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_2a47d57da60f",
      "text": "  這支大軍究竟來自何方？",
      "encoded_ascii": "  ^(s^$L^\"z^..^-<^28^!O^'l^!L^$]^.V",
      "encoded_base64": "ICBeKHNeJExeInpeLi5eLTxeMjheIU9eJ2xeIUxeJF1eLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_930f7ce9c040",
      "text": "  還有多久浩劫才會降臨？",
      "encoded_ascii": "  ^.7^$s^\"x^!.^5^^1l^$,^$r^)N^1U^.V",
      "encoded_base64": "ICBeLjdeJHNeInheIS5eNV5eMWxeJCxeJHJeKU5eMVVeLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_651cc434368a",
      "text": "  你為何會對這則預言深信不疑？",
      "encoded_ascii": "  ^*F^%{^!L^$r^#:^(s^!x^.E^1Y^2*^!U^!)^0p^.V",
      "encoded_base64": "ICBeKkZeJXteIUxeJHJeIzpeKHNeIXheLkVeMVleMipeIVVeISleMHBeLlY=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_4c213624016e",
      "text": "  跟我說說那位預言者吧。",
      "encoded_ascii": "  ^.+^$%^-x^-x^)!^!J^.E^1Y^'V^*I^!\"",
      "encoded_base64": "ICBeLiteJCVeLXheLXheKSFeIUpeLkVeMVleJ1ZeKkleISI=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_c03172513111",
      "text": "你們一定要伸出援手！你們是我們唯一的希望！",
      "encoded_ascii": "^*F^*{^!%^#.^(C^/N^!q^$C^$+^*W^*F^*{^,X^$%^*{^+O^!%^&Z^+{^,]^*W",
      "encoded_base64": "XipGXip7XiElXiMuXihDXi9OXiFxXiRDXiQrXipXXipGXip7XixYXiQlXip7XitPXiElXiZaXit7XixdXipX",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_1c6dd53118a7",
      "text": " 說道……",
      "encoded_ascii": " ^-x^(y^*o^*o",
      "encoded_base64": "IF4teF4oeV4qb14qbw==",
      "byte_length": 13
    },
    {
      "unit_id": "DLG_69f39ffbe720",
      "text": "別幫我們。亞薩斯是個殘酷的世界——每個人都得自求多福。 ",
      "encoded_ascii": "^*H^+}^$%^*{^!\"^!9^-e^$[^,X^!V^,l^1b^&Z^*p^.p^*n^*n^%P^!V^!<^)$^#e^'l^,n^\"x^&z^!\" ",
      "encoded_base64": "XipIXit9XiQlXip7XiEiXiE5Xi1lXiRbXixYXiFWXixsXjFiXiZaXipwXi5wXipuXipuXiVQXiFWXiE8XikkXiNlXidsXixuXiJ4XiZ6XiEiIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_d71212389983",
      "text": "在你們到來之前提奎茲爾就活得好好的，等你們走後這裡依然會如此。",
      "encoded_ascii": "^\"d^*F^*{^!u^!O^!/^!z^$A^5B^/D^&/^*J^%i^#e^+i^+i^&Z^*A^'-^*F^*{^.&^#b^(s^-j^!Q^&\"^$r^#$^%I^!\"",
      "encoded_base64": "XiJkXipGXip7XiF1XiFPXiEvXiF6XiRBXjVCXi9EXiYvXipKXiVpXiNlXitpXitpXiZaXipBXictXipGXip7Xi4mXiNiXihzXi1qXiFRXiYiXiRyXiMkXiVJXiEi",
      "byte_length": 93
    },
    {
      "unit_id": "DLG_d810e31ad1ca",
      "text": "別聽他的。奎林只是在嫉妒罷了。",
      "encoded_ascii": "^*H^-X^!@^&Z^!\"^5B^/1^\"?^,X^\"d^7*^7'^1Q^*D^!\"",
      "encoded_base64": "XipIXi1YXiFAXiZaXiEiXjVCXi8xXiI/XixYXiJkXjcqXjcnXjFRXipEXiEi",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_2633c4c789da",
      "text": "光靠我們自己根本無法抗衡德拉吉。我們唯一的希望就是與其他 ",
      "encoded_ascii": "^!c^.C^$%^*{^'l^#I^%)^$x^%}^%b^$4^8P^#j^$6^\"D^!\"^$%^*{^+O^!%^&Z^+{^,]^*J^,X^'p^!j^!@ ",
      "encoded_base64": "XiFjXi5DXiQlXip7XidsXiNJXiUpXiR4XiV9XiViXiQ0XjhQXiNqXiQ2XiJEXiEiXiQlXip7XitPXiElXiZaXit7XixdXipKXixYXidwXiFqXiFAIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_c998f1cfac35",
      "text": "前角鬥士村莊聯手。你們必須說服那些村莊加入我們的陣線。",
      "encoded_ascii": "^!z^(H^*,^+a^$z^6l^-V^$+^!\"^*F^*{^#l^)r^-x^,\\^)!^!8^$z^6l^\"\"^!f^$%^*{^&Z^)P^'I^!\"",
      "encoded_base64": "XiF6XihIXiosXithXiR6XjZsXi1WXiQrXiEiXipGXip7XiNsXilyXi14XixcXikhXiE4XiR6XjZsXiIiXiFmXiQlXip7XiZaXilQXidJXiEi",
      "byte_length": 81
    },
    {
      "unit_id": "DLG_846710fa80ca",
      "text": "  你為何認為同盟能奏效？",
      "encoded_ascii": "  ^*F^%{^!L^(O^%{^\"E^-0^'b^8F^$Q^.V",
      "encoded_base64": "ICBeKkZeJXteIUxeKE9eJXteIkVeLTBeJ2JeOEZeJFFeLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_70a5541ab7df",
      "text": "  在我做出決定之前，我需要瞭解更多細節。",
      "encoded_ascii": "  ^\"d^$%^*~^!q^,o^#.^!/^!z^*A^$%^)e^(C^<p^(I^$o^\"x^'?^9b^!\"",
      "encoded_base64": "ICBeImReJCVeKn5eIXFeLG9eIy5eIS9eIXpeKkFeJCVeKWVeKENePHBeKEleJG9eInheJz9eOWJeISI=",
      "byte_length": 59
    },
    {
      "unit_id": "DLG_991566725d87",
      "text": " 並未確切指明。我推測那支大軍應該會來自德拉吉。",
      "encoded_ascii": " ^!+^,_^-6^+.^$8^$c^!\"^$%^,J^%p^)!^$L^\"z^..^0`^(M^$r^!O^'l^#j^$6^\"D^!\"",
      "encoded_base64": "IF4hK14sX14tNl4rLl4kOF4kY14hIl4kJV4sSl4lcF4pIV4kTF4iel4uLl4wYF4oTV4kcl4hT14nbF4jal4kNl4iRF4hIg==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_88b1f07033f6",
      "text": "……",
      "encoded_ascii": "^*o^*o",
      "encoded_base64": "XipvXipv",
      "byte_length": 6
    },
    {
      "unit_id": "DLG_f31f85d81d80",
      "text": "德拉吉是唯一能派出像",
      "encoded_ascii": "^#j^$6^\"D^,X^+O^!%^'b^.n^!q^!`",
      "encoded_base64": "XiNqXiQ2XiJEXixYXitPXiElXidiXi5uXiFxXiFg",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_12d4e0873ea4",
      "text": " 所描述那樣龐大軍隊的城邦，但我尚未聽聞任何要開戰的跡象。",
      "encoded_ascii": " ^$)^/g^68^)!^,f^6H^\"z^..^)U^&Z^+_^1a^*A^!I^$%^+v^,_^-X^4^^!C^!L^(C^)F^$(^&Z^(`^4g^!\"",
      "encoded_base64": "IF4kKV4vZ142OF4pIV4sZl42SF4iel4uLl4pVV4mWl4rX14xYV4qQV4hSV4kJV4rdl4sX14tWF40Xl4hQ14hTF4oQ14pRl4kKF4mWl4oYF40Z14hIg==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_b5806eec2a9d",
      "text": "滿載兵器的商隊已經開往德拉吉了。 ",
      "encoded_ascii": "^,{^64^+,^\"V^&Z^1'^)U^#J^'D^)F^,)^#j^$6^\"D^*D^!\" ",
      "encoded_base64": "Xix7XjY0XissXiJWXiZaXjEnXilVXiNKXidEXilGXiwpXiNqXiQ2XiJEXipEXiEiIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_c923aeff4759",
      "text": "備戰行動眼下正在緊鑼密鼓地進行！",
      "encoded_ascii": "^+\"^$(^(;^\"%^&d^!(^%H^\"d^0r^)B^#0^*<^\"e^(w^(;^*W",
      "encoded_base64": "XisiXiQoXig7XiIlXiZkXiEoXiVIXiJkXjByXilCXiMwXio8XiJlXih3Xig7XipX",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_3d9a3f998352",
      "text": "他的預言向來靈驗，如今你們也正如期而至。這件事絕無可疑。",
      "encoded_ascii": "^!@^&Z^.E^1Y^+?^!O^)g^.P^*A^#$^*E^*F^*{^!1^%H^#$^$u^'W^'n^!\"^(s^.W^*r^-I^%}^\"A^0p^!\"",
      "encoded_base64": "XiFAXiZaXi5FXjFZXis/XiFPXilnXi5QXipBXiMkXipFXipGXip7XiExXiVIXiMkXiR1XidXXiduXiEiXihzXi5XXipyXi1JXiV9XiJBXjBwXiEi",
      "byte_length": 84
    },
    {
      "unit_id": "DLG_d6471afda99d",
      "text": "並不是所有人都相信。依我看，提奎茲爾最好先管好自己的一畝三分地， ",
      "encoded_ascii": "^!+^!)^,X^$)^$s^!<^)$^&a^!U^!\"^!Q^$%^*Q^*A^$A^5B^/D^&/^$q^+i^!b^-D^+i^'l^#I^&Z^!%^?g^!&^!s^\"e^*A ",
      "encoded_base64": "XiErXiEpXixYXiQpXiRzXiE8XikkXiZhXiFVXiEiXiFRXiQlXipRXipBXiRBXjVCXi9EXiYvXiRxXitpXiFiXi1EXitpXidsXiNJXiZaXiElXj9nXiEmXiFzXiJlXipBIA==",
      "byte_length": 97
    },
    {
      "unit_id": "DLG_f9124ad14cdd",
      "text": "而不是去瞎操心整個天下。",
      "encoded_ascii": "^'W^!)^,X^\"6^2}^$H^#k^$T^!V^+e^!(^!\"",
      "encoded_base64": "XidXXiEpXixYXiI2XjJ9XiRIXiNrXiRUXiFWXitlXiEoXiEi",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_756576eb42a4",
      "text": "要是整個世界都在我們頭頂上塌陷了，你以為我們還能獨善其身嗎？",
      "encoded_ascii": "^(C^,X^$T^!V^*p^.p^)$^\"d^$%^*{^)t^)p^!'^<f^)S^*D^*A^*F^!B^%{^$%^*{^.7^'b^/z^1(^!j^(c^+X^.V",
      "encoded_base64": "XihDXixYXiRUXiFWXipwXi5wXikkXiJkXiQlXip7Xil0XilwXiEnXjxmXilTXipEXipBXipGXiFCXiV7XiQlXip7Xi43XidiXi96XjEoXiFqXihjXitYXi5W",
      "byte_length": 90
    },
    {
      "unit_id": "DLG_4d31c44972af",
      "text": "我們別無選擇。各個村莊若是單打獨鬥，在德拉吉面前就只是待宰的羔羊。",
      "encoded_ascii": "^$%^*{^*H^%}^.6^,N^!\"^+>^!V^$z^6l^'x^,X^2a^$-^/z^*,^*A^\"d^#j^$6^\"D^)j^!z^*J^\"?^,X^,*^1w^&Z^?i^8M^!\"",
      "encoded_base64": "XiQlXip7XipIXiV9Xi42XixOXiEiXis+XiFWXiR6XjZsXid4XixYXjJhXiQtXi96XiosXipBXiJkXiNqXiQ2XiJEXilqXiF6XipKXiI/XixYXiwqXjF3XiZaXj9pXjhNXiEi",
      "byte_length": 99
    },
    {
      "unit_id": "DLG_a3ae4c95be82",
      "text": " 亦曾預言，大漠深處將掀起一場宏大的起義，並一舉擊潰那支軍隊。",
      "encoded_ascii": " ^7#^.j^.E^1Y^*A^\"z^,}^2*^(,^#7^8h^.(^!%^\"n^45^\"z^&Z^.(^2<^*A^!+^!%^01^$F^2-^)!^$L^..^)U^!\"",
      "encoded_base64": "IF43I14ual4uRV4xWV4qQV4iel4sfV4yKl4oLF4jN144aF4uKF4hJV4ibl40NV4iel4mWl4uKF4yPF4qQV4hK14hJV4wMV4kRl4yLV4pIV4kTF4uLl4pVV4hIg==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_5930d9ca5d82",
      "text": "但我們其他人認為，保持獨立、行動敏捷機動才是更好的生存之道。",
      "encoded_ascii": "^!I^$%^*{^!j^!@^!<^(O^%{^*A^!T^$7^/z^0'^!!^(;^\"%^//^/.^%>^\"%^$,^,X^$o^+i^&Z^&F^#*^!/^(y^!\"",
      "encoded_base64": "XiFJXiQlXip7XiFqXiFAXiE8XihPXiV7XipBXiFUXiQ3Xi96XjAnXiEhXig7XiIlXi8vXi8uXiU+XiIlXiQsXixYXiRvXitpXiZaXiZGXiMqXiEvXih5XiEi",
      "byte_length": 90
    },
    {
      "unit_id": "DLG_765fc3a9a195",
      "text": "行動敏捷，沒錯！但應該迅速行動去締結這場同盟，並全力備戰！",
      "encoded_ascii": "^(;^\"%^//^/.^*A^%\\^)5^*W^!I^0`^(M^(j^(u^(;^\"%^\"6^?6^'@^(s^\"n^\"E^-0^*A^!+^!h^!~^+\"^$(^*W",
      "encoded_base64": "Xig7XiIlXi8vXi8uXipBXiVcXik1XipXXiFJXjBgXihNXihqXih1Xig7XiIlXiI2Xj82XidAXihzXiJuXiJFXi0wXipBXiErXiFoXiF+XisiXiQoXipX",
      "byte_length": 87
    },
    {
      "unit_id": "DLG_fa6dbc5a526c",
      "text": "提奎茲爾並非富庶的村落，但我們會竭盡所能為你們提供一切支持。",
      "encoded_ascii": "^$A^5B^/D^&/^!+^)i^3C^?a^&Z^$z^-`^*A^!I^$%^*{^$r^29^-1^$)^'b^%{^*F^*{^$A^!P^!%^+.^$L^$7^!\"",
      "encoded_base64": "XiRBXjVCXi9EXiYvXiErXilpXjNDXj9hXiZaXiR6Xi1gXipBXiFJXiQlXip7XiRyXjI5Xi0xXiQpXidiXiV7XipGXip7XiRBXiFQXiElXisuXiRMXiQ3XiEi",
      "byte_length": 90
    },
    {
      "unit_id": "DLG_c42da2ae41ed",
      "text": "太好了！這是我們很久以來聽到的最好的好消息！",
      "encoded_ascii": "^+f^+i^*D^*W^(s^,X^$%^*{^*K^!.^!B^!O^-X^!u^&Z^$q^+i^&Z^+i^%k^#w^*W",
      "encoded_base64": "XitmXitpXipEXipXXihzXixYXiQlXip7XipLXiEuXiFCXiFPXi1YXiF1XiZaXiRxXitpXiZaXitpXiVrXiN3XipX",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_439371e0bb0e",
      "text": "你們務必要去拜訪那位預言者。他會為你們的使命提供助力。 ",
      "encoded_ascii": "^*F^*{^+4^#l^(C^\"6^,E^4d^)!^!J^.E^1Y^'V^!\"^!@^$r^%{^*F^*{^&Z^!N^\"N^$A^!P^\"#^!~^!\" ",
      "encoded_base64": "XipGXip7Xis0XiNsXihDXiI2XixFXjRkXikhXiFKXi5FXjFZXidWXiEiXiFAXiRyXiV7XipGXip7XiZaXiFOXiJOXiRBXiFQXiIjXiF+XiEiIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_b43df22febee",
      "text": "你們也會在自己的住所裡找到贈禮——就是東南方的那第二間屋子。",
      "encoded_ascii": "^*F^*{^!1^$r^\"d^'l^#I^&Z^*z^$)^-j^$/^!u^([^-8^*n^*n^*J^,X^,`^\"/^$]^&Z^)!^',^!5^)G^8y^#(^!\"",
      "encoded_base64": "XipGXip7XiExXiRyXiJkXidsXiNJXiZaXip6XiQpXi1qXiQvXiF1XihbXi04XipuXipuXipKXixYXixgXiIvXiRdXiZaXikhXicsXiE1XilHXjh5XiMoXiEi",
      "byte_length": 90
    },
    {
      "unit_id": "DLG_818f4fc7f6e3",
      "text": "  你們能提供什麼樣的援助？",
      "encoded_ascii": "  ^*F^*{^'b^$A^!P^!=^.T^,f^&Z^$C^\"#^.V",
      "encoded_base64": "ICBeKkZeKnteJ2JeJEFeIVBeIT1eLlReLGZeJlpeJENeIiNeLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_99a00f5c66fc",
      "text": "  我們這就立刻出發。告辭。",
      "encoded_ascii": "  ^$%^*{^(s^*J^0'^.Y^!q^&W^!\"^+B^2M^!\"",
      "encoded_base64": "ICBeJCVeKnteKHNeKkpeMCdeLlleIXFeJldeISJeK0JeMk1eISI=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_96d0a774e2a0",
      "text": "那是當然，我會把我所知道的一切都毫無保留地告訴你們。",
      "encoded_ascii": "^)!^,X^&N^&\"^*A^$%^$r^$1^$%^$)^&h^(y^&Z^!%^+.^)$^/t^%}^!T^-+^\"e^+B^-t^*F^*{^!\"",
      "encoded_base64": "XikhXixYXiZOXiYiXipBXiQlXiRyXiQxXiQlXiQpXiZoXih5XiZaXiElXisuXikkXi90XiV9XiFUXi0rXiJlXitCXi10XipGXip7XiEi",
      "byte_length": 78
    },
    {
      "unit_id": "DLG_f30b0ead9799",
      "text": "在你們四處聯絡盟友之際，我們會盡力收集有關德拉吉大軍動向的情報； ",
      "encoded_ascii": "^\"d^*F^*{^\"[^(,^-V^-J^-0^\"8^!/^30^*A^$%^*{^$r^-1^!~^$M^)]^$s^.>^#j^$6^\"D^\"z^..^\"%^+?^&Z^,0^+`^*C ",
      "encoded_base64": "XiJkXipGXip7XiJbXigsXi1WXi1KXi0wXiI4XiEvXjMwXipBXiQlXip7XiRyXi0xXiF+XiRNXildXiRzXi4+XiNqXiQ2XiJEXiJ6Xi4uXiIlXis/XiZaXiwwXitgXipDIA==",
      "byte_length": 97
    },
    {
      "unit_id": "DLG_313d96daf5a2",
      "text": "當然，我們也會為你們拉攏過來的盟軍提供住處與糧草。",
      "encoded_ascii": "^&N^&\"^*A^$%^*{^!1^$r^%{^*F^*{^$6^=V^(x^!O^&Z^-0^..^$A^!P^*z^(,^'p^5s^*f^!\"",
      "encoded_base64": "XiZOXiYiXipBXiQlXip7XiExXiRyXiV7XipGXip7XiQ2Xj1WXih4XiFPXiZaXi0wXi4uXiRBXiFQXip6XigsXidwXjVzXipmXiEi",
      "byte_length": 75
    },
    {
      "unit_id": "DLG_dcfc4b8ad8a6",
      "text": "如果你們想單獨與我或我的副官私下交談，我們就住在這座議事大廳兩側的屋舍裡。 ",
      "encoded_ascii": "^#$^%!^*F^*{^,1^2a^/z^'p^$%^$'^$%^&Z^52^#-^&~^!(^0P^0;^*A^$%^*{^*J^*z^\"d^(s^/_^-|^*r^\"z^0\\^!i^!\\^&Z^8y^03^-j^!\" ",
      "encoded_base64": "XiMkXiUhXipGXip7XiwxXjJhXi96XidwXiQlXiQnXiQlXiZaXjUyXiMtXiZ+XiEoXjBQXjA7XipBXiQlXip7XipKXip6XiJkXihzXi9fXi18XipyXiJ6XjBcXiFpXiFcXiZaXjh5XjAzXi1qXiEiIA==",
      "byte_length": 112
    },
    {
      "unit_id": "DLG_39292769f548",
      "text": "議會將照料你們的一切需求，並在每締結一處同盟時給予你們豐厚的酬賞。",
      "encoded_ascii": "^-|^$r^#7^/x^/n^*F^*{^&Z^!%^+.^)e^,n^*A^!+^\"d^%P^?6^'@^!%^(,^\"E^-0^$f^'A^!4^*F^*{^4!^\"4^&Z^7o^*T^!\"",
      "encoded_base64": "Xi18XiRyXiM3Xi94Xi9uXipGXip7XiZaXiElXisuXillXixuXipBXiErXiJkXiVQXj82XidAXiElXigsXiJFXi0wXiRmXidBXiE0XipGXip7XjQhXiI0XiZaXjdvXipUXiEi",
      "byte_length": 99
    },
    {
      "unit_id": "DLG_61aca7a1ff87",
      "text": "祝你們好運！",
      "encoded_ascii": "^&v^*F^*{^+i^.4^*W",
      "encoded_base64": "XiZ2XipGXip7XitpXi40XipX",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_e709059f4aa3",
      "text": "  你為何一直打斷查爾的話？",
      "encoded_ascii": "  ^*F^%{^!L^!%^&`^$-^,T^%&^&/^&Z^-v^.V",
      "encoded_base64": "ICBeKkZeJXteIUxeISVeJmBeJC1eLFReJSZeJi9eJlpeLXZeLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_04be5dad59db",
      "text": "  我跟查爾說話的時候，你給我把嘴閉上！",
      "encoded_ascii": "  ^$%^.+^%&^&/^-x^-v^&Z^$f^*|^*A^*F^'A^$%^$1^+[^.=^!'^*W",
      "encoded_base64": "ICBeJCVeLiteJSZeJi9eLXheLXZeJlpeJGZeKnxeKkFeKkZeJ0FeJCVeJDFeK1teLj1eISdeKlc=",
      "byte_length": 56
    },
    {
      "unit_id": "DLG_34a7879f3210",
      "text": "我是奎林，提奎茲爾的首席副官。",
      "encoded_ascii": "^$%^,X^5B^/1^*A^$A^5B^/D^&/^&Z^)~^0X^52^#-^!\"",
      "encoded_base64": "XiQlXixYXjVCXi8xXipBXiRBXjVCXi9EXiYvXiZaXil+XjBYXjUyXiMtXiEi",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_fdad810651df",
      "text": "儘管查爾是我們的領袖，但村子裡並不是所有人都贊同他的想法。 ",
      "encoded_ascii": "^+(^-D^%&^&/^,X^$%^*{^&Z^)s^7G^*A^!I^$z^#(^-j^!+^!)^,X^$)^$s^!<^)$^>K^\"E^!@^&Z^,1^%b^!\" ",
      "encoded_base64": "XisoXi1EXiUmXiYvXixYXiQlXip7XiZaXilzXjdHXipBXiFJXiR6XiMoXi1qXiErXiEpXixYXiQpXiRzXiE8XikkXj5LXiJFXiFAXiZaXiwxXiViXiEiIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_6d2394ffcfdb",
      "text": "我只不過是替那些持反對意見的人發出聲音罷了。",
      "encoded_ascii": "^$%^\"?^!)^(x^,X^2o^)!^!8^$7^\"9^#:^#z^-m^&Z^!<^&W^!q^-W^34^1Q^*D^!\"",
      "encoded_base64": "XiQlXiI/XiEpXih4XixYXjJvXikhXiE4XiQ3XiI5XiM6XiN6Xi1tXiZaXiE8XiZXXiFxXi1XXjM0XjFRXipEXiEi",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_fb763659692d",
      "text": "奎林嘴裡含糊不清地嘟囔著，一邊狠狠瞪著你們，一邊退讓給查爾說話。",
      "encoded_ascii": "^5B^/1^+[^-j^\"I^'8^!)^,u^\"e^=l^?_^-a^*A^!%^.8^4T^4T^:V^-a^*F^*{^*A^!%^.8^*V^-}^'A^%&^&/^-x^-v^!\"",
      "encoded_base64": "XjVCXi8xXitbXi1qXiJJXic4XiEpXix1XiJlXj1sXj9fXi1hXipBXiElXi44XjRUXjRUXjpWXi1hXipGXip7XipBXiElXi44XipWXi19XidBXiUmXiYvXi14Xi12XiEi",
      "byte_length": 96
    },
    {
      "unit_id": "DLG_aef11ea80906",
      "text": "我們也不清楚。各個村落大多各自為政。也許你們可以試著去 ",
      "encoded_ascii": "^$%^*{^!1^!)^,u^,c^!\"^+>^!V^$z^-`^\"z^\"x^+>^'l^%{^,P^!\"^!1^-s^*F^*{^\"A^!B^-u^-a^\"6 ",
      "encoded_base64": "XiQlXip7XiExXiEpXix1XixjXiEiXis+XiFWXiR6Xi1gXiJ6XiJ4Xis+XidsXiV7XixQXiEiXiExXi1zXipGXip7XiJBXiFCXi11Xi1hXiI2IA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_e27c188e9439",
      "text": "更靠近德拉吉的地方。",
      "encoded_ascii": "^$o^.C^(l^#j^$6^\"D^&Z^\"e^$]^!\"",
      "encoded_base64": "XiRvXi5DXihsXiNqXiQ2XiJEXiZaXiJlXiRdXiEi",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_72f702a7e73b",
      "text": "西方。",
      "encoded_ascii": "^-l^$]^!\"",
      "encoded_base64": "Xi1sXiRdXiEi",
      "byte_length": 9
    },
    {
      "unit_id": "DLG_7c34be125b07",
      "text": "找找商隊。他們消息靈通。我聽說北方有一支商隊。",
      "encoded_ascii": "^$/^$/^1'^)U^!\"^!@^*{^%k^#w^)g^(t^!\"^$%^-X^-x^+6^$]^$s^!%^$L^1'^)U^!\"",
      "encoded_base64": "XiQvXiQvXjEnXilVXiEiXiFAXip7XiVrXiN3XilnXih0XiEiXiQlXi1YXi14Xis2XiRdXiRzXiElXiRMXjEnXilVXiEi",
      "byte_length": 69
    },
    {
      "unit_id": "DLG_397f5cd3cace",
      "text": "你們必須前往其他村莊，說服他們的領袖與我們結成同盟。",
      "encoded_ascii": "^*F^*{^#l^)r^!z^,)^!j^!@^$z^6l^*A^-x^,\\^!@^*{^&Z^)s^7G^'p^$%^*{^'@^$$^\"E^-0^!\"",
      "encoded_base64": "XipGXip7XiNsXilyXiF6XiwpXiFqXiFAXiR6XjZsXipBXi14XixcXiFAXip7XiZaXilzXjdHXidwXiQlXip7XidAXiQkXiJFXi0wXiEi",
      "byte_length": 78
    },
    {
      "unit_id": "DLG_59321b113385",
      "text": "很高興見到你們。",
      "encoded_ascii": "^*K^*+^-]^-m^!u^*F^*{^!\"",
      "encoded_base64": "XipLXiorXi1dXi1tXiF1XipGXip7XiEi",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_4562cc408a6d",
      "text": "歡迎歸來，尊貴的英雄們。 ",
      "encoded_ascii": "^%F^(k^%K^!O^*A^+u^2F^&Z^'y^)\\^*{^!\" ",
      "encoded_base64": "XiVGXihrXiVLXiFPXipBXit1XjJGXiZaXid5XilcXip7XiEiIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_a3fb963c42a0",
      "text": "塞德里爾特傳來了消息，他們願意加入同盟。",
      "encoded_ascii": "^/(^#j^)(^&/^&5^+$^!O^*D^%k^#w^*A^!@^*{^.H^#z^\"\"^!f^\"E^-0^!\"",
      "encoded_base64": "Xi8oXiNqXikoXiYvXiY1XiskXiFPXipEXiVrXiN3XipBXiFAXip7Xi5IXiN6XiIiXiFmXiJFXi0wXiEi",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_6645b811bc35",
      "text": " 蓋德隆也派來了戰士。",
      "encoded_ascii": " ^-d^#j^)T^!1^.n^!O^*D^$(^+a^!\"",
      "encoded_base64": "IF4tZF4jal4pVF4hMV4ubl4hT14qRF4kKF4rYV4hIg==",
      "byte_length": 31
    },
    {
      "unit_id": "DLG_233efdfff4d4",
      "text": "來自蓋德隆的信使已許諾，全力支持我們 ",
      "encoded_ascii": "^!O^'l^-d^#j^)T^&Z^!U^!N^#J^-s^7k^*A^!h^!~^$L^$7^$%^*{ ",
      "encoded_base64": "XiFPXidsXi1kXiNqXilUXiZaXiFVXiFOXiNKXi1zXjdrXipBXiFoXiF+XiRMXiQ3XiQlXip7IA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_10ba98f04dec",
      "text": "對抗德拉吉的戰事。",
      "encoded_ascii": "^#:^$4^#j^$6^\"D^&Z^$(^*r^!\"",
      "encoded_base64": "XiM6XiQ0XiNqXiQ2XiJEXiZaXiQoXipyXiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_158b86364514",
      "text": " 我們對你們的信任果然沒有白費，一份豐厚的酬賞 ",
      "encoded_ascii": " ^$%^*{^#:^*F^*{^&Z^!U^!C^%!^&\"^%\\^$s^&X^.\"^*A^!%^*x^4!^\"4^&Z^7o^*T ",
      "encoded_base64": "IF4kJV4qe14jOl4qRl4qe14mWl4hVV4hQ14lIV4mIl4lXF4kc14mWF4uIl4qQV4hJV4qeF40IV4iNF4mWl43b14qVCA=",
      "byte_length": 68
    },
    {
      "unit_id": "DLG_e0c88d0f4f9d",
      "text": "已在你們的草屋中等候著你們了。",
      "encoded_ascii": "^#J^\"d^*F^*{^&Z^*f^8y^!,^'-^*|^-a^*F^*{^*D^!\"",
      "encoded_base64": "XiNKXiJkXipGXip7XiZaXipmXjh5XiEsXictXip8Xi1hXipGXip7XipEXiEi",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_8ca700a10285",
      "text": "現在，去吧",
      "encoded_ascii": "^&?^\"d^*A^\"6^*I",
      "encoded_base64": "XiY/XiJkXipBXiI2XipJ",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_648ea85c25a7",
      "text": "向你們致敬，我的好朋友們！",
      "encoded_ascii": "^+?^*F^*{^'o^*O^*A^$%^&Z^+i^,[^\"8^*{^*W",
      "encoded_base64": "Xis/XipGXip7XidvXipPXipBXiQlXiZaXitpXixbXiI4Xip7XipX",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_4bc39b272935",
      "text": "想看看弓箭補給品嗎？",
      "encoded_ascii": "^,1^*Q^*Q^#Y^'.^6&^'A^\"R^+X^.V",
      "encoded_base64": "XiwxXipRXipRXiNZXicuXjYmXidBXiJSXitYXi5W",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_999b21e93dda",
      "text": "  好啊，把你的貨物拿給我瞧瞧。",
      "encoded_ascii": "  ^+i^+Q^*A^$1^*F^&Z^.w^&4^,G^'A^$%^-4^-4^!\"",
      "encoded_base64": "ICBeK2leK1FeKkFeJDFeKkZeJlpeLndeJjReLEdeJ0FeJCVeLTReLTReISI=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_e86c2d8777d0",
      "text": "  不用了，我不需要任何裝備。",
      "encoded_ascii": "  ^!)^&H^*D^*A^$%^!)^)e^(C^!C^!L^(A^+\"^!\"",
      "encoded_base64": "ICBeISleJkheKkReKkFeJCVeISleKWVeKENeIUNeIUxeKEFeKyJeISI=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_d76dcf968f64",
      "text": "  你為什麼不肯賣東西給我？",
      "encoded_ascii": "  ^*F^%{^!=^.T^!)^-Z^.$^,`^-l^'A^$%^.V",
      "encoded_base64": "ICBeKkZeJXteIT1eLlReISleLVpeLiReLGBeLWxeJ0FeJCVeLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_1ed3559f8c01",
      "text": "  奎利鳥的羽毛有何特別之處？",
      "encoded_ascii": "  ^5B^!t^4p^&Z^'S^%R^$s^!L^&5^*H^!/^(,^.V",
      "encoded_base64": "ICBeNUJeIXReNHBeJlpeJ1NeJVJeJHNeIUxeJjVeKkheIS9eKCxeLlY=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_1fd1c52afb4f",
      "text": "  你是從哪裡弄到奎利鳥羽毛的？",
      "encoded_ascii": "  ^*F^,X^#f^+I^-j^/`^!u^5B^!t^4p^'S^%R^&Z^.V",
      "encoded_base64": "ICBeKkZeLFheI2ZeK0leLWpeL2BeIXVeNUJeIXReNHBeJ1NeJVJeJlpeLlY=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_3e84c69ee4a5",
      "text": "  那邊那是你的箭術靶子嗎？",
      "encoded_ascii": "  ^)!^.8^)!^,X^*F^&Z^'.^(<^)l^#(^+X^.V",
      "encoded_base64": "ICBeKSFeLjheKSFeLFheKkZeJlpeJy5eKDxeKWxeIyheK1heLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_ace707caa88e",
      "text": " 恕我失陪，我還有一些 ",
      "encoded_ascii": " ^3q^$%^\"|^8.^*A^$%^.7^$s^!%^!8 ",
      "encoded_base64": "IF4zcV4kJV4ifF44Ll4qQV4kJV4uN14kc14hJV4hOCA=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_9b10e87d933a",
      "text": "弓弦需要更換。 ",
      "encoded_ascii": "^#Y^?n^)e^(C^$o^4@^!\" ",
      "encoded_base64": "XiNZXj9uXillXihDXiRvXjRAXiEiIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_258c879a06cd",
      "text": "箭羽需要黏製。 ",
      "encoded_ascii": "^'.^'S^)e^(C^*9^(B^!\" ",
      "encoded_base64": "XicuXidTXillXihDXio5XihCXiEiIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_274f8647a1e8",
      "text": "我可以把貨物賣給你們，但你們千萬不能讓議會知道。 ",
      "encoded_ascii": "^$%^\"A^!B^$1^.w^&4^.$^'A^*F^*{^*A^!I^*F^*{^+7^-_^!)^'b^-}^-|^$r^&h^(y^!\" ",
      "encoded_base64": "XiQlXiJBXiFCXiQxXi53XiY0Xi4kXidBXipGXip7XipBXiFJXipGXip7Xis3Xi1fXiEpXidiXi19Xi18XiRyXiZoXih5XiEiIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_d189007fcd8b",
      "text": "拿去吧，隨你們怎麼檢查都行；你們在任何地方都找不到 ",
      "encoded_ascii": "^,G^\"6^*I^*A^)X^*F^*{^,,^.T^%?^%&^)$^(;^*C^*F^*{^\"d^!C^!L^\"e^$]^)$^$/^!)^!u ",
      "encoded_base64": "XixHXiI2XipJXipBXilYXipGXip7XiwsXi5UXiU/XiUmXikkXig7XipDXipGXip7XiJkXiFDXiFMXiJlXiRdXikkXiQvXiEpXiF1IA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_a35527116be2",
      "text": "射速更快的弓了，這比單純增加拉力更能提升你的射程。",
      "encoded_ascii": "^#6^(u^$o^*L^&Z^#Y^*D^*A^(s^,m^2a^3\"^\"s^\"\"^$6^!~^$o^'b^$A^\",^*F^&Z^#6^'#^!\"",
      "encoded_base64": "XiM2Xih1XiRvXipMXiZaXiNZXipEXipBXihzXixtXjJhXjMiXiJzXiIiXiQ2XiF+XiRvXidiXiRBXiIsXipGXiZaXiM2XicjXiEi",
      "byte_length": 75
    },
    {
      "unit_id": "DLG_31cfce501627",
      "text": "更精準的箭矢了，這全是用奎利鳥的羽毛精心黏製的。",
      "encoded_ascii": "^$o^'7^,x^&Z^'.^&g^*D^*A^(s^!h^,X^&H^5B^!t^4p^&Z^'S^%R^'7^#k^*9^(B^&Z^!\"",
      "encoded_base64": "XiRvXic3Xix4XiZaXicuXiZnXipEXipBXihzXiFoXixYXiZIXjVCXiF0XjRwXiZaXidTXiVSXic3XiNrXio5XihCXiZaXiEi",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_d8795a892c24",
      "text": "弓臂更強韌的弓了，而且我的弓絕不會有震手困擾。",
      "encoded_ascii": "^#Y^'k^$o^#]^)n^&Z^#Y^*D^*A^'W^!*^$%^&Z^#Y^-I^!)^$r^$s^32^$+^\"^^$K^!\"",
      "encoded_base64": "XiNZXidrXiRvXiNdXiluXiZaXiNZXipEXipBXidXXiEqXiQlXiZaXiNZXi1JXiEpXiRyXiRzXjMyXiQrXiJeXiRLXiEi",
      "byte_length": 69
    },
    {
      "unit_id": "DLG_431cbd39f264",
      "text": "全是因為那則預言。如果你真想知道原因，就去問問議會吧。 ",
      "encoded_ascii": "^!h^,X^\"]^%{^)!^!x^.E^1Y^!\"^#$^%!^*F^-2^,1^&h^(y^\"5^\"]^*A^*J^\"6^*Z^*Z^-|^$r^*I^!\" ",
      "encoded_base64": "XiFoXixYXiJdXiV7XikhXiF4Xi5FXjFZXiEiXiMkXiUhXipGXi0yXiwxXiZoXih5XiI1XiJdXipBXipKXiI2XipaXipaXi18XiRyXipJXiEiIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_29c2b09cef05",
      "text": "我才不信那些鬼話胡扯。",
      "encoded_ascii": "^$%^$,^!)^!U^)!^!8^*-^-v^3}^.e^!\"",
      "encoded_base64": "XiQlXiQsXiEpXiFVXikhXiE4XiotXi12XjN9Xi5lXiEi",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_1aa38533b832",
      "text": "那就改天再說吧。",
      "encoded_ascii": "^)!^*J^$N^+e^!l^-x^*I^!\"",
      "encoded_base64": "XikhXipKXiROXitlXiFsXi14XipJXiEi",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_726074708ac5",
      "text": "提奎茲爾正西方就有許多牠們的巢穴。",
      "encoded_ascii": "^$A^5B^/D^&/^%H^-l^$]^*J^$s^-s^\"x^-#^*{^&Z^#G^'&^!\"",
      "encoded_base64": "XiRBXjVCXi9EXiYvXiVIXi1sXiRdXipKXiRzXi1zXiJ4Xi0jXip7XiZaXiNHXicmXiEi",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_19259fa4f6c2",
      "text": "這種鳥的羽毛會分泌出一種油脂。能防止箭羽 ",
      "encoded_ascii": "^(s^'$^4p^&Z^'S^%R^$r^!s^>[^!q^!%^'$^%^^;6^!\"^'b^)K^%G^'.^'S ",
      "encoded_base64": "XihzXickXjRwXiZaXidTXiVSXiRyXiFzXj5bXiFxXiElXickXiVeXjs2XiEiXidiXilLXiVHXicuXidTIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_471c8ec7a184",
      "text": "磨損分岔，並確保你的箭矢不會偏離目標。",
      "encoded_ascii": "^-7^$D^!s^3m^*A^!+^-6^!T^*F^&Z^'.^&g^!)^$r^![^)`^&^^%9^!\"",
      "encoded_base64": "Xi03XiREXiFzXjNtXipBXiErXi02XiFUXipGXiZaXicuXiZnXiEpXiRyXiFbXilgXiZeXiU5XiEi",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_8a4b42c35b24",
      "text": "沒錯，我立在那裡好讓客人們能親自檢驗我貨物的品質 ",
      "encoded_ascii": "^%\\^)5^*A^$%^0'^\"d^)!^-j^+i^-}^+q^!<^*{^'b^(F^'l^%?^.P^$%^.w^&4^&Z^\"R^(Z ",
      "encoded_base64": "XiVcXik1XipBXiQlXjAnXiJkXikhXi1qXitpXi19XitxXiE8Xip7XidiXihGXidsXiU/Xi5QXiQlXi53XiY0XiZaXiJSXihaIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_cf860807ec3c",
      "text": "優劣。歡迎你們隨時去試射。",
      "encoded_ascii": "^+)^+2^!\"^%F^(k^*F^*{^)X^$f^\"6^-u^#6^!\"",
      "encoded_base64": "XispXisyXiEiXiVGXihrXipGXip7XilYXiRmXiI2Xi11XiM2XiEi",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_0a9d88212dab",
      "text": "再會了， ",
      "encoded_ascii": "^!l^$r^*D^*A ",
      "encoded_base64": "XiFsXiRyXipEXipBIA==",
      "byte_length": 13
    },
    {
      "unit_id": "DLG_5e15af55bfbb",
      "text": "多謝惠顧。",
      "encoded_ascii": "^\"x^-z^6Z^4n^!\"",
      "encoded_base64": "XiJ4Xi16XjZaXjRuXiEi",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_d03a2c43297e",
      "text": "祝你們冒險順利。",
      "encoded_ascii": "^&v^*F^*{^/P^*m^.D^!t^!\"",
      "encoded_base64": "XiZ2XipGXip7Xi9QXiptXi5EXiF0XiEi",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_a0b50d43fb79",
      "text": "日安。有什麼我能為你們效勞的？",
      "encoded_ascii": "^$a^+p^!\"^$s^!=^.T^$%^'b^%{^*F^*{^$Q^/R^&Z^.V",
      "encoded_base64": "XiRhXitwXiEiXiRzXiE9Xi5UXiQlXidiXiV7XipGXip7XiRRXi9SXiZaXi5W",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_c82a96cf444f",
      "text": "  你在說什麼戰爭？",
      "encoded_ascii": "  ^*F^\"d^-x^!=^.T^$(^1I^.V",
      "encoded_base64": "ICBeKkZeImReLXheIT1eLlReJCheMUleLlY=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_07a4401e5f2f",
      "text": "  我該去哪裡找你們的領袖？",
      "encoded_ascii": "  ^$%^(M^\"6^+I^-j^$/^*F^*{^&Z^)s^7G^.V",
      "encoded_base64": "ICBeJCVeKE1eIjZeK0leLWpeJC9eKkZeKnteJlpeKXNeN0deLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_b88472b199dd",
      "text": "  跟我說說你的生意吧。",
      "encoded_ascii": "  ^.+^$%^-x^-x^*F^&Z^&F^#z^*I^!\"",
      "encoded_base64": "ICBeLiteJCVeLXheLXheKkZeJlpeJkZeI3peKkleISI=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_9c4cfa4d0c48",
      "text": " 現在請恕我失陪，我還有很多事情要忙。 ",
      "encoded_ascii": " ^&?^\"d^*S^3q^$%^\"|^8.^*A^$%^.7^$s^*K^\"x^*r^,0^(C^,+^!\" ",
      "encoded_base64": "IF4mP14iZF4qU14zcV4kJV4ifF44Ll4qQV4kJV4uN14kc14qS14ieF4qcl4sMF4oQ14sK14hIiA=",
      "byte_length": 56
    },
    {
      "unit_id": "DLG_8e027d6d3657",
      "text": "這是我的榮幸。",
      "encoded_ascii": "^(s^,X^$%^&Z^,e^15^!\"",
      "encoded_base64": "XihzXixYXiQlXiZaXixlXjE1XiEi",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_71252ebb9573",
      "text": "非常抱歉，但我們村莊的領袖嚴令禁止我出售任何護甲。 ",
      "encoded_ascii": "^)i^#O^,@^,h^*A^!I^$%^*{^$z^6l^&Z^)s^7G^1*^*w^&y^%G^$%^!q^56^!C^!L^(T^&J^!\" ",
      "encoded_base64": "XilpXiNPXixAXixoXipBXiFJXiQlXip7XiR6XjZsXiZaXilzXjdHXjEqXip3XiZ5XiVHXiQlXiFxXjU2XiFDXiFMXihUXiZKXiEiIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_ad43eb089167",
      "text": "戰火的狂風正吹向我們，我們必須全力備戰。",
      "encoded_ascii": "^$(^%x^&Z^&8^)y^%H^+A^+?^$%^*{^*A^$%^*{^#l^)r^!h^!~^+\"^$(^!\"",
      "encoded_base64": "XiQoXiV4XiZaXiY4Xil5XiVIXitBXis/XiQlXip7XipBXiQlXip7XiNsXilyXiFoXiF+XisiXiQoXiEi",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_1de676b522b9",
      "text": "不買也無妨。你們想隨便看看多久都行。",
      "encoded_ascii": "^!)^.!^!1^%}^5D^!\"^*F^*{^,1^)X^!R^*Q^*Q^\"x^!.^)$^(;^!\"",
      "encoded_base64": "XiEpXi4hXiExXiV9XjVEXiEiXipGXip7XiwxXilYXiFSXipRXipRXiJ4XiEuXikkXig7XiEi",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_b47440172abc",
      "text": "戰火將吞噬所有的村落。這是那位預言者說的。你們最好 ",
      "encoded_ascii": "^$(^%x^#7^:-^:0^$)^$s^&Z^$z^-`^!\"^(s^,X^)!^!J^.E^1Y^'V^-x^&Z^!\"^*F^*{^$q^+i ",
      "encoded_base64": "XiQoXiV4XiM3XjotXjowXiQpXiRzXiZaXiR6Xi1gXiEiXihzXixYXikhXiFKXi5FXjFZXidWXi14XiZaXiEiXipGXip7XiRxXitpIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_eb2887501fd0",
      "text": "去跟我們的領袖談談。即使是像你們這般身經百戰的精悍戰士，也絕不會希望 ",
      "encoded_ascii": "^\"6^.+^$%^*{^&Z^)s^7G^0;^0;^!\"^\"1^!N^,X^!`^*F^*{^(s^'r^(c^'D^&Y^$(^&Z^'7^,-^$(^+a^*A^!1^-I^!)^$r^+{^,] ",
      "encoded_base64": "XiI2Xi4rXiQlXip7XiZaXilzXjdHXjA7XjA7XiEiXiIxXiFOXixYXiFgXipGXip7XihzXidyXihjXidEXiZZXiQoXiZaXic3XiwtXiQoXithXipBXiExXi1JXiEpXiRyXit7XixdIA==",
      "byte_length": 103
    },
    {
      "unit_id": "DLG_0560c6d24388",
      "text": "在戰爭爆發時孤立無援。",
      "encoded_ascii": "^\"d^$(^1I^&*^&W^$f^2c^0'^%}^$C^!\"",
      "encoded_base64": "XiJkXiQoXjFJXiYqXiZXXiRmXjJjXjAnXiV9XiRDXiEi",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_32c0a2b2b4d5",
      "text": "查爾正和長老議會一起在村子北邊的議事大廳裡。",
      "encoded_ascii": "^%&^&/^%H^\"O^)C^'U^-|^$r^!%^.(^\"d^$z^#(^+6^.8^&Z^-|^*r^\"z^0\\^-j^!\"",
      "encoded_base64": "XiUmXiYvXiVIXiJPXilDXidVXi18XiRyXiElXi4oXiJkXiR6XiMoXis2Xi44XiZaXi18XipyXiJ6XjBcXi1qXiEi",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_53fb51be7a40",
      "text": "我從來沒這麼忙碌過。人人都需要護甲備戰，而時間根本 ",
      "encoded_ascii": "^$%^#f^!O^%\\^(s^.T^,+^<y^(x^!\"^!<^!<^)$^)e^(C^(T^&J^+\"^$(^*A^'W^$f^)G^%)^$x ",
      "encoded_base64": "XiQlXiNmXiFPXiVcXihzXi5UXiwrXjx5Xih4XiEiXiE8XiE8XikkXillXihDXihUXiZKXisiXiQoXipBXidXXiRmXilHXiUpXiR4IA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_20621c476abb",
      "text": "不夠用。如果你們需要的話，可以隨意使用鐵匠鋪的鍛造爐。 ",
      "encoded_ascii": "^!)^+d^&H^!\"^#$^%!^*F^*{^)e^(C^&Z^-v^*A^\"A^!B^)X^#z^!N^&H^)?^7S^<1^&Z^1c^(v^&,^!\" ",
      "encoded_base64": "XiEpXitkXiZIXiEiXiMkXiUhXipGXip7XillXihDXiZaXi12XipBXiJBXiFCXilYXiN6XiFOXiZIXik/XjdTXjwxXiZaXjFjXih2XiYsXiEiIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_94efb7a3d245",
      "text": "我現在實在太忙了，沒法替任何人量身定製。",
      "encoded_ascii": "^$%^&?^\"d^#3^\"d^+f^,+^*D^*A^%\\^%b^2o^!C^!L^!<^)*^(c^#.^(B^!\"",
      "encoded_base64": "XiQlXiY/XiJkXiMzXiJkXitmXiwrXipEXipBXiVcXiViXjJvXiFDXiFMXiE8XikqXihjXiMuXihCXiEi",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_fc08f85cfc3d",
      "text": "你們好。很高興你們能光顧我這裡。",
      "encoded_ascii": "^*F^*{^+i^!\"^*K^*+^-]^*F^*{^'b^!c^4n^$%^(s^-j^!\"",
      "encoded_base64": "XipGXip7XitpXiEiXipLXiorXi1dXipGXip7XidiXiFjXjRuXiQlXihzXi1qXiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_14c82a53a234",
      "text": "啊，你們就是查爾說過會來的那群戰士嗎？",
      "encoded_ascii": "^+Q^*A^*F^*{^*J^,X^%&^&/^-x^(x^$r^!O^&Z^)!^'R^$(^+a^+X^.V",
      "encoded_base64": "XitRXipBXipGXip7XipKXixYXiUmXiYvXi14Xih4XiRyXiFPXiZaXikhXidSXiQoXithXitYXi5W",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_a33e40a1c598",
      "text": "這真是個好消息。想必你們一定希望為自己英勇的使命購置精良裝備吧。",
      "encoded_ascii": "^(s^-2^,X^!V^+i^%k^#w^!\"^,1^#l^*F^*{^!%^#.^+{^,]^%{^'l^#I^'y^\"$^&Z^!N^\"N^63^'Q^'7^1V^(A^+\"^*I^!\"",
      "encoded_base64": "XihzXi0yXixYXiFWXitpXiVrXiN3XiEiXiwxXiNsXipGXip7XiElXiMuXit7XixdXiV7XidsXiNJXid5XiIkXiZaXiFOXiJOXjYzXidRXic3XjFWXihBXisiXipJXiEi",
      "byte_length": 96
    },
    {
      "unit_id": "DLG_d581034d876d",
      "text": "非常抱歉。你們必須獲得長老議會的許可才能購買 ",
      "encoded_ascii": "^)i^#O^,@^,h^!\"^*F^*{^#l^)r^&:^#e^)C^'U^-|^$r^&Z^-s^\"A^$,^'b^63^.! ",
      "encoded_base64": "XilpXiNPXixAXixoXiEiXipGXip7XiNsXilyXiY6XiNlXilDXidVXi18XiRyXiZaXi1zXiJBXiQsXidiXjYzXi4hIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_182786c09701",
      "text": "任何兵器。我們正在全力備戰，無法將武器分給一般的 ",
      "encoded_ascii": "^!C^!L^+,^\"V^!\"^$%^*{^%H^\"d^!h^!~^+\"^$(^*A^%}^%b^#7^%J^\"V^!s^'A^!%^'r^&Z ",
      "encoded_base64": "XiFDXiFMXissXiJWXiEiXiQlXip7XiVIXiJkXiFoXiF+XisiXiQoXipBXiV9XiViXiM3XiVKXiJWXiFzXidBXiElXidyXiZaIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_b3b4a4694cf8",
      "text": "訪客。議會就在北邊的議事大廳裡。",
      "encoded_ascii": "^4d^+q^!\"^-|^$r^*J^\"d^+6^.8^&Z^-|^*r^\"z^0\\^-j^!\"",
      "encoded_base64": "XjRkXitxXiEiXi18XiRyXipKXiJkXis2Xi44XiZaXi18XipyXiJ6XjBcXi1qXiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_6a1430f87ac1",
      "text": " 我這裡庫存有各式各樣的兵刃。我相信你們一定能挑選到合心意的武器。",
      "encoded_ascii": " ^$%^(s^-j^,#^#*^$s^+>^#X^+>^,f^&Z^+,^!r^!\"^$%^&a^!U^*F^*{^!%^#.^'b^,H^.6^!u^\"C^#k^#z^&Z^%J^\"V^!\"",
      "encoded_base64": "IF4kJV4oc14tal4sI14jKl4kc14rPl4jWF4rPl4sZl4mWl4rLF4hcl4hIl4kJV4mYV4hVV4qRl4qe14hJV4jLl4nYl4sSF4uNl4hdV4iQ14ja14jel4mWl4lSl4iVl4hIg==",
      "byte_length": 97
    },
    {
      "unit_id": "DLG_6fba175ba147",
      "text": "請收好您的貨物，它一定會為您立下汗馬功勞。",
      "encoded_ascii": "^*S^$M^+i^4:^&Z^.w^&4^*A^+o^!%^#.^$r^%{^4:^0'^!(^;j^*\"^\"!^/R^!\"",
      "encoded_base64": "XipTXiRNXitpXjQ6XiZaXi53XiY0XipBXitvXiElXiMuXiRyXiV7XjQ6XjAnXiEoXjtqXioiXiIhXi9SXiEi",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_e3699483aef2",
      "text": "日後若是還需要 ",
      "encoded_ascii": "^$a^#b^'x^,X^.7^)e^(C ",
      "encoded_base64": "XiRhXiNiXid4XixYXi43XillXihDIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_fa3835b66b3c",
      "text": "弓箭補給，請記得找我。",
      "encoded_ascii": "^#Y^'.^6&^'A^*A^*S^(K^#e^$/^$%^!\"",
      "encoded_base64": "XiNZXicuXjYmXidBXipBXipTXihLXiNlXiQvXiQlXiEi",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_6f41142de949",
      "text": "護甲，請記得找我。",
      "encoded_ascii": "^(T^&J^*A^*S^(K^#e^$/^$%^!\"",
      "encoded_base64": "XihUXiZKXipBXipTXihLXiNlXiQvXiQlXiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_4b33fdd150a3",
      "text": "兵器，請記得找我。",
      "encoded_ascii": "^+,^\"V^*A^*S^(K^#e^$/^$%^!\"",
      "encoded_base64": "XissXiJWXipBXipTXihLXiNlXiQvXiQlXiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_a696d73a32cf",
      "text": "滾回德拉吉去，你這卑鄙的蛇蜥賤種！那裡才是殺人劊子手該呆的地方！",
      "encoded_ascii": "^,z^\"\\^#j^$6^\"D^\"6^*A^*F^(s^\".^8,^&Z^(/^(2^2G^'$^*W^)!^-j^$,^,X^%M^!<^?&^#(^$+^(M^;)^&Z^\"e^$]^*W",
      "encoded_base64": "Xix6XiJcXiNqXiQ2XiJEXiI2XipBXipGXihzXiIuXjgsXiZaXigvXigyXjJHXickXipXXikhXi1qXiQsXixYXiVNXiE8Xj8mXiMoXiQrXihNXjspXiZaXiJlXiRdXipX",
      "byte_length": 96
    },
    {
      "unit_id": "DLG_d2a538a3c688",
      "text": "  我的命運究竟如何？",
      "encoded_ascii": "  ^$%^&Z^\"N^.4^-<^28^#$^!L^.V",
      "encoded_base64": "ICBeJCVeJlpeIk5eLjReLTxeMjheIyReIUxeLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_b9b9f353d5e8",
      "text": "  烈日把你的腦子給曬壞了吧！",
      "encoded_ascii": "  ^%|^$a^$1^*F^&Z^2@^#(^'A^,Z^\"v^*D^*I^*W",
      "encoded_base64": "ICBeJXxeJGFeJDFeKkZeJlpeMkBeIyheJ0FeLFpeInZeKkReKkleKlc=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_99253d7b4026",
      "text": "  有人告訴我你會送我一份禮物。",
      "encoded_ascii": "  ^$s^!<^+B^-t^$%^*F^$r^./^$%^!%^*x^-8^&4^!\"",
      "encoded_base64": "ICBeJHNeITxeK0JeLXReJCVeKkZeJHJeLi9eJCVeISVeKnheLTheJjReISI=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_fe4f659f8436",
      "text": "你們斬殺了惡狼，逃脫了牠可怕的魔爪！憑藉著英勇的雙翼， ",
      "encoded_ascii": "^*F^*{^9B^%M^*D^#y^21^*A^(p^'c^*D^-#^\"A^0^^&Z^*0^&.^*W^,5^04^-a^'y^\"$^&Z^)_^'T^*A ",
      "encoded_base64": "XipGXip7XjlCXiVNXipEXiN5XjIxXipBXihwXidjXipEXi0jXiJBXjBeXiZaXiowXiYuXipXXiw1XjA0Xi1hXid5XiIkXiZaXilfXidUXipBIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_8911ae866b07",
      "text": "你們奮勇凌空，粉碎了束縛眾生的沉重枷鎖—— ",
      "encoded_ascii": "^*F^*{^+g^\"$^9R^'(^*A^'5^&o^*D^$|^3W^&e^&F^&Z^%Z^))^2p^)8^*n^*n ",
      "encoded_base64": "XipGXip7XitnXiIkXjlSXicoXipBXic1XiZvXipEXiR8XjNXXiZlXiZGXiZaXiVaXikpXjJwXik4XipuXipuIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_4a9843b8bdb5",
      "text": "唯有極少數人能踏過荒原中那條渺茫狹窄的征程！",
      "encoded_ascii": "^+O^$s^1D^#<^$V^!<^'b^.,^(x^1W^\"5^!,^)!^%.^<n^9L^9#^9&^&Z^.c^'#^*W",
      "encoded_base64": "XitPXiRzXjFEXiM8XiRWXiE8XidiXi4sXih4XjFXXiI1XiEsXikhXiUuXjxuXjlMXjkjXjkmXiZaXi5jXicjXipX",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_7f8ee4caca95",
      "text": "  我該如何使用這根權杖？",
      "encoded_ascii": "  ^$%^(M^#$^!L^!N^&H^(s^%)^1E^${^.V",
      "encoded_base64": "ICBeJCVeKE1eIyReIUxeIU5eJkheKHNeJSleMUVeJHteLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_61f32fd39496",
      "text": "  你能看見我們的未來會如何嗎？",
      "encoded_ascii": "  ^*F^'b^*Q^-m^$%^*{^&Z^,_^!O^$r^#$^!L^+X^.V",
      "encoded_base64": "ICBeKkZeJ2JeKlFeLW1eJCVeKnteJlpeLF9eIU9eJHJeIyReIUxeK1heLlY=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_5f1604063938",
      "text": " 也許在遙遠的異鄉或縹緲的夢境中，我們還會再度相逢。在此之前， ",
      "encoded_ascii": " ^!1^-s^\"d^4j^({^&Z^&M^6<^$'^@%^@$^&Z^\"y^\"q^!,^*A^$%^*{^.7^$r^!l^#V^&a^7K^!\"^\"d^%I^!/^!z^*A ",
      "encoded_base64": "IF4hMV4tc14iZF40al4oe14mWl4mTV42PF4kJ15AJV5AJF4mWl4ieV4icV4hLF4qQV4kJV4qe14uN14kcl4hbF4jVl4mYV43S14hIl4iZF4lSV4hL14hel4qQSA=",
      "byte_length": 92
    },
    {
      "unit_id": "DLG_d0a482f94e27",
      "text": "我祝你們一路順遂。",
      "encoded_ascii": "^$%^&v^*F^*{^!%^(a^.D^;p^!\"",
      "encoded_base64": "XiQlXiZ2XipGXip7XiElXihhXi5EXjtwXiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_27cea2a8183f",
      "text": "你們的雙手沾滿了自掘墳墓的死氣！你們與 ",
      "encoded_ascii": "^*F^*{^&Z^)_^$+^74^,{^*D^'l^=@^:C^6P^&Z^%L^%U^*W^*F^*{^'p ",
      "encoded_base64": "XipGXip7XiZaXilfXiQrXjc0Xix7XipEXidsXj1AXjpDXjZQXiZaXiVMXiVVXipXXipGXip7XidwIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_b194ce3e6a7f",
      "text": "豺狼為伍並襲擊羊群。當心啊！被你們殘殺的正是自己的手足 ",
      "encoded_ascii": "^>/^21^%{^!F^!+^08^$F^8M^'R^!\"^&N^#k^+Q^*W^(@^*F^*{^,l^%M^&Z^%H^,X^'l^#I^&Z^$+^(^ ",
      "encoded_base64": "Xj4vXjIxXiV7XiFGXiErXjA4XiRGXjhNXidSXiEiXiZOXiNrXitRXipXXihAXipGXip7XixsXiVNXiZaXiVIXixYXidsXiNJXiZaXiQrXiheIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_bf966855f512",
      "text": "兄弟",
      "encoded_ascii": "^1!^16",
      "encoded_base64": "XjEhXjE2",
      "byte_length": 6
    },
    {
      "unit_id": "DLG_7590cfaf1d64",
      "text": "姐妹",
      "encoded_ascii": "^?u^;d",
      "encoded_base64": "Xj91Xjtk",
      "byte_length": 6
    },
    {
      "unit_id": "DLG_9f2088a48052",
      "text": "！",
      "encoded_ascii": "^*W",
      "encoded_base64": "XipX",
      "byte_length": 3
    },
    {
      "unit_id": "DLG_78b003b0bb9b",
      "text": "風暴正在匯聚！你們的一隻手緊握著友誼—— ",
      "encoded_ascii": "^)y^$m^%H^\"d^>|^'[^*W^*F^*{^&Z^!%^)[^$+^0r^1>^-a^\"8^=4^*n^*n ",
      "encoded_base64": "Xil5XiRtXiVIXiJkXj58XidbXipXXipGXip7XiZaXiElXilbXiQrXjByXjE+Xi1hXiI4Xj00XipuXipuIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_11fd52b82e5a",
      "text": "另一隻手卻依然空無一物。若未能雙手緊握支撐， ",
      "encoded_ascii": "^\">^!%^)[^$+^1&^!Q^&\"^'(^%}^!%^&4^!\"^'x^,_^'b^)_^$+^0r^1>^$L^,L^*A ",
      "encoded_base64": "XiI+XiElXilbXiQrXjEmXiFRXiYiXicoXiV9XiElXiY0XiEiXid4XixfXidiXilfXiQrXjByXjE+XiRMXixMXipBIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_f01d9c51a647",
      "text": "狂暴的狂風將會把你們的白骨吹蝕殆盡。",
      "encoded_ascii": "^&8^$m^&Z^&8^)y^#7^$r^$1^*F^*{^&Z^&X^*$^+A^(4^8H^-1^!\"",
      "encoded_base64": "XiY4XiRtXiZaXiY4Xil5XiM3XiRyXiQxXipGXip7XiZaXiZYXiokXitBXig0XjhIXi0xXiEi",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_81188ca32f43",
      "text": "過往英雄的幽影啊——我向你們致敬，你們正漫步於 ",
      "encoded_ascii": "^(x^,)^'y^)\\^&Z^2f^#a^+Q^*n^*n^$%^+?^*F^*{^'o^*O^*A^*F^*{^%H^2,^,i^$^ ",
      "encoded_base64": "Xih4XiwpXid5XilcXiZaXjJmXiNhXitRXipuXipuXiQlXis/XipGXip7XidvXipPXipBXipGXip7XiVIXjIsXixpXiReIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_99d9bf9b2a4d",
      "text": "我們卑微的賤民階層之中！",
      "encoded_ascii": "^$%^*{^\".^#i^&Z^2G^%T^=b^#B^!/^!,^*W",
      "encoded_base64": "XiQlXip7XiIuXiNpXiZaXjJHXiVUXj1iXiNCXiEvXiEsXipX",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_a5d206f7b12c",
      "text": "在死亡的伴隨之下，我靜候著鐮刀橫掃，肅清整片大地並收割穀物。 ",
      "encoded_ascii": "^\"d^%L^!:^&Z^1h^)X^!/^!(^*A^$%^)h^*|^-a^@.^7Q^/2^:p^*A^5y^,u^$T^&1^\"z^\"e^!+^$M^+1^'%^&4^!\" ",
      "encoded_base64": "XiJkXiVMXiE6XiZaXjFoXilYXiEvXiEoXipBXiQlXiloXip8Xi1hXkAuXjdRXi8yXjpwXipBXjV5Xix1XiRUXiYxXiJ6XiJlXiErXiRNXisxXiclXiY0XiEiIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_5bde0ac39c52",
      "text": "歡迎！是時候開懷享用了！",
      "encoded_ascii": "^%F^(k^*W^,X^$f^*|^)F^,9^!;^&H^*D^*W",
      "encoded_base64": "XiVGXihrXipXXixYXiRmXip8XilGXiw5XiE7XiZIXipEXipX",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_8a9ebac24afe",
      "text": "致敬！流沙之中的幽影。歲月終將揭曉 ",
      "encoded_ascii": "^'o^*O^*W^%j^%]^!/^!,^&Z^2f^#a^!\"^,j^/p^-H^#7^$B^7y ",
      "encoded_base64": "XidvXipPXipXXiVqXiVdXiEvXiEsXiZaXjJmXiNhXiEiXixqXi9wXi1IXiM3XiRCXjd5IA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_0d40922f449e",
      "text": "命運那錯綜複雜的織錦。",
      "encoded_ascii": "^\"N^.4^)!^)5^5t^6s^0G^&Z^3z^@-^!\"",
      "encoded_base64": "XiJOXi40XikhXik1XjV0XjZzXjBHXiZaXjN6XkAtXiEi",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_99c83c89f418",
      "text": "你們終於來了！我幻象中的幽影化為了血肉之軀。面紗已揭開， ",
      "encoded_ascii": "^*F^*{^-H^$^^!O^*D^*W^$%^#S^4g^!,^&Z^2f^#a^\")^%{^*D^(:^'^^!/^(d^!\"^)j^-G^#J^$B^)F^*A ",
      "encoded_base64": "XipGXip7Xi1IXiReXiFPXipEXipXXiQlXiNTXjRnXiEsXiZaXjJmXiNhXiIpXiV7XipEXig6XideXiEvXihkXiEiXilqXi1HXiNKXiRCXilGXipBIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_96479c033e1e",
      "text": "顯露出了自由的面容。",
      "encoded_ascii": "^4&^.B^!q^*D^'l^&I^&Z^)j^+t^!\"",
      "encoded_base64": "XjQmXi5CXiFxXipEXidsXiZJXiZaXilqXit0XiEi",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_ab47d79717e7",
      "text": "  你說的話根本讓人無法理解！",
      "encoded_ascii": "  ^*F^-x^&Z^-v^%)^$x^-}^!<^%}^%b^&A^(I^*W",
      "encoded_base64": "ICBeKkZeLXheJlpeLXZeJSleJHheLX1eITxeJX1eJWJeJkFeKEleKlc=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_f7b7a8dad9fd",
      "text": "  你對我有什麼指引或建議嗎？",
      "encoded_ascii": "  ^*F^#:^$%^$s^!=^.T^$8^#Z^$'^,'^-|^+X^.V",
      "encoded_base64": "ICBeKkZeIzpeJCVeJHNeIT1eLlReJDheI1peJCdeLCdeLXxeK1heLlY=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_85c986394aa1",
      "text": "  你的幻象究竟來自何處？",
      "encoded_ascii": "  ^*F^&Z^#S^4g^-<^28^!O^'l^!L^(,^.V",
      "encoded_base64": "ICBeKkZeJlpeI1NeNGdeLTxeMjheIU9eJ2xeIUxeKCxeLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_5866244b812e",
      "text": "  關於這場戰爭，你能說些什麼？",
      "encoded_ascii": "  ^.>^$^^(s^\"n^$(^1I^*A^*F^'b^-x^!8^!=^.T^.V",
      "encoded_base64": "ICBeLj5eJF5eKHNeIm5eJCheMUleKkFeKkZeJ2JeLXheITheIT1eLlReLlY=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_af247817b837",
      "text": "  跟我說說這則預言吧。",
      "encoded_ascii": "  ^.+^$%^-x^-x^(s^!x^.E^1Y^*I^!\"",
      "encoded_base64": "ICBeLiteJCVeLXheLXheKHNeIXheLkVeMVleKkleISI=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_903e15254db0",
      "text": "  你知道我接下來該怎麼做嗎？",
      "encoded_ascii": "  ^*F^&h^(y^$%^$?^!(^!O^(M^,,^.T^*~^+X^.V",
      "encoded_base64": "ICBeKkZeJmheKHleJCVeJD9eISheIU9eKE1eLCxeLlReKn5eK1heLlY=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_94a5fb811d43",
      "text": "風暴已經降臨！你們的命運迫在眉睫！",
      "encoded_ascii": "^)y^$m^#J^'D^)N^1U^*W^*F^*{^&Z^\"N^.4^1`^\"d^3S^8o^*W",
      "encoded_base64": "Xil5XiRtXiNKXidEXilOXjFVXipXXipGXip7XiZaXiJOXi40XjFgXiJkXjNTXjhvXipX",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_608014b2f9c8",
      "text": "變革之風將在廢墟中顯露希望，喚醒昔日歡樂時光的 ",
      "encoded_ascii": "^(U^;&^!/^)y^#7^\"d^#W^\"t^!,^4&^.B^+{^,]^*A^\"U^.9^<)^$a^%F^%8^$f^!c^&Z ",
      "encoded_base64": "XihVXjsmXiEvXil5XiM3XiJkXiNXXiJ0XiEsXjQmXi5CXit7XixdXipBXiJVXi45XjwpXiRhXiVGXiU4XiRmXiFjXiZaIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_40861dc7886b",
      "text": "幽影。",
      "encoded_ascii": "^2f^#a^!\"",
      "encoded_base64": "XjJmXiNhXiEi",
      "byte_length": 9
    },
    {
      "unit_id": "DLG_a3dd14e639d8",
      "text": "  你能預言這場戰爭的結局嗎？",
      "encoded_ascii": "  ^*F^'b^.E^1Y^(s^\"n^$(^1I^&Z^'@^._^+X^.V",
      "encoded_base64": "ICBeKkZeJ2JeLkVeMVleKHNeIm5eJCheMUleJlpeJ0BeLl9eK1heLlY=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_ecf0df81b3af",
      "text": "  你的幻象揭示了什麼？",
      "encoded_ascii": "  ^*F^&Z^#S^4g^$B^&s^*D^!=^.T^.V",
      "encoded_base64": "ICBeKkZeJlpeI1NeNGdeJEJeJnNeKkReIT1eLlReLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_5febe413f70e",
      "text": "  是否有辦法化解這場厄運浩劫？",
      "encoded_ascii": "  ^,X^\"H^$s^2L^%b^\")^(I^(s^\"n^80^.4^5^^1l^.V",
      "encoded_base64": "ICBeLFheIkheJHNeMkxeJWJeIileKEleKHNeIm5eODBeLjReNV5eMWxeLlY=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_8e8a1894fb41",
      "text": "莫要遲疑停手，你們正屹立於風暴之前！ ",
      "encoded_ascii": "^/F^(C^.5^0p^+!^$+^*A^*F^*{^%H^?U^0'^$^^)y^$m^!/^!z^*W ",
      "encoded_base64": "Xi9GXihDXi41XjBwXishXiQrXipBXipGXip7XiVIXj9VXjAnXiReXil5XiRtXiEvXiF6XipXIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_3810d1e5b484",
      "text": "大戰的嘹亮號角已經吹響！",
      "encoded_ascii": "^\"z^$(^&Z^?t^*t^(-^(H^#J^'D^+A^)o^*W",
      "encoded_base64": "XiJ6XiQoXiZaXj90Xip0XigtXihIXiNKXidEXitBXilvXipX",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_f881e0989949",
      "text": "看哪！你們的命運已然顯現！你們的天命正於流沙顯露的廢墟之中 ",
      "encoded_ascii": "^*Q^+I^*W^*F^*{^&Z^\"N^.4^#J^&\"^4&^&?^*W^*F^*{^&Z^+e^\"N^%H^$^^%j^%]^4&^.B^&Z^#W^\"t^!/^!, ",
      "encoded_base64": "XipRXitJXipXXipGXip7XiZaXiJOXi40XiNKXiYiXjQmXiY/XipXXipGXip7XiZaXitlXiJOXiVIXiReXiVqXiVdXjQmXi5CXiZaXiNXXiJ0XiEvXiEsIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_5f9abce0c5c5",
      "text": "靜候著你們。",
      "encoded_ascii": "^)h^*|^-a^*F^*{^!\"",
      "encoded_base64": "XiloXip8Xi1hXipGXip7XiEi",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_9e3cd56b5f22",
      "text": "風暴吹散了黃沙，露出了古老的廢墟， ",
      "encoded_ascii": "^)y^$m^+A^$S^*D^*7^%]^*A^.B^!q^*D^\"=^'U^&Z^#W^\"t^*A ",
      "encoded_base64": "Xil5XiRtXitBXiRTXipEXio3XiVdXipBXi5CXiFxXipEXiI9XidVXiZaXiNXXiJ0XipBIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_2066540ed44e",
      "text": "你們唯一的獲勝希望依然隱於陰影之中。拔開 ",
      "encoded_ascii": "^*F^*{^+O^!%^&Z^&:^+5^+{^,]^!Q^&\"^)Y^$^^6B^#a^!/^!,^!\"^/c^)F ",
      "encoded_base64": "XipGXip7XitPXiElXiZaXiY6Xis1Xit7XixdXiFRXiYiXilZXiReXjZCXiNhXiEvXiEsXiEiXi9jXilGIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_4ff0b4e7923c",
      "text": "神燈巨靈的瓶塞，召喚出你們所需的神力吧。",
      "encoded_ascii": "^&w^93^#H^)g^&Z^&D^/(^*A^\"@^\"U^!q^*F^*{^$)^)e^&Z^&w^!~^*I^!\"",
      "encoded_base64": "XiZ3XjkzXiNIXilnXiZaXiZEXi8oXipBXiJAXiJVXiFxXipGXip7XiQpXillXiZaXiZ3XiF+XipJXiEi",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_cd3cdda6c41c",
      "text": "預言既已應驗，我便如盲人一般——我將追尋我的視界， ",
      "encoded_ascii": "^.E^1Y^,U^#J^0`^.P^*A^$%^!R^#$^&_^!<^!%^'r^*n^*n^$%^#7^(o^#9^$%^&Z^(E^.p^*A ",
      "encoded_base64": "Xi5FXjFZXixVXiNKXjBgXi5QXipBXiQlXiFSXiMkXiZfXiE8XiElXidyXipuXipuXiQlXiM3XihvXiM5XiQlXiZaXihFXi5wXipBIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_5c3da9c272c0",
      "text": "抑或是尋覓一處更加涼爽的棲身之地。",
      "encoded_ascii": "^?1^$'^,X^#9^6t^!%^(,^$o^\"\"^,s^@!^&Z^,b^(c^!/^\"e^!\"",
      "encoded_base64": "Xj8xXiQnXixYXiM5XjZ0XiElXigsXiRvXiIiXixzXkAhXiZaXixiXihjXiEvXiJlXiEi",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_09ec43323d8e",
      "text": "偉大的功業隱匿於面紗之後。預言在時光長河中綿延不息， ",
      "encoded_ascii": "^*}^\"z^&Z^\"!^%5^)Y^7%^$^^)j^-G^!/^#b^!\"^.E^1Y^\"d^$f^!c^)C^<*^!,^>&^,&^!)^#w^*A ",
      "encoded_base64": "Xip9XiJ6XiZaXiIhXiU1XilZXjclXiReXilqXi1HXiEvXiNiXiEiXi5FXjFZXiJkXiRmXiFjXilDXjwqXiEsXj4mXiwmXiEpXiN3XipBIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_d14dc756babd",
      "text": "那時所有的元素都將和諧相融，偉大的英雄們將於 ",
      "encoded_ascii": "^)!^$f^$)^$s^&Z^!a^'=^)$^#7^\"O^4f^&a^(7^*A^*}^\"z^&Z^'y^)\\^*{^#7^$^ ",
      "encoded_base64": "XikhXiRmXiQpXiRzXiZaXiFhXic9XikkXiM3XiJPXjRmXiZhXig3XipBXip9XiJ6XiZaXid5XilcXip7XiM3XiReIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_cf4825f51d7f",
      "text": "時空渦流之中熠熠生輝。",
      "encoded_ascii": "^$f^'(^?y^%j^!/^!,^?~^?~^&F^2K^!\"",
      "encoded_base64": "XiRmXicoXj95XiVqXiEvXiEsXj9+Xj9+XiZGXjJLXiEi",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_6d0a8855ddfd",
      "text": "哎呀！怒濤狂湧而過，你們卻依然佇立不前！難道你們 ",
      "encoded_ascii": "^3i^3h^*W^#o^?|^&8^0m^'W^(x^*A^*F^*{^1&^!Q^&\"^>e^0'^!)^!z^*W^)a^(y^*F^*{ ",
      "encoded_base64": "XjNpXjNoXipXXiNvXj98XiY4XjBtXidXXih4XipBXipGXip7XjEmXiFRXiYiXj5lXjAnXiEpXiF6XipXXilhXih5XipGXip7IA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_a28b73315f53",
      "text": "聽不見浩劫步步逼近的如雷蹄聲嗎？ ",
      "encoded_ascii": "^-X^!)^-m^5^^1l^,i^,i^.1^(l^&Z^#$^)c^8s^-W^+X^.V ",
      "encoded_base64": "Xi1YXiEpXi1tXjVeXjFsXixpXixpXi4xXihsXiZaXiMkXiljXjhzXi1XXitYXi5WIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_b71a5ffb3527",
      "text": "戰鼓正為你們擂響！",
      "encoded_ascii": "^$(^*<^%H^%{^*F^*{^?v^)o^*W",
      "encoded_base64": "XiQoXio8XiVIXiV7XipGXip7Xj92XilvXipX",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_e532390797fa",
      "text": "  我必須做些什麼？",
      "encoded_ascii": "  ^$%^#l^)r^*~^!8^!=^.T^.V",
      "encoded_base64": "ICBeJCVeI2xeKXJeKn5eITheIT1eLlReLlY=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_4682cfec66a3",
      "text": "  德拉吉大軍的情況如何？",
      "encoded_ascii": "  ^#j^$6^\"D^\"z^..^&Z^,0^,q^#$^!L^.V",
      "encoded_base64": "ICBeI2peJDZeIkReInpeLi5eJlpeLDBeLHFeIyReIUxeLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_16ce7f8d4606",
      "text": "  廢墟裡究竟有什麼？",
      "encoded_ascii": "  ^#W^\"t^-j^-<^28^$s^!=^.T^.V",
      "encoded_base64": "ICBeI1deInReLWpeLTxeMjheJHNeIT1eLlReLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_8375b7946346",
      "text": "  這則預言究竟是什麼？",
      "encoded_ascii": "  ^(s^!x^.E^1Y^-<^28^,X^!=^.T^.V",
      "encoded_base64": "ICBeKHNeIXheLkVeMVleLTxeMjheLFheIT1eLlReLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_4034bf612006",
      "text": "  預言裡說了些什麼？",
      "encoded_ascii": "  ^.E^1Y^-j^-x^*D^!8^!=^.T^.V",
      "encoded_base64": "ICBeLkVeMVleLWpeLXheKkReITheIT1eLlReLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_b40f56a7a844",
      "text": "  你是如何知曉這一切的？",
      "encoded_ascii": "  ^*F^,X^#$^!L^&h^7y^(s^!%^+.^&Z^.V",
      "encoded_base64": "ICBeKkZeLFheIyReIUxeJmheN3leKHNeISVeKy5eJlpeLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_5fcbcc143e24",
      "text": "你們必須改弦易轍！",
      "encoded_ascii": "^*F^*{^#l^)r^$N^?n^,W^@+^*W",
      "encoded_base64": "XipGXip7XiNsXilyXiROXj9uXixXXkArXipX",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_a448193753bb",
      "text": "繼續沿著同伴之路前行吧。",
      "encoded_ascii": "^-O^'M^%`^-a^\"E^1h^!/^(a^!z^(;^*I^!\"",
      "encoded_base64": "Xi1PXidNXiVgXi1hXiJFXjFoXiEvXihhXiF6Xig7XipJXiEi",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_84a535c980b3",
      "text": " 孤劍難敵千軍，唯有手握堅盾方能立於不敗之地。當標槍如雨落下時， ",
      "encoded_ascii": " ^2c^!|^)a^$U^+7^..^*A^+O^$s^$+^1>^\"l^&b^$]^'b^0'^$^^!)^$R^!/^\"e^!\"^&N^%9^?x^#$^8B^-`^!(^$f^*A ",
      "encoded_base64": "IF4yY14hfF4pYV4kVV4rN14uLl4qQV4rT14kc14kK14xPl4ibF4mYl4kXV4nYl4wJ14kXl4hKV4kUl4hL14iZV4hIl4mTl4lOV4/eF4jJF44Ql4tYF4hKF4kZl4qQSA=",
      "byte_length": 95
    },
    {
      "unit_id": "DLG_168af2f0556b",
      "text": "誰來做你的護盾？",
      "encoded_ascii": "^-y^!O^*~^*F^&Z^(T^&b^.V",
      "encoded_base64": "Xi15XiFPXip+XipGXiZaXihUXiZiXi5W",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_3361fc8b4492",
      "text": "  確切告訴我究竟該做些什麼。",
      "encoded_ascii": "  ^-6^+.^+B^-t^$%^-<^28^(M^*~^!8^!=^.T^!\"",
      "encoded_base64": "ICBeLTZeKy5eK0JeLXReJCVeLTxeMjheKE1eKn5eITheIT1eLlReISI=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_2eb8cc270769",
      "text": "  我該去哪裡尋找他們？",
      "encoded_ascii": "  ^$%^(M^\"6^+I^-j^#9^$/^!@^*{^.V",
      "encoded_base64": "ICBeJCVeKE1eIjZeK0leLWpeIzleJC9eIUBeKnteLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_17a1f34ea924",
      "text": "  是否會有任何可供遵循的徵兆？",
      "encoded_ascii": "  ^,X^\"H^$r^$s^!C^!L^\"A^!P^4#^#h^&Z^5O^5/^.V",
      "encoded_base64": "ICBeLFheIkheJHJeJHNeIUNeIUxeIkFeIVBeNCNeI2heJlpeNU9eNS9eLlY=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_0a9977edeb64",
      "text": "勝利者於幽影中尋獲——面紗遮蔽在我的眼前。",
      "encoded_ascii": "^+5^!t^'V^$^^2f^#a^!,^#9^&:^*n^*n^)j^-G^(~^('^\"d^$%^&Z^&d^!z^!\"",
      "encoded_base64": "Xis1XiF0XidWXiReXjJmXiNhXiEsXiM5XiY6XipuXipuXilqXi1HXih+XignXiJkXiQlXiZaXiZkXiF6XiEi",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_f561ffd78c8d",
      "text": "遮天蔽日的沙塵在風暴前肆虐——未來被禁錮在旋風之中。",
      "encoded_ascii": "^(~^+e^('^$a^&Z^%]^\"p^\"d^)y^$m^!z^2>^3)^*n^*n^,_^!O^(@^&y^?%^\"d^$`^)y^!/^!,^!\"",
      "encoded_base64": "Xih+XitlXignXiRhXiZaXiVdXiJwXiJkXil5XiRtXiF6XjI+XjMpXipuXipuXixfXiFPXihAXiZ5Xj8lXiJkXiRgXil5XiEvXiEsXiEi",
      "byte_length": 78
    },
    {
      "unit_id": "DLG_b0b62fa3ff5c",
      "text": "我是傳達神諭的聲音。你們是踐行天命的雙手。",
      "encoded_ascii": "^$%^,X^+$^(z^&w^3_^&Z^-W^34^!\"^*F^*{^,X^4h^(;^+e^\"N^&Z^)_^$+^!\"",
      "encoded_base64": "XiQlXixYXiskXih6XiZ3XjNfXiZaXi1XXjM0XiEiXipGXip7XixYXjRoXig7XitlXiJOXiZaXilfXiQrXiEi",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_73f7d1cbe006",
      "text": "把握你們的命運吧！趕在惡狼吞噬整片大地之前！",
      "encoded_ascii": "^$1^1>^*F^*{^&Z^\"N^.4^*I^*W^0u^\"d^#y^21^:-^:0^$T^&1^\"z^\"e^!/^!z^*W",
      "encoded_base64": "XiQxXjE+XipGXip7XiZaXiJOXi40XipJXipXXjB1XiJkXiN5XjIxXjotXjowXiRUXiYxXiJ6XiJlXiEvXiF6XipX",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_48281ae99bca",
      "text": "  你是什麼的代言之音？",
      "encoded_ascii": "  ^*F^,X^!=^.T^&Z^*v^1Y^!/^34^.V",
      "encoded_base64": "ICBeKkZeLFheIT1eLlReJlpeKnZeMVleIS9eMzReLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_d638fc079500",
      "text": "  你為何稱我為雙手？",
      "encoded_ascii": "  ^*F^%{^!L^0&^$%^%{^)_^$+^.V",
      "encoded_base64": "ICBeKkZeJXteIUxeMCZeJCVeJXteKV9eJCteLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_4149e49a4b7f",
      "text": "  你所說的惡狼究竟是指什麼？",
      "encoded_ascii": "  ^*F^$)^-x^&Z^#y^21^-<^28^,X^$8^!=^.T^.V",
      "encoded_base64": "ICBeKkZeJCleLXheJlpeI3leMjFeLTxeMjheLFheJDheIT1eLlReLlY=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_8c9128a4e366",
      "text": "烈日投下了它的長矛，如今我漫步於陰影之中。你們也將尋覓 ",
      "encoded_ascii": "^%|^$a^$3^!(^*D^+o^&Z^)C^4Z^*A^#$^*E^$%^2,^,i^$^^6B^#a^!/^!,^!\"^*F^*{^!1^#7^#9^6t ",
      "encoded_base64": "XiV8XiRhXiQzXiEoXipEXitvXiZaXilDXjRaXipBXiMkXipFXiQlXjIsXixpXiReXjZCXiNhXiEvXiEsXiEiXipGXip7XiExXiM3XiM5XjZ0IA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_45405cfab592",
      "text": "一尊幽靈，在怨毒閉上那焦灼之舌的地方。",
      "encoded_ascii": "^!%^+u^2f^)g^*A^\"d^3F^%Q^.=^!'^)!^%~^9^^!/^'q^&Z^\"e^$]^!\"",
      "encoded_base64": "XiElXit1XjJmXilnXipBXiJkXjNGXiVRXi49XiEnXikhXiV+XjleXiEvXidxXiZaXiJlXiRdXiEi",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_78896d2cf857",
      "text": "踏上那條幽狹之路吧！你們的天命 ",
      "encoded_ascii": "^.,^!'^)!^%.^2f^9#^!/^(a^*I^*W^*F^*{^&Z^+e^\"N ",
      "encoded_base64": "Xi4sXiEnXikhXiUuXjJmXjkjXiEvXihhXipJXipXXipGXip7XiZaXitlXiJOIA==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_0591b6dc1623",
      "text": "要求你們追尋被遺忘的古道。將仇視可怖威脅的仇敵， ",
      "encoded_ascii": "^(C^,n^*F^*{^(o^#9^(@^0v^0]^&Z^\"=^(y^!\"^#7^1g^(E^\"A^#p^#&^1T^&Z^1g^$U^*A ",
      "encoded_base64": "XihDXixuXipGXip7XihvXiM5XihAXjB2XjBdXiZaXiI9Xih5XiEiXiM3XjFnXihFXiJBXiNwXiMmXjFUXiZaXjFnXiRVXipBIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_4682caa7ece3",
      "text": "全都攬入你們的麾下。",
      "encoded_ascii": "^!h^)$^?c^!f^*F^*{^&Z^4)^!(^!\"",
      "encoded_base64": "XiFoXikkXj9jXiFmXipGXip7XiZaXjQpXiEoXiEi",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_3676ecb55a94",
      "text": "正在等候，而橫跨流沙之上，死神正在悄然獵捕 ",
      "encoded_ascii": "^%H^\"d^'-^*|^*A^'W^/2^@)^%j^%]^!/^!'^*A^%L^&w^%H^\"d^3r^&\"^&;^4? ",
      "encoded_base64": "XiVIXiJkXictXip8XipBXidXXi8yXkApXiVqXiVdXiEvXiEnXipBXiVMXiZ3XiVIXiJkXjNyXiYiXiY7XjQ/IA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_9352ac6c3d4e",
      "text": "野兔。",
      "encoded_ascii": "^.:^?.^!\"",
      "encoded_base64": "Xi46Xj8uXiEi",
      "byte_length": 9
    },
    {
      "unit_id": "DLG_34e087e34922",
      "text": "你們的天命——是馴服這場變革之狂風，否則就會被拋落重重深淵。 ",
      "encoded_ascii": "^*F^*{^&Z^+e^\"N^*n^*n^,X^.N^,\\^(s^\"n^(U^;&^!/^&8^)y^*A^\"H^!x^*J^$r^(@^,A^-`^))^))^2*^<m^!\" ",
      "encoded_base64": "XipGXip7XiZaXitlXiJOXipuXipuXixYXi5OXixcXihzXiJuXihVXjsmXiEvXiY4Xil5XipBXiJIXiF4XipKXiRyXihAXixBXi1gXikpXikpXjIqXjxtXiEiIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_7aecdbaeaad5",
      "text": "在懸崖邊緣搖搖欲墜的你們，必須鑄就堅不可摧的奧援， ",
      "encoded_ascii": "^\"d^0a^9l^.8^9J^3J^3J^4I^\"r^&Z^*F^*{^*A^#l^)r^:?^*J^\"l^!)^\"A^$E^&Z^6Q^$C^*A ",
      "encoded_base64": "XiJkXjBhXjlsXi44XjlKXjNKXjNKXjRJXiJyXiZaXipGXip7XipBXiNsXilyXjo/XipKXiJsXiEpXiJBXiRFXiZaXjZRXiRDXipBIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_35b1551e1d88",
      "text": "以免粉身碎骨！",
      "encoded_ascii": "^!B^!e^'5^(c^&o^*$^*W",
      "encoded_base64": "XiFCXiFlXic1XihjXiZvXiokXipX",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_1589e60fb90b",
      "text": "用粉碎的桎梏鑄就鋼鐵般的意志，你們受命於此； ",
      "encoded_ascii": "^&H^'5^&o^&Z^3L^3M^:?^*J^)2^)?^'r^&Z^#z^#m^*A^*F^*{^\";^\"N^$^^%I^*C ",
      "encoded_base64": "XiZIXic1XiZvXiZaXjNMXjNNXjo/XipKXikyXik/XidyXiZaXiN6XiNtXipBXipGXip7XiI7XiJOXiReXiVJXipDIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_ca1d0065a5a6",
      "text": "在鐵砧上砸碎沉重的鎖鏈，解救獲取自由的同盟。 ",
      "encoded_ascii": "^\"d^)?^&m^!'^0#^&o^%Z^))^&Z^)8^)<^*A^(I^,Q^&:^\":^'l^&I^&Z^\"E^-0^!\" ",
      "encoded_base64": "XiJkXik/XiZtXiEnXjAjXiZvXiVaXikpXiZaXik4Xik8XipBXihJXixRXiY6XiI6XidsXiZJXiZaXiJFXi0wXiEiIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_e7bfb350fe0c",
      "text": "同盟必將尋獲。",
      "encoded_ascii": "^\"E^-0^#l^#7^#9^&:^!\"",
      "encoded_base64": "XiJFXi0wXiNsXiM3XiM5XiY6XiEi",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_57d06f8bbae3",
      "text": "揮劍手臂的力量存於你的內心，那頭惡狼的剋星 ",
      "encoded_ascii": "^2\"^!|^$+^'k^&Z^!~^)*^#*^$^^*F^&Z^!g^#k^*A^)!^)t^#y^21^&Z^?q^$e ",
      "encoded_base64": "XjIiXiF8XiQrXidrXiZaXiF+XikqXiMqXiReXipGXiZaXiFnXiNrXipBXikhXil0XiN5XjIxXiZaXj9xXiRlIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_5230bc2fa4eb",
      "text": "就隱藏在牠的獵物之中。重訪那些曾被你們從利爪魔掌中 ",
      "encoded_ascii": "^*J^)Y^-f^\"d^-#^&Z^&;^&4^!/^!,^!\"^))^4d^)!^!8^.j^(@^*F^*{^#f^!t^&.^*0^$;^!, ",
      "encoded_base64": "XipKXilZXi1mXiJkXi0jXiZaXiY7XiY0XiEvXiEsXiEiXikpXjRkXikhXiE4Xi5qXihAXipGXip7XiNmXiF0XiYuXiowXiQ7XiEsIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_ed8f27a7214d",
      "text": "拯救出來的人們吧。",
      "encoded_ascii": "^,F^,Q^!q^!O^&Z^!<^*{^*I^!\"",
      "encoded_base64": "XixGXixRXiFxXiFPXiZaXiE8Xip7XipJXiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_dea008f69749",
      "text": "恐懼的雙翼盤旋在天，正伺機俯衝獵殺。你們漫步於 ",
      "encoded_ascii": "^#t^$#^&Z^)_^'T^1M^$`^\"d^+e^*A^%H^0Q^%>^5*^-h^&;^%M^!\"^*F^*{^2,^,i^$^ ",
      "encoded_base64": "XiN0XiQjXiZaXilfXidUXjFNXiRgXiJkXitlXipBXiVIXjBRXiU+XjUqXi1oXiY7XiVNXiEiXipGXip7XjIsXixpXiReIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_3b0b19e6f35a",
      "text": "牠們凶險邪惡的目光之下，將那些獵物引領歸入安全的庇護所。 ",
      "encoded_ascii": "^-#^*{^3e^*m^)\"^#y^&Z^&^^!c^!/^!(^*A^#7^)!^!8^&;^&4^#Z^)s^%K^!f^+p^!h^&Z^,\"^(T^$)^!\" ",
      "encoded_base64": "Xi0jXip7XjNlXiptXikiXiN5XiZaXiZeXiFjXiEvXiEoXipBXiM3XikhXiE4XiY7XiY0XiNaXilzXiVLXiFmXitwXiFoXiZaXiwiXihUXiQpXiEiIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_871d3de69e4d",
      "text": "安全歸巢。",
      "encoded_ascii": "^+p^!h^%K^#G^!\"",
      "encoded_base64": "XitwXiFoXiVLXiNHXiEi",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_df675d55c512",
      "text": "取回矗立巨石那璀璨閃耀的核心吧。當巨石的生機復甦， ",
      "encoded_ascii": "^\":^\"\\^<q^0'^#H^&k^)!^8m^8n^)E^7D^&Z^:\"^#k^*I^!\"^&N^#H^&k^&Z^&F^%>^#g^6e^*A ",
      "encoded_base64": "XiI6XiJcXjxxXjAnXiNIXiZrXikhXjhtXjhuXilFXjdEXiZaXjoiXiNrXipJXiEiXiZOXiNIXiZrXiZaXiZGXiU+XiNnXjZlXipBIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_a6a2a1273091",
      "text": "古老的巨石便能向你們發出呼喚。",
      "encoded_ascii": "^\"=^'U^&Z^#H^&k^!R^'b^+?^*F^*{^&W^!q^\"M^\"U^!\"",
      "encoded_base64": "XiI9XidVXiZaXiNIXiZrXiFSXidiXis/XipGXip7XiZXXiFxXiJNXiJVXiEi",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_28e0ab1c63b7",
      "text": " 在愚昧無知之中，提奎茲爾的巨石核心被拋入了深邃的水井暗道裡。",
      "encoded_ascii": " ^\"d^/a^4D^%}^&h^!/^!,^*A^$A^5B^/D^&/^&Z^#H^&k^:\"^#k^(@^,A^!f^*D^2*^6;^&Z^%V^!7^$k^(y^-j^!\"",
      "encoded_base64": "IF4iZF4vYV40RF4lfV4maF4hL14hLF4qQV4kQV41Ql4vRF4mL14mWl4jSF4ma146Il4ja14oQF4sQV4hZl4qRF4yKl42O14mWl4lVl4hN14ka14oeV4tal4hIg==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_b9026e23b1b0",
      "text": "啊，我確實有。沒錯。這是一件能為你們旅程提供助力的法寶；一根能引領你們前往有生機巨石之地的魔法權杖。 ",
      "encoded_ascii": "^+Q^*A^$%^-6^#3^$s^!\"^%\\^)5^!\"^(s^,X^!%^.W^'b^%{^*F^*{^2m^'#^$A^!P^\"#^!~^&Z^%b^#4^*C^!%^%)^'b^#Z^)s^*F^*{^!z^,)^$s^&F^%>^#H^&k^!/^\"e^&Z^*0^%b^1E^${^!\" ",
      "encoded_base64": "XitRXipBXiQlXi02XiMzXiRzXiEiXiVcXik1XiEiXihzXixYXiElXi5XXidiXiV7XipGXip7XjJtXicjXiRBXiFQXiIjXiF+XiZaXiViXiM0XipDXiElXiUpXidiXiNaXilzXipGXip7XiF6XiwpXiRzXiZGXiU+XiNIXiZrXiEvXiJlXiZaXiowXiViXjFFXiR7XiEiIA==",
      "byte_length": 151
    },
    {
      "unit_id": "DLG_42334e9b3577",
      "text": "帶你們去往古石甦生之處。",
      "encoded_ascii": "^#N^*F^*{^\"6^,)^\"=^&k^6e^&F^!/^(,^!\"",
      "encoded_base64": "XiNOXipGXip7XiI2XiwpXiI9XiZrXjZlXiZGXiEvXigsXiEi",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_1b5bff74d00a",
      "text": "你們的死期尚被阻擋在門外，而在廢墟之中，其他人的死期正等候著呼召。速速啟程吧！ ",
      "encoded_ascii": "^*F^*{^&Z^%L^$u^+v^(@^)L^$G^\"d^)D^\"w^*A^'W^\"d^#W^\"t^!/^!,^*A^!j^!@^!<^&Z^%L^$u^%H^'-^*|^-a^\"M^\"@^!\"^(u^(u^57^'#^*I^*W ",
      "encoded_base64": "XipGXip7XiZaXiVMXiR1Xit2XihAXilMXiRHXiJkXilEXiJ3XipBXidXXiJkXiNXXiJ0XiEvXiEsXipBXiFqXiFAXiE8XiZaXiVMXiR1XiVIXictXip8Xi1hXiJNXiJAXiEiXih1Xih1XjU3XicjXipJXipXIA==",
      "byte_length": 118
    },
    {
      "unit_id": "DLG_7ca92d48ae7e",
      "text": "勝利的幽影正逐漸黯淡。",
      "encoded_ascii": "^+5^!t^&Z^2f^#a^%H^(r^2v^@/^5_^!\"",
      "encoded_base64": "Xis1XiF0XiZaXjJmXiNhXiVIXihyXjJ2XkAvXjVfXiEi",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_cb14682f188e",
      "text": "狂暴的大軍已被風暴逼退，但時光無情的雙手從不等人。 ",
      "encoded_ascii": "^&8^$m^&Z^\"z^..^#J^(@^)y^$m^.1^*V^*A^!I^$f^!c^%}^,0^&Z^)_^$+^#f^!)^'-^!<^!\" ",
      "encoded_base64": "XiY4XiRtXiZaXiJ6Xi4uXiNKXihAXil5XiRtXi4xXipWXipBXiFJXiRmXiFjXiV9XiwwXiZaXilfXiQrXiNmXiEpXictXiE8XiEiIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_62cad507725d",
      "text": "你們必須喚醒古老巨石中的幽影。",
      "encoded_ascii": "^*F^*{^#l^)r^\"U^.9^\"=^'U^#H^&k^!,^&Z^2f^#a^!\"",
      "encoded_base64": "XipGXip7XiNsXilyXiJVXi45XiI9XidVXiNIXiZrXiEsXiZaXjJmXiNhXiEi",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_d8071028be12",
      "text": "消逝歲月的幽影就潛藏在廢墟之中，那裡沉睡著通往你們勝利的奧秘。 ",
      "encoded_ascii": "^%k^0E^,j^/p^&Z^2f^#a^*J^7:^-f^\"d^#W^\"t^!/^!,^*A^)!^-j^%Z^-3^-a^(t^,)^*F^*{^+5^!t^&Z^6Q^1O^!\" ",
      "encoded_base64": "XiVrXjBFXixqXi9wXiZaXjJmXiNhXipKXjc6Xi1mXiJkXiNXXiJ0XiEvXiEsXipBXikhXi1qXiVaXi0zXi1hXih0XiwpXipGXip7Xis1XiF0XiZaXjZRXjFPXiEiIA==",
      "byte_length": 94
    },
    {
      "unit_id": "DLG_a63da1c94964",
      "text": "勝利的終極奧秘。",
      "encoded_ascii": "^+5^!t^&Z^-H^1D^6Q^1O^!\"",
      "encoded_base64": "Xis1XiF0XiZaXi1IXjFEXjZRXjFPXiEi",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_95ac9fe0d56c",
      "text": "你們就是預言本身！",
      "encoded_ascii": "^*F^*{^*J^,X^.E^1Y^$x^(c^*W",
      "encoded_base64": "XipGXip7XipKXixYXi5FXjFZXiR4XihjXipX",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_61fcb622dd13",
      "text": "當邪惡張開雙翼企圖奪取那隻它無法掌控的雙手時， ",
      "encoded_ascii": "^&N^)\"^#y^,(^)F^)_^'T^4-^\"b^1,^\":^)!^)[^+o^%}^%b^$;^$@^&Z^)_^$+^$f^*A ",
      "encoded_base64": "XiZOXikiXiN5XiwoXilGXilfXidUXjQtXiJiXjEsXiI6XikhXilbXitvXiV9XiViXiQ7XiRAXiZaXilfXiQrXiRmXipBIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_0ad72b1efb86",
      "text": "它的陰影將籠罩大漠，企圖在黑暗中奪回逃脫之物。 ",
      "encoded_ascii": "^+o^&Z^6B^#a^#7^'3^'P^\"z^,}^*A^4-^\"b^\"d^*:^$k^!,^1,^\"\\^(p^'c^!/^&4^!\" ",
      "encoded_base64": "XitvXiZaXjZCXiNhXiM3XiczXidQXiJ6Xix9XipBXjQtXiJiXiJkXio6XiRrXiEsXjEsXiJcXihwXidjXiEvXiY0XiEiIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_6daa5b895721",
      "text": "但在凡人破碎心靈的深處，一位勝利者即將降臨， ",
      "encoded_ascii": "^!I^\"d^+-^!<^&n^&o^#k^)g^&Z^2*^(,^*A^!%^!J^+5^!t^'V^\"1^#7^)N^1U^*A ",
      "encoded_base64": "XiFJXiJkXistXiE8XiZuXiZvXiNrXilnXiZaXjIqXigsXipBXiElXiFKXis1XiF0XidWXiIxXiM3XilOXjFVXipBIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_42adce32bba4",
      "text": "引領眾人穿越流沙。緊握那雙手，面紗將保護眾人 ",
      "encoded_ascii": "^#Z^)s^&e^!<^')^(]^%j^%]^!\"^0r^1>^)!^)_^$+^*A^)j^-G^#7^!T^(T^&e^!< ",
      "encoded_base64": "XiNaXilzXiZlXiE8XicpXihdXiVqXiVdXiEiXjByXjE+XikhXilfXiQrXipBXilqXi1HXiM3XiFUXihUXiZlXiE8IA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_3894f821be69",
      "text": "免受烈日焚灼的凝視。 ",
      "encoded_ascii": "^!e^\";^%|^$a^>u^9^^&Z^!o^(E^!\" ",
      "encoded_base64": "XiFlXiI7XiV8XiRhXj51XjleXiZaXiFvXihFXiEiIA==",
      "byte_length": 31
    },
    {
      "unit_id": "DLG_af34212f5610",
      "text": "免受無情烈日的炙烤。",
      "encoded_ascii": "^!e^\";^%}^,0^%|^$a^&Z^7=^/w^!\"",
      "encoded_base64": "XiFlXiI7XiV9XiwwXiV8XiRhXiZaXjc9Xi93XiEi",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_e65b1c4ed75e",
      "text": "去尋找吧， ",
      "encoded_ascii": "^\"6^#9^$/^*I^*A ",
      "encoded_base64": "XiI2XiM5XiQvXipJXipBIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_79f8f6374900",
      "text": "去尋找那些作繭自縛之人。出於貪婪，他們引來了巧舌如簧的惡狼赴宴，並甘受其奴役。 ",
      "encoded_ascii": "^\"6^#9^$/^)!^!8^!M^@&^'l^3W^!/^!<^!\"^!q^$^^1^^1-^*A^!@^*{^#Z^!O^*D^3D^'q^#$^@#^&Z^#y^21^.'^1/^*A^!+^/:^\";^!j^##^17^!\" ",
      "encoded_base64": "XiI2XiM5XiQvXikhXiE4XiFNXkAmXidsXjNXXiEvXiE8XiEiXiFxXiReXjFeXjEtXipBXiFAXip7XiNaXiFPXipEXjNEXidxXiMkXkAjXiZaXiN5XjIxXi4nXjEvXipBXiErXi86XiI7XiFqXiMjXjE3XiEiIA==",
      "byte_length": 118
    },
    {
      "unit_id": "DLG_88afaca2a7e4",
      "text": "甘願受其驅使。",
      "encoded_ascii": "^/:^.H^\";^!j^*#^!N^!\"",
      "encoded_base64": "Xi86Xi5IXiI7XiFqXiojXiFOXiEi",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_9c568f47b9ab",
      "text": "踏上那些幽暗的古道，在那裡心靈於猜忌的地下墓穴中喪失了一統。 ",
      "encoded_ascii": "^.,^!'^)!^!8^2f^$k^&Z^\"=^(y^*A^\"d^)!^-j^#k^)g^$^^-'^;P^&Z^\"e^!(^6P^'&^!,^1)^\"|^*D^!%^'B^!\" ",
      "encoded_base64": "Xi4sXiEnXikhXiE4XjJmXiRrXiZaXiI9Xih5XipBXiJkXikhXi1qXiNrXilnXiReXi0nXjtQXiZaXiJlXiEoXjZQXicmXiEsXjEpXiJ8XipEXiElXidCXiEiIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_4330df87f866",
      "text": "猜忌的迷宮深處。",
      "encoded_ascii": "^-'^;P^&Z^(n^/\\^2*^(,^!\"",
      "encoded_base64": "Xi0nXjtQXiZaXihuXi9cXjIqXigsXiEi",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_8225423a7380",
      "text": "淤泥淹沒了海岸，吞噬了一切哀求。 ",
      "encoded_ascii": "^6c^%d^0l^%\\^*D^6`^>Y^*A^:-^:0^*D^!%^+.^2`^,n^!\" ",
      "encoded_base64": "XjZjXiVkXjBsXiVcXipEXjZgXj5ZXipBXjotXjowXipEXiElXisuXjJgXixuXiEiIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_0ed454b82ada",
      "text": "沒有安全的港灣。沒有棲身的孤島。",
      "encoded_ascii": "^%\\^$s^+p^!h^&Z^?z^?}^!\"^%\\^$s^,b^(c^&Z^2c^=)^!\"",
      "encoded_base64": "XiVcXiRzXitwXiFoXiZaXj96Xj99XiEiXiVcXiRzXixiXihjXiZaXjJjXj0pXiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_70002f78ce06",
      "text": "大地被受壓迫者的鮮血所染紅。 ",
      "encoded_ascii": "^\"z^\"e^(@^\";^4v^1`^'V^&Z^35^(:^$)^%%^3!^!\" ",
      "encoded_base64": "XiJ6XiJlXihAXiI7XjR2XjFgXidWXiZaXjM1Xig6XiQpXiUlXjMhXiEiIA==",
      "byte_length": 43
    },
    {
      "unit_id": "DLG_afd0b93218bc",
      "text": "險峰聳立在被劫掠一空的田野之上。",
      "encoded_ascii": "^*m^12^4_^0'^\"d^(@^1l^1<^!%^'(^&Z^;\\^.:^!/^!'^!\"",
      "encoded_base64": "XiptXjEyXjRfXjAnXiJkXihAXjFsXjE8XiElXicoXiZaXjtcXi46XiEvXiEnXiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_dfa5638f94b2",
      "text": "風之呼喚吹散了遮蔽的黃沙，並為幽影注入了生機。 ",
      "encoded_ascii": "^)y^!/^\"M^\"U^+A^$S^*D^(~^('^&Z^*7^%]^*A^!+^%{^2f^#a^%e^!f^*D^&F^%>^!\" ",
      "encoded_base64": "Xil5XiEvXiJNXiJVXitBXiRTXipEXih+XignXiZaXio3XiVdXipBXiErXiV7XjJmXiNhXiVlXiFmXipEXiZGXiU+XiEiIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_1853bb5610bd",
      "text": "賦予幽影以生命。",
      "encoded_ascii": "^(Y^!4^2f^#a^!B^&F^\"N^!\"",
      "encoded_base64": "XihZXiE0XjJmXiNhXiFCXiZGXiJOXiEi",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_468bd54dce0d",
      "text": "高舉可怖的雙手，以阻擋巨斧的劈落。",
      "encoded_ascii": "^*+^01^\"A^#p^&Z^)_^$+^*A^!B^)L^$G^#H^$Z^&Z^4t^-`^!\"",
      "encoded_base64": "XiorXjAxXiJBXiNwXiZaXilfXiQrXipBXiFCXilMXiRHXiNIXiRaXiZaXjR0Xi1gXiEi",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_795755ff14da",
      "text": "每一顆星辰，每一輪明月——皆歸於那可怖的森然對稱。",
      "encoded_ascii": "^%P^!%^)u^$e^@,^*A^%P^!%^(h^$c^/p^*n^*n^5j^%K^$^^)!^\"A^#p^&Z^4H^&\"^#:^0&^!\"",
      "encoded_base64": "XiVQXiElXil1XiRlXkAsXipBXiVQXiElXihoXiRjXi9wXipuXipuXjVqXiVLXiReXikhXiJBXiNwXiZaXjRIXiYiXiM6XjAmXiEi",
      "byte_length": 75
    },
    {
      "unit_id": "DLG_5297156ae00c",
      "text": "嫉妒明月的光華，惡狼以無盡的貪婪吞噬著牠們的輝芒。 ",
      "encoded_ascii": "^7*^7'^$c^/p^&Z^!c^3'^*A^#y^21^!B^%}^-1^&Z^1^^1-^:-^:0^-a^-#^*{^&Z^2K^'u^!\" ",
      "encoded_base64": "XjcqXjcnXiRjXi9wXiZaXiFjXjMnXipBXiN5XjIxXiFCXiV9Xi0xXiZaXjFeXjEtXjotXjowXi1hXi0jXip7XiZaXjJLXid1XiEiIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_8e92632b5208",
      "text": "如今盛宴已經擺開， ",
      "encoded_ascii": "^#$^*E^1L^1/^#J^'D^1@^)F^*A ",
      "encoded_base64": "XiMkXipFXjFMXjEvXiNKXidEXjFAXilGXipBIA==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_3bc199ac8985",
      "text": "獵物就在眼前。",
      "encoded_ascii": "^&;^&4^*J^\"d^&d^!z^!\"",
      "encoded_base64": "XiY7XiY0XipKXiJkXiZkXiF6XiEi",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_ea8990cfed1a",
      "text": "斬斷的鎖鏈與破碎的桎梏，乃是償付的代價。",
      "encoded_ascii": "^9B^,T^&Z^)8^)<^'p^&n^&o^&Z^3L^3M^*A^/M^,X^5-^*u^&Z^*v^+&^!\"",
      "encoded_base64": "XjlCXixUXiZaXik4Xik8XidwXiZuXiZvXiZaXjNMXjNNXipBXi9NXixYXjUtXip1XiZaXip2XismXiEi",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_5a037f482001",
      "text": "在人心之中鑄就的殘酷，終將在鐵砧之上被徹底擊碎。",
      "encoded_ascii": "^\"d^!<^#k^!/^!,^:?^*J^&Z^,l^1b^*A^-H^#7^\"d^)?^&m^!/^!'^(@^18^/^^$F^&o^!\"",
      "encoded_base64": "XiJkXiE8XiNrXiEvXiEsXjo/XipKXiZaXixsXjFiXipBXi1IXiM3XiJkXik/XiZtXiEvXiEnXihAXjE4Xi9eXiRGXiZvXiEi",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_9ae89071708d",
      "text": "命運的蛛網已然結就，蜘蛛正靜候獵物落入陷阱。 ",
      "encoded_ascii": "^\"N^.4^&Z^(0^'G^#J^&\"^'@^*J^*A^(1^(0^%H^)h^*|^&;^&4^-`^!f^)S^)J^!\" ",
      "encoded_base64": "XiJOXi40XiZaXigwXidHXiNKXiYiXidAXipKXipBXigxXigwXiVIXiloXip8XiY7XiY0Xi1gXiFmXilTXilKXiEiIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_e97a592ee5e0",
      "text": "冷酷而盲目，牠的獵物已然選定。",
      "encoded_ascii": "^!n^1b^'W^&_^&^^*A^-#^&Z^&;^&4^#J^&\"^.6^#.^!\"",
      "encoded_base64": "XiFuXjFiXidXXiZfXiZeXipBXi0jXiZaXiY7XiY0XiNKXiYiXi42XiMuXiEi",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_80fff46407cc",
      "text": "渴望追隨惡狼殘酷足跡的食腐烏鴉，正於牠們的巢穴中發出呼號。 ",
      "encoded_ascii": "^,w^,]^(o^)X^#y^21^,l^1b^(^^(`^&Z^0J^0/^/4^<|^*A^%H^$^^-#^*{^&Z^#G^'&^!,^&W^!q^\"M^(-^!\" ",
      "encoded_base64": "Xix3XixdXihvXilYXiN5XjIxXixsXjFiXiheXihgXiZaXjBKXjAvXi80Xjx8XipBXiVIXiReXi0jXip7XiZaXiNHXicmXiEsXiZXXiFxXiJNXigtXiEiIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_20df1272f516",
      "text": "發出陣陣嘶鳴。",
      "encoded_ascii": "^&W^!q^)P^)P^?s^.|^!\"",
      "encoded_base64": "XiZXXiFxXilQXilQXj9zXi58XiEi",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_6dfb4cdf5ee2",
      "text": "幽影欣然步入光明，脫胎於黑暗的義舉善始善終。 ",
      "encoded_ascii": "^2f^#a^2'^&\"^,i^!f^!c^$c^*A^'c^@(^$^^*:^$k^&Z^2<^01^1(^+k^1(^-H^!\" ",
      "encoded_base64": "XjJmXiNhXjInXiYiXixpXiFmXiFjXiRjXipBXidjXkAoXiReXio6XiRrXiZaXjI8XjAxXjEoXitrXjEoXi1IXiEiIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_e70914451917",
      "text": "功德圓滿。",
      "encoded_ascii": "^\"!^#j^\"a^,{^!\"",
      "encoded_base64": "XiIhXiNqXiJhXix7XiEi",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_5593f21f6ff3",
      "text": "惡狼的飢渴如陰影般籠罩——清晰可辨的無盡黑暗。",
      "encoded_ascii": "^#y^21^&Z^1d^,w^#$^6B^#a^'r^'3^'P^*n^*n^,u^71^\"A^6{^&Z^%}^-1^*:^$k^!\"",
      "encoded_base64": "XiN5XjIxXiZaXjFkXix3XiMkXjZCXiNhXidyXiczXidQXipuXipuXix1XjcxXiJBXjZ7XiZaXiV9Xi0xXio6XiRrXiEi",
      "byte_length": 69
    },
    {
      "unit_id": "DLG_2288039d8d55",
      "text": "盲目之人靜候著劊子手高懸的巨斧。",
      "encoded_ascii": "^&_^&^^!/^!<^)h^*|^-a^?&^#(^$+^*+^0a^&Z^#H^$Z^!\"",
      "encoded_base64": "XiZfXiZeXiEvXiE8XiloXip8Xi1hXj8mXiMoXiQrXiorXjBhXiZaXiNIXiRaXiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_35b155e40286",
      "text": "受盡煎熬的躁動心靈依然在劇烈搏動。",
      "encoded_ascii": "^\";^-1^?Y^<W^&Z^4\"^\"%^#k^)g^!Q^&\"^\"d^1#^%|^,K^\"%^!\"",
      "encoded_base64": "XiI7Xi0xXj9ZXjxXXiZaXjQiXiIlXiNrXilnXiFRXiYiXiJkXjEjXiV8XixLXiIlXiEi",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_9f6336fb4638",
      "text": "  你說的簡直不知所云！",
      "encoded_ascii": "  ^*F^-x^&Z^3y^&`^!)^&h^$)^?o^*W",
      "encoded_base64": "ICBeKkZeLXheJlpeM3leJmBeISleJmheJCleP29eKlc=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_82a85a634543",
      "text": "  別再打啞謎說謎語了。",
      "encoded_ascii": "  ^*H^!l^$-^:m^=w^-x^=w^0:^*D^!\"",
      "encoded_base64": "ICBeKkheIWxeJC1eOm1ePXdeLXhePXdeMDpeKkReISI=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_685da77915c2",
      "text": "  你究竟想表達什麼？",
      "encoded_ascii": "  ^*F^-<^28^,1^-i^(z^!=^.T^.V",
      "encoded_base64": "ICBeKkZeLTxeMjheLDFeLWleKHpeIT1eLlReLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_ad3080c851b0",
      "text": "從食腐烏鴉的喙間，吹來了一陣清風。",
      "encoded_ascii": "^#f^0J^0/^/4^<|^&Z^?r^)G^*A^+A^!O^*D^!%^)P^,u^)y^!\"",
      "encoded_base64": "XiNmXjBKXjAvXi80Xjx8XiZaXj9yXilHXipBXitBXiFPXipEXiElXilQXix1Xil5XiEi",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_0492c74a2c1c",
      "text": "真理的幽影徘徊於昔日輝煌如今淪為廢墟的殿堂之中。",
      "encoded_ascii": "^-2^&A^&Z^2f^#a^9X^9W^$^^<)^$a^2K^2.^#$^*E^2)^%{^#W^\"t^&Z^.m^42^!/^!,^!\"",
      "encoded_base64": "Xi0yXiZBXiZaXjJmXiNhXjlYXjlXXiReXjwpXiRhXjJLXjIuXiMkXipFXjIpXiV7XiNXXiJ0XiZaXi5tXjQyXiEvXiEsXiEi",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_8def26c7e658",
      "text": "命運之手將在你們的疑惑面前揭開面紗。",
      "encoded_ascii": "^\"N^.4^!/^$+^#7^\"d^*F^*{^&Z^0p^#x^)j^!z^$B^)F^)j^-G^!\"",
      "encoded_base64": "XiJOXi40XiEvXiQrXiM3XiJkXipGXip7XiZaXjBwXiN4XilqXiF6XiRCXilGXilqXi1HXiEi",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_2f64214425a3",
      "text": "最深沉的真理棲息於黑暗之中，親愛的幻象啊。",
      "encoded_ascii": "^$q^2*^%Z^&Z^-2^&A^,b^#w^$^^*:^$k^!/^!,^*A^(F^,2^&Z^#S^4g^+Q^!\"",
      "encoded_base64": "XiRxXjIqXiVaXiZaXi0yXiZBXixiXiN3XiReXio6XiRrXiEvXiEsXipBXihGXiwyXiZaXiNTXjRnXitRXiEi",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_552ba1518431",
      "text": "在黑夜的光芒之下不留半分陰翳——曾經的幽暗幻影，如今已然看個分明。 ",
      "encoded_ascii": "^\"d^*:^+c^&Z^!c^'u^!/^!(^!)^-+^\"-^!s^6B^@'^*n^*n^.j^'D^&Z^2f^$k^#S^#a^*A^#$^*E^#J^&\"^*Q^!V^!s^$c^!\" ",
      "encoded_base64": "XiJkXio6XitjXiZaXiFjXid1XiEvXiEoXiEpXi0rXiItXiFzXjZCXkAnXipuXipuXi5qXidEXiZaXjJmXiRrXiNTXiNhXipBXiMkXipFXiNKXiYiXipRXiFWXiFzXiRjXiEiIA==",
      "byte_length": 100
    },
    {
      "unit_id": "DLG_de5fe107cadc",
      "text": "真相昭然若揭。",
      "encoded_ascii": "^-2^&a^?w^&\"^'x^$B^!\"",
      "encoded_base64": "Xi0yXiZhXj93XiYiXid4XiRCXiEi",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_4911b42ff614",
      "text": "水井深邃，泉水清冽甘寒——飲水之時，你們又何須篩子？ ",
      "encoded_ascii": "^%V^!7^2*^6;^*A^%a^%V^,u^?p^/:^#1^*n^*n^){^%V^!/^$f^*A^*F^*{^+;^!L^)r^@\"^#(^.V ",
      "encoded_base64": "XiVWXiE3XjIqXjY7XipBXiVhXiVWXix1Xj9wXi86XiMxXipuXipuXil7XiVWXiEvXiRmXipBXipGXip7Xis7XiFMXilyXkAiXiMoXi5WIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_205377b29c71",
      "text": "何必畫蛇添足？",
      "encoded_ascii": "^!L^#l^-,^(/^5`^(^^.V",
      "encoded_base64": "XiFMXiNsXi0sXigvXjVgXiheXi5W",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_8de29e4567cd",
      "text": "信仰是一顆輕信的心靈，極易遭到欺瞞與踐踏。",
      "encoded_ascii": "^!U^4,^,X^!%^)u^(g^!U^&Z^#k^)g^*A^1D^,W^(}^!u^2r^?Z^'p^4h^.,^!\"",
      "encoded_base64": "XiFVXjQsXixYXiElXil1XihnXiFVXiZaXiNrXilnXipBXjFEXixXXih9XiF1XjJyXj9aXidwXjRoXi4sXiEi",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_7095779e0a3f",
      "text": "死神戴著諸多面具，為你們的使命提供助力。",
      "encoded_ascii": "^%L^&w^1:^-a^1]^\"x^)j^!k^*A^%{^*F^*{^&Z^!N^\"N^$A^!P^\"#^!~^!\"",
      "encoded_base64": "XiVMXiZ3XjE6Xi1hXjFdXiJ4XilqXiFrXipBXiV7XipGXip7XiZaXiFOXiJOXiRBXiFQXiIjXiF+XiEi",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_809eeea6ee75",
      "text": "迷失於狂舞的黃沙之中，惡狼不再苛求索取。",
      "encoded_ascii": "^(n^\"|^$^^&8^9s^&Z^*7^%]^!/^!,^*A^#y^21^!)^!l^;}^,n^'>^\":^!\"",
      "encoded_base64": "XihuXiJ8XiReXiY4XjlzXiZaXio3XiVdXiEvXiEsXipBXiN5XjIxXiEpXiFsXjt9XixuXic+XiI6XiEi",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_dc01990b4a80",
      "text": "荒原上的無盡足跡——隨波逐流者眾，開闢蹊徑者寡。",
      "encoded_ascii": "^1W^\"5^!'^&Z^%}^-1^(^^(`^*n^*n^)X^%c^(r^%j^'V^&e^*A^)F^?m^@*^#c^'V^8x^!\"",
      "encoded_base64": "XjFXXiI1XiEnXiZaXiV9Xi0xXiheXihgXipuXipuXilYXiVjXihyXiVqXidWXiZlXipBXilGXj9tXkAqXiNjXidWXjh4XiEi",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_3c833e045c83",
      "text": "恐懼孕育出殘酷的潰敗——切莫用淚水去澆灌那猜忌的種子。 ",
      "encoded_ascii": "^#t^$#^5H^5z^!q^,l^1b^&Z^2-^$R^*n^*n^+.^/F^&H^%m^%V^\"6^?{^0o^)!^-'^;P^&Z^'$^#(^!\" ",
      "encoded_base64": "XiN0XiQjXjVIXjV6XiFxXixsXjFiXiZaXjItXiRSXipuXipuXisuXi9GXiZIXiVtXiVWXiI2Xj97XjBvXikhXi0nXjtQXiZaXickXiMoXiEiIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_ccb54163da84",
      "text": "莫讓猜疑生根。",
      "encoded_ascii": "^/F^-}^-'^0p^&F^%)^!\"",
      "encoded_base64": "Xi9GXi19Xi0nXjBwXiZGXiUpXiEi",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_ecab1749483f",
      "text": "塔許！待在那裡別動，你這隻小黃鼠狼！",
      "encoded_ascii": "^\"o^-s^*W^,*^\"d^)!^-j^*H^\"%^*A^*F^(s^)[^#;^*7^*=^21^*W",
      "encoded_base64": "XiJvXi1zXipXXiwqXiJkXikhXi1qXipIXiIlXipBXipGXihzXilbXiM7Xio3Xio9XjIxXipX",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_db44c02951d6",
      "text": "不好意思，請千萬別把我的寵物黃鼠狼給放跑了。",
      "encoded_ascii": "^!)^+i^#z^#q^*A^*S^+7^-_^*H^$1^$%^&Z^6U^&4^*7^*=^21^'A^$P^(_^*D^!\"",
      "encoded_base64": "XiEpXitpXiN6XiNxXipBXipTXis3Xi1fXipIXiQxXiQlXiZaXjZVXiY0Xio3Xio9XjIxXidBXiRQXihfXipEXiEi",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_8bfba54c5f67",
      "text": "  黃鼠狼？我看倒像隻大老鼠。",
      "encoded_ascii": "  ^*7^*=^21^.V^$%^*Q^!X^!`^)[^\"z^'U^*=^!\"",
      "encoded_base64": "ICBeKjdeKj1eMjFeLlZeJCVeKlFeIVheIWBeKVteInpeJ1VeKj1eISI=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_6f35fe33d25f",
      "text": "  抱歉，我只是好奇而已。",
      "encoded_ascii": "  ^,@^,h^*A^$%^\"?^,X^+i^\"}^'W^#J^!\"",
      "encoded_base64": "ICBeLEBeLGheKkFeJCVeIj9eLFheK2leIn1eJ1deI0peISI=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_9f05e1fabd1f",
      "text": "牠只是個頭還沒長足罷了。等牠長大以後，肯定會是一隻威風漂亮的黃鼠狼。",
      "encoded_ascii": "^-#^\"?^,X^!V^)t^.7^%\\^)C^(^^1Q^*D^!\"^'-^-#^)C^\"z^!B^#b^*A^-Z^#.^$r^,X^!%^)[^#&^)y^,|^*t^&Z^*7^*=^21^!\"",
      "encoded_base64": "Xi0jXiI/XixYXiFWXil0Xi43XiVcXilDXiheXjFRXipEXiEiXictXi0jXilDXiJ6XiFCXiNiXipBXi1aXiMuXiRyXixYXiElXilbXiMmXil5Xix8Xip0XiZaXio3Xio9XjIxXiEi",
      "byte_length": 102
    },
    {
      "unit_id": "DLG_6491db2ddba3",
      "text": "那倒無所謂，但要是你被咬染上了狂犬病，可別跑來找我哭訴。",
      "encoded_ascii": "^)!^!X^%}^$)^0s^*A^!I^(C^,X^*F^(@^\"Q^%%^!'^*D^&8^&6^&R^*A^\"A^*H^(_^!O^$/^$%^/U^-t^!\"",
      "encoded_base64": "XikhXiFYXiV9XiQpXjBzXipBXiFJXihDXixYXipGXihAXiJRXiUlXiEnXipEXiY4XiY2XiZSXipBXiJBXipIXihfXiFPXiQvXiQlXi9VXi10XiEi",
      "byte_length": 84
    },
    {
      "unit_id": "DLG_f9c59911cbe5",
      "text": "抱歉，我正在值勤，沒空閒聊。",
      "encoded_ascii": "^,@^,h^*A^$%^%H^\"d^!Z^2Z^*A^%\\^'(^6A^-U^!\"",
      "encoded_base64": "XixAXixoXipBXiQlXiVIXiJkXiFaXjJaXipBXiVcXicoXjZBXi1VXiEi",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_830c132cda4f",
      "text": "借過一下，我必須在村子裡巡邏。如果你們發現了 ",
      "encoded_ascii": "^!Y^(x^!%^!(^*A^$%^#l^)r^\"d^$z^#(^-j^8g^8u^!\"^#$^%!^*F^*{^&W^&?^*D ",
      "encoded_base64": "XiFZXih4XiElXiEoXipBXiQlXiNsXilyXiJkXiR6XiMoXi1qXjhnXjh1XiEiXiMkXiUhXipGXip7XiZXXiY/XipEIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_9e288731b741",
      "text": "任何可疑的奸細探子，請立刻前來回報。",
      "encoded_ascii": "^!C^!L^\"A^0p^&Z^:2^'?^$>^#(^*A^*S^0'^.Y^!z^!O^\"\\^+`^!\"",
      "encoded_base64": "XiFDXiFMXiJBXjBwXiZaXjoyXic/XiQ+XiMoXipBXipTXjAnXi5ZXiF6XiFPXiJcXitgXiEi",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_b8cf581e80db",
      "text": "賈瑞克",
      "encoded_ascii": "^/J^/8^!d",
      "encoded_base64": "Xi9KXi84XiFk",
      "byte_length": 9
    },
    {
      "unit_id": "DLG_64ae0fee8587",
      "text": "加萊",
      "encoded_ascii": "^\"\"^(!",
      "encoded_base64": "XiIiXigh",
      "byte_length": 6
    },
    {
      "unit_id": "DLG_a1aedaacb612",
      "text": "伊圖哈",
      "encoded_ascii": "^!E^\"b^+F",
      "encoded_base64": "XiFFXiJiXitG",
      "byte_length": 9
    },
    {
      "unit_id": "DLG_6d8534dd8b2a",
      "text": "克維特卡",
      "encoded_ascii": "^!d^'F^&5^\"0",
      "encoded_base64": "XiFkXidGXiY1XiIw",
      "byte_length": 12
    },
    {
      "unit_id": "DLG_8c6ff22f2cb5",
      "text": "仁慈的領袖",
      "encoded_ascii": "^37^3H^&Z^)s^7G",
      "encoded_base64": "XjM3XjNIXiZaXilzXjdH",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_d1628bbbade2",
      "text": "旅人",
      "encoded_ascii": "^2m^!<",
      "encoded_base64": "XjJtXiE8",
      "byte_length": 6
    },
    {
      "unit_id": "DLG_ec740d315fc4",
      "text": "  你答應為我打造的盾牌做好了嗎？",
      "encoded_ascii": "  ^*F^-B^0`^%{^$%^$-^(v^&Z^&b^&2^*~^+i^*D^+X^.V",
      "encoded_base64": "ICBeKkZeLUJeMGBeJXteJCVeJC1eKHZeJlpeJmJeJjJeKn5eK2leKkReK1heLlY=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_4a25eb7bc408",
      "text": "  你叫什麼名字？",
      "encoded_ascii": "  ^*F^+<^!=^.T^\"F^#)^.V",
      "encoded_base64": "ICBeKkZeKzxeIT1eLlReIkZeIyleLlY=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_786ae8770eb2",
      "text": "  我相信你在戰鬥中也同樣作戰英勇。",
      "encoded_ascii": "  ^$%^&a^!U^*F^\"d^$(^*,^!,^!1^\"E^,f^!M^$(^'y^\"$^!\"",
      "encoded_base64": "ICBeJCVeJmFeIVVeKkZeImReJCheKixeISxeITFeIkVeLGZeIU1eJCheJ3leIiReISI=",
      "byte_length": 50
    },
    {
      "unit_id": "DLG_fb1ed188bac8",
      "text": "  戰鬥期間你都做了些什麼？",
      "encoded_ascii": "  ^$(^*,^$u^)G^*F^)$^*~^*D^!8^!=^.T^.V",
      "encoded_base64": "ICBeJCheKixeJHVeKUdeKkZeKSReKn5eKkReITheIT1eLlReLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_7aaea5570c25",
      "text": "  關於那支暗影大軍，你看到了什麼？",
      "encoded_ascii": "  ^.>^$^^)!^$L^$k^#a^\"z^..^*A^*F^*Q^!u^*D^!=^.T^.V",
      "encoded_base64": "ICBeLj5eJF5eKSFeJExeJGteI2FeInpeLi5eKkFeKkZeKlFeIXVeKkReIT1eLlReLlY=",
      "byte_length": 50
    },
    {
      "unit_id": "DLG_c34b1fe42c05",
      "text": "  目前備戰工作進展如何？",
      "encoded_ascii": "  ^&^^!z^+\"^$(^+y^!M^(w^+x^#$^!L^.V",
      "encoded_base64": "ICBeJl5eIXpeKyJeJCheK3leIU1eKHdeK3heIyReIUxeLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_548090eaa096",
      "text": "  這座村莊附近都有些什麼？",
      "encoded_ascii": "  ^(s^/_^$z^6l^.?^(l^)$^$s^!8^!=^.T^.V",
      "encoded_base64": "ICBeKHNeL19eJHpeNmxeLj9eKGxeKSReJHNeITheIT1eLlReLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_5bca0737057a",
      "text": "  你知道去哪裡能找到其他村莊嗎？",
      "encoded_ascii": "  ^*F^&h^(y^\"6^+I^-j^'b^$/^!u^!j^!@^$z^6l^+X^.V",
      "encoded_base64": "ICBeKkZeJmheKHleIjZeK0leLWpeJ2JeJC9eIXVeIWpeIUBeJHpeNmxeK1heLlY=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_fd991a41b6aa",
      "text": "  這裡的水源似乎相當充沛。",
      "encoded_ascii": "  ^(s^-j^&Z^%V^%q^!H^!0^&a^&N^5.^8I^!\"",
      "encoded_base64": "ICBeKHNeLWpeJlpeJVZeJXFeIUheITBeJmFeJk5eNS5eOEleISI=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_07adda59b4e4",
      "text": "  你對那位預言者怎麼看？",
      "encoded_ascii": "  ^*F^#:^)!^!J^.E^1Y^'V^,,^.T^*Q^.V",
      "encoded_base64": "ICBeKkZeIzpeKSFeIUpeLkVeMVleJ1ZeLCxeLlReKlFeLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_189c272e0650",
      "text": "  跟我談談你們的領袖吧？",
      "encoded_ascii": "  ^.+^$%^0;^0;^*F^*{^&Z^)s^7G^*I^.V",
      "encoded_base64": "ICBeLiteJCVeMDteMDteKkZeKnteJlpeKXNeN0deKkleLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_1d094a0076bf",
      "text": "你們就是預言裡提到的那些英雄，對吧？我早就聽說你們要來了。",
      "encoded_ascii": "^*F^*{^*J^,X^.E^1Y^-j^$A^!u^&Z^)!^!8^'y^)\\^*A^#:^*I^.V^$%^,V^*J^-X^-x^*F^*{^(C^!O^*D^!\"",
      "encoded_base64": "XipGXip7XipKXixYXi5FXjFZXi1qXiRBXiF1XiZaXikhXiE4Xid5XilcXipBXiM6XipJXi5WXiQlXixWXipKXi1YXi14XipGXip7XihDXiFPXipEXiEi",
      "byte_length": 87
    },
    {
      "unit_id": "DLG_0d9a904e594e",
      "text": "我平時不太跟外地人說話，但多米尼說過你們信得過。",
      "encoded_ascii": "^$%^0Y^$f^!)^+f^.+^\"w^\"e^!<^-x^-v^*A^!I^\"x^'4^#>^-x^(x^*F^*{^!U^#e^(x^!\"",
      "encoded_base64": "XiQlXjBZXiRmXiEpXitmXi4rXiJ3XiJlXiE8Xi14Xi12XipBXiFJXiJ4Xic0XiM+Xi14Xih4XipGXip7XiFVXiNlXih4XiEi",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_a0c900a56080",
      "text": "我終於見到了大家都在談論的大英雄。你們來得可真是太及時了。",
      "encoded_ascii": "^$%^-H^$^^-m^!u^*D^\"z^+s^)$^\"d^0;^1\\^&Z^\"z^'y^)\\^!\"^*F^*{^!O^#e^\"A^-2^,X^+f^\"7^$f^*D^!\"",
      "encoded_base64": "XiQlXi1IXiReXi1tXiF1XipEXiJ6XitzXikkXiJkXjA7XjFcXiZaXiJ6Xid5XilcXiEiXipGXip7XiFPXiNlXiJBXi0yXixYXitmXiI3XiRmXipEXiEi",
      "byte_length": 87
    },
    {
      "unit_id": "DLG_9123969f1838",
      "text": "很高興認識你， ",
      "encoded_ascii": "^*K^*+^-]^(O^(R^*F^*A ",
      "encoded_base64": "XipLXiorXi1dXihPXihSXipGXipBIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_1797313b12a6",
      "text": "掌井人。",
      "encoded_ascii": "^$;^!7^!<^!\"",
      "encoded_base64": "XiQ7XiE3XiE8XiEi",
      "byte_length": 12
    },
    {
      "unit_id": "DLG_d0b8a0f48520",
      "text": "我的名字是 ",
      "encoded_ascii": "^$%^&Z^\"F^#)^,X ",
      "encoded_base64": "XiQlXiZaXiJGXiMpXixYIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_77b164c69b83",
      "text": "我正在 ",
      "encoded_ascii": "^$%^%H^\"d ",
      "encoded_base64": "XiQlXiVIXiJkIA==",
      "byte_length": 10
    },
    {
      "unit_id": "DLG_ea0d5183f98c",
      "text": "製作家具好與其他村莊進行貿易。副官說這會讓我們發家致富。",
      "encoded_ascii": "^(B^!M^+s^!k^+i^'p^!j^!@^$z^6l^(w^(;^6/^,W^!\"^52^#-^-x^(s^$r^-}^$%^*{^&W^+s^'o^3C^!\"",
      "encoded_base64": "XihCXiFNXitzXiFrXitpXidwXiFqXiFAXiR6XjZsXih3Xig7XjYvXixXXiEiXjUyXiMtXi14XihzXiRyXi19XiQlXip7XiZXXitzXidvXjNDXiEi",
      "byte_length": 84
    },
    {
      "unit_id": "DLG_3e09ebf71c43",
      "text": "製作一面盾牌",
      "encoded_ascii": "^(B^!M^!%^)j^&b^&2",
      "encoded_base64": "XihCXiFNXiElXilqXiZiXiYy",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_26f66ed8bcda",
      "text": "等我做好了，你想拿去用嗎？",
      "encoded_ascii": "^'-^$%^*~^+i^*D^*A^*F^,1^,G^\"6^&H^+X^.V",
      "encoded_base64": "XictXiQlXip+XitpXipEXipBXipGXiwxXixHXiI2XiZIXitYXi5W",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_0a29d3325c35",
      "text": "我再過一會兒就能完工了。",
      "encoded_ascii": "^$%^!l^(x^!%^$r^++^*J^'b^#,^+y^*D^!\"",
      "encoded_base64": "XiQlXiFsXih4XiElXiRyXisrXipKXidiXiMsXit5XipEXiEi",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_5c5f56e4e63b",
      "text": "給查爾用。戰士們需要盡可能多的防護。",
      "encoded_ascii": "^'A^%&^&/^&H^!\"^$(^+a^*{^)e^(C^-1^\"A^'b^\"x^&Z^)K^(T^!\"",
      "encoded_base64": "XidBXiUmXiYvXiZIXiEiXiQoXithXip7XillXihDXi0xXiJBXidiXiJ4XiZaXilLXihUXiEi",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_814a94e1cfc8",
      "text": "製作一個 ",
      "encoded_ascii": "^(B^!M^!%^!V ",
      "encoded_base64": "XihCXiFNXiElXiFWIA==",
      "byte_length": 13
    },
    {
      "unit_id": "DLG_49011ba6ef18",
      "text": "扶壁",
      "encoded_ascii": "^@2^*\\",
      "encoded_base64": "XkAyXipc",
      "byte_length": 6
    },
    {
      "unit_id": "DLG_c3569e6f2023",
      "text": "突緣",
      "encoded_ascii": "^'*^9J",
      "encoded_base64": "XicqXjlK",
      "byte_length": 6
    },
    {
      "unit_id": "DLG_dd0b3d37428e",
      "text": " 來加固大門。 ",
      "encoded_ascii": " ^!O^\"\"^3>^\"z^)D^!\" ",
      "encoded_base64": "IF4hT14iIl4zPl4iel4pRF4hIiA=",
      "byte_length": 20
    },
    {
      "unit_id": "DLG_59915a021ced",
      "text": "它在戰鬥中受損了。",
      "encoded_ascii": "^+o^\"d^$(^*,^!,^\";^$D^*D^!\"",
      "encoded_base64": "XitvXiJkXiQoXiosXiEsXiI7XiREXipEXiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_b5ca17b8b610",
      "text": "我們的領袖認為它擋不住正面的強攻。",
      "encoded_ascii": "^$%^*{^&Z^)s^7G^(O^%{^+o^$G^!)^*z^%H^)j^&Z^#]^$O^!\"",
      "encoded_base64": "XiQlXip7XiZaXilzXjdHXihPXiV7XitvXiRHXiEpXip6XiVIXilqXiZaXiNdXiRPXiEi",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_289cca62308e",
      "text": "刷洗這上面的污漬。 ",
      "encoded_ascii": "^>H^0j^(s^!'^)j^&Z^0h^@5^!\" ",
      "encoded_base64": "Xj5IXjBqXihzXiEnXilqXiZaXjBoXkA1XiEiIA==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_b8b2b44d40de",
      "text": "所有的狂歡慶祝都是要付出代價的。",
      "encoded_ascii": "^$)^$s^&Z^&8^%F^5P^&v^)$^,X^(C^*u^!q^*v^+&^&Z^!\"",
      "encoded_base64": "XiQpXiRzXiZaXiY4XiVGXjVQXiZ2XikkXixYXihDXip1XiFxXip2XismXiZaXiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_ff577de33875",
      "text": "那個預言者的邋遢邋遢程度，簡直跟他扭曲瘋癲的心智不相上下。",
      "encoded_ascii": "^)!^!V^.E^1Y^'V^&Z^>G^>F^>G^>F^'#^#V^*A^3y^&`^.+^!@^1;^$n^-/^4Y^&Z^#k^$i^!)^&a^!'^!(^!\"",
      "encoded_base64": "XikhXiFWXi5FXjFZXidWXiZaXj5HXj5GXj5HXj5GXicjXiNWXipBXjN5XiZgXi4rXiFAXjE7XiRuXi0vXjRZXiZaXiNrXiRpXiEpXiZhXiEnXiEoXiEi",
      "byte_length": 87
    },
    {
      "unit_id": "DLG_5548baca0ff6",
      "text": "為 ",
      "encoded_ascii": "^%{ ",
      "encoded_base64": "XiV7IA==",
      "byte_length": 4
    },
    {
      "unit_id": "DLG_e2e6b56d5dfc",
      "text": "議會",
      "encoded_ascii": "^-|^$r",
      "encoded_base64": "Xi18XiRy",
      "byte_length": 6
    },
    {
      "unit_id": "DLG_a4bae55f681a",
      "text": "他們正",
      "encoded_ascii": "^!@^*{^%H",
      "encoded_base64": "XiFAXip7XiVI",
      "byte_length": 9
    },
    {
      "unit_id": "DLG_a28665c10ab9",
      "text": "預言者",
      "encoded_ascii": "^.E^1Y^'V",
      "encoded_base64": "Xi5FXjFZXidW",
      "byte_length": 9
    },
    {
      "unit_id": "DLG_60f0c4a47fa7",
      "text": "他正",
      "encoded_ascii": "^!@^%H",
      "encoded_base64": "XiFAXiVI",
      "byte_length": 6
    },
    {
      "unit_id": "DLG_816161401535",
      "text": "的桌子進行拋光擦拭。 ",
      "encoded_ascii": "^&Z^/q^#(^(w^(;^,A^!c^4C^@3^!\" ",
      "encoded_base64": "XiZaXi9xXiMoXih3Xig7XixBXiFjXjRDXkAzXiEiIA==",
      "byte_length": 31
    },
    {
      "unit_id": "DLG_84ad2c1d5a5d",
      "text": " 籌劃為戰士們舉辦一場慶功宴。",
      "encoded_ascii": " ^:W^4s^%{^$(^+a^*{^01^2L^!%^\"n^5P^\"!^1/^!\"",
      "encoded_base64": "IF46V140c14le14kKF4rYV4qe14wMV4yTF4hJV4ibl41UF4iIV4xL14hIg==",
      "byte_length": 43
    },
    {
      "unit_id": "DLG_b16f3916af9b",
      "text": "擦洗這副護甲。每個人都想在德拉吉大軍面前顯得體面威武， ",
      "encoded_ascii": "^4C^0j^(s^52^(T^&J^!\"^%P^!V^!<^)$^,1^\"d^#j^$6^\"D^\"z^..^)j^!z^4&^#e^**^)j^#&^%J^*A ",
      "encoded_base64": "XjRDXjBqXihzXjUyXihUXiZKXiEiXiVQXiFWXiE8XikkXiwxXiJkXiNqXiQ2XiJEXiJ6Xi4uXilqXiF6XjQmXiNlXioqXilqXiMmXiVKXipBIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_439545daca6f",
      "text": "彷彿當你死在黃沙堆裡的時候，身上穿得好看不好看 ",
      "encoded_ascii": "^.a^.b^&N^*F^%L^\"d^*7^%]^*[^-j^&Z^$f^*|^*A^(c^!'^')^#e^+i^*Q^!)^+i^*Q ",
      "encoded_base64": "Xi5hXi5iXiZOXipGXiVMXiJkXio3XiVdXipbXi1qXiZaXiRmXip8XipBXihjXiEnXicpXiNlXitpXipRXiEpXitpXipRIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_d08f0a1d57d0",
      "text": "還有半點意義似的！",
      "encoded_ascii": "^.7^$s^\"-^*;^#z^2<^!H^&Z^*W",
      "encoded_base64": "Xi43XiRzXiItXio7XiN6XjI8XiFIXiZaXipX",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_470dfaea28c6",
      "text": " 的到來大受歡迎。我只希望他們動起手來能像他們長得那樣威猛凶悍。",
      "encoded_ascii": " ^&Z^!u^!O^\"z^\";^%F^(k^!\"^$%^\"?^+{^,]^!@^*{^\"%^.(^$+^!O^'b^!`^!@^*{^)C^#e^)!^,f^#&^*P^3e^,-^!\"",
      "encoded_base64": "IF4mWl4hdV4hT14iel4iO14lRl4oa14hIl4kJV4iP14re14sXV4hQF4qe14iJV4uKF4kK14hT14nYl4hYF4hQF4qe14pQ14jZV4pIV4sZl4jJl4qUF4zZV4sLV4hIg==",
      "byte_length": 94
    },
    {
      "unit_id": "DLG_b2ba12dae0a8",
      "text": "即便有",
      "encoded_ascii": "^\"1^!R^$s",
      "encoded_base64": "XiIxXiFSXiRz",
      "byte_length": 9
    },
    {
      "unit_id": "DLG_53be562d6655",
      "text": "助陣，局勢依然對我們極為不利。據說德拉吉已經屠戮了兩座村莊。",
      "encoded_ascii": "^\"#^)P^*A^._^\"&^!Q^&\"^#:^$%^*{^1D^%{^!)^!t^!\"^5T^-x^#j^$6^\"D^#J^'D^#A^,:^*D^!i^/_^$z^6l^!\"",
      "encoded_base64": "XiIjXilQXipBXi5fXiImXiFRXiYiXiM6XiQlXip7XjFEXiV7XiEpXiF0XiEiXjVUXi14XiNqXiQ2XiJEXiNKXidEXiNBXiw6XipEXiFpXi9fXiR6XjZsXiEi",
      "byte_length": 90
    },
    {
      "unit_id": "DLG_f546ee4b1aba",
      "text": "副官抓到了一個偽裝成覆面同盟成員的奸細。你們不用再擔心 ",
      "encoded_ascii": "^52^#-^$2^!u^*D^!%^!V^6J^(A^$$^(D^)j^\"E^-0^$$^+G^&Z^:2^'?^!\"^*F^*{^!)^&H^!l^*N^#k ",
      "encoded_base64": "XjUyXiMtXiQyXiF1XipEXiElXiFWXjZKXihBXiQkXihEXilqXiJFXi0wXiQkXitHXiZaXjoyXic/XiEiXipGXip7XiEpXiZIXiFsXipOXiNrIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_4676bc5c6e27",
      "text": "他會把我們新結盟的消息帶回給德拉吉了。",
      "encoded_ascii": "^!@^$r^$1^$%^*{^$\\^'@^-0^&Z^%k^#w^#N^\"\\^'A^#j^$6^\"D^*D^!\"",
      "encoded_base64": "XiFAXiRyXiQxXiQlXip7XiRcXidAXi0wXiZaXiVrXiN3XiNOXiJcXidBXiNqXiQ2XiJEXipEXiEi",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_5cd17b159f34",
      "text": "如今既然",
      "encoded_ascii": "^#$^*E^,U^&\"",
      "encoded_base64": "XiMkXipFXixVXiYi",
      "byte_length": 12
    },
    {
      "unit_id": "DLG_0881ae7565d3",
      "text": " 已經趕到，我們至少有了一線作戰的生機。",
      "encoded_ascii": " ^#J^'D^0u^!u^*A^$%^*{^'n^#<^$s^*D^!%^'I^!M^$(^&Z^&F^%>^!\"",
      "encoded_base64": "IF4jSl4nRF4wdV4hdV4qQV4kJV4qe14nbl4jPF4kc14qRF4hJV4nSV4hTV4kKF4mWl4mRl4lPl4hIg==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_1cf6e0401103",
      "text": "我們全完了！我聽說德拉吉大軍有整整十萬人馬，甚至可能有二十萬！",
      "encoded_ascii": "^$%^*{^!h^#,^*D^*W^$%^-X^-x^#j^$6^\"D^\"z^..^$s^$T^$T^*Y^-_^!<^*\"^*A^/|^'n^\"A^'b^$s^!5^*Y^-_^*W",
      "encoded_base64": "XiQlXip7XiFoXiMsXipEXipXXiQlXi1YXi14XiNqXiQ2XiJEXiJ6Xi4uXiRzXiRUXiRUXipZXi1fXiE8XioiXipBXi98XiduXiJBXidiXiRzXiE1XipZXi1fXipX",
      "byte_length": 93
    },
    {
      "unit_id": "DLG_10723c0f6956",
      "text": "預言已然應驗在我們頭上了！德拉吉大軍正開拔前來毀滅我們，無人能擋得住他們！",
      "encoded_ascii": "^.E^1Y^#J^&\"^0`^.P^\"d^$%^*{^)t^!'^*D^*W^#j^$6^\"D^\"z^..^%H^)F^/c^!z^!O^%N^%t^$%^*{^*A^%}^!<^'b^$G^#e^*z^!@^*{^*W",
      "encoded_base64": "Xi5FXjFZXiNKXiYiXjBgXi5QXiJkXiQlXip7Xil0XiEnXipEXipXXiNqXiQ2XiJEXiJ6Xi4uXiVIXilGXi9jXiF6XiFPXiVOXiV0XiQlXip7XipBXiV9XiE8XidiXiRHXiNlXip6XiFAXip7XipX",
      "byte_length": 111
    },
    {
      "unit_id": "DLG_b07292013bae",
      "text": "眼下除了拚死一戰別無他法！德拉吉大軍正步步逼近，我敢發誓，整個 ",
      "encoded_ascii": "^&d^!(^)Q^*D^,C^%L^!%^$(^*H^%}^!@^%b^*W^#j^$6^\"D^\"z^..^%H^,i^,i^.1^(l^*A^$%^/m^&W^-w^*A^$T^!V ",
      "encoded_base64": "XiZkXiEoXilRXipEXixDXiVMXiElXiQoXipIXiV9XiFAXiViXipXXiNqXiQ2XiJEXiJ6Xi4uXiVIXixpXixpXi4xXihsXipBXiQlXi9tXiZXXi13XipBXiRUXiFWIA==",
      "byte_length": 94
    },
    {
      "unit_id": "DLG_3d0d80d7c8a8",
      "text": "亞薩斯的所有戰士全都在他們的隊列之中。",
      "encoded_ascii": "^!9^-e^$[^&Z^$)^$s^$(^+a^!h^)$^\"d^!@^*{^&Z^)U^8f^!/^!,^!\"",
      "encoded_base64": "XiE5Xi1lXiRbXiZaXiQpXiRzXiQoXithXiFoXikkXiJkXiFAXip7XiZaXilVXjhmXiEvXiEsXiEi",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_fa69d5691dfa",
      "text": "你們締結的這場同盟給了我希望。我做夢也沒想過各個村莊竟然能夠團結一致。 ",
      "encoded_ascii": "^*F^*{^?6^'@^&Z^(s^\"n^\"E^-0^'A^*D^$%^+{^,]^!\"^$%^*~^\"y^!1^%\\^,1^(x^+>^!V^$z^6l^28^&\"^'b^+d^0V^'@^!%^'o^!\" ",
      "encoded_base64": "XipGXip7Xj82XidAXiZaXihzXiJuXiJFXi0wXidBXipEXiQlXit7XixdXiEiXiQlXip+XiJ5XiExXiVcXiwxXih4Xis+XiFWXiR6XjZsXjI4XiYiXidiXitkXjBWXidAXiElXidvXiEiIA==",
      "byte_length": 106
    },
    {
      "unit_id": "DLG_f0b2fff51c22",
      "text": "現在看來任何奇蹟都有可能發生了！",
      "encoded_ascii": "^&?^\"d^*Q^!O^!C^!L^\"}^0B^)$^$s^\"A^'b^&W^&F^*D^*W",
      "encoded_base64": "XiY/XiJkXipRXiFPXiFDXiFMXiJ9XjBCXikkXiRzXiJBXidiXiZXXiZGXipEXipX",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_9bc445665ae3",
      "text": "局勢已經脫離我們的掌控了。德拉吉大軍幾乎已經兵臨城下了！我實在 ",
      "encoded_ascii": "^._^\"&^#J^'D^'c^)`^$%^*{^&Z^$;^$@^*D^!\"^#j^$6^\"D^\"z^..^#T^!0^#J^'D^+,^1U^+_^!(^*D^*W^$%^#3^\"d ",
      "encoded_base64": "Xi5fXiImXiNKXidEXidjXilgXiQlXip7XiZaXiQ7XiRAXipEXiEiXiNqXiQ2XiJEXiJ6Xi4uXiNUXiEwXiNKXidEXissXjFVXitfXiEoXipEXipXXiQlXiMzXiJkIA==",
      "byte_length": 94
    },
    {
      "unit_id": "DLG_a1a742d5dbaa",
      "text": "不認為我們擁有足夠的力量能抵擋住這場猛攻。",
      "encoded_ascii": "^!)^(O^%{^$%^*{^,M^$s^(^^+d^&Z^!~^)*^'b^$5^$G^*z^(s^\"n^*P^$O^!\"",
      "encoded_base64": "XiEpXihPXiV7XiQlXip7XixNXiRzXiheXitkXiZaXiF+XikqXidiXiQ1XiRHXip6XihzXiJuXipQXiRPXiEi",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_79a85236b043",
      "text": "要是你們找不到盟友，這場仗根本撐不了多久！德拉吉大軍會像狂風般 ",
      "encoded_ascii": "^(C^,X^*F^*{^$/^!)^!u^-0^\"8^*A^(s^\"n^0|^%)^$x^,L^!)^*D^\"x^!.^*W^#j^$6^\"D^\"z^..^$r^!`^&8^)y^'r ",
      "encoded_base64": "XihDXixYXipGXip7XiQvXiEpXiF1Xi0wXiI4XipBXihzXiJuXjB8XiUpXiR4XixMXiEpXipEXiJ4XiEuXipXXiNqXiQ2XiJEXiJ6Xi4uXiRyXiFgXiY4Xil5XidyIA==",
      "byte_length": 94
    },
    {
      "unit_id": "DLG_3f1b13efcb07",
      "text": "碾碎我們，甚至連眼都不會眨一下。",
      "encoded_ascii": "^0$^&o^$%^*{^*A^/|^'n^.0^&d^)$^!)^$r^;F^!%^!(^!\"",
      "encoded_base64": "XjAkXiZvXiQlXip7XipBXi98XiduXi4wXiZkXikkXiEpXiRyXjtGXiElXiEoXiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_11b341154224",
      "text": "我們用不了多久就能好好招待德拉吉的那幫雜種了！ ",
      "encoded_ascii": "^$%^*{^&H^!)^*D^\"x^!.^*J^'b^+i^+i^,D^,*^#j^$6^\"D^&Z^)!^+}^0G^'$^*D^*W ",
      "encoded_base64": "XiQlXip7XiZIXiEpXipEXiJ4XiEuXipKXidiXitpXitpXixEXiwqXiNqXiQ2XiJEXiZaXikhXit9XjBHXickXipEXipXIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_f09ba33c0e47",
      "text": "副官已經把斥候探子全都撒出去了。",
      "encoded_ascii": "^52^#-^#J^'D^$1^,S^*|^$>^#(^!h^)$^<>^!q^\"6^*D^!\"",
      "encoded_base64": "XjUyXiMtXiNKXidEXiQxXixTXip8XiQ+XiMoXiFoXikkXjw+XiFxXiI2XipEXiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_f057221df12d",
      "text": "我們正在竭盡所能——打造武器並加固防禦工事，但我們全都 ",
      "encoded_ascii": "^$%^*{^%H^\"d^29^-1^$)^'b^*n^*n^$-^(v^%J^\"V^!+^\"\"^3>^)K^&{^+y^*r^*A^!I^$%^*{^!h^)$ ",
      "encoded_base64": "XiQlXip7XiVIXiJkXjI5Xi0xXiQpXidiXipuXipuXiQtXih2XiVKXiJWXiErXiIiXjM+XilLXiZ7Xit5XipyXipBXiFJXiQlXip7XiFoXikkIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_acd8c929ad11",
      "text": "仰仗你們去爭取各方盟友前來支援。",
      "encoded_ascii": "^4,^0|^*F^*{^\"6^1I^\":^+>^$]^-0^\"8^!z^!O^$L^$C^!\"",
      "encoded_base64": "XjQsXjB8XipGXip7XiI2XjFJXiI6Xis+XiRdXi0wXiI4XiF6XiFPXiRMXiRDXiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_62dc1e251bb1",
      "text": "那些聖堂武士以為能像割草一樣輕易掃蕩孤立的村莊，但你們為我們爭取到的 ",
      "encoded_ascii": "^)!^!8^'Z^42^%J^+a^!B^%{^'b^!`^+1^*f^!%^,f^(g^,W^:p^1X^2c^0'^&Z^$z^6l^*A^!I^*F^*{^%{^$%^*{^1I^\":^!u^&Z ",
      "encoded_base64": "XikhXiE4XidaXjQyXiVKXithXiFCXiV7XidiXiFgXisxXipmXiElXixmXihnXixXXjpwXjFYXjJjXjAnXiZaXiR6XjZsXipBXiFJXipGXip7XiV7XiQlXip7XjFJXiI6XiF1XiZaIA==",
      "byte_length": 103
    },
    {
      "unit_id": "DLG_41f72f97381c",
      "text": "強大同盟，一定會給他們好好上一課！",
      "encoded_ascii": "^#]^\"z^\"E^-0^*A^!%^#.^$r^'A^!@^*{^+i^+i^!'^!%^:$^*W",
      "encoded_base64": "XiNdXiJ6XiJFXi0wXipBXiElXiMuXiRyXidBXiFAXip7XitpXitpXiEnXiElXjokXipX",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_ffe27c9b7d77",
      "text": "我們已經開始在村莊城牆外修築護牆壁壘了。我敢說， ",
      "encoded_ascii": "^$%^*{^#J^'D^)F^+k^\"d^$z^6l^+_^&0^\"w^.~^8;^(T^&0^*\\^\"u^*D^!\"^$%^/m^-x^*A ",
      "encoded_base64": "XiQlXip7XiNKXidEXilGXitrXiJkXiR6XjZsXitfXiYwXiJ3Xi5+Xjg7XihUXiYwXipcXiJ1XipEXiEiXiQlXi9tXi14XipBIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_490ac93b5af6",
      "text": "提奎茲爾還從未見過如此熱火朝天的備戰場面。",
      "encoded_ascii": "^$A^5B^/D^&/^.7^#f^,_^-m^(x^#$^%I^&$^%x^,^^+e^&Z^+\"^$(^\"n^)j^!\"",
      "encoded_base64": "XiRBXjVCXi9EXiYvXi43XiNmXixfXi1tXih4XiMkXiVJXiYkXiV4XixeXitlXiZaXisiXiQoXiJuXilqXiEi",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_8b7d6cf29e41",
      "text": "來自各地的勇士 ",
      "encoded_ascii": "^!O^'l^+>^\"e^&Z^\"$^+a ",
      "encoded_base64": "XiFPXidsXis+XiJlXiZaXiIkXithIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_25547b5f5528",
      "text": "你們是在尋求挑戰嗎？塞德里爾特的人都在談論西南方那座火山周圍的寶石礦脈。 ",
      "encoded_ascii": "^*F^*{^,X^\"d^#9^,n^,H^$(^+X^.V^/(^#j^)(^&/^&5^&Z^!<^)$^\"d^0;^1\\^-l^\"/^$]^)!^/_^%x^11^\"L^\"`^&Z^#4^&k^5m^6i^!\" ",
      "encoded_base64": "XipGXip7XixYXiJkXiM5XixuXixIXiQoXitYXi5WXi8oXiNqXikoXiYvXiY1XiZaXiE8XikkXiJkXjA7XjFcXi1sXiIvXiRdXikhXi9fXiV4XjExXiJMXiJgXiZaXiM0XiZrXjVtXjZpXiEiIA==",
      "byte_length": 109
    },
    {
      "unit_id": "DLG_95257d60ad88",
      "text": "不過那裡怪物橫行。如果你們膽敢前去，要麼一夜暴富，要麼命喪黃泉。",
      "encoded_ascii": "^!)^(x^)!^-j^#s^&4^/2^(;^!\"^#$^%!^*F^*{^-[^/m^!z^\"6^*A^(C^.T^!%^+c^$m^3C^*A^(C^.T^\"N^1)^*7^%a^!\"",
      "encoded_base64": "XiEpXih4XikhXi1qXiNzXiY0Xi8yXig7XiEiXiMkXiUhXipGXip7Xi1bXi9tXiF6XiI2XipBXihDXi5UXiElXitjXiRtXjNDXipBXihDXi5UXiJOXjEpXio3XiVhXiEi",
      "byte_length": 96
    },
    {
      "unit_id": "DLG_af867723aa1a",
      "text": "外面大多都是茫茫沙海，不過我們這裡曾經來過一位訪客，他說西方綠洲那邊 ",
      "encoded_ascii": "^\"w^)j^\"z^\"x^)$^,X^9L^9L^%]^6`^*A^!)^(x^$%^*{^(s^-j^.j^'D^!O^(x^!%^!J^4d^+q^*A^!@^-x^-l^$]^3V^76^)!^.8 ",
      "encoded_base64": "XiJ3XilqXiJ6XiJ4XikkXixYXjlMXjlMXiVdXjZgXipBXiEpXih4XiQlXip7XihzXi1qXi5qXidEXiFPXih4XiElXiFKXjRkXitxXipBXiFAXi14Xi1sXiRdXjNWXjc2XikhXi44IA==",
      "byte_length": 103
    },
    {
      "unit_id": "DLG_971a0c19427d",
      "text": "正遭受著漫天蟲群的嚴重騷擾。",
      "encoded_ascii": "^%H^(}^\";^-a^2,^+e^(8^'R^&Z^1*^))^0y^$K^!\"",
      "encoded_base64": "XiVIXih9XiI7Xi1hXjIsXitlXig4XidSXiZaXjEqXikpXjB5XiRLXiEi",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_ed3686e7be65",
      "text": "在我們村子的東面和北面，都曾頻繁目擊到瑪格拉巨怪出沒。",
      "encoded_ascii": "^\"d^$%^*{^$z^#(^&Z^,`^)j^\"O^+6^)j^*A^)$^.j^=z^-N^&^^$F^!u^-*^%*^$6^#H^#s^!q^%\\^!\"",
      "encoded_base64": "XiJkXiQlXip7XiR6XiMoXiZaXixgXilqXiJPXis2XilqXipBXikkXi5qXj16Xi1OXiZeXiRGXiF1Xi0qXiUqXiQ2XiNIXiNzXiFxXiVcXiEi",
      "byte_length": 81
    },
    {
      "unit_id": "DLG_c097db7751ae",
      "text": "我所聽說過的就只有蓋德隆村了。我想那應該是在西北方的某個地方。",
      "encoded_ascii": "^$%^$)^-X^-x^(x^&Z^*J^\"?^$s^-d^#j^)T^$z^*D^!\"^$%^,1^)!^0`^(M^,X^\"d^-l^+6^$]^&Z^%$^!V^\"e^$]^!\"",
      "encoded_base64": "XiQlXiQpXi1YXi14Xih4XiZaXipKXiI/XiRzXi1kXiNqXilUXiR6XipEXiEiXiQlXiwxXikhXjBgXihNXixYXiJkXi1sXis2XiRdXiZaXiUkXiFWXiJlXiRdXiEi",
      "byte_length": 93
    },
    {
      "unit_id": "DLG_3c0f9c677f51",
      "text": "各個村莊星羅棋布散落在大漠各處。我們彼此之間很少有往來接觸， ",
      "encoded_ascii": "^+>^!V^$z^6l^$e^/?^@4^.`^$S^-`^\"d^\"z^,}^+>^(,^!\"^$%^*{^:E^%I^!/^)G^*K^#<^$s^,)^!O^$?^(J^*A ",
      "encoded_base64": "Xis+XiFWXiR6XjZsXiRlXi8/XkA0Xi5gXiRTXi1gXiJkXiJ6Xix9Xis+XigsXiEiXiQlXip7XjpFXiVJXiEvXilHXipLXiM8XiRzXiwpXiFPXiQ/XihKXipBIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_b66f310bce4d",
      "text": "即便偶有聯絡，具體的地點也都嚴格保密。",
      "encoded_ascii": "^\"1^!R^9,^$s^-V^-J^*A^!k^**^&Z^\"e^*;^!1^)$^1*^%*^!T^#0^!\"",
      "encoded_base64": "XiIxXiFSXjksXiRzXi1WXi1KXipBXiFrXioqXiZaXiJlXio7XiExXikkXjEqXiUqXiFUXiMwXiEi",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_1ee94323c7ff",
      "text": "沒錯！這裡的水足夠供應所有人。這座村莊原本可以成為一個極其偉大的 ",
      "encoded_ascii": "^%\\^)5^*W^(s^-j^&Z^%V^(^^+d^!P^0`^$)^$s^!<^!\"^(s^/_^$z^6l^\"5^$x^\"A^!B^$$^%{^!%^!V^1D^!j^*}^\"z^&Z ",
      "encoded_base64": "XiVcXik1XipXXihzXi1qXiZaXiVWXiheXitkXiFQXjBgXiQpXiRzXiE8XiEiXihzXi9fXiR6XjZsXiI1XiR4XiJBXiFCXiQkXiV7XiElXiFWXjFEXiFqXip9XiJ6XiZaIA==",
      "byte_length": 97
    },
    {
      "unit_id": "DLG_ff65d6f3c404",
      "text": "好地方，只可惜我們的領袖太過保守怠惰，根本不思進取。",
      "encoded_ascii": "^+i^\"e^$]^*A^\"?^\"A^7X^$%^*{^&Z^)s^7G^+f^(x^!T^#+^@0^@1^*A^%)^$x^!)^#q^(w^\":^!\"",
      "encoded_base64": "XitpXiJlXiRdXipBXiI/XiJBXjdYXiQlXip7XiZaXilzXjdHXitmXih4XiFUXiMrXkAwXkAxXipBXiUpXiR4XiEpXiNxXih3XiI6XiEi",
      "byte_length": 78
    },
    {
      "unit_id": "DLG_6d1cf27900d4",
      "text": "我們的水井比任何綠洲都要可靠，你去問問多米尼就知道了。要是我們的領袖肯利用這個優勢， ",
      "encoded_ascii": "^$%^*{^&Z^%V^!7^,m^!C^!L^3V^76^)$^(C^\"A^.C^*A^*F^\"6^*Z^*Z^\"x^'4^#>^*J^&h^(y^*D^!\"^(C^,X^$%^*{^&Z^)s^7G^-Z^!t^&H^(s^!V^+)^\"&^*A ",
      "encoded_base64": "XiQlXip7XiZaXiVWXiE3XixtXiFDXiFMXjNWXjc2XikkXihDXiJBXi5DXipBXipGXiI2XipaXipaXiJ4Xic0XiM+XipKXiZoXih5XipEXiEiXihDXixYXiQlXip7XiZaXilzXjdHXi1aXiF0XiZIXihzXiFWXispXiImXipBIA==",
      "byte_length": 127
    },
    {
      "unit_id": "DLG_96a7d9e9b318",
      "text": "而不是把我們與外界隔絕孤立起來，提奎茲爾本來可以遠比現在繁榮昌盛得多。 ",
      "encoded_ascii": "^'W^!)^,X^$1^$%^*{^'p^\"w^.p^9e^-I^2c^0'^.(^!O^*A^$A^5B^/D^&/^$x^!O^\"A^!B^({^,m^&?^\"d^-N^,e^2%^1L^#e^\"x^!\" ",
      "encoded_base64": "XidXXiEpXixYXiQxXiQlXip7XidwXiJ3Xi5wXjllXi1JXjJjXjAnXi4oXiFPXipBXiRBXjVCXi9EXiYvXiR4XiFPXiJBXiFCXih7XixtXiY/XiJkXi1OXixlXjIlXjFMXiNlXiJ4XiEiIA==",
      "byte_length": 106
    },
    {
      "unit_id": "DLG_5440d4a7d9db",
      "text": "可惜他只會閉門造車。",
      "encoded_ascii": "^\"A^7X^!@^\"?^$r^.=^)D^(v^5%^!\"",
      "encoded_base64": "XiJBXjdYXiFAXiI/XiRyXi49XilEXih2XjUlXiEi",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_dc5424a6ea73",
      "text": "那個老古董腦子裡全都是沙子！不過說來也怪，他那些胡言亂語 ",
      "encoded_ascii": "^)!^!V^'U^\"=^@7^2@^#(^-j^!h^)$^,X^%]^#(^*W^!)^(x^-x^!O^!1^#s^*A^!@^)!^!8^3}^1Y^!3^0: ",
      "encoded_base64": "XikhXiFWXidVXiI9XkA3XjJAXiMoXi1qXiFoXikkXixYXiVdXiMoXipXXiEpXih4Xi14XiFPXiExXiNzXipBXiFAXikhXiE4XjN9XjFZXiEzXjA6IA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_74a52b0778c5",
      "text": "就像幽靈一樣揮之不去。我真希望我們的領袖在對待那個預言者時， ",
      "encoded_ascii": "^*J^!`^2f^)g^!%^,f^2\"^!/^!)^\"6^!\"^$%^-2^+{^,]^$%^*{^&Z^)s^7G^\"d^#:^,*^)!^!V^.E^1Y^'V^$f^*A ",
      "encoded_base64": "XipKXiFgXjJmXilnXiElXixmXjIiXiEvXiEpXiI2XiEiXiQlXi0yXit7XixdXiQlXip7XiZaXilzXjdHXiJkXiM6XiwqXikhXiFWXi5FXjFZXidWXiRmXipBIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_0fb46f9bd621",
      "text": "心裡真正有數。",
      "encoded_ascii": "^#k^-j^-2^%H^$s^$V^!\"",
      "encoded_base64": "XiNrXi1qXi0yXiVIXiRzXiRWXiEi",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_589f8a9efd60",
      "text": "你們去跟他談過了嗎？長老議會和領袖都深信他的預言，但我實在 ",
      "encoded_ascii": "^*F^*{^\"6^.+^!@^0;^(x^*D^+X^.V^)C^'U^-|^$r^\"O^)s^7G^)$^2*^!U^!@^&Z^.E^1Y^*A^!I^$%^#3^\"d ",
      "encoded_base64": "XipGXip7XiI2Xi4rXiFAXjA7Xih4XipEXitYXi5WXilDXidVXi18XiRyXiJPXilzXjdHXikkXjIqXiFVXiFAXiZaXi5FXjFZXipBXiFJXiQlXiMzXiJkIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_19e708fd1075",
      "text": "分辨不出他究竟是在預言我們的死期，還是在指引我們的生路。不過照我對他的瞭解， ",
      "encoded_ascii": "^!s^6{^!)^!q^!@^-<^28^,X^\"d^.E^1Y^$%^*{^&Z^%L^$u^*A^.7^,X^\"d^$8^#Z^$%^*{^&Z^&F^(a^!\"^!)^(x^/x^$%^#:^!@^&Z^<p^(I^*A ",
      "encoded_base64": "XiFzXjZ7XiEpXiFxXiFAXi08XjI4XixYXiJkXi5FXjFZXiQlXip7XiZaXiVMXiR1XipBXi43XixYXiJkXiQ4XiNaXiQlXip7XiZaXiZGXihhXiEiXiEpXih4Xi94XiQlXiM6XiFAXiZaXjxwXihJXipBIA==",
      "byte_length": 115
    },
    {
      "unit_id": "DLG_7b190620574c",
      "text": "兩者恐怕兼而有之吧。",
      "encoded_ascii": "^!i^'V^#t^0^^<4^'W^$s^!/^*I^!\"",
      "encoded_base64": "XiFpXidWXiN0XjBeXjw0XidXXiRzXiEvXipJXiEi",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_cf1813a5ff06",
      "text": "我真不知道該怎麼看待那個半身人。我們的領袖說他看待世界的方式是顛倒內外的， ",
      "encoded_ascii": "^$%^-2^!)^&h^(y^(M^,,^.T^*Q^,*^)!^!V^\"-^(c^!<^!\"^$%^*{^&Z^)s^7G^-x^!@^*Q^,*^*p^.p^&Z^$]^#X^,X^8R^!X^!g^\"w^&Z^*A ",
      "encoded_base64": "XiQlXi0yXiEpXiZoXih5XihNXiwsXi5UXipRXiwqXikhXiFWXiItXihjXiE8XiEiXiQlXip7XiZaXilzXjdHXi14XiFAXipRXiwqXipwXi5wXiZaXiRdXiNYXixYXjhSXiFYXiFnXiJ3XiZaXipBIA==",
      "byte_length": 112
    },
    {
      "unit_id": "DLG_e55768ac0c12",
      "text": "正因如此他才能降下那些玄乎的預言。",
      "encoded_ascii": "^%H^\"]^#$^%I^!@^$,^'b^)N^!(^)!^!8^@6^!0^&Z^.E^1Y^!\"",
      "encoded_base64": "XiVIXiJdXiMkXiVJXiFAXiQsXidiXilOXiEoXikhXiE4XkA2XiEwXiZaXi5FXjFZXiEi",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_7e307c140ec8",
      "text": "我真希望能聽懂他說的那些話。你能感覺到他所說的都是至關重要的大事。 ",
      "encoded_ascii": "^$%^-2^+{^,]^'b^-X^,6^!@^-x^&Z^)!^!8^-v^!\"^*F^'b^#{^(G^!u^!@^$)^-x^&Z^)$^,X^'n^.>^))^(C^&Z^\"z^*r^!\" ",
      "encoded_base64": "XiQlXi0yXit7XixdXidiXi1YXiw2XiFAXi14XiZaXikhXiE4Xi12XiEiXipGXidiXiN7XihHXiF1XiFAXiQpXi14XiZaXikkXixYXiduXi4+XikpXihDXiZaXiJ6XipyXiEiIA==",
      "byte_length": 100
    },
    {
      "unit_id": "DLG_2b12bc26b121",
      "text": "只不過要真正理解那些話的意思，實在比登天還難。",
      "encoded_ascii": "^\"?^!)^(x^(C^-2^%H^&A^(I^)!^!8^-v^&Z^#z^#q^*A^#3^\"d^,m^/;^+e^.7^)a^!\"",
      "encoded_base64": "XiI/XiEpXih4XihDXi0yXiVIXiZBXihJXikhXiE4Xi12XiZaXiN6XiNxXipBXiMzXiJkXixtXi87XitlXi43XilhXiEi",
      "byte_length": 69
    },
    {
      "unit_id": "DLG_aee873a809d2",
      "text": "查爾 ",
      "encoded_ascii": "^%&^&/ ",
      "encoded_base64": "XiUmXiYvIA==",
      "byte_length": 7
    },
    {
      "unit_id": "DLG_db1d7eee4b0c",
      "text": "把所有決策大權全都推給了長老議會。我們真正需要的是一位能雷厲風行掌權並激勵人心的領導者。 ",
      "encoded_ascii": "^$1^$)^$s^,o^5p^\"z^1E^!h^)$^,J^'A^*D^)C^'U^-|^$r^!\"^$%^*{^-2^%H^)e^(C^&Z^,X^!%^!J^'b^)c^+:^)y^(;^$;^1E^!+^1H^;a^!<^#k^&Z^)s^10^'V^!\" ",
      "encoded_base64": "XiQxXiQpXiRzXixvXjVwXiJ6XjFFXiFoXikkXixKXidBXipEXilDXidVXi18XiRyXiEiXiQlXip7Xi0yXiVIXillXihDXiZaXixYXiElXiFKXidiXiljXis6Xil5Xig7XiQ7XjFFXiErXjFIXjthXiE8XiNrXiZaXilzXjEwXidWXiEiIA==",
      "byte_length": 133
    },
    {
      "unit_id": "DLG_154c7b474cd0",
      "text": "激發我們的鬥志。",
      "encoded_ascii": "^1H^&W^$%^*{^&Z^*,^#m^!\"",
      "encoded_base64": "XjFIXiZXXiQlXip7XiZaXiosXiNtXiEi",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_c303ae1067a4",
      "text": "已經太老了。提奎茲爾需要新思維，需要一位有足夠遠見與魄力去把握嶄新機遇的 ",
      "encoded_ascii": "^#J^'D^+f^'U^*D^!\"^$A^5B^/D^&/^)e^(C^$\\^#q^'F^*A^)e^(C^!%^!J^$s^(^^+d^({^-m^'p^.S^!~^\"6^$1^1>^<R^$\\^%>^.2^&Z ",
      "encoded_base64": "XiNKXidEXitmXidVXipEXiEiXiRBXjVCXi9EXiYvXillXihDXiRcXiNxXidGXipBXillXihDXiElXiFKXiRzXiheXitkXih7Xi1tXidwXi5TXiF+XiI2XiQxXjE+XjxSXiRcXiU+Xi4yXiZaIA==",
      "byte_length": 109
    },
    {
      "unit_id": "DLG_78bcd427e50f",
      "text": "新領袖。",
      "encoded_ascii": "^$\\^)s^7G^!\"",
      "encoded_base64": "XiRcXilzXjdHXiEi",
      "byte_length": 12
    },
    {
      "unit_id": "DLG_5d8251f35cfc",
      "text": "多年來固然保全了村莊的安全，但也僅此而已了。一位真正的領袖應當擁有更宏大的抱負。 ",
      "encoded_ascii": "^\"x^+~^!O^3>^&\"^!T^!h^*D^$z^6l^&Z^+p^!h^*A^!I^!1^!_^%I^'W^#J^*D^!\"^!%^!J^-2^%H^&Z^)s^7G^0`^&N^,M^$s^$o^45^\"z^&Z^,@^(W^!\" ",
      "encoded_base64": "XiJ4Xit+XiFPXjM+XiYiXiFUXiFoXipEXiR6XjZsXiZaXitwXiFoXipBXiFJXiExXiFfXiVJXidXXiNKXipEXiEiXiElXiFKXi0yXiVIXiZaXilzXjdHXjBgXiZOXixNXiRzXiRvXjQ1XiJ6XiZaXixAXihXXiEiIA==",
      "byte_length": 121
    },
    {
      "unit_id": "DLG_e55cba0cdb5d",
      "text": "更有遠見的抱負。",
      "encoded_ascii": "^$o^$s^({^-m^&Z^,@^(W^!\"",
      "encoded_base64": "XiRvXiRzXih7Xi1tXiZaXixAXihXXiEi",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_46b55d878853",
      "text": "確實是個強悍的勇士，但提奎茲爾如今的發展已經超出了他的能力範圍。我們需要一位不僅僅只會揮拳搏殺的 ",
      "encoded_ascii": "^-6^#3^,X^!V^#]^,-^&Z^\"$^+a^*A^!I^$A^5B^/D^&/^#$^*E^&Z^&W^+x^#J^'D^(\\^!q^*D^!@^&Z^'b^!~^'0^\"`^!\"^$%^*{^)e^(C^!%^!J^!)^!_^!_^\"?^$r^2\"^<k^,K^%M^&Z ",
      "encoded_base64": "Xi02XiMzXixYXiFWXiNdXiwtXiZaXiIkXithXipBXiFJXiRBXjVCXi9EXiYvXiMkXipFXiZaXiZXXit4XiNKXidEXihcXiFxXipEXiFAXiZaXidiXiF+XicwXiJgXiEiXiQlXip7XillXihDXiElXiFKXiEpXiFfXiFfXiI/XiRyXjIiXjxrXixLXiVNXiZaIA==",
      "byte_length": 145
    },
    {
      "unit_id": "DLG_734622ab5244",
      "text": "明智領袖。",
      "encoded_ascii": "^$c^$i^)s^7G^!\"",
      "encoded_base64": "XiRjXiRpXilzXjdHXiEi",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_a78722c2e3eb",
      "text": "我？ ",
      "encoded_ascii": "^$%^.V ",
      "encoded_base64": "XiQlXi5WIA==",
      "byte_length": 7
    },
    {
      "unit_id": "DLG_42c898009501",
      "text": "不，我當時嚇壞了！ ",
      "encoded_ascii": "^!)^*A^$%^&N^$f^\"X^\"v^*D^*W ",
      "encoded_base64": "XiEpXipBXiQlXiZOXiRmXiJYXiJ2XipEXipXIA==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_b4452149ba4c",
      "text": "我只是盡了我的職責，僅此而已。 ",
      "encoded_ascii": "^$%^\"?^,X^-1^*D^$%^&Z^'\\^0>^*A^!_^%I^'W^#J^!\" ",
      "encoded_base64": "XiQlXiI/XixYXi0xXipEXiQlXiZaXidcXjA+XipBXiFfXiVJXidXXiNKXiEiIA==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_37391a5d9ea6",
      "text": "戰鬥爆發時我正守在城牆上。隨後一群達戈蘭獸撲倒了幾名來自 ",
      "encoded_ascii": "^$(^*,^&*^&W^$f^$%^%H^#+^\"d^+_^&0^!'^!\"^)X^#b^!%^'R^(z^*M^/G^&<^4B^!X^*D^#T^\"F^!O^'l ",
      "encoded_base64": "XiQoXiosXiYqXiZXXiRmXiQlXiVIXiMrXiJkXitfXiYwXiEnXiEiXilYXiNiXiElXidSXih6XipNXi9HXiY8XjRCXiFYXipEXiNUXiJGXiFPXidsIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_3d8066b5b2e3",
      "text": "查爾麾下的戰士",
      "encoded_ascii": "^%&^&/^4)^!(^&Z^$(^+a",
      "encoded_base64": "XiUmXiYvXjQpXiEoXiZaXiQoXith",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_303c898a71f2",
      "text": " ，我們便衝上去迎戰那群凶獸。要不是查爾及時將牠們引開，我們早就沒命了。",
      "encoded_ascii": " ^*A^$%^*{^!R^-h^!'^\"6^(k^$(^)!^'R^3e^&<^!\"^(C^!)^,X^%&^&/^\"7^$f^#7^-#^*{^#Z^)F^*A^$%^*{^,V^*J^%\\^\"N^*D^!\"",
      "encoded_base64": "IF4qQV4kJV4qe14hUl4taF4hJ14iNl4oa14kKF4pIV4nUl4zZV4mPF4hIl4oQ14hKV4sWF4lJl4mL14iN14kZl4jN14tI14qe14jWl4pRl4qQV4kJV4qe14sVl4qSl4lXF4iTl4qRF4hIg==",
      "byte_length": 106
    },
    {
      "unit_id": "DLG_a391fcb9c639",
      "text": "  查爾後來怎麼樣了？",
      "encoded_ascii": "  ^%&^&/^#b^!O^,,^.T^,f^*D^.V",
      "encoded_base64": "ICBeJSZeJi9eI2JeIU9eLCxeLlReLGZeKkReLlY=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_5789fc925fae",
      "text": "我曾與來自 ",
      "encoded_ascii": "^$%^.j^'p^!O^'l ",
      "encoded_base64": "XiQlXi5qXidwXiFPXidsIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_abd9ed5ac2eb",
      "text": "蓋德隆的戰士",
      "encoded_ascii": "^-d^#j^)T^&Z^$(^+a",
      "encoded_base64": "Xi1kXiNqXilUXiZaXiQoXith",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_40fad6ae3aa4",
      "text": "塞德里爾特的戰士",
      "encoded_ascii": "^/(^#j^)(^&/^&5^&Z^$(^+a",
      "encoded_base64": "Xi8oXiNqXikoXiYvXiY1XiZaXiQoXith",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_3518eb076f04",
      "text": " 一同鎮守東翼防線——直到我的腦袋挨了一記重擊昏倒在地。",
      "encoded_ascii": " ^!%^\"E^);^#+^,`^'T^)K^'I^*n^*n^&`^!u^$%^&Z^2@^(?^7\\^*D^!%^(K^))^$F^$d^!X^\"d^\"e^!\"",
      "encoded_base64": "IF4hJV4iRV4pO14jK14sYF4nVF4pS14nSV4qbl4qbl4mYF4hdV4kJV4mWl4yQF4oP143XF4qRF4hJV4oS14pKV4kRl4kZF4hWF4iZF4iZV4hIg==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_69c2bb0b08b4",
      "text": "  我們的盟友在戰鬥中表現如何？",
      "encoded_ascii": "  ^$%^*{^&Z^-0^\"8^\"d^$(^*,^!,^-i^&?^#$^!L^.V",
      "encoded_base64": "ICBeJCVeKnteJlpeLTBeIjheImReJCheKixeISxeLWleJj9eIyReIUxeLlY=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_4691ffcb1ee3",
      "text": "我根本沒參與戰鬥，而是負責照料傷員。",
      "encoded_ascii": "^$%^%)^$x^%\\^6K^'p^$(^*,^*A^'W^,X^(W^0>^/x^/n^!^^+G^!\"",
      "encoded_base64": "XiQlXiUpXiR4XiVcXjZLXidwXiQoXiosXipBXidXXixYXihXXjA+Xi94Xi9uXiFeXitHXiEi",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_24c0166f4540",
      "text": "  在殘酷的戰爭中，治病救人乃是最崇高的天職。",
      "encoded_ascii": "  ^\"d^,l^1b^&Z^$(^1I^!,^*A^%_^&R^,Q^!<^/M^,X^$q^13^*+^&Z^+e^'\\^!\"",
      "encoded_base64": "ICBeImReLGxeMWJeJlpeJCheMUleISxeKkFeJV9eJlJeLFFeITxeL01eLFheJHFeMTNeKiteJlpeK2VeJ1xeISI=",
      "byte_length": 65
    },
    {
      "unit_id": "DLG_4516b6514c53",
      "text": "我只是幫忙守衛大門而已。",
      "encoded_ascii": "^$%^\"?^,X^+}^,+^#+^(=^\"z^)D^'W^#J^!\"",
      "encoded_base64": "XiQlXiI/XixYXit9XiwrXiMrXig9XiJ6XilEXidXXiNKXiEi",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_b14deffa77ad",
      "text": " 當那支暗影大軍拔地而起時，我還以為我們大難臨頭了！但隨後它竟然 ",
      "encoded_ascii": " ^&N^)!^$L^$k^#a^\"z^..^/c^\"e^'W^.(^$f^*A^$%^.7^!B^%{^$%^*{^\"z^)a^1U^)t^*D^*W^!I^)X^#b^+o^28^&\" ",
      "encoded_base64": "IF4mTl4pIV4kTF4ka14jYV4iel4uLl4vY14iZV4nV14uKF4kZl4qQV4kJV4uN14hQl4le14kJV4qe14iel4pYV4xVV4pdF4qRF4qV14hSV4pWF4jYl4rb14yOF4mIiA=",
      "byte_length": 95
    },
    {
      "unit_id": "DLG_084f4470335a",
      "text": "反戈殺向德拉吉軍隊——這等不可思議的法術讓那些聖堂武士顏面掃地。",
      "encoded_ascii": "^\"9^*M^%M^+?^#j^$6^\"D^..^)U^*n^*n^(s^'-^!)^\"A^#q^-|^&Z^%b^(<^-}^)!^!8^'Z^42^%J^+a^;K^)j^:p^\"e^!\"",
      "encoded_base64": "XiI5XipNXiVNXis/XiNqXiQ2XiJEXi4uXilVXipuXipuXihzXictXiEpXiJBXiNxXi18XiZaXiViXig8Xi19XikhXiE4XidaXjQyXiVKXithXjtLXilqXjpwXiJlXiEi",
      "byte_length": 96
    },
    {
      "unit_id": "DLG_722b028ef878",
      "text": "在那之後我就再也沒見過他了。",
      "encoded_ascii": "^\"d^)!^!/^#b^$%^*J^!l^!1^%\\^-m^(x^!@^*D^!\"",
      "encoded_base64": "XiJkXikhXiEvXiNiXiQlXipKXiFsXiExXiVcXi1tXih4XiFAXipEXiEi",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_f67871b1d4ac",
      "text": "據我所見，他們個個作戰英勇。我會永遠將他們視為真正的摯友。",
      "encoded_ascii": "^5T^$%^$)^-m^*A^!@^*{^!V^!V^!M^$(^'y^\"$^!\"^$%^$r^%W^({^#7^!@^*{^(E^%{^-2^%H^&Z^2#^\"8^!\"",
      "encoded_base64": "XjVUXiQlXiQpXi1tXipBXiFAXip7XiFWXiFWXiFNXiQoXid5XiIkXiEiXiQlXiRyXiVXXih7XiM3XiFAXip7XihFXiV7Xi0yXiVIXiZaXjIjXiI4XiEi",
      "byte_length": 87
    },
    {
      "unit_id": "DLG_48e19cffe2ef",
      "text": "您過獎了，但傷者實在太多太多了。我們根本無法拯救所有人。",
      "encoded_ascii": "^4:^(x^7?^*D^*A^!I^!^^'V^#3^\"d^+f^\"x^+f^\"x^*D^!\"^$%^*{^%)^$x^%}^%b^,F^,Q^$)^$s^!<^!\"",
      "encoded_base64": "XjQ6Xih4Xjc/XipEXipBXiFJXiFeXidWXiMzXiJkXitmXiJ4XitmXiJ4XipEXiEiXiQlXip7XiUpXiR4XiV9XiViXixGXixRXiQpXiRzXiE8XiEi",
      "byte_length": 84
    },
    {
      "unit_id": "DLG_29567f53a1d0",
      "text": "起初，德拉吉士兵試圖與暗影大軍交鋒對抗。敵軍在人數上依舊佔據優勢， ",
      "encoded_ascii": "^.(^1\"^*A^#j^$6^\"D^+a^+,^-u^\"b^'p^$k^#a^\"z^..^0P^6?^#:^$4^!\"^$U^..^\"d^!<^$V^!'^!Q^02^0R^5T^+)^\"&^*A ",
      "encoded_base64": "Xi4oXjEiXipBXiNqXiQ2XiJEXithXissXi11XiJiXidwXiRrXiNhXiJ6Xi4uXjBQXjY/XiM6XiQ0XiEiXiRVXi4uXiJkXiE8XiRWXiEnXiFRXjAyXjBSXjVUXispXiImXipBIA==",
      "byte_length": 100
    },
    {
      "unit_id": "DLG_1dc988f91b72",
      "text": "但恐懼徹底擊垮了他們的膽氣，而那些暗影戰士更是步步緊逼、毫無憐憫。",
      "encoded_ascii": "^!I^#t^$#^18^/^^$F^.^^*D^!@^*{^&Z^-[^%U^*A^'W^)!^!8^$k^#a^$(^+a^$o^,X^,i^,i^0r^.1^!!^/t^%}^1}^1~^!\"",
      "encoded_base64": "XiFJXiN0XiQjXjE4Xi9eXiRGXi5eXipEXiFAXip7XiZaXi1bXiVVXipBXidXXikhXiE4XiRrXiNhXiQoXithXiRvXixYXixpXixpXjByXi4xXiEhXi90XiV9XjF9XjF+XiEi",
      "byte_length": 99
    },
    {
      "unit_id": "DLG_2fc87c521409",
      "text": "。有什麼我能為你們效勞的嗎？",
      "encoded_ascii": "^!\"^$s^!=^.T^$%^'b^%{^*F^*{^$Q^/R^&Z^+X^.V",
      "encoded_base64": "XiEiXiRzXiE9Xi5UXiQlXidiXiV7XipGXip7XiRRXi9SXiZaXitYXi5W",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_f3181b99ac8d",
      "text": "！你們擊潰德拉吉的英勇事蹟將會被萬世傳頌！我們對你們的感激之情難以言表。",
      "encoded_ascii": "^*W^*F^*{^$F^2-^#j^$6^\"D^&Z^'y^\"$^*r^0B^#7^$r^(@^-_^*p^+$^7\"^*W^$%^*{^#:^*F^*{^&Z^#{^1H^!/^,0^)a^!B^1Y^-i^!\"",
      "encoded_base64": "XipXXipGXip7XiRGXjItXiNqXiQ2XiJEXiZaXid5XiIkXipyXjBCXiM3XiRyXihAXi1fXipwXiskXjciXipXXiQlXip7XiM6XipGXip7XiZaXiN7XjFIXiEvXiwwXilhXiFCXjFZXi1pXiEi",
      "byte_length": 108
    },
    {
      "unit_id": "DLG_42d8ae1c9d08",
      "text": "！那個瘋瘋癲癲的老預言者居然說對了！你們實現了預言， ",
      "encoded_ascii": "^*W^)!^!V^-/^-/^4Y^4Y^&Z^'U^.E^1Y^'V^+w^&\"^-x^#:^*D^*W^*F^*{^#3^&?^*D^.E^1Y^*A ",
      "encoded_base64": "XipXXikhXiFWXi0vXi0vXjRZXjRZXiZaXidVXi5FXjFZXidWXit3XiYiXi14XiM6XipEXipXXipGXip7XiMzXiY/XipEXi5FXjFZXipBIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_a4db539bb5a1",
      "text": "大漠的百姓終於擺脫了德拉吉的魔爪。整個亞薩斯都深欠你們一份天大的恩情。",
      "encoded_ascii": "^\"z^,}^&Z^&Y^6S^-H^$^^1@^'c^*D^#j^$6^\"D^&Z^*0^&.^!\"^$T^!V^!9^-e^$[^)$^2*^,g^*F^*{^!%^*x^+e^\"z^&Z^#v^,0^!\"",
      "encoded_base64": "XiJ6Xix9XiZaXiZZXjZTXi1IXiReXjFAXidjXipEXiNqXiQ2XiJEXiZaXiowXiYuXiEiXiRUXiFWXiE5Xi1lXiRbXikkXjIqXixnXipGXip7XiElXip4XitlXiJ6XiZaXiN2XiwwXiEi",
      "byte_length": 105
    },
    {
      "unit_id": "DLG_ee57147797ca",
      "text": "！感謝你們拯救了我的村莊！我會把我即將出生的第一個 ",
      "encoded_ascii": "^*W^#{^-z^*F^*{^,F^,Q^*D^$%^&Z^$z^6l^*W^$%^$r^$1^$%^\"1^#7^!q^&F^&Z^',^!%^!V ",
      "encoded_base64": "XipXXiN7Xi16XipGXip7XixGXixRXipEXiQlXiZaXiR6XjZsXipXXiQlXiRyXiQxXiQlXiIxXiM3XiFxXiZGXiZaXicsXiElXiFWIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_a4a499732198",
      "text": "兒子",
      "encoded_ascii": "^++^#(",
      "encoded_base64": "XisrXiMo",
      "byte_length": 6
    },
    {
      "unit_id": "DLG_d8940efe6b26",
      "text": "女兒",
      "encoded_ascii": "^#\"^++",
      "encoded_base64": "XiMiXisr",
      "byte_length": 6
    },
    {
      "unit_id": "DLG_7e65830aa459",
      "text": " 以你的名字來命名，以銘記你那傳奇般的英雄壯舉。",
      "encoded_ascii": " ^!B^*F^&Z^\"F^#)^!O^\"N^\"F^*A^!B^.;^(K^*F^)!^+$^\"}^'r^&Z^'y^)\\^+b^01^!\"",
      "encoded_base64": "IF4hQl4qRl4mWl4iRl4jKV4hT14iTl4iRl4qQV4hQl4uO14oS14qRl4pIV4rJF4ifV4ncl4mWl4neV4pXF4rYl4wMV4hIg==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_308a57e469be",
      "text": "！這對於全亞薩斯而言都是一個無比偉大的日子。我們永遠欠你們一份恩情！",
      "encoded_ascii": "^*W^(s^#:^$^^!h^!9^-e^$[^'W^1Y^)$^,X^!%^!V^%}^,m^*}^\"z^&Z^$a^#(^!\"^$%^*{^%W^({^,g^*F^*{^!%^*x^#v^,0^*W",
      "encoded_base64": "XipXXihzXiM6XiReXiFoXiE5Xi1lXiRbXidXXjFZXikkXixYXiElXiFWXiV9XixtXip9XiJ6XiZaXiRhXiMoXiEiXiQlXip7XiVXXih7XixnXipGXip7XiElXip4XiN2XiwwXipX",
      "byte_length": 102
    },
    {
      "unit_id": "DLG_a65ed28096cb",
      "text": "是的，我手頭上就有。",
      "encoded_ascii": "^,X^&Z^*A^$%^$+^)t^!'^*J^$s^!\"",
      "encoded_base64": "XixYXiZaXipBXiQlXiQrXil0XiEnXipKXiRzXiEi",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_1eb056dfba38",
      "text": "還沒有呢。",
      "encoded_ascii": "^.7^%\\^$s^+C^!\"",
      "encoded_base64": "Xi43XiVcXiRzXitDXiEi",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_25af4445406a",
      "text": "我現在很忙。你們要是有什麼需要，就去找長老議會吧。",
      "encoded_ascii": "^$%^&?^\"d^*K^,+^!\"^*F^*{^(C^,X^$s^!=^.T^)e^(C^*A^*J^\"6^$/^)C^'U^-|^$r^*I^!\"",
      "encoded_base64": "XiQlXiY/XiJkXipLXiwrXiEiXipGXip7XihDXixYXiRzXiE9Xi5UXillXihDXipBXipKXiI2XiQvXilDXidVXi18XiRyXipJXiEi",
      "byte_length": 75
    },
    {
      "unit_id": "DLG_673935da2fca",
      "text": "我不喜歡跟外生人打交道。議會就是專門幹這個的。",
      "encoded_ascii": "^$%^!)^+V^%F^.+^\"w^&F^!<^$-^0P^(y^!\"^-|^$r^*J^,X^#8^)D^,!^(s^!V^&Z^!\"",
      "encoded_base64": "XiQlXiEpXitWXiVGXi4rXiJ3XiZGXiE8XiQtXjBQXih5XiEiXi18XiRyXipKXixYXiM4XilEXiwhXihzXiFWXiZaXiEi",
      "byte_length": 69
    },
    {
      "unit_id": "DLG_b24f9b66b58d",
      "text": "我沒空閒聊。難道你們沒聽說那則預言嗎？我們必須全力備戰。 ",
      "encoded_ascii": "^$%^%\\^'(^6A^-U^!\"^)a^(y^*F^*{^%\\^-X^-x^)!^!x^.E^1Y^+X^.V^$%^*{^#l^)r^!h^!~^+\"^$(^!\" ",
      "encoded_base64": "XiQlXiVcXicoXjZBXi1VXiEiXilhXih5XipGXip7XiVcXi1YXi14XikhXiF4Xi5FXjFZXitYXi5WXiQlXip7XiNsXilyXiFoXiF+XisiXiQoXiEiIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_c2351fa73ee4",
      "text": "長老議會會跟你們細說這事的。",
      "encoded_ascii": "^)C^'U^-|^$r^$r^.+^*F^*{^'?^-x^(s^*r^&Z^!\"",
      "encoded_base64": "XilDXidVXi18XiRyXiRyXi4rXipGXip7Xic/Xi14XihzXipyXiZaXiEi",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_feba8077427b",
      "text": "如果你們是想來推銷賣東西的，我可毫無興趣。要是你們運氣夠好， ",
      "encoded_ascii": "^#$^%!^*F^*{^,X^,1^!O^,J^)1^.$^,`^-l^&Z^*A^$%^\"A^/t^%}^-]^.*^!\"^(C^,X^*F^*{^.4^%U^+d^+i^*A ",
      "encoded_base64": "XiMkXiUhXipGXip7XixYXiwxXiFPXixKXikxXi4kXixgXi1sXiZaXipBXiQlXiJBXi90XiV9Xi1dXi4qXiEiXihDXixYXipGXip7Xi40XiVVXitkXitpXipBIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_39b1604ebaa7",
      "text": "長老議會說不定還能讓你們活著走出村子。",
      "encoded_ascii": "^)C^'U^-|^$r^-x^!)^#.^.7^'b^-}^*F^*{^%i^-a^.&^!q^$z^#(^!\"",
      "encoded_base64": "XilDXidVXi18XiRyXi14XiEpXiMuXi43XidiXi19XipGXip7XiVpXi1hXi4mXiFxXiR6XiMoXiEi",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_efaab6a10a8c",
      "text": " 他們就在村子北邊的議事大廳裡。",
      "encoded_ascii": " ^!@^*{^*J^\"d^$z^#(^+6^.8^&Z^-|^*r^\"z^0\\^-j^!\"",
      "encoded_base64": "IF4hQF4qe14qSl4iZF4kel4jKF4rNl4uOF4mWl4tfF4qcl4iel4wXF4tal4hIg==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_e28935914146",
      "text": "在我們出兵作戰之前，你們還有什麼問題嗎？",
      "encoded_ascii": "^\"d^$%^*{^!q^+,^!M^$(^!/^!z^*A^*F^*{^.7^$s^!=^.T^*Z^.G^+X^.V",
      "encoded_base64": "XiJkXiQlXip7XiFxXissXiFNXiQoXiEvXiF6XipBXipGXip7Xi43XiRzXiE9Xi5UXipaXi5HXitYXi5W",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_d0a528f6f229",
      "text": "然而，德拉吉大軍已然開拔，我們必須整頓 ",
      "encoded_ascii": "^&\"^'W^*A^#j^$6^\"D^\"z^..^#J^&\"^)F^/c^*A^$%^*{^#l^)r^$T^.F ",
      "encoded_base64": "XiYiXidXXipBXiNqXiQ2XiJEXiJ6Xi4uXiNKXiYiXilGXi9jXipBXiQlXip7XiNsXilyXiRUXi5GIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_af051a945fd0",
      "text": "各路部隊。查爾會為你們詳細簡報。",
      "encoded_ascii": "^+>^(a^)#^)U^!\"^%&^&/^$r^%{^*F^*{^6v^'?^3y^+`^!\"",
      "encoded_base64": "Xis+XihhXikjXilVXiEiXiUmXiYvXiRyXiV7XipGXip7XjZ2Xic/XjN5XitgXiEi",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_7ddee7052cd6",
      "text": "我們的處境已到了危急關頭！德拉吉大軍比我 ",
      "encoded_ascii": "^$%^*{^&Z^(,^\"q^#J^!u^*D^2\\^3p^.>^)t^*W^#j^$6^\"D^\"z^..^,m^$% ",
      "encoded_base64": "XiQlXip7XiZaXigsXiJxXiNKXiF1XipEXjJcXjNwXi4+Xil0XipXXiNqXiQ2XiJEXiJ6Xi4uXixtXiQlIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_2df248c1d2bf",
      "text": "所能想像的還要龐大。 ",
      "encoded_ascii": "^$)^'b^,1^!`^&Z^.7^(C^6H^\"z^!\" ",
      "encoded_base64": "XiQpXidiXiwxXiFgXiZaXi43XihDXjZIXiJ6XiEiIA==",
      "byte_length": 31
    },
    {
      "unit_id": "DLG_809c866f9b24",
      "text": "而沒有盟友，我們的命運就此注定",
      "encoded_ascii": "^'W^%\\^$s^-0^\"8^*A^$%^*{^&Z^\"N^.4^*J^%I^%e^#.",
      "encoded_base64": "XidXXiVcXiRzXi0wXiI4XipBXiQlXip7XiZaXiJOXi40XipKXiVJXiVlXiMu",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_622f68920486",
      "text": "你為我們找來的援助，來自 ",
      "encoded_ascii": "^*F^%{^$%^*{^$/^!O^&Z^$C^\"#^*A^!O^'l ",
      "encoded_base64": "XipGXiV7XiQlXip7XiQvXiFPXiZaXiRDXiIjXipBXiFPXidsIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_aed9c58230c2",
      "text": " 是莫大的幫助，我由衷感謝。儘管如此，我們仍然幾乎沒有 ",
      "encoded_ascii": " ^,X^/F^\"z^&Z^+}^\"#^*A^$%^&I^7i^#{^-z^!\"^+(^-D^#$^%I^*A^$%^*{^!?^&\"^#T^!0^%\\^$s ",
      "encoded_base64": "IF4sWF4vRl4iel4mWl4rfV4iI14qQV4kJV4mSV43aV4je14tel4hIl4rKF4tRF4jJF4lSV4qQV4kJV4qe14hP14mIl4jVF4hMF4lXF4kcyA=",
      "byte_length": 80
    },
    {
      "unit_id": "DLG_e55d6fa57e4a",
      "text": "以對抗德拉吉",
      "encoded_ascii": "^!B^#:^$4^#j^$6^\"D",
      "encoded_base64": "XiFCXiM6XiQ0XiNqXiQ2XiJE",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_2bba3c9ebbef",
      "text": " ——但我絕不屈服！就算要賠上我的性命，我也絕不再 ",
      "encoded_ascii": " ^*n^*n^!I^$%^-I^!)^5K^,\\^*W^*J^-C^(C^62^!'^$%^&Z^#r^\"N^*A^$%^!1^-I^!)^!l ",
      "encoded_base64": "IF4qbl4qbl4hSV4kJV4tSV4hKV41S14sXF4qV14qSl4tQ14oQ142Ml4hJ14kJV4mWl4jcl4iTl4qQV4kJV4hMV4tSV4hKV4hbCA=",
      "byte_length": 74
    },
    {
      "unit_id": "DLG_22605b29f1e2",
      "text": "淪為奴隸！",
      "encoded_ascii": "^2)^%{^##^)Z^*W",
      "encoded_base64": "XjIpXiV7XiMjXilaXipX",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_fc003a0cfe7b",
      "text": "  我們的作戰計畫是什麼？",
      "encoded_ascii": "  ^$%^*{^&Z^!M^$(^-n^-,^,X^!=^.T^.V",
      "encoded_base64": "ICBeJCVeKnteJlpeIU1eJCheLW5eLSxeLFheIT1eLlReLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_370c3cd69d1c",
      "text": "  村莊的士氣如何？",
      "encoded_ascii": "  ^$z^6l^&Z^+a^%U^#$^!L^.V",
      "encoded_base64": "ICBeJHpeNmxeJlpeK2FeJVVeIyReIUxeLlY=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_01118829a6b1",
      "text": "  我們的盟友撐得住嗎？",
      "encoded_ascii": "  ^$%^*{^&Z^-0^\"8^,L^#e^*z^+X^.V",
      "encoded_base64": "ICBeJCVeKnteJlpeLTBeIjheLExeI2VeKnpeK1heLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_da91a9ae4251",
      "text": "  你對這場沙暴怎麼看？",
      "encoded_ascii": "  ^*F^#:^(s^\"n^%]^$m^,,^.T^*Q^.V",
      "encoded_base64": "ICBeKkZeIzpeKHNeIm5eJV1eJG1eLCxeLlReKlFeLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_2ec6f3211659",
      "text": "  那位預言者有說出什麼預言嗎？",
      "encoded_ascii": "  ^)!^!J^.E^1Y^'V^$s^-x^!q^!=^.T^.E^1Y^+X^.V",
      "encoded_base64": "ICBeKSFeIUpeLkVeMVleJ1ZeJHNeLXheIXFeIT1eLlReLkVeMVleK1heLlY=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_2a76bcae9207",
      "text": "  我去做好準備。",
      "encoded_ascii": "  ^$%^\"6^*~^+i^,x^+\"^!\"",
      "encoded_base64": "ICBeJCVeIjZeKn5eK2leLHheKyJeISI=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_fc09a2ce8d20",
      "text": "我們將從提奎茲爾出兵，主動迎擊敵軍！",
      "encoded_ascii": "^$%^*{^#7^#f^$A^5B^/D^&/^!q^+,^*A^!-^\"%^(k^$F^$U^..^*W",
      "encoded_base64": "XiQlXip7XiM3XiNmXiRBXjVCXi9EXiYvXiFxXissXipBXiEtXiIlXihrXiRGXiRVXi4uXipX",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_6161f5420d5f",
      "text": "  副官打算怎麼做？",
      "encoded_ascii": "  ^52^#-^$-^-C^,,^.T^*~^.V",
      "encoded_base64": "ICBeNTJeIy1eJC1eLUNeLCxeLlReKn5eLlY=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_6686338331d0",
      "text": "  德拉吉大軍現在在哪裡？",
      "encoded_ascii": "  ^#j^$6^\"D^\"z^..^&?^\"d^\"d^+I^-j^.V",
      "encoded_base64": "ICBeI2peJDZeIkReInpeLi5eJj9eImReImReK0leLWpeLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_797116178b28",
      "text": "  德拉吉大軍規模有多大？",
      "encoded_ascii": "  ^#j^$6^\"D^\"z^..^6'^%:^$s^\"x^\"z^.V",
      "encoded_base64": "ICBeI2peJDZeIkReInpeLi5eNideJTpeJHNeInheInpeLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_26ce9f99c92c",
      "text": "  我們的盟友現在在哪裡？",
      "encoded_ascii": "  ^$%^*{^&Z^-0^\"8^&?^\"d^\"d^+I^-j^.V",
      "encoded_base64": "ICBeJCVeKnteJlpeLTBeIjheJj9eImReImReK0leLWpeLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_2cf52e321919",
      "text": "村民們 ",
      "encoded_ascii": "^$z^%T^*{ ",
      "encoded_base64": "XiR6XiVUXip7IA==",
      "byte_length": 10
    },
    {
      "unit_id": "DLG_f3cebfdb0dbc",
      "text": "因你們帶來的戰士而大受鼓舞，來自 ",
      "encoded_ascii": "^\"]^*F^*{^#N^!O^&Z^$(^+a^'W^\"z^\";^*<^9s^*A^!O^'l ",
      "encoded_base64": "XiJdXipGXip7XiNOXiFPXiZaXiQoXithXidXXiJ6XiI7Xio8XjlzXipBXiFPXidsIA==",
      "byte_length": 49
    },
    {
      "unit_id": "DLG_60b7058a3969",
      "text": "，但他們意識到提奎茲爾和 ",
      "encoded_ascii": "^*A^!I^!@^*{^#z^(R^!u^$A^5B^/D^&/^\"O ",
      "encoded_base64": "XipBXiFJXiFAXip7XiN6XihSXiF1XiRBXjVCXi9EXiYvXiJPIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_64b9e3584565",
      "text": " 單憑自己的力量根本無法匹敵德拉吉大軍。",
      "encoded_ascii": " ^2a^,5^'l^#I^&Z^!~^)*^%)^$x^%}^%b^8w^$U^#j^$6^\"D^\"z^..^!\"",
      "encoded_base64": "IF4yYV4sNV4nbF4jSV4mWl4hfl4pKl4lKV4keF4lfV4lYl44d14kVV4jal4kNl4iRF4iel4uLl4hIg==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_b42ca7fc526b",
      "text": "都很害怕。看到來自蓋德隆和塞德里爾特的戰士， ",
      "encoded_ascii": "^)$^*K^#/^0^^!\"^*Q^!u^!O^'l^-d^#j^)T^\"O^/(^#j^)(^&/^&5^&Z^$(^+a^*A ",
      "encoded_base64": "XikkXipLXiMvXjBeXiEiXipRXiF1XiFPXidsXi1kXiNqXilUXiJPXi8oXiNqXikoXiYvXiY1XiZaXiQoXithXipBIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_c240d94acea0",
      "text": "讓他們燃起了奮戰的決心，但他們仍然幾乎沒有 ",
      "encoded_ascii": "^-}^!@^*{^&%^.(^*D^+g^$(^&Z^,o^#k^*A^!I^!@^*{^!?^&\"^#T^!0^%\\^$s ",
      "encoded_base64": "Xi19XiFAXip7XiYlXi4oXipEXitnXiQoXiZaXixvXiNrXipBXiFJXiFAXip7XiE/XiYiXiNUXiEwXiVcXiRzIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_4234ddb6aa66",
      "text": "勝利的希望。",
      "encoded_ascii": "^+5^!t^&Z^+{^,]^!\"",
      "encoded_base64": "Xis1XiF0XiZaXit7XixdXiEi",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_060988dbd3ea",
      "text": "已陷入了絕望之中。他們深知若無盟友，我們根本無法奢望獲勝 ",
      "encoded_ascii": "^#J^)S^!f^*D^-I^,]^!/^!,^!\"^!@^*{^2*^&h^'x^%}^-0^\"8^*A^$%^*{^%)^$x^%}^%b^1t^,]^&:^+5 ",
      "encoded_base64": "XiNKXilTXiFmXipEXi1JXixdXiEvXiEsXiEiXiFAXip7XjIqXiZoXid4XiV9Xi0wXiI4XipBXiQlXip7XiUpXiR4XiV9XiViXjF0XixdXiY6Xis1IA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_8e4676c08e45",
      "text": "——根本無法獲勝。",
      "encoded_ascii": "^*n^*n^%)^$x^%}^%b^&:^+5^!\"",
      "encoded_base64": "XipuXipuXiUpXiR4XiV9XiViXiY6Xis1XiEi",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_aac485c690d5",
      "text": "他們的鬥志早已低落，許多人已悄悄溜入了荒漠之中， ",
      "encoded_ascii": "^!@^*{^&Z^*,^#m^,V^#J^!K^-`^*A^-s^\"x^!<^#J^3r^3r^%r^!f^*D^1W^,}^!/^!,^*A ",
      "encoded_base64": "XiFAXip7XiZaXiosXiNtXixWXiNKXiFLXi1gXipBXi1zXiJ4XiE8XiNKXjNyXjNyXiVyXiFmXipEXjFXXix9XiEvXiEsXipBIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_00d1bda7610e",
      "text": "毫無疑問是奔向那些更安寧的地方去了。",
      "encoded_ascii": "^/t^%}^0p^*Z^,X^2b^+?^)!^!8^$o^+p^3k^&Z^\"e^$]^\"6^*D^!\"",
      "encoded_base64": "Xi90XiV9XjBwXipaXixYXjJiXis/XikhXiE4XiRvXitwXjNrXiZaXiJlXiRdXiI2XipEXiEi",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_e4d402de904b",
      "text": "考慮到我們所面臨的處境，沒有更多人逃跑已經令人嘖嘖稱奇了 ",
      "encoded_ascii": "^-R^19^!u^$%^*{^$)^)j^1U^&Z^(,^\"q^*A^%\\^$s^$o^\"x^!<^(p^(_^#J^'D^*w^!<^@9^@9^0&^\"}^*D ",
      "encoded_base64": "Xi1SXjE5XiF1XiQlXip7XiQpXilqXjFVXiZaXigsXiJxXipBXiVcXiRzXiRvXiJ4XiE8XihwXihfXiNKXidEXip3XiE8XkA5XkA5XjAmXiJ9XipEIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_25959a68748b",
      "text": "。我確信這是因為你們的激勵領導所產生的效果。",
      "encoded_ascii": "^!\"^$%^-6^!U^(s^,X^\"]^%{^*F^*{^&Z^1H^;a^)s^10^$)^&G^&F^&Z^$Q^%!^!\"",
      "encoded_base64": "XiEiXiQlXi02XiFVXihzXixYXiJdXiV7XipGXip7XiZaXjFIXjthXilzXjEwXiQpXiZHXiZGXiZaXiRRXiUhXiEi",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_b61df0b00d35",
      "text": "自沙暴來臨之前，我就再也沒有與他交談過了。我相信 ",
      "encoded_ascii": "^'l^%]^$m^!O^1U^!/^!z^*A^$%^*J^!l^!1^%\\^$s^'p^!@^0P^0;^(x^*D^!\"^$%^&a^!U ",
      "encoded_base64": "XidsXiVdXiRtXiFPXjFVXiEvXiF6XipBXiQlXipKXiFsXiExXiVcXiRzXidwXiFAXjBQXjA7Xih4XipEXiEiXiQlXiZhXiFVIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_0b20ace4dc1c",
      "text": "他對這個預兆必定有所見解。",
      "encoded_ascii": "^!@^#:^(s^!V^.E^5/^#l^#.^$s^$)^-m^(I^!\"",
      "encoded_base64": "XiFAXiM6XihzXiFWXi5FXjUvXiNsXiMuXiRzXiQpXi1tXihJXiEi",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_d72c7f2a1f1b",
      "text": "他說風暴已然降臨，它將揭示我們的命運。 ",
      "encoded_ascii": "^!@^-x^)y^$m^#J^&\"^)N^1U^*A^+o^#7^$B^&s^$%^*{^&Z^\"N^.4^!\" ",
      "encoded_base64": "XiFAXi14Xil5XiRtXiNKXiYiXilOXjFVXipBXitvXiM3XiRCXiZzXiQlXip7XiZaXiJOXi40XiEiIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_22fc8f86e3ff",
      "text": "說什麼顯而易見的道理，就要靠一位預言者來告訴我們！",
      "encoded_ascii": "^-x^!=^.T^4&^'W^,W^-m^&Z^(y^&A^*A^*J^(C^.C^!%^!J^.E^1Y^'V^!O^+B^-t^$%^*{^*W",
      "encoded_base64": "Xi14XiE9Xi5UXjQmXidXXixXXi1tXiZaXih5XiZBXipBXipKXihDXi5DXiElXiFKXi5FXjFZXidWXiFPXitCXi10XiQlXip7XipX",
      "byte_length": 75
    },
    {
      "unit_id": "DLG_0e4df6f054e1",
      "text": "這必定是個預兆。我們如今在西方所見的那片廢墟，必定 ",
      "encoded_ascii": "^(s^#l^#.^,X^!V^.E^5/^!\"^$%^*{^#$^*E^\"d^-l^$]^$)^-m^&Z^)!^&1^#W^\"t^*A^#l^#. ",
      "encoded_base64": "XihzXiNsXiMuXixYXiFWXi5FXjUvXiEiXiQlXip7XiMkXipFXiJkXi1sXiRdXiQpXi1tXiZaXikhXiYxXiNXXiJ0XipBXiNsXiMuIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_c707b77dc538",
      "text": "不是我們的救贖所在，就是我們的葬身之地。",
      "encoded_ascii": "^!)^,X^$%^*{^&Z^,Q^3-^$)^\"d^*A^*J^,X^$%^*{^&Z^-b^(c^!/^\"e^!\"",
      "encoded_base64": "XiEpXixYXiQlXip7XiZaXixRXjMtXiQpXiJkXipBXipKXixYXiQlXip7XiZaXi1iXihjXiEvXiJlXiEi",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_d86e2258c9da",
      "text": "是時候做好準備了。 ",
      "encoded_ascii": "^,X^$f^*|^*~^+i^,x^+\"^*D^!\" ",
      "encoded_base64": "XixYXiRmXip8Xip+XitpXix4XisiXipEXiEiIA==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_72dbba455d81",
      "text": "我深信那片廢墟是被沙暴有目的地揭露出來的， ",
      "encoded_ascii": "^$%^2*^!U^)!^&1^#W^\"t^,X^(@^%]^$m^$s^&^^&Z^\"e^$B^.B^!q^!O^&Z^*A ",
      "encoded_base64": "XiQlXjIqXiFVXikhXiYxXiNXXiJ0XixYXihAXiVdXiRtXiRzXiZeXiZaXiJlXiRCXi5CXiFxXiFPXiZaXipBIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_0c518e0803ba",
      "text": "但那有待你前去探明，而我們則在此集結 ",
      "encoded_ascii": "^!I^)!^$s^,*^*F^!z^\"6^$>^$c^*A^'W^$%^*{^!x^\"d^%I^)]^'@ ",
      "encoded_base64": "XiFJXikhXiRzXiwqXipGXiF6XiI2XiQ+XiRjXipBXidXXiQlXip7XiF4XiJkXiVJXildXidAIA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_bb9793c55710",
      "text": "勇士們。",
      "encoded_ascii": "^\"$^+a^*{^!\"",
      "encoded_base64": "XiIkXithXip7XiEi",
      "byte_length": 12
    },
    {
      "unit_id": "DLG_0b17c47bdb21",
      "text": " 將集結勇士們，並在城門外等候你們的到來。",
      "encoded_ascii": " ^#7^)]^'@^\"$^+a^*{^*A^!+^\"d^+_^)D^\"w^'-^*|^*F^*{^&Z^!u^!O^!\"",
      "encoded_base64": "IF4jN14pXV4nQF4iJF4rYV4qe14qQV4hK14iZF4rX14pRF4id14nLV4qfF4qRl4qe14mWl4hdV4hT14hIg==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_f1d362b03dca",
      "text": "願你遠離傷害，有所庇護！",
      "encoded_ascii": "^.H^*F^({^)`^!^^#/^*A^$s^$)^,\"^(T^*W",
      "encoded_base64": "Xi5IXipGXih7XilgXiFeXiMvXipBXiRzXiQpXiwiXihUXipX",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_596f323d9bdd",
      "text": "是的，我們沒有時間閒聊了。",
      "encoded_ascii": "^,X^&Z^*A^$%^*{^%\\^$s^$f^)G^6A^-U^*D^!\"",
      "encoded_base64": "XixYXiZaXipBXiQlXip7XiVcXiRzXiRmXilHXjZBXi1VXipEXiEi",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_ff831ba37ff7",
      "text": "去探查那片被沙暴揭露的廢墟，看看能否加以利用， ",
      "encoded_ascii": "^\"6^$>^%&^)!^&1^(@^%]^$m^$B^.B^&Z^#W^\"t^*A^*Q^*Q^'b^\"H^\"\"^!B^!t^&H^*A ",
      "encoded_base64": "XiI2XiQ+XiUmXikhXiYxXihAXiVdXiRtXiRCXi5CXiZaXiNXXiJ0XipBXipRXipRXidiXiJIXiIiXiFCXiF0XiZIXipBIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_dad662246413",
      "text": "或許可用作防禦工事。之後你",
      "encoded_ascii": "^$'^-s^\"A^&H^!M^)K^&{^+y^*r^!\"^!/^#b^*F",
      "encoded_base64": "XiQnXi1zXiJBXiZIXiFNXilLXiZ7Xit5XipyXiEiXiEvXiNiXipG",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_3a0e905d4d71",
      "text": "磨好你的劍！你",
      "encoded_ascii": "^-7^+i^*F^&Z^!|^*W^*F",
      "encoded_base64": "Xi03XitpXipGXiZaXiF8XipXXipG",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_4c9e00897a27",
      "text": "必須 ",
      "encoded_ascii": "^#l^)r ",
      "encoded_base64": "XiNsXilyIA==",
      "byte_length": 7
    },
    {
      "unit_id": "DLG_d0b60b9ca0c2",
      "text": "挺進",
      "encoded_ascii": "^,I^(w",
      "encoded_base64": "XixJXih3",
      "byte_length": 6
    },
    {
      "unit_id": "DLG_d1d6223260e8",
      "text": "率領來自 ",
      "encoded_ascii": "^22^)s^!O^'l ",
      "encoded_base64": "XjIyXilzXiFPXidsIA==",
      "byte_length": 13
    },
    {
      "unit_id": "DLG_077e1142de97",
      "text": " 的部隊投入戰鬥，一旦準備就緒，立即行動！ ",
      "encoded_ascii": " ^&Z^)#^)U^$3^!f^$(^*,^*A^!%^1C^,x^+\"^*J^3#^*A^0'^\"1^(;^\"%^*W ",
      "encoded_base64": "IF4mWl4pI14pVV4kM14hZl4kKF4qLF4qQV4hJV4xQ14seF4rIl4qSl4zI14qQV4wJ14iMV4oO14iJV4qVyA=",
      "byte_length": 62
    },
    {
      "unit_id": "DLG_c941b69ba939",
      "text": " 將統率來自提奎茲爾的戰士。",
      "encoded_ascii": " ^#7^'B^22^!O^'l^$A^5B^/D^&/^&Z^$(^+a^!\"",
      "encoded_base64": "IF4jN14nQl4yMl4hT14nbF4kQV41Ql4vRF4mL14mWl4kKF4rYV4hIg==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_12280d22356f",
      "text": "  你們打算怎麼做？",
      "encoded_ascii": "  ^*F^*{^$-^-C^,,^.T^*~^.V",
      "encoded_base64": "ICBeKkZeKnteJC1eLUNeLCxeLlReKn5eLlY=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_c5cfff37ab2e",
      "text": "副官",
      "encoded_ascii": "^52^#-",
      "encoded_base64": "XjUyXiMt",
      "byte_length": 6
    },
    {
      "unit_id": "DLG_7ff04e28adb1",
      "text": " 自告奮勇，在戰役期間留守保護村莊。",
      "encoded_ascii": " ^'l^+B^+g^\"$^*A^\"d^$(^17^$u^)G^-+^#+^!T^(T^$z^6l^!\"",
      "encoded_base64": "IF4nbF4rQl4rZ14iJF4qQV4iZF4kKF4xN14kdV4pR14tK14jK14hVF4oVF4kel42bF4hIg==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_726648666858",
      "text": "斥候回報德拉吉大軍 ",
      "encoded_ascii": "^,S^*|^\"\\^+`^#j^$6^\"D^\"z^.. ",
      "encoded_base64": "XixTXip8XiJcXitgXiNqXiQ2XiJEXiJ6Xi4uIA==",
      "byte_length": 28
    },
    {
      "unit_id": "DLG_89e9216c572d",
      "text": "因風暴而陷入混亂，但他們重整旗鼓用不了多長時間。 ",
      "encoded_ascii": "^\"]^)y^$m^'W^)S^!f^%n^!3^*A^!I^!@^*{^))^$T^1B^*<^&H^!)^*D^\"x^)C^$f^)G^!\" ",
      "encoded_base64": "XiJdXil5XiRtXidXXilTXiFmXiVuXiEzXipBXiFJXiFAXip7XikpXiRUXjFCXio8XiZIXiEpXipEXiJ4XilDXiRmXilHXiEiIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_b50a421113a7",
      "text": "很快就能重新列陣！",
      "encoded_ascii": "^*K^*L^*J^'b^))^$\\^8f^)P^*W",
      "encoded_base64": "XipLXipMXipKXidiXikpXiRcXjhmXilQXipX",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_afee1faec949",
      "text": "已橫掃外圍農田，正長驅直入朝著 ",
      "encoded_ascii": "^#J^/2^:p^\"w^\"`^4i^;\\^*A^%H^)C^*#^&`^!f^,^^-a ",
      "encoded_base64": "XiNKXi8yXjpwXiJ3XiJgXjRpXjtcXipBXiVIXilDXiojXiZgXiFmXixeXi1hIA==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_435d0e4beaa1",
      "text": "提奎茲爾挺進！",
      "encoded_ascii": "^$A^5B^/D^&/^,I^(w^*W",
      "encoded_base64": "XiRBXjVCXi9EXiYvXixJXih3XipX",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_1ec7a666b9ed",
      "text": "你無法用數字來衡量那支大軍的兵力。他們的篝火 ",
      "encoded_ascii": "^*F^%}^%b^&H^$V^#)^!O^8P^)*^)!^$L^\"z^..^&Z^+,^!~^!\"^!@^*{^&Z^@>^%x ",
      "encoded_base64": "XipGXiV9XiViXiZIXiRWXiMpXiFPXjhQXikqXikhXiRMXiJ6Xi4uXiZaXissXiF+XiEiXiFAXip7XiZaXkA+XiV4IA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_880a53d67adc",
      "text": "猶如一片火紅的眼眸鋪展橫貫荒漠，他們行軍捲起的 ",
      "encoded_ascii": "^2y^#$^!%^&1^%x^3!^&Z^&d^@=^<1^+x^/2^;J^1W^,}^*A^!@^*{^(;^..^0c^.(^&Z ",
      "encoded_base64": "XjJ5XiMkXiElXiYxXiV4XjMhXiZaXiZkXkA9XjwxXit4Xi8yXjtKXjFXXix9XipBXiFAXip7Xig7Xi4uXjBjXi4oXiZaIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_ee55e8e2635c",
      "text": "漫天塵土足以讓一頭馬基洛特獸也窒息難耐。",
      "encoded_ascii": "^2,^+e^\"p^\"c^(^^!B^-}^!%^)t^*\"^/'^%g^&5^&<^!1^:~^#w^)a^-S^!\"",
      "encoded_base64": "XjIsXitlXiJwXiJjXiheXiFCXi19XiElXil0XioiXi8nXiVnXiY1XiY8XiExXjp+XiN3XilhXi1TXiEi",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_825907b74d32",
      "text": "來自 ",
      "encoded_ascii": "^!O^'l ",
      "encoded_base64": "XiFPXidsIA==",
      "byte_length": 7
    },
    {
      "unit_id": "DLG_6a0afb4d8aaf",
      "text": " 的勇士們已在綠洲附近紮營",
      "encoded_ascii": " ^&Z^\"$^+a^*{^#J^\"d^3V^76^.?^(l^8\"^&'",
      "encoded_base64": "IF4mWl4iJF4rYV4qe14jSl4iZF4zVl43Nl4uP14obF44Il4mJw==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_fd4c18b4aa49",
      "text": " ——他們因此得以免受風暴侵擾。他們將 ",
      "encoded_ascii": " ^*n^*n^!@^*{^\"]^%I^#e^!B^!e^\";^)y^$m^.X^$K^!\"^!@^*{^#7 ",
      "encoded_base64": "IF4qbl4qbl4hQF4qe14iXV4lSV4jZV4hQl4hZV4iO14peV4kbV4uWF4kS14hIl4hQF4qe14jNyA=",
      "byte_length": 56
    },
    {
      "unit_id": "DLG_5f2c4906202c",
      "text": "在村外集合列隊。",
      "encoded_ascii": "^\"d^$z^\"w^)]^\"C^8f^)U^!\"",
      "encoded_base64": "XiJkXiR6XiJ3XildXiJDXjhmXilVXiEi",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_34517997d5d7",
      "text": "。我一得到你們抵達的消息，就立刻傳令讓他們立即行軍。 ",
      "encoded_ascii": "^!\"^$%^!%^#e^!u^*F^*{^$5^(z^&Z^%k^#w^*A^*J^0'^.Y^+$^*w^-}^!@^*{^0'^\"1^(;^..^!\" ",
      "encoded_base64": "XiEiXiQlXiElXiNlXiF1XipGXip7XiQ1Xih6XiZaXiVrXiN3XipBXipKXjAnXi5ZXiskXip3Xi19XiFAXip7XjAnXiIxXig7Xi4uXiEiIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_97cfefe28e12",
      "text": "你們已然到來。",
      "encoded_ascii": "^*F^*{^#J^&\"^!u^!O^!\"",
      "encoded_base64": "XipGXip7XiNKXiYiXiF1XiFPXiEi",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_a1229dbb06e3",
      "text": "查爾",
      "encoded_ascii": "^%&^&/",
      "encoded_base64": "XiUmXiYv",
      "byte_length": 6
    },
    {
      "unit_id": "DLG_9e5888c48e25",
      "text": "英雄們，見到你們真好！",
      "encoded_ascii": "^'y^)\\^*{^*A^-m^!u^*F^*{^-2^+i^*W",
      "encoded_base64": "Xid5XilcXip7XipBXi1tXiF1XipGXip7Xi0yXitpXipX",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_3e7600cc153e",
      "text": "大戰已然落幕，但願你們此刻能好好休憩。",
      "encoded_ascii": "^\"z^$(^#J^&\"^-`^#Q^*A^!I^.H^*F^*{^%I^.Y^'b^+i^+i^!G^@:^!\"",
      "encoded_base64": "XiJ6XiQoXiNKXiYiXi1gXiNRXipBXiFJXi5IXipGXip7XiVJXi5ZXidiXitpXitpXiFHXkA6XiEi",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_688acaee3c7d",
      "text": "萬歲，大地的英雄！我們熱烈歡迎你們凱旋歸來，並共同慶賀你們擊潰 ",
      "encoded_ascii": "^-_^,j^*A^\"z^\"e^&Z^'y^)\\^*W^$%^*{^&$^%|^%F^(k^*F^*{^!p^$`^%K^!O^*A^!+^3d^\"E^5P^7l^*F^*{^$F^2- ",
      "encoded_base64": "Xi1fXixqXipBXiJ6XiJlXiZaXid5XilcXipXXiQlXip7XiYkXiV8XiVGXihrXipGXip7XiFwXiRgXiVLXiFPXipBXiErXjNkXiJFXjVQXjdsXipGXip7XiRGXjItIA==",
      "byte_length": 94
    },
    {
      "unit_id": "DLG_88945fe0cf95",
      "text": "邪惡德拉吉壓迫的偉大勝利！ ",
      "encoded_ascii": "^)\"^#y^#j^$6^\"D^4v^1`^&Z^*}^\"z^+5^!t^*W ",
      "encoded_base64": "XikiXiN5XiNqXiQ2XiJEXjR2XjFgXiZaXip9XiJ6Xis1XiF0XipXIA==",
      "byte_length": 40
    },
    {
      "unit_id": "DLG_b02fb3b8a72d",
      "text": "德拉吉的暴政就此覆滅！英雄們，萬壽無疆！",
      "encoded_ascii": "^#j^$6^\"D^&Z^$m^,P^*J^%I^(D^%t^*W^'y^)\\^*{^*A^-_^?=^%}^@<^*W",
      "encoded_base64": "XiNqXiQ2XiJEXiZaXiRtXixQXipKXiVJXihEXiV0XipXXid5XilcXip7XipBXi1fXj89XiV9XkA8XipX",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_f52da14a4bb7",
      "text": "  你們的熱情歡迎真是令我們受寵若驚！",
      "encoded_ascii": "  ^*F^*{^&Z^&$^,0^%F^(k^-2^,X^*w^$%^*{^\";^6U^'x^.Q^*W",
      "encoded_base64": "ICBeKkZeKnteJlpeJiReLDBeJUZeKGteLTJeLFheKndeJCVeKnteIjteNlVeJ3heLlFeKlc=",
      "byte_length": 53
    },
    {
      "unit_id": "DLG_342f45a2b3df",
      "text": "  我得走了，再見。",
      "encoded_ascii": "  ^$%^#e^.&^*D^*A^!l^-m^!\"",
      "encoded_base64": "ICBeJCVeI2VeLiZeKkReKkFeIWxeLW1eISI=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_1c995fa939f9",
      "text": "  關於德拉吉有什麼消息？",
      "encoded_ascii": "  ^.>^$^^#j^$6^\"D^$s^!=^.T^%k^#w^.V",
      "encoded_base64": "ICBeLj5eJF5eI2peJDZeIkReJHNeIT1eLlReJWteI3deLlY=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_ebd51d279329",
      "text": "  跟我說說查爾吧。",
      "encoded_ascii": "  ^.+^$%^-x^-x^%&^&/^*I^!\"",
      "encoded_base64": "ICBeLiteJCVeLXheLXheJSZeJi9eKkleISI=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_0a69f0f25282",
      "text": "  查爾的女兒卡圖拉後來怎麼樣了？",
      "encoded_ascii": "  ^%&^&/^&Z^#\"^++^\"0^\"b^$6^#b^!O^,,^.T^,f^*D^.V",
      "encoded_base64": "ICBeJSZeJi9eJlpeIyJeKyteIjBeImJeJDZeI2JeIU9eLCxeLlReLGZeKkReLlY=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_92c7e5e83ed1",
      "text": "  你看到那支暗影大軍了嗎？",
      "encoded_ascii": "  ^*F^*Q^!u^)!^$L^$k^#a^\"z^..^*D^+X^.V",
      "encoded_base64": "ICBeKkZeKlFeIXVeKSFeJExeJGteI2FeInpeLi5eKkReK1heLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_95eb053ba680",
      "text": "不不不，這是你們應得的！你們將恐懼的匕首深深刺入了德拉吉的 ",
      "encoded_ascii": "^!)^!)^!)^*A^(s^,X^*F^*{^0`^#e^&Z^*W^*F^*{^#7^#t^$#^&Z^\"(^)~^2*^2*^!w^!f^*D^#j^$6^\"D^&Z ",
      "encoded_base64": "XiEpXiEpXiEpXipBXihzXixYXipGXip7XjBgXiNlXiZaXipXXipGXip7XiM3XiN0XiQjXiZaXiIoXil+XjIqXjIqXiF3XiFmXipEXiNqXiQ2XiJEXiZaIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_60de2af6c47d",
      "text": "心臟，那些聖堂武士在再度對我們動手之前一定會三思而後行！ ",
      "encoded_ascii": "^#k^3Y^*A^)!^!8^'Z^42^%J^+a^\"d^!l^#V^#:^$%^*{^\"%^$+^!/^!z^!%^#.^$r^!&^#q^'W^#b^(;^*W ",
      "encoded_base64": "XiNrXjNZXipBXikhXiE4XidaXjQyXiVKXithXiJkXiFsXiNWXiM6XiQlXip7XiIlXiQrXiEvXiF6XiElXiMuXiRyXiEmXiNxXidXXiNiXig7XipXIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_90da665066e5",
      "text": "整個亞薩斯大陸的奴隸們都會為此歡呼雀躍。",
      "encoded_ascii": "^$T^!V^!9^-e^$[^\"z^99^&Z^##^)Z^*{^)$^$r^%{^%I^%F^\"M^<u^:b^!\"",
      "encoded_base64": "XiRUXiFWXiE5Xi1lXiRbXiJ6Xjk5XiZaXiMjXilaXip7XikkXiRyXiV7XiVJXiVGXiJNXjx1XjpiXiEi",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_96f2a550da9e",
      "text": "  他是個勇敢而高貴的靈魂。",
      "encoded_ascii": "  ^!@^,X^!V^\"$^/m^'W^*+^2F^&Z^)g^*.^!\"",
      "encoded_base64": "ICBeIUBeLFheIVZeIiReL21eJ1deKiteMkZeJlpeKWdeKi5eISI=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_2f0246478f2b",
      "text": "  看來提奎茲爾需要選出新的領袖了。",
      "encoded_ascii": "  ^*Q^!O^$A^5B^/D^&/^)e^(C^.6^!q^$\\^&Z^)s^7G^*D^!\"",
      "encoded_base64": "ICBeKlFeIU9eJEFeNUJeL0ReJi9eKWVeKENeLjZeIXFeJFxeJlpeKXNeN0deKkReISI=",
      "byte_length": 50
    },
    {
      "unit_id": "DLG_bb07ef2eb4af",
      "text": "  他太過魯莽，根本不足以在這種大戰中存活。",
      "encoded_ascii": "  ^!@^+f^(x^/K^;8^*A^%)^$x^!)^(^^!B^\"d^(s^'$^\"z^$(^!,^#*^%i^!\"",
      "encoded_base64": "ICBeIUBeK2ZeKHheL0teOzheKkFeJSleJHheISleKF5eIUJeImReKHNeJyReInpeJCheISxeIypeJWleISI=",
      "byte_length": 62
    },
    {
      "unit_id": "DLG_de2c6a1724df",
      "text": "且慢！ ",
      "encoded_ascii": "^!*^#~^*W ",
      "encoded_base64": "XiEqXiN+XipXIA==",
      "byte_length": 10
    },
    {
      "unit_id": "DLG_a04f703e9d74",
      "text": "憑著你們給德拉吉大軍造成的慘敗？絕無可能！ ",
      "encoded_ascii": "^,5^-a^*F^*{^'A^#j^$6^\"D^\"z^..^(v^$$^&Z^,4^$R^.V^-I^%}^\"A^'b^*W ",
      "encoded_base64": "Xiw1Xi1hXipGXip7XidBXiNqXiQ2XiJEXiJ6Xi4uXih2XiQkXiZaXiw0XiRSXi5WXi1JXiV9XiJBXidiXipXIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_7e98398bd81a",
      "text": "城中殘部四散潰逃於荒漠之中， ",
      "encoded_ascii": "^+_^!,^,l^)#^\"[^$S^2-^(p^$^^1W^,}^!/^!,^*A ",
      "encoded_base64": "XitfXiEsXixsXikjXiJbXiRTXjItXihwXiReXjFXXix9XiEvXiEsXipBIA==",
      "byte_length": 43
    },
    {
      "unit_id": "DLG_9b9a91b4c062",
      "text": "那些聖堂武士一段時間內也只能俯首蟄伏。",
      "encoded_ascii": "^)!^!8^'Z^42^%J^+a^!%^.l^$f^)G^!g^!1^\"?^'b^5*^)~^@?^3c^!\"",
      "encoded_base64": "XikhXiE4XidaXjQyXiVKXithXiElXi5sXiRmXilHXiFnXiExXiI/XidiXjUqXil+XkA/XjNjXiEi",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_f206e3f8a23b",
      "text": "是的！起初我還以為那是衝著我們來的，但 ",
      "encoded_ascii": "^,X^&Z^*W^.(^1\"^$%^.7^!B^%{^)!^,X^-h^-a^$%^*{^!O^&Z^*A^!I ",
      "encoded_base64": "XixYXiZaXipXXi4oXjEiXiQlXi43XiFCXiV7XikhXixYXi1oXi1hXiQlXip7XiFPXiZaXipBXiFJIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_8767f0c4d989",
      "text": "牠們帶來的援助確實令人感激至極！若無牠們相助，我實在不認為我們有辦法 ",
      "encoded_ascii": "^-#^*{^#N^!O^&Z^$C^\"#^-6^#3^*w^!<^#{^1H^'n^1D^*W^'x^%}^-#^*{^&a^\"#^*A^$%^#3^\"d^!)^(O^%{^$%^*{^$s^2L^%b ",
      "encoded_base64": "Xi0jXip7XiNOXiFPXiZaXiRDXiIjXi02XiMzXip3XiE8XiN7XjFIXiduXjFEXipXXid4XiV9Xi0jXip7XiZhXiIjXipBXiQlXiMzXiJkXiEpXihPXiV7XiQlXip7XiRzXjJMXiViIA==",
      "byte_length": 103
    },
    {
      "unit_id": "DLG_c68494ea55c0",
      "text": "取得最終的勝利。",
      "encoded_ascii": "^\":^#e^$q^-H^&Z^+5^!t^!\"",
      "encoded_base64": "XiI6XiNlXiRxXi1IXiZaXis1XiF0XiEi",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_e333c038edcb",
      "text": "她深深沉浸在查爾離世的悲痛之中，已啟程前往 ",
      "encoded_ascii": "^+h^2*^2*^%Z^=Z^\"d^%&^&/^)`^*p^&Z^,.^-.^!/^!,^*A^#J^57^'#^!z^,) ",
      "encoded_base64": "XitoXjIqXjIqXiVaXj1aXiJkXiUmXiYvXilgXipwXiZaXiwuXi0uXiEvXiEsXipBXiNKXjU3XicjXiF6XiwpIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_bc39e4069447",
      "text": "尼貝奈，尋訪她的親生父母。",
      "encoded_ascii": "^#>^/I^\"~^*A^#9^4d^+h^&Z^(F^&F^5d^/s^!\"",
      "encoded_base64": "XiM+Xi9JXiJ+XipBXiM5XjRkXitoXiZaXihGXiZGXjVkXi9zXiEi",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_4cd2883f7480",
      "text": "查爾在被孤立於麾下戰士之外時英勇殉職。然而，在他倒下之前， ",
      "encoded_ascii": "^%&^&/^\"d^(@^2c^0'^$^^4)^!(^$(^+a^!/^\"w^$f^'y^\"$^@;^'\\^!\"^&\"^'W^*A^\"d^!@^!X^!(^!/^!z^*A ",
      "encoded_base64": "XiUmXiYvXiJkXihAXjJjXjAnXiReXjQpXiEoXiQoXithXiEvXiJ3XiRmXid5XiIkXkA7XidcXiEiXiYiXidXXipBXiJkXiFAXiFYXiEoXiEvXiF6XipBIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_864415e239f1",
      "text": "他生生鑿穿了德拉吉大軍的主力方陣，大大遲滯了 ",
      "encoded_ascii": "^!@^&F^&F^6@^')^*D^#j^$6^\"D^\"z^..^&Z^!-^!~^$]^)P^*A^\"z^\"z^.5^:L^*D ",
      "encoded_base64": "XiFAXiZGXiZGXjZAXicpXipEXiNqXiQ2XiJEXiJ6Xi4uXiZaXiEtXiF+XiRdXilQXipBXiJ6XiJ6Xi41XjpMXipEIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_7a993fb2b7c8",
      "text": "敵軍對我們的正面衝擊。",
      "encoded_ascii": "^$U^..^#:^$%^*{^&Z^%H^)j^-h^$F^!\"",
      "encoded_base64": "XiRVXi4uXiM6XiQlXip7XiZaXiVIXilqXi1oXiRGXiEi",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_89a88bc86086",
      "text": "確實如此！但是 ",
      "encoded_ascii": "^-6^#3^#$^%I^*W^!I^,X ",
      "encoded_base64": "Xi02XiMzXiMkXiVJXipXXiFJXixYIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_ab2e4e5a1f40",
      "text": "是的，這正是我們當前的問題。 ",
      "encoded_ascii": "^,X^&Z^*A^(s^%H^,X^$%^*{^&N^!z^&Z^*Z^.G^!\" ",
      "encoded_base64": "XixYXiZaXipBXihzXiVIXixYXiQlXip7XiZOXiF6XiZaXipaXi5HXiEiIA==",
      "byte_length": 43
    },
    {
      "unit_id": "DLG_7057b15480af",
      "text": "儘管如此，他的英勇壯舉與犧牲精神必將受到永世敬仰。事實上，我們 ",
      "encoded_ascii": "^+(^-D^#$^%I^*A^!@^&Z^'y^\"$^+b^01^'p^2w^1J^'7^&w^#l^#7^\";^!u^%W^*p^*O^4,^!\"^*r^#3^!'^*A^$%^*{ ",
      "encoded_base64": "XisoXi1EXiMkXiVJXipBXiFAXiZaXid5XiIkXitiXjAxXidwXjJ3XjFKXic3XiZ3XiNsXiM3XiI7XiF1XiVXXipwXipPXjQsXiEiXipyXiMzXiEnXipBXiQlXip7IA==",
      "byte_length": 94
    },
    {
      "unit_id": "DLG_b87424e959ad",
      "text": "現在就必須著手為他辦理告別儀式。克維林將承繼 ",
      "encoded_ascii": "^&?^\"d^*J^#l^)r^-a^$+^%{^!@^2L^&A^+B^*H^+'^#X^!\"^!d^'F^/1^#7^$0^-O ",
      "encoded_base64": "XiY/XiJkXipKXiNsXilyXi1hXiQrXiV7XiFAXjJMXiZBXitCXipIXisnXiNYXiEiXiFkXidGXi8xXiM3XiQwXi1PIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_16f0be28fe49",
      "text": "提奎茲爾的領袖之位。",
      "encoded_ascii": "^$A^5B^/D^&/^&Z^)s^7G^!/^!J^!\"",
      "encoded_base64": "XiRBXjVCXi9EXiYvXiZaXilzXjdHXiEvXiFKXiEi",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_215f46357370",
      "text": "別了，朋友們。",
      "encoded_ascii": "^*H^*D^*A^,[^\"8^*{^!\"",
      "encoded_base64": "XipIXipEXipBXixbXiI4Xip7XiEi",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_031851b81766",
      "text": "提奎茲爾必須選出新的領袖",
      "encoded_ascii": "^$A^5B^/D^&/^#l^)r^.6^!q^$\\^&Z^)s^7G",
      "encoded_base64": "XiRBXjVCXi9EXiYvXiNsXilyXi42XiFxXiRcXiZaXilzXjdH",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_3c39d3094134",
      "text": " 已然陣亡，",
      "encoded_ascii": " ^#J^&\"^)P^!:^*A",
      "encoded_base64": "IF4jSl4mIl4pUF4hOl4qQQ==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_f0c15f53dbbd",
      "text": "而克維林的力量恐怕不足以抵禦那些必將接踵而至、 ",
      "encoded_ascii": "^'W^!d^'F^/1^&Z^!~^)*^#t^0^^!)^(^^!B^$5^&{^)!^!8^#l^#7^$?^@@^'W^'n^!! ",
      "encoded_base64": "XidXXiFkXidGXi8xXiZaXiF+XikqXiN0XjBeXiEpXiheXiFCXiQ1XiZ7XikhXiE4XiNsXiM3XiQ/XkBAXidXXiduXiEhIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_a59177bd2e22",
      "text": "覬覦統治之位的覬覦者。如果你願意接受 ",
      "encoded_ascii": "^8b^8a^'B^%_^!/^!J^&Z^8b^8a^'V^!\"^#$^%!^*F^.H^#z^$?^\"; ",
      "encoded_base64": "XjhiXjhhXidCXiVfXiEvXiFKXiZaXjhiXjhhXidWXiEiXiMkXiUhXipGXi5IXiN6XiQ/XiI7IA==",
      "byte_length": 55
    },
    {
      "unit_id": "DLG_3198613f4137",
      "text": "我們的邀請，出任提奎茲爾的領袖，沒有任何人膽敢 ",
      "encoded_ascii": "^$%^*{^&Z^:%^*S^*A^!q^!C^$A^5B^/D^&/^&Z^)s^7G^*A^%\\^$s^!C^!L^!<^-[^/m ",
      "encoded_base64": "XiQlXip7XiZaXjolXipTXipBXiFxXiFDXiRBXjVCXi9EXiYvXiZaXilzXjdHXipBXiVcXiRzXiFDXiFMXiE8Xi1bXi9tIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_8a40aec0510e",
      "text": "挑戰你的權威。這對我們而言將是無上的榮耀。 ",
      "encoded_ascii": "^,H^$(^*F^&Z^1E^#&^!\"^(s^#:^$%^*{^'W^1Y^#7^,X^%}^!'^&Z^,e^7D^!\" ",
      "encoded_base64": "XixIXiQoXipGXiZaXjFFXiMmXiEiXihzXiM6XiQlXip7XidXXjFZXiM3XixYXiV9XiEnXiZaXixlXjdEXiEiIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_482b2679d6be",
      "text": "你願意率領我們嗎？",
      "encoded_ascii": "^*F^.H^#z^22^)s^$%^*{^+X^.V",
      "encoded_base64": "XipGXi5IXiN6XjIyXilzXiQlXip7XitYXi5W",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_fbc95fcf43dd",
      "text": "太好了！在你的率領之下，我們必定繁榮昌盛！ ",
      "encoded_ascii": "^+f^+i^*D^*W^\"d^*F^&Z^22^)s^!/^!(^*A^$%^*{^#l^#.^-N^,e^2%^1L^*W ",
      "encoded_base64": "XitmXitpXipEXipXXiJkXipGXiZaXjIyXilzXiEvXiEoXipBXiQlXip7XiNsXiMuXi1OXixlXjIlXjFMXipXIA==",
      "byte_length": 64
    },
    {
      "unit_id": "DLG_68a2a0fcf21f",
      "text": "你們在每一層面上都是真正的英雄！",
      "encoded_ascii": "^*F^*{^\"d^%P^!%^#B^)j^!'^)$^,X^-2^%H^&Z^'y^)\\^*W",
      "encoded_base64": "XipGXip7XiJkXiVQXiElXiNCXilqXiEnXikkXixYXi0yXiVIXiZaXid5XilcXipX",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_7e05df9ccd9b",
      "text": "唉，也罷。我們早料到會是這個結果——畢竟像你們這樣的冒險者，很難 ",
      "encoded_ascii": "^+M^*A^!1^1Q^!\"^$%^*{^,V^/n^!u^$r^,X^(s^!V^'@^%!^*n^*n^;k^28^!`^*F^*{^(s^,f^&Z^/P^*m^'V^*A^*K^)a ",
      "encoded_base64": "XitNXipBXiExXjFRXiEiXiQlXip7XixWXi9uXiF1XiRyXixYXihzXiFWXidAXiUhXipuXipuXjtrXjI4XiFgXipGXip7XihzXixmXiZaXi9QXiptXidWXipBXipLXilhIA==",
      "byte_length": 97
    },
    {
      "unit_id": "DLG_667c8be715d0",
      "text": "心甘情願地就此安定下來。",
      "encoded_ascii": "^#k^/:^,0^.H^\"e^*J^%I^+p^#.^!(^!O^!\"",
      "encoded_base64": "XiNrXi86XiwwXi5IXiJlXipKXiVJXitwXiMuXiEoXiFPXiEi",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_78a926ea187b",
      "text": "！我必須由衷地感謝你們！你們的英雄壯舉拯救了 ",
      "encoded_ascii": "^*W^$%^#l^)r^&I^7i^\"e^#{^-z^*F^*{^*W^*F^*{^&Z^'y^)\\^+b^01^,F^,Q^*D ",
      "encoded_base64": "XipXXiQlXiNsXilyXiZJXjdpXiJlXiN7Xi16XipGXip7XipXXipGXip7XiZaXid5XilcXitiXjAxXixGXixRXipEIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_59b75223fca3",
      "text": "我的家人，也拯救了整個提奎茲爾。你們的功績將被 ",
      "encoded_ascii": "^$%^&Z^+s^!<^*A^!1^,F^,Q^*D^$T^!V^$A^5B^/D^&/^!\"^*F^*{^&Z^\"!^?P^#7^(@ ",
      "encoded_base64": "XiQlXiZaXitzXiE8XipBXiExXixGXixRXipEXiRUXiFWXiRBXjVCXi9EXiYvXiEiXipGXip7XiZaXiIhXj9QXiM3XihAIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_a8a7d7b762c6",
      "text": "世代珍藏，永遠傳頌！",
      "encoded_ascii": "^*p^*v^/7^-f^*A^%W^({^+$^7\"^*W",
      "encoded_base64": "XipwXip2Xi83Xi1mXipBXiVXXih7XiskXjciXipX",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_d447a1708587",
      "text": "  這份功勳應當歸於所有英勇的戰士們。",
      "encoded_ascii": "  ^(s^*x^\"!^@8^0`^&N^%K^$^^$)^$s^'y^\"$^&Z^$(^+a^*{^!\"",
      "encoded_base64": "ICBeKHNeKnheIiFeQDheMGBeJk5eJUteJF5eJCleJHNeJ3leIiReJlpeJCheK2FeKnteISI=",
      "byte_length": 53
    },
    {
      "unit_id": "DLG_7dfa52dc15d5",
      "text": "  提奎茲爾此役傷亡慘重嗎？",
      "encoded_ascii": "  ^$A^5B^/D^&/^%I^17^!^^!:^,4^))^+X^.V",
      "encoded_base64": "ICBeJEFeNUJeL0ReJi9eJUleMTdeIV5eITpeLDReKSleK1heLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_ed83124f50f2",
      "text": "你們太謙虛了！正是因為有你們，提奎茲爾 ",
      "encoded_ascii": "^*F^*{^+f^6x^-g^*D^*W^%H^,X^\"]^%{^$s^*F^*{^*A^$A^5B^/D^&/ ",
      "encoded_base64": "XipGXip7XitmXjZ4Xi1nXipEXipXXiVIXixYXiJdXiV7XiRzXipGXip7XipBXiRBXjVCXi9EXiYvIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_b99943de0dd4",
      "text": "才得以倖存。你們是締造傳奇的英雄！",
      "encoded_ascii": "^$,^#e^!B^5+^#*^!\"^*F^*{^,X^?6^(v^+$^\"}^&Z^'y^)\\^*W",
      "encoded_base64": "XiQsXiNlXiFCXjUrXiMqXiEiXipGXip7XixYXj82Xih2XiskXiJ9XiZaXid5XilcXipX",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_945dea5701ac",
      "text": "提奎茲爾依然屹立！這已遠超我們最初的期望，儘管 ",
      "encoded_ascii": "^$A^5B^/D^&/^!Q^&\"^?U^0'^*W^(s^#J^({^(\\^$%^*{^$q^1\"^&Z^$u^,]^*A^+(^-D ",
      "encoded_base64": "XiRBXjVCXi9EXiYvXiFRXiYiXj9VXjAnXipXXihzXiNKXih7XihcXiQlXip7XiRxXjEiXiZaXiR1XixdXipBXisoXi1EIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_c141bc80a5e5",
      "text": "這並非毫無代價。查爾在率軍鑿穿 ",
      "encoded_ascii": "^(s^!+^)i^/t^%}^*v^+&^!\"^%&^&/^\"d^22^..^6@^') ",
      "encoded_base64": "XihzXiErXilpXi90XiV9Xip2XismXiEiXiUmXiYvXiJkXjIyXi4uXjZAXicpIA==",
      "byte_length": 46
    },
    {
      "unit_id": "DLG_b6abd9773f22",
      "text": "德拉吉大軍主力方陣的衝鋒中以身殉職。",
      "encoded_ascii": "^#j^$6^\"D^\"z^..^!-^!~^$]^)P^&Z^-h^6?^!,^!B^(c^@;^'\\^!\"",
      "encoded_base64": "XiNqXiQ2XiJEXiJ6Xi4uXiEtXiF+XiRdXilQXiZaXi1oXjY/XiEsXiFCXihjXkA7XidcXiEi",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_b28e992d9def",
      "text": "我承認，沙暴期間我躲了起來。那場風暴實在令我不知所措！ ",
      "encoded_ascii": "^$%^$0^(O^*A^%]^$m^$u^)G^$%^0C^*D^.(^!O^!\"^)!^\"n^)y^$m^#3^\"d^*w^$%^!)^&h^$)^;[^*W ",
      "encoded_base64": "XiQlXiQwXihPXipBXiVdXiRtXiR1XilHXiQlXjBDXipEXi4oXiFPXiEiXikhXiJuXil5XiRtXiMzXiJkXip3XiQlXiEpXiZoXiQpXjtbXipXIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_e47a1102cbe1",
      "text": "但事後，我鼓起勇氣踏上那片血染的沙地，守護了我們的東翼防線。",
      "encoded_ascii": "^!I^*r^#b^*A^$%^*<^.(^\"$^%U^.,^!'^)!^&1^(:^%%^&Z^%]^\"e^*A^#+^(T^*D^$%^*{^&Z^,`^'T^)K^'I^!\"",
      "encoded_base64": "XiFJXipyXiNiXipBXiQlXio8Xi4oXiIkXiVVXi4sXiEnXikhXiYxXig6XiUlXiZaXiVdXiJlXipBXiMrXihUXipEXiQlXip7XiZaXixgXidUXilLXidJXiEi",
      "byte_length": 90
    },
    {
      "unit_id": "DLG_2110fce18dc4",
      "text": " 你們也萬壽無疆！",
      "encoded_ascii": " ^*F^*{^!1^-_^?=^%}^@<^*W",
      "encoded_base64": "IF4qRl4qe14hMV4tX14/PV4lfV5APF4qVw==",
      "byte_length": 25
    },
    {
      "unit_id": "DLG_7fe578fca455",
      "text": "哦！長老議會迫切地想要與你們相見。",
      "encoded_ascii": "^+H^*W^)C^'U^-|^$r^1`^+.^\"e^,1^(C^'p^*F^*{^&a^-m^!\"",
      "encoded_base64": "XitIXipXXilDXidVXi18XiRyXjFgXisuXiJlXiwxXihDXidwXipGXip7XiZhXi1tXiEi",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_12d52939acfc",
      "text": "我正在搭建一個 ",
      "encoded_ascii": "^$%^%H^\"d^8\\^,'^!%^!V ",
      "encoded_base64": "XiQlXiVIXiJkXjhcXiwnXiElXiFWIA==",
      "byte_length": 22
    },
    {
      "unit_id": "DLG_3278961ff18e",
      "text": "尖塔 尖塔",
      "encoded_ascii": "^#=^\"o ^#=^\"o",
      "encoded_base64": "XiM9XiJvIF4jPV4ibw==",
      "byte_length": 13
    },
    {
      "unit_id": "DLG_3c046d3e8b54",
      "text": "火葬的柴堆",
      "encoded_ascii": "^%x^-b^&Z^4G^*[",
      "encoded_base64": "XiV4Xi1iXiZaXjRHXipb",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_0026419b58ef",
      "text": "盤旋的濃煙",
      "encoded_ascii": "^1M^$`^&Z^%w^4S",
      "encoded_base64": "XjFNXiRgXiZaXiV3XjRT",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_88d6c96d5289",
      "text": "越升越高",
      "encoded_ascii": "^(]^\",^(]^*+",
      "encoded_base64": "XihdXiIsXihdXior",
      "byte_length": 12
    },
    {
      "unit_id": "DLG_1522c75e9507",
      "text": "他是恩南迪，我是洛曼。請原諒他可能說的瘋言瘋語。正如你們所見，他瘋得厲害， ",
      "encoded_ascii": "^!@^,X^#v^\"/^(m^*A^$%^,X^%g^4F^!\"^*S^\"5^0<^!@^\"A^'b^-x^&Z^-/^1Y^-/^0:^!\"^%H^#$^*F^*{^$)^-m^*A^!@^-/^#e^+:^#/^*A ",
      "encoded_base64": "XiFAXixYXiN2XiIvXihtXipBXiQlXixYXiVnXjRGXiEiXipTXiI1XjA8XiFAXiJBXidiXi14XiZaXi0vXjFZXi0vXjA6XiEiXiVIXiMkXipGXip7XiQpXi1tXipBXiFAXi0vXiNlXis6XiMvXipBIA==",
      "byte_length": 112
    },
    {
      "unit_id": "DLG_1dcd5fd6287d",
      "text": "烈日早已烤焦了他的心智。 ",
      "encoded_ascii": "^%|^$a^,V^#J^/w^%~^*D^!@^&Z^#k^$i^!\" ",
      "encoded_base64": "XiV8XiRhXixWXiNKXi93XiV+XipEXiFAXiZaXiNrXiRpXiEiIA==",
      "byte_length": 37
    },
    {
      "unit_id": "DLG_d3d02dc89213",
      "text": "  你們是怎麼活下來的？這裡如此險惡荒涼。",
      "encoded_ascii": "  ^*F^*{^,X^,,^.T^%i^!(^!O^&Z^.V^(s^-j^#$^%I^*m^#y^1W^,s^!\"",
      "encoded_base64": "ICBeKkZeKnteLFheLCxeLlReJWleISheIU9eJlpeLlZeKHNeLWpeIyReJUleKm1eI3leMVdeLHNeISI=",
      "byte_length": 59
    },
    {
      "unit_id": "DLG_4e92ef3fa4fe",
      "text": "  你們為什麼要住在這種地方？",
      "encoded_ascii": "  ^*F^*{^%{^!=^.T^(C^*z^\"d^(s^'$^\"e^$]^.V",
      "encoded_base64": "ICBeKkZeKnteJXteIT1eLlReKENeKnpeImReKHNeJyReImVeJF1eLlY=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_b560cca11258",
      "text": "  什麼是大石尖塔？",
      "encoded_ascii": "  ^!=^.T^,X^\"z^&k^#=^\"o^.V",
      "encoded_base64": "ICBeIT1eLlReLFheInpeJmteIz1eIm9eLlY=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_6aa6a7405229",
      "text": "  我確實對大石尖塔一無所知。",
      "encoded_ascii": "  ^$%^-6^#3^#:^\"z^&k^#=^\"o^!%^%}^$)^&h^!\"",
      "encoded_base64": "ICBeJCVeLTZeIzNeIzpeInpeJmteIz1eIm9eISVeJX1eJCleJmheISI=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_48b9eacaf12b",
      "text": "  是烈日把恩南迪逼瘋的嗎？",
      "encoded_ascii": "  ^,X^%|^$a^$1^#v^\"/^(m^.1^-/^&Z^+X^.V",
      "encoded_base64": "ICBeLFheJXxeJGFeJDFeI3ZeIi9eKG1eLjFeLS9eJlpeK1heLlY=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_cf86918d9794",
      "text": "很高興遇見你們。 ",
      "encoded_ascii": "^*K^*+^-]^.2^-m^*F^*{^!\" ",
      "encoded_base64": "XipLXiorXi1dXi4yXi1tXipGXip7XiEiIA==",
      "byte_length": 25
    },
    {
      "unit_id": "DLG_3dc39fbe2e5f",
      "text": "恩南迪和我住在這裡。",
      "encoded_ascii": "^#v^\"/^(m^\"O^$%^*z^\"d^(s^-j^!\"",
      "encoded_base64": "XiN2XiIvXihtXiJPXiQlXip6XiJkXihzXi1qXiEi",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_671d9c37532f",
      "text": "其實沒那麼糟。我們把形狀奇特的岩石賣給路過的商隊， ",
      "encoded_ascii": "^!j^#3^%\\^)!^.T^-E^!\"^$%^*{^$1^#_^&7^\"}^&5^&Z^#D^&k^.$^'A^(a^(x^&Z^1'^)U^*A ",
      "encoded_base64": "XiFqXiMzXiVcXikhXi5UXi1FXiEiXiQlXip7XiQxXiNfXiY3XiJ9XiY1XiZaXiNEXiZrXi4kXidBXihhXih4XiZaXjEnXilVXipBIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_48dcd1f441c2",
      "text": "還設陷阱捕捉小動物換取鮮肉。而且，當然了，大石 ",
      "encoded_ascii": "^.7^4e^)S^)J^4?^4>^#;^\"%^&4^4@^\":^35^'^^!\"^'W^!*^*A^&N^&\"^*D^*A^\"z^&k ",
      "encoded_base64": "Xi43XjRlXilTXilKXjQ/XjQ+XiM7XiIlXiY0XjRAXiI6XjM1XideXiEiXidXXiEqXipBXiZOXiYiXipEXipBXiJ6XiZrIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_cf9e47606ab7",
      "text": "尖塔一直在庇佑看顧著我們。",
      "encoded_ascii": "^#=^\"o^!%^&`^\"d^,\"^4.^*Q^4n^-a^$%^*{^!\"",
      "encoded_base64": "XiM9XiJvXiElXiZgXiJkXiwiXjQuXipRXjRuXi1hXiQlXip7XiEi",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_fb20405b25c2",
      "text": "噢，我們不喜歡城邦。那裡的人嘲笑恩南迪，對待我的態度 ",
      "encoded_ascii": "^+]^*A^$%^*{^!)^+V^%F^+_^1a^!\"^)!^-j^&Z^!<^+Z^-@^#v^\"/^(m^*A^#:^,*^$%^&Z^#|^#V ",
      "encoded_base64": "XitdXipBXiQlXip7XiEpXitWXiVGXitfXjFhXiEiXikhXi1qXiZaXiE8XitaXi1AXiN2XiIvXihtXipBXiM6XiwqXiQlXiZaXiN8XiNWIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_749e57027125",
      "text": "也好不到哪裡去。",
      "encoded_ascii": "^!1^+i^!)^!u^+I^-j^\"6^!\"",
      "encoded_base64": "XiExXitpXiEpXiF1XitJXi1qXiI2XiEi",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_b70077ddcae3",
      "text": "你們在開玩笑吧！人人都知道大石尖塔！",
      "encoded_ascii": "^*F^*{^\"d^)F^4U^-@^*I^*W^!<^!<^)$^&h^(y^\"z^&k^#=^\"o^*W",
      "encoded_base64": "XipGXip7XiJkXilGXjRVXi1AXipJXipXXiE8XiE8XikkXiZoXih5XiJ6XiZrXiM9XiJvXipX",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_84ab99c91769",
      "text": "你們居然是認真的！這太糟糕了！來……跟我來。直接帶你們去看看 ",
      "encoded_ascii": "^*F^*{^+w^&\"^,X^(O^-2^&Z^*W^(s^+f^-E^4\\^*D^*W^!O^*o^*o^.+^$%^!O^!\"^&`^$?^#N^*F^*{^\"6^*Q^*Q ",
      "encoded_base64": "XipGXip7Xit3XiYiXixYXihPXi0yXiZaXipXXihzXitmXi1FXjRcXipEXipXXiFPXipvXipvXi4rXiQlXiFPXiEiXiZgXiQ/XiNOXipGXip7XiI2XipRXipRIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_492678079403",
      "text": "會容易得多。",
      "encoded_ascii": "^$r^+t^,W^#e^\"x^!\"",
      "encoded_base64": "XiRyXit0XixXXiNlXiJ4XiEi",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_833581243c0a",
      "text": "千真萬確……真的很令人難過。你看，烈日總會對他說些他 ",
      "encoded_ascii": "^+7^-2^-_^-6^*o^*o^-2^&Z^*K^*w^!<^)a^(x^!\"^*F^*Q^*A^%|^$a^-M^$r^#:^!@^-x^!8^!@ ",
      "encoded_base64": "Xis3Xi0yXi1fXi02XipvXipvXi0yXiZaXipLXip3XiE8XilhXih4XiEiXipGXipRXipBXiV8XiRhXi1NXiRyXiM6XiFAXi14XiE4XiFAIA==",
      "byte_length": 79
    },
    {
      "unit_id": "DLG_5e930a220f52",
      "text": "不想聽的事情。他以前好多了，但現在瞧瞧他成什麼樣了！",
      "encoded_ascii": "^!)^,1^-X^&Z^*r^,0^!\"^!@^!B^!z^+i^\"x^*D^*A^!I^&?^\"d^-4^-4^!@^$$^!=^.T^,f^*D^*W",
      "encoded_base64": "XiEpXiwxXi1YXiZaXipyXiwwXiEiXiFAXiFCXiF6XitpXiJ4XipEXipBXiFJXiY/XiJkXi00Xi00XiFAXiQkXiE9Xi5UXixmXipEXipX",
      "byte_length": 78
    },
    {
      "unit_id": "DLG_2b3dfec876e1",
      "text": "再見！願大石尖塔與你們同在！",
      "encoded_ascii": "^!l^-m^*W^.H^\"z^&k^#=^\"o^'p^*F^*{^\"E^\"d^*W",
      "encoded_base64": "XiFsXi1tXipXXi5IXiJ6XiZrXiM9XiJvXidwXipGXip7XiJFXiJkXipX",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_f7b0803c2908",
      "text": "啊！瞧啊，恩南迪！我們的好朋友回來了！ ",
      "encoded_ascii": "^+Q^*W^-4^+Q^*A^#v^\"/^(m^*W^$%^*{^&Z^+i^,[^\"8^\"\\^!O^*D^*W ",
      "encoded_base64": "XitRXipXXi00XitRXipBXiN2XiIvXihtXipXXiQlXip7XiZaXitpXixbXiI4XiJcXiFPXipEXipXIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_1b5383a75a49",
      "text": "是什麼風把你們吹回來了？莫非你們是想尋求更多大石尖塔的智慧？",
      "encoded_ascii": "^,X^!=^.T^)y^$1^*F^*{^+A^\"\\^!O^*D^.V^/F^)i^*F^*{^,X^,1^#9^,n^$o^\"x^\"z^&k^#=^\"o^&Z^$i^4;^.V",
      "encoded_base64": "XixYXiE9Xi5UXil5XiQxXipGXip7XitBXiJcXiFPXipEXi5WXi9GXilpXipGXip7XixYXiwxXiM5XixuXiRvXiJ4XiJ6XiZrXiM9XiJvXiZaXiRpXjQ7Xi5W",
      "byte_length": 90
    },
    {
      "unit_id": "DLG_b66b8e225c05",
      "text": "  是的，我想跟大石尖塔談談。",
      "encoded_ascii": "  ^,X^&Z^*A^$%^,1^.+^\"z^&k^#=^\"o^0;^0;^!\"",
      "encoded_base64": "ICBeLFheJlpeKkFeJCVeLDFeLiteInpeJmteIz1eIm9eMDteMDteISI=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_6a6ee1649c0b",
      "text": "  我是來跟你談談的。",
      "encoded_ascii": "  ^$%^,X^!O^.+^*F^0;^0;^&Z^!\"",
      "encoded_base64": "ICBeJCVeLFheIU9eLiteKkZeMDteMDteJlpeISI=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_13ea350044ec",
      "text": "  大石尖塔不過是一塊普通的岩石罷了！",
      "encoded_ascii": "  ^\"z^&k^#=^\"o^!)^(x^,X^!%^/Z^$g^(t^&Z^#D^&k^1Q^*D^*W",
      "encoded_base64": "ICBeInpeJmteIz1eIm9eISleKHheLFheISVeL1peJGdeKHReJlpeI0ReJmteMVFeKkReKlc=",
      "byte_length": 53
    },
    {
      "unit_id": "DLG_3f627df33aad",
      "text": "  你能跟我們說說這片區域的事嗎？",
      "encoded_ascii": "  ^*F^'b^.+^$%^*{^-x^-x^(s^&1^\"+^\"k^&Z^*r^+X^.V",
      "encoded_base64": "ICBeKkZeJ2JeLiteJCVeKnteLXheLXheKHNeJjFeIiteImteJlpeKnJeK1heLlY=",
      "byte_length": 47
    },
    {
      "unit_id": "DLG_3c5c5f9ffde7",
      "text": "  洛曼，你瘋了嗎？",
      "encoded_ascii": "  ^%g^4F^*A^*F^-/^*D^+X^.V",
      "encoded_base64": "ICBeJWdeNEZeKkFeKkZeLS9eKkReK1heLlY=",
      "byte_length": 26
    },
    {
      "unit_id": "DLG_f850e425dd69",
      "text": "  這座尖塔根本沒有任何神力。",
      "encoded_ascii": "  ^(s^/_^#=^\"o^%)^$x^%\\^$s^!C^!L^&w^!~^!\"",
      "encoded_base64": "ICBeKHNeL19eIz1eIm9eJSleJHheJVxeJHNeIUNeIUxeJndeIX5eISI=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_8883e5c17f0f",
      "text": "  西南邊的村民全都是異教徒嗎？",
      "encoded_ascii": "  ^-l^\"/^.8^&Z^$z^%T^!h^)$^,X^&M^,R^#d^+X^.V",
      "encoded_base64": "ICBeLWxeIi9eLjheJlpeJHpeJVReIWheKSReLFheJk1eLFJeI2ReK1heLlY=",
      "byte_length": 44
    },
    {
      "unit_id": "DLG_6849c084df81",
      "text": "  多跟我說說瑪格拉巨怪的事。",
      "encoded_ascii": "  ^\"x^.+^$%^-x^-x^-*^%*^$6^#H^#s^&Z^*r^!\"",
      "encoded_base64": "ICBeInheLiteJCVeLXheLXheLSpeJSpeJDZeI0heI3NeJlpeKnJeISI=",
      "byte_length": 41
    },
    {
      "unit_id": "DLG_5c04eb00663a",
      "text": "  是大石尖塔創造了這處「人間天堂」？",
      "encoded_ascii": "  ^,X^\"z^&k^#=^\"o^!{^(v^*D^(s^(,^!#^!<^)G^+e^42^!$^.V",
      "encoded_base64": "ICBeLFheInpeJmteIz1eIm9eIXteKHZeKkReKHNeKCxeISNeITxeKUdeK2VeNDJeISReLlY=",
      "byte_length": 53
    },
    {
      "unit_id": "DLG_b753ea16665a",
      "text": "  這裡根本不是天堂！這裡依然是不毛的荒原惡地！",
      "encoded_ascii": "  ^(s^-j^%)^$x^!)^,X^+e^42^*W^(s^-j^!Q^&\"^,X^!)^%R^&Z^1W^\"5^#y^\"e^*W",
      "encoded_base64": "ICBeKHNeLWpeJSleJHheISleLFheK2VeNDJeKldeKHNeLWpeIVFeJiJeLFheISleJVJeJlpeMVdeIjVeI3leImVeKlc=",
      "byte_length": 68
    },
    {
      "unit_id": "DLG_3ae13868b6f7",
      "text": "  尖塔根本不會說話。",
      "encoded_ascii": "  ^#=^\"o^%)^$x^!)^$r^-x^-v^!\"",
      "encoded_base64": "ICBeIz1eIm9eJSleJHheISleJHJeLXheLXZeISI=",
      "byte_length": 29
    },
    {
      "unit_id": "DLG_f315e2357876",
      "text": "  是你瘋了，所以你才聽得見它說話！",
      "encoded_ascii": "  ^,X^*F^-/^*D^*A^$)^!B^*F^$,^-X^#e^-m^+o^-x^-v^*W",
      "encoded_base64": "ICBeLFheKkZeLS9eKkReKkFeJCleIUJeKkZeJCxeLVheI2VeLW1eK29eLXheLXZeKlc=",
      "byte_length": 50
    },
    {
      "unit_id": "DLG_426efd6e7ec2",
      "text": "太棒了！我們走吧！",
      "encoded_ascii": "^+f^%1^*D^*W^$%^*{^.&^*I^*W",
      "encoded_base64": "XitmXiUxXipEXipXXiQlXip7Xi4mXipJXipX",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_be43768fb216",
      "text": "噢，你們想聊些什麼？",
      "encoded_ascii": "^+]^*A^*F^*{^,1^-U^!8^!=^.T^.V",
      "encoded_base64": "XitdXipBXipGXip7XiwxXi1VXiE4XiE9Xi5UXi5W",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_3ce092e3e0da",
      "text": "好啊！這裡以東的惡地拔起化作高聳絕壁，而往北邊走， ",
      "encoded_ascii": "^+i^+Q^*W^(s^-j^!B^,`^&Z^#y^\"e^/c^.(^\")^!M^*+^4_^-I^*\\^*A^'W^,)^+6^.8^.&^*A ",
      "encoded_base64": "XitpXitRXipXXihzXi1qXiFCXixgXiZaXiN5XiJlXi9jXi4oXiIpXiFNXiorXjRfXi1JXipcXipBXidXXiwpXis2Xi44Xi4mXipBIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_3ad9ff20325c",
      "text": "瑪格拉巨怪盤踞在一頭巨獸的體內。而在遙遠的西方，有一座 ",
      "encoded_ascii": "^-*^%*^$6^#H^#s^1M^1_^\"d^!%^)t^#H^&<^&Z^**^!g^!\"^'W^\"d^4j^({^&Z^-l^$]^*A^$s^!%^/_ ",
      "encoded_base64": "Xi0qXiUqXiQ2XiNIXiNzXjFNXjFfXiJkXiElXil0XiNIXiY8XiZaXioqXiFnXiEiXidXXiJkXjRqXih7XiZaXi1sXiRdXipBXiRzXiElXi9fIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_5c02519f7f68",
      "text": "異教徒的村落。",
      "encoded_ascii": "^&M^,R^#d^&Z^$z^-`^!\"",
      "encoded_base64": "XiZNXixSXiNkXiZaXiR6Xi1gXiEi",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_62dacaa6fcf5",
      "text": "你們為什麼要質疑我的理智？我是……等等！我知道了！你們對大石 ",
      "encoded_ascii": "^*F^*{^%{^!=^.T^(C^(Z^0p^$%^&Z^&A^$i^.V^$%^,X^*o^*o^'-^'-^*W^$%^&h^(y^*D^*W^*F^*{^#:^\"z^&k ",
      "encoded_base64": "XipGXip7XiV7XiE9Xi5UXihDXihaXjBwXiQlXiZaXiZBXiRpXi5WXiQlXixYXipvXipvXictXictXipXXiQlXiZoXih5XipEXipXXipGXip7XiM6XiJ6XiZrIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_b5f769762b64",
      "text": "尖塔毫無信仰！你們怎敢否定它的偉力？你們自己分明也 ",
      "encoded_ascii": "^#=^\"o^/t^%}^!U^4,^*W^*F^*{^,,^/m^\"H^#.^+o^&Z^*}^!~^.V^*F^*{^'l^#I^!s^$c^!1 ",
      "encoded_base64": "XiM9XiJvXi90XiV9XiFVXjQsXipXXipGXip7XiwsXi9tXiJIXiMuXitvXiZaXip9XiF+Xi5WXipGXip7XidsXiNJXiFzXiRjXiExIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_4afe4c5993ad",
      "text": "親耳聽見了！",
      "encoded_ascii": "^(F^'Y^-X^-m^*D^*W",
      "encoded_base64": "XihGXidZXi1YXi1tXipEXipX",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_cc4b14a28f7b",
      "text": "沒有神力？！睜大你們的眼睛看看四周！這處美麗的天堂曾經是一片荒蕪的 ",
      "encoded_ascii": "^%\\^$s^&w^!~^.V^*W^.q^\"z^*F^*{^&Z^&d^&f^*Q^*Q^\"[^\"L^*W^(s^(,^-P^0z^&Z^+e^42^.j^'D^,X^!%^&1^1W^4b^&Z ",
      "encoded_base64": "XiVcXiRzXiZ3XiF+Xi5WXipXXi5xXiJ6XipGXip7XiZaXiZkXiZmXipRXipRXiJbXiJMXipXXihzXigsXi1QXjB6XiZaXitlXjQyXi5qXidEXixYXiElXiYxXjFXXjRiXiZaIA==",
      "byte_length": 100
    },
    {
      "unit_id": "DLG_93ac797e742a",
      "text": "惡地。但隨後大石尖塔破土而出！頃刻之間， ",
      "encoded_ascii": "^#y^\"e^!\"^!I^)X^#b^\"z^&k^#=^\"o^&n^\"c^'W^!q^*W^4m^.Y^!/^)G^*A ",
      "encoded_base64": "XiN5XiJlXiEiXiFJXilYXiNiXiJ6XiZrXiM9XiJvXiZuXiJjXidXXiFxXipXXjRtXi5ZXiEvXilHXipBIA==",
      "byte_length": 61
    },
    {
      "unit_id": "DLG_0abe95582b25",
      "text": "萬物便化作了你們眼前所見的景象——一座鬱鬱蔥蔥、豐饒無比的伊甸樂園！",
      "encoded_ascii": "^-_^&4^!R^\")^!M^*D^*F^*{^&d^!z^$)^-m^&Z^4E^4g^*n^*n^!%^/_^4o^4o^4a^4a^!!^4!^.M^%}^,m^&Z^!E^4X^%8^41^*W",
      "encoded_base64": "Xi1fXiY0XiFSXiIpXiFNXipEXipGXip7XiZkXiF6XiQpXi1tXiZaXjRFXjRnXipuXipuXiElXi9fXjRvXjRvXjRhXjRhXiEhXjQhXi5NXiV9XixtXiZaXiFFXjRYXiU4XjQxXipX",
      "byte_length": 102
    },
    {
      "unit_id": "DLG_f7ca9cb1f97a",
      "text": "最惡劣的那種異教徒！大石尖塔差遣我們前往那裡，傳播 ",
      "encoded_ascii": "^$q^#y^+2^&Z^)!^'$^&M^,R^#d^*W^\"z^&k^#=^\"o^48^4k^$%^*{^!z^,)^)!^-j^*A^+$^4A ",
      "encoded_base64": "XiRxXiN5XisyXiZaXikhXickXiZNXixSXiNkXipXXiJ6XiZrXiM9XiJvXjQ4XjRrXiQlXip7XiF6XiwpXikhXi1qXipBXiskXjRBIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_0b9b9b2f69cb",
      "text": "它的豐饒福音……他們卻用長矛把我們轟了出來！塞德利特村 ",
      "encoded_ascii": "^+o^&Z^4!^.M^&z^34^*o^*o^!@^*{^1&^&H^)C^4Z^$1^$%^*{^.y^*D^!q^!O^*W^/(^#j^!t^&5^$z ",
      "encoded_base64": "XitvXiZaXjQhXi5NXiZ6XjM0XipvXipvXiFAXip7XjEmXiZIXilDXjRaXiQxXiQlXip7Xi55XipEXiFxXiFPXipXXi8oXiNqXiF0XiY1XiR6IA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_314bd77745ff",
      "text": "對我們可是一點好感也沒有。",
      "encoded_ascii": "^#:^$%^*{^\"A^,X^!%^*;^+i^#{^!1^%\\^$s^!\"",
      "encoded_base64": "XiM6XiQlXip7XiJBXixYXiElXio7XitpXiN7XiExXiVcXiRzXiEi",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_26e0e9a86222",
      "text": "我從來沒敢靠得太近牠們的巢穴。牠們殘暴凶狠。 ",
      "encoded_ascii": "^$%^#f^!O^%\\^/m^.C^#e^+f^(l^-#^*{^&Z^#G^'&^!\"^-#^*{^,l^$m^3e^4T^!\" ",
      "encoded_base64": "XiQlXiNmXiFPXiVcXi9tXi5DXiNlXitmXihsXi0jXip7XiZaXiNHXicmXiEiXi0jXip7XixsXiRtXjNlXjRUXiEiIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_b098c34fe295",
      "text": "你得比恩南迪還要瘋癲，才會想跑到那種地方去！",
      "encoded_ascii": "^*F^#e^,m^#v^\"/^(m^.7^(C^-/^4Y^*A^$,^$r^,1^(_^!u^)!^'$^\"e^$]^\"6^*W",
      "encoded_base64": "XipGXiNlXixtXiN2XiIvXihtXi43XihDXi0vXjRZXipBXiQsXiRyXiwxXihfXiF1XikhXickXiJlXiRdXiI2XipX",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_76331ae6e87e",
      "text": "是啊！難道這還不夠美妙嗎？鳥兒的清脆啼鳴。鮮花的芬芳撲鼻。而且， ",
      "encoded_ascii": "^,X^+Q^*W^)a^(y^(s^.7^!)^+d^-P^43^+X^.V^4p^++^&Z^,u^2?^40^.|^!\"^35^'w^&Z^/C^4`^4B^4q^!\"^'W^!*^*A ",
      "encoded_base64": "XixYXitRXipXXilhXih5XihzXi43XiEpXitkXi1QXjQzXitYXi5WXjRwXisrXiZaXix1XjI/XjQwXi58XiEiXjM1Xid3XiZaXi9DXjRgXjRCXjRxXiEiXidXXiEqXipBIA==",
      "byte_length": 97
    },
    {
      "unit_id": "DLG_1aea3180324f",
      "text": "沒錯！溪流潺潺的歡歌！來吧！我感到自己迫不及待想要沐浴在 ",
      "encoded_ascii": "^%\\^)5^*W^4P^%j^4R^4R^&Z^%F^4J^*W^!O^*I^*W^$%^#{^!u^'l^#I^1`^!)^\"7^,*^,1^(C^4L^4N^\"d ",
      "encoded_base64": "XiVcXik1XipXXjRQXiVqXjRSXjRSXiZaXiVGXjRKXipXXiFPXipJXipXXiQlXiN7XiF1XidsXiNJXjFgXiEpXiI3XiwqXiwxXihDXjRMXjROXiJkIA==",
      "byte_length": 85
    },
    {
      "unit_id": "DLG_3d182698ab82",
      "text": "大石尖塔的神妙恩典之中！",
      "encoded_ascii": "^\"z^&k^#=^\"o^&Z^&w^43^#v^2W^!/^!,^*W",
      "encoded_base64": "XiJ6XiZrXiM9XiJvXiZaXiZ3XjQzXiN2XjJXXiEvXiEsXipX",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_f37ed869fb13",
      "text": "什麼？你們看不見我們所見到的景象嗎？一定是邪惡力量支配操縱了你們的 ",
      "encoded_ascii": "^!=^.T^.V^*F^*{^*Q^!)^-m^$%^*{^$)^-m^!u^&Z^4E^4g^+X^.V^!%^#.^,X^)\"^#y^!~^)*^$L^)&^$H^4]^*D^*F^*{^&Z ",
      "encoded_base64": "XiE9Xi5UXi5WXipGXip7XipRXiEpXi1tXiQlXip7XiQpXi1tXiF1XiZaXjRFXjRnXitYXi5WXiElXiMuXixYXikiXiN5XiF+XikqXiRMXikmXiRIXjRdXipEXipGXip7XiZaIA==",
      "byte_length": 100
    },
    {
      "unit_id": "DLG_97e96ff6a646",
      "text": "心智！來吧！我們沒時間可以浪費了！我們立刻出發前往 ",
      "encoded_ascii": "^#k^$i^*W^!O^*I^*W^$%^*{^%\\^$f^)G^\"A^!B^,r^.\"^*D^*W^$%^*{^0'^.Y^!q^&W^!z^,) ",
      "encoded_base64": "XiNrXiRpXipXXiFPXipJXipXXiQlXip7XiVcXiRmXilHXiJBXiFCXixyXi4iXipEXipXXiQlXip7XjAnXi5ZXiFxXiZXXiF6XiwpIA==",
      "byte_length": 76
    },
    {
      "unit_id": "DLG_f8f1e0fb2acb",
      "text": "大石尖塔！",
      "encoded_ascii": "^\"z^&k^#=^\"o^*W",
      "encoded_base64": "XiJ6XiZrXiM9XiJvXipX",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_7bfc92f6a0b8",
      "text": "你、你們怎能這麼說？！你們自己也親耳聽見大石尖塔說話了！",
      "encoded_ascii": "^*F^!!^*F^*{^,,^'b^(s^.T^-x^.V^*W^*F^*{^'l^#I^!1^(F^'Y^-X^-m^\"z^&k^#=^\"o^-x^-v^*D^*W",
      "encoded_base64": "XipGXiEhXipGXip7XiwsXidiXihzXi5UXi14Xi5WXipXXipGXip7XidsXiNJXiExXihGXidZXi1YXi1tXiJ6XiZrXiM9XiJvXi14Xi12XipEXipX",
      "byte_length": 84
    },
    {
      "unit_id": "DLG_fcb1e7b68a39",
      "text": "它當然會說話！你們肯定是還沒像我們一樣與尖塔的 ",
      "encoded_ascii": "^+o^&N^&\"^$r^-x^-v^*W^*F^*{^-Z^#.^,X^.7^%\\^!`^$%^*{^!%^,f^'p^#=^\"o^&Z ",
      "encoded_base64": "XitvXiZOXiYiXiRyXi14Xi12XipXXipGXip7Xi1aXiMuXixYXi43XiVcXiFgXiQlXip7XiElXixmXidwXiM9XiJvXiZaIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_011b9895c6b9",
      "text": "神力調諧相通。恩南迪和我現在正要前往大石尖塔。跟上來吧！",
      "encoded_ascii": "^&w^!~^(Q^4f^&a^(t^!\"^#v^\"/^(m^\"O^$%^&?^\"d^%H^(C^!z^,)^\"z^&k^#=^\"o^!\"^.+^!'^!O^*I^*W",
      "encoded_base64": "XiZ3XiF+XihRXjRmXiZhXih0XiEiXiN2XiIvXihtXiJPXiQlXiY/XiJkXiVIXihDXiF6XiwpXiJ6XiZrXiM9XiJvXiEiXi4rXiEnXiFPXipJXipX",
      "byte_length": 84
    },
    {
      "unit_id": "DLG_a436a6928192",
      "text": "我「瘋了」？哈！我說瘋了的分明是你們！只有瘋子 ",
      "encoded_ascii": "^$%^!#^-/^*D^!$^.V^+F^*W^$%^-x^-/^*D^&Z^!s^$c^,X^*F^*{^*W^\"?^$s^-/^#( ",
      "encoded_base64": "XiQlXiEjXi0vXipEXiEkXi5WXitGXipXXiQlXi14Xi0vXipEXiZaXiFzXiRjXixYXipGXip7XipXXiI/XiRzXi0vXiMoIA==",
      "byte_length": 70
    },
    {
      "unit_id": "DLG_a32b6eae65a3",
      "text": "才會否定大石尖塔的無上神威！",
      "encoded_ascii": "^$,^$r^\"H^#.^\"z^&k^#=^\"o^&Z^%}^!'^&w^#&^*W",
      "encoded_base64": "XiQsXiRyXiJIXiMuXiJ6XiZrXiM9XiJvXiZaXiV9XiEnXiZ3XiMmXipX",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_52ebbeacdcbb",
      "text": "我們正要去跟大石尖塔交談呢。一起來吧！你們一定會 ",
      "encoded_ascii": "^$%^*{^%H^(C^\"6^.+^\"z^&k^#=^\"o^0P^0;^+C^!\"^!%^.(^!O^*I^*W^*F^*{^!%^#.^$r ",
      "encoded_base64": "XiQlXip7XiVIXihDXiI2Xi4rXiJ6XiZrXiM9XiJvXjBQXjA7XitDXiEiXiElXi4oXiFPXipJXipXXipGXip7XiElXiMuXiRyIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_f223d541d292",
      "text": "樂在其中的，我敢保證！",
      "encoded_ascii": "^%8^\"d^!j^!,^&Z^*A^$%^/m^!T^-{^*W",
      "encoded_base64": "XiU4XiJkXiFqXiEsXiZaXipBXiQlXi9tXiFUXi17XipX",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_ab05db097dbb",
      "text": "就在這裡！ ",
      "encoded_ascii": "^*J^\"d^(s^-j^*W ",
      "encoded_base64": "XipKXiJkXihzXi1qXipXIA==",
      "byte_length": 16
    },
    {
      "unit_id": "DLG_bde665d0316f",
      "text": "噢，大石尖塔，這片榮美土地堅如磐石的君主，我為您帶來了訪客， ",
      "encoded_ascii": "^+]^*A^\"z^&k^#=^\"o^*A^(s^&1^,e^-P^\"c^\"e^\"l^#$^4[^&k^&Z^+@^!-^*A^$%^%{^4:^#N^!O^*D^4d^+q^*A ",
      "encoded_base64": "XitdXipBXiJ6XiZrXiM9XiJvXipBXihzXiYxXixlXi1QXiJjXiJlXiJsXiMkXjRbXiZrXiZaXitAXiEtXipBXiQlXiV7XjQ6XiNOXiFPXipEXjRkXitxXipBIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_97c0941136c0",
      "text": "前來沐浴在您的智慧之中！",
      "encoded_ascii": "^!z^!O^4L^4N^\"d^4:^&Z^$i^4;^!/^!,^*W",
      "encoded_base64": "XiF6XiFPXjRMXjROXiJkXjQ6XiZaXiRpXjQ7XiEvXiEsXipX",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_b615db485400",
      "text": "洛曼聚精會神地凝神傾聽。",
      "encoded_ascii": "^%g^4F^'[^'7^$r^&w^\"e^!o^&w^2U^-X^!\"",
      "encoded_base64": "XiVnXjRGXidbXic3XiRyXiZ3XiJlXiFvXiZ3XjJVXi1YXiEi",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_6a51525a04c7",
      "text": "你們可曾聽過如此神妙的宏論真言？我看絕無可能！來吧，恩南迪！ ",
      "encoded_ascii": "^*F^*{^\"A^.j^-X^(x^#$^%I^&w^43^&Z^45^1\\^-2^1Y^.V^$%^*Q^-I^%}^\"A^'b^*W^!O^*I^*A^#v^\"/^(m^*W ",
      "encoded_base64": "XipGXip7XiJBXi5qXi1YXih4XiMkXiVJXiZ3XjQzXiZaXjQ1XjFcXi0yXjFZXi5WXiQlXipRXi1JXiV9XiJBXidiXipXXiFPXipJXipBXiN2XiIvXihtXipXIA==",
      "byte_length": 91
    },
    {
      "unit_id": "DLG_ffb26baf6843",
      "text": "讓我們恪遵並踐行大石尖塔的聖意！",
      "encoded_ascii": "^-}^$%^*{^49^4#^!+^4h^(;^\"z^&k^#=^\"o^&Z^'Z^#z^*W",
      "encoded_base64": "Xi19XiQlXip7XjQ5XjQjXiErXjRoXig7XiJ6XiZrXiM9XiJvXiZaXidaXiN6XipX",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_9db582f1caaf",
      "text": "噢，全能尖塔，高聳巍峨的樂園主宰！ ",
      "encoded_ascii": "^+]^*A^!h^'b^#=^\"o^*A^*+^4_^47^46^&Z^%8^41^!-^1w^*W ",
      "encoded_base64": "XitdXipBXiFoXidiXiM9XiJvXipBXiorXjRfXjQ3XjQ2XiZaXiU4XjQxXiEtXjF3XipXIA==",
      "byte_length": 52
    },
    {
      "unit_id": "DLG_33558efa255c",
      "text": "看哪！旅人們又回來了！請將您的無上威嚴傾注於他們之身吧！",
      "encoded_ascii": "^*Q^+I^*W^2m^!<^*{^+;^\"\\^!O^*D^*W^*S^#7^4:^&Z^%}^!'^#&^1*^2U^%e^$^^!@^*{^!/^(c^*I^*W",
      "encoded_base64": "XipRXitJXipXXjJtXiE8Xip7Xis7XiJcXiFPXipEXipXXipTXiM3XjQ6XiZaXiV9XiEnXiMmXjEqXjJVXiVlXiReXiFAXip7XiEvXihjXipJXipX",
      "byte_length": 84
    },
    {
      "unit_id": "DLG_f3f8a0684d79",
      "text": "這些可憐的靈魂雙眼被邪惡所蒙蔽——他們 ",
      "encoded_ascii": "^(s^!8^\"A^1}^&Z^)g^*.^)_^&d^(@^)\"^#y^$)^-c^('^*n^*n^!@^*{ ",
      "encoded_base64": "XihzXiE4XiJBXjF9XiZaXilnXiouXilfXiZkXihAXikiXiN5XiQpXi1jXignXipuXipuXiFAXip7IA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_9f0712f725a9",
      "text": "根本無法體會您的神妙！救救他們吧……我懇求您。",
      "encoded_ascii": "^%)^$x^%}^%b^**^$r^4:^&Z^&w^43^*W^,Q^,Q^!@^*{^*I^*o^*o^$%^3t^,n^4:^!\"",
      "encoded_base64": "XiUpXiR4XiV9XiViXioqXiRyXjQ6XiZaXiZ3XjQzXipXXixRXixRXiFAXip7XipJXipvXipvXiQlXjN0XixuXjQ6XiEi",
      "byte_length": 69
    },
    {
      "unit_id": "DLG_0961d79b9fe6",
      "text": "一抹無比幸福欣慰的笑容浮現在洛曼臉上。",
      "encoded_ascii": "^!%^4=^%}^,m^15^&z^2'^4<^&Z^-@^+t^4M^&?^\"d^%g^4F^-\\^!'^!\"",
      "encoded_base64": "XiElXjQ9XiV9XixtXjE1XiZ6XjInXjQ8XiZaXi1AXit0XjRNXiY/XiJkXiVnXjRGXi1cXiEnXiEi",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_ebfe905af062",
      "text": "對！沒錯！噢，感激不盡，大石尖塔！你們看見了吧，朋友們！它的神威 ",
      "encoded_ascii": "^#:^*W^%\\^)5^*W^+]^*A^#{^1H^!)^-1^*A^\"z^&k^#=^\"o^*W^*F^*{^*Q^-m^*D^*I^*A^,[^\"8^*{^*W^+o^&Z^&w^#& ",
      "encoded_base64": "XiM6XipXXiVcXik1XipXXitdXipBXiN7XjFIXiEpXi0xXipBXiJ6XiZrXiM9XiJvXipXXipGXip7XipRXi1tXipEXipJXipBXixbXiI4Xip7XipXXitvXiZaXiZ3XiMmIA==",
      "byte_length": 97
    },
    {
      "unit_id": "DLG_82cc04a51c27",
      "text": "舉世無雙！來吧，恩南迪，我們必須去尋找更多人，把他們從 ",
      "encoded_ascii": "^01^*p^%}^)_^*W^!O^*I^*A^#v^\"/^(m^*A^$%^*{^#l^)r^\"6^#9^$/^$o^\"x^!<^*A^$1^!@^*{^#f ",
      "encoded_base64": "XjAxXipwXiV9XilfXipXXiFPXipJXipBXiN2XiIvXihtXipBXiQlXip7XiNsXilyXiI2XiM5XiQvXiRvXiJ4XiE8XipBXiQxXiFAXip7XiNmIA==",
      "byte_length": 82
    },
    {
      "unit_id": "DLG_48106442638f",
      "text": "精神上的愚昧無知中解救出來！",
      "encoded_ascii": "^'7^&w^!'^&Z^/a^4D^%}^&h^!,^(I^,Q^!q^!O^*W",
      "encoded_base64": "Xic3XiZ3XiEnXiZaXi9hXjREXiV9XiZoXiEsXihJXixRXiFxXiFPXipX",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_e6e72dd01c58",
      "text": "兵器，兵器，利劍，烈火！那些小狗和一切——看哪，牠們對著我 ",
      "encoded_ascii": "^+,^\"V^*A^+,^\"V^*A^!t^!|^*A^%|^%x^*W^)!^!8^#;^-&^\"O^!%^+.^*n^*n^*Q^+I^*A^-#^*{^#:^-a^$% ",
      "encoded_base64": "XissXiJWXipBXissXiJWXipBXiF0XiF8XipBXiV8XiV4XipXXikhXiE4XiM7Xi0mXiJPXiElXisuXipuXipuXipRXitJXipBXi0jXip7XiM6Xi1hXiQlIA==",
      "byte_length": 88
    },
    {
      "unit_id": "DLG_cbb4c6e375c8",
      "text": "狂吠不止。汪汪。",
      "encoded_ascii": "^&8^4/^!)^%G^!\"^4K^4K^!\"",
      "encoded_base64": "XiY4XjQvXiEpXiVHXiEiXjRLXjRLXiEi",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_cf87fe15934e",
      "text": "看哪，看哪，一隻老鼠！安靜，安靜！快，拿烤乳酪餵牠！",
      "encoded_ascii": "^*Q^+I^*A^*Q^+I^*A^!%^)[^'U^*=^*W^+p^)h^*A^+p^)h^*W^*L^*A^,G^/w^!2^4l^.L^-#^*W",
      "encoded_base64": "XipRXitJXipBXipRXitJXipBXiElXilbXidVXio9XipXXitwXiloXipBXitwXiloXipXXipMXipBXixHXi93XiEyXjRsXi5MXi0jXipX",
      "byte_length": 78
    },
    {
      "unit_id": "DLG_dbf6c4453677",
      "text": "這裡聞起來滿是玫瑰的花香！他們曾告訴我我是一切。",
      "encoded_ascii": "^(s^-j^4^^.(^!O^,{^,X^4V^4W^&Z^'w^*!^*W^!@^*{^.j^+B^-t^$%^$%^,X^!%^+.^!\"",
      "encoded_base64": "XihzXi1qXjReXi4oXiFPXix7XixYXjRWXjRXXiZaXid3XiohXipXXiFAXip7Xi5qXitCXi10XiQlXiQlXixYXiElXisuXiEi",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_705a0772b21a",
      "text": "大石尖塔！啊……得聞歡愉之尊名！",
      "encoded_ascii": "^\"z^&k^#=^\"o^*W^+Q^*o^*o^#e^4^^%F^1|^!/^+u^\"F^*W",
      "encoded_base64": "XiJ6XiZrXiM9XiJvXipXXitRXipvXipvXiNlXjReXiVGXjF8XiEvXit1XiJGXipX",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_8d9c4e0c2c5e",
      "text": "你可曾見過農夫的狗對著乞丐狂吠？",
      "encoded_ascii": "^*F^\"A^.j^-m^(x^4i^\"{^&Z^-&^#:^-a^4+^4*^&8^4/^.V",
      "encoded_base64": "XipGXiJBXi5qXi1tXih4XjRpXiJ7XiZaXi0mXiM6Xi1hXjQrXjQqXiY4XjQvXi5W",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_0ae6eb8983b1",
      "text": "是的，但先把它擦乾淨……它散發著凡人必死的腐朽氣息。",
      "encoded_ascii": "^,X^&Z^*A^!I^!b^$1^+o^4C^*X^0k^*o^*o^+o^$S^&W^-a^+-^!<^#l^%L^&Z^0/^3K^%U^#w^!\"",
      "encoded_base64": "XixYXiZaXipBXiFJXiFiXiQxXitvXjRDXipYXjBrXipvXipvXitvXiRTXiZXXi1hXistXiE8XiNsXiVMXiZaXjAvXjNLXiVVXiN3XiEi",
      "byte_length": 78
    },
    {
      "unit_id": "DLG_6fa8bc00ec16",
      "text": "去看那些你們看不見的事物！快點快點！莎、莎、莎！",
      "encoded_ascii": "^\"6^*Q^)!^!8^*F^*{^*Q^!)^-m^&Z^*r^&4^*W^*L^*;^*L^*;^*W^/E^!!^/E^!!^/E^*W",
      "encoded_base64": "XiI2XipRXikhXiE4XipGXip7XipRXiEpXi1tXiZaXipyXiY0XipXXipMXio7XipMXio7XipXXi9FXiEhXi9FXiEhXi9FXipX",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_744bd2834f0b",
      "text": "我傷心欲絕直刺大腦……哎，這簡直能把一條漢子哭成淚人兒！",
      "encoded_ascii": "^$%^!^^#k^4I^-I^&`^!w^\"z^2@^*o^*o^3i^*A^(s^3y^&`^'b^$1^!%^%.^4Q^#(^/U^$$^%m^!<^++^*W",
      "encoded_base64": "XiQlXiFeXiNrXjRJXi1JXiZgXiF3XiJ6XjJAXipvXipvXjNpXipBXihzXjN5XiZgXidiXiQxXiElXiUuXjRRXiMoXi9VXiQkXiVtXiE8XisrXipX",
      "byte_length": 84
    },
    {
      "unit_id": "DLG_908890409d51",
      "text": "……阿瑪拉格森巴達姆加爾 大石尖塔 拉格瑪德阿布涅茲埃格……",
      "encoded_ascii": "^*o^*o^)M^-*^$6^%*^4H^#K^(z^#%^\"\"^&/ ^\"z^&k^#=^\"o ^$6^%*^-*^#j^)M^.`^4O^/D^/&^%*^*o^*o",
      "encoded_base64": "XipvXipvXilNXi0qXiQ2XiUqXjRIXiNLXih6XiMlXiIiXiYvIF4iel4ma14jPV4ibyBeJDZeJSpeLSpeI2peKU1eLmBeNE9eL0ReLyZeJSpeKm9eKm8=",
      "byte_length": 86
    },
    {
      "unit_id": "DLG_cbf9fff3a6d6",
      "text": "……加爾努恩卡阿利亞蘇蘇 大石尖塔 納安達……",
      "encoded_ascii": "^*o^*o^\"\"^&/^1$^#v^\"0^)M^!t^!9^4c^4c ^\"z^&k^#=^\"o ^';^+p^(z^*o^*o",
      "encoded_base64": "XipvXipvXiIiXiYvXjEkXiN2XiIwXilNXiF0XiE5XjRjXjRjIF4iel4ma14jPV4ibyBeJzteK3BeKHpeKm9eKm8=",
      "byte_length": 65
    },
    {
      "unit_id": "DLG_2bb8a851bfe5",
      "text": "……安基加阿吉阿吉……",
      "encoded_ascii": "^*o^*o^+p^/'^\"\"^)M^\"D^)M^\"D^*o^*o",
      "encoded_base64": "XipvXipvXitwXi8nXiIiXilNXiJEXilNXiJEXipvXipv",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_c7337ba4e8c0",
      "text": "……尼姆媽媽達姆埃……",
      "encoded_ascii": "^*o^*o^#>^#%^44^44^(z^#%^/&^*o^*o",
      "encoded_base64": "XipvXipvXiM+XiMlXjQ0XjQ0Xih6XiMlXi8mXipvXipv",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_bdb2f3ac416c",
      "text": "……蘇蘇納安達埃涅埃姆瑪……",
      "encoded_ascii": "^*o^*o^4c^4c^';^+p^(z^/&^4O^/&^#%^-*^*o^*o",
      "encoded_base64": "XipvXipvXjRjXjRjXic7XitwXih6Xi8mXjRPXi8mXiMlXi0qXipvXipv",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_7f963baa20bf",
      "text": "……格森巴達姆加爾布魯德努恩……",
      "encoded_ascii": "^*o^*o^%*^4H^#K^(z^#%^\"\"^&/^.`^/K^#j^1$^#v^*o^*o",
      "encoded_base64": "XipvXipvXiUqXjRIXiNLXih6XiMlXiIiXiYvXi5gXi9LXiNqXjEkXiN2XipvXipv",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_4d16f451d610",
      "text": "……吉尼姆媽媽達姆埃……",
      "encoded_ascii": "^*o^*o^\"D^#>^#%^44^44^(z^#%^/&^*o^*o",
      "encoded_base64": "XipvXipvXiJEXiM+XiMlXjQ0XjQ0Xih6XiMlXi8mXipvXipv",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_6df39e9ac6f8",
      "text": "……吉尼姆媽媽達姆埃涅埃姆阿姆安……",
      "encoded_ascii": "^*o^*o^\"D^#>^#%^44^44^(z^#%^/&^4O^/&^#%^)M^#%^+p^*o^*o",
      "encoded_base64": "XipvXipvXiJEXiM+XiMlXjQ0XjQ0Xih6XiMlXi8mXjRPXi8mXiMlXilNXiMlXitwXipvXipv",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_0ab3546a52a1",
      "text": "……埃涅埃姆瑪尼阿吉格魯德阿吉尼姆……",
      "encoded_ascii": "^*o^*o^/&^4O^/&^#%^-*^#>^)M^\"D^%*^/K^#j^)M^\"D^#>^#%^*o^*o",
      "encoded_base64": "XipvXipvXi8mXjRPXi8mXiMlXi0qXiM+XilNXiJEXiUqXi9LXiNqXilNXiJEXiM+XiMlXipvXipv",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_9c9375631cae",
      "text": "……姆媽媽達姆埃涅埃姆阿姆安……",
      "encoded_ascii": "^*o^*o^#%^44^44^(z^#%^/&^4O^/&^#%^)M^#%^+p^*o^*o",
      "encoded_base64": "XipvXipvXiMlXjQ0XjQ0Xih6XiMlXi8mXjRPXi8mXiMlXilNXiMlXitwXipvXipv",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_60825fdc2e4b",
      "text": "唯有君王才會企盼這樣的夢境！真是徹底的救贖！ ",
      "encoded_ascii": "^+O^$s^+@^-)^$,^$r^4-^23^(s^,f^&Z^\"y^\"q^*W^-2^,X^18^/^^&Z^,Q^3-^*W ",
      "encoded_base64": "XitPXiRzXitAXi0pXiQsXiRyXjQtXjIzXihzXixmXiZaXiJ5XiJxXipXXi0yXixYXjE4Xi9eXiZaXixRXjMtXipXIA==",
      "byte_length": 67
    },
    {
      "unit_id": "DLG_a200d7cd4448",
      "text": "我們快到了！",
      "encoded_ascii": "^$%^*{^*L^!u^*D^*W",
      "encoded_base64": "XiQlXip7XipMXiF1XipEXipX",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_be2b5ee6a261",
      "text": "  別擋我的路！",
      "encoded_ascii": "  ^*H^$G^$%^&Z^(a^*W",
      "encoded_base64": "ICBeKkheJEdeJCVeJlpeKGFeKlc=",
      "byte_length": 20
    },
    {
      "unit_id": "DLG_f6a53b5459fe",
      "text": "有入侵者！",
      "encoded_ascii": "^$s^!f^.X^'V^*W",
      "encoded_base64": "XiRzXiFmXi5YXidWXipX",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_88269d0acecc",
      "text": "你們還有其他想要的事物嗎？",
      "encoded_ascii": "^*F^*{^.7^$s^!j^!@^,1^(C^&Z^*r^&4^+X^.V",
      "encoded_base64": "XipGXip7Xi43XiRzXiFqXiFAXiwxXihDXiZaXipyXiY0XitYXi5W",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_638520726a2a",
      "text": "  我們動身吧。",
      "encoded_ascii": "  ^$%^*{^\"%^(c^*I^!\"",
      "encoded_base64": "ICBeJCVeKnteIiVeKGNeKkleISI=",
      "byte_length": 20
    },
    {
      "unit_id": "DLG_80148baa9b12",
      "text": "夠了，我要離開了。我要去多找一些",
      "encoded_ascii": "^+d^*D^*A^$%^(C^)`^)F^*D^!\"^$%^(C^\"6^\"x^$/^!%^!8",
      "encoded_base64": "XitkXipEXipBXiQlXihDXilgXilGXipEXiEiXiQlXihDXiI2XiJ4XiQvXiElXiE4",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_b36e5ae70e70",
      "text": "聯盟的成員。",
      "encoded_ascii": "^-V^-0^&Z^$$^+G^!\"",
      "encoded_base64": "Xi1WXi0wXiZaXiQkXitHXiEi",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_59fb07d493ff",
      "text": "群眾朝你們丟下錢幣。",
      "encoded_ascii": "^'R^&e^,^^*F^*{^*q^!(^.<^+|^!\"",
      "encoded_base64": "XidSXiZlXixeXipGXip7XipxXiEoXi48Xit8XiEi",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_f0bc0a3809cf",
      "text": "德拉吉的市民們！",
      "encoded_ascii": "^#j^$6^\"D^&Z^+z^%T^*{^*W",
      "encoded_base64": "XiNqXiQ2XiJEXiZaXit6XiVUXip7XipX",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_5565dfffd3f4",
      "text": "各位眼前是一小群角鬥士。請觀賞他們",
      "encoded_ascii": "^+>^!J^&d^!z^,X^!%^#;^'R^(H^*,^+a^!\"^*S^*R^*T^!@^*{",
      "encoded_base64": "Xis+XiFKXiZkXiF6XixYXiElXiM7XidSXihIXiosXithXiEiXipTXipSXipUXiFAXip7",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_495b1eef3a78",
      "text": "與我們土地上的猛獸搏鬥至死。",
      "encoded_ascii": "^'p^$%^*{^\"c^\"e^!'^&Z^*P^&<^,K^*,^'n^%L^!\"",
      "encoded_base64": "XidwXiQlXip7XiJjXiJlXiEnXiZaXipQXiY8XixLXiosXiduXiVMXiEi",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_9d7f108374f8",
      "text": "看哪，這是你們的國王特克圖克特雷、德拉吉的無情守護者所賜的禮物——",
      "encoded_ascii": "^*Q^+I^*A^(s^,X^*F^*{^&Z^+^^-)^&5^!d^\"b^!d^&5^)c^!!^#j^$6^\"D^&Z^%}^,0^#+^(T^'V^$)^.#^&Z^-8^&4^*n^*n",
      "encoded_base64": "XipRXitJXipBXihzXixYXipGXip7XiZaXiteXi0pXiY1XiFkXiJiXiFkXiY1XiljXiEhXiNqXiQ2XiJEXiZaXiV9XiwwXiMrXihUXidWXiQpXi4jXiZaXi04XiY0XipuXipu",
      "byte_length": 99
    },
    {
      "unit_id": "DLG_56cece3361ae",
      "text": "戰鬥與死亡的禮物！",
      "encoded_ascii": "^$(^*,^'p^%L^!:^&Z^-8^&4^*W",
      "encoded_base64": "XiQoXiosXidwXiVMXiE6XiZaXi04XiY0XipX",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_43a8a5387e91",
      "text": "馴獸師：放出你的獸群！",
      "encoded_ascii": "^.N^&<^#M^*B^$P^!q^*F^&Z^&<^'R^*W",
      "encoded_base64": "Xi5OXiY8XiNNXipCXiRQXiFxXipGXiZaXiY8XidSXipX",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_6170496966c8",
      "text": "請看這些角鬥士如何與那些",
      "encoded_ascii": "^*S^*Q^(s^!8^(H^*,^+a^#$^!L^'p^)!^!8",
      "encoded_base64": "XipTXipRXihzXiE4XihIXiosXithXiMkXiFMXidwXikhXiE4",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_f797f995bc00",
      "text": "存在於城牆之外的恐怖野獸近身搏鬥。感謝你們的國王特克圖克特雷",
      "encoded_ascii": "^#*^\"d^$^^+_^&0^!/^\"w^&Z^#t^#p^.:^&<^(l^(c^,K^*,^!\"^#{^-z^*F^*{^&Z^+^^-)^&5^!d^\"b^!d^&5^)c",
      "encoded_base64": "XiMqXiJkXiReXitfXiYwXiEvXiJ3XiZaXiN0XiNwXi46XiY8XihsXihjXixLXiosXiEiXiN7Xi16XipGXip7XiZaXiteXi0pXiY1XiFkXiJiXiFkXiY1Xilj",
      "byte_length": 90
    },
    {
      "unit_id": "DLG_973d86180361",
      "text": "賜予的保護。",
      "encoded_ascii": "^.#^!4^&Z^!T^(T^!\"",
      "encoded_base64": "Xi4jXiE0XiZaXiFUXihUXiEi",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_e713f2d026b0",
      "text": "向我們的君主致敬，偉大的特克圖克特雷——他那庇護的羽翼",
      "encoded_ascii": "^+?^$%^*{^&Z^+@^!-^'o^*O^*A^*}^\"z^&Z^&5^!d^\"b^!d^&5^)c^*n^*n^!@^)!^,\"^(T^&Z^'S^'T",
      "encoded_base64": "Xis/XiQlXip7XiZaXitAXiEtXidvXipPXipBXip9XiJ6XiZaXiY1XiFkXiJiXiFkXiY1XiljXipuXipuXiFAXikhXiwiXihUXiZaXidTXidU",
      "byte_length": 81
    },
    {
      "unit_id": "DLG_296e162943d9",
      "text": "將我們全都籠罩在他惡毒的榮光之下！",
      "encoded_ascii": "^#7^$%^*{^!h^)$^'3^'P^\"d^!@^#y^%Q^&Z^,e^!c^!/^!(^*W",
      "encoded_base64": "XiM3XiQlXip7XiFoXikkXiczXidQXiJkXiFAXiN5XiVRXiZaXixlXiFjXiEvXiEoXipX",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_12df0a9ea0a6",
      "text": "這些奴隸已經證明了他們的價值。看來競技場買得很值得。",
      "encoded_ascii": "^(s^!8^##^)Z^#J^'D^-{^$c^*D^!@^*{^&Z^+&^!Z^!\"^*Q^!O^-?^,>^\"n^.!^#e^*K^!Z^#e^!\"",
      "encoded_base64": "XihzXiE4XiMjXilaXiNKXidEXi17XiRjXipEXiFAXip7XiZaXismXiFaXiEiXipRXiFPXi0/Xiw+XiJuXi4hXiNlXipLXiFaXiNlXiEi",
      "byte_length": 78
    },
    {
      "unit_id": "DLG_3f08254049e8",
      "text": "在這一天，特克圖克特雷國王再次向德拉吉",
      "encoded_ascii": "^\"d^(s^!%^+e^*A^&5^!d^\"b^!d^&5^)c^+^^-)^!l^%D^+?^#j^$6^\"D",
      "encoded_base64": "XiJkXihzXiElXitlXipBXiY1XiFkXiJiXiFkXiY1XiljXiteXi0pXiFsXiVEXis/XiNqXiQ2XiJE",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_fec0336dfb76",
      "text": "獻上他戰鬥與死亡的禮物。",
      "encoded_ascii": "^-(^!'^!@^$(^*,^'p^%L^!:^&Z^-8^&4^!\"",
      "encoded_base64": "Xi0oXiEnXiFAXiQoXiosXidwXiVMXiE6XiZaXi04XiY0XiEi",
      "byte_length": 36
    },
    {
      "unit_id": "DLG_adab4712496e",
      "text": "向特克圖克特雷與德拉吉的勝利大軍致敬！",
      "encoded_ascii": "^+?^&5^!d^\"b^!d^&5^)c^'p^#j^$6^\"D^&Z^+5^!t^\"z^..^'o^*O^*W",
      "encoded_base64": "Xis/XiY1XiFkXiJiXiFkXiY1XiljXidwXiNqXiQ2XiJEXiZaXis1XiF0XiJ6Xi4uXidvXipPXipX",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_b15e59008963",
      "text": "這些角鬥士強壯又熟練，但尚未受過真正的考驗。",
      "encoded_ascii": "^(s^!8^(H^*,^+a^#]^+b^+;^-\"^-L^*A^!I^+v^,_^\";^(x^-2^%H^&Z^-R^.P^!\"",
      "encoded_base64": "XihzXiE4XihIXiosXithXiNdXitiXis7Xi0iXi1MXipBXiFJXit2XixfXiI7Xih4Xi0yXiVIXiZaXi1SXi5QXiEi",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_998de4e3b35f",
      "text": "今天我們將挑戰他們，讓他們證明自己足以對抗",
      "encoded_ascii": "^*E^+e^$%^*{^#7^,H^$(^!@^*{^*A^-}^!@^*{^-{^$c^'l^#I^(^^!B^#:^$4",
      "encoded_base64": "XipFXitlXiQlXip7XiM3XixIXiQoXiFAXip7XipBXi19XiFAXip7Xi17XiRjXidsXiNJXiheXiFCXiM6XiQ0",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_cd91d85838f9",
      "text": "我們馴獸師手上最厲害的猛獸。",
      "encoded_ascii": "^$%^*{^.N^&<^#M^$+^!'^$q^+:^#/^&Z^*P^&<^!\"",
      "encoded_base64": "XiQlXip7Xi5OXiY8XiNNXiQrXiEnXiRxXis6XiMvXiZaXipQXiY8XiEi",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_3fa68a80173d",
      "text": "遊戲開始！",
      "encoded_ascii": "^.3^,;^)F^+k^*W",
      "encoded_base64": "Xi4zXiw7XilGXitrXipX",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_0b9f6ccd4e7c",
      "text": "再一次，滿懷期待的觀眾們，你們將見到訓練有素的戰士",
      "encoded_ascii": "^!l^!%^%D^*A^,{^,9^$u^,*^&Z^*R^&e^*{^*A^*F^*{^#7^-m^!u^-p^-L^$s^'=^&Z^$(^+a",
      "encoded_base64": "XiFsXiElXiVEXipBXix7Xiw5XiR1XiwqXiZaXipSXiZlXip7XipBXipGXip7XiM3Xi1tXiF1Xi1wXi1MXiRzXic9XiZaXiQoXith",
      "byte_length": 75
    },
    {
      "unit_id": "DLG_f54c0d69c5fe",
      "text": "對抗棲息在城牆之外的成群猛獸。",
      "encoded_ascii": "^#:^$4^,b^#w^\"d^+_^&0^!/^\"w^&Z^$$^'R^*P^&<^!\"",
      "encoded_base64": "XiM6XiQ0XixiXiN3XiJkXitfXiYwXiEvXiJ3XiZaXiQkXidSXipQXiY8XiEi",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_e770d066ac75",
      "text": "今天有個驚喜！「獸欄之王」斯卡，已經",
      "encoded_ascii": "^*E^+e^$s^!V^.Q^+V^*W^!#^&<^%C^!/^-)^!$^$[^\"0^*A^#J^'D",
      "encoded_base64": "XipFXitlXiRzXiFWXi5RXitWXipXXiEjXiY8XiVDXiEvXi0pXiEkXiRbXiIwXipBXiNKXidE",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_f1c5cd8269b4",
      "text": "對這些渣滓的苟延殘喘感到厭惡，於是他",
      "encoded_ascii": "^#:^(s^!8^,v^,y^&Z^-^^,&^,l^+U^#{^!u^+9^#y^*A^$^^,X^!@",
      "encoded_base64": "XiM6XihzXiE4Xix2Xix5XiZaXi1eXiwmXixsXitVXiN7XiF1Xis5XiN5XipBXiReXixYXiFA",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_5ed80a81df46",
      "text": "自願親手殺了他們，好為真正的角鬥士騰出獸欄的空間。",
      "encoded_ascii": "^'l^.H^(F^$+^%M^*D^!@^*{^*A^+i^%{^-2^%H^&Z^(H^*,^+a^.O^!q^&<^%C^&Z^'(^)G^!\"",
      "encoded_base64": "XidsXi5IXihGXiQrXiVNXipEXiFAXip7XipBXitpXiV7Xi0yXiVIXiZaXihIXiosXithXi5PXiFxXiY8XiVDXiZaXicoXilHXiEi",
      "byte_length": 75
    },
    {
      "unit_id": "DLG_080f5502866e",
      "text": "今天是特別的日子。讓我們為",
      "encoded_ascii": "^*E^+e^,X^&5^*H^&Z^$a^#(^!\"^-}^$%^*{^%{",
      "encoded_base64": "XipFXitlXixYXiY1XipIXiZaXiRhXiMoXiEiXi19XiQlXip7XiV7",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_a344dddd8b77",
      "text": "角鬥士們的第一千場戰鬥鼓掌。",
      "encoded_ascii": "^(H^*,^+a^*{^&Z^',^!%^+7^\"n^$(^*,^*<^$;^!\"",
      "encoded_base64": "XihIXiosXithXip7XiZaXicsXiElXis3XiJuXiQoXiosXio8XiQ7XiEi",
      "byte_length": 42
    },
    {
      "unit_id": "DLG_c32295989fd7",
      "text": "特克圖克特雷國王親自為這些勇者們送來了禮物。",
      "encoded_ascii": "^&5^!d^\"b^!d^&5^)c^+^^-)^(F^'l^%{^(s^!8^\"$^'V^*{^./^!O^*D^-8^&4^!\"",
      "encoded_base64": "XiY1XiFkXiJiXiFkXiY1XiljXiteXi0pXihGXidsXiV7XihzXiE4XiIkXidWXip7Xi4vXiFPXipEXi04XiY0XiEi",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_a6e553504a1f",
      "text": "你們贏了！透過在競技場中奮戰，你們已經讓",
      "encoded_ascii": "^*F^*{^.%^*D^*W^(q^(x^\"d^-?^,>^\"n^!,^+g^$(^*A^*F^*{^#J^'D^-}",
      "encoded_base64": "XipGXip7Xi4lXipEXipXXihxXih4XiJkXi0/Xiw+XiJuXiEsXitnXiQoXipBXipGXip7XiNKXidEXi19",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_0caa349441f0",
      "text": "整個亞薩斯的怪物絕跡。",
      "encoded_ascii": "^$T^!V^!9^-e^$[^&Z^#s^&4^-I^(`^!\"",
      "encoded_base64": "XiRUXiFWXiE5Xi1lXiRbXiZaXiNzXiY0Xi1JXihgXiEi",
      "byte_length": 33
    },
    {
      "unit_id": "DLG_a339f640890e",
      "text": "對抗棲息在城牆之外的成群猛獸。",
      "encoded_ascii": "^#:^$4^,b^#w^\"d^+_^&0^!/^\"w^&Z^$$^'R^*P^&<^!\"",
      "encoded_base64": "XiM6XiQ0XixiXiN3XiJkXitfXiYwXiEvXiJ3XiZaXiQkXidSXipQXiY8XiEi",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_818becb913ca",
      "text": "群眾打起了呵欠。只有少數人還醒著鼓掌。",
      "encoded_ascii": "^'R^&e^$-^.(^*D^+D^,g^!\"^\"?^$s^#<^$V^!<^.7^.9^-a^*<^$;^!\"",
      "encoded_base64": "XidSXiZlXiQtXi4oXipEXitEXixnXiEiXiI/XiRzXiM8XiRWXiE8Xi43Xi45Xi1hXio8XiQ7XiEi",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_d81521bee378",
      "text": "喔！抱歉耽擱了，我只是在閉目養神……",
      "encoded_ascii": "^+T^*W^,@^,h^-T^,O^*D^*A^$%^\"?^,X^\"d^.=^&^^.I^&w^*o^*o",
      "encoded_base64": "XitUXipXXixAXixoXi1UXixPXipEXipBXiQlXiI/XixYXiJkXi49XiZeXi5JXiZ3XipvXipv",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_1cc4b0e0ebea",
      "text": "我不建議你們把「等怪物自然老死」",
      "encoded_ascii": "^$%^!)^,'^-|^*F^*{^$1^!#^'-^#s^&4^'l^&\"^'U^%L^!$",
      "encoded_base64": "XiQlXiEpXiwnXi18XipGXip7XiQxXiEjXictXiNzXiY0XidsXiYiXidVXiVMXiEk",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_35a94e25c7ef",
      "text": "當成什麼有趣的戰術。",
      "encoded_ascii": "^&N^$$^!=^.T^$s^.*^&Z^$(^(<^!\"",
      "encoded_base64": "XiZOXiQkXiE9Xi5UXiRzXi4qXiZaXiQoXig8XiEi",
      "byte_length": 30
    },
    {
      "unit_id": "DLG_eec457ac8c5e",
      "text": "野獸大師：去看看那些怪物是死了還是只是在睡覺。",
      "encoded_ascii": "^.:^&<^\"z^#M^*B^\"6^*Q^*Q^)!^!8^#s^&4^,X^%L^*D^.7^,X^\"?^,X^\"d^-3^(G^!\"",
      "encoded_base64": "Xi46XiY8XiJ6XiNNXipCXiI2XipRXipRXikhXiE4XiNzXiY0XixYXiVMXipEXi43XixYXiI/XixYXiJkXi0zXihHXiEi",
      "byte_length": 69
    },
    {
      "unit_id": "DLG_e3b833c81e08",
      "text": "太輕鬆了。也許這些怪物該更有挑戰性一點！",
      "encoded_ascii": "^+f^(g^.R^*D^!\"^!1^-s^(s^!8^#s^&4^(M^$o^$s^,H^$(^#r^!%^*;^*W",
      "encoded_base64": "XitmXihnXi5SXipEXiEiXiExXi1zXihzXiE4XiNzXiY0XihNXiRvXiRzXixIXiQoXiNyXiElXio7XipX",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_91db58d15660",
      "text": "請注意，角鬥士們：回到獸欄去療傷。",
      "encoded_ascii": "^*S^%e^#z^*A^(H^*,^+a^*{^*B^\"\\^!u^&<^%C^\"6^&U^!^^!\"",
      "encoded_base64": "XipTXiVlXiN6XipBXihIXiosXithXip7XipCXiJcXiF1XiY8XiVDXiI2XiZVXiFeXiEi",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_11e794f32dd5",
      "text": "德拉吉的市民們已經對延遲感到不耐煩了。",
      "encoded_ascii": "^#j^$6^\"D^&Z^+z^%T^*{^#J^'D^#:^,&^.5^#{^!u^!)^-S^-!^*D^!\"",
      "encoded_base64": "XiNqXiQ2XiJEXiZaXit6XiVUXip7XiNKXidEXiM6XiwmXi41XiN7XiF1XiEpXi1TXi0hXipEXiEi",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_1d263aabdd4f",
      "text": "德拉吉的市民們，",
      "encoded_ascii": "^#j^$6^\"D^&Z^+z^%T^*{^*A",
      "encoded_base64": "XiNqXiQ2XiJEXiZaXit6XiVUXip7XipB",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_17b1b939fc2c",
      "text": "這些可悲、悽慘、丟人現眼的角鬥士並不是我們唯一的",
      "encoded_ascii": "^(s^!8^\"A^,.^!!^,/^,4^!!^*q^!<^&?^&d^&Z^(H^*,^+a^!+^!)^,X^$%^*{^+O^!%^&Z",
      "encoded_base64": "XihzXiE4XiJBXiwuXiEhXiwvXiw0XiEhXipxXiE8XiY/XiZkXiZaXihIXiosXithXiErXiEpXixYXiQlXip7XitPXiElXiZa",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_11ed77258525",
      "text": "娛樂——別擔心！真正的戰士今天稍後就會上場。",
      "encoded_ascii": "^+l^%8^*n^*n^*H^*N^#k^*W^-2^%H^&Z^$(^+a^*E^+e^-:^#b^*J^$r^!'^\"n^!\"",
      "encoded_base64": "XitsXiU4XipuXipuXipIXipOXiNrXipXXi0yXiVIXiZaXiQoXithXipFXitlXi06XiNiXipKXiRyXiEnXiJuXiEi",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_4bc33bf18650",
      "text": "看來今天運氣站在角鬥士這一邊。",
      "encoded_ascii": "^*Q^!O^*E^+e^.4^%U^->^\"d^(H^*,^+a^(s^!%^.8^!\"",
      "encoded_base64": "XipRXiFPXipFXitlXi40XiVVXi0+XiJkXihIXiosXithXihzXiElXi44XiEi",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_96cd47c0e8ae",
      "text": "這些角鬥士似乎還有點鬥志！就連被逼到絕境的老鼠",
      "encoded_ascii": "^(s^!8^(H^*,^+a^!H^!0^.7^$s^*;^*,^#m^*W^*J^.0^(@^.1^!u^-I^\"q^&Z^'U^*=",
      "encoded_base64": "XihzXiE4XihIXiosXithXiFIXiEwXi43XiRzXio7XiosXiNtXipXXipKXi4wXihAXi4xXiF1Xi1JXiJxXiZaXidVXio9",
      "byte_length": 69
    },
    {
      "unit_id": "DLG_57c14e23605b",
      "text": "也會反咬一口。",
      "encoded_ascii": "^!1^$r^\"9^\"Q^!%^\"<^!\"",
      "encoded_base64": "XiExXiRyXiI5XiJRXiElXiI8XiEi",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_19f5c3a1d8bc",
      "text": "趁現在好好享受勝利吧！你們遲早會遇上真正的對手！",
      "encoded_ascii": "^.)^&?^\"d^+i^+i^!;^\";^+5^!t^*I^*W^*F^*{^.5^,V^$r^.2^!'^-2^%H^&Z^#:^$+^*W",
      "encoded_base64": "Xi4pXiY/XiJkXitpXitpXiE7XiI7Xis1XiF0XipJXipXXipGXip7Xi41XixWXiRyXi4yXiEnXi0yXiVIXiZaXiM6XiQrXipX",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_63ddf2bfd380",
      "text": "想看屍體就儘管看吧，反正也幫不了你。你還是會死。",
      "encoded_ascii": "^,1^*Q^#?^**^*J^+(^-D^*Q^*I^*A^\"9^%H^!1^+}^!)^*D^*F^!\"^*F^.7^,X^$r^%L^!\"",
      "encoded_base64": "XiwxXipRXiM/XioqXipKXisoXi1EXipRXipJXipBXiI5XiVIXiExXit9XiEpXipEXipGXiEiXipGXi43XixYXiRyXiVMXiEi",
      "byte_length": 72
    },
    {
      "unit_id": "DLG_7fd503e3614c",
      "text": "要回嘴嗆司儀嗎？",
      "encoded_ascii": "^(C^\"\\^+[^+W^+=^+'^+X^.V",
      "encoded_base64": "XihDXiJcXitbXitXXis9XisnXitYXi5W",
      "byte_length": 24
    },
    {
      "unit_id": "DLG_396655d737a5",
      "text": "你有話要說嗎？",
      "encoded_ascii": "^*F^$s^-v^(C^-x^+X^.V",
      "encoded_base64": "XipGXiRzXi12XihDXi14XitYXi5W",
      "byte_length": 21
    },
    {
      "unit_id": "DLG_a85304bf83ae",
      "text": "  被逼到絕境的老鼠？儘管放出你最強的傢伙！",
      "encoded_ascii": "  ^(@^.1^!u^-I^\"q^&Z^'U^*=^.V^+(^-D^$P^!q^*F^$q^#]^&Z^+#^*y^*W",
      "encoded_base64": "ICBeKEBeLjFeIXVeLUleInFeJlpeJ1VeKj1eLlZeKyheLUReJFBeIXFeKkZeJHFeI11eJlpeKyNeKnleKlc=",
      "byte_length": 62
    },
    {
      "unit_id": "DLG_72e61360b5c7",
      "text": "  再叫我一次老鼠，你會付出代價的！",
      "encoded_ascii": "  ^!l^+<^$%^!%^%D^'U^*=^*A^*F^$r^*u^!q^*v^+&^&Z^*W",
      "encoded_base64": "ICBeIWxeKzxeJCVeISVeJUReJ1VeKj1eKkFeKkZeJHJeKnVeIXFeKnZeKyZeJlpeKlc=",
      "byte_length": 50
    },
    {
      "unit_id": "DLG_43faa81bc1a0",
      "text": "  那才不是運氣！",
      "encoded_ascii": "  ^)!^$,^!)^,X^.4^%U^*W",
      "encoded_base64": "ICBeKSFeJCxeISleLFheLjReJVVeKlc=",
      "byte_length": 23
    },
    {
      "unit_id": "DLG_938122d89faa",
      "text": "  算你走運，我留你一命！",
      "encoded_ascii": "  ^-C^*F^.&^.4^*A^$%^-+^*F^!%^\"N^*W",
      "encoded_base64": "ICBeLUNeKkZeLiZeLjReKkFeJCVeLSteKkZeISVeIk5eKlc=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_7760ae41c419",
      "text": "  可悲？儘管放馬過來吧！",
      "encoded_ascii": "  ^\"A^,.^.V^+(^-D^$P^*\"^(x^!O^*I^*W",
      "encoded_base64": "ICBeIkFeLC5eLlZeKyheLUReJFBeKiJeKHheIU9eKkleKlc=",
      "byte_length": 35
    },
    {
      "unit_id": "DLG_07bfe6c2b168",
      "text": "  我是真正的戰士，我會證明給你看！",
      "encoded_ascii": "  ^$%^,X^-2^%H^&Z^$(^+a^*A^$%^$r^-{^$c^'A^*F^*Q^*W",
      "encoded_base64": "ICBeJCVeLFheLTJeJUheJlpeJCheK2FeKkFeJCVeJHJeLXteJGNeJ0FeKkZeKlFeKlc=",
      "byte_length": 50
    },
    {
      "unit_id": "DLG_081ea6eeafd6",
      "text": "  你就只有這點本事嗎？",
      "encoded_ascii": "  ^*F^*J^\"?^$s^(s^*;^$x^*r^+X^.V",
      "encoded_base64": "ICBeKkZeKkpeIj9eJHNeKHNeKjteJHheKnJeK1heLlY=",
      "byte_length": 32
    },
    {
      "unit_id": "DLG_7eee6afb2abe",
      "text": "  我要再戰一場！現在就要！",
      "encoded_ascii": "  ^$%^(C^!l^$(^!%^\"n^*W^&?^\"d^*J^(C^*W",
      "encoded_base64": "ICBeJCVeKENeIWxeJCheISVeIm5eKldeJj9eImReKkpeKENeKlc=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_66c701915a3c",
      "text": "  你是我見過最厲害的司儀。",
      "encoded_ascii": "  ^*F^,X^$%^-m^(x^$q^+:^#/^&Z^+=^+'^!\"",
      "encoded_base64": "ICBeKkZeLFheJCVeLW1eKHheJHFeKzpeIy9eJlpeKz1eKydeISI=",
      "byte_length": 38
    },
    {
      "unit_id": "DLG_23e0cea44cd0",
      "text": "好了，謝了！",
      "encoded_ascii": "^+i^*D^*A^-z^*D^*W",
      "encoded_base64": "XitpXipEXipBXi16XipEXipX",
      "byte_length": 18
    },
    {
      "unit_id": "DLG_7ecb33376d10",
      "text": "什麼？！你們這些狂妄之徒！接招吧！",
      "encoded_ascii": "^!=^.T^.V^*W^*F^*{^(s^!8^&8^+j^!/^#d^*W^$?^,D^*I^*W",
      "encoded_base64": "XiE9Xi5UXi5WXipXXipGXip7XihzXiE4XiY4XitqXiEvXiNkXipXXiQ/XixEXipJXipX",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_5654d17b0a4d",
      "text": "馴獸師：放出怪物！",
      "encoded_ascii": "^.N^&<^#M^*B^$P^!q^#s^&4^*W",
      "encoded_base64": "Xi5OXiY8XiNNXipCXiRQXiFxXiNzXiY0XipX",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_3e057b5a81ce",
      "text": "哦！這麼渴望殺戮嗎？特克圖克特雷會很滿意的。",
      "encoded_ascii": "^+H^*W^(s^.T^,w^,]^%M^,:^+X^.V^&5^!d^\"b^!d^&5^)c^$r^*K^,{^#z^&Z^!\"",
      "encoded_base64": "XitIXipXXihzXi5UXix3XixdXiVNXiw6XitYXi5WXiY1XiFkXiJiXiFkXiY1XiljXiRyXipLXix7XiN6XiZaXiEi",
      "byte_length": 66
    },
    {
      "unit_id": "DLG_0a35165ab5c6",
      "text": "馴獸師：再給我們的英雄們來一場戰鬥！",
      "encoded_ascii": "^.N^&<^#M^*B^!l^'A^$%^*{^&Z^'y^)\\^*{^!O^!%^\"n^$(^*,^*W",
      "encoded_base64": "Xi5OXiY8XiNNXipCXiFsXidBXiQlXip7XiZaXid5XilcXip7XiFPXiElXiJuXiQoXiosXipX",
      "byte_length": 54
    },
    {
      "unit_id": "DLG_59182e5547d7",
      "text": "群眾為你驚人的戰鬥能力所折服。他們開始",
      "encoded_ascii": "^'R^&e^%{^*F^.Q^!<^&Z^$(^*,^'b^!~^$)^,?^,\\^!\"^!@^*{^)F^+k",
      "encoded_base64": "XidSXiZlXiV7XipGXi5RXiE8XiZaXiQoXiosXidiXiF+XiQpXiw/XixcXiEiXiFAXip7XilGXitr",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_22b7a14a7143",
      "text": "高呼你的名字，並將錢幣拋向競技場的地面。",
      "encoded_ascii": "^*+^\"M^*F^&Z^\"F^#)^*A^!+^#7^.<^+|^,A^+?^-?^,>^\"n^&Z^\"e^)j^!\"",
      "encoded_base64": "XiorXiJNXipGXiZaXiJGXiMpXipBXiErXiM3Xi48Xit8XixBXis/Xi0/Xiw+XiJuXiZaXiJlXilqXiEi",
      "byte_length": 60
    },
    {
      "unit_id": "DLG_d4ce2f0998df",
      "text": "如果你不想回獸欄，那你一定是還想再打一場！",
      "encoded_ascii": "^#$^%!^*F^!)^,1^\"\\^&<^%C^*A^)!^*F^!%^#.^,X^.7^,1^!l^$-^!%^\"n^*W",
      "encoded_base64": "XiMkXiUhXipGXiEpXiwxXiJcXiY8XiVDXipBXikhXipGXiElXiMuXixYXi43XiwxXiFsXiQtXiElXiJuXipX",
      "byte_length": 63
    },
    {
      "unit_id": "DLG_9d653026e882",
      "text": "德拉吉市民的耐性可不是無窮無盡的。",
      "encoded_ascii": "^#j^$6^\"D^+z^%T^&Z^-S^#r^\"A^!)^,X^%}^-=^%}^-1^&Z^!\"",
      "encoded_base64": "XiNqXiQ2XiJEXit6XiVUXiZaXi1TXiNyXiJBXiEpXixYXiV9Xi09XiV9Xi0xXiZaXiEi",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_dd4dea24b24c",
      "text": "既然你不願離開，那你就必須戰鬥！",
      "encoded_ascii": "^,U^&\"^*F^!)^.H^)`^)F^*A^)!^*F^*J^#l^)r^$(^*,^*W",
      "encoded_base64": "XixVXiYiXipGXiEpXi5IXilgXilGXipBXikhXipGXipKXiNsXilyXiQoXiosXipX",
      "byte_length": 48
    },
    {
      "unit_id": "DLG_4f632fddb45c",
      "text": "太好了！這些角鬥士還想再戰！我們就",
      "encoded_ascii": "^+f^+i^*D^*W^(s^!8^(H^*,^+a^.7^,1^!l^$(^*W^$%^*{^*J",
      "encoded_base64": "XitmXitpXipEXipXXihzXiE4XihIXiosXithXi43XiwxXiFsXiQoXipXXiQlXip7XipK",
      "byte_length": 51
    },
    {
      "unit_id": "DLG_173ac97e255f",
      "text": "看看他們的表現吧！",
      "encoded_ascii": "^*Q^*Q^!@^*{^&Z^-i^&?^*I^*W",
      "encoded_base64": "XipRXipRXiFAXip7XiZaXi1pXiY/XipJXipX",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_f6c2fbaa84a9",
      "text": "今日法師賽爾戈將迎戰一頭兇猛的狂暴獸。",
      "encoded_ascii": "^*E^$a^%b^#M^*U^&/^*M^#7^(k^$(^!%^)t^*G^*P^&Z^&8^$m^&<^!\"",
      "encoded_base64": "XipFXiRhXiViXiNNXipVXiYvXipNXiM3XihrXiQoXiElXil0XipHXipQXiZaXiY4XiRtXiY8XiEi",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_13ab12eaff4a",
      "text": "敬請觀賞！",
      "encoded_ascii": "^*O^*S^*R^*T^*W",
      "encoded_base64": "XipPXipTXipSXipUXipX",
      "byte_length": 15
    },
    {
      "unit_id": "DLG_6294a22b2cbb",
      "text": "別擔心，",
      "encoded_ascii": "^*H^*N^#k^*A",
      "encoded_base64": "XipIXipOXiNrXipB",
      "byte_length": 12
    },
    {
      "unit_id": "DLG_67aa8858af43",
      "text": "。很快就輪到你了。退後觀看這場戰鬥吧。",
      "encoded_ascii": "^!\"^*K^*L^*J^(h^!u^*F^*D^!\"^*V^#b^*R^*Q^(s^\"n^$(^*,^*I^!\"",
      "encoded_base64": "XiEiXipLXipMXipKXihoXiF1XipGXipEXiEiXipWXiNiXipSXipRXihzXiJuXiQoXiosXipJXiEi",
      "byte_length": 57
    },
    {
      "unit_id": "DLG_a1a7c5952b7b",
      "text": "角鬥士們：向前踏入競技場！",
      "encoded_ascii": "^(H^*,^+a^*{^*B^+?^!z^.,^!f^-?^,>^\"n^*W",
      "encoded_base64": "XihIXiosXithXip7XipCXis/XiF6Xi4sXiFmXi0/Xiw+XiJuXipX",
      "byte_length": 39
    },
    {
      "unit_id": "DLG_b3fd490edea4",
      "text": "周圍的空氣中劈啪作響地爆發著魔法電芒， ",
      "encoded_ascii": "^\"L^\"`^&Z^'(^%U^!,^4t^4u^!M^)o^\"e^&*^&W^-a^*0^%b^)d^'u^*A ",
      "encoded_base64": "XiJMXiJgXiZaXicoXiVVXiEsXjR0XjR1XiFNXilvXiJlXiYqXiZXXi1hXiowXiViXilkXid1XipBIA==",
      "byte_length": 58
    },
    {
      "unit_id": "DLG_335e4dd94e3a",
      "text": "一頭巨龍那毋庸置疑的磅礴威壓正赫然逼近。他建立起 ",
      "encoded_ascii": "^!%^)t^#H^*>^)!^4~^4x^'Q^0p^&Z^5!^5\"^#&^4v^%H^5$^&\"^.1^(l^!\"^!@^,'^0'^.( ",
      "encoded_base64": "XiElXil0XiNIXio+XikhXjR+XjR4XidRXjBwXiZaXjUhXjUiXiMmXjR2XiVIXjUkXiYiXi4xXihsXiEiXiFAXiwnXjAnXi4oIA==",
      "byte_length": 73
    },
    {
      "unit_id": "DLG_05a21257379f",
      "text": "心靈感應連結，並向你發出質問。",
      "encoded_ascii": "^#k^)g^#{^0`^.0^'@^*A^!+^+?^*F^&W^!q^(Z^*Z^!\"",
      "encoded_base64": "XiNrXilnXiN7XjBgXi4wXidAXipBXiErXis/XipGXiZXXiFxXihaXipaXiEi",
      "byte_length": 45
    },
    {
      "unit_id": "DLG_41aecfa688bb",
      "text": "除非回答我的問題，否則你休想再往前踏出半步……",
      "encoded_ascii": "^)Q^)i^\"\\^-B^$%^&Z^*Z^.G^*A^\"H^!x^*F^!G^,1^!l^,)^!z^.,^!q^\"-^,i^*o^*o",
      "encoded_base64": "XilRXilpXiJcXi1CXiQlXiZaXipaXi5HXipBXiJIXiF4XipGXiFHXiwxXiFsXiwpXiF6Xi4sXiFxXiItXixpXipvXipv",
      "byte_length": 69
    },
    {
      "unit_id": "DLG_3fbc0b6faec1",
      "text": "那麼我再問一次……",
      "encoded_ascii": "^)!^.T^$%^!l^*Z^!%^%D^*o^*o",
      "encoded_base64": "XikhXi5UXiQlXiFsXipaXiElXiVEXipvXipv",
      "byte_length": 27
    },
    {
      "unit_id": "DLG_f15004e319b9",
      "text": "我的耐心已經耗盡！這是我最後一次發問！",
      "encoded_ascii": "^$%^&Z^-S^#k^#J^'D^'X^-1^*W^(s^,X^$%^$q^#b^!%^%D^&W^*Z^*W",
      "encoded_base64": "XiQlXiZaXi1TXiNrXiNKXidEXidYXi0xXipXXihzXixYXiQlXiRxXiNiXiElXiVEXiZXXipaXipX",
      "byte_length": 57
    },
