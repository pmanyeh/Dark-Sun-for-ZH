    },
    {
      "unit_id": "LOC_6701510a0f3c",
      "text": "魅惑人類：改變目標在戰鬥中的陣營歸屬。僅對人類型生物（人類、矮人等）有效。",
      "encoded_ascii": "^*/^#x^!<^)w^*B^$N^(U^&^^%9^\"d^$(^*,^!,^&Z^)P^&'^%K^#C^!\"^!_^#:^!<^)w^\"j^&F^&4^*?^!<^)w^!!^&j^!<^'-^*@^$s^$Q^!\"",
