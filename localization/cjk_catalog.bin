      "encoded_ascii": "^+F^-c^#j",
      "encoded_base64": "XitGXi1jXiNq",
      "byte_length": 9
    },
    {
      "unit_id": "LOC_2d861f17fffb",
      "text": "卡瑪爾",
      "encoded_ascii": "^\"0^-*^&/",
      "encoded_base64": "XiIwXi0qXiYv",
      "byte_length": 9
    },
    {
      "unit_id": "LOC_c93c74b31642",
