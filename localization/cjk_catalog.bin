      "encoded_ascii": "^/&^&/^$[^\"o",
      "encoded_base64": "Xi8mXiYvXiRbXiJv",
      "byte_length": 12
    },
    {
      "unit_id": "LOC_fb88a9de4cda",
      "text": "巴斯比翁",
      "encoded_ascii": "^#K^$[^,m^/@",
      "encoded_base64": "XiNLXiRbXixtXi9A",
      "byte_length": 12
    },
    {
      "unit_id": "LOC_8b95c88ec2c7",
