      "byte_length": 114
    },
    {
      "unit_id": "LOC_639eac27cd2d",
      "text": "巨化術：使目標變大變強，在近戰中造成更多傷害。施法者等級越高效果越強。",
      "encoded_ascii": "^#H^\")^(<^*B^!N^&^^%9^(U^\"z^(U^#]^*A^\"d^(l^$(^!,^(v^$$^$o^\"x^!^^#/^!\"^$_^%b^'V^'-^'<^(]^*+^$Q^%!^(]^#]^!\"",
